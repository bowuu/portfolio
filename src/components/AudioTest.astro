---
// AudioTest.astro - DAC Latency, Stereo Isolation, 180° Polarity, Frequency Sweeper & Noise Generator
---

<section class="card audio-test-card" id="audio-lab">
	<div class="card-header-wrap">
		<div class="card-header-left">
			<h2 class="card-title">
				<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" class="card-icon">
					<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
					<path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/>
				</svg>
				Audio Test
			</h2>

			<!-- Telemetry HUD Badge (Moved to card header to keep visualizer 100% unobstructed) -->
			<div class="header-hud-badge" id="hero-hud-overlay">
				<div class="hud-badge-wrap" id="hud-badge-wrap">
					<span id="hero-hud-main" class="hud-main-text mono">Standby</span>
					<span class="hud-sep">▪</span>
					<span id="hero-hud-sub" class="hud-sub-text">Select Test</span>
				</div>
			</div>
		</div>

		<div class="header-actions">
			<!-- VISUALIZER INPUT SOURCE SWITCHER (Mic | Sim | Both) -->
			<div class="segmented-control source-control" role="group" aria-label="Audio Input Source">
				<button class="seg-btn" id="btn-src-mic" data-src-mode="mic" type="button" title="Microphone Input (Live Capture)">
					<svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" class="source-mic-icon">
						<path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
						<path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
						<line x1="12" y1="19" x2="12" y2="23"/>
						<line x1="8" y1="23" x2="16" y2="23"/>
					</svg>
					Mic
				</button>
				<button class="seg-btn active" id="btn-src-sim" data-src-mode="sim" type="button" title="Simulated Synthesizer & Tone Generator">Sim</button>
				<button class="seg-btn" id="btn-src-both" data-src-mode="both" type="button" title="Combine Microphone & Simulated Audio">Both</button>
			</div>

			<div class="volume-control-wrap" title="Output Volume (Safe Ceiling -18 dBFS)">
				<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" class="vol-icon">
					<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
					<path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
				</svg>
				<input type="range" id="audio-volume-slider" min="0" max="1" step="0.05" value="0.5" class="vol-slider" aria-label="Output Volume" />
				<span id="audio-vol-text" class="vol-text mono">50%</span>
			</div>
		</div>
	</div>

	<p class="benchmark-desc">
		Inspect stereo channel separation, 180&deg; wiring phase, broadband noise, and 20 Hz&ndash;20 kHz frequency response.
	</p>

	<!-- TWO-COLUMN WORKBENCH (HERO VISUALIZER ON LEFT, CONTROLS ON RIGHT) -->
	<div class="audio-workbench-grid">
		<!-- COLUMN 1: UNIFIED HERO VISUALIZER & DUAL CHANNEL METER -->
		<div class="audio-col hero-visualizer-col">
			<div class="col-head">
				<div class="col-head-left">
					<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" class="col-icon">
						<path d="M2 12h4l3 8 4-16 3 8h6"/>
					</svg>
					<span class="col-title">Visualizer</span>
				</div>
				<!-- MODE SWITCHER -->
				<div class="segmented-control" role="group" aria-label="Hero Visualizer Mode">
					<button class="seg-btn" id="btn-hero-waveform" data-hero-mode="waveform" type="button">Waveform</button>
					<button class="seg-btn active" id="btn-hero-spectrum" data-hero-mode="spectrum" type="button">Spectrum</button>
					<button class="seg-btn" id="btn-hero-spectrogram" data-hero-mode="spectrogram" type="button">Spectrogram</button>
				</div>
			</div>

			<!-- VISUALIZER STAGE (CANVAS + HORIZONTAL STEREO VU METER DIRECTLY UNDER) -->
			<div class="visualizer-stage">
				<!-- HERO CANVAS CONTAINER -->
				<div class="hero-canvas-box" id="hero-canvas-box">
					<canvas id="audio-hero-canvas" width="600" height="310"></canvas>

					<!-- TIME-DOMAIN PHASE CORRELATION BAR (Active in waveform mode) -->
					<div class="waveform-hud-bar" id="waveform-hud-bar" style="display: none;">
						<div class="phase-meter-wrap" title="Phase Correlation (-1.0 Inverted to +1.0 In-Phase)">
							<span class="phase-meter-title">Phase:</span>
							<span class="phase-meter-tag mono">-1.0</span>
							<div class="phase-meter-track">
								<div class="phase-meter-center"></div>
								<div class="phase-meter-fill" id="phase-meter-fill"></div>
							</div>
							<span class="phase-meter-tag mono">+1.0</span>
							<span class="phase-val mono" id="phase-val-text">+1.00</span>
						</div>
					</div>
				</div>

				<!-- DEDICATED HORIZONTAL STEREO PEAK / VU METER (FULL HORIZONTAL WIDTH) -->
				<div class="stereo-meter-box" id="stereo-meter-box" title="Stereo Peak / VU Meter (Left & Right Channels in dBFS)">
					<canvas id="audio-meter-canvas" width="600" height="58"></canvas>
				</div>
			</div>
		</div>

		<!-- COLUMN 2: HARDWARE TEST CONTROLS -->
		<div class="audio-col controls-col">
			<!-- SECTION 1: STEREO, POLARITY & NOISE -->
			<div class="control-group">
				<div class="group-header">
					<div class="group-header-left">
						<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" class="group-icon">
							<circle cx="12" cy="12" r="10"/>
							<line x1="12" y1="2" x2="12" y2="22"/>
						</svg>
						<span class="group-title">Stereo ▪ Polarity ▪ Noise</span>
					</div>
				</div>

				<div class="tone-buttons-grid">
					<button class="tone-btn" id="btn-tone-left" type="button">
						<span class="tone-pill cyan">L</span>
						<span class="tone-name">Left Channel</span>
					</button>

					<button class="tone-btn" id="btn-tone-right" type="button">
						<span class="tone-pill amber">R</span>
						<span class="tone-name">Right Channel</span>
					</button>

					<button class="tone-btn" id="btn-tone-inphase" type="button">
						<span class="tone-pill green">0&deg;</span>
						<span class="tone-name">Center Channel</span>
					</button>

					<button class="tone-btn" id="btn-tone-outphase" type="button">
						<span class="tone-pill warn">180&deg;</span>
						<span class="tone-name">Out-of-Phase</span>
					</button>

					<button class="tone-btn" id="btn-noise-pink" data-noise="pink" type="button">
						<span class="tone-pill pink">P</span>
						<span class="tone-name">Pink Noise</span>
					</button>

					<button class="tone-btn" id="btn-noise-white" data-noise="white" type="button">
						<span class="tone-pill white">W</span>
						<span class="tone-name">White Noise</span>
					</button>
				</div>
			</div>

			<!-- SECTION 2: TONE GENERATOR & SWEEPER -->
			<div class="control-group">
				<div class="group-header">
					<div class="group-header-left">
						<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" class="group-icon">
							<path d="M2 12h4l3 8 4-16 3 8h6"/>
						</svg>
						<span class="group-title">Tone Generator &amp; Sweeper</span>
					</div>
				</div>

				<!-- SINE TONE & SWEEPER SECTION -->
				<div class="tone-controls-section">
					<!-- SWEEP ACTIONS -->
					<div class="sweep-actions-row">
						<button id="run-sweep-btn" class="sweep-btn" type="button" title="Run 10-second frequency sweep (20 Hz–20,000 Hz)">
							<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" class="sweep-icon">
								<path d="M2 18l6-6 4 4 10-10"/>
								<polyline points="16 6 22 6 22 12"/>
							</svg>
							<span id="run-sweep-text">Auto Frequency Sweep (10s)</span>
						</button>
					</div>

					<!-- SCRUB SLIDER -->
					<div class="slider-row">
						<div class="slider-header-info">
							<span class="slider-hint">Sine Frequency Scrub</span>
							<span class="slider-hz-val mono" id="slider-hz-display">1,000 Hz</span>
						</div>
						<div class="slider-input-wrap">
							<button id="btn-play-tone" class="slider-play-btn" type="button" title="Play or Stop Sine Tone" aria-label="Play or Stop Sine Tone">
								<svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" class="play-icon" id="play-tone-icon">
									<polygon points="6 4 20 12 6 20 6 4"/>
								</svg>
								<span id="tone-play-text">Play</span>
							</button>
							<input type="range" id="freq-slider" min="20" max="20000" step="1" value="11335" class="freq-slider" aria-label="Frequency Slider" aria-valuenow="1000" aria-valuetext="1,000 Hz" />
						</div>
					</div>

					<!-- PRESET BUTTONS (Compact 3-Column Grid) -->
					<div class="freq-buttons-grid">
						<button class="tone-btn freq-btn" data-hz="20" type="button">
							<span class="tone-pill mono">20 Hz</span>
							<span class="tone-name">Sub</span>
						</button>

						<button class="tone-btn freq-btn" data-hz="60" type="button">
							<span class="tone-pill mono">60 Hz</span>
							<span class="tone-name">Bass</span>
						</button>

						<button class="tone-btn freq-btn" data-hz="250" type="button">
							<span class="tone-pill mono">250 Hz</span>
							<span class="tone-name">Mid</span>
						</button>

						<button class="tone-btn freq-btn" data-hz="1000" type="button">
							<span class="tone-pill mono">1 kHz</span>
							<span class="tone-name">Ref</span>
						</button>

						<button class="tone-btn freq-btn" data-hz="8000" type="button">
							<span class="tone-pill mono">8 kHz</span>
							<span class="tone-name">Pres</span>
						</button>

						<button class="tone-btn freq-btn" data-hz="16000" type="button">
							<span class="tone-pill mono">16 kHz</span>
							<span class="tone-name">Treble</span>
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	function setupAudioTest() {
		let audioCtx: AudioContext | null = null;
		let audioBus: GainNode | null = null;
		let masterGain: GainNode | null = null;
		let compressor: DynamicsCompressorNode | null = null;

		// Input Source & Visualizer Summing Routing (Mic / Simulated / Both)
		let visualizerBus: GainNode | null = null;
		let simVisualizerGain: GainNode | null = null;
		let micVisualizerGain: GainNode | null = null;
		let micStream: MediaStream | null = null;
		let micSourceNode: MediaStreamAudioSourceNode | null = null;
		let currentSourceMode: 'mic' | 'sim' | 'both' = 'sim';

		let currentOsc: OscillatorNode | null = null;
		let noiseNode: AudioNode | null = null;

		let activeSignal: 'sine' | 'pink' | 'white' = 'sine';
		let activeHeroMode: 'waveform' | 'spectrum' | 'spectrogram' = 'spectrum';
		let activeMode: 'none' | 'left' | 'right' | 'inphase' | 'outphase' | 'tone' | 'sweep' | 'noise' = 'none';
		let activeNoiseType: 'pink' | 'white' = 'pink';
		let currentToneHz = 1000;
		let isSweeping = false;
		let sweepRafId: number | null = null;
		let spectrumDecayFactor = 0.0;

		// VU Meter Ballistics State
		let smoothL = -60;
		let smoothR = -60;
		let peakHoldL = -60;
		let peakHoldR = -60;
		let peakHoldTimeL = 0;
		let peakHoldTimeR = 0;

		// Spectrogram History Buffer State
		let specHistoryCanvas: HTMLCanvasElement | null = null;
		let specHistoryCtx: CanvasRenderingContext2D | null = null;
		let lastSpecTime = 0;
		let currentThemeIsDark = true;

		// Visualizer Animation Loop State
		let isAudioVisible = false;
		let rafVisualizerId: number | null = null;

		function ensureVisualizerRunning() {
			if (isAudioVisible && !rafVisualizerId) {
				rafVisualizerId = requestAnimationFrame(renderActiveVisualizer);
			}
		}

		// UI references
		const modeWaveformBtn = document.getElementById('btn-hero-waveform');
		const modeSpectrumBtn = document.getElementById('btn-hero-spectrum');
		const modeSpectrogramBtn = document.getElementById('btn-hero-spectrogram');
		const waveformHudBar = document.getElementById('waveform-hud-bar');

		const btnSrcMic = document.getElementById('btn-src-mic');
		const btnSrcSim = document.getElementById('btn-src-sim');
		const btnSrcBoth = document.getElementById('btn-src-both');
		const srcBtns = [btnSrcMic, btnSrcSim, btnSrcBoth];

		const volSlider = document.getElementById('audio-volume-slider') as HTMLInputElement;
		const volText = document.getElementById('audio-vol-text');

		const heroHudMain = document.getElementById('hero-hud-main');
		const heroHudSub = document.getElementById('hero-hud-sub');
		const phaseMeterFill = document.getElementById('phase-meter-fill');
		const phaseValText = document.getElementById('phase-val-text');

		const sliderHzDisplay = document.getElementById('slider-hz-display');
		const freqSlider = document.getElementById('freq-slider') as HTMLInputElement;
		const btnPlayTone = document.getElementById('btn-play-tone');
		const tonePlayText = document.getElementById('tone-play-text');
		const playToneIcon = document.getElementById('play-tone-icon');
		const runSweepBtn = document.getElementById('run-sweep-btn');
		const runSweepText = document.getElementById('run-sweep-text');

		// Logarithmic frequency slider mapping (20 Hz - 20,000 Hz)
		const MIN_HZ = 20;
		const MAX_HZ = 20000;
		const MIN_LOG = Math.log(MIN_HZ);
		const MAX_LOG = Math.log(MAX_HZ);

		function hzToSliderVal(hz: number): number {
			const clamped = Math.max(MIN_HZ, Math.min(MAX_HZ, hz));
			const scale = (Math.log(clamped) - MIN_LOG) / (MAX_LOG - MIN_LOG);
			return Math.round(MIN_HZ + scale * (MAX_HZ - MIN_HZ));
		}

		function sliderValToHz(sliderVal: number): number {
			const scale = (sliderVal - MIN_HZ) / (MAX_HZ - MIN_HZ);
			return Math.round(Math.exp(MIN_LOG + scale * (MAX_LOG - MIN_LOG)));
		}

		if (freqSlider) {
			freqSlider.value = String(hzToSliderVal(currentToneHz));
			freqSlider.setAttribute('aria-valuenow', String(Math.round(currentToneHz)));
			freqSlider.setAttribute('aria-valuetext', `${Math.round(currentToneHz).toLocaleString()} Hz`);
		}

		const freqBtns = document.querySelectorAll('.freq-btn');
		const btnNoisePink = document.getElementById('btn-noise-pink');
		const btnNoiseWhite = document.getElementById('btn-noise-white');

		const heroCanvas = document.getElementById('audio-hero-canvas') as HTMLCanvasElement;
		const heroCtx = heroCanvas?.getContext('2d');

		const meterCanvas = document.getElementById('audio-meter-canvas') as HTMLCanvasElement;
		const meterCtx = meterCanvas?.getContext('2d');

		let splitter: ChannelSplitterNode | null = null;
		let analyserLeft: AnalyserNode | null = null;
		let analyserRight: AnalyserNode | null = null;
		let fftAnalyser: AnalyserNode | null = null;

		// Lazy initialize AudioContext on user interaction
		function getAudioContext(): AudioContext {
			if (!audioCtx) {
				const AudioConstructor = window.AudioContext || (window as any).webkitAudioContext;
				audioCtx = new AudioConstructor();

				// Master compressor to prevent clipping / distortion on speakers
				compressor = audioCtx.createDynamicsCompressor();
				compressor.threshold.setValueAtTime(-12, audioCtx.currentTime);
				compressor.knee.setValueAtTime(30, audioCtx.currentTime);
				compressor.ratio.setValueAtTime(12, audioCtx.currentTime);
				compressor.attack.setValueAtTime(0.003, audioCtx.currentTime);
				compressor.release.setValueAtTime(0.25, audioCtx.currentTime);

				// Pre-attenuation Audio Bus (Unity Gain 0 dB) for simulated audio output
				audioBus = audioCtx.createGain();
				audioBus.channelCount = 2;
				audioBus.channelCountMode = 'explicit';
				audioBus.channelInterpretation = 'speakers';

				// Master volume attenuation node for simulated audio speakers / output
				masterGain = audioCtx.createGain();
				const initialVol = volSlider ? parseFloat(volSlider.value) : 0.5;
				masterGain.gain.setValueAtTime(initialVol * 0.45, audioCtx.currentTime);

				audioBus.connect(masterGain);
				masterGain.connect(compressor);
				compressor.connect(audioCtx.destination);

				// Dedicated Visualizer Bus: Sums simulated and/or microphone inputs
				visualizerBus = audioCtx.createGain();
				visualizerBus.channelCount = 2;
				visualizerBus.channelCountMode = 'explicit';
				visualizerBus.channelInterpretation = 'speakers';

				simVisualizerGain = audioCtx.createGain();
				simVisualizerGain.gain.setValueAtTime(currentSourceMode === 'mic' ? 0.0 : 1.0, audioCtx.currentTime);
				audioBus.connect(simVisualizerGain);
				simVisualizerGain.connect(visualizerBus);

				micVisualizerGain = audioCtx.createGain();
				micVisualizerGain.gain.setValueAtTime(currentSourceMode === 'sim' ? 0.0 : 1.0, audioCtx.currentTime);
				micVisualizerGain.connect(visualizerBus);

				if (micSourceNode) {
					try { micSourceNode.connect(micVisualizerGain); } catch (_) {}
				}

				// Real Stereo & Phase Vector Split (Left / Right split for oscilloscope & VU meter)
				splitter = audioCtx.createChannelSplitter(2);
				analyserLeft = audioCtx.createAnalyser();
				analyserRight = audioCtx.createAnalyser();
				analyserLeft.fftSize = 2048;
				analyserRight.fftSize = 2048;

				visualizerBus.connect(splitter);
				splitter.connect(analyserLeft, 0);
				splitter.connect(analyserRight, 1);

				// Real Frequency Response FFT Spectrum Analyser (4096-point high-resolution FFT)
				fftAnalyser = audioCtx.createAnalyser();
				fftAnalyser.fftSize = 4096;
				fftAnalyser.smoothingTimeConstant = 0.80;
				fftAnalyser.minDecibels = -80;
				fftAnalyser.maxDecibels = -10;

				visualizerBus.connect(fftAnalyser);
			}

			if (audioCtx.state === 'suspended') {
				audioCtx.resume().catch(() => {});
			}
			return audioCtx;
		}

		// Visualizer Mode Switcher
		function setHeroVisualizerMode(mode: 'waveform' | 'spectrum' | 'spectrogram') {
			activeHeroMode = mode;
			modeWaveformBtn?.classList.toggle('active', mode === 'waveform');
			modeSpectrumBtn?.classList.toggle('active', mode === 'spectrum');
			modeSpectrogramBtn?.classList.toggle('active', mode === 'spectrogram');

			if (waveformHudBar) {
				waveformHudBar.style.display = mode === 'waveform' ? 'flex' : 'none';
			}

			updateHudOverlay();
			if (!rafVisualizerId) {
				renderActiveVisualizer(true);
			}
		}

		modeWaveformBtn?.addEventListener('click', () => setHeroVisualizerMode('waveform'));
		modeSpectrumBtn?.addEventListener('click', () => setHeroVisualizerMode('spectrum'));
		modeSpectrogramBtn?.addEventListener('click', () => setHeroVisualizerMode('spectrogram'));

		// Update Master Volume
		if (volSlider) {
			volSlider.addEventListener('input', () => {
				const val = parseFloat(volSlider.value);
				if (volText) volText.textContent = `${Math.round(val * 100)}%`;
				if (masterGain && audioCtx) {
					masterGain.gain.setTargetAtTime(val * 0.45, audioCtx.currentTime, 0.03);
				}
			});
		}

		// Voice Audio Buffers for Spoken Tests
		const voiceBufferCache: Record<string, AudioBuffer> = {};
		let currentSourceNode: AudioBufferSourceNode | null = null;

		async function loadVoiceBuffer(mode: 'left' | 'right' | 'inphase' | 'outphase'): Promise<AudioBuffer | null> {
			if (voiceBufferCache[mode]) return voiceBufferCache[mode];
			const fileMap: Record<string, string> = {
				left: '/audio/voice-left.mp3',
				right: '/audio/voice-right.mp3',
				inphase: '/audio/voice-center.mp3',
				outphase: '/audio/voice-outphase.mp3',
			};
			try {
				const res = await fetch(fileMap[mode]);
				const arr = await res.arrayBuffer();
				const ctx = getAudioContext();
				const buf = await ctx.decodeAudioData(arr);
				voiceBufferCache[mode] = buf;
				return buf;
			} catch (e) {
				console.error('Failed to load voice buffer', e);
				return null;
			}
		}

		// Microphone and Visualizer Audio Source Management (Mic | Sim | Both)
		async function enableMicrophone(): Promise<boolean> {
			const ctx = getAudioContext();
			if (micStream && micSourceNode) {
				return true;
			}
			try {
				if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
					alert('Microphone input is not supported in this browser.');
					return false;
				}
				const stream = await navigator.mediaDevices.getUserMedia({
					audio: {
						echoCancellation: false,
						noiseSuppression: false,
						autoGainControl: false,
					},
				});
				micStream = stream;
				micSourceNode = ctx.createMediaStreamSource(stream);
				if (micVisualizerGain) {
					micSourceNode.connect(micVisualizerGain);
				}
				return true;
			} catch (err: any) {
				console.warn('Microphone access denied or error:', err);
				if (heroHudMain && heroHudSub) {
					heroHudMain.textContent = 'Mic Blocked';
					heroHudSub.textContent = 'Permission Denied';
				}
				return false;
			}
		}

		function stopMicrophone() {
			if (micStream) {
				micStream.getTracks().forEach((t) => t.stop());
				micStream = null;
			}
			if (micSourceNode) {
				try {
					micSourceNode.disconnect();
				} catch (_) {}
				micSourceNode = null;
			}
		}

		async function setSourceMode(mode: 'mic' | 'sim' | 'both') {
			getAudioContext();
			if (mode === 'mic' || mode === 'both') {
				const ok = await enableMicrophone();
				if (!ok) {
					mode = 'sim';
				}
			} else {
				stopMicrophone();
			}

			currentSourceMode = mode;

			srcBtns.forEach((b) => {
				if (!b) return;
				const active = b.getAttribute('data-src-mode') === mode;
				b.classList.toggle('active', active);
			});

			if (simVisualizerGain && micVisualizerGain && audioCtx) {
				const now = audioCtx.currentTime;
				simVisualizerGain.gain.setTargetAtTime(mode === 'mic' ? 0.0 : 1.0, now, 0.02);
				micVisualizerGain.gain.setTargetAtTime(mode === 'sim' ? 0.0 : 1.0, now, 0.02);
			}

			updateHudOverlay();
			if (mode === 'mic' || mode === 'both') {
				ensureVisualizerRunning();
			}
		}

		btnSrcMic?.addEventListener('click', () => setSourceMode('mic'));
		btnSrcSim?.addEventListener('click', () => setSourceMode('sim'));
		btnSrcBoth?.addEventListener('click', () => setSourceMode('both'));

		// Update HUD text banner
		function updateHudOverlay() {
			if (!heroHudMain || !heroHudSub) return;

			if (currentSourceMode === 'mic') {
				heroHudMain.textContent = 'Microphone';
				heroHudSub.textContent = 'Live Capture';
				return;
			}

			const prefix = currentSourceMode === 'both' ? 'Mic + ' : '';

			if (activeMode === 'none') {
				heroHudMain.textContent = currentSourceMode === 'both' ? 'Mic Active' : 'Standby';
				heroHudSub.textContent = currentSourceMode === 'both' ? 'Sim Ready' : 'Select Test';
				return;
			}

			if (activeMode === 'left') {
				heroHudMain.textContent = `${prefix}Left Channel`;
				heroHudSub.textContent = '100% Left';
			} else if (activeMode === 'right') {
				heroHudMain.textContent = `${prefix}Right Channel`;
				heroHudSub.textContent = '100% Right';
			} else if (activeMode === 'inphase') {
				heroHudMain.textContent = `${prefix}Center (0°)`;
				heroHudSub.textContent = 'In-Phase';
			} else if (activeMode === 'outphase') {
				heroHudMain.textContent = `${prefix}Out-of-Phase (180°)`;
				heroHudSub.textContent = 'Inverted Polarity';
			} else if (activeMode === 'tone') {
				heroHudMain.textContent = `${prefix}${Math.round(currentToneHz).toLocaleString()} Hz`;
				heroHudSub.textContent = getBandTag(currentToneHz);
			} else if (activeMode === 'sweep') {
				heroHudMain.textContent = `${prefix}${Math.round(currentToneHz).toLocaleString()} Hz`;
				heroHudSub.textContent = 'Auto Sweep';
			} else if (activeMode === 'noise') {
				if (activeNoiseType === 'pink') {
					heroHudMain.textContent = `${prefix}Pink (1/f)`;
					heroHudSub.textContent = 'Equal Energy/Oct';
				} else {
					heroHudMain.textContent = `${prefix}White Noise`;
					heroHudSub.textContent = 'Flat PSD';
				}
			}
		}

		function getBandTag(hz: number): string {
			if (hz < 60) return 'Sub-Bass';
			if (hz < 250) return 'Bass';
			if (hz < 500) return 'Low-Mid';
			if (hz < 2000) return 'Midrange';
			if (hz < 4000) return 'High-Mid';
			if (hz < 8000) return 'Presence';
			if (hz < 14000) return 'Brilliance';
			return 'Ultra-Treble';
		}

		function updateTonePlayButtonUI(isPlaying: boolean) {
			if (!btnPlayTone) return;
			btnPlayTone.classList.toggle('active', isPlaying);
			if (tonePlayText) tonePlayText.textContent = isPlaying ? 'Stop' : 'Play';
			if (playToneIcon) {
				playToneIcon.innerHTML = isPlaying
					? '<rect x="5" y="5" width="14" height="14" rx="2"/>'
					: '<polygon points="6 4 20 12 6 20 6 4"/>';
			}
		}

		// Stop All Active Audio
		function stopAllAudio() {
			if (sweepRafId) {
				cancelAnimationFrame(sweepRafId);
				sweepRafId = null;
			}
			isSweeping = false;

			if (currentSourceNode) {
				try {
					currentSourceNode.onended = null;
					currentSourceNode.stop();
					currentSourceNode.disconnect();
				} catch (_) {}
				currentSourceNode = null;
			}
			if (currentOsc) {
				try {
					currentOsc.stop();
					currentOsc.disconnect();
				} catch (_) {}
				currentOsc = null;
			}
			if (noiseNode) {
				try {
					(noiseNode as any).stop?.();
					noiseNode.disconnect();
				} catch (_) {}
				noiseNode = null;
			}

			activeMode = 'none';
			document.querySelectorAll('.tone-btn').forEach(b => b.classList.remove('active'));
			updateTonePlayButtonUI(false);
			if (runSweepBtn) runSweepBtn.classList.remove('active');
			if (runSweepText) runSweepText.textContent = 'Auto Frequency Sweep (10s)';

			updateHudOverlay();
			ensureVisualizerRunning();
		}

		// Frequency UI updates
		function updateFrequencyUI(hz: number, syncSlider = false) {
			currentToneHz = hz;
			if (sliderHzDisplay) {
				sliderHzDisplay.textContent = `${Math.round(hz).toLocaleString()} Hz`;
			}
			if (syncSlider && freqSlider) {
				freqSlider.value = String(hzToSliderVal(hz));
				freqSlider.setAttribute('aria-valuenow', String(Math.round(hz)));
				freqSlider.setAttribute('aria-valuetext', `${Math.round(hz).toLocaleString()} Hz`);
			}
			updateHudOverlay();
			ensureVisualizerRunning();
		}

		// Slider Scrub
		if (freqSlider) {
			freqSlider.addEventListener('input', () => {
				const sliderVal = parseFloat(freqSlider.value);
				const hz = sliderValToHz(sliderVal);

				activeSignal = 'sine';
				updateFrequencyUI(hz, false);
				freqSlider.setAttribute('aria-valuenow', String(Math.round(hz)));
				freqSlider.setAttribute('aria-valuetext', `${Math.round(hz).toLocaleString()} Hz`);

				if (activeMode === 'tone' && currentOsc && audioCtx) {
					currentOsc.frequency.setTargetAtTime(hz, audioCtx.currentTime, 0.02);
				}
				freqBtns.forEach((p) => {
					const pillHz = parseInt(p.getAttribute('data-hz') || '0', 10);
					p.classList.toggle('active', pillHz === hz);
				});
				btnNoisePink?.classList.remove('active');
				btnNoiseWhite?.classList.remove('active');
			});
		}

		// Preset Frequency Buttons (Clicking immediately plays or toggles off if active)
		freqBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const targetHz = parseInt(btn.getAttribute('data-hz') || '1000', 10);

				// If this preset is already actively playing, clicking it pauses/stops audio
				if (activeMode === 'tone' && currentToneHz === targetHz) {
					stopAllAudio();
					return;
				}

				activeSignal = 'sine';
				updateFrequencyUI(targetHz, true);
				startToneGenerator(targetHz);
			});
		});

		// Broadband Noise Buttons (Clicking immediately plays or toggles off if active)
		btnNoisePink?.addEventListener('click', () => {
			if (activeMode === 'noise' && activeNoiseType === 'pink') {
				stopAllAudio();
				return;
			}
			activeSignal = 'pink';
			activeNoiseType = 'pink';
			startNoiseGenerator('pink');
		});

		btnNoiseWhite?.addEventListener('click', () => {
			if (activeMode === 'noise' && activeNoiseType === 'white') {
				stopAllAudio();
				return;
			}
			activeSignal = 'white';
			activeNoiseType = 'white';
			startNoiseGenerator('white');
		});

		// Start Sine Tone Generator
		function startToneGenerator(targetHz?: number) {
			const ctx = getAudioContext();
			stopAllAudio();
			activeMode = 'tone';
			activeSignal = 'sine';
			if (typeof targetHz === 'number') currentToneHz = targetHz;

			spectrumDecayFactor = 1.0;
			updateTonePlayButtonUI(true);

			const osc = ctx.createOscillator();
			osc.type = 'sine';
			osc.frequency.setValueAtTime(currentToneHz, ctx.currentTime);
			osc.connect(audioBus || masterGain!);
			osc.start();
			currentOsc = osc;

			freqBtns.forEach((p) => {
				const hz = parseInt(p.getAttribute('data-hz') || '0', 10);
				p.classList.toggle('active', hz === currentToneHz);
			});

			updateHudOverlay();
			ensureVisualizerRunning();
		}

		btnPlayTone?.addEventListener('click', () => {
			if (activeMode === 'tone') {
				stopAllAudio();
			} else {
				activeSignal = 'sine';
				updateFrequencyUI(currentToneHz, false);
				startToneGenerator(currentToneHz);
			}
		});

		// Auto Frequency Sweep (20Hz - 20,000Hz over 10 seconds)
		function runAutoSweep() {
			if (isSweeping) {
				stopAllAudio();
				return;
			}
			const ctx = getAudioContext();
			stopAllAudio();
			isSweeping = true;
			activeMode = 'sweep';
			activeSignal = 'sine';
			spectrumDecayFactor = 1.0;

			const osc = ctx.createOscillator();
			osc.type = 'sine';
			osc.frequency.setValueAtTime(20, ctx.currentTime);
			osc.frequency.exponentialRampToValueAtTime(20000, ctx.currentTime + 10);
			osc.connect(audioBus || masterGain!);
			osc.start();
			currentOsc = osc;

			if (runSweepBtn) runSweepBtn.classList.add('active');
			if (runSweepText) runSweepText.textContent = 'Stop Frequency Sweep';
			updateHudOverlay();
			ensureVisualizerRunning();

			const sweepStart = performance.now();
			function updateSweepProgress() {
				if (!isSweeping) return;
				const elapsed = (performance.now() - sweepStart) / 1000;
				if (elapsed >= 10) {
					stopAllAudio();
					return;
				}
				// Exponential frequency calculation
				const sweepHz = 20 * Math.pow(20000 / 20, elapsed / 10);
				updateFrequencyUI(sweepHz, true);

				sweepRafId = requestAnimationFrame(updateSweepProgress);
			}
			sweepRafId = requestAnimationFrame(updateSweepProgress);
		}

		if (runSweepBtn) runSweepBtn.addEventListener('click', runAutoSweep);

		// BROADBAND NOISE GENERATOR (Pink / White)
		function startNoiseGenerator(noiseType?: 'pink' | 'white') {
			if (noiseType) activeNoiseType = noiseType;
			activeSignal = activeNoiseType;
			const ctx = getAudioContext();
			stopAllAudio();
			activeMode = 'noise';
			spectrumDecayFactor = 1.0;

			const bufferSize = ctx.sampleRate * 2;
			const noiseBuffer = ctx.createBuffer(2, bufferSize, ctx.sampleRate);
			const outL = noiseBuffer.getChannelData(0);
			const outR = noiseBuffer.getChannelData(1);

			if (activeNoiseType === 'white') {
				for (let i = 0; i < bufferSize; i++) {
					outL[i] = (Math.random() * 2 - 1) * 0.45;
					outR[i] = (Math.random() * 2 - 1) * 0.45;
				}
			} else {
				// Pink noise: Paul Kellet 6-pole IIR filter algorithm (-3 dB/oct)
				let b0L = 0, b1L = 0, b2L = 0, b3L = 0, b4L = 0, b5L = 0, b6L = 0;
				let b0R = 0, b1R = 0, b2R = 0, b3R = 0, b4R = 0, b5R = 0, b6R = 0;
				for (let i = 0; i < bufferSize; i++) {
					const whiteL = Math.random() * 2 - 1;
					b0L = 0.99886 * b0L + whiteL * 0.0555179;
					b1L = 0.99332 * b1L + whiteL * 0.0750759;
					b2L = 0.96900 * b2L + whiteL * 0.1538520;
					b3L = 0.86650 * b3L + whiteL * 0.3104856;
					b4L = 0.55000 * b4L + whiteL * 0.5329522;
					b5L = -0.7616 * b5L - whiteL * 0.0168980;
					outL[i] = (b0L + b1L + b2L + b3L + b4L + b5L + b6L + whiteL * 0.5362) * 0.07;
					b6L = whiteL * 0.115926;

					const whiteR = Math.random() * 2 - 1;
					b0R = 0.99886 * b0R + whiteR * 0.0555179;
					b1R = 0.99332 * b1R + whiteR * 0.0750759;
					b2R = 0.96900 * b2R + whiteR * 0.1538520;
					b3R = 0.86650 * b3R + whiteR * 0.3104856;
					b4R = 0.55000 * b4R + whiteR * 0.5329522;
					b5R = -0.7616 * b5R - whiteR * 0.0168980;
					outR[i] = (b0R + b1R + b2R + b3R + b4R + b5R + b6R + whiteR * 0.5362) * 0.07;
					b6R = whiteR * 0.115926;
				}
			}

			const noiseSource = ctx.createBufferSource();
			noiseSource.buffer = noiseBuffer;
			noiseSource.loop = true;
			noiseSource.connect(audioBus || masterGain!);
			noiseSource.start();
			noiseNode = noiseSource;

			btnNoisePink?.classList.toggle('active', activeNoiseType === 'pink');
			btnNoiseWhite?.classList.toggle('active', activeNoiseType === 'white');
			updateHudOverlay();
			ensureVisualizerRunning();
		}

		// CHANNEL ISOLATION & POLARITY TESTS
		async function playPolarityTone(mode: 'left' | 'right' | 'inphase' | 'outphase') {
			if (activeMode === mode) {
				stopAllAudio();
				return;
			}

			const ctx = getAudioContext();
			stopAllAudio();
			activeMode = mode;
			spectrumDecayFactor = 1.0;

			const btnMap: Record<string, string> = {
				left: 'btn-tone-left',
				right: 'btn-tone-right',
				inphase: 'btn-tone-inphase',
				outphase: 'btn-tone-outphase'
			};
			document.getElementById(btnMap[mode])?.classList.add('active');
			updateHudOverlay();

			const buf = await loadVoiceBuffer(mode);
			if (activeMode !== mode) return;

			function playVoiceClip() {
				if (activeMode !== mode || !masterGain) return;
				const c = getAudioContext();
				const merger = c.createChannelMerger(2);

				if (buf) {
					const source = c.createBufferSource();
					source.buffer = buf;

					if (mode === 'left') {
						const g = c.createGain();
						g.gain.setValueAtTime(1.0, c.currentTime);
						source.connect(g);
						g.connect(merger, 0, 0); // left ear only
					} else if (mode === 'right') {
						const g = c.createGain();
						g.gain.setValueAtTime(1.0, c.currentTime);
						source.connect(g);
						g.connect(merger, 0, 1); // right ear only
					} else if (mode === 'inphase') {
						const leftG = c.createGain();
						const rightG = c.createGain();
						leftG.gain.setValueAtTime(1.0, c.currentTime);
						rightG.gain.setValueAtTime(1.0, c.currentTime);
						source.connect(leftG);
						source.connect(rightG);
						leftG.connect(merger, 0, 0);
						rightG.connect(merger, 0, 1);
					} else if (mode === 'outphase') {
						const leftG = c.createGain();
						const rightG = c.createGain();
						leftG.gain.setValueAtTime(1.0, c.currentTime);
						rightG.gain.setValueAtTime(-1.0, c.currentTime); // 180° phase inversion
						source.connect(leftG);
						source.connect(rightG);
						leftG.connect(merger, 0, 0);
						rightG.connect(merger, 0, 1);
					}

					merger.connect(audioBus || masterGain);
					source.start();
					currentSourceNode = source;

					source.onended = () => {
						if (activeMode === mode) {
							playVoiceClip();
						}
					};
				} else {
					// Fallback to sine wave if audio file fails to load
					const osc = c.createOscillator();
					osc.type = 'sine';
					osc.frequency.setValueAtTime(1000, c.currentTime);
					if (mode === 'left') {
						const leftG = c.createGain();
						leftG.gain.setValueAtTime(1.0, c.currentTime);
						osc.connect(leftG);
						leftG.connect(merger, 0, 0);
					} else if (mode === 'right') {
						const rightG = c.createGain();
						rightG.gain.setValueAtTime(1.0, c.currentTime);
						osc.connect(rightG);
						rightG.connect(merger, 0, 1);
					} else if (mode === 'inphase') {
						osc.connect(merger, 0, 0);
						osc.connect(merger, 0, 1);
					} else if (mode === 'outphase') {
						const leftG = c.createGain();
						const rightG = c.createGain();
						rightG.gain.setValueAtTime(-1.0, c.currentTime);
						osc.connect(leftG);
						osc.connect(rightG);
						leftG.connect(merger, 0, 0);
						rightG.connect(merger, 0, 1);
					}
					merger.connect(audioBus || masterGain);
					osc.start();
					currentOsc = osc;
				}
			}

			playVoiceClip();
			ensureVisualizerRunning();
		}

		document.getElementById('btn-tone-left')?.addEventListener('click', () => playPolarityTone('left'));
		document.getElementById('btn-tone-right')?.addEventListener('click', () => playPolarityTone('right'));
		document.getElementById('btn-tone-inphase')?.addEventListener('click', () => playPolarityTone('inphase'));
		document.getElementById('btn-tone-outphase')?.addEventListener('click', () => playPolarityTone('outphase'));

		// -------------------------------------------------------------
		// VISUALIZER 1: DUAL-TRACE WAVEFORM OSCILLOSCOPE
		// -------------------------------------------------------------
		function renderWaveformScope() {
			if (!heroCtx || !heroCanvas) return;
			const w = heroCanvas.width;
			const h = heroCanvas.height;
			const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
			const cy = h / 2;

			heroCtx.clearRect(0, 0, w, h);
			heroCtx.fillStyle = isDark ? '#09090b' : '#f8fafc';
			heroCtx.fillRect(0, 0, w, h);

			// Oscilloscope Grid Divisions
			heroCtx.strokeStyle = isDark ? 'rgba(255, 255, 255, 0.05)' : 'rgba(0, 0, 0, 0.06)';
			heroCtx.lineWidth = 1;

			// Horizontal division lines (±1.0, ±0.5, 0 baseline)
			const gridYSteps = [0.15, 0.32, 0.5, 0.68, 0.85];
			gridYSteps.forEach((ratio) => {
				const y = Math.round(h * ratio);
				heroCtx.beginPath();
				heroCtx.moveTo(0, y);
				heroCtx.lineTo(w, y);
				heroCtx.stroke();
			});

			// Vertical division lines
			const gridCols = 8;
			for (let col = 1; col < gridCols; col++) {
				const x = Math.round((w / gridCols) * col);
				heroCtx.beginPath();
				heroCtx.moveTo(x, 0);
				heroCtx.lineTo(x, h);
				heroCtx.stroke();
			}

			// Center baseline (0V reference)
			heroCtx.strokeStyle = isDark ? 'rgba(255, 255, 255, 0.12)' : 'rgba(0, 0, 0, 0.18)';
			heroCtx.beginPath();
			heroCtx.moveTo(0, cy);
			heroCtx.lineTo(w, cy);
			heroCtx.stroke();

			const isProducingSound = activeMode !== 'none' || (currentSourceMode !== 'sim' && !!micStream);
			if (!analyserLeft || !analyserRight || (!isProducingSound && spectrumDecayFactor === 0)) {
				// Standby resting zero baselines
				heroCtx.strokeStyle = isDark ? 'rgba(56, 189, 248, 0.35)' : 'rgba(2, 132, 199, 0.35)';
				heroCtx.beginPath();
				heroCtx.moveTo(0, cy);
				heroCtx.lineTo(w, cy);
				heroCtx.stroke();
				if (phaseValText && phaseMeterFill) {
					phaseValText.textContent = '+1.00';
					phaseMeterFill.style.transform = 'scaleX(1)';
					phaseMeterFill.style.background = '#22c55e';
				}
				return;
			}

			const bufLen = analyserLeft.fftSize;
			const timeL = new Float32Array(bufLen);
			const timeR = new Float32Array(bufLen);
			analyserLeft.getFloatTimeDomainData(timeL);
			analyserRight.getFloatTimeDomainData(timeR);

			// Calculate Pearson correlation & RMS energy
			let sumSqL = 0;
			let sumSqR = 0;
			let dotProd = 0;
			for (let i = 0; i < bufLen; i++) {
				const l = timeL[i];
				const r = timeR[i];
				sumSqL += l * l;
				sumSqR += r * r;
				dotProd += l * r;
			}
			const rmsL = Math.sqrt(sumSqL / bufLen);
			const rmsR = Math.sqrt(sumSqR / bufLen);
			const maxRms = Math.max(rmsL, rmsR);

			// Phase correlation computation: r in [-1.0 .. +1.0]
			const denom = Math.sqrt(sumSqL * sumSqR);
			let correlation = 1.0;
			if (denom > 0.0001) {
				correlation = Math.max(-1.0, Math.min(1.0, dotProd / denom));
			} else if (rmsL > 0.01 && rmsR <= 0.005) {
				correlation = 0.0;
			} else if (rmsR > 0.01 && rmsL <= 0.005) {
				correlation = 0.0;
			}

			// Update Phase Correlation Meter HUD UI
			if (phaseValText && phaseMeterFill) {
				if (maxRms < 0.002) {
					phaseValText.textContent = '0.00';
					phaseMeterFill.style.width = '50%';
					phaseMeterFill.style.background = 'rgba(148, 163, 184, 0.4)';
				} else if (rmsL > 0.01 && rmsR < 0.003) {
					phaseValText.textContent = 'L Only';
					phaseMeterFill.style.width = '50%';
					phaseMeterFill.style.background = '#38bdf8';
				} else if (rmsR > 0.01 && rmsL < 0.003) {
					phaseValText.textContent = 'R Only';
					phaseMeterFill.style.width = '50%';
					phaseMeterFill.style.background = '#f59e0b';
				} else {
					phaseValText.textContent = (correlation >= 0 ? '+' : '') + correlation.toFixed(2);
					const pct = Math.round(((correlation + 1) / 2) * 100);
					phaseMeterFill.style.width = `${pct}%`;
					if (correlation > 0.65) {
						phaseMeterFill.style.background = '#22c55e';
					} else if (correlation < -0.65) {
						phaseMeterFill.style.background = '#ef4444';
					} else {
						phaseMeterFill.style.background = '#ea580c';
					}
				}
			}

			// Trigger detection: find rising zero-crossing to stabilize periodic waveforms
			let triggerIdx = 0;
			if (maxRms > 0.005) {
				const triggerArray = rmsL >= rmsR ? timeL : timeR;
				for (let i = 1; i < 256; i++) {
					if (triggerArray[i - 1] <= 0 && triggerArray[i] > 0) {
						triggerIdx = i;
						break;
					}
				}
			}

			// Dynamic sample display window tailored to fundamental period
			let displayLen = 512;
			if (activeMode === 'tone' || activeMode === 'sweep') {
				const hz = Math.max(20, Math.min(20000, currentToneHz));
				if (audioCtx) {
					const periodSamples = Math.round(audioCtx.sampleRate / hz);
					displayLen = Math.min(bufLen - triggerIdx - 1, Math.max(64, periodSamples * 4));
				}
			}

			const ampHeight = (h / 2) * 0.82;
			const stepX = w / (displayLen - 1);

			// Render Left Channel Waveform (Cyan #38bdf8 in dark, Sky-Blue #0284c7 in light)
			heroCtx.save();
			heroCtx.strokeStyle = isDark ? '#38bdf8' : '#0284c7';
			heroCtx.lineWidth = 2.0;
			heroCtx.shadowColor = isDark ? 'rgba(56, 189, 248, 0.5)' : 'rgba(2, 132, 199, 0.25)';
			heroCtx.shadowBlur = 4;
			heroCtx.beginPath();
			for (let i = 0; i < displayLen; i++) {
				const sampleIdx = triggerIdx + i;
				const sL = sampleIdx < bufLen ? timeL[sampleIdx] : 0;
				const x = i * stepX;
				const y = cy - sL * ampHeight;
				if (i === 0) heroCtx.moveTo(x, y);
				else heroCtx.lineTo(x, y);
			}
			heroCtx.stroke();
			heroCtx.restore();

			// Render Right Channel Waveform (Amber #f59e0b in dark, Deep Amber #d97706 in light)
			heroCtx.save();
			heroCtx.strokeStyle = isDark ? '#f59e0b' : '#d97706';
			heroCtx.lineWidth = 2.0;
			heroCtx.shadowColor = isDark ? 'rgba(245, 158, 11, 0.5)' : 'rgba(217, 119, 6, 0.25)';
			heroCtx.shadowBlur = 4;
			heroCtx.beginPath();
			for (let i = 0; i < displayLen; i++) {
				const sampleIdx = triggerIdx + i;
				const sR = sampleIdx < bufLen ? timeR[sampleIdx] : 0;
				const x = i * stepX;
				const y = cy - sR * ampHeight;
				if (i === 0) heroCtx.moveTo(x, y);
				else heroCtx.lineTo(x, y);
			}
			heroCtx.stroke();
			heroCtx.restore();
		}

		// -------------------------------------------------------------
		// VISUALIZER 2: 4096-POINT FFT SPECTRUM ANALYSER
		// -------------------------------------------------------------
		function renderSpectrumScope() {
			if (!heroCtx || !heroCanvas) return;
			const w = heroCanvas.width;
			const h = heroCanvas.height;
			const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			const bottomY = Math.round(h - 22 * dpr);
			const labelY = Math.round(h - 6 * dpr);
			const topPad = Math.round(14 * dpr);
			const plotH = bottomY - topPad;

			heroCtx.clearRect(0, 0, w, h);
			heroCtx.fillStyle = isDark ? '#09090b' : '#f8fafc';
			heroCtx.fillRect(0, 0, w, h);

			const minFreq = 20;
			const maxFreq = 20000;
			const logMin = Math.log10(minFreq);
			const logMax = Math.log10(maxFreq);
			const logRange = logMax - logMin;

			const freqToX = (hz: number) => {
				const clamped = Math.max(minFreq, Math.min(maxFreq, hz));
				return ((Math.log10(clamped) - logMin) / logRange) * w;
			};

			// Horizontal divider above bottom gutter
			heroCtx.strokeStyle = isDark ? 'rgba(255, 255, 255, 0.05)' : 'rgba(0, 0, 0, 0.06)';
			heroCtx.lineWidth = 1;
			heroCtx.beginPath();
			heroCtx.moveTo(0, bottomY);
			heroCtx.lineTo(w, bottomY);
			heroCtx.stroke();

			// Landmark grid lines: 100 Hz, 1 kHz, 10 kHz
			heroCtx.strokeStyle = isDark ? 'rgba(255, 255, 255, 0.08)' : 'rgba(0, 0, 0, 0.1)';
			heroCtx.lineWidth = 1;
			heroCtx.setLineDash([2, 4]);
			[100, 1000, 10000].forEach((hz) => {
				const x = freqToX(hz);
				heroCtx.beginPath();
				heroCtx.moveTo(x, 0);
				heroCtx.lineTo(x, bottomY);
				heroCtx.stroke();
			});
			heroCtx.setLineDash([]);

			// Frequency labels matching Spectrogram (20 Hz, 100 Hz, 1 kHz, 10 kHz, 20 kHz)
			const fontSize = Math.round(9.5 * dpr);
			heroCtx.font = `${fontSize}px monospace`;
			heroCtx.fillStyle = isDark ? 'rgba(255, 255, 255, 0.35)' : 'rgba(0, 0, 0, 0.55)';

			heroCtx.textAlign = 'left';
			heroCtx.fillText('20 Hz', 6 * dpr, labelY);

			heroCtx.textAlign = 'center';
			heroCtx.fillText('100 Hz', freqToX(100), labelY);
			heroCtx.fillText('1 kHz', freqToX(1000), labelY);

			heroCtx.textAlign = 'right';
			heroCtx.fillText('10 kHz', freqToX(10000) - 4 * dpr, labelY);
			heroCtx.fillText('20 kHz', w - 6 * dpr, labelY);

			// Horizontal dB guide lines
			heroCtx.strokeStyle = isDark ? 'rgba(255, 255, 255, 0.04)' : 'rgba(0, 0, 0, 0.05)';
			[0.25, 0.5, 0.75].forEach(ratio => {
				const y = bottomY - ratio * plotH;
				heroCtx.beginPath();
				heroCtx.moveTo(0, y);
				heroCtx.lineTo(w, y);
				heroCtx.stroke();
			});

			if (!fftAnalyser || !audioCtx) {
				// Flat baseline
				heroCtx.strokeStyle = isDark ? 'rgba(249, 115, 22, 0.25)' : 'rgba(234, 88, 12, 0.3)';
				heroCtx.beginPath();
				heroCtx.moveTo(0, bottomY);
				heroCtx.lineTo(w, bottomY);
				heroCtx.stroke();
				return;
			}

			// Handle sound production and smooth decay when stopped
			const isProducingSound = activeMode !== 'none' || (currentSourceMode !== 'sim' && !!micStream);
			if (isProducingSound) {
				spectrumDecayFactor = 1.0;
			} else {
				spectrumDecayFactor *= 0.82;
				if (spectrumDecayFactor < 0.005) {
					spectrumDecayFactor = 0.0;
				}
			}

			if (spectrumDecayFactor === 0.0) {
				// Flat resting baseline
				heroCtx.strokeStyle = isDark ? 'rgba(249, 115, 22, 0.25)' : 'rgba(234, 88, 12, 0.3)';
				heroCtx.beginPath();
				heroCtx.moveTo(0, bottomY);
				heroCtx.lineTo(w, bottomY);
				heroCtx.stroke();
				return;
			}

			const binCount = fftAnalyser.frequencyBinCount;
			const freqData = new Uint8Array(binCount);
			fftAnalyser.getByteFrequencyData(freqData);

			const sampleRate = audioCtx.sampleRate;
			const binWidth = (sampleRate / 2) / binCount;

			const stepPx = Math.max(1, Math.round(w / 300));
			const yPoints: number[] = [];

			for (let x = 0; x <= w; x += stepPx) {
				const normX0 = Math.max(0, (x - stepPx * 0.5) / w);
				const normX1 = Math.min(1, (x + stepPx * 0.5) / w);
				const hz0 = Math.pow(10, logMin + normX0 * logRange);
				const hz1 = Math.pow(10, logMin + normX1 * logRange);
				const binStart = Math.max(0, Math.floor(hz0 / binWidth));
				const binEnd = Math.min(binCount - 1, Math.ceil(hz1 / binWidth));

				let val = 0;
				if (binEnd > binStart) {
					for (let b = binStart; b <= binEnd; b++) {
						if (freqData[b] > val) val = freqData[b];
					}
				} else {
					const hz = Math.pow(10, logMin + (x / w) * logRange);
					const binExact = Math.min(binCount - 1, Math.max(0, hz / binWidth));
					const b0 = Math.floor(binExact);
					const b1 = Math.min(binCount - 1, b0 + 1);
					const frac = binExact - b0;
					val = freqData[b0] * (1 - frac) + freqData[b1] * frac;
				}

				val *= spectrumDecayFactor;
				const norm = Math.min(1.0, Math.pow(val / 255, 0.78) * 1.25);
				const y = bottomY - norm * plotH;
				yPoints.push(y);
			}

			// Build filled polygon
			heroCtx.beginPath();
			heroCtx.moveTo(0, bottomY);
			for (let i = 0, x = 0; x <= w; x += stepPx, i++) {
				heroCtx.lineTo(x, yPoints[i]);
			}
			heroCtx.lineTo(w, bottomY);
			heroCtx.closePath();

			const grad = heroCtx.createLinearGradient(0, 0, 0, bottomY);
			grad.addColorStop(0, isDark ? 'rgba(249, 115, 22, 0.55)' : 'rgba(249, 115, 22, 0.35)');
			grad.addColorStop(0.65, isDark ? 'rgba(249, 115, 22, 0.2)' : 'rgba(249, 115, 22, 0.12)');
			grad.addColorStop(1, isDark ? 'rgba(249, 115, 22, 0.02)' : 'rgba(249, 115, 22, 0.01)');
			heroCtx.fillStyle = grad;
			heroCtx.fill();

			// Curve stroke with orange glow
			heroCtx.strokeStyle = isDark ? '#f97316' : '#ea580c';
			heroCtx.lineWidth = 2.0;
			heroCtx.shadowColor = isDark ? '#f97316' : 'rgba(234, 88, 12, 0.3)';
			heroCtx.shadowBlur = isDark ? 6 : 2;
			heroCtx.beginPath();
			for (let i = 0, x = 0; x <= w; x += stepPx, i++) {
				if (x === 0) heroCtx.moveTo(x, yPoints[i]);
				else heroCtx.lineTo(x, yPoints[i]);
			}
			heroCtx.stroke();
			heroCtx.shadowBlur = 0;

			// Tuning target frequency marker
			if (activeMode === 'tone' || activeMode === 'sweep') {
				const targetX = freqToX(currentToneHz);
				heroCtx.strokeStyle = isDark ? 'rgba(249, 115, 22, 0.45)' : 'rgba(234, 88, 12, 0.5)';
				heroCtx.lineWidth = 1;
				heroCtx.setLineDash([2, 2]);
				heroCtx.beginPath();
				heroCtx.moveTo(targetX, 0);
				heroCtx.lineTo(targetX, bottomY);
				heroCtx.stroke();
				heroCtx.setLineDash([]);
			}
		}

		// -------------------------------------------------------------
		// VISUALIZER 3: 2D SPECTROGRAM WATERFALL (DOWNWARD HEATMAP)
		// -------------------------------------------------------------
		function updateSpectrogramBuffer() {
			if (!heroCanvas) return;
			const w = heroCanvas.width;
			const h = heroCanvas.height;
			const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			const bottomY = Math.round(h - 22 * dpr);
			const waterfallH = Math.max(1, bottomY);

			if (currentThemeIsDark !== isDark) {
				currentThemeIsDark = isDark;
				if (specHistoryCtx && specHistoryCanvas) {
					specHistoryCtx.fillStyle = isDark ? '#09090b' : '#f8fafc';
					specHistoryCtx.fillRect(0, 0, specHistoryCanvas.width, specHistoryCanvas.height);
				}
			}

			if (!specHistoryCanvas || specHistoryCanvas.width !== w || specHistoryCanvas.height !== waterfallH) {
				specHistoryCanvas = document.createElement('canvas');
				specHistoryCanvas.width = w;
				specHistoryCanvas.height = waterfallH;
				specHistoryCtx = specHistoryCanvas.getContext('2d', { willReadFrequently: true });
				if (specHistoryCtx) {
					specHistoryCtx.fillStyle = isDark ? '#09090b' : '#f8fafc';
					specHistoryCtx.fillRect(0, 0, w, waterfallH);
				}
			}

			if (!specHistoryCtx || !specHistoryCanvas) return;

			const now = performance.now();
			const dt = now - lastSpecTime;
			const scrollSpeed = 1;

			if (dt >= 15) {
				lastSpecTime = now;

				// Waterfall scrolls downward: live audio enters at top (y = 0) and flows down
				specHistoryCtx.drawImage(
					specHistoryCanvas,
					0, 0, w, waterfallH - scrollSpeed,
					0, scrollSpeed, w, waterfallH - scrollSpeed
				);

				// Blank new top row
				specHistoryCtx.fillStyle = isDark ? '#09090b' : '#f8fafc';
				specHistoryCtx.fillRect(0, 0, w, scrollSpeed);

				if (fftAnalyser && audioCtx) {
					const binCount = fftAnalyser.frequencyBinCount;
					const freqData = new Uint8Array(binCount);
					fftAnalyser.getByteFrequencyData(freqData);

					const sampleRate = audioCtx.sampleRate;
					const binWidth = (sampleRate / 2) / binCount;

					const minFreq = 20;
					const maxFreq = 20000;
					const logMin = Math.log10(minFreq);
					const logMax = Math.log10(maxFreq);
					const logRange = logMax - logMin;

					const imgData = specHistoryCtx.createImageData(w, scrollSpeed);
					const data = imgData.data;

					for (let x = 0; x < w; x++) {
						const normX0 = Math.max(0, (x - 0.5) / Math.max(1, w - 1));
						const normX1 = Math.min(1, (x + 0.5) / Math.max(1, w - 1));
						const hz0 = Math.pow(10, logMin + normX0 * logRange);
						const hz1 = Math.pow(10, logMin + normX1 * logRange);
						const binStart = Math.max(0, Math.floor(hz0 / binWidth));
						const binEnd = Math.min(binCount - 1, Math.ceil(hz1 / binWidth));

						let rawVal = 0;
						if (binEnd > binStart) {
							for (let b = binStart; b <= binEnd; b++) {
								if (freqData[b] > rawVal) rawVal = freqData[b];
							}
						} else {
							const hz = Math.pow(10, logMin + (x / Math.max(1, w - 1)) * logRange);
							const binExact = Math.min(binCount - 1, Math.max(0, hz / binWidth));
							const b0 = Math.floor(binExact);
							const b1 = Math.min(binCount - 1, b0 + 1);
							const frac = binExact - b0;
							rawVal = freqData[b0] * (1 - frac) + freqData[b1] * frac;
						}

						rawVal *= spectrumDecayFactor;
						const val = Math.min(255, Math.pow(rawVal / 255, 0.85) * 260);

						let r = isDark ? 9 : 248;
						let g = isDark ? 9 : 250;
						let b = isDark ? 11 : 252;
						let a = 255;

						if (val > 8) {
							if (isDark) {
								if (val < 65) {
									const t = val / 65;
									r = Math.round(12 + t * 95);
									g = Math.round(12 + t * 25);
									b = Math.round(25 + t * 50);
								} else if (val < 145) {
									const t = (val - 65) / 80;
									r = Math.round(107 + t * 142);
									g = Math.round(37 + t * 78);
									b = Math.round(75 - t * 53);
								} else if (val < 215) {
									const t = (val - 145) / 70;
									r = Math.round(249 + t * 2);
									g = Math.round(115 + t * 76);
									b = Math.round(22 + t * 14);
								} else {
									const t = (val - 215) / 40;
									r = Math.round(251 + t * 4);
									g = Math.round(191 + t * 64);
									b = Math.round(36 + t * 219);
								}
							} else {
								if (val < 65) {
									const t = val / 65;
									r = Math.round(248 - t * 80);
									g = Math.round(250 - t * 70);
									b = Math.round(252 - t * 40);
								} else if (val < 145) {
									const t = (val - 65) / 80;
									r = Math.round(168 + t * 67);
									g = Math.round(180 - t * 50);
									b = Math.round(212 - t * 180);
								} else if (val < 215) {
									const t = (val - 145) / 70;
									r = Math.round(235 - t * 15);
									g = Math.round(130 - t * 92);
									b = Math.round(32 + t * 6);
								} else {
									const t = (val - 215) / 40;
									r = Math.round(220 - t * 80);
									g = Math.round(38 - t * 20);
									b = Math.round(38 - t * 18);
								}
							}
						}

						for (let s = 0; s < scrollSpeed; s++) {
							const idx = (s * w + x) * 4;
							data[idx] = r;
							data[idx + 1] = g;
							data[idx + 2] = b;
							data[idx + 3] = a;
						}
					}
					specHistoryCtx.putImageData(imgData, 0, 0);
				}
			}
		}

		function renderSpectrogramScope() {
			updateSpectrogramBuffer();
			if (!heroCtx || !heroCanvas || !specHistoryCanvas) return;
			const w = heroCanvas.width;
			const h = heroCanvas.height;
			const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			const bottomY = Math.round(h - 22 * dpr);
			const labelY = Math.round(h - 6 * dpr);

			// Clear and fill canvas background
			heroCtx.clearRect(0, 0, w, h);
			heroCtx.fillStyle = isDark ? '#09090b' : '#f8fafc';
			heroCtx.fillRect(0, 0, w, h);

			// Blit waterfall history
			heroCtx.drawImage(specHistoryCanvas, 0, 0);

			const minFreq = 20;
			const maxFreq = 20000;
			const logMin = Math.log10(minFreq);
			const logMax = Math.log10(maxFreq);
			const logRange = logMax - logMin;
			const freqToX = (hz: number) => {
				const clamped = Math.max(minFreq, Math.min(maxFreq, hz));
				return ((Math.log10(clamped) - logMin) / logRange) * w;
			};

			// Horizontal divider above bottom gutter
			heroCtx.strokeStyle = isDark ? 'rgba(255, 255, 255, 0.05)' : 'rgba(0, 0, 0, 0.06)';
			heroCtx.lineWidth = 1;
			heroCtx.beginPath();
			heroCtx.moveTo(0, bottomY);
			heroCtx.lineTo(w, bottomY);
			heroCtx.stroke();

			// Vertical grid lines (100 Hz, 1 kHz, 10 kHz)
			heroCtx.strokeStyle = isDark ? 'rgba(255, 255, 255, 0.08)' : 'rgba(0, 0, 0, 0.1)';
			heroCtx.lineWidth = 1;
			heroCtx.setLineDash([2, 4]);
			[100, 1000, 10000].forEach((hz) => {
				const x = freqToX(hz);
				heroCtx.beginPath();
				heroCtx.moveTo(x, 0);
				heroCtx.lineTo(x, bottomY);
				heroCtx.stroke();
			});
			heroCtx.setLineDash([]);

			// Frequency labels matching Frequency Generator (20 Hz, 100 Hz, 1 kHz, 10 kHz, 20 kHz)
			const fontSize = Math.round(9.5 * dpr);
			heroCtx.font = `${fontSize}px monospace`;
			heroCtx.fillStyle = isDark ? 'rgba(255, 255, 255, 0.35)' : 'rgba(0, 0, 0, 0.55)';

			heroCtx.textAlign = 'left';
			heroCtx.fillText('20 Hz', 6 * dpr, labelY);

			heroCtx.textAlign = 'center';
			heroCtx.fillText('100 Hz', freqToX(100), labelY);
			heroCtx.fillText('1 kHz', freqToX(1000), labelY);

			heroCtx.textAlign = 'right';
			heroCtx.fillText('10 kHz', freqToX(10000) - 4 * dpr, labelY);
			heroCtx.fillText('20 kHz', w - 6 * dpr, labelY);

			// Tuning target cursor
			if (activeMode === 'tone' || activeMode === 'sweep') {
				const targetX = freqToX(currentToneHz);
				heroCtx.strokeStyle = isDark ? 'rgba(249, 115, 22, 0.45)' : 'rgba(234, 88, 12, 0.5)';
				heroCtx.lineWidth = 1;
				heroCtx.setLineDash([2, 2]);
				heroCtx.beginPath();
				heroCtx.moveTo(targetX, 0);
				heroCtx.lineTo(targetX, bottomY);
				heroCtx.stroke();
				heroCtx.setLineDash([]);
			}
		}

		// -------------------------------------------------------------
		// DEDICATED HORIZONTAL STEREO PEAK / VU METER (FULL WIDTH)
		// -------------------------------------------------------------
		function renderStereoMeter() {
			if (!meterCtx || !meterCanvas) return;
			const w = meterCanvas.width;
			const h = meterCanvas.height;
			const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
			const dpr = Math.min(window.devicePixelRatio || 1, 2);

			meterCtx.clearRect(0, 0, w, h);
			meterCtx.fillStyle = isDark ? '#09090b' : '#f8fafc';
			meterCtx.fillRect(0, 0, w, h);

			const now = performance.now();
			let currentPeakL = 0;
			let currentPeakR = 0;

			if (analyserLeft && analyserRight && activeMode !== 'none') {
				const bufLen = analyserLeft.fftSize;
				const timeL = new Float32Array(bufLen);
				const timeR = new Float32Array(bufLen);
				analyserLeft.getFloatTimeDomainData(timeL);
				analyserRight.getFloatTimeDomainData(timeR);

				for (let i = 0; i < bufLen; i++) {
					const absL = Math.abs(timeL[i]);
					const absR = Math.abs(timeR[i]);
					if (absL > currentPeakL) currentPeakL = absL;
					if (absR > currentPeakR) currentPeakR = absR;
				}
			}

			// Instantaneous dBFS (clamped to [-60 dBFS .. 0 dBFS])
			const dbL = currentPeakL > 0.0005 ? Math.max(-60, 20 * Math.log10(currentPeakL)) : -60;
			const dbR = currentPeakR > 0.0005 ? Math.max(-60, 20 * Math.log10(currentPeakR)) : -60;

			// Smooth meter ballistics (instant attack, smooth release decay ~1.25 dB/frame)
			if (dbL >= smoothL) smoothL = dbL;
			else smoothL = Math.max(-60, smoothL - 1.25);

			if (dbR >= smoothR) smoothR = dbR;
			else smoothR = Math.max(-60, smoothR - 1.25);

			// Peak Hold needle logic (hold 750ms, then drop with gravity)
			if (dbL >= peakHoldL) {
				peakHoldL = dbL;
				peakHoldTimeL = now;
			} else if (now - peakHoldTimeL > 750) {
				peakHoldL = Math.max(-60, peakHoldL - 0.75);
			}

			if (dbR >= peakHoldR) {
				peakHoldR = dbR;
				peakHoldTimeR = now;
			} else if (now - peakHoldTimeR > 750) {
				peakHoldR = Math.max(-60, peakHoldR - 0.75);
			}

			// Horizontal Layout Dimensions
			const labelW = Math.round(18 * dpr);
			const readoutW = Math.round(54 * dpr);
			const trackX0 = labelW + Math.round(6 * dpr);
			const trackX1 = w - readoutW - Math.round(4 * dpr);
			const trackW = Math.max(10, trackX1 - trackX0);

			const barH = Math.round(7 * dpr);
			const row1Y = Math.round(7 * dpr);
			const row2Y = Math.round(19 * dpr);
			const tickTopY = Math.round(31 * dpr);
			const tickBottomY = Math.round(36 * dpr);
			const textY = Math.round(39 * dpr);

			const row1Center = row1Y + barH / 2;
			const row2Center = row2Y + barH / 2;
			const labelX = Math.round(5 * dpr);

			// Helper: dB to X coordinate
			const dbToX = (val: number) => {
				const clamped = Math.max(-60, Math.min(0, val));
				const norm = (clamped + 60) / 60;
				return trackX0 + norm * trackW;
			};

			// Horizontal Gradient for active meter bars (Green -> Yellow -> Red)
			const grad = meterCtx.createLinearGradient(trackX0, 0, trackX1, 0);
			grad.addColorStop(0.0, '#15803d');   // Dark green (-60 dB)
			grad.addColorStop(0.65, '#22c55e');  // Vibrant green (-20 dB)
			grad.addColorStop(0.88, '#eab308');  // Yellow (-6 dB)
			grad.addColorStop(0.95, '#f97316');  // Amber (-3 dB)
			grad.addColorStop(1.0, '#ef4444');   // Red (0 dB)

			// ROW 1: LEFT CHANNEL (L)
			meterCtx.font = `bold ${Math.round(11 * dpr)}px sans-serif`;
			meterCtx.textAlign = 'left';
			meterCtx.textBaseline = 'middle';
			meterCtx.fillStyle = isDark ? '#38bdf8' : '#0284c7';
			meterCtx.fillText('L', labelX, row1Center);

			// Track background
			meterCtx.fillStyle = isDark ? 'rgba(255, 255, 255, 0.08)' : 'rgba(0, 0, 0, 0.08)';
			meterCtx.fillRect(trackX0, row1Y, trackW, barH);

			// Active bar fill
			const fillW_L = ((smoothL + 60) / 60) * trackW;
			if (fillW_L > 0) {
				meterCtx.fillStyle = grad;
				meterCtx.fillRect(trackX0, row1Y, fillW_L, barH);
			}

			// Peak Hold Needle
			if (peakHoldL > -58) {
				meterCtx.fillStyle = isDark ? '#ffffff' : '#0f172a';
				meterCtx.fillRect(Math.round(dbToX(peakHoldL)), row1Y, Math.round(1.5 * dpr), barH);
			}

			// Numeric dB readout for Left Channel
			meterCtx.textAlign = 'right';
			meterCtx.textBaseline = 'middle';
			if (smoothL <= -58) {
				meterCtx.font = `bold ${Math.round(16 * dpr)}px sans-serif`;
				meterCtx.fillStyle = isDark ? 'rgba(255, 255, 255, 0.45)' : 'rgba(0, 0, 0, 0.4)';
				meterCtx.fillText('−∞', w - Math.round(5 * dpr), row1Center);
			} else {
				meterCtx.font = `bold ${Math.round(11 * dpr)}px monospace`;
				meterCtx.fillStyle = isDark ? '#38bdf8' : '#0284c7';
				meterCtx.fillText(`${Math.round(smoothL)} dB`, w - Math.round(5 * dpr), row1Center);
			}

			// ROW 2: RIGHT CHANNEL (R)
			meterCtx.font = `bold ${Math.round(11 * dpr)}px sans-serif`;
			meterCtx.textAlign = 'left';
			meterCtx.textBaseline = 'middle';
			meterCtx.fillStyle = isDark ? '#f59e0b' : '#d97706';
			meterCtx.fillText('R', labelX, row2Center);

			// Track background
			meterCtx.fillStyle = isDark ? 'rgba(255, 255, 255, 0.08)' : 'rgba(0, 0, 0, 0.08)';
			meterCtx.fillRect(trackX0, row2Y, trackW, barH);

			// Active bar fill
			const fillW_R = ((smoothR + 60) / 60) * trackW;
			if (fillW_R > 0) {
				meterCtx.fillStyle = grad;
				meterCtx.fillRect(trackX0, row2Y, fillW_R, barH);
			}

			// Peak Hold Needle
			if (peakHoldR > -58) {
				meterCtx.fillStyle = isDark ? '#ffffff' : '#0f172a';
				meterCtx.fillRect(Math.round(dbToX(peakHoldR)), row2Y, Math.round(1.5 * dpr), barH);
			}

			// Numeric dB readout for Right Channel
			meterCtx.textAlign = 'right';
			meterCtx.textBaseline = 'middle';
			if (smoothR <= -58) {
				meterCtx.font = `bold ${Math.round(16 * dpr)}px sans-serif`;
				meterCtx.fillStyle = isDark ? 'rgba(255, 255, 255, 0.45)' : 'rgba(0, 0, 0, 0.4)';
				meterCtx.fillText('−∞', w - Math.round(5 * dpr), row2Center);
			} else {
				meterCtx.font = `bold ${Math.round(11 * dpr)}px monospace`;
				meterCtx.fillStyle = isDark ? '#f59e0b' : '#d97706';
				meterCtx.fillText(`${Math.round(smoothR)} dB`, w - Math.round(5 * dpr), row2Center);
			}

			// SCALE TICKS & DB LABELS (Bottom Row)
			const isNarrow = trackW < 300 * dpr;
			const marks = isNarrow
				? [-60, -36, -24, -12, -6, 0]
				: [-60, -48, -36, -24, -18, -12, -6, -3, 0];

			meterCtx.textAlign = 'center';

			marks.forEach((m) => {
				const x = Math.round(dbToX(m));
				const isZero = m === 0;
				const isNeg3 = m === -3;
				const isNeg6 = m === -6;
				const isNegInf = m === -60;

				meterCtx.strokeStyle = isZero ? '#ef4444' : (isNeg3 ? '#f97316' : (isNeg6 ? (isDark ? '#eab308' : '#ca8a04') : (isDark ? 'rgba(255, 255, 255, 0.45)' : 'rgba(0, 0, 0, 0.25)')));
				meterCtx.lineWidth = Math.max(1, Math.round(1.5 * dpr));
				meterCtx.beginPath();
				meterCtx.moveTo(x, tickTopY);
				meterCtx.lineTo(x, tickBottomY);
				meterCtx.stroke();

				meterCtx.fillStyle = isZero ? '#ef4444' : (isNeg3 ? '#f97316' : (isNeg6 ? (isDark ? '#eab308' : '#ca8a04') : (isDark ? 'rgba(255, 255, 255, 0.8)' : 'rgba(0, 0, 0, 0.7)')));

				if (isNegInf) {
					meterCtx.font = `bold ${Math.round(15.5 * dpr)}px sans-serif`;
					meterCtx.textBaseline = 'middle';
					meterCtx.fillText('−∞', x, textY + Math.round(4 * dpr));
				} else {
					meterCtx.font = `bold ${Math.round(9.5 * dpr)}px monospace`;
					meterCtx.textBaseline = 'top';
					const label = isZero ? '0' : `${m}`;
					meterCtx.fillText(label, x, textY);
				}
			});
		}

		// Main visualizer animation loop
		function renderActiveVisualizer(force?: boolean | number) {
			const shouldRender = isAudioVisible || force === true;
			if (!shouldRender) {
				rafVisualizerId = null;
				return;
			}

			// Keep spectrogram waterfall recording continuously in background once audio is enabled
			if (audioCtx) {
				updateSpectrogramBuffer();
			}

			if (activeHeroMode === 'waveform') {
				renderWaveformScope();
			} else if (activeHeroMode === 'spectrum') {
				renderSpectrumScope();
			} else {
				renderSpectrogramScope();
			}

			// Render horizontal stereo VU meter
			renderStereoMeter();

			// If audio is actively playing or VU meter / spectrum are still decaying, keep animating
			const isDecaying = smoothL > -59.5 || smoothR > -59.5 || spectrumDecayFactor > 0;
			const isProducing = activeMode !== 'none' || isSweeping || !!micStream;

			if ((isProducing || isDecaying) && isAudioVisible) {
				rafVisualizerId = requestAnimationFrame(renderActiveVisualizer);
			} else {
				rafVisualizerId = null;
			}
		}

		// Responsive canvas resizing (DPR Retina scaling)
		function resizeCanvases() {
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			if (heroCanvas) {
				const rect = heroCanvas.getBoundingClientRect();
				const targetW = Math.round((rect.width || 600) * dpr);
				const targetH = Math.round((rect.height || 310) * dpr);
				if (heroCanvas.width !== targetW || heroCanvas.height !== targetH) {
					heroCanvas.width = targetW;
					heroCanvas.height = targetH;
				}
			}
			if (meterCanvas) {
				const rect = meterCanvas.getBoundingClientRect();
				const targetW = Math.round((rect.width || 600) * dpr);
				const targetH = Math.round((rect.height || 58) * dpr);
				if (meterCanvas.width !== targetW || meterCanvas.height !== targetH) {
					meterCanvas.width = targetW;
					meterCanvas.height = targetH;
				}
			}
			if (!rafVisualizerId) {
				renderActiveVisualizer(true);
			}
		}
		resizeCanvases();
		window.addEventListener('resize', resizeCanvases, { passive: true });

		const heroBox = document.getElementById('hero-canvas-box');
		if (heroBox && window.ResizeObserver) {
			const ro = new ResizeObserver(() => {
				resizeCanvases();
			});
			ro.observe(heroBox);
		}

		// 0% CPU consumption when off-screen or idle
		const cardEl = document.getElementById('audio-lab');
		if (cardEl && window.IntersectionObserver) {
			const obs = new IntersectionObserver((entries) => {
				entries.forEach((e) => {
					isAudioVisible = e.isIntersecting;
					if (isAudioVisible) {
						if (!rafVisualizerId) {
							renderActiveVisualizer();
						}
					} else if (rafVisualizerId) {
						cancelAnimationFrame(rafVisualizerId);
						rafVisualizerId = null;
					}
				});
			}, { threshold: 0.05 });
			obs.observe(cardEl);
		} else {
			isAudioVisible = true;
			renderActiveVisualizer();
		}

		// Redraw canvas instantly when theme swaps while idle
		const themeObserver = new MutationObserver((mutations) => {
			for (const mutation of mutations) {
				if (mutation.type === 'attributes' && mutation.attributeName === 'data-theme') {
					if (!rafVisualizerId) {
						renderActiveVisualizer(true);
					}
					break;
				}
			}
		});
		themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

		document.addEventListener('astro:before-swap', () => {
			stopAllAudio();
			stopMicrophone();
			themeObserver.disconnect();
		}, { once: true });
	}

	setupAudioTest();
	document.addEventListener('astro:page-load', setupAudioTest);
</script>

