---
// AudioTest.astro - DAC Latency, Stereo Isolation, 180° Polarity & Frequency Sweeper
---

<section class="card audio-test-card" id="audio-lab">
	<div class="card-header-wrap">
		<h2 class="card-title">
			<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" class="card-icon">
				<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
				<path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/>
			</svg>
			Audio Test
		</h2>

		<div class="header-actions">
			<div class="volume-control-wrap" title="Output Volume (Safe Ceiling -18 dBFS)">
				<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" class="vol-icon">
					<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
					<path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
				</svg>
				<input type="range" id="audio-volume-slider" min="0" max="1" step="0.05" value="0.35" class="vol-slider" aria-label="Output Volume" />
				<span id="audio-vol-text" class="vol-text mono">35%</span>
			</div>
		</div>
	</div>

	<p class="benchmark-desc">
		Test DAC hardware latency, channel separation, 180&deg; wiring phase, and 20 Hz&ndash;20 kHz frequency response.
	</p>

	<!-- TWO-COLUMN WORKBENCH -->
	<div class="audio-workbench-grid">
		<!-- COLUMN 1: POLARITY & CHANNEL ISOLATION -->
		<div class="audio-col">
			<div class="col-head">
				<div class="col-head-left">
					<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" class="col-icon">
						<circle cx="12" cy="12" r="10"/>
						<line x1="12" y1="2" x2="12" y2="22"/>
					</svg>
					<span class="col-title">Stereo &amp; Phase Test</span>
				</div>
				<div class="segmented-control" role="group" aria-label="Stereo Visualizer Mode">
					<button class="seg-btn active" id="btn-mode-scope" data-stereo-mode="scope" type="button">Scope</button>
					<button class="seg-btn" id="btn-mode-spectrogram" data-stereo-mode="spectrogram" type="button">Spectrogram</button>
				</div>
			</div>

			<!-- PHASE LISSAJOUS / 2D SPECTROGRAM CANVAS -->
			<div class="lissajous-box">
				<canvas id="lissajous-canvas" width="400" height="150"></canvas>
				<div class="lissajous-overlay">
					<span id="lissajous-mode-label" class="lissajous-label">Standby &bull; Select Channel Below</span>
				</div>
			</div>

			<!-- POLARITY BUTTON GRID -->
			<div class="tone-buttons-grid">
				<button class="tone-btn" id="btn-tone-left" type="button">
					<span class="tone-pill">L</span>
					<span class="tone-name">Left Channel</span>
				</button>

				<button class="tone-btn" id="btn-tone-right" type="button">
					<span class="tone-pill">R</span>
					<span class="tone-name">Right Channel</span>
				</button>

				<button class="tone-btn" id="btn-tone-inphase" type="button">
					<span class="tone-pill">0&deg;</span>
					<span class="tone-name">Center Channel</span>
				</button>

				<button class="tone-btn" id="btn-tone-outphase" type="button">
					<span class="tone-pill warn">180&deg;</span>
					<span class="tone-name">Out-of-Phase</span>
				</button>
			</div>
		</div>

		<!-- COLUMN 2: FREQUENCY GENERATOR -->
		<div class="audio-col">
			<div class="col-head">
				<div class="col-head-left">
					<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" class="col-icon">
						<path d="M2 12h4l3 8 4-16 3 8h6"/>
					</svg>
					<span class="col-title">Frequency Generator</span>
				</div>
				<div class="segmented-control" role="group" aria-label="Audio Waveform">
					<button class="seg-btn active" data-wave="sine" type="button">Sine</button>
					<button class="seg-btn" data-wave="pink" type="button" title="Pink Noise (1/f Equal Energy)">Pink</button>
					<button class="seg-btn" data-wave="white" type="button" title="White Noise">White</button>
				</div>
			</div>

			<!-- REAL FREQUENCY RESPONSE SPECTRUM HERO -->
			<div class="spectrum-box">
				<canvas id="spectrum-canvas" width="400" height="150"></canvas>
				<div class="spectrum-overlay">
					<div class="spectrum-hud-badge">
						<span id="freq-num" class="freq-num mono">1,000</span>
						<span class="freq-unit">Hz</span>
						<span class="hud-sep">&bull;</span>
						<span id="freq-band-tag" class="freq-band-tag">Midrange (1 kHz Reference)</span>
					</div>
				</div>
			</div>

			<!-- SCRUB SLIDER -->
			<div class="slider-row">
				<input type="range" id="freq-slider" min="20" max="20000" step="1" value="1000" class="freq-slider" aria-label="Frequency Slider" />
			</div>

			<!-- PRESET PILLS (Symmetrical 6-column grid) -->
			<div class="freq-presets-grid">
				<button class="freq-pill" data-hz="20" type="button"><span class="pill-hz mono">20 Hz</span><span class="pill-tag">Sub</span></button>
				<button class="freq-pill" data-hz="60" type="button"><span class="pill-hz mono">60 Hz</span><span class="pill-tag">Bass</span></button>
				<button class="freq-pill" data-hz="250" type="button"><span class="pill-hz mono">250 Hz</span><span class="pill-tag">Mid</span></button>
				<button class="freq-pill active" data-hz="1000" type="button"><span class="pill-hz mono">1 kHz</span><span class="pill-tag">Ref</span></button>
				<button class="freq-pill" data-hz="8000" type="button"><span class="pill-hz mono">8 kHz</span><span class="pill-tag">Pres</span></button>
				<button class="freq-pill" data-hz="16000" type="button"><span class="pill-hz mono">16 kHz</span><span class="pill-tag">Treble</span></button>
			</div>

			<!-- SWEEP ACTION ROW -->
			<div class="sweep-actions-row">
				<button id="toggle-tone-btn" class="sweep-btn" type="button">
					<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" id="toggle-tone-icon">
						<polygon points="5 3 19 12 5 21 5 3"/>
					</svg>
					<span id="toggle-tone-text">Play Tone</span>
				</button>

				<button id="run-sweep-btn" class="sweep-btn sweep-auto-btn" type="button">
					<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
						<polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
						<polyline points="17 6 23 6 23 12"/>
					</svg>
					<span id="run-sweep-text">Auto Sweep</span>
				</button>
			</div>
		</div>
	</div>
</section>

<script>
	function setupAudioTest() {
		let audioCtx: AudioContext | null = null;
		let audioBus: GainNode | null = null;
		let masterGain: GainNode | null = null;
		let compressor: DynamicsCompressorNode | null = null;

		let currentOsc: OscillatorNode | null = null;
		let noiseNode: AudioNode | null = null;
		let pannerNode: StereoPannerNode | null = null;
		let leftGain: GainNode | null = null;
		let rightGain: GainNode | null = null;

		let activeStereoMode: 'scope' | 'spectrogram' = 'scope';
		let activeMode: 'none' | 'left' | 'right' | 'inphase' | 'outphase' | 'tone' | 'sweep' = 'none';
		let activeWave: 'sine' | 'pink' | 'white' = 'sine';
		let isSweeping = false;
		let sweepRafId: number | null = null;

		// UI references
		const modeScopeBtn = document.getElementById('btn-mode-scope');
		const modeSpectrogramBtn = document.getElementById('btn-mode-spectrogram');
		const volSlider = document.getElementById('audio-volume-slider') as HTMLInputElement;
		const volText = document.getElementById('audio-vol-text');

		const freqNumEl = document.getElementById('freq-num');
		const freqBandEl = document.getElementById('freq-band-tag');
		const freqSlider = document.getElementById('freq-slider') as HTMLInputElement;
		const toggleToneBtn = document.getElementById('toggle-tone-btn');
		const toggleToneText = document.getElementById('toggle-tone-text');
		const runSweepBtn = document.getElementById('run-sweep-btn');
		const runSweepText = document.getElementById('run-sweep-text');

		const lissajousCanvas = document.getElementById('lissajous-canvas') as HTMLCanvasElement;
		const lissajousLabel = document.getElementById('lissajous-mode-label');
		const lissajousCtx = lissajousCanvas?.getContext('2d');

		const spectrumCanvas = document.getElementById('spectrum-canvas') as HTMLCanvasElement;
		const spectrumCtx = spectrumCanvas?.getContext('2d');

		let splitter: ChannelSplitterNode | null = null;
		let analyserLeft: AnalyserNode | null = null;
		let analyserRight: AnalyserNode | null = null;
		let fftAnalyser: AnalyserNode | null = null;

		// Lazy initialize AudioContext on user interaction
		function getAudioContext(): AudioContext {
			if (!audioCtx) {
				const AudioConstructor = window.AudioContext || (window as any).webkitAudioContext;
				audioCtx = new AudioConstructor();

				// Master compressor to prevent clipping / distortion
				compressor = audioCtx.createDynamicsCompressor();
				compressor.threshold.setValueAtTime(-12, audioCtx.currentTime);
				compressor.knee.setValueAtTime(30, audioCtx.currentTime);
				compressor.ratio.setValueAtTime(12, audioCtx.currentTime);
				compressor.attack.setValueAtTime(0.003, audioCtx.currentTime);
				compressor.release.setValueAtTime(0.25, audioCtx.currentTime);

				// Pre-attenuation Audio Bus (Unity Gain 0 dB) for unattenuated visualizer telemetry
				audioBus = audioCtx.createGain();
				audioBus.channelCount = 2;
				audioBus.channelCountMode = 'explicit';
				audioBus.channelInterpretation = 'speakers';

				// Master volume attenuation node for speakers / output
				masterGain = audioCtx.createGain();
				const initialVol = volSlider ? parseFloat(volSlider.value) : 0.35;
				masterGain.gain.setValueAtTime(initialVol * 0.45, audioCtx.currentTime);

				audioBus.connect(masterGain);
				masterGain.connect(compressor);
				compressor.connect(audioCtx.destination);

				// Real Stereo & Phase Vector Scope (Left / Right split)
				splitter = audioCtx.createChannelSplitter(2);
				analyserLeft = audioCtx.createAnalyser();
				analyserRight = audioCtx.createAnalyser();
				analyserLeft.fftSize = 512;
				analyserRight.fftSize = 512;

				audioBus.connect(splitter);
				splitter.connect(analyserLeft, 0);
				splitter.connect(analyserRight, 1);

				// Real Frequency Response FFT Spectrum Analyser (4096-point high-resolution FFT)
				fftAnalyser = audioCtx.createAnalyser();
				fftAnalyser.fftSize = 4096;
				fftAnalyser.smoothingTimeConstant = 0.80;
				fftAnalyser.minDecibels = -80;
				fftAnalyser.maxDecibels = -10;

				audioBus.connect(fftAnalyser);
			}

			if (audioCtx.state === 'suspended') {
				audioCtx.resume().catch(() => {});
			}
			return audioCtx;
		}

		// Visualizer Mode Toggle
		function setStereoVisualizerMode(mode: 'scope' | 'spectrogram') {
			activeStereoMode = mode;
			if (mode === 'scope') {
				modeScopeBtn?.classList.add('active');
				modeSpectrogramBtn?.classList.remove('active');
				if (lissajousLabel && activeMode === 'none') {
					lissajousLabel.textContent = 'Standby • Select Tone Below';
				}
			} else {
				modeSpectrogramBtn?.classList.add('active');
				modeScopeBtn?.classList.remove('active');
				if (lissajousLabel && activeMode === 'none') {
					lissajousLabel.textContent = 'Spectrogram • Live Waterfall';
				}
			}
		}

		modeScopeBtn?.addEventListener('click', () => setStereoVisualizerMode('scope'));
		modeSpectrogramBtn?.addEventListener('click', () => setStereoVisualizerMode('spectrogram'));

		// Update Master Volume
		if (volSlider) {
			volSlider.addEventListener('input', () => {
				const val = parseFloat(volSlider.value);
				if (volText) volText.textContent = `${Math.round(val * 100)}%`;
				if (masterGain && audioCtx) {
					masterGain.gain.setTargetAtTime(val * 0.45, audioCtx.currentTime, 0.03);
				}
			});
		}

		// Voice Audio Buffers for Spoken Tests
		const voiceBufferCache: Record<string, AudioBuffer> = {};
		let voiceLoopTimeout: number | null = null;
		let currentSourceNode: AudioBufferSourceNode | null = null;

		async function loadVoiceBuffer(mode: 'left' | 'right' | 'inphase' | 'outphase'): Promise<AudioBuffer | null> {
			if (voiceBufferCache[mode]) return voiceBufferCache[mode];
			const fileMap: Record<string, string> = {
				left: '/audio/voice-left.mp3',
				right: '/audio/voice-right.mp3',
				inphase: '/audio/voice-center.mp3',
				outphase: '/audio/voice-outphase.mp3',
			};
			try {
				const res = await fetch(fileMap[mode]);
				const arr = await res.arrayBuffer();
				const ctx = getAudioContext();
				const buf = await ctx.decodeAudioData(arr);
				voiceBufferCache[mode] = buf;
				return buf;
			} catch (e) {
				console.error('Failed to load voice buffer', e);
				return null;
			}
		}

		// Stop All Active Audio
		function stopAllAudio() {
			if (sweepRafId) {
				cancelAnimationFrame(sweepRafId);
				sweepRafId = null;
			}
			isSweeping = false;

			if (voiceLoopTimeout) {
				clearTimeout(voiceLoopTimeout);
				voiceLoopTimeout = null;
			}
			if (currentSourceNode) {
				try {
					currentSourceNode.stop();
					currentSourceNode.disconnect();
				} catch (_) {}
				currentSourceNode = null;
			}
			if (currentOsc) {
				try {
					currentOsc.stop();
					currentOsc.disconnect();
				} catch (_) {}
				currentOsc = null;
			}
			if (noiseNode) {
				try {
					noiseNode.disconnect();
				} catch (_) {}
				noiseNode = null;
			}

			activeMode = 'none';
			document.querySelectorAll('.tone-btn').forEach(b => b.classList.remove('active'));
			if (toggleToneBtn) toggleToneBtn.classList.remove('active');
			if (toggleToneText) toggleToneText.textContent = 'Play Tone';
			if (runSweepBtn) runSweepBtn.classList.remove('active');
			if (runSweepText) runSweepText.textContent = 'Auto Sweep';
			if (lissajousLabel) lissajousLabel.textContent = 'Standby • Select Channel Below';
		}

		// Frequency Band Classification
		function updateFrequencyUI(hz: number) {
			if (freqNumEl) freqNumEl.textContent = Math.round(hz).toLocaleString();
			let band = 'Midrange';
			if (hz < 60) band = 'Sub-Bass (Feel more than hear)';
			else if (hz < 250) band = 'Bass / Punch';
			else if (hz < 500) band = 'Low-Mid / Body';
			else if (hz < 2000) band = 'Midrange (Vocal fundamental)';
			else if (hz < 4000) band = 'High-Mid / Clarinet / Attack';
			else if (hz < 8000) band = 'Presence / Sibilance';
			else if (hz < 14000) band = 'Brilliance / Air';
			else band = 'Ultra-High Treble (Hearing limit)';

			if (freqBandEl) freqBandEl.textContent = band;
		}

		// Slider Scrub
		if (freqSlider) {
			freqSlider.addEventListener('input', () => {
				const sliderVal = parseFloat(freqSlider.value);
				// Logarithmic mapping for natural frequency perception
				const minLog = Math.log(20);
				const maxLog = Math.log(20000);
				const scale = (sliderVal - 20) / (20000 - 20);
				const hz = Math.round(Math.exp(minLog + scale * (maxLog - minLog)));

				updateFrequencyUI(hz);
				if (currentOsc && audioCtx) {
					currentOsc.frequency.setTargetAtTime(hz, audioCtx.currentTime, 0.02);
				}
				document.querySelectorAll('.freq-pill').forEach(p => p.classList.remove('active'));
			});
		}

		// Preset Frequency Pills
		const freqPills = document.querySelectorAll('.freq-pill');
		freqPills.forEach((pill) => {
			pill.addEventListener('click', () => {
				freqPills.forEach(p => p.classList.remove('active'));
				pill.classList.add('active');
				const targetHz = parseInt(pill.getAttribute('data-hz') || '1000', 10);
				updateFrequencyUI(targetHz);

				// Reverse map to slider
				const minLog = Math.log(20);
				const maxLog = Math.log(20000);
				const scale = (Math.log(targetHz) - minLog) / (maxLog - minLog);
				if (freqSlider) freqSlider.value = String(Math.round(20 + scale * (20000 - 20)));

				if (currentOsc && audioCtx) {
					currentOsc.frequency.setTargetAtTime(targetHz, audioCtx.currentTime, 0.02);
				}
			});
		});

		// Waveform segmented control
		const waveBtns = document.querySelectorAll('.audio-test-card .seg-btn[data-wave]');
		waveBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				waveBtns.forEach(b => b.classList.remove('active'));
				btn.classList.add('active');
				activeWave = (btn.getAttribute('data-wave') as any) || 'sine';
				if (activeMode === 'tone') {
					startToneGenerator();
				}
			});
		});

		// Play / Pause Frequency Generator
		function startToneGenerator() {
			const ctx = getAudioContext();
			stopAllAudio();
			activeMode = 'tone';

			const hz = parseInt(freqNumEl?.textContent?.replace(/,/g, '') || '1000', 10);

			if (activeWave === 'sine') {
				const osc = ctx.createOscillator();
				osc.type = 'sine';
				osc.frequency.setValueAtTime(hz, ctx.currentTime);
				osc.connect(audioBus || masterGain!);
				osc.start();
				currentOsc = osc;
			} else {
				// Buffer Noise Generator (Pink / White)
				const bufferSize = ctx.sampleRate * 2;
				const noiseBuffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
				const output = noiseBuffer.getChannelData(0);

				if (activeWave === 'white') {
					for (let i = 0; i < bufferSize; i++) {
						output[i] = Math.random() * 2 - 1;
					}
				} else {
					// Pink noise 1/f Paul Kellet filter
					let b0 = 0, b1 = 0, b2 = 0, b3 = 0, b4 = 0, b5 = 0, b6 = 0;
					for (let i = 0; i < bufferSize; i++) {
						const white = Math.random() * 2 - 1;
						b0 = 0.99886 * b0 + white * 0.0555179;
						b1 = 0.99332 * b1 + white * 0.0750759;
						b2 = 0.96900 * b2 + white * 0.1538520;
						b3 = 0.86650 * b3 + white * 0.3104856;
						b4 = 0.55000 * b4 + white * 0.5329522;
						b5 = -0.7616 * b5 - white * 0.0168980;
						output[i] = (b0 + b1 + b2 + b3 + b4 + b5 + b6 + white * 0.5362) * 0.11;
						b6 = white * 0.115926;
					}
				}

				const whiteSource = ctx.createBufferSource();
				whiteSource.buffer = noiseBuffer;
				whiteSource.loop = true;
				whiteSource.connect(audioBus || masterGain!);
				whiteSource.start();
				noiseNode = whiteSource;
			}

			if (toggleToneBtn) toggleToneBtn.classList.add('active');
			if (toggleToneText) toggleToneText.textContent = 'Pause Tone';
			if (lissajousLabel) lissajousLabel.textContent = `Generator Active • ${activeWave.toUpperCase()} • ${hz} Hz`;
		}

		if (toggleToneBtn) {
			toggleToneBtn.addEventListener('click', () => {
				if (activeMode === 'tone') {
					stopAllAudio();
				} else {
					startToneGenerator();
				}
			});
		}

		// Auto Frequency Sweep (20Hz - 20,000Hz over 10 seconds)
		function runAutoSweep() {
			if (isSweeping) {
				stopAllAudio();
				return;
			}
			const ctx = getAudioContext();
			stopAllAudio();
			isSweeping = true;
			activeMode = 'sweep';

			const osc = ctx.createOscillator();
			osc.type = 'sine';
			osc.frequency.setValueAtTime(20, ctx.currentTime);
			osc.frequency.exponentialRampToValueAtTime(20000, ctx.currentTime + 10);
			osc.connect(audioBus || masterGain!);
			osc.start();
			currentOsc = osc;

			if (runSweepBtn) runSweepBtn.classList.add('active');
			if (runSweepText) runSweepText.textContent = 'Stop Sweep';
			if (lissajousLabel) lissajousLabel.textContent = 'Logarithmic Sweep Running (20Hz → 20kHz)...';

			const sweepStart = performance.now();
			function updateSweepProgress() {
				if (!isSweeping) return;
				const elapsed = (performance.now() - sweepStart) / 1000;
				if (elapsed >= 10) {
					stopAllAudio();
					return;
				}
				// Exponential frequency calculation
				const currentSweepHz = 20 * Math.pow(20000 / 20, elapsed / 10);
				updateFrequencyUI(currentSweepHz);

				// Update slider
				const minLog = Math.log(20);
				const maxLog = Math.log(20000);
				const scale = (Math.log(currentSweepHz) - minLog) / (maxLog - minLog);
				if (freqSlider) freqSlider.value = String(Math.round(20 + scale * (20000 - 20)));

				sweepRafId = requestAnimationFrame(updateSweepProgress);
			}
			sweepRafId = requestAnimationFrame(updateSweepProgress);
		}

		if (runSweepBtn) runSweepBtn.addEventListener('click', runAutoSweep);

		// CHANNEL ISOLATION & POLARITY TESTS (Toggleable on/off with spoken voice clips)
		async function playPolarityTone(mode: 'left' | 'right' | 'inphase' | 'outphase') {
			if (activeMode === mode) {
				stopAllAudio();
				return;
			}

			const ctx = getAudioContext();
			stopAllAudio();
			activeMode = mode;

			// Highlight active button
			const btnMap: Record<string, string> = {
				left: 'btn-tone-left',
				right: 'btn-tone-right',
				inphase: 'btn-tone-inphase',
				outphase: 'btn-tone-outphase'
			};
			document.getElementById(btnMap[mode])?.classList.add('active');

			if (lissajousLabel) {
				const labelMap: Record<string, string> = {
					left: 'Voice "Left Channel" • Left Ear Only',
					right: 'Voice "Right Channel" • Right Ear Only',
					inphase: 'Voice "Center Channel" • Center Channel',
					outphase: 'Voice "Out-of-Phase" • 180° Inverted Phase'
				};
				lissajousLabel.textContent = labelMap[mode];
			}

			const buf = await loadVoiceBuffer(mode);
			if (activeMode !== mode) return; // Mode changed or stopped while fetching

			function playVoiceClip() {
				if (activeMode !== mode || !masterGain) return;
				const c = getAudioContext();
				const merger = c.createChannelMerger(2);

				if (buf) {
					const source = c.createBufferSource();
					source.buffer = buf;

					if (mode === 'left') {
						const g = c.createGain();
						g.gain.setValueAtTime(1.0, c.currentTime);
						source.connect(g);
						g.connect(merger, 0, 0); // left ear only
					} else if (mode === 'right') {
						const g = c.createGain();
						g.gain.setValueAtTime(1.0, c.currentTime);
						source.connect(g);
						g.connect(merger, 0, 1); // right ear only
					} else if (mode === 'inphase') {
						const leftG = c.createGain();
						const rightG = c.createGain();
						leftG.gain.setValueAtTime(1.0, c.currentTime);
						rightG.gain.setValueAtTime(1.0, c.currentTime);
						source.connect(leftG);
						source.connect(rightG);
						leftG.connect(merger, 0, 0);
						rightG.connect(merger, 0, 1);
					} else if (mode === 'outphase') {
						const leftG = c.createGain();
						const rightG = c.createGain();
						leftG.gain.setValueAtTime(1.0, c.currentTime);
						rightG.gain.setValueAtTime(-1.0, c.currentTime); // 180° phase inversion
						source.connect(leftG);
						source.connect(rightG);
						leftG.connect(merger, 0, 0);
						rightG.connect(merger, 0, 1);
					}

					merger.connect(audioBus || masterGain);
					source.start();
					currentSourceNode = source;

					source.onended = () => {
						if (activeMode === mode) {
							voiceLoopTimeout = window.setTimeout(() => {
								if (activeMode === mode) playVoiceClip();
							}, 800);
						}
					};
				} else {
					// Fallback to sine wave if audio file fails to load
					const osc = c.createOscillator();
					osc.type = 'sine';
					osc.frequency.setValueAtTime(1000, c.currentTime);
					if (mode === 'left') {
						const leftG = c.createGain();
						leftG.gain.setValueAtTime(1.0, c.currentTime);
						osc.connect(leftG);
						leftG.connect(merger, 0, 0);
					} else if (mode === 'right') {
						const rightG = c.createGain();
						rightG.gain.setValueAtTime(1.0, c.currentTime);
						osc.connect(rightG);
						rightG.connect(merger, 0, 1);
					} else if (mode === 'inphase') {
						osc.connect(merger, 0, 0);
						osc.connect(merger, 0, 1);
					} else if (mode === 'outphase') {
						const leftG = c.createGain();
						const rightG = c.createGain();
						rightG.gain.setValueAtTime(-1.0, c.currentTime);
						osc.connect(leftG);
						osc.connect(rightG);
						leftG.connect(merger, 0, 0);
						rightG.connect(merger, 0, 1);
					}
					merger.connect(audioBus || masterGain);
					osc.start();
					currentOsc = osc;
				}
			}

			playVoiceClip();
		}

		document.getElementById('btn-tone-left')?.addEventListener('click', () => playPolarityTone('left'));
		document.getElementById('btn-tone-right')?.addEventListener('click', () => playPolarityTone('right'));
		document.getElementById('btn-tone-inphase')?.addEventListener('click', () => playPolarityTone('inphase'));
		document.getElementById('btn-tone-outphase')?.addEventListener('click', () => playPolarityTone('outphase'));

		// Responsive canvas resizing (DPR Retina scaling)
		function resizeCanvases() {
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			if (lissajousCanvas) {
				const rect = lissajousCanvas.getBoundingClientRect();
				const targetW = Math.round((rect.width || 400) * dpr);
				const targetH = Math.round(150 * dpr);
				if (lissajousCanvas.width !== targetW || lissajousCanvas.height !== targetH) {
					lissajousCanvas.width = targetW;
					lissajousCanvas.height = targetH;
				}
			}
			if (spectrumCanvas) {
				const rect = spectrumCanvas.getBoundingClientRect();
				const targetW = Math.round((rect.width || 400) * dpr);
				const targetH = Math.round(150 * dpr);
				if (spectrumCanvas.width !== targetW || spectrumCanvas.height !== targetH) {
					spectrumCanvas.width = targetW;
					spectrumCanvas.height = targetH;
				}
			}
		}
		resizeCanvases();
		window.addEventListener('resize', resizeCanvases, { passive: true });

		// REAL-TIME STEREO & PHASE VECTOR SCOPE (Rotated Goniometer: L on Left, R on Right, Center Vertical)
		function renderLissajousScope() {
			if (!lissajousCtx || !lissajousCanvas) return;
			const w = lissajousCanvas.width;
			const h = lissajousCanvas.height;
			const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
			const cx = w / 2;
			const cy = h / 2;
			const radius = Math.min(cx, cy) * 0.82;

			lissajousCtx.clearRect(0, 0, w, h);
			lissajousCtx.fillStyle = isDark ? '#09090b' : '#0c0a09';
			lissajousCtx.fillRect(0, 0, w, h);

			const invSqrt2 = 0.70710678;

			// Center crosshairs: Vertical (0° In-Phase / Mid) and Horizontal (180° Out-of-Phase / Side)
			lissajousCtx.strokeStyle = 'rgba(255, 255, 255, 0.08)';
			lissajousCtx.lineWidth = 1;
			lissajousCtx.beginPath();
			lissajousCtx.moveTo(cx, cy - radius * 0.95);
			lissajousCtx.lineTo(cx, cy + radius * 0.95);
			lissajousCtx.moveTo(cx - radius * 0.95, cy);
			lissajousCtx.lineTo(cx + radius * 0.95, cy);
			lissajousCtx.stroke();

			// 45° Diagonal Channel Axes: Left (top-left) and Right (top-right)
			lissajousCtx.setLineDash([3, 5]);
			lissajousCtx.strokeStyle = 'rgba(255, 255, 255, 0.08)';
			lissajousCtx.beginPath();
			// Left channel diagonal (-45°)
			lissajousCtx.moveTo(cx - radius * invSqrt2 * 0.95, cy - radius * invSqrt2 * 0.95);
			lissajousCtx.lineTo(cx + radius * invSqrt2 * 0.95, cy + radius * invSqrt2 * 0.95);
			// Right channel diagonal (+45°)
			lissajousCtx.moveTo(cx + radius * invSqrt2 * 0.95, cy - radius * invSqrt2 * 0.95);
			lissajousCtx.lineTo(cx - radius * invSqrt2 * 0.95, cy + radius * invSqrt2 * 0.95);
			lissajousCtx.stroke();
			lissajousCtx.setLineDash([]);

			// Axis landmark indicators: Left on left, Right on right, Center at top, Out at sides
			lissajousCtx.font = `${Math.max(9, Math.round(10 * (w / 400)))}px monospace`;
			lissajousCtx.fillStyle = 'rgba(255, 255, 255, 0.35)';
			lissajousCtx.textAlign = 'center';

			// L (Left Channel) at top-left
			lissajousCtx.fillText('L', cx - radius * invSqrt2 * 0.95 - 8, cy - radius * invSqrt2 * 0.95 - 4);
			// R (Right Channel) at top-right
			lissajousCtx.fillText('R', cx + radius * invSqrt2 * 0.95 + 8, cy - radius * invSqrt2 * 0.95 - 4);
			// 0° (In-Phase / Center) at top
			lissajousCtx.fillText('0° (In)', cx, cy - radius * 0.95 - 4);
			// 180° (Out-of-Phase / Invert) at right
			lissajousCtx.textAlign = 'left';
			lissajousCtx.fillText('180° (Out)', cx + radius * 0.95 + 6, cy + 4);

			if (!analyserLeft || !analyserRight) {
				// Standby resting center dot
				lissajousCtx.fillStyle = 'rgba(249, 115, 22, 0.5)';
				lissajousCtx.beginPath();
				lissajousCtx.arc(cx, cy, 2.5, 0, Math.PI * 2);
				lissajousCtx.fill();
				return;
			}

			const bufLen = analyserLeft.fftSize;
			const timeL = new Float32Array(bufLen);
			const timeR = new Float32Array(bufLen);
			analyserLeft.getFloatTimeDomainData(timeL);
			analyserRight.getFloatTimeDomainData(timeR);

			// Calculate RMS energy and Pearson correlation
			let sumSqL = 0;
			let sumSqR = 0;
			let dotProd = 0;
			for (let i = 0; i < bufLen; i++) {
				const l = timeL[i];
				const r = timeR[i];
				sumSqL += l * l;
				sumSqR += r * r;
				dotProd += l * r;
			}
			const rmsL = Math.sqrt(sumSqL / bufLen);
			const rmsR = Math.sqrt(sumSqR / bufLen);
			const maxRms = Math.max(rmsL, rmsR);

			if (maxRms < 0.003) {
				// Resting center dot during silence
				lissajousCtx.fillStyle = 'rgba(249, 115, 22, 0.4)';
				lissajousCtx.beginPath();
				lissajousCtx.arc(cx, cy, 2, 0, Math.PI * 2);
				lissajousCtx.fill();
				return;
			}

			// Color coding by live phase correlation
			const denom = Math.sqrt(sumSqL * sumSqR);
			const correlation = denom > 0.0001 ? (dotProd / denom) : 0;

			let strokeColor = '#38bdf8';
			if (rmsL > 0.01 && rmsR < 0.003) {
				strokeColor = '#38bdf8'; // Left only (cyan)
			} else if (rmsR > 0.01 && rmsL < 0.003) {
				strokeColor = '#f59e0b'; // Right only (amber)
			} else if (correlation > 0.60) {
				strokeColor = '#22c55e'; // In-phase (green)
			} else if (correlation < -0.60) {
				strokeColor = '#ef4444'; // Out-of-phase (red)
			} else {
				strokeColor = '#f97316'; // Stereo spread (orange)
			}

			lissajousCtx.save();
			lissajousCtx.beginPath();
			// Circular clip to guarantee the indicator NEVER draws outside the scope boundary
			lissajousCtx.arc(cx, cy, radius * 0.94, 0, Math.PI * 2);
			lissajousCtx.clip();

			lissajousCtx.strokeStyle = strokeColor;
			lissajousCtx.lineWidth = 2.0;
			lissajousCtx.shadowColor = strokeColor;
			lissajousCtx.shadowBlur = 4;
			lissajousCtx.beginPath();

			// M/S normalized deflection: keeps 0 dBFS sine generator tones safely within the circular reticle
			const ampGain = radius * 0.58;
			const maxRadius = radius * 0.90;

			for (let i = 0; i < bufLen; i++) {
				const l = timeL[i];
				const r = timeR[i];
				// Rotated vectorscope transform:
				// Left audio deflects toward top-left (Left side of graph)
				// Right audio deflects toward top-right (Right side of graph)
				// Center audio deflects straight UP
				// Out-of-phase audio deflects horizontally
				const dx = (r - l) * invSqrt2 * ampGain;
				const dy = -(l + r) * invSqrt2 * ampGain;
				const dist = Math.sqrt(dx * dx + dy * dy);
				const scale = dist > maxRadius ? (maxRadius / dist) : 1.0;
				const x = cx + dx * scale;
				const y = cy + dy * scale;
				if (i === 0) lissajousCtx.moveTo(x, y);
				else lissajousCtx.lineTo(x, y);
			}
			lissajousCtx.stroke();
			lissajousCtx.restore();
		}

		// REAL-TIME 2D SPECTROGRAM WATERFALL (Time-Frequency Heatmap)
		let specHistoryCanvas: HTMLCanvasElement | null = null;
		let specHistoryCtx: CanvasRenderingContext2D | null = null;
		let lastSpecTime = 0;

		function renderSpectrogram() {
			if (!lissajousCtx || !lissajousCanvas) return;
			const w = lissajousCanvas.width;
			const h = lissajousCanvas.height;
			const isDark = document.documentElement.getAttribute('data-theme') === 'dark';

			if (!specHistoryCanvas || specHistoryCanvas.width !== w || specHistoryCanvas.height !== h) {
				specHistoryCanvas = document.createElement('canvas');
				specHistoryCanvas.width = w;
				specHistoryCanvas.height = h;
				specHistoryCtx = specHistoryCanvas.getContext('2d', { willReadFrequently: true });
				if (specHistoryCtx) {
					specHistoryCtx.fillStyle = isDark ? '#09090b' : '#0c0a09';
					specHistoryCtx.fillRect(0, 0, w, h);
				}
			}

			if (!specHistoryCtx) return;

			const now = performance.now();
			const dt = now - lastSpecTime;
			// 1-pixel ultra-fine scroll increment for maximum horizontal resolution
			const scrollSpeed = 1;

			if (dt >= 15) {
				lastSpecTime = now;

				// Shift history canvas left by 1 pixel
				specHistoryCtx.drawImage(specHistoryCanvas, scrollSpeed, 0, w - scrollSpeed, h, 0, 0, w - scrollSpeed, h);

				// Blank newly scrolled column
				specHistoryCtx.fillStyle = isDark ? '#09090b' : '#0c0a09';
				specHistoryCtx.fillRect(w - scrollSpeed, 0, scrollSpeed, h);

				if (fftAnalyser && audioCtx) {
					const binCount = fftAnalyser.frequencyBinCount;
					const freqData = new Uint8Array(binCount);
					fftAnalyser.getByteFrequencyData(freqData);

					const sampleRate = audioCtx.sampleRate;
					const binWidth = (sampleRate / 2) / binCount;

					const minFreq = 20;
					const maxFreq = 20000;
					const logMin = Math.log10(minFreq);
					const logMax = Math.log10(maxFreq);
					const logRange = logMax - logMin;

					const imgData = specHistoryCtx.createImageData(1, h);
					const data = imgData.data;

					for (let y = 0; y < h; y++) {
						// Smooth continuous logarithmic frequency mapping
						const normY = (h - 1 - y) / Math.max(1, h - 1);
						const hz = Math.pow(10, logMin + normY * logRange);

						// Fractional bin linear interpolation (sub-bin anti-aliased frequency resolution)
						const binExact = Math.min(binCount - 1, Math.max(0, hz / binWidth));
						const b0 = Math.floor(binExact);
						const b1 = Math.min(binCount - 1, b0 + 1);
						const frac = binExact - b0;
						const rawVal = freqData[b0] * (1 - frac) + freqData[b1] * frac;

						// Dynamic gamma expansion for rich contrast and vibrant formants
						const val = Math.min(255, Math.pow(rawVal / 255, 0.85) * 260);

						let r = 9, g = 9, b = 11, a = 255;
						if (val > 8) {
							// Silky smooth continuous thermal heatmap ramp
							if (val < 65) {
								const t = val / 65;
								r = Math.round(12 + t * 95);
								g = Math.round(12 + t * 25);
								b = Math.round(25 + t * 50);
							} else if (val < 145) {
								const t = (val - 65) / 80;
								r = Math.round(107 + t * 142); // -> 249
								g = Math.round(37 + t * 78);   // -> 115
								b = Math.round(75 - t * 53);   // -> 22
							} else if (val < 215) {
								const t = (val - 145) / 70;
								r = Math.round(249 + t * 2);   // -> 251
								g = Math.round(115 + t * 76);  // -> 191
								b = Math.round(22 + t * 14);   // -> 36
							} else {
								const t = (val - 215) / 40;
								r = Math.round(251 + t * 4);   // -> 255
								g = Math.round(191 + t * 64);  // -> 255
								b = Math.round(36 + t * 219);  // -> 255
							}
						}

						const idx = y * 4;
						data[idx] = r;
						data[idx + 1] = g;
						data[idx + 2] = b;
						data[idx + 3] = a;
					}
					specHistoryCtx.putImageData(imgData, w - scrollSpeed, 0);
				}
			}

			// Blit history to display canvas
			lissajousCtx.drawImage(specHistoryCanvas, 0, 0);

			// Draw subtle frequency landmarks
			const landmarks = [
				{ hz: 100, label: '100 Hz' },
				{ hz: 1000, label: '1 kHz' },
				{ hz: 10000, label: '10 kHz' },
			];
			const logMin = Math.log10(20);
			const logMax = Math.log10(20000);
			const logRange = logMax - logMin;

			lissajousCtx.strokeStyle = 'rgba(255, 255, 255, 0.12)';
			lissajousCtx.lineWidth = 1;
			lissajousCtx.setLineDash([2, 4]);

			landmarks.forEach(({ hz, label }) => {
				const normY = (Math.log10(hz) - logMin) / logRange;
				const y = Math.round(h - 1 - normY * (h - 1));
				lissajousCtx.beginPath();
				lissajousCtx.moveTo(0, y);
				lissajousCtx.lineTo(w, y);
				lissajousCtx.stroke();

				lissajousCtx.font = `${Math.max(9, Math.round(10 * (w / 400)))}px monospace`;
				lissajousCtx.fillStyle = 'rgba(255, 255, 255, 0.4)';
				lissajousCtx.textAlign = 'right';
				lissajousCtx.fillText(label, w - 8, y - 3);
			});
			lissajousCtx.setLineDash([]);
		}

		// REAL-TIME FREQUENCY RESPONSE SPECTRUM ANALYSER
		function renderSpectrumScope() {
			if (!spectrumCtx || !spectrumCanvas) return;
			const w = spectrumCanvas.width;
			const h = spectrumCanvas.height;
			const isDark = document.documentElement.getAttribute('data-theme') === 'dark';

			spectrumCtx.clearRect(0, 0, w, h);
			spectrumCtx.fillStyle = isDark ? '#09090b' : '#0c0a09';
			spectrumCtx.fillRect(0, 0, w, h);

			const minFreq = 20;
			const maxFreq = 20000;
			const logMin = Math.log10(minFreq); // 1.3010
			const logMax = Math.log10(maxFreq); // 4.3010
			const logRange = logMax - logMin;   // 3.0

			const freqToX = (hz: number) => {
				const clamped = Math.max(minFreq, Math.min(maxFreq, hz));
				return ((Math.log10(clamped) - logMin) / logRange) * w;
			};

			const bottomY = h - 16;

			// Landmark grid lines: 100 Hz, 1 kHz, 10 kHz
			const landmarks = [
				{ hz: 100, label: '100 Hz' },
				{ hz: 1000, label: '1 kHz' },
				{ hz: 10000, label: '10 kHz' },
			];

			spectrumCtx.strokeStyle = 'rgba(255, 255, 255, 0.08)';
			spectrumCtx.lineWidth = 1;
			spectrumCtx.setLineDash([2, 4]);
			landmarks.forEach(({ hz, label }) => {
				const x = freqToX(hz);
				spectrumCtx.beginPath();
				spectrumCtx.moveTo(x, 0);
				spectrumCtx.lineTo(x, bottomY);
				spectrumCtx.stroke();

				spectrumCtx.font = `${Math.max(9, Math.round(10 * (w / 400)))}px monospace`;
				spectrumCtx.fillStyle = 'rgba(255, 255, 255, 0.3)';
				spectrumCtx.textAlign = 'center';
				spectrumCtx.fillText(label, x, h - 4);
			});
			spectrumCtx.setLineDash([]);

			// Horizontal dB guide lines
			spectrumCtx.strokeStyle = 'rgba(255, 255, 255, 0.04)';
			[0.25, 0.5, 0.75].forEach(ratio => {
				const y = bottomY - ratio * (bottomY - 14);
				spectrumCtx.beginPath();
				spectrumCtx.moveTo(0, y);
				spectrumCtx.lineTo(w, y);
				spectrumCtx.stroke();
			});

			if (!fftAnalyser || !audioCtx) {
				// Flat baseline
				spectrumCtx.strokeStyle = 'rgba(249, 115, 22, 0.25)';
				spectrumCtx.beginPath();
				spectrumCtx.moveTo(0, bottomY);
				spectrumCtx.lineTo(w, bottomY);
				spectrumCtx.stroke();
				return;
			}

			const binCount = fftAnalyser.frequencyBinCount;
			const freqData = new Uint8Array(binCount);
			fftAnalyser.getByteFrequencyData(freqData);

			const sampleRate = audioCtx.sampleRate;
			const binWidth = (sampleRate / 2) / binCount;

			// Build filled polygon
			spectrumCtx.beginPath();
			spectrumCtx.moveTo(0, bottomY);

			const stepPx = Math.max(1, Math.round(w / 200));
			for (let x = 0; x <= w; x += stepPx) {
				const hz = Math.pow(10, logMin + (x / w) * logRange);
				const bin = Math.min(binCount - 1, Math.max(0, Math.round(hz / binWidth)));
				const val = freqData[bin];
				// Boosted prominent curve scaling so bars and curves show clearly
				const norm = Math.min(1.0, Math.pow(val / 255, 0.78) * 1.25);
				const y = bottomY - norm * (bottomY - 12);
				spectrumCtx.lineTo(x, y);
			}
			spectrumCtx.lineTo(w, bottomY);
			spectrumCtx.closePath();

			const grad = spectrumCtx.createLinearGradient(0, 0, 0, bottomY);
			grad.addColorStop(0, 'rgba(249, 115, 22, 0.55)');
			grad.addColorStop(0.65, 'rgba(249, 115, 22, 0.2)');
			grad.addColorStop(1, 'rgba(249, 115, 22, 0.02)');
			spectrumCtx.fillStyle = grad;
			spectrumCtx.fill();

			// Curve stroke with orange glow
			spectrumCtx.strokeStyle = '#f97316';
			spectrumCtx.lineWidth = 2.0;
			spectrumCtx.shadowColor = '#f97316';
			spectrumCtx.shadowBlur = 6;
			spectrumCtx.beginPath();
			for (let x = 0; x <= w; x += stepPx) {
				const hz = Math.pow(10, logMin + (x / w) * logRange);
				const bin = Math.min(binCount - 1, Math.max(0, Math.round(hz / binWidth)));
				const val = freqData[bin];
				const norm = Math.min(1.0, Math.pow(val / 255, 0.78) * 1.25);
				const y = bottomY - norm * (bottomY - 12);
				if (x === 0) spectrumCtx.moveTo(x, y);
				else spectrumCtx.lineTo(x, y);
			}
			spectrumCtx.stroke();
			spectrumCtx.shadowBlur = 0;

			// Tuning target frequency marker
			const currentHz = parseInt(freqNumEl?.textContent?.replace(/,/g, '') || '1000', 10);
			const targetX = freqToX(currentHz);
			spectrumCtx.strokeStyle = 'rgba(249, 115, 22, 0.4)';
			spectrumCtx.lineWidth = 1;
			spectrumCtx.setLineDash([2, 2]);
			spectrumCtx.beginPath();
			spectrumCtx.moveTo(targetX, 0);
			spectrumCtx.lineTo(targetX, bottomY);
			spectrumCtx.stroke();
			spectrumCtx.setLineDash([]);
		}

		let isAudioVisible = false;
		let rafVisualizerId: number | null = null;

		function renderVisualizers() {
			if (!isAudioVisible) {
				rafVisualizerId = null;
				return;
			}
			if (activeStereoMode === 'scope') {
				renderLissajousScope();
			} else {
				renderSpectrogram();
			}
			renderSpectrumScope();
			rafVisualizerId = requestAnimationFrame(renderVisualizers);
		}

		const cardEl = document.getElementById('audio-lab');
		if (cardEl) {
			const obs = new IntersectionObserver((entries) => {
				entries.forEach((e) => {
					isAudioVisible = e.isIntersecting;
					if (isAudioVisible && !rafVisualizerId) {
						rafVisualizerId = requestAnimationFrame(renderVisualizers);
					}
				});
			}, { threshold: 0.05 });
			obs.observe(cardEl);
		} else {
			isAudioVisible = true;
			rafVisualizerId = requestAnimationFrame(renderVisualizers);
		}
	}

	setupAudioTest();
	document.addEventListener('astro:page-load', setupAudioTest);
</script>

<style>
	.audio-test-card {
		padding: clamp(1.2em, 3vw, 2em);
		margin-top: 1.8em;
	}

	.card-header-wrap {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.8em;
