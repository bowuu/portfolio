---
// AudioTest.astro - DAC Latency, Stereo Isolation, 180° Polarity, Frequency Sweeper & Noise Generator
---

<section class="card audio-test-card" id="audio-lab">
	<div class="card-header-wrap">
		<h2 class="card-title">
			<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" class="card-icon">
				<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
				<path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/>
			</svg>
			Audio Test
		</h2>

		<div class="header-actions">
			<div class="volume-control-wrap" title="Output Volume (Safe Ceiling -18 dBFS)">
				<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" class="vol-icon">
					<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
					<path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
				</svg>
				<input type="range" id="audio-volume-slider" min="0" max="1" step="0.05" value="0.35" class="vol-slider" aria-label="Output Volume" />
				<span id="audio-vol-text" class="vol-text mono">35%</span>
			</div>
		</div>
	</div>

	<p class="benchmark-desc">
		Test DAC hardware latency, channel separation, 180&deg; wiring phase, 20 Hz&ndash;20 kHz frequency response, and acoustic noise calibration.
	</p>

	<!-- TWO-COLUMN WORKBENCH (HERO VISUALIZER ON LEFT, CONTROLS ON RIGHT) -->
	<div class="audio-workbench-grid">
		<!-- COLUMN 1: UNIFIED HERO VISUALIZER & DUAL CHANNEL METER -->
		<div class="audio-col hero-visualizer-col">
			<div class="col-head">
				<div class="col-head-left">
					<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" class="col-icon">
						<path d="M2 12h4l3 8 4-16 3 8h6"/>
					</svg>
					<span class="col-title">Live Visualizer</span>
				</div>
				<!-- MODE SWITCHER -->
				<div class="segmented-control" role="group" aria-label="Hero Visualizer Mode">
					<button class="seg-btn active" id="btn-hero-waveform" data-hero-mode="waveform" type="button">Waveform</button>
					<button class="seg-btn" id="btn-hero-spectrum" data-hero-mode="spectrum" type="button">Spectrum</button>
					<button class="seg-btn" id="btn-hero-spectrogram" data-hero-mode="spectrogram" type="button">Spectrogram</button>
				</div>
			</div>

			<!-- VISUALIZER STAGE (CANVAS + HORIZONTAL STEREO VU METER DIRECTLY UNDER) -->
			<div class="visualizer-stage">
				<!-- HERO CANVAS CONTAINER -->
				<div class="hero-canvas-box" id="hero-canvas-box">
					<canvas id="audio-hero-canvas" width="600" height="310"></canvas>

					<!-- FLOATING HUD OVERLAY BADGE -->
					<div class="hero-hud-overlay" id="hero-hud-overlay">
						<div class="hud-badge-wrap" id="hud-badge-wrap">
							<span id="hero-hud-main" class="hud-main-text mono">Standby</span>
							<span class="hud-sep">&bull;</span>
							<span id="hero-hud-sub" class="hud-sub-text">Select Test</span>
						</div>
					</div>

					<!-- TIME-DOMAIN PHASE CORRELATION BAR (Active in waveform mode) -->
					<div class="waveform-hud-bar" id="waveform-hud-bar">
						<div class="phase-meter-wrap" title="Phase Correlation (-1.0 Inverted to +1.0 In-Phase)">
							<span class="phase-meter-title">Phase:</span>
							<span class="phase-meter-tag mono">-1.0</span>
							<div class="phase-meter-track">
								<div class="phase-meter-center"></div>
								<div class="phase-meter-fill" id="phase-meter-fill"></div>
							</div>
							<span class="phase-meter-tag mono">+1.0</span>
							<span class="phase-val mono" id="phase-val-text">+1.00</span>
						</div>
					</div>
				</div>

				<!-- DEDICATED HORIZONTAL STEREO PEAK / VU METER (FULL HORIZONTAL WIDTH) -->
				<div class="stereo-meter-box" id="stereo-meter-box" title="Stereo Peak / VU Meter (Left & Right Channels in dBFS)">
					<canvas id="audio-meter-canvas" width="600" height="52"></canvas>
				</div>
			</div>
		</div>

		<!-- COLUMN 2: HARDWARE TEST CONTROLS -->
		<div class="audio-col controls-col">
			<!-- SECTION 1: STEREO & POLARITY ISOLATION -->
			<div class="control-group">
				<div class="group-header">
					<div class="group-header-left">
						<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" class="group-icon">
							<circle cx="12" cy="12" r="10"/>
							<line x1="12" y1="2" x2="12" y2="22"/>
						</svg>
						<span class="group-title">Stereo &amp; Polarity Isolation</span>
					</div>
					<span class="group-badge">Voice + Tone</span>
				</div>

				<div class="tone-buttons-grid">
					<button class="tone-btn" id="btn-tone-left" type="button">
						<span class="tone-pill">L</span>
						<span class="tone-name">Left Channel</span>
					</button>

					<button class="tone-btn" id="btn-tone-right" type="button">
						<span class="tone-pill">R</span>
						<span class="tone-name">Right Channel</span>
					</button>

					<button class="tone-btn" id="btn-tone-inphase" type="button">
						<span class="tone-pill">0&deg;</span>
						<span class="tone-name">Center Channel</span>
					</button>

					<button class="tone-btn" id="btn-tone-outphase" type="button">
						<span class="tone-pill warn">180&deg;</span>
						<span class="tone-name">Out-of-Phase</span>
					</button>
				</div>
			</div>

			<!-- SECTION 2: TONE & BROADBAND NOISE GENERATOR -->
			<div class="control-group">
				<div class="group-header">
					<div class="group-header-left">
						<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" class="group-icon">
							<path d="M2 12h4l3 8 4-16 3 8h6"/>
						</svg>
						<span class="group-title">Tone &amp; Noise Generator</span>
					</div>
					<span class="group-badge">Sine &bull; Pink &bull; White</span>
				</div>

				<!-- SINE TONE & SWEEPER SECTION -->
				<div class="tone-controls-section">
					<!-- SWEEP ACTIONS -->
					<div class="sweep-actions-row">
						<button id="toggle-tone-btn" class="sweep-btn" type="button">
							<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" id="toggle-tone-icon">
								<polygon points="5 3 19 12 5 21 5 3"/>
							</svg>
							<span id="toggle-tone-text">Play</span>
						</button>

						<button id="run-sweep-btn" class="sweep-btn sweep-auto-btn" type="button">
							<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
								<polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
								<polyline points="17 6 23 6 23 12"/>
							</svg>
							<span id="run-sweep-text">Auto Sweep (10s)</span>
						</button>
					</div>

					<!-- SCRUB SLIDER -->
					<div class="slider-row">
						<div class="slider-header-info">
							<span class="slider-hint">Sine Frequency Scrub</span>
							<span class="slider-hz-val mono" id="slider-hz-display">1,000 Hz</span>
						</div>
						<input type="range" id="freq-slider" min="20" max="20000" step="1" value="1000" class="freq-slider" aria-label="Frequency Slider" />
					</div>

					<!-- PRESET PILLS (Symmetrical 6-column grid) -->
					<div class="freq-presets-grid">
						<button class="freq-pill" data-hz="20" type="button"><span class="pill-hz mono">20 Hz</span><span class="pill-tag">Sub</span></button>
						<button class="freq-pill" data-hz="60" type="button"><span class="pill-hz mono">60 Hz</span><span class="pill-tag">Bass</span></button>
						<button class="freq-pill" data-hz="250" type="button"><span class="pill-hz mono">250 Hz</span><span class="pill-tag">Mid</span></button>
						<button class="freq-pill active" data-hz="1000" type="button"><span class="pill-hz mono">1 kHz</span><span class="pill-tag">Ref</span></button>
						<button class="freq-pill" data-hz="8000" type="button"><span class="pill-hz mono">8 kHz</span><span class="pill-tag">Pres</span></button>
						<button class="freq-pill" data-hz="16000" type="button"><span class="pill-hz mono">16 kHz</span><span class="pill-tag">Treble</span></button>
					</div>

					<!-- BROADBAND NOISE PRESETS (Directly under frequency presets) -->
					<div class="noise-presets-grid">
						<button class="noise-pill" data-noise="pink" type="button">
							<span class="pill-hz">Pink Noise</span>
							<span class="pill-tag">1/f Equal Energy</span>
						</button>
						<button class="noise-pill" data-noise="white" type="button">
							<span class="pill-hz">White Noise</span>
							<span class="pill-tag">Flat PSD (20 Hz–20 kHz)</span>
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	function setupAudioTest() {
		let audioCtx: AudioContext | null = null;
		let audioBus: GainNode | null = null;
		let masterGain: GainNode | null = null;
		let compressor: DynamicsCompressorNode | null = null;

		let currentOsc: OscillatorNode | null = null;
		let noiseNode: AudioNode | null = null;

		let activeSignal: 'sine' | 'pink' | 'white' = 'sine';
		let activeHeroMode: 'waveform' | 'spectrum' | 'spectrogram' = 'waveform';
		let activeMode: 'none' | 'left' | 'right' | 'inphase' | 'outphase' | 'tone' | 'sweep' | 'noise' = 'none';
		let activeNoiseType: 'pink' | 'white' = 'pink';
		let currentToneHz = 1000;
		let isSweeping = false;
		let sweepRafId: number | null = null;

		// VU Meter Ballistics State
		let smoothL = -60;
		let smoothR = -60;
		let peakHoldL = -60;
		let peakHoldR = -60;
		let peakHoldTimeL = 0;
		let peakHoldTimeR = 0;

		// UI references
		const modeWaveformBtn = document.getElementById('btn-hero-waveform');
		const modeSpectrumBtn = document.getElementById('btn-hero-spectrum');
		const modeSpectrogramBtn = document.getElementById('btn-hero-spectrogram');
		const waveformHudBar = document.getElementById('waveform-hud-bar');

		const volSlider = document.getElementById('audio-volume-slider') as HTMLInputElement;
		const volText = document.getElementById('audio-vol-text');

		const heroHudMain = document.getElementById('hero-hud-main');
		const heroHudSub = document.getElementById('hero-hud-sub');
		const phaseMeterFill = document.getElementById('phase-meter-fill');
		const phaseValText = document.getElementById('phase-val-text');

		const sliderHzDisplay = document.getElementById('slider-hz-display');
		const freqSlider = document.getElementById('freq-slider') as HTMLInputElement;
		const toggleToneBtn = document.getElementById('toggle-tone-btn');
		const toggleToneText = document.getElementById('toggle-tone-text');
		const toggleToneIcon = document.getElementById('toggle-tone-icon');
		const runSweepBtn = document.getElementById('run-sweep-btn');
		const runSweepText = document.getElementById('run-sweep-text');

		const freqPills = document.querySelectorAll('.freq-pill');
		const noisePills = document.querySelectorAll('.noise-pill');

		function setPlayButtonState(isPlaying: boolean) {
			if (toggleToneBtn) toggleToneBtn.classList.toggle('active', isPlaying);
			if (toggleToneText) toggleToneText.textContent = isPlaying ? 'Pause' : 'Play';
			if (toggleToneIcon) {
				if (isPlaying) {
					toggleToneIcon.innerHTML = '<rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>';
				} else {
					toggleToneIcon.innerHTML = '<polygon points="5 3 19 12 5 21 5 3"/>';
				}
			}
		}

		const heroCanvas = document.getElementById('audio-hero-canvas') as HTMLCanvasElement;
		const heroCtx = heroCanvas?.getContext('2d');

		const meterCanvas = document.getElementById('audio-meter-canvas') as HTMLCanvasElement;
		const meterCtx = meterCanvas?.getContext('2d');

		let splitter: ChannelSplitterNode | null = null;
		let analyserLeft: AnalyserNode | null = null;
		let analyserRight: AnalyserNode | null = null;
		let fftAnalyser: AnalyserNode | null = null;

		// Lazy initialize AudioContext on user interaction
		function getAudioContext(): AudioContext {
			if (!audioCtx) {
				const AudioConstructor = window.AudioContext || (window as any).webkitAudioContext;
				audioCtx = new AudioConstructor();

				// Master compressor to prevent clipping / distortion
				compressor = audioCtx.createDynamicsCompressor();
				compressor.threshold.setValueAtTime(-12, audioCtx.currentTime);
				compressor.knee.setValueAtTime(30, audioCtx.currentTime);
				compressor.ratio.setValueAtTime(12, audioCtx.currentTime);
				compressor.attack.setValueAtTime(0.003, audioCtx.currentTime);
				compressor.release.setValueAtTime(0.25, audioCtx.currentTime);

				// Pre-attenuation Audio Bus (Unity Gain 0 dB) for unattenuated visualizer telemetry
				audioBus = audioCtx.createGain();
				audioBus.channelCount = 2;
				audioBus.channelCountMode = 'explicit';
				audioBus.channelInterpretation = 'speakers';

				// Master volume attenuation node for speakers / output
				masterGain = audioCtx.createGain();
				const initialVol = volSlider ? parseFloat(volSlider.value) : 0.35;
				masterGain.gain.setValueAtTime(initialVol * 0.45, audioCtx.currentTime);

				audioBus.connect(masterGain);
				masterGain.connect(compressor);
				compressor.connect(audioCtx.destination);

				// Real Stereo & Phase Vector Split (Left / Right split for oscilloscope & VU meter)
				splitter = audioCtx.createChannelSplitter(2);
				analyserLeft = audioCtx.createAnalyser();
				analyserRight = audioCtx.createAnalyser();
				analyserLeft.fftSize = 2048;
				analyserRight.fftSize = 2048;

				audioBus.connect(splitter);
				splitter.connect(analyserLeft, 0);
				splitter.connect(analyserRight, 1);

				// Real Frequency Response FFT Spectrum Analyser (4096-point high-resolution FFT)
				fftAnalyser = audioCtx.createAnalyser();
				fftAnalyser.fftSize = 4096;
				fftAnalyser.smoothingTimeConstant = 0.80;
				fftAnalyser.minDecibels = -80;
				fftAnalyser.maxDecibels = -10;

				audioBus.connect(fftAnalyser);
			}

			if (audioCtx.state === 'suspended') {
				audioCtx.resume().catch(() => {});
			}
			return audioCtx;
		}

		// Visualizer Mode Switcher
		function setHeroVisualizerMode(mode: 'waveform' | 'spectrum' | 'spectrogram') {
			activeHeroMode = mode;
			modeWaveformBtn?.classList.toggle('active', mode === 'waveform');
			modeSpectrumBtn?.classList.toggle('active', mode === 'spectrum');
			modeSpectrogramBtn?.classList.toggle('active', mode === 'spectrogram');

			if (waveformHudBar) {
				waveformHudBar.style.display = mode === 'waveform' ? 'flex' : 'none';
			}

			updateHudOverlay();
		}

		modeWaveformBtn?.addEventListener('click', () => setHeroVisualizerMode('waveform'));
		modeSpectrumBtn?.addEventListener('click', () => setHeroVisualizerMode('spectrum'));
		modeSpectrogramBtn?.addEventListener('click', () => setHeroVisualizerMode('spectrogram'));

		// Update Master Volume
		if (volSlider) {
			volSlider.addEventListener('input', () => {
				const val = parseFloat(volSlider.value);
				if (volText) volText.textContent = `${Math.round(val * 100)}%`;
				if (masterGain && audioCtx) {
					masterGain.gain.setTargetAtTime(val * 0.45, audioCtx.currentTime, 0.03);
				}
			});
		}

		// Voice Audio Buffers for Spoken Tests
		const voiceBufferCache: Record<string, AudioBuffer> = {};
		let voiceLoopTimeout: number | null = null;
		let currentSourceNode: AudioBufferSourceNode | null = null;

		async function loadVoiceBuffer(mode: 'left' | 'right' | 'inphase' | 'outphase'): Promise<AudioBuffer | null> {
			if (voiceBufferCache[mode]) return voiceBufferCache[mode];
			const fileMap: Record<string, string> = {
				left: '/audio/voice-left.mp3',
				right: '/audio/voice-right.mp3',
				inphase: '/audio/voice-center.mp3',
				outphase: '/audio/voice-outphase.mp3',
			};
			try {
				const res = await fetch(fileMap[mode]);
				const arr = await res.arrayBuffer();
				const ctx = getAudioContext();
				const buf = await ctx.decodeAudioData(arr);
				voiceBufferCache[mode] = buf;
				return buf;
			} catch (e) {
				console.error('Failed to load voice buffer', e);
				return null;
			}
		}

		// Update HUD text banner (Streamlined to prevent text wrapping on narrow mobile screens)
		function updateHudOverlay() {
			if (!heroHudMain || !heroHudSub) return;

			if (activeMode === 'none') {
				heroHudMain.textContent = 'Standby';
				heroHudSub.textContent = 'Select Test';
				return;
			}

			if (activeMode === 'left') {
				heroHudMain.textContent = 'Left Channel';
				heroHudSub.textContent = '100% Left';
			} else if (activeMode === 'right') {
				heroHudMain.textContent = 'Right Channel';
				heroHudSub.textContent = '100% Right';
			} else if (activeMode === 'inphase') {
				heroHudMain.textContent = 'Center (0°)';
				heroHudSub.textContent = 'In-Phase';
			} else if (activeMode === 'outphase') {
				heroHudMain.textContent = 'Out-of-Phase (180°)';
				heroHudSub.textContent = 'Inverted Polarity';
			} else if (activeMode === 'tone') {
				heroHudMain.textContent = `${Math.round(currentToneHz).toLocaleString()} Hz`;
				heroHudSub.textContent = getBandTag(currentToneHz);
			} else if (activeMode === 'sweep') {
				heroHudMain.textContent = `${Math.round(currentToneHz).toLocaleString()} Hz`;
				heroHudSub.textContent = 'Auto Sweep';
			} else if (activeMode === 'noise') {
				if (activeNoiseType === 'pink') {
					heroHudMain.textContent = 'Pink (1/f)';
					heroHudSub.textContent = 'Equal Energy/Oct';
				} else {
					heroHudMain.textContent = 'White Noise';
					heroHudSub.textContent = 'Flat PSD';
				}
			}
		}

		function getBandTag(hz: number): string {
			if (hz < 60) return 'Sub-Bass';
			if (hz < 250) return 'Bass';
			if (hz < 500) return 'Low-Mid';
			if (hz < 2000) return 'Midrange';
			if (hz < 4000) return 'High-Mid';
			if (hz < 8000) return 'Presence';
			if (hz < 14000) return 'Brilliance';
			return 'Ultra-Treble';
		}

		// Stop All Active Audio
		function stopAllAudio() {
			if (sweepRafId) {
				cancelAnimationFrame(sweepRafId);
				sweepRafId = null;
			}
			isSweeping = false;

			if (voiceLoopTimeout) {
				clearTimeout(voiceLoopTimeout);
				voiceLoopTimeout = null;
			}
			if (currentSourceNode) {
				try {
					currentSourceNode.stop();
					currentSourceNode.disconnect();
				} catch (_) {}
				currentSourceNode = null;
			}
			if (currentOsc) {
				try {
					currentOsc.stop();
					currentOsc.disconnect();
				} catch (_) {}
				currentOsc = null;
			}
			if (noiseNode) {
				try {
					(noiseNode as any).stop?.();
					noiseNode.disconnect();
				} catch (_) {}
				noiseNode = null;
			}

			activeMode = 'none';
			document.querySelectorAll('.tone-btn').forEach(b => b.classList.remove('active'));
			setPlayButtonState(false);
			if (runSweepBtn) runSweepBtn.classList.remove('active');
			if (runSweepText) runSweepText.textContent = 'Auto Sweep (10s)';

			updateHudOverlay();
		}

		// Frequency UI updates
		function updateFrequencyUI(hz: number) {
			currentToneHz = hz;
			if (sliderHzDisplay) {
				sliderHzDisplay.textContent = `${Math.round(hz).toLocaleString()} Hz`;
			}
			updateHudOverlay();
		}

		// Slider Scrub
		if (freqSlider) {
			freqSlider.addEventListener('input', () => {
				const sliderVal = parseFloat(freqSlider.value);
				// Logarithmic mapping for natural frequency perception
				const minLog = Math.log(20);
				const maxLog = Math.log(20000);
				const scale = (sliderVal - 20) / (20000 - 20);
				const hz = Math.round(Math.exp(minLog + scale * (maxLog - minLog)));

				activeSignal = 'sine';
				updateFrequencyUI(hz);
				if (activeMode === 'tone' && currentOsc && audioCtx) {
					currentOsc.frequency.setTargetAtTime(hz, audioCtx.currentTime, 0.02);
				} else if (activeMode === 'noise') {
					startToneGenerator();
				}
				freqPills.forEach(p => p.classList.remove('active'));
				noisePills.forEach(p => p.classList.remove('active'));
			});
		}

		// Preset Frequency Pills
		freqPills.forEach((pill) => {
			pill.addEventListener('click', () => {
				freqPills.forEach(p => p.classList.remove('active'));
				noisePills.forEach(p => p.classList.remove('active'));
				pill.classList.add('active');

				activeSignal = 'sine';
				const targetHz = parseInt(pill.getAttribute('data-hz') || '1000', 10);
				updateFrequencyUI(targetHz);

				// Reverse map to slider
				const minLog = Math.log(20);
				const maxLog = Math.log(20000);
				const scale = (Math.log(targetHz) - minLog) / (maxLog - minLog);
				if (freqSlider) freqSlider.value = String(Math.round(20 + scale * (20000 - 20)));

				if (activeMode === 'tone' && currentOsc && audioCtx) {
					currentOsc.frequency.setTargetAtTime(targetHz, audioCtx.currentTime, 0.02);
				} else if (activeMode === 'noise') {
					startToneGenerator();
				}
			});
		});

		// Preset Noise Pills (Pink & White under frequency presets)
		noisePills.forEach((pill) => {
			pill.addEventListener('click', () => {
				const noiseType = (pill.getAttribute('data-noise') as 'pink' | 'white') || 'pink';

				// If this noise is currently playing, clicking it pauses
				if (activeMode === 'noise' && activeNoiseType === noiseType) {
					stopAllAudio();
					return;
				}

				activeSignal = noiseType;
				activeNoiseType = noiseType;

				freqPills.forEach(p => p.classList.remove('active'));
				noisePills.forEach(p => p.classList.remove('active'));
				pill.classList.add('active');

				startNoiseGenerator(noiseType);
			});
		});

		// Play / Pause Sine Tone Generator
		function startToneGenerator() {
			const ctx = getAudioContext();
			stopAllAudio();
			activeMode = 'tone';
			activeSignal = 'sine';

			const osc = ctx.createOscillator();
			osc.type = 'sine';
			osc.frequency.setValueAtTime(currentToneHz, ctx.currentTime);
			osc.connect(audioBus || masterGain!);
			osc.start();
			currentOsc = osc;

			setPlayButtonState(true);
			updateHudOverlay();
		}

		if (toggleToneBtn) {
			toggleToneBtn.addEventListener('click', () => {
				if (activeMode === 'tone' || activeMode === 'noise') {
					stopAllAudio();
				} else {
					if (activeSignal === 'pink' || activeSignal === 'white') {
						startNoiseGenerator(activeSignal);
					} else {
						startToneGenerator();
					}
				}
			});
		}

		// Auto Frequency Sweep (20Hz - 20,000Hz over 10 seconds)
		function runAutoSweep() {
			if (isSweeping) {
				stopAllAudio();
				return;
			}
			const ctx = getAudioContext();
			stopAllAudio();
			isSweeping = true;
			activeMode = 'sweep';
			activeSignal = 'sine';

			const osc = ctx.createOscillator();
			osc.type = 'sine';
			osc.frequency.setValueAtTime(20, ctx.currentTime);
			osc.frequency.exponentialRampToValueAtTime(20000, ctx.currentTime + 10);
			osc.connect(audioBus || masterGain!);
			osc.start();
			currentOsc = osc;

			if (runSweepBtn) runSweepBtn.classList.add('active');
			if (runSweepText) runSweepText.textContent = 'Stop Sweep';
			updateHudOverlay();

			const sweepStart = performance.now();
			function updateSweepProgress() {
				if (!isSweeping) return;
				const elapsed = (performance.now() - sweepStart) / 1000;
				if (elapsed >= 10) {
					stopAllAudio();
					return;
				}
				// Exponential frequency calculation
				const sweepHz = 20 * Math.pow(20000 / 20, elapsed / 10);
				updateFrequencyUI(sweepHz);

				// Update slider
				const minLog = Math.log(20);
				const maxLog = Math.log(20000);
				const scale = (Math.log(sweepHz) - minLog) / (maxLog - minLog);
				if (freqSlider) freqSlider.value = String(Math.round(20 + scale * (20000 - 20)));

				sweepRafId = requestAnimationFrame(updateSweepProgress);
			}
			sweepRafId = requestAnimationFrame(updateSweepProgress);
		}

		if (runSweepBtn) runSweepBtn.addEventListener('click', runAutoSweep);

		// BROADBAND NOISE GENERATOR (Pink / White)
		function startNoiseGenerator(noiseType?: 'pink' | 'white') {
			if (noiseType) activeNoiseType = noiseType;
			activeSignal = activeNoiseType;
			const ctx = getAudioContext();
			stopAllAudio();
			activeMode = 'noise';

			const bufferSize = ctx.sampleRate * 2;
			const noiseBuffer = ctx.createBuffer(2, bufferSize, ctx.sampleRate);
			const outL = noiseBuffer.getChannelData(0);
			const outR = noiseBuffer.getChannelData(1);

			if (activeNoiseType === 'white') {
				for (let i = 0; i < bufferSize; i++) {
					outL[i] = (Math.random() * 2 - 1) * 0.45;
					outR[i] = (Math.random() * 2 - 1) * 0.45;
				}
			} else {
				// Pink noise: Paul Kellet 6-pole IIR filter algorithm (-3 dB/oct)
				let b0L = 0, b1L = 0, b2L = 0, b3L = 0, b4L = 0, b5L = 0, b6L = 0;
				let b0R = 0, b1R = 0, b2R = 0, b3R = 0, b4R = 0, b5R = 0, b6R = 0;
				for (let i = 0; i < bufferSize; i++) {
					const whiteL = Math.random() * 2 - 1;
					b0L = 0.99886 * b0L + whiteL * 0.0555179;
					b1L = 0.99332 * b1L + whiteL * 0.0750759;
					b2L = 0.96900 * b2L + whiteL * 0.1538520;
					b3L = 0.86650 * b3L + whiteL * 0.3104856;
					b4L = 0.55000 * b4L + whiteL * 0.5329522;
					b5L = -0.7616 * b5L - whiteL * 0.0168980;
					outL[i] = (b0L + b1L + b2L + b3L + b4L + b5L + b6L + whiteL * 0.5362) * 0.07;
					b6L = whiteL * 0.115926;

					const whiteR = Math.random() * 2 - 1;
					b0R = 0.99886 * b0R + whiteR * 0.0555179;
					b1R = 0.99332 * b1R + whiteR * 0.0750759;
					b2R = 0.96900 * b2R + whiteR * 0.1538520;
					b3R = 0.86650 * b3R + whiteR * 0.3104856;
					b4R = 0.55000 * b4R + whiteR * 0.5329522;
					b5R = -0.7616 * b5R - whiteR * 0.0168980;
					outR[i] = (b0R + b1R + b2R + b3R + b4R + b5R + b6R + whiteR * 0.5362) * 0.07;
					b6R = whiteR * 0.115926;
				}
			}

			const noiseSource = ctx.createBufferSource();
			noiseSource.buffer = noiseBuffer;
			noiseSource.loop = true;
			noiseSource.connect(audioBus || masterGain!);
			noiseSource.start();
			noiseNode = noiseSource;

			setPlayButtonState(true);
			updateHudOverlay();
		}

		// CHANNEL ISOLATION & POLARITY TESTS
		async function playPolarityTone(mode: 'left' | 'right' | 'inphase' | 'outphase') {
			if (activeMode === mode) {
				stopAllAudio();
				return;
			}

			const ctx = getAudioContext();
			stopAllAudio();
			activeMode = mode;

			const btnMap: Record<string, string> = {
				left: 'btn-tone-left',
				right: 'btn-tone-right',
				inphase: 'btn-tone-inphase',
				outphase: 'btn-tone-outphase'
			};
			document.getElementById(btnMap[mode])?.classList.add('active');
			updateHudOverlay();

			const buf = await loadVoiceBuffer(mode);
			if (activeMode !== mode) return;

			function playVoiceClip() {
				if (activeMode !== mode || !masterGain) return;
				const c = getAudioContext();
				const merger = c.createChannelMerger(2);

				if (buf) {
					const source = c.createBufferSource();
					source.buffer = buf;

					if (mode === 'left') {
						const g = c.createGain();
						g.gain.setValueAtTime(1.0, c.currentTime);
						source.connect(g);
						g.connect(merger, 0, 0); // left ear only
					} else if (mode === 'right') {
						const g = c.createGain();
						g.gain.setValueAtTime(1.0, c.currentTime);
						source.connect(g);
						g.connect(merger, 0, 1); // right ear only
					} else if (mode === 'inphase') {
						const leftG = c.createGain();
						const rightG = c.createGain();
						leftG.gain.setValueAtTime(1.0, c.currentTime);
						rightG.gain.setValueAtTime(1.0, c.currentTime);
						source.connect(leftG);
						source.connect(rightG);
						leftG.connect(merger, 0, 0);
						rightG.connect(merger, 0, 1);
					} else if (mode === 'outphase') {
						const leftG = c.createGain();
						const rightG = c.createGain();
						leftG.gain.setValueAtTime(1.0, c.currentTime);
						rightG.gain.setValueAtTime(-1.0, c.currentTime); // 180° phase inversion
						source.connect(leftG);
						source.connect(rightG);
						leftG.connect(merger, 0, 0);
						rightG.connect(merger, 0, 1);
					}

					merger.connect(audioBus || masterGain);
					source.start();
					currentSourceNode = source;

					source.onended = () => {
						if (activeMode === mode) {
							voiceLoopTimeout = window.setTimeout(() => {
								if (activeMode === mode) playVoiceClip();
							}, 800);
						}
					};
				} else {
					// Fallback to sine wave if audio file fails to load
					const osc = c.createOscillator();
					osc.type = 'sine';
					osc.frequency.setValueAtTime(1000, c.currentTime);
					if (mode === 'left') {
						const leftG = c.createGain();
						leftG.gain.setValueAtTime(1.0, c.currentTime);
						osc.connect(leftG);
						leftG.connect(merger, 0, 0);
					} else if (mode === 'right') {
						const rightG = c.createGain();
						rightG.gain.setValueAtTime(1.0, c.currentTime);
						osc.connect(rightG);
						rightG.connect(merger, 0, 1);
					} else if (mode === 'inphase') {
						osc.connect(merger, 0, 0);
						osc.connect(merger, 0, 1);
					} else if (mode === 'outphase') {
						const leftG = c.createGain();
						const rightG = c.createGain();
						rightG.gain.setValueAtTime(-1.0, c.currentTime);
						osc.connect(leftG);
						osc.connect(rightG);
						leftG.connect(merger, 0, 0);
						rightG.connect(merger, 0, 1);
					}
					merger.connect(audioBus || masterGain);
					osc.start();
					currentOsc = osc;
				}
			}

			playVoiceClip();
		}

		document.getElementById('btn-tone-left')?.addEventListener('click', () => playPolarityTone('left'));
		document.getElementById('btn-tone-right')?.addEventListener('click', () => playPolarityTone('right'));
		document.getElementById('btn-tone-inphase')?.addEventListener('click', () => playPolarityTone('inphase'));
		document.getElementById('btn-tone-outphase')?.addEventListener('click', () => playPolarityTone('outphase'));

		// Responsive canvas resizing (DPR Retina scaling)
		function resizeCanvases() {
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			if (heroCanvas) {
				const rect = heroCanvas.getBoundingClientRect();
				const targetW = Math.round((rect.width || 600) * dpr);
				const targetH = Math.round((rect.height || 310) * dpr);
				if (heroCanvas.width !== targetW || heroCanvas.height !== targetH) {
					heroCanvas.width = targetW;
					heroCanvas.height = targetH;
				}
			}
			if (meterCanvas) {
				const rect = meterCanvas.getBoundingClientRect();
				const targetW = Math.round((rect.width || 600) * dpr);
				const targetH = Math.round((rect.height || 52) * dpr);
				if (meterCanvas.width !== targetW || meterCanvas.height !== targetH) {
					meterCanvas.width = targetW;
					meterCanvas.height = targetH;
				}
			}
		}
		resizeCanvases();
		window.addEventListener('resize', resizeCanvases, { passive: true });

		const heroBox = document.getElementById('hero-canvas-box');
		if (heroBox && window.ResizeObserver) {
			const ro = new ResizeObserver(() => {
				resizeCanvases();
			});
			ro.observe(heroBox);
		}

		// -------------------------------------------------------------
		// VISUALIZER 1: DUAL-TRACE WAVEFORM OSCILLOSCOPE
		// -------------------------------------------------------------
		function renderWaveformScope() {
			if (!heroCtx || !heroCanvas) return;
			const w = heroCanvas.width;
			const h = heroCanvas.height;
			const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
			const cy = h / 2;

			heroCtx.clearRect(0, 0, w, h);
			heroCtx.fillStyle = isDark ? '#09090b' : '#0c0a09';
			heroCtx.fillRect(0, 0, w, h);

			// Oscilloscope Grid Divisions
			heroCtx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
			heroCtx.lineWidth = 1;

			// Horizontal division lines (±1.0, ±0.5, 0 baseline)
			const gridYSteps = [0.15, 0.32, 0.5, 0.68, 0.85];
			gridYSteps.forEach((ratio) => {
				const y = Math.round(h * ratio);
				heroCtx.beginPath();
				heroCtx.moveTo(0, y);
				heroCtx.lineTo(w, y);
				heroCtx.stroke();
			});

			// Vertical division lines
			const gridCols = 8;
			for (let col = 1; col < gridCols; col++) {
				const x = Math.round((w / gridCols) * col);
				heroCtx.beginPath();
				heroCtx.moveTo(x, 0);
				heroCtx.lineTo(x, h);
				heroCtx.stroke();
			}

			// Center baseline (0V reference)
			heroCtx.strokeStyle = 'rgba(255, 255, 255, 0.12)';
			heroCtx.beginPath();
			heroCtx.moveTo(0, cy);
			heroCtx.lineTo(w, cy);
			heroCtx.stroke();

			if (!analyserLeft || !analyserRight) {
				// Standby resting zero baselines
				heroCtx.strokeStyle = 'rgba(56, 189, 248, 0.35)';
				heroCtx.beginPath();
				heroCtx.moveTo(0, cy);
				heroCtx.lineTo(w, cy);
				heroCtx.stroke();
				return;
			}

			const bufLen = analyserLeft.fftSize;
			const timeL = new Float32Array(bufLen);
			const timeR = new Float32Array(bufLen);
			analyserLeft.getFloatTimeDomainData(timeL);
			analyserRight.getFloatTimeDomainData(timeR);

			// Calculate Pearson correlation & RMS energy
			let sumSqL = 0;
			let sumSqR = 0;
			let dotProd = 0;
			for (let i = 0; i < bufLen; i++) {
				const l = timeL[i];
				const r = timeR[i];
				sumSqL += l * l;
				sumSqR += r * r;
				dotProd += l * r;
			}
			const rmsL = Math.sqrt(sumSqL / bufLen);
			const rmsR = Math.sqrt(sumSqR / bufLen);
			const maxRms = Math.max(rmsL, rmsR);

			// Phase correlation computation: r in [-1.0 .. +1.0]
			const denom = Math.sqrt(sumSqL * sumSqR);
			let correlation = 1.0;
			if (denom > 0.0001) {
				correlation = Math.max(-1.0, Math.min(1.0, dotProd / denom));
			} else if (rmsL > 0.01 && rmsR <= 0.005) {
				correlation = 0.0;
			} else if (rmsR > 0.01 && rmsL <= 0.005) {
				correlation = 0.0;
			}

			// Update Phase Correlation Meter HUD UI
			if (phaseValText && phaseMeterFill) {
				if (maxRms < 0.002) {
					phaseValText.textContent = '0.00';
					phaseMeterFill.style.width = '50%';
					phaseMeterFill.style.background = 'rgba(148, 163, 184, 0.4)';
				} else if (rmsL > 0.01 && rmsR < 0.003) {
					phaseValText.textContent = 'L Only';
					phaseMeterFill.style.width = '50%';
					phaseMeterFill.style.background = '#38bdf8';
				} else if (rmsR > 0.01 && rmsL < 0.003) {
					phaseValText.textContent = 'R Only';
					phaseMeterFill.style.width = '50%';
					phaseMeterFill.style.background = '#f59e0b';
				} else {
					phaseValText.textContent = (correlation >= 0 ? '+' : '') + correlation.toFixed(2);
					const pct = Math.round(((correlation + 1) / 2) * 100);
					phaseMeterFill.style.width = `${pct}%`;
					if (correlation > 0.65) {
						phaseMeterFill.style.background = '#22c55e';
					} else if (correlation < -0.65) {
						phaseMeterFill.style.background = '#ef4444';
					} else {
						phaseMeterFill.style.background = '#f97316';
					}
				}
			}

			// Trigger detection: find rising zero-crossing to stabilize periodic waveforms
			let triggerIdx = 0;
			if (maxRms > 0.005) {
				const triggerArray = rmsL >= rmsR ? timeL : timeR;
				for (let i = 1; i < 256; i++) {
					if (triggerArray[i - 1] <= 0 && triggerArray[i] > 0) {
						triggerIdx = i;
						break;
					}
				}
			}

			// Dynamic sample display window tailored to fundamental period
			let displayLen = 512;
			if (activeMode === 'tone' || activeMode === 'sweep') {
				const hz = Math.max(20, Math.min(20000, currentToneHz));
				if (audioCtx) {
					const periodSamples = Math.round(audioCtx.sampleRate / hz);
					displayLen = Math.min(bufLen - triggerIdx - 1, Math.max(64, periodSamples * 4));
				}
			}

			const ampHeight = (h / 2) * 0.82;
			const stepX = w / (displayLen - 1);

			// Render Left Channel Waveform (Cyan #38bdf8)
			heroCtx.save();
			heroCtx.strokeStyle = '#38bdf8';
			heroCtx.lineWidth = 2.0;
			heroCtx.shadowColor = 'rgba(56, 189, 248, 0.5)';
			heroCtx.shadowBlur = 4;
			heroCtx.beginPath();
			for (let i = 0; i < displayLen; i++) {
				const sampleIdx = triggerIdx + i;
				const sL = sampleIdx < bufLen ? timeL[sampleIdx] : 0;
				const x = i * stepX;
				const y = cy - sL * ampHeight;
				if (i === 0) heroCtx.moveTo(x, y);
				else heroCtx.lineTo(x, y);
			}
			heroCtx.stroke();
			heroCtx.restore();

			// Render Right Channel Waveform (Amber #f59e0b)
			heroCtx.save();
			heroCtx.strokeStyle = '#f59e0b';
			heroCtx.lineWidth = 2.0;
			heroCtx.shadowColor = 'rgba(245, 158, 11, 0.5)';
			heroCtx.shadowBlur = 4;
			heroCtx.beginPath();
			for (let i = 0; i < displayLen; i++) {
				const sampleIdx = triggerIdx + i;
				const sR = sampleIdx < bufLen ? timeR[sampleIdx] : 0;
				const x = i * stepX;
				const y = cy - sR * ampHeight;
				if (i === 0) heroCtx.moveTo(x, y);
				else heroCtx.lineTo(x, y);
			}
			heroCtx.stroke();
			heroCtx.restore();
		}

		// -------------------------------------------------------------
		// VISUALIZER 2: 4096-POINT FFT SPECTRUM ANALYSER
		// -------------------------------------------------------------
		function renderSpectrumScope() {
			if (!heroCtx || !heroCanvas) return;
			const w = heroCanvas.width;
			const h = heroCanvas.height;
			const isDark = document.documentElement.getAttribute('data-theme') === 'dark';

			heroCtx.clearRect(0, 0, w, h);
			heroCtx.fillStyle = isDark ? '#09090b' : '#0c0a09';
			heroCtx.fillRect(0, 0, w, h);

			const minFreq = 20;
			const maxFreq = 20000;
			const logMin = Math.log10(minFreq);
			const logMax = Math.log10(maxFreq);
			const logRange = logMax - logMin;

			const freqToX = (hz: number) => {
				const clamped = Math.max(minFreq, Math.min(maxFreq, hz));
				return ((Math.log10(clamped) - logMin) / logRange) * w;
			};

			const bottomY = h - 20;

			// Horizontal divider above bottom gutter
			heroCtx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
			heroCtx.lineWidth = 1;
			heroCtx.beginPath();
			heroCtx.moveTo(0, bottomY);
			heroCtx.lineTo(w, bottomY);
			heroCtx.stroke();

			// Landmark grid lines: 100 Hz, 1 kHz, 10 kHz
			heroCtx.strokeStyle = 'rgba(255, 255, 255, 0.08)';
			heroCtx.lineWidth = 1;
			heroCtx.setLineDash([2, 4]);
			[100, 1000, 10000].forEach((hz) => {
				const x = freqToX(hz);
				heroCtx.beginPath();
				heroCtx.moveTo(x, 0);
				heroCtx.lineTo(x, bottomY);
				heroCtx.stroke();
			});
			heroCtx.setLineDash([]);

			// Frequency labels matching Spectrogram (20 Hz, 100 Hz, 1 kHz, 10 kHz, 20 kHz)
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			const fontSize = Math.round(9.5 * dpr);
			heroCtx.font = `${fontSize}px monospace`;
			heroCtx.fillStyle = 'rgba(255, 255, 255, 0.35)';

			heroCtx.textAlign = 'left';
			heroCtx.fillText('20 Hz', 6 * dpr, h - 5 * dpr);

			heroCtx.textAlign = 'center';
			heroCtx.fillText('100 Hz', freqToX(100), h - 5 * dpr);
			heroCtx.fillText('1 kHz', freqToX(1000), h - 5 * dpr);

			heroCtx.textAlign = 'right';
			heroCtx.fillText('10 kHz', freqToX(10000) - 4 * dpr, h - 5 * dpr);
			heroCtx.fillText('20 kHz', w - 6 * dpr, h - 5 * dpr);

			// Horizontal dB guide lines
			heroCtx.strokeStyle = 'rgba(255, 255, 255, 0.04)';
			[0.25, 0.5, 0.75].forEach(ratio => {
				const y = bottomY - ratio * (bottomY - 14);
				heroCtx.beginPath();
				heroCtx.moveTo(0, y);
				heroCtx.lineTo(w, y);
				heroCtx.stroke();
			});

			if (!fftAnalyser || !audioCtx) {
				// Flat baseline
				heroCtx.strokeStyle = 'rgba(249, 115, 22, 0.25)';
				heroCtx.beginPath();
				heroCtx.moveTo(0, bottomY);
				heroCtx.lineTo(w, bottomY);
				heroCtx.stroke();
				return;
			}

			const binCount = fftAnalyser.frequencyBinCount;
			const freqData = new Uint8Array(binCount);
			fftAnalyser.getByteFrequencyData(freqData);

			const sampleRate = audioCtx.sampleRate;
			const binWidth = (sampleRate / 2) / binCount;

			const stepPx = Math.max(1, Math.round(w / 300));
			const yPoints: number[] = [];

			for (let x = 0; x <= w; x += stepPx) {
				const normX0 = Math.max(0, (x - stepPx * 0.5) / w);
				const normX1 = Math.min(1, (x + stepPx * 0.5) / w);
				const hz0 = Math.pow(10, logMin + normX0 * logRange);
				const hz1 = Math.pow(10, logMin + normX1 * logRange);
				const binStart = Math.max(0, Math.floor(hz0 / binWidth));
				const binEnd = Math.min(binCount - 1, Math.ceil(hz1 / binWidth));

				let val = 0;
				if (binEnd > binStart) {
					for (let b = binStart; b <= binEnd; b++) {
						if (freqData[b] > val) val = freqData[b];
					}
				} else {
					const hz = Math.pow(10, logMin + (x / w) * logRange);
					const binExact = Math.min(binCount - 1, Math.max(0, hz / binWidth));
					const b0 = Math.floor(binExact);
					const b1 = Math.min(binCount - 1, b0 + 1);
					const frac = binExact - b0;
					val = freqData[b0] * (1 - frac) + freqData[b1] * frac;
				}

				const norm = Math.min(1.0, Math.pow(val / 255, 0.78) * 1.25);
				const y = bottomY - norm * (bottomY - 14);
				yPoints.push(y);
			}

			// Build filled polygon
			heroCtx.beginPath();
			heroCtx.moveTo(0, bottomY);
			for (let i = 0, x = 0; x <= w; x += stepPx, i++) {
				heroCtx.lineTo(x, yPoints[i]);
			}
			heroCtx.lineTo(w, bottomY);
			heroCtx.closePath();

			const grad = heroCtx.createLinearGradient(0, 0, 0, bottomY);
			grad.addColorStop(0, 'rgba(249, 115, 22, 0.55)');
			grad.addColorStop(0.65, 'rgba(249, 115, 22, 0.2)');
			grad.addColorStop(1, 'rgba(249, 115, 22, 0.02)');
			heroCtx.fillStyle = grad;
			heroCtx.fill();

			// Curve stroke with orange glow
			heroCtx.strokeStyle = '#f97316';
			heroCtx.lineWidth = 2.0;
			heroCtx.shadowColor = '#f97316';
			heroCtx.shadowBlur = 6;
			heroCtx.beginPath();
			for (let i = 0, x = 0; x <= w; x += stepPx, i++) {
				if (x === 0) heroCtx.moveTo(x, yPoints[i]);
				else heroCtx.lineTo(x, yPoints[i]);
			}
			heroCtx.stroke();
			heroCtx.shadowBlur = 0;

			// Tuning target frequency marker
			if (activeMode === 'tone' || activeMode === 'sweep') {
				const targetX = freqToX(currentToneHz);
				heroCtx.strokeStyle = 'rgba(249, 115, 22, 0.45)';
				heroCtx.lineWidth = 1;
				heroCtx.setLineDash([2, 2]);
				heroCtx.beginPath();
				heroCtx.moveTo(targetX, 0);
				heroCtx.lineTo(targetX, bottomY);
				heroCtx.stroke();
				heroCtx.setLineDash([]);
			}
		}

		// -------------------------------------------------------------
		// VISUALIZER 3: 2D SPECTROGRAM WATERFALL (DOWNWARD HEATMAP)
		// -------------------------------------------------------------
		let specHistoryCanvas: HTMLCanvasElement | null = null;
		let specHistoryCtx: CanvasRenderingContext2D | null = null;
		let lastSpecTime = 0;

		function renderSpectrogramScope() {
			if (!heroCtx || !heroCanvas) return;
			const w = heroCanvas.width;
			const h = heroCanvas.height;
			const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
			const bottomY = h - 20;
			const waterfallH = Math.max(1, bottomY);

			if (!specHistoryCanvas || specHistoryCanvas.width !== w || specHistoryCanvas.height !== waterfallH) {
				specHistoryCanvas = document.createElement('canvas');
				specHistoryCanvas.width = w;
				specHistoryCanvas.height = waterfallH;
				specHistoryCtx = specHistoryCanvas.getContext('2d', { willReadFrequently: true });
				if (specHistoryCtx) {
					specHistoryCtx.fillStyle = isDark ? '#09090b' : '#0c0a09';
					specHistoryCtx.fillRect(0, 0, w, waterfallH);
				}
			}

			if (!specHistoryCtx) return;

			const now = performance.now();
			const dt = now - lastSpecTime;
			const scrollSpeed = 1;

			if (dt >= 15) {
				lastSpecTime = now;

				// Waterfall scrolls downward: live audio enters at top (y = 0) and flows down
				specHistoryCtx.drawImage(
					specHistoryCanvas,
					0, 0, w, waterfallH - scrollSpeed,
					0, scrollSpeed, w, waterfallH - scrollSpeed
				);

				// Blank new top row
				specHistoryCtx.fillStyle = isDark ? '#09090b' : '#0c0a09';
				specHistoryCtx.fillRect(0, 0, w, scrollSpeed);

				if (fftAnalyser && audioCtx) {
					const binCount = fftAnalyser.frequencyBinCount;
					const freqData = new Uint8Array(binCount);
					fftAnalyser.getByteFrequencyData(freqData);

					const sampleRate = audioCtx.sampleRate;
					const binWidth = (sampleRate / 2) / binCount;

					const minFreq = 20;
					const maxFreq = 20000;
					const logMin = Math.log10(minFreq);
					const logMax = Math.log10(maxFreq);
					const logRange = logMax - logMin;

					const imgData = specHistoryCtx.createImageData(w, scrollSpeed);
					const data = imgData.data;

					for (let x = 0; x < w; x++) {
						const normX0 = Math.max(0, (x - 0.5) / Math.max(1, w - 1));
						const normX1 = Math.min(1, (x + 0.5) / Math.max(1, w - 1));
						const hz0 = Math.pow(10, logMin + normX0 * logRange);
						const hz1 = Math.pow(10, logMin + normX1 * logRange);
						const binStart = Math.max(0, Math.floor(hz0 / binWidth));
						const binEnd = Math.min(binCount - 1, Math.ceil(hz1 / binWidth));

						let rawVal = 0;
						if (binEnd > binStart) {
							for (let b = binStart; b <= binEnd; b++) {
								if (freqData[b] > rawVal) rawVal = freqData[b];
							}
						} else {
							const hz = Math.pow(10, logMin + (x / Math.max(1, w - 1)) * logRange);
							const binExact = Math.min(binCount - 1, Math.max(0, hz / binWidth));
							const b0 = Math.floor(binExact);
							const b1 = Math.min(binCount - 1, b0 + 1);
							const frac = binExact - b0;
							rawVal = freqData[b0] * (1 - frac) + freqData[b1] * frac;
						}

						const val = Math.min(255, Math.pow(rawVal / 255, 0.85) * 260);

						let r = isDark ? 9 : 12;
						let g = isDark ? 9 : 10;
						let b = isDark ? 11 : 9;
						let a = 255;

						if (val > 8) {
							if (val < 65) {
								const t = val / 65;
								r = Math.round(12 + t * 95);
								g = Math.round(12 + t * 25);
								b = Math.round(25 + t * 50);
							} else if (val < 145) {
								const t = (val - 65) / 80;
								r = Math.round(107 + t * 142);
								g = Math.round(37 + t * 78);
								b = Math.round(75 - t * 53);
							} else if (val < 215) {
								const t = (val - 145) / 70;
								r = Math.round(249 + t * 2);
								g = Math.round(115 + t * 76);
								b = Math.round(22 + t * 14);
							} else {
								const t = (val - 215) / 40;
								r = Math.round(251 + t * 4);
								g = Math.round(191 + t * 64);
								b = Math.round(36 + t * 219);
							}
						}

						for (let s = 0; s < scrollSpeed; s++) {
							const idx = (s * w + x) * 4;
							data[idx] = r;
							data[idx + 1] = g;
							data[idx + 2] = b;
							data[idx + 3] = a;
						}
					}
					specHistoryCtx.putImageData(imgData, 0, 0);
				}
			}

			// Clear and fill canvas background
			heroCtx.clearRect(0, 0, w, h);
			heroCtx.fillStyle = isDark ? '#09090b' : '#0c0a09';
			heroCtx.fillRect(0, 0, w, h);

			// Blit waterfall history
			heroCtx.drawImage(specHistoryCanvas, 0, 0);

			const minFreq = 20;
			const maxFreq = 20000;
			const logMin = Math.log10(minFreq);
			const logMax = Math.log10(maxFreq);
			const logRange = logMax - logMin;
			const freqToX = (hz: number) => {
				const clamped = Math.max(minFreq, Math.min(maxFreq, hz));
				return ((Math.log10(clamped) - logMin) / logRange) * w;
			};

			// Horizontal divider above bottom gutter
			heroCtx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
			heroCtx.lineWidth = 1;
			heroCtx.beginPath();
			heroCtx.moveTo(0, bottomY);
			heroCtx.lineTo(w, bottomY);
			heroCtx.stroke();

			// Vertical grid lines (100 Hz, 1 kHz, 10 kHz)
			heroCtx.strokeStyle = 'rgba(255, 255, 255, 0.08)';
			heroCtx.lineWidth = 1;
			heroCtx.setLineDash([2, 4]);
			[100, 1000, 10000].forEach((hz) => {
				const x = freqToX(hz);
				heroCtx.beginPath();
				heroCtx.moveTo(x, 0);
				heroCtx.lineTo(x, bottomY);
				heroCtx.stroke();
			});
			heroCtx.setLineDash([]);

			// Frequency labels matching Frequency Generator (20 Hz, 100 Hz, 1 kHz, 10 kHz, 20 kHz)
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			const fontSize = Math.round(9.5 * dpr);
			heroCtx.font = `${fontSize}px monospace`;
			heroCtx.fillStyle = 'rgba(255, 255, 255, 0.35)';

			heroCtx.textAlign = 'left';
			heroCtx.fillText('20 Hz', 6 * dpr, h - 5 * dpr);

			heroCtx.textAlign = 'center';
			heroCtx.fillText('100 Hz', freqToX(100), h - 5 * dpr);
			heroCtx.fillText('1 kHz', freqToX(1000), h - 5 * dpr);

			heroCtx.textAlign = 'right';
			heroCtx.fillText('10 kHz', freqToX(10000) - 4 * dpr, h - 5 * dpr);
			heroCtx.fillText('20 kHz', w - 6 * dpr, h - 5 * dpr);

			// Tuning target cursor
			if (activeMode === 'tone' || activeMode === 'sweep') {
				const targetX = freqToX(currentToneHz);
				heroCtx.strokeStyle = 'rgba(249, 115, 22, 0.45)';
				heroCtx.lineWidth = 1;
				heroCtx.setLineDash([2, 2]);
				heroCtx.beginPath();
				heroCtx.moveTo(targetX, 0);
				heroCtx.lineTo(targetX, bottomY);
				heroCtx.stroke();
				heroCtx.setLineDash([]);
			}
		}

		// -------------------------------------------------------------
		// DEDICATED HORIZONTAL STEREO PEAK / VU METER (FULL WIDTH)
		// -------------------------------------------------------------
		function renderStereoMeter() {
			if (!meterCtx || !meterCanvas) return;
			const w = meterCanvas.width;
			const h = meterCanvas.height;
			const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
			const dpr = Math.min(window.devicePixelRatio || 1, 2);

			meterCtx.clearRect(0, 0, w, h);
			meterCtx.fillStyle = isDark ? '#09090b' : '#0c0a09';
			meterCtx.fillRect(0, 0, w, h);

			const now = performance.now();
			let currentPeakL = 0;
			let currentPeakR = 0;

			if (analyserLeft && analyserRight && activeMode !== 'none') {
				const bufLen = analyserLeft.fftSize;
				const timeL = new Float32Array(bufLen);
				const timeR = new Float32Array(bufLen);
				analyserLeft.getFloatTimeDomainData(timeL);
				analyserRight.getFloatTimeDomainData(timeR);

				for (let i = 0; i < bufLen; i++) {
					const absL = Math.abs(timeL[i]);
					const absR = Math.abs(timeR[i]);
					if (absL > currentPeakL) currentPeakL = absL;
					if (absR > currentPeakR) currentPeakR = absR;
				}
			}

			// Instantaneous dBFS (clamped to [-60 dBFS .. 0 dBFS])
			const dbL = currentPeakL > 0.0005 ? Math.max(-60, 20 * Math.log10(currentPeakL)) : -60;
			const dbR = currentPeakR > 0.0005 ? Math.max(-60, 20 * Math.log10(currentPeakR)) : -60;

			// Smooth meter ballistics (instant attack, smooth release decay ~1.25 dB/frame)
			if (dbL >= smoothL) smoothL = dbL;
			else smoothL = Math.max(-60, smoothL - 1.25);

			if (dbR >= smoothR) smoothR = dbR;
			else smoothR = Math.max(-60, smoothR - 1.25);

			// Peak Hold needle logic (hold 750ms, then drop with gravity)
			if (dbL >= peakHoldL) {
				peakHoldL = dbL;
				peakHoldTimeL = now;
			} else if (now - peakHoldTimeL > 750) {
				peakHoldL = Math.max(-60, peakHoldL - 0.75);
			}

			if (dbR >= peakHoldR) {
				peakHoldR = dbR;
				peakHoldTimeR = now;
			} else if (now - peakHoldTimeR > 750) {
				peakHoldR = Math.max(-60, peakHoldR - 0.75);
			}

			// Horizontal Layout Dimensions
			const labelW = Math.round(18 * dpr);
			const readoutW = Math.round(52 * dpr);
			const trackX0 = labelW + Math.round(6 * dpr);
			const trackX1 = w - readoutW - Math.round(4 * dpr);
			const trackW = Math.max(10, trackX1 - trackX0);

			const barH = Math.round(7 * dpr);
			const row1Y = Math.round(7 * dpr);
			const row2Y = Math.round(20 * dpr);
			const scaleY = Math.round(34 * dpr);

			// Helper: dB to X coordinate
			const dbToX = (val: number) => {
				const clamped = Math.max(-60, Math.min(0, val));
				const norm = (clamped + 60) / 60;
				return trackX0 + norm * trackW;
			};

			// Horizontal Gradient for active meter bars (Green -> Yellow -> Red)
			const grad = meterCtx.createLinearGradient(trackX0, 0, trackX1, 0);
			grad.addColorStop(0.0, '#15803d');   // Dark green (-60 dB)
			grad.addColorStop(0.65, '#22c55e');  // Vibrant green (-20 dB)
			grad.addColorStop(0.88, '#eab308');  // Yellow (-6 dB)
			grad.addColorStop(0.95, '#f97316');  // Amber (-3 dB)
			grad.addColorStop(1.0, '#ef4444');   // Red (0 dB)

			// ROW 1: LEFT CHANNEL (L)
			meterCtx.font = `bold ${Math.round(10 * dpr)}px sans-serif`;
			meterCtx.textAlign = 'center';
			meterCtx.textBaseline = 'middle';
			meterCtx.fillStyle = '#38bdf8';
			meterCtx.fillText('L', Math.round(9 * dpr), row1Y + barH / 2);

			// Track background
			meterCtx.fillStyle = 'rgba(255, 255, 255, 0.08)';
			meterCtx.fillRect(trackX0, row1Y, trackW, barH);

			// Active bar fill
			const fillW_L = ((smoothL + 60) / 60) * trackW;
			if (fillW_L > 0) {
				meterCtx.fillStyle = grad;
				meterCtx.fillRect(trackX0, row1Y, fillW_L, barH);
			}

			// Peak Hold Needle
			if (peakHoldL > -58) {
				meterCtx.fillStyle = '#ffffff';
				meterCtx.fillRect(Math.round(dbToX(peakHoldL)), row1Y, Math.round(1.5 * dpr), barH);
			}

			// Numeric dB readout
			meterCtx.textAlign = 'right';
			meterCtx.font = `bold ${Math.round(9 * dpr)}px monospace`;
			meterCtx.fillStyle = smoothL > -55 ? '#38bdf8' : 'rgba(255, 255, 255, 0.3)';
			const numL = smoothL <= -58 ? '-∞' : `${Math.round(smoothL)} dB`;
			meterCtx.fillText(numL, w - Math.round(4 * dpr), row1Y + barH / 2);

			// ROW 2: RIGHT CHANNEL (R)
			meterCtx.font = `bold ${Math.round(10 * dpr)}px sans-serif`;
			meterCtx.textAlign = 'center';
			meterCtx.fillStyle = '#f59e0b';
			meterCtx.fillText('R', Math.round(9 * dpr), row2Y + barH / 2);

			// Track background
			meterCtx.fillStyle = 'rgba(255, 255, 255, 0.08)';
			meterCtx.fillRect(trackX0, row2Y, trackW, barH);

			// Active bar fill
			const fillW_R = ((smoothR + 60) / 60) * trackW;
			if (fillW_R > 0) {
				meterCtx.fillStyle = grad;
				meterCtx.fillRect(trackX0, row2Y, fillW_R, barH);
			}

			// Peak Hold Needle
			if (peakHoldR > -58) {
				meterCtx.fillStyle = '#ffffff';
				meterCtx.fillRect(Math.round(dbToX(peakHoldR)), row2Y, Math.round(1.5 * dpr), barH);
			}

			// Numeric dB readout
			meterCtx.textAlign = 'right';
			meterCtx.font = `bold ${Math.round(9 * dpr)}px monospace`;
			meterCtx.fillStyle = smoothR > -55 ? '#f59e0b' : 'rgba(255, 255, 255, 0.3)';
			const numR = smoothR <= -58 ? '-∞' : `${Math.round(smoothR)} dB`;
			meterCtx.fillText(numR, w - Math.round(4 * dpr), row2Y + barH / 2);

			// SCALE TICKS & DB LABELS (Bottom Row)
			const marks = [-60, -48, -36, -24, -18, -12, -6, -3, 0];
			meterCtx.font = `${Math.round(7.5 * dpr)}px monospace`;
			meterCtx.textAlign = 'center';
			meterCtx.textBaseline = 'top';

			marks.forEach((m) => {
				const x = Math.round(dbToX(m));
				meterCtx.strokeStyle = 'rgba(255, 255, 255, 0.16)';
				meterCtx.beginPath();
				meterCtx.moveTo(x, scaleY - Math.round(4 * dpr));
				meterCtx.lineTo(x, scaleY);
				meterCtx.stroke();

				meterCtx.fillStyle = m >= -3 ? 'rgba(239, 68, 68, 0.85)' : (m >= -6 ? 'rgba(234, 179, 8, 0.85)' : 'rgba(255, 255, 255, 0.35)');
				const label = m === 0 ? '0' : (m === -60 ? '-∞' : `${m}`);
				meterCtx.fillText(label, x, scaleY + Math.round(2 * dpr));
			});
		}

		// Main visualizer animation loop
		let isAudioVisible = false;
		let rafVisualizerId: number | null = null;

		function renderActiveVisualizer() {
			if (!isAudioVisible) {
				rafVisualizerId = null;
				return;
			}
			if (activeHeroMode === 'waveform') {
				renderWaveformScope();
			} else if (activeHeroMode === 'spectrum') {
				renderSpectrumScope();
			} else {
				renderSpectrogramScope();
			}

			// Render horizontal stereo VU meter
			renderStereoMeter();

			rafVisualizerId = requestAnimationFrame(renderActiveVisualizer);
		}

		// 0% CPU consumption when off-screen
		const cardEl = document.getElementById('audio-lab');
		if (cardEl) {
			const obs = new IntersectionObserver((entries) => {
				entries.forEach((e) => {
					isAudioVisible = e.isIntersecting;
					if (isAudioVisible && !rafVisualizerId) {
						rafVisualizerId = requestAnimationFrame(renderActiveVisualizer);
					}
				});
			}, { threshold: 0.05 });
			obs.observe(cardEl);
		} else {
			isAudioVisible = true;
			rafVisualizerId = requestAnimationFrame(renderActiveVisualizer);
		}
	}

	setupAudioTest();
	document.addEventListener('astro:page-load', setupAudioTest);
</script>

