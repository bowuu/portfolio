---
import manifest from '../../public/models/manifest.json';

const groupedModels = manifest.reduce<Array<{ category: string; items: typeof manifest }>>((acc, item) => {
	let group = acc.find((g) => g.category === item.category);
	if (!group) {
		group = { category: item.category, items: [] };
		acc.push(group);
	}
	group.items.push(item);
	return acc;
}, []);
const defaultModel = manifest[0];
---

<div class="cad-viewer-container" id="cad-viewer" data-manifest={JSON.stringify(manifest)}>
	<div class="cad-viewer-header">
		<div class="cad-viewer-title-row">
			<div class="cad-viewer-title">
				<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
					<polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
					<line x1="12" y1="22.08" x2="12" y2="12"/>
				</svg>
				<span>Model Selection</span>
				<svg class="title-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<line x1="4" y1="12" x2="20" y2="12"></line>
					<polyline points="14 6 20 12 14 18"></polyline>
				</svg>
			</div>

			<!-- MODEL SELECTOR DROPDOWN (Generated from manifest.json) -->
			<div class="model-select-wrapper">
				<select id="cad-model-select" class="model-select" aria-label="Select 3D CAD Model">
					{groupedModels.map((group) => (
						<optgroup label={group.category}>
							{group.items.map((item) => (
								<option value={item.id} selected={item.id === defaultModel.id}>{item.name}</option>
							))}
						</optgroup>
					))}
				</select>
			</div>
		</div>

		<div class="cad-controls-top">
			<button id="cad-reset-cam-btn" class="cad-mini-btn" type="button" title="Reset Viewpoint">Reset View</button>
			<button id="cad-grid-btn" class="cad-mini-btn active" type="button" aria-pressed="true" title="Toggle XY Build Plate Grid">Grid: ON</button>
			<button id="cad-wireframe-btn" class="cad-mini-btn" type="button" aria-pressed="false">Wireframe: OFF</button>
			<button id="cad-centrifuge-btn" class="cad-mini-btn" type="button" aria-pressed="false" title="Centrifuge Stress Test (10,000 RPM)">Centrifuge: OFF</button>
			<button id="cad-slicer-btn" class="cad-mini-btn" type="button" aria-pressed="false" title="Interactive FDM Slicer Layer View">Slicer: OFF</button>
			<button id="cad-upload-btn" class="cad-mini-btn" type="button" title="Upload local STEP, IGES, STL, OBJ, 3MF, or GLB/GLTF file">Upload CAD</button>
			<input id="cad-upload-input" type="file" accept=".stp,.step,.igs,.iges,.stl,.obj,.3mf,.glb,.gltf" class="cad-sr-only" aria-label="Upload 3D CAD File" />
			<button id="cad-orient-btn" class="cad-mini-btn hidden" type="button" aria-pressed="false" title="Toggle CAD Z-Up vs Three.js Y-Up axis">Axis: Y-Up</button>
			<button id="cad-export-json-btn" class="cad-mini-btn cad-download-btn hidden" type="button" title="Export converted high-quality mesh as .JSON">Export .JSON</button>
			<a id="cad-download-btn" class="cad-mini-btn cad-download-btn" href={defaultModel.stepFile} download={defaultModel.file} title={`Download ${defaultModel.name} (${defaultModel.file})`} aria-label="Download .STP (CAD STEP File)">
				<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
					<polyline points="7 10 12 15 17 10"></polyline>
					<line x1="12" y1="15" x2="12" y2="3"></line>
				</svg>
				<span>Download .STP</span>
			</a>
		</div>
	</div>

	<!-- MODEL QUICK DESCRIPTION -->
	<div class="cad-model-meta-strip">
		<span id="model-desc-text" class="model-desc-text" title={defaultModel.desc}>
			{defaultModel.desc}
		</span>
	</div>

	<!-- PRINT-ONLY SUMMARY OF 3D MODELS (Generated from manifest.json) -->
	<div class="print-only cad-print-summary">
		<p class="print-summary-title"><strong>Selected 3D CAD &amp; Prototyping Designs (MakerWorld @brob):</strong></p>
		<ul class="print-model-list">
			{groupedModels.map((group) => (
				<li>
					<strong>{group.category}:</strong> {group.items.map((i) => i.name).join(', ')}
				</li>
			))}
		</ul>
	</div>

	<!-- 3D WEBGL CANVAS -->
	<div class="canvas-wrapper" id="canvas-container">
		<canvas id="cad-canvas" tabindex="0" aria-label="Interactive 3D CAD model viewer. Drag to orbit or use arrow keys to rotate and R to reset view."></canvas>
		<div id="cad-centrifuge-hud" class="cad-centrifuge-hud hidden">
			<span class="hud-pulse-dot"></span>
			<span>CENTRIFUGE STRESS TEST: <strong id="hud-rpm-val">0 RPM</strong> ▪ PEAK LOAD: <strong id="hud-g-val">0G</strong> ▪ DYNAMIC IMBALANCE: <span id="hud-vib-val">0.0G</span></span>
		</div>
		<div id="cad-slicer-hud" class="cad-slicer-hud hidden">
			<div class="slicer-hud-info">
				<span class="slicer-pulse-dot"></span>
				<span class="slicer-hud-title">FDM TOOLPATH SLICER:</span>
				<strong id="slicer-hud-layer">Layer 140 / 140</strong>
				<span class="slicer-hud-sub" id="slicer-hud-mm">(28.0 mm)</span>
				<span class="slicer-hud-sep">▪</span>
				<span id="slicer-hud-filament">PETG: ~50g</span>
				<span class="slicer-hud-sep">▪</span>
				<span id="slicer-hud-time">Est: 1h 42m</span>
			</div>
			<div class="slicer-slider-bar">
				<span class="slicer-bound">0mm</span>
				<input type="range" id="cad-slicer-slider" min="0" max="100" value="100" class="slicer-range-input" aria-label="Slicer Layer Height">
				<span class="slicer-bound" id="slicer-bound-max">76mm</span>
			</div>
		</div>
		<div id="cad-loading-overlay" class="cad-loading hidden" role="status" aria-live="polite">
			<div class="spinner" id="cad-loading-spinner"></div>
			<span id="cad-loading-text">Loading 3D CAD Mesh...</span>
		</div>
		<div id="cad-drop-overlay" class="cad-drop-overlay hidden" aria-hidden="true">
			<span>Drop 3D CAD file (.stp, .igs, .stl, .obj, .3mf, .glb)</span>
		</div>
		<div class="cad-drag-hint">
			<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
				<path d="m5 9-3 3 3 3M9 5l3-3 3 3M15 19l-3 3-3-3M19 9l3 3-3 3M2 12h20M12 2v20"/>
			</svg>
			<span class="hint-desktop">Orbit: Left-drag ▪ Pan: Right-drag / Two-finger ▪ Zoom: Scroll / Pinch</span>
			<span class="hint-mobile">Drag to orbit ▪ Two-finger pan/pinch</span>
		</div>
	</div>

	<!-- CONTROLS & SPEC BAR -->
	<div class="cad-viewer-footer">
		<div class="cad-color-picker" role="group" aria-label="Filament Color">
			<span class="color-label">Color:</span>
			<button type="button" class="color-dot active" data-color="#ea580c" title="Signal Orange" aria-label="Signal Orange" aria-pressed="true" style="background: #ea580c;"></button>
			<button type="button" class="color-dot" data-color="#facc15" title="Sunflower Yellow" aria-label="Sunflower Yellow" aria-pressed="false" style="background: #facc15;"></button>
			<button type="button" class="color-dot" data-color="#10b981" title="Cyber Green" aria-label="Cyber Green" aria-pressed="false" style="background: #10b981;"></button>
			<button type="button" class="color-dot" data-color="#2563eb" title="Tech Blue" aria-label="Tech Blue" aria-pressed="false" style="background: #2563eb;"></button>
			<button type="button" class="color-dot" data-color="#9333ea" title="Royal Purple" aria-label="Royal Purple" aria-pressed="false" style="background: #9333ea;"></button>
			<button type="button" class="color-dot" data-color="#f472b6" title="Sakura Pink" aria-label="Sakura Pink" aria-pressed="false" style="background: #f472b6;"></button>
			<button type="button" class="color-dot light-dot" data-color="#f8fafc" title="Clean White" aria-label="Clean White" aria-pressed="false" style="background: #f8fafc;"></button>
			<button type="button" class="color-dot" data-color="#64748b" title="Cool Gray" aria-label="Cool Gray" aria-pressed="false" style="background: #64748b;"></button>
			<button type="button" class="color-dot" data-color="#1e293b" title="Matte Black PETG" aria-label="Matte Black PETG" aria-pressed="false" style="background: #1e293b;"></button>
		</div>
		<div class="cad-specs" id="cad-specs">
			<span class="spec-tag" id="spec-dim">241 x 28 x 76 mm</span>
			<span class="spec-tag" id="spec-poly">12,602 Triangles</span>
			<span class="spec-tag" id="spec-verts">9,224 Vertices</span>
		</div>
	</div>
</div>

<script>
	import type * as ThreeTypes from 'three';

	interface ModelMeta {
		id: string;
		name: string;
		file: string;
		category: string;
		desc: string;
		dimensions: string;
		jsonFile: string;
		stepFile: string;
		triangles: number;
		vertices: number;
	}

	interface MeshPayload {
		id: string;
		name: string;
		file: string;
		category: string;
		desc: string;
		bbox: { width: number; height: number; depth: number };
		triangles: number;
		vertices: number;
		positions: number[];
		normals: number[];
		indices: number[];
	}

	function initCadViewer() {
		const viewerContainer = document.getElementById('cad-viewer');
		const canvas = document.getElementById('cad-canvas') as HTMLCanvasElement | null;
		const container = document.getElementById('canvas-container');
		if (!viewerContainer || !canvas || !container) return;
		if (viewerContainer.dataset.bound === '1') return;
		viewerContainer.dataset.bound = '1';

		// Clean up previous instance if any
		if ((canvas as any).__cleanup) {
			(canvas as any).__cleanup();
		}

		let isViewerInitialized = false;
		let isSceneStarting = false;
		let isViewerVisible = false;
		let isPausedByEasterEgg = false;
		let animationFrameId: number | null = null;
		let startAnimationLoop: (() => void) | null = null;
		let sceneCleanup: (() => void) | null = null;
		let triggerCentrifugeExternal: ((active?: boolean) => void) | null = null;
		let toggleGridExternal: (() => void) | null = null;
		let toggleSlicerExternal: ((layerPct?: number) => void) | null = null;
		let pendingAction: (() => void) | null = null;

		(window as any).__triggerCadCentrifuge = (active?: boolean) => {
			if (!isViewerInitialized) {
				pendingAction = () => triggerCentrifugeExternal?.(active);
				startCadScene();
				return;
			}
			triggerCentrifugeExternal?.(active);
		};
		(window as any).__toggleCadGrid = () => {
			if (!isViewerInitialized) {
				pendingAction = () => toggleGridExternal?.();
				startCadScene();
				return;
			}
			toggleGridExternal?.();
		};
		(window as any).__toggleCadSlicer = (layerPct?: number) => {
			if (!isViewerInitialized) {
				pendingAction = () => toggleSlicerExternal?.(layerPct);
				startCadScene();
				return;
			}
			toggleSlicerExternal?.(layerPct);
		};

		async function startCadScene() {
			if (isViewerInitialized || isSceneStarting) return;
			isSceneStarting = true;
			const loadingOverlay = document.getElementById('cad-loading-overlay');
			if (loadingOverlay) loadingOverlay.classList.remove('hidden');

			let THREE: typeof ThreeTypes;
			let OrbitControls: typeof import('three/examples/jsm/controls/OrbitControls.js').OrbitControls;
			try {
				const [threeMod, orbitMod] = await Promise.all([
					import('three'),
					import('three/examples/jsm/controls/OrbitControls.js'),
				]);
				THREE = threeMod;
				OrbitControls = orbitMod.OrbitControls;
			} catch (err) {
				isSceneStarting = false;
				if (loadingOverlay) loadingOverlay.classList.add('hidden');
				console.error('Failed to load Three.js:', err);
				return;
			}

			isSceneStarting = false;
			isViewerInitialized = true;

			const ac = new AbortController();
			const { signal } = ac;

			const renderer = new THREE.WebGLRenderer({
				canvas: canvas!,
				antialias: true,
				alpha: true,
				powerPreference: 'high-performance',
			});
			renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
			renderer.toneMapping = THREE.ACESFilmicToneMapping;
			renderer.toneMappingExposure = 1.15;
			renderer.localClippingEnabled = true;

			const initW = Math.max(1, container!.clientWidth);
			const initH = Math.max(1, container!.clientHeight);
			const scene = new THREE.Scene();
			const camera = new THREE.PerspectiveCamera(40, initW / initH, 0.1, 1000);
			camera.position.set(45, 38, 55);

			const controls = new OrbitControls(camera, canvas!);
			controls.enableDamping = true;
			controls.dampingFactor = 0.06;
			controls.minDistance = 15;
			controls.maxDistance = 220;
			controls.maxPolarAngle = Math.PI - 0.02;

			let isUserInteracting = false;
			controls.addEventListener('start', () => {
				isUserInteracting = true;
				startAnimationLoop?.();
			});
			controls.addEventListener('end', () => {
				isUserInteracting = false;
				startAnimationLoop?.();
			});

			// WebGL context loss recovery
			canvas!.addEventListener(
				'webglcontextlost',
				(e) => {
					e.preventDefault();
					if (animationFrameId !== null) {
						cancelAnimationFrame(animationFrameId);
						animationFrameId = null;
					}
				},
				{ signal }
			);
			canvas!.addEventListener(
				'webglcontextrestored',
				() => {
					sceneCleanup?.();
					isViewerInitialized = false;
					startCadScene();
				},
				{ signal }
			);

			// Lighting
			const ambientLight = new THREE.AmbientLight(0xffffff, 1.2);
			scene.add(ambientLight);

			const keyLight = new THREE.DirectionalLight(0xffffff, 2.2);
			keyLight.position.set(60, 80, 50);
			scene.add(keyLight);

			const fillLight = new THREE.DirectionalLight(0x93c5fd, 1.2);
			fillLight.position.set(-60, 40, -50);
			scene.add(fillLight);

			const rimLight = new THREE.DirectionalLight(0xffedd5, 1.2);
			rimLight.position.set(0, -50, 40);
			scene.add(rimLight);

			const underLight = new THREE.DirectionalLight(0xffffff, 1.1);
			underLight.position.set(0, -70, -30);
			scene.add(underLight);

			// Build Plate Grid
			const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
			function getGridColors(dark: boolean) {
				return {
					primary: dark ? 0x64748b : 0x64748b,
					secondary: dark ? 0x384556 : 0xb8c4d4,
				};
			}
			const { primary: gridPrimary, secondary: gridSecondary } = getGridColors(isDark);
			let grid = new THREE.GridHelper(80, 20, gridPrimary, gridSecondary);
			grid.position.y = -18;
			scene.add(grid);

			function updateGridTheme(dark: boolean) {
				const colors = getGridColors(dark);
				const prevY = grid.position.y;
				const prevVis = grid.visible;
				scene.remove(grid);
				grid.geometry.dispose();
				if (Array.isArray(grid.material)) {
					grid.material.forEach((m) => m.dispose());
				} else {
					grid.material.dispose();
				}
				grid = new THREE.GridHelper(80, 20, colors.primary, colors.secondary);
				grid.position.y = prevY;
				grid.visible = prevVis;
				scene.add(grid);
				renderer.render(scene, camera);
			}

			const cadThemeObserver = new MutationObserver((mutations) => {
				for (const mutation of mutations) {
					if (mutation.type === 'attributes' && mutation.attributeName === 'data-theme') {
						const dark = document.documentElement.getAttribute('data-theme') === 'dark';
						updateGridTheme(dark);
						break;
					}
				}
			});
			cadThemeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

			// Slicer Toolpath Plane & Group
			const slicePlane = new THREE.Plane(new THREE.Vector3(0, -1, 0), 1000);
			const toolpathGroup = new THREE.Group();
			const toolpathGrid = new THREE.GridHelper(60, 30, 0x38bdf8, 0x0ea5e9);
			(toolpathGrid.material as ThreeTypes.Material).transparent = true;
			(toolpathGrid.material as ThreeTypes.Material).opacity = 0.55;
			toolpathGroup.add(toolpathGrid);
			scene.add(toolpathGroup);
			toolpathGroup.visible = false;

			// Model Group
			const modelGroup = new THREE.Group();
			scene.add(modelGroup);

			// Material (Default to vibrant Orange for high contrast)
			const baseHex = 0xea580c;
			const material = new THREE.MeshStandardMaterial({
				color: baseHex,
				roughness: 0.38,
				metalness: 0.08,
				flatShading: false,
				wireframe: false,
			});

			let currentMeshObj: ThreeTypes.Mesh | null = null;
			const geometryCache: Record<string, { data: MeshPayload; geometry: ThreeTypes.BufferGeometry }> = {};
			const uploadedModels: Record<string, { data: MeshPayload; geometry: ThreeTypes.BufferGeometry; zUp: boolean }> = {};
			const manifestMap: Record<string, ModelMeta> = {};
			let activeLoadController: AbortController | null = null;
			let activeLoadSeq = 0;
			let activeModelId = '';

			// UI Elements
			const selectEl = document.getElementById('cad-model-select') as HTMLSelectElement | null;
			const descTextEl = document.getElementById('model-desc-text');
			const specDimEl = document.getElementById('spec-dim');
			const specPolyEl = document.getElementById('spec-poly');
			const specVertsEl = document.getElementById('spec-verts');
			const downloadBtn = document.getElementById('cad-download-btn') as HTMLAnchorElement | null;
			const uploadBtn = document.getElementById('cad-upload-btn');
			const uploadInput = document.getElementById('cad-upload-input') as HTMLInputElement | null;
			const orientBtn = document.getElementById('cad-orient-btn');
			const exportJsonBtn = document.getElementById('cad-export-json-btn');
			const dropOverlay = document.getElementById('cad-drop-overlay');
			const gridBtn = document.getElementById('cad-grid-btn');
			const wireframeBtn = document.getElementById('cad-wireframe-btn');
			const resetCamBtn = document.getElementById('cad-reset-cam-btn');
			const centrifugeBtn = document.getElementById('cad-centrifuge-btn');
			const centrifugeHud = document.getElementById('cad-centrifuge-hud');
			const colorDots = document.querySelectorAll('.color-dot');

			let centrifugeActive = false;
			let centrifugeSpeed = 0;
			let currentRpm = 0;
			const TARGET_CENTRIFUGE_SPEED = 1.35;
			const TARGET_RPM = 10000;
			let activeModelRadiusM = 0.1205;
			let activeModelMinY = -18;
			let activeModelMaxY = 10;
			let activeModelHeightMm = 76;
			let activePlasticVolumeCm3 = 34;
			let activeTotalLayers = 380;
			let slicerActive = false;

			const hudRpmEl = document.getElementById('hud-rpm-val');
			const hudGEl = document.getElementById('hud-g-val');
			const hudVibEl = document.getElementById('hud-vib-val');

			const slicerBtn = document.getElementById('cad-slicer-btn');
			const slicerHud = document.getElementById('cad-slicer-hud');
			const slicerSliderEl = document.getElementById('cad-slicer-slider') as HTMLInputElement | null;
			const slicerHudLayerEl = document.getElementById('slicer-hud-layer');
			const slicerHudMmEl = document.getElementById('slicer-hud-mm');
			const slicerHudFilamentEl = document.getElementById('slicer-hud-filament');
			const slicerHudTimeEl = document.getElementById('slicer-hud-time');
			const slicerBoundMaxEl = document.getElementById('slicer-bound-max');

			function updateSlicer() {
				if (!currentMeshObj || !currentMeshObj.geometry.boundingBox) return;
				const sliderVal = slicerSliderEl ? parseInt(slicerSliderEl.value, 10) : 100;
				const pct = Math.max(0, Math.min(1, sliderVal / 100));
				const currentY = activeModelMinY + pct * (activeModelMaxY - activeModelMinY);

				slicePlane.constant = currentY;
				toolpathGroup.position.y = currentY;

				const currentLayer = Math.max(1, Math.round(activeTotalLayers * pct));
				const currentMm = (activeModelHeightMm * pct).toFixed(1);

				// PETG mass (~1.27 g/cm³) from actual mesh shell (6 walls) + 20% crosshatch infill volume
				const estFilamentG = Math.max(1, Math.round(activePlasticVolumeCm3 * 1.27 * pct));
				const estTotalMins = Math.max(5, Math.round(activePlasticVolumeCm3 * 2.2));
				const elapsedMins = Math.round(estTotalMins * pct);
				const estHours = Math.floor(elapsedMins / 60);
				const estMins = elapsedMins % 60;

				if (slicerHudLayerEl) slicerHudLayerEl.textContent = `Layer ${currentLayer} / ${activeTotalLayers}`;
				if (slicerHudMmEl) slicerHudMmEl.textContent = `(${currentMm} mm)`;
				if (slicerHudFilamentEl) slicerHudFilamentEl.textContent = `PETG: ~${estFilamentG}g`;
				if (slicerHudTimeEl) slicerHudTimeEl.textContent = `Est: ${estHours > 0 ? `${estHours}h ` : ''}${estMins}m`;
				renderer.render(scene, camera);
			}

			function setSlicer(active: boolean) {
				slicerActive = active;
				if (centrifugeActive && active) setCentrifuge(false);
				if (slicerBtn) {
					slicerBtn.textContent = active ? 'Slicer: ON' : 'Slicer: OFF';
					slicerBtn.classList.toggle('active-slicer', active);
					slicerBtn.setAttribute('aria-pressed', String(active));
				}
				if (slicerHud) {
					slicerHud.classList.toggle('hidden', !active);
				}
				material.clippingPlanes = active ? [slicePlane] : [];
				material.side = active ? THREE.DoubleSide : THREE.FrontSide;
				material.needsUpdate = true;
				toolpathGroup.visible = active;
				if (active) {
					updateSlicer();
				} else {
					renderer.render(scene, camera);
				}
			}

			if (slicerBtn) {
				slicerBtn.addEventListener('click', () => setSlicer(!slicerActive), { signal });
			}
			if (slicerSliderEl) {
				slicerSliderEl.addEventListener('input', updateSlicer, { signal });
			}

			toggleSlicerExternal = (layerPct?: number) => {
				if (typeof layerPct === 'number') {
					if (!slicerActive) setSlicer(true);
					if (slicerSliderEl) {
						slicerSliderEl.value = Math.max(0, Math.min(100, layerPct)).toString();
						updateSlicer();
					}
				} else {
					setSlicer(!slicerActive);
				}
			};

			function setCentrifuge(active: boolean) {
				centrifugeActive = active;
				if (slicerActive && active) setSlicer(false);
				if (centrifugeBtn) {
					centrifugeBtn.textContent = active ? 'Centrifuge: ON' : 'Centrifuge: OFF';
					centrifugeBtn.classList.toggle('active-centrifuge', active);
					centrifugeBtn.setAttribute('aria-pressed', String(active));
				}
				if (centrifugeHud) {
					centrifugeHud.classList.toggle('hidden', !active);
				}
				startAnimationLoop?.();
			}

			function toggleCentrifuge() {
				setCentrifuge(!centrifugeActive);
			}

			if (centrifugeBtn) {
				centrifugeBtn.addEventListener('click', toggleCentrifuge, { signal });
			}

			// Triple-click canvas trigger
			let clickCount = 0;
			let clickTimer: ReturnType<typeof setTimeout> | null = null;
			canvas!.addEventListener(
				'click',
				() => {
					clickCount++;
					if (clickTimer) clearTimeout(clickTimer);
					clickTimer = setTimeout(() => {
						if (clickCount >= 3) toggleCentrifuge();
						clickCount = 0;
					}, 350);
				},
				{ signal }
			);

			// Spacebar shortcut when hovering viewer
			let isViewerHovered = false;
			container!.addEventListener('mouseenter', () => { isViewerHovered = true; }, { signal });
			container!.addEventListener('mouseleave', () => { isViewerHovered = false; }, { signal });
			window.addEventListener(
				'keydown',
				(e) => {
					if (e.code === 'Space' && isViewerHovered) {
						const activeEl = document.activeElement;
						if (activeEl && (activeEl.tagName === 'INPUT' || activeEl.tagName === 'TEXTAREA' || activeEl.tagName === 'SELECT')) {
							return;
						}
						e.preventDefault();
						toggleCentrifuge();
					}
				},
				{ signal }
			);

			triggerCentrifugeExternal = (active?: boolean) => {
				if (typeof active === 'boolean') {
					setCentrifuge(active);
				} else {
					toggleCentrifuge();
				}
			};

			function resize() {
				const width = container!.clientWidth;
				const height = container!.clientHeight;
				if (width <= 0 || height <= 0) return;
				camera.aspect = width / height;
				camera.updateProjectionMatrix();
				renderer.setSize(width, height, false);
				renderer.render(scene, camera);
			}
			resize();
			window.addEventListener('resize', resize, { signal });

			const resizeObserver = new ResizeObserver(() => resize());
			resizeObserver.observe(container!);

			const projectsSection = document.getElementById('projects');
			projectsSection?.addEventListener('section-toggle', () => {
				requestAnimationFrame(resize);
			}, { signal });

			/**
			 * Estimates extruded plastic volume (cm³) from triangle mesh geometry assuming
			 * 6 perimeter walls (~2.1mm effective average shell) + 20% crosshatch infill.
			 */
			function estimatePlasticVolumeCm3(
				positions: number[],
				indices: number[],
				scaleToMm: number,
				fallbackBboxCm3: number
			): number {
				if (!positions.length || !indices.length || scaleToMm <= 0) {
					return fallbackBboxCm3 * 0.25;
				}
				let signedVol = 0;
				let surfArea = 0;
				for (let i = 0; i < indices.length; i += 3) {
					const a = indices[i] * 3;
					const b = indices[i + 1] * 3;
					const c = indices[i + 2] * 3;
					const ax = positions[a], ay = positions[a + 1], az = positions[a + 2];
					const bx = positions[b], by = positions[b + 1], bz = positions[b + 2];
					const cx = positions[c], cy = positions[c + 1], cz = positions[c + 2];

					signedVol += (ax * (by * cz - bz * cy) - ay * (bx * cz - bz * cx) + az * (bx * cy - by * cx)) / 6;

					const ux = bx - ax, uy = by - ay, uz = bz - az;
					const vx = cx - ax, vy = cy - ay, vz = cz - az;
					const nx = uy * vz - uz * vy;
					const ny = uz * vx - ux * vz;
					const nz = ux * vy - uy * vx;
					surfArea += 0.5 * Math.sqrt(nx * nx + ny * ny + nz * nz);
				}

				const meshVolCm3 = (Math.abs(signedVol) * Math.pow(scaleToMm, 3)) / 1000;
				const meshAreaCm2 = (surfArea * Math.pow(scaleToMm, 2)) / 100;
				if (meshVolCm3 <= 0.01) {
					return fallbackBboxCm3 * 0.25;
				}

				// 6 walls (~2.52mm @ 0.42mm line width) & top/bottom layers (~1.2mm) -> ~2.1mm avg shell
				const avgShellCm = 0.21;
				const shellVolCm3 = meshVolCm3 * (1 - Math.exp(-(meshAreaCm2 * avgShellCm) / meshVolCm3));
				const infillVolCm3 = 0.20 * (meshVolCm3 - shellVolCm3);
				return Math.max(0.5, shellVolCm3 + infillVolCm3);
			}

			function updateBoundsFromOrientation(
				data: MeshPayload,
				geometry: ThreeTypes.BufferGeometry,
				zUp: boolean,
				w: number,
				h: number,
				d: number
			) {
				modelGroup.rotation.x = zUp ? -Math.PI / 2 : 0;
				if (!geometry.boundingBox) return;

				const minY = zUp ? geometry.boundingBox.min.z : geometry.boundingBox.min.y;
				const maxY = zUp ? geometry.boundingBox.max.z : geometry.boundingBox.max.y;
				const spanX = geometry.boundingBox.max.x - geometry.boundingBox.min.x;
				const spanY = geometry.boundingBox.max.y - geometry.boundingBox.min.y;
				const spanZ = geometry.boundingBox.max.z - geometry.boundingBox.min.z;
				const verticalSpan = zUp ? spanZ : spanY;
				const maxSpan = Math.max(spanX, spanY, spanZ, 0.001);
				const maxDimMm = Math.max(w, h, d, 1);

				activeModelMinY = minY;
				activeModelMaxY = maxY;
				grid.position.y = minY - 0.2;
				controls.target.set(0, (maxY + minY) / 2, 0);
				activeModelHeightMm = Math.max(1, (verticalSpan / maxSpan) * maxDimMm);
				activeTotalLayers = Math.max(1, Math.round(activeModelHeightMm / 0.2));
				if (slicerBoundMaxEl) slicerBoundMaxEl.textContent = `${Math.round(activeModelHeightMm)}mm`;
				if (slicerActive) updateSlicer();
			}

			function applyModelData(data: MeshPayload, geometry: ThreeTypes.BufferGeometry, meta?: ModelMeta) {
				if (currentMeshObj) {
					modelGroup.remove(currentMeshObj);
					currentMeshObj = null;
				}

				activeModelId = data.id;
				currentMeshObj = new THREE.Mesh(geometry, material);
				modelGroup.add(currentMeshObj);

				const w = data.bbox?.width || (meta ? parseInt(meta.dimensions.split('x')[0]) : 0);
				const h = data.bbox?.height || (meta ? parseInt(meta.dimensions.split('x')[1]) : 0);
				const d = data.bbox?.depth || (meta ? parseInt(meta.dimensions.split('x')[2]) : 0);
				const bboxVolumeCm3 = Math.max(1, (w * h * d) / 1000);
				const uploadedEntry = uploadedModels[data.id];
				const isZUp = uploadedEntry ? uploadedEntry.zUp : false;

				if (geometry.boundingBox) {
					const spanX = geometry.boundingBox.max.x - geometry.boundingBox.min.x;
					const spanY = geometry.boundingBox.max.y - geometry.boundingBox.min.y;
					const spanZ = geometry.boundingBox.max.z - geometry.boundingBox.min.z;
					const maxSpan = Math.max(spanX, spanY, spanZ, 0.001);
					const maxDimMm = Math.max(w, h, d, 1);

					activePlasticVolumeCm3 = estimatePlasticVolumeCm3(
						data.positions,
						data.indices,
						maxDimMm / maxSpan,
						bboxVolumeCm3
					);
					updateBoundsFromOrientation(data, geometry, isZUp, w, h, d);
				} else {
					modelGroup.rotation.x = 0;
					activePlasticVolumeCm3 = bboxVolumeCm3 * 0.25;
				}

				activeModelRadiusM = Math.max(w, d) > 0 ? Math.max(w, d) / 2 / 1000 : 0.05;
				if (specDimEl) specDimEl.textContent = `${w} x ${h} x ${d} mm`;
				if (specPolyEl) specPolyEl.textContent = `${(data.indices.length / 3).toLocaleString()} Triangles`;
				if (specVertsEl) specVertsEl.textContent = `${(data.positions.length / 3).toLocaleString()} Vertices`;
				const desc = meta?.desc || data.desc;
				if (descTextEl && desc) {
					descTextEl.textContent = desc;
					descTextEl.setAttribute('title', desc);
				}

				const activeMeta = meta || manifestMap[data.id];
				if (uploadedEntry) {
					downloadBtn?.classList.add('hidden');
					if (orientBtn) {
						orientBtn.classList.remove('hidden');
						orientBtn.textContent = isZUp ? 'Axis: Z-Up' : 'Axis: Y-Up';
						orientBtn.classList.toggle('active', isZUp);
						orientBtn.setAttribute('aria-pressed', String(isZUp));
					}
					exportJsonBtn?.classList.remove('hidden');
				} else {
					orientBtn?.classList.add('hidden');
					exportJsonBtn?.classList.add('hidden');
					if (downloadBtn && activeMeta) {
						downloadBtn.classList.remove('hidden');
						downloadBtn.href = activeMeta.stepFile;
						downloadBtn.download = activeMeta.file;
						downloadBtn.title = `Download ${activeMeta.name} (${activeMeta.file})`;
					}
				}

				controls.update();
				renderer.render(scene, camera);
				startAnimationLoop?.();
			}

			async function loadModel(id: string) {
				const seq = ++activeLoadSeq;
				if (activeLoadController) activeLoadController.abort();
				const meta = manifestMap[id];
				const loadingSpinner = document.getElementById('cad-loading-spinner');
				const loadingText = document.getElementById('cad-loading-text');
				let hadError = false;

				if (geometryCache[id]) {
					const cached = geometryCache[id];
					applyModelData(cached.data, cached.geometry, meta);
					if (loadingOverlay) loadingOverlay.classList.add('hidden');
					return;
				}

				if (loadingSpinner) loadingSpinner.style.display = '';
				if (loadingText) loadingText.textContent = 'Loading 3D CAD Mesh...';
				if (loadingOverlay) loadingOverlay.classList.remove('hidden');
				const fetchCtrl = new AbortController();
				activeLoadController = fetchCtrl;

				try {
					const jsonUrl = meta ? meta.jsonFile : `/models/${id}.json`;
					const res = await fetch(jsonUrl, { signal: fetchCtrl.signal });
					if (seq !== activeLoadSeq) return;
					if (!res.ok) throw new Error(`HTTP ${res.status}`);
					const data: MeshPayload = await res.json();
					if (seq !== activeLoadSeq) return;
					const geometry = new THREE.BufferGeometry();
					geometry.setAttribute('position', new THREE.Float32BufferAttribute(data.positions, 3));
					if (data.normals && data.normals.length) {
						// Preserve authentic CAD NURBS/STEP normals (AGENTS.md §1.K)
						geometry.setAttribute('normal', new THREE.Float32BufferAttribute(data.normals, 3));
					} else {
						geometry.computeVertexNormals();
					}
					geometry.setIndex(data.indices);
					geometry.computeBoundingBox();

					geometryCache[id] = { data, geometry };
					applyModelData(data, geometry, meta);
				} catch (err: any) {
					if (err?.name !== 'AbortError') {
						hadError = true;
						console.error('Error loading CAD model:', err);
						if (seq === activeLoadSeq && loadingOverlay) {
							if (loadingSpinner) loadingSpinner.style.display = 'none';
							if (loadingText) loadingText.textContent = 'Unable to load CAD mesh. Select another model or retry.';
							loadingOverlay.classList.remove('hidden');
						}
					}
				} finally {
					if (!hadError && seq === activeLoadSeq && loadingOverlay) {
						loadingOverlay.classList.add('hidden');
					}
				}
			}

			const inlineManifestRaw = viewerContainer?.getAttribute('data-manifest');
			let loadedInlineManifest = false;
			if (inlineManifestRaw) {
				try {
					const items: ModelMeta[] = JSON.parse(inlineManifestRaw);
					items.forEach((m) => { manifestMap[m.id] = m; });
					const initialId = selectEl ? selectEl.value : 'be92u';
					loadedInlineManifest = true;
					loadModel(initialId);
				} catch (_) {
					loadedInlineManifest = false;
				}
			}
			if (!loadedInlineManifest) {
				fetch('/models/manifest.json', { signal })
					.then((r) => r.json())
					.then((items: ModelMeta[]) => {
						items.forEach((m) => { manifestMap[m.id] = m; });
						const initialId = selectEl ? selectEl.value : 'be92u';
						loadModel(initialId);
					})
					.catch((err: any) => {
						if (err?.name !== 'AbortError') loadModel('be92u');
					});
			}

			canvas!.addEventListener(
				'keydown',
				(e: KeyboardEvent) => {
					if (e.key === 'ArrowLeft') {
						e.preventDefault();
						modelGroup.rotation.y -= 0.15;
						renderer.render(scene, camera);
					} else if (e.key === 'ArrowRight') {
						e.preventDefault();
						modelGroup.rotation.y += 0.15;
						renderer.render(scene, camera);
					} else if (e.key === 'r' || e.key === 'R') {
						e.preventDefault();
						resetCamBtn?.click();
					}
				},
				{ signal }
			);

			if (selectEl) {
				selectEl.addEventListener('change', () => {
					loadModel(selectEl.value);
				}, { signal });
			}

			async function handleCadFileUpload(file: File) {
				const seq = ++activeLoadSeq;
				const loadingSpinner = document.getElementById('cad-loading-spinner');
				const loadingText = document.getElementById('cad-loading-text');
				if (loadingSpinner) loadingSpinner.style.display = '';
				if (loadingText) loadingText.textContent = `Converting ${file.name}...`;
				if (loadingOverlay) loadingOverlay.classList.remove('hidden');

				try {
					const { convertCadFileToJson } = await import('../lib/cadConverter');
					const payload = await convertCadFileToJson(file);
					if (seq !== activeLoadSeq) return;

					const geometry = new THREE.BufferGeometry();
					geometry.setAttribute('position', new THREE.Float32BufferAttribute(payload.positions, 3));
					geometry.setAttribute('normal', new THREE.Float32BufferAttribute(payload.normals, 3));
					geometry.setIndex(payload.indices);
					geometry.computeBoundingBox();

					uploadedModels[payload.id] = { data: payload, geometry, zUp: false };
					geometryCache[payload.id] = { data: payload, geometry };

					if (selectEl) {
						let group = document.getElementById('cad-uploaded-group') as HTMLOptGroupElement | null;
						if (!group) {
							group = document.createElement('optgroup');
							group.id = 'cad-uploaded-group';
							group.label = 'Uploaded (Session)';
							selectEl.appendChild(group);
						}
						const opt = document.createElement('option');
						opt.value = payload.id;
						opt.textContent = payload.name;
						group.appendChild(opt);
						selectEl.value = payload.id;
					}

					applyModelData(payload, geometry);
					if (loadingOverlay) loadingOverlay.classList.add('hidden');
				} catch (err: any) {
					console.error('CAD upload conversion error:', err);
					if (seq === activeLoadSeq && loadingOverlay) {
						if (loadingSpinner) loadingSpinner.style.display = 'none';
						if (loadingText) loadingText.textContent = err?.message || 'Unable to convert CAD file.';
						loadingOverlay.classList.remove('hidden');
					}
				}
			}

			if (uploadBtn && uploadInput) {
				uploadBtn.addEventListener('click', () => uploadInput.click(), { signal });
				uploadInput.addEventListener('change', () => {
					const file = uploadInput.files?.[0];
					if (file) handleCadFileUpload(file);
					uploadInput.value = '';
				}, { signal });
			}

			if (orientBtn) {
				orientBtn.addEventListener('click', () => {
					const entry = uploadedModels[activeModelId];
					if (!entry) return;
					entry.zUp = !entry.zUp;
					orientBtn.textContent = entry.zUp ? 'Axis: Z-Up' : 'Axis: Y-Up';
					orientBtn.classList.toggle('active', entry.zUp);
					orientBtn.setAttribute('aria-pressed', String(entry.zUp));
					const { width, height, depth } = entry.data.bbox;
					updateBoundsFromOrientation(entry.data, entry.geometry, entry.zUp, width, height, depth);
					controls.update();
					renderer.render(scene, camera);
				}, { signal });
			}

			if (exportJsonBtn) {
				exportJsonBtn.addEventListener('click', () => {
					const entry = uploadedModels[activeModelId];
					if (!entry) return;
					const blob = new Blob([JSON.stringify(entry.data)], { type: 'application/json' });
					const url = URL.createObjectURL(blob);
					const a = document.createElement('a');
					const baseName = entry.data.file.replace(/\.[^.]+$/, '') || entry.data.id;
					a.href = url;
					a.download = `${baseName}.json`;
					a.click();
					setTimeout(() => URL.revokeObjectURL(url), 1000);
				}, { signal });
			}

			let dragDepth = 0;
			container!.addEventListener('dragenter', (e) => {
				e.preventDefault();
				dragDepth++;
				dropOverlay?.classList.remove('hidden');
			}, { signal });
			container!.addEventListener('dragover', (e) => {
				e.preventDefault();
				if (e.dataTransfer) e.dataTransfer.dropEffect = 'copy';
			}, { signal });
			container!.addEventListener('dragleave', () => {
				dragDepth = Math.max(0, dragDepth - 1);
				if (dragDepth === 0) dropOverlay?.classList.add('hidden');
			}, { signal });
			container!.addEventListener('drop', (e) => {
				e.preventDefault();
				dragDepth = 0;
				dropOverlay?.classList.add('hidden');
				const file = e.dataTransfer?.files?.[0];
				if (file) handleCadFileUpload(file);
			}, { signal });

			if (gridBtn) {
				gridBtn.addEventListener('click', () => {
					grid.visible = !grid.visible;
					gridBtn.textContent = `Grid: ${grid.visible ? 'ON' : 'OFF'}`;
					gridBtn.classList.toggle('active', grid.visible);
					gridBtn.setAttribute('aria-pressed', String(grid.visible));
					renderer.render(scene, camera);
				}, { signal });
			}

			toggleGridExternal = () => {
				gridBtn?.click();
			};

			if (wireframeBtn) {
				wireframeBtn.addEventListener('click', () => {
					material.wireframe = !material.wireframe;
					wireframeBtn.textContent = `Wireframe: ${material.wireframe ? 'ON' : 'OFF'}`;
					wireframeBtn.classList.toggle('active', material.wireframe);
					wireframeBtn.setAttribute('aria-pressed', String(material.wireframe));
					renderer.render(scene, camera);
				}, { signal });
			}

			if (resetCamBtn) {
				resetCamBtn.addEventListener('click', () => {
					modelGroup.rotation.y = 0;
					camera.position.set(45, 38, 55);
					controls.target.set(0, (activeModelMaxY + activeModelMinY) / 2, 0);
					controls.update();
					renderer.render(scene, camera);
					startAnimationLoop?.();
				}, { signal });
			}

			colorDots.forEach((dot) => {
				dot.addEventListener('click', () => {
					colorDots.forEach((d) => {
						d.classList.remove('active');
						d.setAttribute('aria-pressed', 'false');
					});
					dot.classList.add('active');
					dot.setAttribute('aria-pressed', 'true');
					const hexStr = dot.getAttribute('data-color') || '#ea580c';
					material.color.set(hexStr);
					renderer.render(scene, camera);
				}, { signal });
			});

			startAnimationLoop = () => {
				if (isViewerVisible && !isPausedByEasterEgg && animationFrameId === null) {
					animationFrameId = requestAnimationFrame(animate);
				}
			};

			window.addEventListener('pause-cad-render', () => {
				isPausedByEasterEgg = true;
				if (animationFrameId !== null) {
					cancelAnimationFrame(animationFrameId);
					animationFrameId = null;
				}
			}, { signal });
			window.addEventListener('resume-cad-render', () => {
				if (isPausedByEasterEgg) {
					isPausedByEasterEgg = false;
					startAnimationLoop?.();
				}
			}, { signal });

			function animate() {
				animationFrameId = null;
				if (!isViewerVisible || isPausedByEasterEgg) return;

				const dampingMoving = controls.update();
				let physicsActive = false;

				if (centrifugeActive) {
					physicsActive = true;
					centrifugeSpeed = THREE.MathUtils.lerp(centrifugeSpeed, TARGET_CENTRIFUGE_SPEED, 0.06);
					currentRpm = THREE.MathUtils.lerp(currentRpm, TARGET_RPM, 0.06);

					const omega = (currentRpm * 2 * Math.PI) / 60;
					const currentG = (omega * omega * activeModelRadiusM) / 9.80665;
					const vibG = (currentRpm / TARGET_RPM) * (18.2 + (Math.random() - 0.5) * 3.4);
					const vib = (Math.random() - 0.5) * 0.08;
					modelGroup.position.x = vib;
					modelGroup.position.z = vib;

					if (hudRpmEl) hudRpmEl.textContent = Math.round(currentRpm).toLocaleString() + ' RPM';
					if (hudGEl) hudGEl.textContent = Math.round(currentG).toLocaleString() + 'G';
					if (hudVibEl) hudVibEl.textContent = (currentRpm > 100 ? vibG.toFixed(1) : '0.0') + 'G';
				} else if (centrifugeSpeed > 0.0005 || currentRpm > 1 || Math.abs(modelGroup.position.x) > 0.001) {
					physicsActive = true;
					centrifugeSpeed = THREE.MathUtils.lerp(centrifugeSpeed, 0, 0.06);
					currentRpm = THREE.MathUtils.lerp(currentRpm, 0, 0.09);
					modelGroup.position.x = THREE.MathUtils.lerp(modelGroup.position.x, 0, 0.1);
					modelGroup.position.z = THREE.MathUtils.lerp(modelGroup.position.z, 0, 0.1);
					if (centrifugeSpeed <= 0.0005) {
						centrifugeSpeed = 0;
						currentRpm = 0;
						modelGroup.position.set(0, 0, 0);
					}
					if (hudRpmEl) hudRpmEl.textContent = Math.round(currentRpm).toLocaleString() + ' RPM';
					if (hudGEl) {
						const omega = (currentRpm * 2 * Math.PI) / 60;
						const currentG = (omega * omega * activeModelRadiusM) / 9.80665;
						hudGEl.textContent = Math.round(currentG).toLocaleString() + 'G';
					}
					if (hudVibEl) {
						const vibG = (currentRpm / TARGET_RPM) * 18.2;
						hudVibEl.textContent = (currentRpm > 100 ? vibG.toFixed(1) : '0.0') + 'G';
					}
				}

				if (centrifugeSpeed > 0.0005) {
					modelGroup.rotation.y += centrifugeSpeed;
				}

				renderer.render(scene, camera);

				// Only keep rAF alive when interacting, OrbitControls damping, or centrifuge spin is active (0% idle GPU)
				if (isUserInteracting || dampingMoving || physicsActive) {
					animationFrameId = requestAnimationFrame(animate);
				}
			}

			if (pendingAction) {
				const fn = pendingAction;
				pendingAction = null;
				fn();
			}

			sceneCleanup = () => {
				ac.abort();
				if (activeLoadController) activeLoadController.abort();
				if (clickTimer) clearTimeout(clickTimer);
				resizeObserver.disconnect();
				cadThemeObserver.disconnect();
				if (animationFrameId !== null) {
					cancelAnimationFrame(animationFrameId);
					animationFrameId = null;
				}
				Object.values(geometryCache).forEach((entry) => entry.geometry.dispose());
				material.dispose();
				renderer.dispose();
				controls.dispose();
			};
		}

		const viewerObserver = new IntersectionObserver(
			(entries) => {
				const entry = entries[0];
				isViewerVisible = entry.isIntersecting;
				if (isViewerVisible) {
					if (!isViewerInitialized) {
						startCadScene();
					} else {
						startAnimationLoop?.();
					}
				} else if (animationFrameId !== null) {
					cancelAnimationFrame(animationFrameId);
