---
---

<div class="cad-viewer-container" id="cad-viewer">
	<div class="cad-viewer-header">
		<div class="cad-viewer-title-row">
			<div class="cad-viewer-title">
				<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
					<polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
					<line x1="12" y1="22.08" x2="12" y2="12"/>
				</svg>
				<span>Model Selection</span>
				<svg class="title-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<line x1="4" y1="12" x2="20" y2="12"></line>
					<polyline points="14 6 20 12 14 18"></polyline>
				</svg>
			</div>

			<!-- MODEL SELECTOR DROPDOWN -->
			<div class="model-select-wrapper">
				<select id="cad-model-select" class="model-select" aria-label="Select 3D CAD Model">
					<optgroup label="Networking & Hardware Mounts">
						<option value="be92u" selected>ASUS RT-BE92U Router Mount</option>
						<option value="network-switch-stand">Network Switch Vertical Stand</option>
					</optgroup>
					<optgroup label="Workstation & Peripherals">
						<option value="laptop-vertical-stand">Vertical Laptop Workstation Stand</option>
						<option value="dual-keyboard-mount">Dual Keyboard Under-Desk Bracket</option>
						<option value="ikea-tertial">IKEA Tertial Desk Lamp Heavy Mount</option>
					</optgroup>
					<optgroup label="Audio & Smart Devices">
						<option value="r70x-headband">Audio-Technica ATH-R70x Headband Joiner</option>
						<option value="lenovo-clock-stand">Lenovo Smart Clock Essential Riser</option>
						<option value="remote-mount">Smart Remote Wall Mount</option>
					</optgroup>
					<optgroup label="Automotive & Mechanical">
						<option value="brz-armrest">Subaru BRZ / GR86 Armrest Blocker</option>
						<option value="skil-battery">Skil 12V Battery Magnetic Holder</option>
						<option value="gilmour-handle">Gilmour Garden Nozzle Handle</option>
					</optgroup>
				</select>
			</div>
		</div>

		<div class="cad-controls-top">
			<button id="cad-reset-cam-btn" class="cad-mini-btn" type="button" title="Reset Viewpoint">Reset View</button>
			<button id="cad-wireframe-btn" class="cad-mini-btn" type="button">Wireframe: OFF</button>
			<button id="cad-centrifuge-btn" class="cad-mini-btn" type="button" title="Centrifuge Stress Test (10,000 RPM)">Centrifuge: OFF</button>
		</div>
	</div>

	<!-- MODEL QUICK DESCRIPTION -->
	<div class="cad-model-meta-strip">
		<span id="model-desc-text" class="model-desc-text">
			Custom wall mounting bracket for ASUS RT-BE92U Wi-Fi 7 router with integrated thermal ventilation clearance and cable channels.
		</span>
	</div>

	<!-- PRINT-ONLY SUMMARY OF 3D MODELS -->
	<div class="print-only cad-print-summary">
		<p class="print-summary-title"><strong>Selected 3D CAD &amp; Prototyping Designs (MakerWorld @brob):</strong></p>
		<ul class="print-model-list">
			<li><strong>Networking &amp; Hardware Mounts:</strong> ASUS RT-BE92U Wi-Fi 7 Router Mount, Multi-Port Network Switch Stand</li>
			<li><strong>Workstation &amp; Peripherals:</strong> Dual Vertical Laptop Stand, Dual Keyboard Under-Desk Sliding Cradle, IKEA Tertial Heavy Mount</li>
			<li><strong>Audio &amp; Smart Devices:</strong> ATH-R70x Open-Back Headband Joiner, Lenovo Smart Clock Essential Riser, Smart Remote Wall Mount</li>
			<li><strong>Automotive &amp; Workshop:</strong> Subaru BRZ / GR86 Console Gap Blocker, Skil 12V Battery Magnetic Mount, Gilmour High-Flow Nozzle Handle</li>
		</ul>
	</div>

	<!-- 3D WEBGL CANVAS -->
	<div class="canvas-wrapper" id="canvas-container">
		<canvas id="cad-canvas"></canvas>
		<div id="cad-centrifuge-hud" class="cad-centrifuge-hud hidden">
			<span class="hud-pulse-dot"></span>
			<span>CENTRIFUGE STRESS TEST: <strong id="hud-rpm-val">0 RPM</strong> &bull; VIBRATION: <span id="hud-vib-val">0.014G</span> [NOMINAL]</span>
		</div>
		<div id="cad-loading-overlay" class="cad-loading hidden">
			<div class="spinner"></div>
			<span>Tessellating 3D B-Rep Mesh...</span>
		</div>
		<div class="cad-drag-hint">
			<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
				<path d="m5 9-3 3 3 3M9 5l3-3 3 3M15 19l-3 3-3-3M19 9l3 3-3 3M2 12h20M12 2v20"/>
			</svg>
			<span>Orbit: Left-drag &bull; Pan: Right-drag / Two-finger &bull; Zoom: Scroll / Pinch</span>
		</div>
	</div>

	<!-- CONTROLS & SPEC BAR -->
	<div class="cad-viewer-footer">
		<div class="cad-color-picker">
			<span class="color-label">Color:</span>
			<button class="color-dot active" data-color="#ea580c" title="Signal Orange" style="background: #ea580c;"></button>
			<button class="color-dot" data-color="#facc15" title="Sunflower Yellow" style="background: #facc15;"></button>
			<button class="color-dot" data-color="#10b981" title="Cyber Green" style="background: #10b981;"></button>
			<button class="color-dot" data-color="#2563eb" title="Tech Blue" style="background: #2563eb;"></button>
			<button class="color-dot" data-color="#9333ea" title="Royal Purple" style="background: #9333ea;"></button>
			<button class="color-dot" data-color="#f472b6" title="Sakura Pink" style="background: #f472b6;"></button>
			<button class="color-dot light-dot" data-color="#f8fafc" title="Clean White" style="background: #f8fafc;"></button>
			<button class="color-dot" data-color="#64748b" title="Cool Gray" style="background: #64748b;"></button>
			<button class="color-dot" data-color="#1e293b" title="Matte Black PETG" style="background: #1e293b;"></button>
		</div>
		<div class="cad-specs" id="cad-specs">
			<span class="spec-tag" id="spec-dim">241 x 28 x 76 mm</span>
			<span class="spec-tag" id="spec-poly">12,602 Triangles</span>
			<span class="spec-tag" id="spec-verts">9,224 Vertices</span>
		</div>
	</div>
</div>

<script>
	import * as THREE from 'three';
	import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';

	interface ModelMeta {
		id: string;
		name: string;
		file: string;
		category: string;
		desc: string;
		dimensions: string;
		jsonFile: string;
		stepFile: string;
		triangles: number;
		vertices: number;
	}

	interface MeshPayload {
		id: string;
		name: string;
		file: string;
		category: string;
		desc: string;
		bbox: { width: number; height: number; depth: number };
		triangles: number;
		vertices: number;
		positions: number[];
		normals: number[];
		indices: number[];
	}

	function initCadViewer() {
		const canvas = document.getElementById('cad-canvas') as HTMLCanvasElement | null;
		const container = document.getElementById('canvas-container');
		if (!canvas || !container) return;

		// Clean up previous instance if any
		if ((canvas as any).__cleanup) {
			(canvas as any).__cleanup();
		}

		let animationFrameId: number;
		const renderer = new THREE.WebGLRenderer({
			canvas,
			antialias: true,
			alpha: true,
			powerPreference: 'high-performance'
		});
		renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
		renderer.toneMapping = THREE.ACESFilmicToneMapping;
		renderer.toneMappingExposure = 1.15;

		const scene = new THREE.Scene();
		const camera = new THREE.PerspectiveCamera(40, container.clientWidth / container.clientHeight, 0.1, 1000);
		camera.position.set(45, 38, 55);

		const controls = new OrbitControls(camera, canvas);
		controls.enableDamping = true;
		controls.dampingFactor = 0.06;
		controls.minDistance = 15;
		controls.maxDistance = 220;
		controls.maxPolarAngle = Math.PI - 0.02; // Full orbital freedom to inspect underside

		// Lighting
		const ambientLight = new THREE.AmbientLight(0xffffff, 1.2);
		scene.add(ambientLight);

		const keyLight = new THREE.DirectionalLight(0xffffff, 2.2);
		keyLight.position.set(60, 80, 50);
		scene.add(keyLight);

		const fillLight = new THREE.DirectionalLight(0x93c5fd, 1.2);
		fillLight.position.set(-60, 40, -50);
		scene.add(fillLight);

		const rimLight = new THREE.DirectionalLight(0xffedd5, 1.2);
		rimLight.position.set(0, -50, 40);
		scene.add(rimLight);

		const underLight = new THREE.DirectionalLight(0xffffff, 1.1);
		underLight.position.set(0, -70, -30);
		scene.add(underLight);

		// Build Plate Grid
		const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
		const gridPrimary = isDark ? 0x334155 : 0xcbd5e1;
		const gridSecondary = isDark ? 0x1e293b : 0xe2e8f0;
		const grid = new THREE.GridHelper(80, 20, gridPrimary, gridSecondary);
		grid.position.y = -18;
		scene.add(grid);

		// Model Group
		const modelGroup = new THREE.Group();
		scene.add(modelGroup);

		// Material (Default to vibrant Orange for high contrast)
		let baseHex = 0xea580c;
		const material = new THREE.MeshStandardMaterial({
			color: baseHex,
			roughness: 0.38,
			metalness: 0.08,
			flatShading: false,
			wireframe: false
		});

		let currentMeshObj: THREE.Mesh | null = null;
		const meshCache: Record<string, MeshPayload> = {};
		let manifestMap: Record<string, ModelMeta> = {};

		// UI Elements
		const selectEl = document.getElementById('cad-model-select') as HTMLSelectElement | null;
		const descTextEl = document.getElementById('model-desc-text');
		const specDimEl = document.getElementById('spec-dim');
		const specPolyEl = document.getElementById('spec-poly');
		const specVertsEl = document.getElementById('spec-verts');
		const loadingOverlay = document.getElementById('cad-loading-overlay');
		const wireframeBtn = document.getElementById('cad-wireframe-btn');
		const resetCamBtn = document.getElementById('cad-reset-cam-btn');
		const centrifugeBtn = document.getElementById('cad-centrifuge-btn');
		const centrifugeHud = document.getElementById('cad-centrifuge-hud');
		const colorDots = document.querySelectorAll('.color-dot');

		let centrifugeActive = false;
		let centrifugeSpeed = 0;
		let currentRpm = 0;
		const TARGET_CENTRIFUGE_SPEED = 1.35; // Rapid forward optical rotation
		const TARGET_RPM = 10000;
		const hudRpmEl = document.getElementById('hud-rpm-val');
		const hudVibEl = document.getElementById('hud-vib-val');

		function setCentrifuge(active: boolean) {
			centrifugeActive = active;
			if (centrifugeBtn) {
				centrifugeBtn.textContent = active ? 'Centrifuge: ON' : 'Centrifuge: OFF';
				centrifugeBtn.classList.toggle('active-centrifuge', active);
			}
			if (centrifugeHud) {
				centrifugeHud.classList.toggle('hidden', !active);
			}
		}

		function toggleCentrifuge() {
			setCentrifuge(!centrifugeActive);
		}

		if (centrifugeBtn) {
			centrifugeBtn.addEventListener('click', toggleCentrifuge);
		}

		// Triple-click canvas trigger
		let clickCount = 0;
		let clickTimer: any = null;
		canvas.addEventListener('click', () => {
			clickCount++;
			clearTimeout(clickTimer);
			clickTimer = setTimeout(() => {
				if (clickCount >= 3) toggleCentrifuge();
				clickCount = 0;
			}, 350);
		});

		// Spacebar shortcut when hovering viewer
		let isViewerHovered = false;
		container.addEventListener('mouseenter', () => { isViewerHovered = true; });
		container.addEventListener('mouseleave', () => { isViewerHovered = false; });
		window.addEventListener('keydown', (e) => {
			if (e.code === 'Space' && isViewerHovered) {
				const activeEl = document.activeElement;
				if (activeEl && (activeEl.tagName === 'INPUT' || activeEl.tagName === 'TEXTAREA' || activeEl.tagName === 'SELECT')) {
					return;
				}
				e.preventDefault();
				toggleCentrifuge();
			}
		});

		// Global hook for CLI terminal command
		(window as any).__triggerCadCentrifuge = (active?: boolean) => {
			if (typeof active === 'boolean') {
				setCentrifuge(active);
			} else {
				toggleCentrifuge();
			}
		};

		function resize() {
			const width = container!.clientWidth;
			const height = container!.clientHeight;
			camera.aspect = width / height;
			camera.updateProjectionMatrix();
			renderer.setSize(width, height, false);
		}
		resize();
		window.addEventListener('resize', resize);

		function applyModelData(data: MeshPayload, meta?: ModelMeta) {
			if (currentMeshObj) {
				modelGroup.remove(currentMeshObj);
				currentMeshObj.geometry.dispose();
				currentMeshObj = null;
			}

			const geometry = new THREE.BufferGeometry();
			geometry.setAttribute('position', new THREE.Float32BufferAttribute(data.positions, 3));
			if (data.normals && data.normals.length) {
				geometry.setAttribute('normal', new THREE.Float32BufferAttribute(data.normals, 3));
			} else {
				geometry.computeVertexNormals();
			}
			geometry.setIndex(data.indices);
			geometry.computeBoundingBox();

			currentMeshObj = new THREE.Mesh(geometry, material);
			modelGroup.add(currentMeshObj);

			// Center vertically on build plate
			if (geometry.boundingBox) {
				const minY = geometry.boundingBox.min.y;
				grid.position.y = minY - 0.2;
				controls.target.set(0, (geometry.boundingBox.max.y + geometry.boundingBox.min.y) / 2, 0);
			}

			// Update spec labels
			const w = data.bbox?.width || (meta ? parseInt(meta.dimensions.split('x')[0]) : 0);
			const h = data.bbox?.height || (meta ? parseInt(meta.dimensions.split('x')[1]) : 0);
			const d = data.bbox?.depth || (meta ? parseInt(meta.dimensions.split('x')[2]) : 0);
			if (specDimEl) specDimEl.textContent = `${w} x ${h} x ${d} mm`;
			if (specPolyEl) specPolyEl.textContent = `${(data.indices.length / 3).toLocaleString()} Triangles`;
			if (specVertsEl) specVertsEl.textContent = `${(data.positions.length / 3).toLocaleString()} Vertices`;
			if (descTextEl && meta) descTextEl.textContent = meta.desc;
		}

		async function loadModel(id: string) {
			const meta = manifestMap[id];
			if (loadingOverlay) loadingOverlay.classList.remove('hidden');

			if (meshCache[id]) {
				applyModelData(meshCache[id], meta);
				if (loadingOverlay) loadingOverlay.classList.add('hidden');
				return;
			}

			try {
				const jsonUrl = meta ? meta.jsonFile : `/models/${id}.json`;
				const res = await fetch(jsonUrl);
				if (res.ok) {
					const data: MeshPayload = await res.json();
					meshCache[id] = data;
					applyModelData(data, meta);
				}
			} catch (err) {
				console.error('Error loading CAD model:', err);
			} finally {
				if (loadingOverlay) loadingOverlay.classList.add('hidden');
			}
		}

		// Fetch manifest
		fetch('/models/manifest.json')
			.then(r => r.json())
			.then((items: ModelMeta[]) => {
				items.forEach(m => { manifestMap[m.id] = m; });
				const initialId = selectEl ? selectEl.value : 'be92u';
				loadModel(initialId);
			})
			.catch(() => {
				loadModel('be92u');
			});

		if (selectEl) {
			selectEl.addEventListener('change', () => {
				loadModel(selectEl.value);
			});
		}

		if (wireframeBtn) {
			wireframeBtn.addEventListener('click', () => {
				material.wireframe = !material.wireframe;
				wireframeBtn.textContent = `Wireframe: ${material.wireframe ? 'ON' : 'OFF'}`;
				wireframeBtn.classList.toggle('active', material.wireframe);
			});
		}

		if (resetCamBtn) {
			resetCamBtn.addEventListener('click', () => {
				camera.position.set(45, 38, 55);
				controls.target.set(0, 0, 0);
				controls.update();
			});
		}

		colorDots.forEach((dot) => {
			dot.addEventListener('click', () => {
				colorDots.forEach((d) => d.classList.remove('active'));
				dot.classList.add('active');
				const hexStr = dot.getAttribute('data-color') || '#ea580c';
				material.color.set(hexStr);
			});
		});

		// Render animation loop
		function animate() {
			animationFrameId = requestAnimationFrame(animate);
			controls.update();

			if (centrifugeActive) {
				centrifugeSpeed = THREE.MathUtils.lerp(centrifugeSpeed, TARGET_CENTRIFUGE_SPEED, 0.06);
				currentRpm = THREE.MathUtils.lerp(currentRpm, TARGET_RPM, 0.06);
				const vib = (Math.random() - 0.5) * 0.08;
				modelGroup.position.x = vib;
				modelGroup.position.z = vib;
				if (hudRpmEl) hudRpmEl.textContent = Math.round(currentRpm).toLocaleString() + ' RPM';
				if (hudVibEl) hudVibEl.textContent = (0.012 + Math.abs(vib) * 0.05).toFixed(3) + 'G';
			} else {
				centrifugeSpeed = THREE.MathUtils.lerp(centrifugeSpeed, 0, 0.06);
				currentRpm = THREE.MathUtils.lerp(currentRpm, 0, 0.09);
				modelGroup.position.x = THREE.MathUtils.lerp(modelGroup.position.x, 0, 0.1);
				modelGroup.position.z = THREE.MathUtils.lerp(modelGroup.position.z, 0, 0.1);
				if (hudRpmEl) hudRpmEl.textContent = Math.round(currentRpm).toLocaleString() + ' RPM';
			}
			if (centrifugeSpeed > 0.0005) {
				modelGroup.rotation.y += centrifugeSpeed;
			}

			renderer.render(scene, camera);
		}
		animate();

		// Cleanup handle for HMR / page changes
		(canvas as any).__cleanup = () => {
			cancelAnimationFrame(animationFrameId);
			window.removeEventListener('resize', resize);
			renderer.dispose();
			controls.dispose();
		};
	}

	initCadViewer();
	document.addEventListener('astro:page-load', initCadViewer);
</script>

<style>
	.cad-viewer-container {
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 12px;
		margin-top: 1.2em;
		overflow: hidden;
		box-shadow: var(--box-shadow);
		transition: background-color 0.2s ease, border-color 0.2s ease;
	}

	.cad-viewer-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.85em 1.25em;
		border-bottom: 1px solid var(--border-color);
		background: rgba(var(--gray-light), 0.5);
		flex-wrap: wrap;
		gap: 0.8em;
	}

	.cad-viewer-title-row {
		display: flex;
		align-items: center;
		gap: 0.9em;
		flex-wrap: wrap;
	}
	.cad-viewer-title {
		display: flex;
		align-items: center;
		gap: 0.45em;
		font-size: 0.95em;
		font-weight: 700;
		color: rgb(var(--black));
	}
	.cad-viewer-title svg {
		color: var(--accent);
	}
	.title-arrow {
		color: var(--accent);
		margin-left: 0.1em;
		flex-shrink: 0;
		animation: nudgeArrow 2s infinite ease-in-out;
	}
	@keyframes nudgeArrow {
		0%, 100% { transform: translateX(0); }
		50% { transform: translateX(3px); }
	}

	/* MODEL SELECTOR DROPDOWN */
	.model-select-wrapper {
		display: inline-block;
	}
	.model-select {
		font-size: 0.85em;
		font-weight: 600;
		padding: 0.4em 0.85em;
		border-radius: 6px;
		border: 1px solid var(--border-color);
		background: var(--bg-card);
		color: rgb(var(--black));
		cursor: pointer;
		outline: none;
		transition: border-color 0.15s ease;
	}
	.model-select:hover, .model-select:focus {
		border-color: var(--accent);
	}

	.cad-controls-top {
		display: flex;
		align-items: center;
		gap: 0.6em;
	}
	.cad-mini-btn {
		font-size: 0.78em;
		font-weight: 600;
		padding: 0.3em 0.7em;
		border-radius: 5px;
		background: transparent;
		border: 1px solid var(--border-color);
		color: rgb(var(--gray-dark));
		cursor: pointer;
		transition: all 0.15s ease;
	}
	.cad-mini-btn:hover, .cad-mini-btn.active {
		background: var(--accent);
		color: #ffffff;
		border-color: var(--accent);
	}
	.cad-mini-btn.active-centrifuge {
		background: rgba(234, 88, 12, 0.16);
		border-color: #ea580c;
		color: #ea580c;
		font-weight: 700;
		box-shadow: 0 0 10px rgba(234, 88, 12, 0.25);
	}

	.cad-centrifuge-hud {
		position: absolute;
		top: 14px;
		left: 50%;
		transform: translateX(-50%);
		background: rgba(15, 23, 42, 0.88);
		backdrop-filter: blur(8px);
		border: 1px solid #ea580c;
		box-shadow: 0 0 16px rgba(234, 88, 12, 0.35);
		color: #f8fafc;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.76em;
		letter-spacing: 0.04em;
		padding: 0.4em 0.95em;
		border-radius: 20px;
		display: flex;
		align-items: center;
		gap: 0.55em;
		pointer-events: none;
		z-index: 10;
		transition: all 0.25s ease;
	}
	.cad-centrifuge-hud.hidden {
		display: none;
	}
	.hud-pulse-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #ea580c;
		box-shadow: 0 0 8px #ea580c;
		animation: pulseDot 0.8s infinite alternate ease-in-out;
	}
	@keyframes pulseDot {
		from { opacity: 0.35; transform: scale(0.85); }
		to { opacity: 1; transform: scale(1.15); }
	}

	/* MODEL DESCRIPTION STRIP */
	.cad-model-meta-strip {
		padding: 0.6em 1.25em;
		background: rgba(var(--gray-light), 0.25);
		border-bottom: 1px solid var(--border-color);
		font-size: 0.84em;
		line-height: 1.45;
		color: rgb(var(--gray-dark));
	}

	.canvas-wrapper {
		position: relative;
		width: 100%;
		height: 480px;
