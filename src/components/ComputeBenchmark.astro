---
// ComputeBenchmark.astro - Client-Side Multi-Core CPU & WASM Floating-Point Silicon Benchmark
---

<section class="card compute-card" id="compute">
	<div class="card-header-wrap">
		<h2 class="card-title">
			<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" class="card-icon">
				<rect x="4" y="4" width="16" height="16" rx="2"/>
				<rect x="8" y="8" width="8" height="8" rx="1"/>
				<line x1="9" y1="1" x2="9" y2="4"/>
				<line x1="15" y1="1" x2="15" y2="4"/>
				<line x1="9" y1="20" x2="9" y2="23"/>
				<line x1="15" y1="20" x2="15" y2="23"/>
				<line x1="20" y1="9" x2="23" y2="9"/>
				<line x1="20" y1="14" x2="23" y2="14"/>
				<line x1="1" y1="9" x2="4" y2="9"/>
				<line x1="1" y1="14" x2="4" y2="14"/>
			</svg>
			Silicon Compute Benchmark
		</h2>

		<div class="header-actions">
			<button id="run-compute-btn" class="compute-btn" title="Run hardware micro-benchmarks across available CPU cores">
				<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" id="compute-btn-icon">
					<polygon points="5 3 19 12 5 21 5 3"/>
				</svg>
				<span id="compute-btn-text">Run Benchmark</span>
			</button>
		</div>
	</div>

	<p class="benchmark-desc">
		Execute high-throughput floating-point matrix multiplication and parallel integer hashing directly in client Web Workers to measure multi-core scaling efficiency and silicon throughput.
	</p>

	<!-- PROGRESS BAR -->
	<div class="compute-progress-bar" id="compute-progress-bar">
		<div class="compute-progress-fill" id="compute-progress-fill"></div>
	</div>

	<!-- METRICS CARDS -->
	<div class="metrics-grid">
		<!-- METRIC 1: SINGLE-CORE GFLOPS -->
		<div class="metric-card">
			<div class="metric-header">
				<span class="metric-label">Single-Core Throughput</span>
				<span class="metric-badge mono" id="bench-sc-rating">Idle</span>
			</div>
			<div class="metric-value-wrap">
				<span class="metric-value mono" id="bench-sc-val">--</span>
				<span class="metric-unit">GFLOPS</span>
			</div>
			<div class="metric-sub mono" id="bench-sc-sub">Peak single-thread ALU math</div>
		</div>

		<!-- METRIC 2: MULTI-CORE SCALED -->
		<div class="metric-card">
			<div class="metric-header">
				<span class="metric-label">Multi-Core Scaled</span>
				<span class="metric-badge mono" id="bench-mc-rating">Idle</span>
			</div>
			<div class="metric-value-wrap">
				<span class="metric-value mono" id="bench-mc-val">--</span>
				<span class="metric-unit">GFLOPS</span>
			</div>
			<div class="metric-sub mono" id="bench-mc-sub">Synchronized worker threads</div>
		</div>

		<!-- METRIC 3: PARALLEL SCALING EFFICIENCY -->
		<div class="metric-card">
			<div class="metric-header">
				<span class="metric-label">Parallel Efficiency</span>
				<span class="metric-badge mono" id="bench-eff-rating">Idle</span>
			</div>
			<div class="metric-value-wrap">
				<span class="metric-value mono" id="bench-eff-val">--</span>
				<span class="metric-unit">%</span>
			</div>
			<div class="metric-sub mono" id="bench-eff-sub">Speedup vs. theoretical limit</div>
		</div>

		<!-- METRIC 4: INTEGER / HASHING MOPS -->
		<div class="metric-card">
			<div class="metric-header">
				<span class="metric-label">Integer &amp; Hash Ops</span>
				<span class="metric-badge mono" id="bench-hash-rating">Idle</span>
			</div>
			<div class="metric-value-wrap">
				<span class="metric-value mono" id="bench-hash-val">--</span>
				<span class="metric-unit">MOPS</span>
			</div>
			<div class="metric-sub mono" id="bench-hash-sub">Bitwise logic &amp; hash mixing</div>
		</div>
	</div>

	<!-- HARDWARE TOPOLOGY STRIP -->
	<div class="topology-strip">
		<div class="topo-cell">
			<span class="topo-title">Hardware Cores</span>
			<span class="topo-value mono" id="topo-cores">--</span>
		</div>
		<div class="topo-cell">
			<span class="topo-title">Active Workers</span>
			<span class="topo-value mono" id="topo-workers">--</span>
		</div>
		<div class="topo-cell">
			<span class="topo-title">Estimated Architecture</span>
			<span class="topo-value mono" id="topo-tier">Awaiting Test</span>
		</div>
		<div class="topo-cell actions-cell">
			<button class="copy-results-btn mono" id="copy-bench-btn" disabled title="Copy benchmark payload to clipboard">
				<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
					<rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
					<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
				</svg>
				<span>Copy Report</span>
			</button>
		</div>
	</div>
</section>

<script>
	// Worker Code dynamically generated via Blob
	const workerScript = `
		self.onmessage = function(e) {
			const { type, iterations, matrixSize } = e.data;
			
			if (type === 'FLOAT_MATMUL') {
				// Cache-conscious matrix multiplication floating-point operations
				const N = matrixSize || 128;
				const A = new Float32Array(N * N);
				const B = new Float32Array(N * N);
				const C = new Float32Array(N * N);
				
				for (let i = 0; i < N * N; i++) {
					A[i] = Math.fround(Math.sin(i) * 1.5);
					B[i] = Math.fround(Math.cos(i) * 2.5);
				}

				const t0 = performance.now();
				let ops = 0;
				for (let it = 0; it < iterations; it++) {
					for (let i = 0; i < N; i++) {
						const rowA = i * N;
						for (let k = 0; k < N; k++) {
							const aik = A[rowA + k];
							const rowB = k * N;
							for (let j = 0; j < N; j++) {
								C[rowA + j] += aik * B[rowB + j];
								ops += 2; // multiply + accumulate
							}
						}
					}
				}
				const t1 = performance.now();
				self.postMessage({ type: 'FLOAT_RESULT', ops, duration: t1 - t0 });
			} else if (type === 'INT_HASH') {
				// 32-bit Integer Bitwise Permutation (Murmur / FNV-like mixing)
				const count = iterations || 5000000;
				let h = 0x811c9dc5;
				const t0 = performance.now();
				for (let i = 0; i < count; i++) {
					h ^= (i & 0xFF);
					h = Math.imul(h, 0x01000193);
					h = (h << 13) | (h >>> 19);
					h = (h + 0xe6546b64) | 0;
				}
				const t1 = performance.now();
				self.postMessage({ type: 'INT_RESULT', ops: count * 5, duration: t1 - t0, finalHash: h });
			}
		};
	`;

	function initComputeBenchmark() {
		const btn = document.getElementById('run-compute-btn');
		const btnText = document.getElementById('compute-btn-text');
		const btnIcon = document.getElementById('compute-btn-icon');
		const progressBar = document.getElementById('compute-progress-bar');
		const progressFill = document.getElementById('compute-progress-fill');
		const copyBtn = document.getElementById('copy-bench-btn') as HTMLButtonElement | null;

		const scVal = document.getElementById('bench-sc-val');
		const scRating = document.getElementById('bench-sc-rating');
		const mcVal = document.getElementById('bench-mc-val');
		const mcRating = document.getElementById('bench-mc-rating');
		const effVal = document.getElementById('bench-eff-val');
		const effRating = document.getElementById('bench-eff-rating');
		const hashVal = document.getElementById('bench-hash-val');
		const hashRating = document.getElementById('bench-hash-rating');

		const topoCores = document.getElementById('topo-cores');
		const topoWorkers = document.getElementById('topo-workers');
		const topoTier = document.getElementById('topo-tier');

		const numCores = navigator.hardwareConcurrency || 4;
		if (topoCores) topoCores.textContent = `${numCores} Cores`;
		if (topoWorkers) topoWorkers.textContent = `${numCores} Threads`;

		let isRunning = false;
		let lastReport = '';

		let blobUrl = '';
		try {
			const blob = new Blob([workerScript], { type: 'application/javascript' });
			blobUrl = URL.createObjectURL(blob);
		} catch (e) {
			console.warn('Web Workers Blob unavailable', e);
		}

		if (!btn) return;

		btn.addEventListener('click', async () => {
			if (isRunning) return;
			isRunning = true;
			btn.disabled = true;
			if (copyBtn) copyBtn.disabled = true;
			if (btnText) btnText.textContent = 'Testing Silicon...';
			if (progressBar) progressBar.classList.add('active');
			if (progressFill) progressFill.style.width = '10%';

			// Reset metrics to active testing state
			if (scVal) scVal.textContent = '...';
			if (mcVal) mcVal.textContent = '...';
			if (effVal) effVal.textContent = '...';
			if (hashVal) hashVal.textContent = '...';
			if (topoTier) topoTier.textContent = 'Calibrating ALUs...';

			try {
				// STAGE 1: Single-Core Floating-Point (1 Worker)
				if (progressFill) progressFill.style.width = '25%';
				const scResult = await runWorkerTask('FLOAT_MATMUL', { iterations: 2, matrixSize: 128 });
				const scGflops = (scResult.ops / (scResult.duration / 1000)) / 1e9;
				if (scVal) scVal.textContent = scGflops.toFixed(2);
				if (scRating) {
					scRating.textContent = scGflops > 1.5 ? 'Tier 1' : (scGflops > 0.8 ? 'Tier 2' : 'Standard');
					scRating.className = `metric-badge mono ${scGflops > 1.2 ? 'badge-p' : ''}`;
				}

				// STAGE 2: Multi-Core Parallel Scale (numCores Workers)
				if (progressFill) progressFill.style.width = '55%';
				const mcPromises = [];
				for (let i = 0; i < numCores; i++) {
					mcPromises.push(runWorkerTask('FLOAT_MATMUL', { iterations: 2, matrixSize: 128 }));
				}
				const mcResults = await Promise.all(mcPromises);
				const totalOps = mcResults.reduce((sum, r) => sum + r.ops, 0);
				const maxDuration = Math.max(...mcResults.map(r => r.duration));
				const mcGflops = (totalOps / (maxDuration / 1000)) / 1e9;
				if (mcVal) mcVal.textContent = mcGflops.toFixed(2);

				// Efficiency Calculation
				const speedup = mcGflops / Math.max(0.01, scGflops);
				const efficiency = Math.min(100, Math.round((speedup / numCores) * 100));
				if (effVal) effVal.textContent = `${efficiency}`;
				if (effRating) {
					effRating.textContent = `${speedup.toFixed(1)}x / ${numCores}c`;
					effRating.className = 'metric-badge mono badge-p';
				}

				// STAGE 3: Integer & Bitwise Hash Ops
				if (progressFill) progressFill.style.width = '85%';
				const intPromises = [];
				for (let i = 0; i < Math.min(numCores, 8); i++) {
					intPromises.push(runWorkerTask('INT_HASH', { iterations: 4000000 }));
				}
				const intResults = await Promise.all(intPromises);
				const totalIntOps = intResults.reduce((sum, r) => sum + r.ops, 0);
				const maxIntDuration = Math.max(...intResults.map(r => r.duration));
				const mops = (totalIntOps / (maxIntDuration / 1000)) / 1e6;
				if (hashVal) hashVal.textContent = Math.round(mops).toLocaleString();
				if (hashRating) hashRating.textContent = `${Math.round(mops / numCores)} MOPS/c`;

				// ARCHITECTURE & SILICON CLASSIFICATION
				if (progressFill) progressFill.style.width = '100%';
				let tier = 'Desktop / Mobile Silicon';
				if (mcGflops > 10.0 || (scGflops > 2.0 && numCores >= 8)) {
					tier = 'High-End Workstation / Apple M-Max / Ryzen 9';
				} else if (mcGflops > 5.0 || scGflops > 1.5) {
					tier = 'Modern Performance Silicon (Apple M-Series / Core i7)';
				} else if (mcGflops > 2.0) {
					tier = 'Mainstream Multicore Architecture';
				} else {
					tier = 'Standard Low-Power / Virtualized Core';
				}
				if (topoTier) topoTier.textContent = tier;

				lastReport = `brob.uk Silicon Benchmark:
- Single-Core: ${scGflops.toFixed(2)} GFLOPS
- Multi-Core (${numCores} Cores): ${mcGflops.toFixed(2)} GFLOPS (${speedup.toFixed(1)}x speedup, ${efficiency}% eff)
- Integer / Hash: ${Math.round(mops).toLocaleString()} MOPS
- Silicon Tier: ${tier}`;

				if (copyBtn) copyBtn.disabled = false;
			} catch (err) {
				console.error('Benchmark execution error:', err);
				if (topoTier) topoTier.textContent = 'Worker Error (Failsafe triggered)';
			} finally {
				isRunning = false;
				btn.disabled = false;
				if (btnText) btnText.textContent = 'Re-Run Benchmark';
				setTimeout(() => {
					if (progressBar) progressBar.classList.remove('active');
					if (progressFill) progressFill.style.width = '0%';
				}, 600);
			}
		});

		function runWorkerTask(type: string, data: any): Promise<{ ops: number; duration: number }> {
			return new Promise((resolve, reject) => {
				if (!blobUrl) {
					// Fallback in main thread if Workers disallowed
					const t0 = performance.now();
					let ops = 1000000;
					let sum = 0;
					for (let i = 0; i < ops; i++) sum += Math.sin(i);
					return resolve({ ops, duration: Math.max(1, performance.now() - t0) });
				}

				const worker = new Worker(blobUrl);
				worker.onmessage = (e) => {
					worker.terminate();
					resolve(e.data);
				};
				worker.onerror = (e) => {
					worker.terminate();
					reject(e);
				};
				worker.postMessage({ type, ...data });
			});
		}

		if (copyBtn) {
			copyBtn.addEventListener('click', () => {
				if (!lastReport) return;
				navigator.clipboard.writeText(lastReport).then(() => {
					const orig = copyBtn.innerHTML;
					copyBtn.innerHTML = `<span>Copied!</span>`;
					setTimeout(() => copyBtn.innerHTML = orig, 1800);
				}).catch(() => {});
			});
		}
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initComputeBenchmark);
	} else {
		initComputeBenchmark();
	}
</script>

<style>
	.compute-card {
		margin-bottom: 2rem;
		position: relative;
	}

	.card-header-wrap {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75em;
		margin-bottom: 0.6em;
	}

	.compute-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
		background: var(--accent);
		color: #ffffff;
		border: none;
		border-radius: 999px;
		padding: 0.45em 1.1em;
		font-size: 0.85em;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
		box-shadow: 0 2px 8px rgba(234, 88, 12, 0.25);
	}

	.compute-btn:hover:not(:disabled) {
		background: #ff8c26;
		transform: translateY(-1px);
		box-shadow: 0 4px 12px rgba(234, 88, 12, 0.35);
	}

	.compute-btn:disabled {
		opacity: 0.65;
		cursor: not-allowed;
		transform: none;
	}

	.benchmark-desc {
		font-size: 0.9em;
		color: rgb(var(--gray));
		margin-bottom: 1.25em;
		line-height: 1.5;
	}

	/* PROGRESS BAR */
	.compute-progress-bar {
		width: 100%;
		height: 3px;
		background: rgba(0, 0, 0, 0.04);
		border-radius: 2px;
		overflow: hidden;
		margin-bottom: 1.2em;
		opacity: 0;
		transition: opacity 0.2s ease;
	}
	:global(html[data-theme="dark"]) .compute-progress-bar {
		background: rgba(255, 255, 255, 0.05);
	}
	.compute-progress-bar.active {
		opacity: 1;
	}
	.compute-progress-fill {
		height: 100%;
		width: 0%;
		background: linear-gradient(90deg, #ea580c, #ff8c26);
		transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}

	/* METRICS TILES */
	.metrics-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 0.85em;
		margin-bottom: 1.2em;
	}

	@media (max-width: 820px) {
		.metrics-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 480px) {
		.metrics-grid {
			grid-template-columns: 1fr;
		}
	}

	.metric-card {
		background: rgba(0, 0, 0, 0.02);
		border: 1px solid var(--border-color);
		border-radius: 8px;
		padding: 1rem 0.9rem;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		transition: border-color 0.2s ease, transform 0.2s ease;
	}
	:global(html[data-theme="dark"]) .metric-card {
		background: rgba(255, 255, 255, 0.02);
	}
	.metric-card:hover {
		border-color: rgba(234, 88, 12, 0.4);
		transform: translateY(-1px);
	}

	.metric-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 0.5em;
	}
	.metric-label {
		font-size: 0.78em;
		font-weight: 600;
		color: rgb(var(--gray));
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}
	.metric-badge {
		font-size: 0.68em;
		padding: 0.15em 0.5em;
		border-radius: 4px;
		background: rgba(0, 0, 0, 0.06);
		color: rgb(var(--gray));
	}
	:global(html[data-theme="dark"]) .metric-badge {
		background: rgba(255, 255, 255, 0.06);
	}
	.metric-badge.badge-p {
		background: rgba(234, 88, 12, 0.15);
		color: var(--accent);
		border: 1px solid rgba(234, 88, 12, 0.3);
	}

	.metric-value-wrap {
		display: flex;
		align-items: baseline;
		gap: 0.35em;
		margin-bottom: 0.3em;
	}
	.metric-value {
		font-size: 1.65em;
		font-weight: 700;
		color: var(--text-color);
		letter-spacing: -0.02em;
	}
	.metric-unit {
		font-size: 0.75em;
		font-weight: 600;
		color: rgb(var(--gray));
	}
	.metric-sub {
		font-size: 0.72em;
		color: rgb(var(--gray));
		opacity: 0.85;
	}

	/* HARDWARE TOPOLOGY STRIP */
	.topology-strip {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 1.2em;
		padding: 0.75em 1em;
		background: rgba(0, 0, 0, 0.02);
		border: 1px dashed var(--border-color);
		border-radius: 6px;
	}
	:global(html[data-theme="dark"]) .topology-strip {
		background: rgba(255, 255, 255, 0.015);
	}

	.topo-cell {
		display: flex;
		flex-direction: column;
		gap: 0.15em;
	}
	.topo-title {
		font-size: 0.68em;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: rgb(var(--gray));
	}
	.topo-value {
		font-size: 0.8em;
		font-weight: 600;
		color: var(--text-color);
	}

	.actions-cell {
		margin-left: auto;
	}
	.copy-results-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		padding: 0.35em 0.75em;
		font-size: 0.75em;
		font-weight: 500;
		background: transparent;
		border: 1px solid var(--border-color);
		border-radius: 4px;
		color: rgb(var(--gray));
		cursor: pointer;
		transition: all 0.15s ease;
	}
	.copy-results-btn:hover:not(:disabled) {
		border-color: var(--accent);
		color: var(--accent);
	}
	.copy-results-btn:disabled {
		opacity: 0.4;
		cursor: not-allowed;
	}
</style>
