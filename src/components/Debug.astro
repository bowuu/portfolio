---
// Debug.astro - Real-time client-side hardware, runtime & edge telemetry inspector
---

<section class="card telemetry-card" id="debug">
	<div class="telemetry-header">
		<h2 class="card-title">
			<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" class="card-icon">
				<rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
				<line x1="8" y1="21" x2="16" y2="21"/>
				<line x1="12" y1="17" x2="12" y2="21"/>
			</svg>
			Debug
		</h2>
	</div>

	<!-- EXPANDABLE PRIVACY & TELEMETRY NOTICE -->
	<details class="privacy-details">
		<summary class="privacy-summary">
			<div class="privacy-summary-left">
				<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" class="privacy-icon">
					<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
					<path d="m9 12 2 2 4-4"/>
				</svg>
				<span class="privacy-title">Client-Side Privacy Notice</span>
				<span class="privacy-tag">&bull; Zero device data logged</span>
			</div>
			<span class="privacy-toggle">
				<span class="privacy-toggle-label">Details</span>
				<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" class="privacy-chevron">
					<polyline points="6 9 12 15 18 9"/>
				</svg>
			</span>
		</summary>
		<div class="privacy-body">
			<p>
				<strong>Client-Side Evaluation:</strong> The hardware, GPU, CPU, screen, audio, and media metrics below are read ephemerally in your active browser session via standard WebGL, Screen, Audio, and Navigator APIs. <strong>No hardware or browser fingerprinting data is collected, stored, or transmitted to any server or database.</strong>
			</p>
			<p>
				<strong>Anonymous Visitor Counter:</strong> The footer displays an aggregate count of unique human sessions hosted on a Cloudflare D1 serverless database. To prevent duplicate tallies across tabs or browser windows without tracking you, the edge computes an ephemeral, one-way <strong>SHA-256 cryptographic hash</strong> combining your incoming connection with a secret daily salt in volatile memory. <strong>Your raw IP address is discarded immediately and is never stored in any database.</strong> The temporary cryptographic hash is automatically purged after 24–48 hours, and the permanent database only stores an anonymous scalar integer (+1).
			</p>
			<p>
				<strong>Network &amp; Edge Layer:</strong> Like all websites and content delivery networks, Cloudflare Pages edge infrastructure receives standard HTTP connection metadata (such as your connecting IP address and Anycast routing headers) at the network layer to deliver web assets and protect against DDoS attacks.
			</p>
		</div>
	</details>

	<!-- SUBSECTION 1: NETWORK -->
	<div class="telemetry-group">
		<div class="telemetry-group-header">
			<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
				<circle cx="12" cy="12" r="10"/>
				<line x1="2" y1="12" x2="22" y2="12"/>
				<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
			</svg>
			<span>Network</span>
		</div>
		<div class="telemetry-grid">
			<div class="telemetry-item">
				<span class="t-label">Public IP</span>
				<span id="t-ip" class="t-val mono ip-val">Detecting...</span>
			</div>
			<div class="telemetry-item">
				<span class="t-label">Location</span>
				<span id="t-location" class="t-val">Detecting...</span>
			</div>
			<div class="telemetry-item">
				<span class="t-label">Edge Datacenter</span>
				<span id="t-edge" class="t-val">Detecting...</span>
			</div>
			<div class="telemetry-item">
				<span class="t-label">Network &amp; ISP</span>
				<span id="t-isp" class="t-val">Detecting...</span>
			</div>
		</div>
	</div>

	<!-- SUBSECTION 2: HARDWARE -->
	<div class="telemetry-group">
		<div class="telemetry-group-header">
			<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
				<rect x="4" y="4" width="16" height="16" rx="2"/>
				<rect x="9" y="9" width="6" height="6"/>
				<line x1="9" y1="1" x2="9" y2="4"/>
				<line x1="15" y1="1" x2="15" y2="4"/>
				<line x1="9" y1="20" x2="9" y2="23"/>
				<line x1="15" y1="20" x2="15" y2="23"/>
				<line x1="20" y1="9" x2="23" y2="9"/>
				<line x1="20" y1="14" x2="23" y2="14"/>
				<line x1="1" y1="9" x2="4" y2="9"/>
				<line x1="1" y1="14" x2="4" y2="14"/>
			</svg>
			<span>Hardware</span>
		</div>
		<div class="telemetry-grid">
			<div class="telemetry-item">
				<span class="t-label">Operating System</span>
				<span id="t-os" class="t-val">Detecting...</span>
			</div>
			<div class="telemetry-item">
				<span class="t-label">Processor (CPU)</span>
				<span id="t-cpu" class="t-val">Detecting...</span>
			</div>
			<div class="telemetry-item">
				<span class="t-label">System Memory</span>
				<span id="t-ram" class="t-val">Detecting...</span>
			</div>
			<div class="telemetry-item">
				<span class="t-label">Graphics Card (GPU)</span>
				<span id="t-gpu" class="t-val">Detecting WebGL...</span>
			</div>
		</div>
	</div>

	<!-- SUBSECTION 3: DISPLAY -->
	<div class="telemetry-group">
		<div class="telemetry-group-header">
			<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
				<rect x="2" y="3" width="20" height="14" rx="2"/>
				<line x1="8" y1="21" x2="16" y2="21"/>
				<line x1="12" y1="17" x2="12" y2="21"/>
			</svg>
			<span>Display</span>
		</div>
		<div class="telemetry-grid">
			<div class="telemetry-item">
				<span class="t-label">Display &amp; Scaling</span>
				<span id="t-display" class="t-val">Detecting...</span>
			</div>
			<div class="telemetry-item">
				<span class="t-label">Panel Refresh &amp; Gamut</span>
				<span id="t-refresh" class="t-val">Measuring refresh rate...</span>
			</div>
			<div class="telemetry-item">
				<span class="t-label">Screen Orientation</span>
				<span id="t-orientation" class="t-val">Detecting orientation...</span>
			</div>
			<div class="telemetry-item">
				<span class="t-label">Touch Digitizer</span>
				<span id="t-touch" class="t-val">Probing digitizer...</span>
			</div>
		</div>
	</div>

	<!-- SUBSECTION 4: MEDIA -->
	<div class="telemetry-group">
		<div class="telemetry-group-header">
			<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
				<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
				<path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/>
			</svg>
			<span>Media</span>
		</div>
		<div class="telemetry-grid">
			<div class="telemetry-item">
				<span class="t-label">Audio Pipeline Latency</span>
				<span id="t-audio" class="t-val">Probing DAC sink...</span>
			</div>
			<div class="telemetry-item">
				<span class="t-label">Hardware Video Decoder</span>
				<span id="t-codecs" class="t-val">Probing ASIC decoders...</span>
			</div>
			<div class="telemetry-item">
				<span class="t-label">Hardware Video Encoder</span>
				<span id="t-encoder" class="t-val">Probing WebCodecs ASIC...</span>
			</div>
			<div class="telemetry-item">
				<span class="t-label">Video DRM System</span>
				<span id="t-drm" class="t-val">Probing CDM modules...</span>
			</div>
		</div>
	</div>
</section>

<script>
	function detectGPU(): string {
		try {
			const canvas = document.createElement('canvas');
			const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
			if (!gl || !(gl instanceof WebGLRenderingContext)) {
				return 'Hardware Accelerated (WebGL unavailable)';
			}
			const debugInfo = gl.getExtension('WEBGL_debug_renderer_info');
			if (!debugInfo) {
				return 'Hardware Accelerated GPU';
			}
			const renderer = gl.getParameter(debugInfo.UNMASKED_RENDERER_WEBGL);
			if (!renderer) return 'Hardware Accelerated GPU';

			// Format ANGLE strings cleanly and strip trademark noise (e.g. Adreno (TM) -> Qualcomm Adreno)
			const angleMatch = renderer.match(/ANGLE \([^,]+,\s*([^,]+)/);
			const raw = angleMatch && angleMatch[1] ? angleMatch[1] : renderer;
			let cleaned = raw
				.replace(/\sDirect3D.*$/, '')
				.replace(/\s*\((?:0x)?[0-9a-fA-F]{4,8}\)/g, '')
				.replace(/\s*\((?:TM|tm|R|r)\)/gi, '')
				.replace(/[™®]/g, '')
				.replace(/\s+GPU$/i, '')
				.replace(/\s+/g, ' ')
				.trim();

			// Add Qualcomm prefix if Adreno is missing vendor name
			if (/^Adreno\b/i.test(cleaned)) {
				cleaned = 'Qualcomm ' + cleaned;
			}

			return cleaned || 'Hardware Accelerated GPU';
		} catch {
			return 'Generic Graphics Accelerator';
		}
	}

	function buildOSDisplay(osName: string, version: string, arch: string): string {
		const main = version ? `${osName} ${version}` : osName;
		return arch ? `${main} (${arch})` : main;
	}

	function detectOS(gpu: string): { display: string; tooltip: string } {
		const ua = navigator.userAgent;
		const navData = (navigator as any).userAgentData;
		const platform = navData?.platform || navigator.platform || '';
		const isMobileARM = /(Adreno|Mali|Immortalis|Xclipse|PowerVR)/i.test(gpu);
		const hasTouch = (navigator.maxTouchPoints && navigator.maxTouchPoints > 1) || ('ontouchstart' in window);

		// 1. Android
		if (/Android (\d+(\.\d+)?)/i.test(ua)) {
			const match = ua.match(/Android (\d+(\.\d+)?)/i);
			const ver = match ? match[1] : '';
			const isTablet = hasTouch && !/Mobile/i.test(ua);
			const modelMatch = ua.match(/\((?:Linux; Android[^;]+;\s*)([a-zA-Z0-9\-_ ]+)\s+Build/i);
			const model = modelMatch ? modelMatch[1].trim() : (isTablet ? 'Tablet' : '');
			return {
				display: buildOSDisplay('Android', ver, 'ARM64'),
				tooltip: model ? `Device: ${model}` : (isTablet ? 'Android Tablet' : 'Android Mobile')
			};
		}

		// Android Tablet in "Desktop Site" Mode (Chromium sends (X11; Linux x86_64) on tablets)
		if ((/Linux/i.test(ua) || /Linux/i.test(platform)) && (isMobileARM || (hasTouch && !/Macintosh|Windows/i.test(ua)))) {
			return {
				display: buildOSDisplay('Android', '', 'ARM64'),
				tooltip: 'Android Tablet'
			};
		}

		// 2. iOS / iPadOS
		if (/iPhone OS (\d+[._]\d+)/.test(ua)) {
			const match = ua.match(/iPhone OS (\d+[._]\d+)/);
			const ver = match ? match[1].replace('_', '.') : '';
			return {
				display: buildOSDisplay('iOS', ver, 'ARM64'),
				tooltip: 'Apple iPhone'
			};
		}
		if (/iPad/.test(ua) || (ua.includes('Macintosh') && hasTouch)) {
			return {
				display: buildOSDisplay('iPadOS', '', 'ARM64'),
				tooltip: 'Apple iPad'
			};
		}

		// 3. macOS
		if (/Macintosh; Intel Mac OS X (\d+[._]\d+)/.test(ua)) {
			const match = ua.match(/Macintosh; Intel Mac OS X (\d+[._]\d+)/);
			const ver = match ? match[1].replace(/_/g, '.') : '';
			const isAppleSilicon = /Apple/i.test(gpu);
			return {
				display: buildOSDisplay('macOS', ver, isAppleSilicon ? 'ARM64' : 'x86_64'),
				tooltip: isAppleSilicon ? 'Apple Silicon' : 'Intel Mac'
			};
		}

		// 4. Windows
		if (/Windows NT 10.0/.test(ua) || platform === 'Windows') {
			const isLaptop = /Laptop|Mobile/i.test(gpu);
			return {
				display: buildOSDisplay('Windows', '10 / 11', 'x86_64'),
				tooltip: isLaptop ? 'Laptop Chassis' : 'Desktop PC'
			};
		}

		// 5. Genuine Desktop GNU/Linux (no mobile ARM GPU and no multitouch)
		if (/Linux/i.test(ua) || /Linux/i.test(platform)) {
			return {
				display: buildOSDisplay('GNU/Linux', '', 'x86_64'),
				tooltip: 'Linux Workstation'
			};
		}

		return {
			display: platform || 'Unknown OS',
			tooltip: 'Operating System'
		};
	}

	const COLO_NAMES: Record<string, string> = {
		MIA: 'Miami, FL',
		TPA: 'Tampa, FL',
		MCO: 'Orlando, FL',
		ATL: 'Atlanta, GA',
		IAD: 'Ashburn, VA',
		DCA: 'Washington, DC',
		CLT: 'Charlotte, NC',
		RDU: 'Raleigh, NC',
		ORD: 'Chicago, IL',
		DFW: 'Dallas, TX',
		IAH: 'Houston, TX',
		DEN: 'Denver, CO',
		PHX: 'Phoenix, AZ',
		LAX: 'Los Angeles, CA',
		SFO: 'San Francisco, CA',
		SJC: 'San Jose, CA',
		SEA: 'Seattle, WA',
		PDX: 'Portland, OR',
		EWR: 'Newark, NJ',
		JFK: 'New York, NY',
		BOS: 'Boston, MA',
		YYZ: 'Toronto, ON',
		YVR: 'Vancouver, BC',
		LHR: 'London, UK',
		FRA: 'Frankfurt, DE',
		AMS: 'Amsterdam, NL',
		CDG: 'Paris, FR',
		MAD: 'Madrid, ES',
		NRT: 'Tokyo, JP',
		HND: 'Tokyo, JP',
		KIX: 'Osaka, JP',
		ICN: 'Seoul, KR',
		HKG: 'Hong Kong',
		SIN: 'Singapore',
		SYD: 'Sydney, AU',
		MEL: 'Melbourne, AU',
		GRU: 'São Paulo, BR',
	};

	async function initTelemetry() {
		// Network & Edge elements
		const ipEl = document.getElementById('t-ip');
		const locEl = document.getElementById('t-location');
		const edgeEl = document.getElementById('t-edge');
		const ispEl = document.getElementById('t-isp');

		// Hardware & System elements
		const osEl = document.getElementById('t-os');
		const cpuEl = document.getElementById('t-cpu');
		const ramEl = document.getElementById('t-ram');
		const gpuEl = document.getElementById('t-gpu');

		// Display & Touch elements
		const displayEl = document.getElementById('t-display');
		const refreshEl = document.getElementById('t-refresh');
		const orientEl = document.getElementById('t-orientation');
		const touchEl = document.getElementById('t-touch');

		// Audio & Media elements
		const audioEl = document.getElementById('t-audio');
		const codecsEl = document.getElementById('t-codecs');
		const encoderEl = document.getElementById('t-encoder');
		const drmEl = document.getElementById('t-drm');

		// 1. Instant Client Detection: GPU
		const gpuString = detectGPU();
		if (gpuEl) gpuEl.textContent = gpuString;

		// 2. Instant Client Detection: OS
		if (osEl) {
			const initialOS = detectOS(gpuString);
			osEl.textContent = initialOS.display;
			osEl.title = initialOS.tooltip;

			const navData = (navigator as any).userAgentData;
			const isMobileARM = /(Adreno|Mali|Immortalis|Xclipse|PowerVR)/i.test(gpuString);
			const hasTouch = (navigator.maxTouchPoints && navigator.maxTouchPoints > 1) || ('ontouchstart' in window);
			const ua = navigator.userAgent;

			if (navData && navData.getHighEntropyValues) {
				navData.getHighEntropyValues(['platform', 'platformVersion', 'architecture', 'bitness', 'model'])
					.then((hints: any) => {
						if (hints.platform === 'Windows') {
							const major = parseInt(hints.platformVersion?.split('.')[0] || '0', 10);
							const winVer = major >= 13 ? '11' : (major >= 1 ? '10' : '');
							const arch = (hints.architecture === 'arm' || hints.architecture === 'arm64') ? 'ARM64' : 'x86_64';
							const isLaptop = /Laptop|Mobile/i.test(gpuString);
							osEl.textContent = buildOSDisplay('Windows', winVer, arch);
							osEl.title = isLaptop ? 'Laptop Chassis' : 'Desktop PC';
						} else if (
							hints.platform === 'Android' || 
							isMobileARM || 
							(hints.architecture?.toLowerCase().includes('arm') && /Linux/i.test(hints.platform || ''))
						) {
							let ver = hints.platformVersion ? hints.platformVersion.split('.')[0] : '';
							if (!ver) {
								const match = ua.match(/Android (\d+(\.\d+)?)/i);
								if (match) ver = match[1];
							}
							const isTablet = (hasTouch && !/Mobile/i.test(ua)) || /Tablet/i.test(ua);
							const model = hints.model || '';
							osEl.textContent = buildOSDisplay('Android', ver, 'ARM64');
							osEl.title = model 
								? (model.startsWith('SM-') ? `Samsung Device: ${model}` : `Device: ${model}`)
								: (isTablet ? 'Android Tablet' : 'Android Mobile');
						} else if (hints.platform === 'Linux' && !isMobileARM && !hasTouch) {
							const arch = hints.architecture?.includes('64') || hints.bitness === '64' ? 'x86_64' : (hints.architecture || 'x86_64');
							osEl.textContent = buildOSDisplay('GNU/Linux', '', arch);
							osEl.title = 'Linux Workstation';
						} else if (hints.platform === 'macOS') {
							const isAppleSilicon = /Apple/i.test(gpuString) || hints.architecture === 'arm';
							osEl.textContent = buildOSDisplay('macOS', '', isAppleSilicon ? 'ARM64' : 'x86_64');
							osEl.title = isAppleSilicon ? 'Apple Silicon' : 'Intel Mac';
						}
					})
					.catch(() => {});
			}
		}

		// 3. Processor Concurrency
		if (cpuEl) {
			const cores = navigator.hardwareConcurrency;
			cpuEl.textContent = cores ? `${cores} Logical CPU Cores` : 'Multi-core Processor';
			cpuEl.title = 'Total logical CPU threads available.';
		}

		// 4. System Memory
		if (ramEl) {
			const mem = (navigator as any).deviceMemory;
			ramEl.textContent = mem ? `${mem} GB RAM` : '64-bit Architecture';
		}

		// 5. Display & Scaling
		if (displayEl) {
			const dpr = window.devicePixelRatio ? ` @ ${window.devicePixelRatio}x scaling` : '';
			const depth = window.screen.colorDepth ? ` (${window.screen.colorDepth}-bit color)` : '';
			displayEl.textContent = `${window.screen.width} × ${window.screen.height}${dpr}${depth}`;
		}

		// 8. Panel Refresh & Gamut (VRR, LTPO, HDR10 & Video-plane aware)
		const isP3 = window.matchMedia('(color-gamut: p3)').matches;
		const isRec2020 = window.matchMedia('(color-gamut: rec2020)').matches;
		const isHDR = window.matchMedia('(dynamic-range: high)').matches;
		const isVideoHDR = window.matchMedia('(video-dynamic-range: high)').matches;
		const gamut = isRec2020 ? 'Rec.2020' : (isP3 ? 'Display P3' : 'sRGB');
		const hdrTag = (isHDR || isVideoHDR) ? 'HDR' : 'SDR';

		if (refreshEl) {
			let maxObservedHz = 60;
			let isSampling = false;

			function measureRefreshBurst(targetSamples: number = 35) {
				if (isSampling) return;
				isSampling = true;
				let frameTimes: number[] = [];
				let lastFrame = performance.now();
				let frames = 0;

				function onFrame(now: number) {
					const delta = now - lastFrame;
					lastFrame = now;
					if (delta > 2 && delta < 100) frameTimes.push(delta);
					frames++;

					if (frames < targetSamples) {
						requestAnimationFrame(onFrame);
					} else {
						isSampling = false;
						if (frameTimes.length > 5) {
							const clean = frameTimes.slice(3).sort((a, b) => a - b);
							const p15 = clean[Math.floor(clean.length * 0.2)];
							let rawHz = Math.round(1000 / p15);

							for (const std of [60, 75, 90, 120, 144, 165, 240, 360]) {
								if (Math.abs(rawHz - std) <= 4) {
									rawHz = std;
									break;
								}
							}

							if (rawHz > maxObservedHz) maxObservedHz = rawHz;
							const vrrTag = maxObservedHz > 60 ? ' (Adaptive VRR)' : '';
							if (refreshEl) {
								refreshEl.textContent = `${maxObservedHz} Hz${vrrTag} • ${gamut} • ${hdrTag}`;
							}
						}
					}
				}
				requestAnimationFrame(onFrame);
			}

			measureRefreshBurst(30);

			const wakeVRR = () => {
				measureRefreshBurst(35);
			};
			window.addEventListener('scroll', wakeVRR, { passive: true, once: false });
			window.addEventListener('pointerdown', wakeVRR, { passive: true, once: false });
			refreshEl.style.cursor = 'pointer';
			refreshEl.title = 'Click to re-test display refresh rate.';
			refreshEl.addEventListener('click', () => measureRefreshBurst(50));
		}

		// 9. Screen Orientation & Hardware Angle
		if (orientEl) {
			const updateOrient = () => {
				if (screen.orientation) {
					const type = screen.orientation.type.replace('-', ' ');
					const angle = screen.orientation.angle;
					orientEl.textContent = `${type.charAt(0).toUpperCase() + type.slice(1)} (${angle}°)`;
				} else {
					const isLand = window.innerWidth > window.innerHeight;
					orientEl.textContent = isLand ? 'Landscape (0°)' : 'Portrait (0°)';
				}
			};
			updateOrient();
			if (screen.orientation && screen.orientation.addEventListener) {
				screen.orientation.addEventListener('change', updateOrient);
			} else {
				window.addEventListener('resize', updateOrient, { passive: true });
			}
			orientEl.title = 'Display orientation and rotation angle.';
		}

		// 10. Hardware Touch Digitizer
		if (touchEl) {
			const points = navigator.maxTouchPoints || 0;
			if (points > 0) {
				touchEl.textContent = `${points}-Point Multitouch`;
				touchEl.title = `${points}-point hardware multitouch digitizer.`;
			} else {
				touchEl.textContent = '0 (Precision Mouse / No Touch)';
				touchEl.title = 'No touch digitizer detected (mouse/pointer input).';
			}
		}

		// 9. Audio Pipeline Latency
		if (audioEl) {
			try {
				const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
				if (AudioCtx) {
					const actx = new AudioCtx();
					const baseLatMs = ((actx.baseLatency || 0.005) * 1000).toFixed(1);
					const outLatMs = (actx as any).outputLatency ? (((actx as any).outputLatency) * 1000).toFixed(1) : null;
					const rateKhz = (actx.sampleRate / 1000).toFixed(0);
					
					if (outLatMs) {
						audioEl.textContent = `${baseLatMs} ms buffer (${outLatMs} ms sink) • ${rateKhz} kHz DAC`;
					} else {
						audioEl.textContent = `${baseLatMs} ms buffer • ${rateKhz} kHz DAC`;
					}
					audioEl.title = `Buffer latency: ${baseLatMs} ms • DAC: ${rateKhz} kHz`;
					actx.close();
				} else {
					audioEl.textContent = 'Standard Audio (DAC Output)';
				}
			} catch (_) {
				audioEl.textContent = 'Hardware Audio Output';
			}
		}

		// 10. Hardware Video Decoder (MediaCapabilities API Decoders)
		if (codecsEl) {
			const probeCodecs = async () => {
				if (navigator.mediaCapabilities && navigator.mediaCapabilities.decodingInfo) {
					const candidates = [
						{ name: 'AV1', config: { type: 'file', video: { contentType: 'video/mp4; codecs="av01.0.08M.10"', width: 1920, height: 1080, bitrate: 5000000, framerate: 60 } } },
						{ name: 'HEVC', config: { type: 'file', video: { contentType: 'video/mp4; codecs="hvc1.1.6.L93.B0"', width: 1920, height: 1080, bitrate: 5000000, framerate: 60 } } },
						{ name: 'VP9', config: { type: 'file', video: { contentType: 'video/webm; codecs="vp09.00.10.08"', width: 1920, height: 1080, bitrate: 5000000, framerate: 60 } } },
						{ name: 'H.264', config: { type: 'file', video: { contentType: 'video/mp4; codecs="avc1.640028"', width: 1920, height: 1080, bitrate: 5000000, framerate: 60 } } },
					];
					const supported: string[] = [];
					for (const c of candidates) {
						try {
							const res = await navigator.mediaCapabilities.decodingInfo(c.config as any);
							if (res.supported) {
								supported.push(c.name);
							}
						} catch (_) {}
					}
					if (supported.length > 0) {
						codecsEl.textContent = supported.join(' • ');
					} else {
						codecsEl.textContent = 'H.264 • VP9 • WebM';
					}
				} else {
					codecsEl.textContent = 'H.264 • VP9 • WebM';
				}
			};
			probeCodecs();
			codecsEl.title = 'Hardware-accelerated video decoding support.';
		}

		// 11. Hardware Video Encoder (WebCodecs API)
		if (encoderEl) {
			const probeEncoder = async () => {
				if (typeof VideoEncoder !== 'undefined' && VideoEncoder.isConfigSupported) {
					const encCandidates = [
						{ name: 'AV1', codec: 'av01.0.08M.10' },
						{ name: 'HEVC', codec: 'hvc1.1.6.L93.B0' },
						{ name: 'VP9', codec: 'vp09.00.10.08' },
						{ name: 'H.264', codec: 'avc1.42001f' }
					];
					const supported: string[] = [];
					for (const c of encCandidates) {
						try {
							const res = await VideoEncoder.isConfigSupported({
								codec: c.codec,
								width: 1920,
								height: 1080,
								bitrate: 5000000,
								framerate: 60
							});
							if (res.supported) {
								supported.push(c.name);
							}
						} catch (_) {}
					}
					if (supported.length > 0) {
						encoderEl.textContent = supported.join(' • ');
						encoderEl.title = 'Hardware-accelerated video encoding support.';
					} else {
						encoderEl.textContent = 'Software / CPU Encoding';
					}
				} else {
					encoderEl.textContent = 'Not Supported';
					encoderEl.title = 'Hardware video encoding not supported.';
				}
			};
			probeEncoder();
		}

		// 12. Hardware DRM Key System (EME)
		if (drmEl) {
			const probeDRM = async () => {
				if (navigator.requestMediaKeySystemAccess) {
					const drmCandidates = [
						{
							id: 'com.widevine.alpha',
							name: 'Widevine',
							config: [{
								initDataTypes: ['cenc'],
								videoCapabilities: [{ contentType: 'video/mp4; codecs="avc1.42E01E"' }]
							}],
							hwConfig: [{
								initDataTypes: ['cenc'],
								videoCapabilities: [{ contentType: 'video/mp4; codecs="avc1.42E01E"', robustness: 'HW_SECURE_ALL' }]
							}]
						},
						{
							id: 'com.microsoft.playready.recommendation',
							name: 'PlayReady (Hardware)',
							config: [{
								initDataTypes: ['cenc'],
								videoCapabilities: [{ contentType: 'video/mp4; codecs="avc1.42E01E"' }]
							}]
						},
						{
							id: 'com.microsoft.playready',
							name: 'PlayReady',
							config: [{
								initDataTypes: ['cenc'],
								videoCapabilities: [{ contentType: 'video/mp4; codecs="avc1.42E01E"' }]
							}]
						},
						{
							id: 'com.apple.fps',
							name: 'FairPlay',
							config: [{
								initDataTypes: ['sinf'],
								videoCapabilities: [{ contentType: 'video/mp4; codecs="avc1.42E01E"' }]
							}]
						}
					];

					const found: string[] = [];
					for (const item of drmCandidates) {
						if (item.id === 'com.microsoft.playready' && found.some(f => f.includes('PlayReady'))) continue;
						try {
							await navigator.requestMediaKeySystemAccess(item.id, item.config as any);
							if (item.id === 'com.widevine.alpha' && item.hwConfig) {
								try {
									await navigator.requestMediaKeySystemAccess(item.id, item.hwConfig as any);
									found.push('Widevine L1 (Hardware TrustZone)');
								} catch {
									found.push('Widevine L3 (Software CDM)');
								}
							} else {
								found.push(item.name);
							}
						} catch (_) {}
					}

					if (found.length > 0) {
						drmEl.textContent = found.join(' • ');
						drmEl.title = `Active DRM: ${found.join(', ')}`;
					} else {
						drmEl.textContent = 'Standard / Open Media';
						drmEl.title = 'No DRM key system detected.';
					}
				} else {
					drmEl.textContent = 'Not Supported';
				}
			};
			probeDRM();
		}

		// 15. Cloudflare Edge Ephemeral Detection
		try {
			const res = await fetch('/api/visitor-info', { cache: 'no-store' });
			if (res.ok) {
				const data = await res.json();
				if (ipEl) ipEl.textContent = data.ip || 'Unavailable';
				
				const locParts = [data.city, data.region, data.country].filter(Boolean);
				if (locEl) {
					locEl.textContent = locParts.length > 0 ? locParts.join(', ') : 'Location unavailable';
					locEl.title = 'Approximate geolocation based on client IP.';
				}

				if (edgeEl) {
					const coloCode = (data.coloCode || (data.colo ? data.colo.split(' ')[0] : '')).toUpperCase();
					const coloCity = coloCode && COLO_NAMES[coloCode];
					if (coloCity) {
						edgeEl.textContent = `${coloCode} (${coloCity})`;
					} else if (data.colo) {
						edgeEl.textContent = data.colo;
					} else {
						edgeEl.textContent = 'Cloudflare Anycast Edge';
					}
					edgeEl.title = 'Cloudflare Anycast edge datacenter.';
				}

				if (ispEl) {
					const asn = data.asn ? `AS${data.asn}` : '';
					const isp = data.isp ? `${data.isp}` : 'Broadband Provider';
					ispEl.textContent = asn ? `${isp} (${asn})` : isp;
				}
			} else {
				throw new Error('Edge endpoint responded with non-200');
			}
		} catch (err) {
			if (ipEl) ipEl.textContent = '127.0.0.1 (Local Edge)';
			if (locEl) locEl.textContent = 'Direct Connection';
			if (edgeEl) edgeEl.textContent = 'Localhost (Dev Edge)';
			if (ispEl) ispEl.textContent = 'Cloudflare Protected';
		}
	}

	initTelemetry();
	document.addEventListener('astro:page-load', initTelemetry);
</script>

