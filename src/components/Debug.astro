								<div class="webgpu-tile-val">${webgpuInfoCache.features.hasBC ? 'BC <span class="webgpu-tile-sub">(DirectX)</span>' : (webgpuInfoCache.features.hasASTC ? 'ASTC' : 'Standard')}</div>
