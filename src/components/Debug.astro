					worker.postMessage({ canvas: offscreen }, [offscreen]);
				} catch (_) {}
			}

			// 3. Real-Time Low-Latency Interaction Observer
			// Catches Android Choreographer Touch Boost the instant touch/gesture occurs
			let activeSamplingUntil = 0;
			let interactionRafId: number | null = null;
			let lastInteractionTime = performance.now();
			const rollingInteractionDeltas: number[] = [];

			function onInteractionDetected() {
				activeSamplingUntil = performance.now() + 1500; // Sample for 1.5s following touch/gesture
				if (interactionRafId !== null) return;
				lastInteractionTime = performance.now();

				function interactionLoop(now: number) {
					const delta = now - lastInteractionTime;
					lastInteractionTime = now;

					if (delta >= 1.6 && delta <= 50) {
						rollingInteractionDeltas.push(delta);
						if (rollingInteractionDeltas.length > 50) {
							rollingInteractionDeltas.shift();
						}
						// Process rolling window every 6 frames
						if (rollingInteractionDeltas.length >= 6 && rollingInteractionDeltas.length % 6 === 0) {
