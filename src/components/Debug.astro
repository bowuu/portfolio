							const wcRes = await VideoDecoder.isConfigSupported({
								codec: c.codec,
								codedWidth: 1920,
								codedHeight: 1080,
								hardwareAcceleration: 'prefer-hardware'
							});
							if (wcRes) {
								if (wcRes.supported === false) {
