				const displaySize = mbSize >= 1.0 ? `${mbSize.toFixed(1)} MB` : `${kbSize.toFixed(0)} KB`;
				const avgKbPerFrame = (kbSize / totalFrames).toFixed(1);
				const durationSec = totalFrames / fps;
				const bitrateMbps = ((totalChunkBytes * 8) / (durationSec * 1_000_000)).toFixed(1);
				const rawMb = Math.round(rawBytes / (1024 * 1024));
				const ratioX = Math.round(rawBytes / Math.max(1, totalChunkBytes));

