---
// Debug.astro - Real-time client-side hardware, runtime & edge telemetry inspector
---

<section class="card telemetry-card" id="debug">
	<div class="telemetry-header">
		<h2 class="card-title">
			<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" class="card-icon">
				<rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
				<line x1="8" y1="21" x2="16" y2="21"/>
				<line x1="12" y1="17" x2="12" y2="21"/>
			</svg>
			Debug
		</h2>
	</div>

	<!-- EXPANDABLE PRIVACY & TELEMETRY NOTICE -->
	<details class="privacy-details">
		<summary class="privacy-summary">
			<div class="privacy-summary-left">
				<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" class="privacy-icon">
					<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
					<path d="m9 12 2 2 4-4"/>
				</svg>
				<span class="privacy-title">Client-Side Privacy Notice</span>
				<span class="privacy-tag">&bull; Zero device data logged</span>
			</div>
			<span class="privacy-toggle">
				<span class="privacy-toggle-label">Details</span>
				<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" class="privacy-chevron">
					<polyline points="6 9 12 15 18 9"/>
				</svg>
			</span>
		</summary>
		<div class="privacy-body">
			<p>
				<strong>Network:</strong> Like all websites and content delivery networks, Cloudflare Pages edge infrastructure receives standard HTTP connection metadata (such as your connecting IP address and Anycast routing headers) at the network layer to deliver web assets and protect against DDoS attacks.
			</p>
			<p>
				<strong>Client-Side Evaluation:</strong> The hardware, GPU, CPU, screen, audio, and media metrics below are read ephemerally in your active browser session via standard WebGL, Screen, Audio, and Navigator APIs. <strong>No hardware or browser fingerprinting data is collected, stored, or transmitted to any server or database.</strong>
			</p>
			<p>
				<strong>Visitor Counter:</strong> The footer tally stores only an anonymous aggregate count in Cloudflare D1. To deduplicate visits across tabs and shared networks without tracking individuals, an ephemeral one-way hash combining connection headers with a daily rotating salt is evaluated in volatile memory. <strong>Raw IP addresses and device identifiers are never stored.</strong> Temporary deduplication hashes are purged at UTC midnight rollover, while the total visitor count remains permanent.
			</p>
		</div>
	</details>

	<!-- SUBSECTION 1: NETWORK -->
	<div class="telemetry-group">
		<div class="telemetry-group-header">
			<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
				<circle cx="12" cy="12" r="10"/>
				<line x1="2" y1="12" x2="22" y2="12"/>
				<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
			</svg>
			<span>Network</span>
		</div>
		<div class="telemetry-grid">
			<div class="telemetry-item telemetry-ip-item">
				<span class="t-label">Public IP</span>
				<span id="t-ip" class="sr-only" aria-hidden="true">Detecting...</span>
				<div class="ip-dual-stack">
					<div class="ip-line">
						<span class="ip-tag">IPv4:</span>
						<span id="t-ipv4" class="t-val mono ip-val">Detecting...</span>
					</div>
					<div class="ip-line">
						<span class="ip-tag">IPv6:</span>
						<span id="t-ipv6" class="t-val mono ip-val">Detecting...</span>
					</div>
				</div>
			</div>
			<div class="telemetry-item">
				<div class="loc-label-bar">
					<span class="t-label">Location</span>
					<button id="open-map-btn" class="loc-map-btn hidden" type="button" title="Open interactive OpenStreetMap applet">
						<svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon><line x1="8" y1="2" x2="8" y2="18"></line><line x1="16" y1="6" x2="16" y2="22"></line></svg>
						<span>Map</span>
					</button>
				</div>
				<span id="t-location" class="t-val">Detecting...</span>
			</div>
			<div class="telemetry-item">
				<span class="t-label">Edge Datacenter</span>
				<span id="t-edge" class="t-val">Detecting...</span>
			</div>
			<div class="telemetry-item">
				<span class="t-label">Network &amp; ISP</span>
				<span id="t-isp" class="t-val">Detecting...</span>
			</div>
		</div>
	</div>

	<!-- SUBSECTION 2: HARDWARE -->
	<div class="telemetry-group">
		<div class="telemetry-group-header">
			<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
				<rect x="4" y="4" width="16" height="16" rx="2"/>
				<rect x="9" y="9" width="6" height="6"/>
				<line x1="9" y1="1" x2="9" y2="4"/>
				<line x1="15" y1="1" x2="15" y2="4"/>
				<line x1="9" y1="20" x2="9" y2="23"/>
				<line x1="15" y1="20" x2="15" y2="23"/>
				<line x1="20" y1="9" x2="23" y2="9"/>
				<line x1="20" y1="14" x2="23" y2="14"/>
				<line x1="1" y1="9" x2="4" y2="9"/>
				<line x1="1" y1="14" x2="4" y2="14"/>
			</svg>
			<span>Hardware</span>
		</div>
		<div class="telemetry-grid">
			<div class="telemetry-item">
				<span class="t-label">Operating System</span>
				<span id="t-os" class="t-val">Detecting...</span>
			</div>
			<div class="telemetry-item">
				<span class="t-label">Processor (CPU)</span>
				<span id="t-cpu" class="t-val">Detecting...</span>
			</div>
			<div class="telemetry-item">
				<span class="t-label">System Memory</span>
				<span id="t-ram" class="t-val">Detecting...</span>
			</div>
			<div class="telemetry-item">
				<span class="t-label">Graphics Card (GPU)</span>
				<span id="t-gpu" class="t-val">Detecting WebGL...</span>
			</div>
		</div>
	</div>

	<!-- SUBSECTION 3: DISPLAY -->
	<div class="telemetry-group">
		<div class="telemetry-group-header">
			<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
				<rect x="2" y="3" width="20" height="14" rx="2"/>
				<line x1="8" y1="21" x2="16" y2="21"/>
				<line x1="12" y1="17" x2="12" y2="21"/>
			</svg>
			<span>Display</span>
		</div>
		<div class="telemetry-grid">
			<div class="telemetry-item">
				<span class="t-label">Display &amp; Scaling</span>
				<span id="t-display" class="t-val">Detecting...</span>
			</div>
			<div class="telemetry-item">
				<span class="t-label">Panel Refresh &amp; Gamut</span>
				<span id="t-refresh" class="t-val">Measuring refresh rate...</span>
			</div>
			<div class="telemetry-item">
				<span class="t-label">Screen Orientation</span>
				<span id="t-orientation" class="t-val">Detecting orientation...</span>
			</div>
			<div class="telemetry-item">
				<span class="t-label">Touch Digitizer</span>
				<span id="t-touch" class="t-val">Probing digitizer...</span>
			</div>
		</div>
	</div>

	<!-- SUBSECTION 4: MEDIA -->
	<div class="telemetry-group">
		<div class="telemetry-group-header">
			<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
				<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
				<path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/>
			</svg>
			<span>Media</span>
		</div>
		<div class="telemetry-grid">
			<div class="telemetry-item">
				<span class="t-label">Audio Pipeline Latency</span>
				<span id="t-audio" class="t-val">Probing DAC sink...</span>
			</div>
			<div class="telemetry-item">
				<span class="t-label">Hardware Video Decoder</span>
				<span id="t-codecs" class="t-val">Probing ASIC decoders...</span>
			</div>
			<div class="telemetry-item">
				<span class="t-label">Hardware Video Encoder</span>
				<span id="t-encoder" class="t-val">Probing WebCodecs ASIC...</span>
			</div>
			<div class="telemetry-item">
				<span class="t-label">Video DRM System</span>
				<span id="t-drm" class="t-val">Probing CDM modules...</span>
			</div>
		</div>
	</div>

	<!-- INTERACTIVE MAP APPLET (OpenStreetMap) -->
	<div id="map-applet-modal" class="map-applet-modal hidden" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="map-applet-title">
		<div class="map-applet-backdrop" id="map-applet-backdrop"></div>
		<div class="map-applet-dialog">
			<div class="map-applet-header">
				<div class="map-applet-title-wrap">
					<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" class="map-pin-icon">
						<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
						<circle cx="12" cy="10" r="3"></circle>
					</svg>
					<div>
						<h3 id="map-applet-title" class="map-applet-title">Edge Geolocation Map</h3>
						<span id="map-coords-badge" class="map-coords-badge mono">--</span>
					</div>
				</div>
				<button id="map-applet-close-btn" class="map-close-btn" type="button" aria-label="Close Map Applet" title="Close (Esc)">
					<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
						<line x1="18" y1="6" x2="6" y2="18"></line>
						<line x1="6" y1="6" x2="18" y2="18"></line>
					</svg>
				</button>
			</div>

			<div class="map-applet-frame-wrap">
				<div id="map-applet-loader" class="map-applet-loader">
					<div class="map-spinner"></div>
					<span>Loading OpenStreetMap...</span>
				</div>
				<iframe
					id="map-applet-iframe"
					class="map-applet-iframe"
					title="OpenStreetMap Location Applet"
					loading="lazy"
					src="about:blank"
				></iframe>
			</div>

			<div class="map-applet-footer">
				<div class="map-footer-info">
					<span id="map-footer-loc" class="map-footer-loc">--</span>
					<span class="map-footer-note">OpenStreetMap &bull; Approximate city-level Anycast edge geolocation</span>
				</div>
				<a id="map-external-link" href="https://www.openstreetmap.org" target="_blank" rel="noopener noreferrer" class="map-ext-link" title="Open full map on openstreetmap.org">
					<span>Open in OSM</span>
					<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
						<polyline points="15 3 21 3 21 9"></polyline>
						<line x1="10" y1="14" x2="21" y2="3"></line>
					</svg>
				</a>
			</div>
		</div>
	</div>
</section>

<script>
	function detectGPU(): string {
		try {
			const canvas = document.createElement('canvas');
			const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
			if (!gl || !(gl instanceof WebGLRenderingContext)) {
				return 'Hardware Accelerated (WebGL unavailable)';
			}
			const debugInfo = gl.getExtension('WEBGL_debug_renderer_info');
			if (!debugInfo) {
				return 'Hardware Accelerated GPU';
			}
			const renderer = gl.getParameter(debugInfo.UNMASKED_RENDERER_WEBGL);
			if (!renderer) return 'Hardware Accelerated GPU';

			// Format ANGLE strings cleanly and strip trademark noise (e.g. Adreno (TM) -> Qualcomm Adreno)
			const angleMatch = renderer.match(/ANGLE \([^,]+,\s*([^,]+)/);
			const raw = angleMatch && angleMatch[1] ? angleMatch[1] : renderer;
			let cleaned = raw
				.replace(/^ANGLE Metal Renderer:\s*/i, '')
				.replace(/\sDirect3D.*$/, '')
				.replace(/\s*\((?:0x)?[0-9a-fA-F]{4,8}\)/g, '')
				.replace(/\s*\((?:TM|tm|R|r)\)/gi, '')
				.replace(/[™®]/g, '')
				.replace(/(?<!^Apple)\s+GPU$/i, '')
				.replace(/,?\s*or similar\b[\s.]*/gi, '')
				.replace(/^Mesa (?:DRI )?/i, '')
				.replace(/\s+/g, ' ')
				.trim();

			// Add Qualcomm prefix if Adreno is missing vendor name
			if (/^Adreno\b/i.test(cleaned)) {
				cleaned = 'Qualcomm ' + cleaned;
			}

			return cleaned || 'Hardware Accelerated GPU';
		} catch {
			return 'Generic Graphics Accelerator';
		}
	}

	function buildOSDisplay(osName: string, version: string, arch: string): string {
		const main = version ? `${osName} ${version}` : osName;
		return arch ? `${main} (${arch})` : main;
	}

	function detectOS(gpu: string): { display: string; tooltip: string } {
		const ua = navigator.userAgent;
		const navData = (navigator as any).userAgentData;
		const platform = navData?.platform || navigator.platform || '';
		const isMobileARM = /(Adreno|Mali|Immortalis|Xclipse|PowerVR)/i.test(gpu);
		const hasTouch = (navigator.maxTouchPoints && navigator.maxTouchPoints > 1) || ('ontouchstart' in window);

		// 1. Android
		if (/Android (\d+(\.\d+)?)/i.test(ua)) {
			const match = ua.match(/Android (\d+(\.\d+)?)/i);
			const ver = match ? match[1] : '';
			const isTablet = hasTouch && !/Mobile/i.test(ua);
			const modelMatch = ua.match(/\((?:Linux; Android[^;]+;\s*)([a-zA-Z0-9\-_ ]+)\s+Build/i);
			const model = modelMatch ? modelMatch[1].trim() : (isTablet ? 'Tablet' : '');
			return {
				display: buildOSDisplay('Android', ver, 'ARM64'),
				tooltip: model ? `Device: ${model}` : (isTablet ? 'Android Tablet' : 'Android Mobile')
			};
		}

		// Android Tablet in "Desktop Site" Mode (Chromium sends (X11; Linux x86_64) on tablets)
		if ((/Linux/i.test(ua) || /Linux/i.test(platform)) && (isMobileARM || (hasTouch && !/Macintosh|Windows/i.test(ua)))) {
			return {
				display: buildOSDisplay('Android', '', 'ARM64'),
				tooltip: 'Android Tablet'
			};
		}

		// 2. iOS / iPadOS
		if (/iPhone OS (\d+[._]\d+)/.test(ua)) {
			const match = ua.match(/iPhone OS (\d+[._]\d+)/);
			const ver = match ? match[1].replace('_', '.') : '';
			return {
				display: buildOSDisplay('iOS', ver, 'ARM64'),
				tooltip: 'Apple iPhone'
			};
		}
		if (/iPad/.test(ua) || (ua.includes('Macintosh') && hasTouch)) {
			return {
				display: buildOSDisplay('iPadOS', '', 'ARM64'),
				tooltip: 'Apple iPad'
			};
		}

		// 3. macOS
		if (/Macintosh; Intel Mac OS X (\d+[._]\d+)/.test(ua) || /Macintosh/i.test(ua) || platform === 'MacIntel') {
			const match = ua.match(/Macintosh; Intel Mac OS X (\d+[._]\d+)/);
			let ver = match ? match[1].replace(/_/g, '.') : '';
			const isAppleSilicon = /Apple/i.test(gpu);
			// Apple WebKit permanently freezes Safari UA to 10.15 (10.15.7). Omit the synthetic version for Apple Silicon or legacy freeze
			if (isAppleSilicon || ver === '10.15') {
				ver = '';
			}
			return {
				display: buildOSDisplay('macOS', ver, isAppleSilicon ? 'ARM64' : 'x86_64'),
				tooltip: isAppleSilicon ? 'Apple Silicon' : 'Intel Mac'
			};
		}

		// 4. Windows
		if (/Windows NT 10.0/.test(ua) || platform === 'Windows') {
			const isLaptop = /Laptop|Mobile/i.test(gpu);
			return {
				display: buildOSDisplay('Windows', '10 / 11', 'x86_64'),
				tooltip: isLaptop ? 'Laptop Chassis' : 'Desktop PC'
			};
		}

		// 5. ChromeOS (Chromebooks)
		if (/CrOS/i.test(ua)) {
			const isArm = /arm|aarch64/i.test(ua);
			return {
				display: buildOSDisplay('ChromeOS', '', isArm ? 'ARM64' : 'x86_64'),
				tooltip: 'Chromebook'
			};
		}

		// 6. Genuine Desktop GNU/Linux (no mobile ARM GPU and no multitouch)
		if (/Linux/i.test(ua) || /Linux/i.test(platform)) {
			const isArmLinux = /aarch64|arm64|armv8/i.test(ua) || /aarch64|arm64|armv8/i.test(platform);
			return {
				display: buildOSDisplay('GNU/Linux', '', isArmLinux ? 'ARM64' : 'x86_64'),
				tooltip: isArmLinux ? 'ARM Linux Workstation' : 'Linux Workstation'
			};
		}

		return {
			display: platform || 'Unknown OS',
			tooltip: 'Operating System'
		};
	}

	const COLO_NAMES: Record<string, string> = {
		MIA: 'Miami, FL',
		TPA: 'Tampa, FL',
		MCO: 'Orlando, FL',
		ATL: 'Atlanta, GA',
		IAD: 'Ashburn, VA',
		DCA: 'Washington, DC',
		CLT: 'Charlotte, NC',
		RDU: 'Raleigh, NC',
		ORD: 'Chicago, IL',
		DFW: 'Dallas, TX',
		IAH: 'Houston, TX',
		DEN: 'Denver, CO',
		PHX: 'Phoenix, AZ',
		LAX: 'Los Angeles, CA',
		SFO: 'San Francisco, CA',
		SJC: 'San Jose, CA',
		SEA: 'Seattle, WA',
		PDX: 'Portland, OR',
		EWR: 'Newark, NJ',
		JFK: 'New York, NY',
		BOS: 'Boston, MA',
		YYZ: 'Toronto, ON',
		YVR: 'Vancouver, BC',
		LHR: 'London, UK',
		FRA: 'Frankfurt, DE',
		AMS: 'Amsterdam, NL',
		CDG: 'Paris, FR',
		MAD: 'Madrid, ES',
		NRT: 'Tokyo, JP',
		HND: 'Tokyo, JP',
		KIX: 'Osaka, JP',
		ICN: 'Seoul, KR',
		HKG: 'Hong Kong',
		SIN: 'Singapore',
		SYD: 'Sydney, AU',
		MEL: 'Melbourne, AU',
		GRU: 'São Paulo, BR',
	};

	async function initTelemetry() {
		// Network & Edge elements
		const ipv4El = document.getElementById('t-ipv4');
		const ipv6El = document.getElementById('t-ipv6');
		const legacyIpEl = document.getElementById('t-ip');
		const locEl = document.getElementById('t-location');
		const edgeEl = document.getElementById('t-edge');
		const ispEl = document.getElementById('t-isp');
		const openMapBtn = document.getElementById('open-map-btn');

		let currentIpv4 = '';
		let currentIpv6 = '';

		function renderIpDisplay() {
			if (ipv4El) {
				ipv4El.textContent = currentIpv4 || 'Detecting...';
				if (currentIpv4 && currentIpv4 !== 'Unavailable') {
					ipv4El.title = 'Client public IPv4 address detected at Cloudflare edge.';
				}
			}

			if (ipv6El) {
				if (currentIpv6 === 'none') {
					ipv6El.innerHTML = '<span class="ip-disabled">No IPv6 enabled</span>';
					ipv6El.title = 'No active IPv6 route detected on client connection.';
				} else if (!currentIpv6) {
					ipv6El.textContent = 'Detecting...';
				} else {
					ipv6El.textContent = currentIpv6;
					ipv6El.title = 'Client public IPv6 address detected at Cloudflare edge.';
				}
			}

			if (legacyIpEl) {
				legacyIpEl.textContent = currentIpv4 || currentIpv6 || 'Detected at edge';
			}
		}

		function openMapApplet(lat: number, lon: number, locName: string) {
			const modal = document.getElementById('map-applet-modal');
			const iframe = document.getElementById('map-applet-iframe') as HTMLIFrameElement | null;
			const loader = document.getElementById('map-applet-loader');
			const coordsEl = document.getElementById('map-coords-badge');
			const footerLocEl = document.getElementById('map-footer-loc');
			const extLink = document.getElementById('map-external-link') as HTMLAnchorElement | null;

			if (!modal || !iframe) return;

			const latDir = lat >= 0 ? 'N' : 'S';
			const lonDir = lon >= 0 ? 'E' : 'W';
			const formattedCoords = `${Math.abs(lat).toFixed(4)}° ${latDir}, ${Math.abs(lon).toFixed(4)}° ${lonDir}`;

			if (coordsEl) coordsEl.textContent = formattedCoords;
			if (footerLocEl) footerLocEl.textContent = locName;

			const delta = 0.045; // ~5km radius bounding box
			const minLon = (lon - delta).toFixed(5);
			const minLat = (lat - delta).toFixed(5);
			const maxLon = (lon + delta).toFixed(5);
			const maxLat = (lat + delta).toFixed(5);
			const embedUrl = `https://www.openstreetmap.org/export/embed.html?bbox=${minLon}%2C${minLat}%2C${maxLon}%2C${maxLat}&layer=mapnik&marker=${lat.toFixed(5)}%2C${lon.toFixed(5)}`;
			const fullUrl = `https://www.openstreetmap.org/?mlat=${lat.toFixed(5)}&mlon=${lon.toFixed(5)}#map=13/${lat.toFixed(5)}/${lon.toFixed(5)}`;

			if (extLink) extLink.href = fullUrl;

			if (loader) loader.style.display = 'flex';
			iframe.onload = () => {
				if (loader) loader.style.display = 'none';
			};

			if (iframe.src !== embedUrl) {
				iframe.src = embedUrl;
			}

			modal.classList.remove('hidden');
			modal.setAttribute('aria-hidden', 'false');
			document.body.style.overflow = 'hidden';
		}

		function closeMapApplet() {
			const modal = document.getElementById('map-applet-modal');
			if (!modal || modal.classList.contains('hidden')) return;
			modal.classList.add('hidden');
			modal.setAttribute('aria-hidden', 'true');
			document.body.style.overflow = '';
		}

		const mapCloseBtn = document.getElementById('map-applet-close-btn');
		const mapBackdrop = document.getElementById('map-applet-backdrop');
		if (mapCloseBtn) mapCloseBtn.onclick = closeMapApplet;
		if (mapBackdrop) mapBackdrop.onclick = closeMapApplet;

		// Hardware & System elements
		const osEl = document.getElementById('t-os');
		const cpuEl = document.getElementById('t-cpu');
		const ramEl = document.getElementById('t-ram');
		const gpuEl = document.getElementById('t-gpu');

		// Display & Touch elements
		const displayEl = document.getElementById('t-display');
		const refreshEl = document.getElementById('t-refresh');
		const orientEl = document.getElementById('t-orientation');
		const touchEl = document.getElementById('t-touch');

		// Audio & Media elements
		const audioEl = document.getElementById('t-audio');
		const codecsEl = document.getElementById('t-codecs');
		const encoderEl = document.getElementById('t-encoder');
		const drmEl = document.getElementById('t-drm');

		// 1. Instant Client Detection: GPU
		const gpuString = detectGPU();
		if (gpuEl) gpuEl.textContent = gpuString;

		// 2. Instant Client Detection: OS
		if (osEl) {
			const initialOS = detectOS(gpuString);
			osEl.textContent = initialOS.display;
			osEl.title = initialOS.tooltip;

			const navData = (navigator as any).userAgentData;
			const isMobileARM = /(Adreno|Mali|Immortalis|Xclipse|PowerVR)/i.test(gpuString);
			const hasTouch = (navigator.maxTouchPoints && navigator.maxTouchPoints > 1) || ('ontouchstart' in window);
			const ua = navigator.userAgent;

			if (navData && navData.getHighEntropyValues) {
				navData.getHighEntropyValues(['platform', 'platformVersion', 'architecture', 'bitness', 'model'])
					.then((hints: any) => {
						if (hints.platform === 'Windows') {
							const major = parseInt(hints.platformVersion?.split('.')[0] || '0', 10);
							const winVer = major >= 13 ? '11' : (major >= 1 ? '10' : '');
							const arch = (hints.architecture === 'arm' || hints.architecture === 'arm64') ? 'ARM64' : 'x86_64';
							const isLaptop = /Laptop|Mobile/i.test(gpuString);
							osEl.textContent = buildOSDisplay('Windows', winVer, arch);
							osEl.title = isLaptop ? 'Laptop Chassis' : 'Desktop PC';
						} else if (
							hints.platform === 'Android' || 
							isMobileARM || 
							(hints.architecture?.toLowerCase().includes('arm') && /Linux/i.test(hints.platform || ''))
						) {
							let ver = hints.platformVersion ? hints.platformVersion.split('.')[0] : '';
							if (!ver) {
								const match = ua.match(/Android (\d+(\.\d+)?)/i);
								if (match) ver = match[1];
							}
							const isTablet = (hasTouch && !/Mobile/i.test(ua)) || /Tablet/i.test(ua);
							const model = hints.model || '';
							osEl.textContent = buildOSDisplay('Android', ver, 'ARM64');
							osEl.title = model 
								? (model.startsWith('SM-') ? `Samsung Device: ${model}` : `Device: ${model}`)
								: (isTablet ? 'Android Tablet' : 'Android Mobile');
						} else if (hints.platform === 'Linux' && !isMobileARM && !hasTouch) {
							const arch = hints.architecture?.includes('64') || hints.bitness === '64' ? 'x86_64' : (hints.architecture || 'x86_64');
							osEl.textContent = buildOSDisplay('GNU/Linux', '', arch);
							osEl.title = 'Linux Workstation';
						} else if (hints.platform === 'macOS') {
							const isAppleSilicon = /Apple/i.test(gpuString) || hints.architecture === 'arm';
							osEl.textContent = buildOSDisplay('macOS', '', isAppleSilicon ? 'ARM64' : 'x86_64');
							osEl.title = isAppleSilicon ? 'Apple Silicon' : 'Intel Mac';
						}
					})
					.catch(() => {});
			}
		}

		// 3. Processor Concurrency
		if (cpuEl) {
			const cores = navigator.hardwareConcurrency;
			cpuEl.textContent = cores ? `${cores} Logical CPU Cores` : 'Multi-core Processor';
			cpuEl.title = 'Total logical CPU threads available.';
		}

		// 4. System Memory
		if (ramEl) {
			const mem = (navigator as any).deviceMemory;
			if (mem) {
				ramEl.textContent = `${mem} GB RAM`;
				ramEl.title = 'Approximate device memory capacity via Device Memory API.';
			} else {
				ramEl.textContent = '64-bit Architecture';
				ramEl.title = 'Device memory capacity not exposed by browser (privacy protection).';
			}
		}

		// 5. Display & Scaling (Dynamic Multi-Monitor & DPI Scaling Aware)
		let lastScreenWidth = window.screen.width;
		let lastScreenHeight = window.screen.height;
		let lastDPR = window.devicePixelRatio;

		const updateDisplayMetrics = () => {
			if (!displayEl) return;
			const dprVal = window.devicePixelRatio ? Number(window.devicePixelRatio.toFixed(2)) : null;
			const dpr = dprVal ? ` @ ${dprVal}x scaling` : '';
			const depth = window.screen.colorDepth ? ` (${window.screen.colorDepth}-bit color)` : '';
			const isExtended = (window.screen as any).isExtended;
			displayEl.textContent = `${window.screen.width} × ${window.screen.height}${dpr}${depth}`;
			displayEl.title = isExtended
				? 'Active screen resolution and scaling. Multi-monitor extended desktop detected.'
				: 'Active screen resolution and scaling.';

			// If screen geometry or scaling shifted (e.g. window dragged across displays)
			if (
				window.screen.width !== lastScreenWidth ||
				window.screen.height !== lastScreenHeight ||
				window.devicePixelRatio !== lastDPR
			) {
				lastScreenWidth = window.screen.width;
				lastScreenHeight = window.screen.height;
				lastDPR = window.devicePixelRatio;
				if (typeof retestRefresh === 'function') {
					retestRefresh();
				}
			}
		};

		// 8. Panel Refresh & Gamut (VRR, LTPO, HDR10 & Video-plane aware)
		function getGamutAndHDR() {
			const isP3 = window.matchMedia('(color-gamut: p3)').matches;
			const isRec2020 = window.matchMedia('(color-gamut: rec2020)').matches;
			const isHDR = window.matchMedia('(dynamic-range: high)').matches;
			const isVideoHDR = window.matchMedia('(video-dynamic-range: high)').matches;
			const gamut = isRec2020 ? 'Rec.2020' : (isP3 ? 'Display P3' : 'sRGB');
			const hdrTag = (isHDR || isVideoHDR) ? 'HDR' : 'SDR';
			return { gamut, hdrTag };
		}

		let retestRefresh: () => void = () => {};

		if (refreshEl) {
			let baselineHz = 0;
			let peakHz = 0;
			let isAdaptiveVRR = false;
			let isProbing = false;

			const STANDARD_RATES = [60, 75, 90, 100, 120, 144, 165, 180, 200, 240, 280, 360, 480, 500, 540];

			function updateDisplay() {
				if (!refreshEl) return;
				const displayHz = peakHz || baselineHz || 60;
				const vrrTag = (displayHz > 60 || isAdaptiveVRR) ? ' (Adaptive VRR)' : '';
				const { gamut, hdrTag } = getGamutAndHDR();
				refreshEl.textContent = `${displayHz} Hz${vrrTag} • ${gamut} • ${hdrTag}`;
			}

			// Multi-rate clustering classifier: detects standard frequency buckets and identifies VRR
			function processDeltas(deltas: number[]) {
				const valid = deltas.filter(d => d >= 1.6 && d <= 45);
				if (valid.length < 4) return;

				const bucketCounts: Record<number, number> = {};
				for (const std of STANDARD_RATES) bucketCounts[std] = 0;

				for (const d of valid) {
					const instHz = 1000 / d;
					for (const std of STANDARD_RATES) {
						const nominal = 1000 / std;
						const tol = nominal * 0.12; // 12% VSYNC jitter tolerance window
						if (Math.abs(d - nominal) <= tol || Math.abs(instHz - std) <= 5) {
							bucketCounts[std]++;
							break;
						}
					}
				}

				// Find detected frequencies with at least 3 valid frames
				const detectedRates: number[] = [];
				for (const std of STANDARD_RATES) {
					if (bucketCounts[std] >= 3) {
						detectedRates.push(std);
					}
				}

				if (detectedRates.length === 0) {
					// Fallback to median
					const sorted = [...valid].sort((a, b) => a - b);
					const median = sorted[Math.floor(sorted.length / 2)];
					let measured = Math.round(1000 / median);
					for (const std of STANDARD_RATES) {
						if (Math.abs(measured - std) <= 4) {
							measured = std;
							break;
						}
					}
					detectedRates.push(measured);
				}

				const maxRate = Math.max(...detectedRates);

				if (!baselineHz) {
					baselineHz = detectedRates[0] || 60;
				}

				if (maxRate > peakHz) {
					peakHz = maxRate;
				}

				// Variable Refresh Rate (VRR / LTPO) Detection:
				// If multiple distinct rates observed (e.g. 60Hz and 120Hz),
				// or if peak rate exceeds baseline, or if peak rate > 60Hz:
				if (
					(detectedRates.length > 1 && detectedRates.some(r => r > 60) && detectedRates.some(r => r <= 60)) ||
					(peakHz > baselineHz && baselineHz <= 60) ||
					peakHz > 60
				) {
					isAdaptiveVRR = true;
				}

				updateDisplay();
			}

			// 1. Active Compositor Stimulus Burst
			// Draws micro-subpixel frames to a detached canvas to guarantee the browser compositor
			// submits damaged frame buffers down to Android SurfaceFlinger/Choreographer.
			function measureRefreshBurst(targetSamples: number = 40) {
				if (isProbing) return;
				isProbing = true;
				const frameTimes: number[] = [];
				let lastFrame = performance.now();
				let frames = 0;

				let probeCanvas: HTMLCanvasElement | null = null;
				let probeCtx: CanvasRenderingContext2D | null = null;
				try {
					probeCanvas = document.createElement('canvas');
					probeCanvas.width = 2;
					probeCanvas.height = 2;
					probeCanvas.style.cssText = 'position:fixed;top:-999px;left:-999px;opacity:0.001;pointer-events:none;';
					document.body.appendChild(probeCanvas);
					probeCtx = probeCanvas.getContext('2d');
				} catch (_) {}

				function onFrame(now: number) {
					const delta = now - lastFrame;
					lastFrame = now;
					if (delta >= 1.6 && delta <= 50) frameTimes.push(delta);
					frames++;

					if (probeCtx) {
						probeCtx.fillStyle = frames % 2 === 0 ? '#fff' : '#000';
						probeCtx.fillRect(0, 0, 2, 2);
					}

					if (frames < targetSamples) {
						requestAnimationFrame(onFrame);
					} else {
						isProbing = false;
						if (probeCanvas) {
							try { probeCanvas.remove(); } catch (_) {}
						}
						// Discard first 3 frames for warm-up
						const clean = frameTimes.length > 6 ? frameTimes.slice(3) : frameTimes;
						processDeltas(clean);
					}
				}
				requestAnimationFrame(onFrame);
			}

			// 2. Dedicated Worker Probe via OffscreenCanvas
			// Runs on an independent compositor frame clock (DedicatedWorkerGlobalScope)
			// which is unthrottled by mobile main-thread power gating.
			function probeWorkerRefresh() {
				if (
					typeof Worker === 'undefined' ||
					typeof HTMLCanvasElement === 'undefined' ||
					!HTMLCanvasElement.prototype.transferControlToOffscreen
				) {
					return;
				}

				try {
					const workerCanvas = document.createElement('canvas');
					workerCanvas.width = 2;
					workerCanvas.height = 2;
					workerCanvas.style.cssText = 'position:fixed;top:-999px;left:-999px;opacity:0.001;pointer-events:none;';
					document.body.appendChild(workerCanvas);
					const offscreen = workerCanvas.transferControlToOffscreen();

					const workerBlob = new Blob([`
						self.onmessage = function(e) {
							const canvas = e.data.canvas;
							const ctx = canvas.getContext('2d');
							let frames = 0;
							let last = performance.now();
							const deltas = [];
							function step(now) {
								const delta = now - last;
								last = now;
								if (delta >= 1.6 && delta <= 50) deltas.push(delta);
								if (ctx) {
									ctx.fillStyle = frames % 2 === 0 ? '#fff' : '#000';
									ctx.fillRect(0, 0, 2, 2);
								}
								if (++frames < 30) {
									requestAnimationFrame(step);
								} else {
									self.postMessage(deltas);
								}
							}
							requestAnimationFrame(step);
						};
					`], { type: 'application/javascript' });

					const workerUrl = URL.createObjectURL(workerBlob);
					const worker = new Worker(workerUrl);

					const cleanup = () => {
						try { worker.terminate(); } catch (_) {}
						try { URL.revokeObjectURL(workerUrl); } catch (_) {}
						try { workerCanvas.remove(); } catch (_) {}
					};

					worker.onmessage = function(e) {
						if (Array.isArray(e.data) && e.data.length >= 8) {
							processDeltas(e.data.slice(2));
						}
						cleanup();
					};

					worker.onerror = cleanup;
					worker.postMessage({ canvas: offscreen }, [offscreen]);
				} catch (_) {}
			}

			// 3. Real-Time Low-Latency Interaction Observer
			// Catches Android Choreographer Touch Boost the instant touch/gesture occurs
			let activeSamplingUntil = 0;
			let interactionRafId: number | null = null;
			let lastInteractionTime = performance.now();
			const rollingInteractionDeltas: number[] = [];

			function onInteractionDetected() {
				activeSamplingUntil = performance.now() + 1500; // Sample for 1.5s following touch/gesture
				if (interactionRafId !== null) return;
				lastInteractionTime = performance.now();

				function interactionLoop(now: number) {
					const delta = now - lastInteractionTime;
					lastInteractionTime = now;

					if (delta >= 1.6 && delta <= 50) {
						rollingInteractionDeltas.push(delta);
						if (rollingInteractionDeltas.length > 50) {
							rollingInteractionDeltas.shift();
						}
						// Process rolling window every 6 frames
						if (rollingInteractionDeltas.length >= 6 && rollingInteractionDeltas.length % 6 === 0) {
							processDeltas(rollingInteractionDeltas);
						}
					}

					if (performance.now() < activeSamplingUntil) {
						interactionRafId = requestAnimationFrame(interactionLoop);
					} else {
						if (rollingInteractionDeltas.length >= 4) {
							processDeltas(rollingInteractionDeltas);
						}
						interactionRafId = null;
					}
				}
				interactionRafId = requestAnimationFrame(interactionLoop);
			}

			const INTERACTION_EVENTS = ['touchstart', 'touchmove', 'pointerdown', 'pointermove', 'scroll', 'wheel'];
			INTERACTION_EVENTS.forEach((evt) => {
				window.addEventListener(evt, onInteractionDetected, { passive: true });
			});

			retestRefresh = () => {
				// Re-probe without artificially destroying verified peak hardware capability
				measureRefreshBurst(45);
				probeWorkerRefresh();
				onInteractionDetected();
			};

			// Initial dual probe on page load
			measureRefreshBurst(40);
			probeWorkerRefresh();

			refreshEl.style.cursor = 'pointer';
			refreshEl.title = 'Click or touch to re-test display refresh rate. Detects high-refresh G-Sync/FreeSync/ProMotion panels and dynamic VRR/LTPO scaling.';
			refreshEl.addEventListener('click', () => {
				retestRefresh();
			});
		}

		// Initial display & scaling calculation
		updateDisplayMetrics();

		// Listen for DPI scaling changes via resolution media query
		let dprMediaQuery: MediaQueryList | null = null;
		const watchDprChange = () => {
			if (dprMediaQuery) {
				try { dprMediaQuery.removeEventListener('change', onDprChange); } catch (_) {}
			}
			if (typeof window.matchMedia === 'function') {
				dprMediaQuery = window.matchMedia(`(resolution: ${window.devicePixelRatio}dppx)`);
				if (dprMediaQuery && dprMediaQuery.addEventListener) {
					dprMediaQuery.addEventListener('change', onDprChange, { once: true });
				}
			}
		};
		const onDprChange = () => {
			updateDisplayMetrics();
			watchDprChange();
		};
		watchDprChange();

		// 9. Screen Orientation & Hardware Angle
		if (orientEl) {
			const updateOrient = () => {
				if (screen.orientation) {
					const angle = screen.orientation.angle || 0;
					const rawType = screen.orientation.type || '';
					const isPortraitCurrent = rawType.startsWith('portrait') || (window.innerHeight > window.innerWidth);
					const currentMode = isPortraitCurrent ? 'Portrait' : 'Landscape';

					// Determine hardware panel's native orientation from type and rotation angle
					let nativeMode = 'Landscape';
					if (rawType.includes('primary')) {
						nativeMode = rawType.startsWith('portrait') ? 'Portrait' : 'Landscape';
					} else if (rawType.includes('secondary')) {
						if (angle === 90 || angle === 270) {
							nativeMode = rawType.startsWith('portrait') ? 'Landscape' : 'Portrait';
						} else {
							nativeMode = rawType.startsWith('portrait') ? 'Portrait' : 'Landscape';
						}
					}

					let label = '';
					if (angle === 0) {
						label = `${currentMode} (0° Native)`;
					} else if (angle === 180) {
						label = `Inverted ${currentMode} (180°)`;
					} else {
						label = `${currentMode} (${angle}° Rotated)`;
					}

					orientEl.textContent = label;
					orientEl.title = `Current: ${currentMode} • Default: ${nativeMode} (${angle}° rotation).`;
				} else {
					const isLand = window.innerWidth >= window.innerHeight;
					const mode = isLand ? 'Landscape' : 'Portrait';
					orientEl.textContent = `${mode} (Viewport)`;
					orientEl.title = `Display orientation: ${mode}.`;
				}
			};
			updateOrient();
			if (screen.orientation && screen.orientation.addEventListener) {
				screen.orientation.addEventListener('change', () => {
					updateOrient();
					updateDisplayMetrics();
				});
			}
			window.addEventListener('resize', () => {
				updateOrient();
				updateDisplayMetrics();
			}, { passive: true });
		}

		// 10. Hardware Touch Digitizer
		if (touchEl) {
			const points = navigator.maxTouchPoints || 0;
			if (points > 0) {
				touchEl.textContent = `${points}-Point Multitouch`;
				touchEl.title = `${points}-point hardware multitouch digitizer.`;
			} else {
				touchEl.textContent = 'Precision Mouse (No Touch)';
				touchEl.title = 'No touch digitizer detected (desktop mouse or trackpad pointer input).';
			}
		}

		// 11. Audio Pipeline Latency
		if (audioEl) {
			try {
				const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
				if (AudioCtx) {
					const actx = new AudioCtx();
					const baseLatMs = ((actx.baseLatency || 0.005) * 1000).toFixed(1);
					const outLatMs = (actx as any).outputLatency ? (((actx as any).outputLatency) * 1000).toFixed(1) : null;
					const rateKhz = (actx.sampleRate / 1000).toFixed(0);
					
					if (outLatMs) {
						audioEl.textContent = `${baseLatMs} ms buffer (${outLatMs} ms sink) • ${rateKhz} kHz`;
					} else {
						audioEl.textContent = `${baseLatMs} ms buffer • ${rateKhz} kHz`;
					}
					audioEl.title = `Audio pipeline latency: ${baseLatMs} ms buffer • Sample rate: ${rateKhz} kHz`;
					actx.close();
				} else {
					audioEl.textContent = 'Hardware Audio Output';
				}
			} catch (_) {
				audioEl.textContent = 'Hardware Audio Output';
			}
		}

		// 10. Hardware Video Decoder (MediaCapabilities powerEfficient & WebCodecs prefer-hardware)
		if (codecsEl) {
			const probeCodecs = async () => {
				const candidates = [
					{
						name: 'AV1',
						codec: 'av01.0.08M.10',
						configs: [
							{ type: 'file', video: { contentType: 'video/mp4; codecs="av01.0.08M.10"', width: 1920, height: 1080, bitrate: 5000000, framerate: 60 } },
							{ type: 'file', video: { contentType: 'video/webm; codecs="av01.0.08M.10"', width: 1920, height: 1080, bitrate: 5000000, framerate: 60 } }
						]
					},
					{
						name: 'HEVC',
						codec: 'hvc1.1.6.L93.B0',
						configs: [
							{ type: 'file', video: { contentType: 'video/mp4; codecs="hvc1.1.6.L93.B0"', width: 1920, height: 1080, bitrate: 5000000, framerate: 60 } },
							{ type: 'file', video: { contentType: 'video/mp4; codecs="hev1.1.6.L93.B0"', width: 1920, height: 1080, bitrate: 5000000, framerate: 60 } }
						]
					},
					{
						name: 'VP9',
						codec: 'vp09.00.10.08',
						configs: [
							{ type: 'file', video: { contentType: 'video/webm; codecs="vp09.00.10.08"', width: 1920, height: 1080, bitrate: 5000000, framerate: 60 } },
							{ type: 'file', video: { contentType: 'video/mp4; codecs="vp09.00.10.08"', width: 1920, height: 1080, bitrate: 5000000, framerate: 60 } }
						]
					},
					{
						name: 'H.264',
						codec: 'avc1.640028',
						configs: [
							{ type: 'file', video: { contentType: 'video/mp4; codecs="avc1.640028"', width: 1920, height: 1080, bitrate: 5000000, framerate: 60 } }
						]
					}
				];

				const supported: string[] = [];

				for (const c of candidates) {
					let isHw = false;
					let hasExplicitSwOnly = false;

					// 1. Probe MediaCapabilities for powerEfficient (hardware-accelerated) decoding
					if (navigator.mediaCapabilities && navigator.mediaCapabilities.decodingInfo) {
						for (const cfg of c.configs) {
							try {
								const res = await navigator.mediaCapabilities.decodingInfo(cfg as any);
								if (res.supported) {
									if (res.powerEfficient) {
										isHw = true;
										hasExplicitSwOnly = false;
										break;
									} else {
										// Supported strictly via software/CPU decoding (e.g. dav1d for AV1 on Turing GPUs)
										hasExplicitSwOnly = true;
									}
								}
							} catch (_) {}
						}
					}

					// 2. Cross-verify or fallback to WebCodecs VideoDecoder with prefer-hardware
					if (typeof VideoDecoder !== 'undefined' && typeof VideoDecoder.isConfigSupported === 'function') {
						try {
							const wcRes = await VideoDecoder.isConfigSupported({
								codec: c.codec,
								codedWidth: 1920,
								codedHeight: 1080,
								hardwareAcceleration: 'prefer-hardware'
							});
							if (wcRes) {
								if (wcRes.supported === false) {
									// WebCodecs explicitly confirms no hardware decoder is available
									isHw = false;
								} else if (wcRes.supported === true && !hasExplicitSwOnly) {
									isHw = true;
								}
							}
						} catch (_) {}
					}

					if (isHw && !hasExplicitSwOnly) {
						supported.push(c.name);
					}
				}

				if (supported.length > 0) {
					codecsEl.textContent = supported.join(' • ');
					codecsEl.title = 'Hardware-accelerated video decoding support.';
				} else {
					codecsEl.textContent = 'Software / CPU Decoding';
					codecsEl.title = 'Hardware video decoding not supported.';
				}
			};
			probeCodecs();
		}

		// 11. Hardware Video Encoder (MediaCapabilities powerEfficient & WebCodecs prefer-hardware)
		if (encoderEl) {
			const probeEncoder = async () => {
				const encCandidates = [
					{
						name: 'AV1',
						codecs: ['av01.0.08M.10', 'av01.0.05M.08'],
						mcConfigs: [
							{ type: 'record', video: { contentType: 'video/mp4; codecs="av01.0.08M.10"', width: 1920, height: 1080, bitrate: 5000000, framerate: 60 } },
							{ type: 'record', video: { contentType: 'video/webm; codecs="av01.0.08M.10"', width: 1920, height: 1080, bitrate: 5000000, framerate: 60 } }
						]
					},
					{
						name: 'HEVC',
						codecs: ['hvc1.1.6.L93.B0', 'hev1.1.6.L93.B0'],
						mcConfigs: [
							{ type: 'record', video: { contentType: 'video/mp4; codecs="hvc1.1.6.L93.B0"', width: 1920, height: 1080, bitrate: 5000000, framerate: 60 } },
							{ type: 'record', video: { contentType: 'video/mp4; codecs="hev1.1.6.L93.B0"', width: 1920, height: 1080, bitrate: 5000000, framerate: 60 } }
						]
					},
					{
						name: 'VP9',
						codecs: ['vp09.00.10.08'],
						mcConfigs: [
							{ type: 'record', video: { contentType: 'video/webm; codecs="vp09.00.10.08"', width: 1920, height: 1080, bitrate: 5000000, framerate: 60 } },
							{ type: 'record', video: { contentType: 'video/mp4; codecs="vp09.00.10.08"', width: 1920, height: 1080, bitrate: 5000000, framerate: 60 } }
						]
					},
					{
						name: 'H.264',
						codecs: ['avc1.42001f', 'avc1.4d002a', 'avc1.64002a', 'avc1.640028'],
						mcConfigs: [
							{ type: 'record', video: { contentType: 'video/mp4; codecs="avc1.42001f"', width: 1920, height: 1080, bitrate: 5000000, framerate: 60 } },
							{ type: 'record', video: { contentType: 'video/mp4; codecs="avc1.640028"', width: 1920, height: 1080, bitrate: 5000000, framerate: 60 } }
						]
					}
				];
				const supported: string[] = [];

				for (const c of encCandidates) {
					let isHw = false;

					// 1. Probe MediaCapabilities for powerEfficient (hardware-accelerated) encoding
					if (navigator.mediaCapabilities && navigator.mediaCapabilities.encodingInfo) {
						for (const cfg of c.mcConfigs) {
							try {
								const res = await navigator.mediaCapabilities.encodingInfo(cfg as any);
								if (res && res.supported && res.powerEfficient) {
									isHw = true;
									break;
								}
							} catch (_) {}
						}
					}

					// 2. Cross-verify or fallback to WebCodecs VideoEncoder with prefer-hardware
					if (!isHw && typeof VideoEncoder !== 'undefined' && typeof VideoEncoder.isConfigSupported === 'function') {
						for (const codec of c.codecs) {
							try {
								const res = await VideoEncoder.isConfigSupported({
									codec: codec,
									width: 1920,
									height: 1080,
									bitrate: 5000000,
									framerate: 60,
									hardwareAcceleration: 'prefer-hardware'
								});
								if (res && res.supported === true) {
									isHw = true;
									break;
								}
							} catch (_) {}
						}
					}

					if (isHw) {
						supported.push(c.name);
					}
				}

				if (supported.length > 0) {
					encoderEl.textContent = supported.join(' • ');
					encoderEl.title = 'Hardware-accelerated video encoding support.';
				} else {
					encoderEl.textContent = 'Software / CPU Encoding';
					encoderEl.title = 'Hardware video encoding not supported.';
				}
			};
			probeEncoder();
		}

		// 12. Hardware DRM Key System (EME)
		if (drmEl) {
			const probeDRM = async () => {
				if (navigator.requestMediaKeySystemAccess) {
					const drmCandidates = [
						{
							id: 'com.widevine.alpha',
							name: 'Widevine',
							config: [{
								initDataTypes: ['cenc'],
								videoCapabilities: [{ contentType: 'video/mp4; codecs="avc1.42E01E"' }]
							}],
							hwConfig: [{
								initDataTypes: ['cenc'],
								videoCapabilities: [{ contentType: 'video/mp4; codecs="avc1.42E01E"', robustness: 'HW_SECURE_ALL' }]
							}]
						},
						{
							id: 'com.microsoft.playready.recommendation',
							name: 'PlayReady (Hardware)',
							config: [{
								initDataTypes: ['cenc'],
								videoCapabilities: [{ contentType: 'video/mp4; codecs="avc1.42E01E"' }]
							}]
						},
						{
							id: 'com.microsoft.playready',
							name: 'PlayReady',
							config: [{
								initDataTypes: ['cenc'],
								videoCapabilities: [{ contentType: 'video/mp4; codecs="avc1.42E01E"' }]
							}]
						},
						{
							id: 'com.apple.fps',
							name: 'FairPlay',
							config: [{
								initDataTypes: ['cenc', 'sinf', 'skd'],
								videoCapabilities: [{ contentType: 'video/mp4; codecs="avc1.42E01E"' }]
							}]
						},
						{
							id: 'com.apple.fps.1_0',
							name: 'FairPlay',
							config: [{
								initDataTypes: ['cenc', 'sinf', 'skd'],
								videoCapabilities: [{ contentType: 'video/mp4; codecs="avc1.42E01E"' }]
							}]
						}
					];

					const found: string[] = [];
					for (const item of drmCandidates) {
						if (item.id === 'com.microsoft.playready' && found.some(f => f.includes('PlayReady'))) continue;
						if (item.id === 'com.apple.fps.1_0' && found.some(f => f.includes('FairPlay'))) continue;
						try {
							await navigator.requestMediaKeySystemAccess(item.id, item.config as any);
							if (item.id === 'com.widevine.alpha' && item.hwConfig) {
								try {
									await navigator.requestMediaKeySystemAccess(item.id, item.hwConfig as any);
									found.push('Widevine L1 (Hardware TrustZone)');
								} catch {
									found.push('Widevine L3 (Software CDM)');
								}
							} else {
								found.push(item.name);
							}
						} catch (_) {}
					}

					if (found.length > 0) {
						drmEl.textContent = found.join(' • ');
						drmEl.title = `Active DRM: ${found.join(', ')}`;
					} else {
						drmEl.textContent = 'Standard / Open Media';
						drmEl.title = 'No DRM key system detected.';
					}
				} else {
					drmEl.textContent = 'Not Supported';
				}
			};
			probeDRM();
		}

		// 15. Cloudflare Edge Ephemeral Detection & Dual-Stack IP
		try {
			const res = await fetch('/api/visitor-info', { cache: 'no-store' });
			if (res.ok) {
				const data = await res.json();
				const edgeIp = (data.ip || '').trim();
				if (edgeIp.includes(':')) {
					currentIpv6 = edgeIp;
				} else if (edgeIp) {
					currentIpv4 = edgeIp;
				}
				renderIpDisplay();

				// Probe dual-stack complement via Cloudflare icanhazip (CORS enabled)
				if (!currentIpv4 || currentIpv4.includes('Localhost')) {
					fetch('https://ipv4.icanhazip.com', { signal: AbortSignal.timeout(3000) })
						.then((r) => r.text())
						.then((t) => {
							const ip = t.trim();
							if (ip && !ip.includes(':')) {
								currentIpv4 = ip;
								renderIpDisplay();
							}
						})
						.catch(() => {
							if (!currentIpv4) {
								currentIpv4 = 'Unavailable';
								renderIpDisplay();
							}
						});
				}

				if (!currentIpv6) {
					fetch('https://ipv6.icanhazip.com', { signal: AbortSignal.timeout(3000) })
						.then((r) => r.text())
						.then((t) => {
							const ip = t.trim();
							if (ip && ip.includes(':')) {
								currentIpv6 = ip;
							} else {
								currentIpv6 = 'none';
							}
							renderIpDisplay();
						})
						.catch(() => {
							currentIpv6 = 'none';
							renderIpDisplay();
						});
				}

				const locParts = [data.city, data.region, data.country].filter(Boolean);
				const locString = locParts.length > 0 ? locParts.join(', ') : 'Location unavailable';
				if (locEl) {
					locEl.textContent = locString;
					locEl.title = 'Approximate geolocation based on client IP.';
				}

				const lat = parseFloat(data.latitude);
				const lon = parseFloat(data.longitude);
				if (!isNaN(lat) && !isNaN(lon) && (lat !== 0 || lon !== 0)) {
					if (openMapBtn) {
						openMapBtn.classList.remove('hidden');
						openMapBtn.title = `View ${locString} on interactive OpenStreetMap`;
						openMapBtn.onclick = (e) => {
							e.stopPropagation();
							openMapApplet(lat, lon, locString);
						};
					}
					if (locEl) {
						locEl.classList.add('loc-clickable');
						locEl.title = 'Approximate geolocation. Click to view on OpenStreetMap.';
						locEl.onclick = () => openMapApplet(lat, lon, locString);
					}
				} else {
					if (openMapBtn) openMapBtn.classList.add('hidden');
				}

				if (edgeEl) {
					const coloCode = (data.coloCode || (data.colo ? data.colo.split(' ')[0] : '')).toUpperCase();
					const coloCity = coloCode && COLO_NAMES[coloCode];
					if (coloCity) {
						edgeEl.textContent = `${coloCode} (${coloCity})`;
					} else if (data.colo) {
						edgeEl.textContent = data.colo;
					} else {
						edgeEl.textContent = 'Cloudflare Anycast Edge';
					}
					edgeEl.title = 'Cloudflare Anycast edge datacenter.';
				}

				if (ispEl) {
					const asn = data.asn ? `AS${data.asn}` : '';
					const isp = data.isp ? `${data.isp}` : 'Broadband Provider';
					ispEl.textContent = asn ? `${isp} (${asn})` : isp;
				}
			} else {
				throw new Error('Edge endpoint responded with non-200');
			}
		} catch (err) {
			currentIpv4 = '127.0.0.1 (Local Edge)';
			currentIpv6 = 'none';
			renderIpDisplay();
			if (locEl) locEl.textContent = 'Direct Connection';
			if (edgeEl) edgeEl.textContent = 'Localhost (Dev Edge)';
			if (ispEl) ispEl.textContent = 'Cloudflare Protected';
		}
	}

	window.addEventListener('keydown', (e) => {
		const modal = document.getElementById('map-applet-modal');
		if (modal && !modal.classList.contains('hidden') && (e.key === 'Escape' || e.key === 'Esc')) {
			e.stopPropagation();
			modal.classList.add('hidden');
			modal.setAttribute('aria-hidden', 'true');
			document.body.style.overflow = '';
		}
	});

	initTelemetry();
	document.addEventListener('astro:page-load', initTelemetry);
</script>

