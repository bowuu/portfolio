<script>
	import { initTelemetry, triggerHeavyTelemetryProbes } from '../lib/telemetry';
	import { initCodecStudio } from '../lib/codecStudio';

	function bootDebugAndCodec() {
		initCodecStudio({ onBeforeOpen: triggerHeavyTelemetryProbes });
		if ('requestIdleCallback' in window) {
			(window as any).requestIdleCallback(() => initTelemetry(), { timeout: 2000 });
		} else {
			setTimeout(() => initTelemetry(), 150);
		}
	}

	bootDebugAndCodec();
	document.addEventListener('astro:page-load', bootDebugAndCodec);
</script>

