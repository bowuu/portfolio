---
// Debug.astro - Real-time client-side hardware, runtime & edge telemetry inspector
---

<section class="card telemetry-card" id="debug">
	<div class="telemetry-header">
		<h2 class="card-title">
			<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" class="card-icon">
				<rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
				<line x1="8" y1="21" x2="16" y2="21"/>
				<line x1="12" y1="17" x2="12" y2="21"/>
			</svg>
			Debug
		</h2>
	</div>

	<!-- EXPANDABLE PRIVACY & TELEMETRY NOTICE -->
	<details class="privacy-details">
		<summary class="privacy-summary">
			<div class="privacy-summary-left">
				<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" class="privacy-icon">
					<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
					<path d="m9 12 2 2 4-4"/>
				</svg>
				<span class="privacy-title">Client-Side Privacy Notice</span>
				<span class="privacy-tag">▪ Zero device data logged</span>
			</div>
			<span class="privacy-toggle">
				<span class="privacy-toggle-label">Details</span>
				<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" class="privacy-chevron">
					<polyline points="6 9 12 15 18 9"/>
				</svg>
			</span>
		</summary>
		<div class="privacy-body">
			<p>
				<strong>Network:</strong> Like all websites and content delivery networks, Cloudflare Pages edge infrastructure receives standard HTTP connection metadata (such as your connecting IP address and Anycast routing headers) at the network layer to deliver web assets and protect against DDoS attacks.
			</p>
			<p>
				<strong>Client-Side Evaluation:</strong> The hardware, GPU, CPU, screen, audio, and media metrics below are read ephemerally in your active browser session via standard WebGL, Screen, Audio, and Navigator APIs. <strong>No hardware or browser fingerprinting data is collected, stored, or transmitted to any server or database.</strong>
			</p>
			<p>
				<strong>Visitor Counter:</strong> The footer tally stores only an anonymous aggregate count in Cloudflare D1. To deduplicate visits across tabs and shared networks without tracking individuals, an ephemeral one-way hash combining connection headers with a daily rotating salt is evaluated in volatile memory. <strong>Raw IP addresses and device identifiers are never stored.</strong> Temporary deduplication hashes are purged at UTC midnight rollover, while the total visitor count remains permanent.
			</p>
		</div>
	</details>

	<!-- SUBSECTION 1: NETWORK -->
	<div class="telemetry-group">
		<div class="telemetry-group-header">
			<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
				<circle cx="12" cy="12" r="10"/>
				<line x1="2" y1="12" x2="22" y2="12"/>
				<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
			</svg>
			<span>Network</span>
		</div>
		<div class="telemetry-grid">
			<div class="telemetry-item telemetry-ip-item">
				<span class="t-label">Public IP</span>
				<span id="t-ip" class="sr-only" aria-hidden="true">Detecting...</span>
				<div class="ip-dual-stack">
					<div class="ip-line">
						<span class="ip-tag">IPv4:</span>
						<span id="t-ipv4" class="t-val mono ip-val">Detecting...</span>
					</div>
					<div class="ip-line">
						<span class="ip-tag">IPv6:</span>
						<span id="t-ipv6" class="t-val mono ip-val">Detecting...</span>
					</div>
				</div>
			</div>
			<div class="telemetry-item" id="item-location">
				<div class="t-subhead-pill-wrap">
					<button id="open-map-btn" class="t-subhead-pill-btn" type="button" disabled title="Click to view on interactive OpenStreetMap">
						<span>Location</span>
						<svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon><line x1="8" y1="2" x2="8" y2="18"></line><line x1="16" y1="6" x2="16" y2="22"></line></svg>
					</button>
				</div>
				<span id="t-location" class="t-val">Detecting...</span>
			</div>
			<div class="telemetry-item">
				<span class="t-label">Edge Datacenter</span>
				<span id="t-edge" class="t-val">Detecting...</span>
			</div>
			<div class="telemetry-item">
				<span class="t-label">Network &amp; ISP</span>
				<span id="t-isp" class="t-val">Detecting...</span>
			</div>
		</div>
	</div>

	<!-- SUBSECTION 2: HARDWARE -->
	<div class="telemetry-group">
		<div class="telemetry-group-header">
			<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
				<rect x="4" y="4" width="16" height="16" rx="2"/>
				<rect x="9" y="9" width="6" height="6"/>
				<line x1="9" y1="1" x2="9" y2="4"/>
				<line x1="15" y1="1" x2="15" y2="4"/>
				<line x1="9" y1="20" x2="9" y2="23"/>
				<line x1="15" y1="20" x2="15" y2="23"/>
				<line x1="20" y1="9" x2="23" y2="9"/>
				<line x1="20" y1="14" x2="23" y2="14"/>
				<line x1="1" y1="9" x2="4" y2="9"/>
				<line x1="1" y1="14" x2="4" y2="14"/>
			</svg>
			<span>Hardware</span>
		</div>
		<div class="telemetry-grid">
			<div class="telemetry-item">
				<span class="t-label">Operating System</span>
				<span id="t-os" class="t-val">Detecting...</span>
			</div>
			<div class="telemetry-item">
				<span class="t-label">Processor (CPU)</span>
				<span id="t-cpu" class="t-val">Detecting...</span>
			</div>
			<div class="telemetry-item">
				<span class="t-label">System Memory</span>
				<span id="t-ram" class="t-val">Detecting...</span>
			</div>
			<div class="telemetry-item" id="item-gpu">
				<div class="t-subhead-pill-wrap">
					<button id="open-webgpu-btn" class="t-subhead-pill-btn" type="button" disabled title="View WebGPU compute limits & hardware architecture">
						<span>Graphics (GPU)</span>
						<svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/></svg>
					</button>
				</div>
				<span id="t-gpu" class="t-val">Detecting WebGL...</span>
			</div>
		</div>
	</div>

	<!-- SUBSECTION 3: DISPLAY -->
	<div class="telemetry-group">
		<div class="telemetry-group-header">
			<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
				<rect x="2" y="3" width="20" height="14" rx="2"/>
				<line x1="8" y1="21" x2="16" y2="21"/>
				<line x1="12" y1="17" x2="12" y2="21"/>
			</svg>
			<span>Display</span>
		</div>
		<div class="telemetry-grid">
			<div class="telemetry-item">
				<span class="t-label">Display &amp; Scaling</span>
				<span id="t-display" class="t-val">Detecting...</span>
			</div>
			<div class="telemetry-item" id="item-refresh">
				<span class="t-label">Panel Refresh &amp; Gamut</span>
				<span id="t-refresh" class="t-val loc-clickable">Measuring refresh rate...</span>
			</div>
			<div class="telemetry-item">
				<span class="t-label">Screen Orientation</span>
				<span id="t-orientation" class="t-val">Detecting orientation...</span>
			</div>
			<div class="telemetry-item">
				<span class="t-label">Touch Digitizer</span>
				<span id="t-touch" class="t-val">Probing digitizer...</span>
			</div>
		</div>
	</div>

	<!-- SUBSECTION 4: MEDIA -->
	<div class="telemetry-group">
		<div class="telemetry-group-header">
			<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
				<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
				<path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/>
			</svg>
			<span>Media</span>
		</div>
		<div class="telemetry-grid">
			<div class="telemetry-item">
				<span class="t-label">DAC Pipeline</span>
				<span id="t-audio" class="t-val">Probing DAC sink...</span>
			</div>
			<div class="telemetry-item telemetry-item-clickable" id="item-decoder" role="button" tabindex="0" title="Click to test Hardware Video Decoder in ASIC Codec Studio">
				<div class="t-subhead-pill-wrap">
					<button id="open-decoder-btn" class="t-subhead-pill-btn interactive" type="button" title="Click to test Hardware Video Decoder in ASIC Codec Studio">
						<span>Decoder</span>
						<svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
					</button>
				</div>
				<span id="t-codecs" class="t-val">Probing ASIC decoders...</span>
			</div>
			<div class="telemetry-item telemetry-item-clickable" id="item-encoder" role="button" tabindex="0" title="Click to test Hardware Video Encoder in ASIC Codec Studio">
				<div class="t-subhead-pill-wrap">
					<button id="open-encoder-btn" class="t-subhead-pill-btn interactive" type="button" title="Click to test Hardware Video Encoder in ASIC Codec Studio">
						<span>Encoder</span>
						<svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8" fill="currentColor"/></svg>
					</button>
				</div>
				<span id="t-encoder" class="t-val">Probing WebCodecs ASIC...</span>
			</div>
			<div class="telemetry-item" id="item-drm">
				<span class="t-label">Video DRM System</span>
				<span id="t-drm" class="t-val loc-clickable">Probing CDM modules...</span>
			</div>
		</div>
	</div>

	<!-- INTERACTIVE MAP APPLET (OpenStreetMap) -->
	<div id="map-applet-modal" class="map-applet-modal hidden" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="map-applet-title">
		<div class="map-applet-backdrop" id="map-applet-backdrop"></div>
		<div class="map-applet-dialog" id="map-applet-dialog" data-map-theme="dark">
			<div class="map-applet-header">
				<div class="map-applet-title-wrap">
					<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" class="map-pin-icon">
						<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
						<circle cx="12" cy="10" r="3"></circle>
					</svg>
					<div class="map-applet-heading-row">
						<h3 id="map-applet-title" class="map-applet-title">Edge Geolocation Map</h3>
						<span id="map-coords-badge" class="map-coords-badge mono">--</span>
					</div>
				</div>
				<div class="map-applet-header-actions">
					<div class="map-theme-segmented" role="group" aria-label="Map theme">
						<button id="map-theme-dark-btn" class="map-theme-seg-btn active" type="button" data-theme-val="dark" title="Dark theme map" aria-label="Dark theme map" aria-pressed="true">
							<svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" stroke="none">
								<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
							</svg>
							<span class="seg-label">Dark</span>
						</button>
						<button id="map-theme-light-btn" class="map-theme-seg-btn" type="button" data-theme-val="light" title="Light theme map" aria-label="Light theme map" aria-pressed="false">
							<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="12" cy="12" r="4" fill="currentColor"></circle>
								<line x1="12" y1="1" x2="12" y2="3"></line>
								<line x1="12" y1="21" x2="12" y2="23"></line>
								<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
								<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
								<line x1="1" y1="12" x2="3" y2="12"></line>
								<line x1="21" y1="12" x2="23" y2="12"></line>
								<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
								<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
							</svg>
							<span class="seg-label">Light</span>
						</button>
					</div>
					<button id="map-applet-close-btn" class="map-close-btn" type="button" aria-label="Close Map Applet" title="Close (Esc)">
						<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
							<line x1="18" y1="6" x2="6" y2="18"></line>
							<line x1="6" y1="6" x2="18" y2="18"></line>
						</svg>
					</button>
				</div>
			</div>

			<div class="map-applet-frame-wrap">
				<div id="map-applet-loader" class="map-applet-loader">
					<div class="map-spinner"></div>
					<span>Loading OpenStreetMap...</span>
				</div>
				<iframe
					id="map-applet-iframe"
					class="map-applet-iframe"
					title="OpenStreetMap Location Applet"
					loading="lazy"
					src="about:blank"
				></iframe>
			</div>

			<div class="map-applet-footer">
				<div class="map-footer-info">
					<span id="map-footer-loc" class="map-footer-loc">--</span>
					<span class="map-footer-sep" aria-hidden="true">▪</span>
					<span class="map-footer-note">Approximate OpenStreetMap geolocation</span>
				</div>
				<a id="map-external-link" href="https://www.openstreetmap.org" target="_blank" rel="noopener noreferrer" class="map-ext-link" title="Open full map on openstreetmap.org">
					<span>Open in OSM</span>
					<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
						<polyline points="15 3 21 3 21 9"></polyline>
						<line x1="10" y1="14" x2="21" y2="3"></line>
					</svg>
				</a>
			</div>
		</div>
	</div>

	<!-- WEBGPU SILICON ARCHITECTURE & COMPUTE LIMITS MODAL -->
	<div id="webgpu-applet-modal" class="map-applet-modal hidden" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="webgpu-applet-title">
		<div class="map-applet-backdrop" id="webgpu-applet-backdrop"></div>
		<div class="map-applet-dialog webgpu-dialog" id="webgpu-applet-dialog" data-map-theme="dark">
			<div class="map-applet-header">
				<div class="map-applet-title-wrap">
					<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" class="map-pin-icon">
						<rect x="4" y="4" width="16" height="16" rx="2"/>
						<rect x="9" y="9" width="6" height="6"/>
					</svg>
					<div class="map-applet-heading-row">
						<h3 id="webgpu-applet-title" class="map-applet-title">WebGPU Silicon &amp; Compute Architecture</h3>
					</div>
				</div>
				<div class="map-applet-header-actions">
					<button id="webgpu-applet-close-btn" class="map-close-btn" type="button" aria-label="Close WebGPU Inspector" title="Close (Esc)">
						<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
							<line x1="18" y1="6" x2="6" y2="18"></line>
							<line x1="6" y1="6" x2="18" y2="18"></line>
						</svg>
					</button>
				</div>
			</div>

			<div class="webgpu-body-wrap" id="webgpu-body-wrap">
				<div class="webgpu-specs-grid" id="webgpu-specs-grid">
					<!-- Populated by JS -->
				</div>
			</div>

			<div class="map-applet-footer">
				<div class="map-footer-info">
					<span id="webgpu-footer-vendor" class="map-footer-loc">--</span>
				</div>
			</div>
		</div>
	</div>

	<!-- ASIC VIDEO CODEC STUDIO & HARDWARE BENCHMARK MODAL -->
	<div id="codec-applet-modal" class="map-applet-modal hidden" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="codec-applet-title">
		<div class="map-applet-backdrop" id="codec-applet-backdrop"></div>
		<div class="map-applet-dialog codec-dialog" id="codec-applet-dialog" data-map-theme="dark">
			<div class="map-applet-header">
				<div class="map-applet-title-wrap">
					<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" class="map-pin-icon">
						<polygon points="23 7 16 12 23 17 23 7"></polygon>
						<rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
					</svg>
					<div class="map-applet-heading-row">
						<h3 id="codec-applet-title" class="map-applet-title">ASIC Video Codec Studio</h3>
					</div>
				</div>
				<div class="terminal-wm-btns" aria-label="Window controls">
					<button class="wm-btn wm-min" id="codec-applet-min-btn" type="button" title="Minimize / Close (Esc)" aria-label="Minimize">
						<svg viewBox="0 0 10 10" width="10" height="10"><line x1="1" y1="5" x2="9" y2="5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
					</button>
					<button class="wm-btn wm-max" id="codec-applet-maximize-btn" type="button" title="Full Screen in Browser (Maximize)" aria-label="Full Screen in Browser">
						<svg id="codec-icon-maximize" viewBox="0 0 10 10" width="10" height="10"><rect x="1.5" y="1.5" width="7" height="7" rx="1" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
						<svg id="codec-icon-restore" class="hidden" viewBox="0 0 10 10" width="10" height="10"><rect x="3.5" y="1.5" width="5" height="5" rx="0.8" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M1.5 3.5v5h5" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
					</button>
					<button class="wm-btn wm-close" id="codec-applet-close-btn" type="button" title="Close (exit / Esc)" aria-label="Close">
						<svg viewBox="0 0 10 10" width="10" height="10"><line x1="1.5" y1="1.5" x2="8.5" y2="8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><line x1="8.5" y1="1.5" x2="1.5" y2="8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
					</button>
				</div>
			</div>

			<div class="codec-body-wrap">
				<!-- STUDIO CONTROL RACK (CLEAN 2-ROW GRID) -->
				<div class="codec-rack">
					<!-- ROW 1: PIPELINE, ENGINE & TOP-RIGHT START BUTTON -->
					<div class="codec-rack-row codec-rack-top">
						<div class="codec-rack-controls">
							<div class="codec-rack-group">
								<span class="codec-ctrl-label">Pipeline:</span>
								<div class="codec-segmented" id="pipeline-selector" role="group" aria-label="Pipeline selection">
									<button type="button" class="codec-seg-btn" data-pipeline="decode" title="Decode bitstream directly to canvas (NVDEC/VDU)">Decode</button>
									<button type="button" class="codec-seg-btn" data-pipeline="encode" title="Encode source frames to compressed bitstream">Encode</button>
									<button type="button" class="codec-seg-btn active" data-pipeline="loopback" title="Full loopback: encode source frames then decode back to canvas">Both</button>
								</div>
							</div>

							<div class="codec-rack-group">
								<span class="codec-ctrl-label">Engine:</span>
								<div class="codec-segmented" id="engine-selector" role="group" aria-label="Acceleration mode">
									<button type="button" class="codec-seg-btn" data-mode="prefer-software" title="CPU software transcoding via WebCodecs &amp; WASM">Software</button>
									<button type="button" class="codec-seg-btn active" data-mode="prefer-hardware" title="ASIC media transcoder on chip (dedicated hardware silicon)">Hardware</button>
								</div>
							</div>
						</div>

						<button type="button" id="codec-run-btn" class="codec-run-btn" title="Start video verification test">
							<svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" stroke="none"><polygon points="5 3 19 12 5 21 5 3"/></svg>
							<span id="codec-btn-label">Start</span>
						</button>
					</div>

					<!-- ROW 2: SOURCE, CODEC & QUALITY -->
					<div class="codec-rack-row codec-rack-bottom">
						<div class="codec-rack-group">
							<span class="codec-ctrl-label">Source:</span>
							<div class="codec-segmented" id="scene-selector" role="group" aria-label="Source frame selection">
								<button type="button" class="codec-seg-btn" data-scene="smpte" title="SMPTE BT.709 color calibration &amp; alignment pattern">Test</button>
								<button type="button" class="codec-seg-btn active" data-scene="1080p" title="Blender 'Charge' sci-fi action master (1920×1080)">1080</button>
								<button type="button" class="codec-seg-btn" data-scene="4k" title="Chief Morale Officer (Samoyed) 4K UHD Master (3840×2160)">4K</button>
							</div>
						</div>

						<div class="codec-rack-group">
							<span class="codec-ctrl-label">Codec:</span>
							<div class="codec-segmented" id="codec-selector" role="group" aria-label="Codec selection">
								<button type="button" class="codec-seg-btn active" data-codec="avc" title="AVC / H.264 baseline &amp; high profiles (broad compatibility)">H.264</button>
								<button type="button" class="codec-seg-btn" data-codec="vp9" title="Google VP9 Profile 0 8-bit web video standard">VP9</button>
								<button type="button" class="codec-seg-btn" data-codec="hevc" title="H.265 / HEVC high efficiency video coding (ASIC accelerated)">HEVC</button>
								<button type="button" class="codec-seg-btn" data-codec="av1" title="AOMedia AV1 next-gen royalty-free open codec">AV1</button>
