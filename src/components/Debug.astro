				}
				if (metricEncFps) {
					metricEncFps.innerHTML = `${encFps.toLocaleString()} <span class="webgpu-tile-sub">FPS (${encLatency} ms)</span>`;
				}
				if (metricDecFps) {
					metricDecFps.innerHTML = `${decFps.toLocaleString()} <span class="webgpu-tile-sub">FPS (${decLatency} ms)</span>`;
				}
				if (metricRatio) {
					const inSize = getInputFileSize();
					metricRatio.innerHTML = `${inSize} &rarr; ${displaySize}`;
					metricRatio.title = selectedScene === 'smpte'
						? `Input: Procedural vector canvas (24-frame window, 0 KB network download) → Transcoded output: ${displaySize} (${bitrateMbps} Mbps bitstream at 24 fps). Uncompressed 24-frame YUV 4:2:0 raster in RAM: ${rawMb} MB.`
						: `Input clip size: ${inSize} (testing 24-frame window) → Transcoded output: ${displaySize} (${bitrateMbps} Mbps average bitstream at 24 fps). Uncompressed 24-frame YUV 4:2:0 raster: ${rawMb} MB (${ratioX}:1 reduction).`;
				}

				if (statusText) {
					statusText.textContent = `✓ Verified ${totalFrames} frames in ${(encDuration + decDuration).toFixed(0)}ms ▪ ${encFps.toLocaleString()} FPS enc / ${decFps.toLocaleString()} FPS dec ▪ ${bitrateMbps} Mbps`;
					statusText.style.color = '#22c55e';
				}

				decodedStartFrameLoaded = rangeStartFrame;
				decodedSceneLoaded = selectedScene;
				currentFrameIdx = 0;
				syncTimelineUI(0);
				startPlayback();
			} catch (err: any) {
				if (statusText) {
					statusText.textContent = `Verification Notice: ${err.message || 'Codec profile unsupported'}.`;
					statusText.style.color = '#f97316';
				}
				// If verification didn't produce decoded frames, restore srcVideo so user isn't stuck on frozen canvas
				if (decodedBitmaps.length < TEST_WINDOW_FRAMES && selectedScene !== 'smpte') {
					if (srcCanvas) srcCanvas.classList.add('hidden');
					if (srcVideo) srcVideo.classList.remove('hidden');
				}
			} finally {
				isRunning = false;
				if (runBtn) runBtn.disabled = false;
				const btnLabel = document.getElementById('codec-btn-label');
				if (btnLabel) btnLabel.textContent = 'Start';
			}
		}

		window.addEventListener('keydown', (e) => {
			if (!codecModal || codecModal.classList.contains('hidden')) return;
			if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;

			if (e.code === 'Space') {
				e.preventDefault();
				togglePlayback();
			} else if (e.code === 'ArrowLeft') {
				e.preventDefault();
				stopPlayback();
				seekToFrame(currentFrameIdx - 1);
			} else if (e.code === 'ArrowRight') {
				e.preventDefault();
				stopPlayback();
				seekToFrame(currentFrameIdx + 1);
			}
		});

		if (runBtn) runBtn.onclick = runVerification;
	}

	window.addEventListener('keydown', (e) => {
		const modal = document.getElementById('map-applet-modal');
		const webgpuModal = document.getElementById('webgpu-applet-modal');
		const codecModal = document.getElementById('codec-applet-modal');
		if (e.key === 'Escape' || e.key === 'Esc') {
			if (modal && !modal.classList.contains('hidden')) {
				e.stopPropagation();
				const mapClose = document.getElementById('map-applet-close-btn');
				if (mapClose) mapClose.click();
				else {
					modal.classList.add('hidden');
					modal.setAttribute('aria-hidden', 'true');
					document.body.style.overflow = '';
					(window as any).__popModalHistory?.('map-modal');
				}
			}
			if (webgpuModal && !webgpuModal.classList.contains('hidden')) {
				e.stopPropagation();
				const webgpuClose = document.getElementById('webgpu-applet-close-btn');
				if (webgpuClose) webgpuClose.click();
				else {
					webgpuModal.classList.add('hidden');
					webgpuModal.setAttribute('aria-hidden', 'true');
					document.body.style.overflow = '';
					(window as any).__popModalHistory?.('webgpu-modal');
				}
			}
			if (codecModal && !codecModal.classList.contains('hidden')) {
				e.stopPropagation();
				if (document.fullscreenElement) {
					try {
						if (document.exitFullscreen) {
							document.exitFullscreen();
						} else if ((document as any).webkitExitFullscreen) {
							(document as any).webkitExitFullscreen();
						}
					} catch (_) {}
					return;
				}
				const pinHint = document.getElementById('codec-pin-hint');
				if (pinHint && pinHint.classList.contains('pinned')) {
					pinHint.click();
					return;
				}
				if (codecModal.classList.contains('is-maximized')) {
					codecModal.classList.remove('is-maximized');
					const iconMax = document.getElementById('codec-icon-maximize');
					const iconRestore = document.getElementById('codec-icon-restore');
					if (iconMax && iconRestore) {
						iconMax.classList.remove('hidden');
						iconRestore.classList.add('hidden');
					}
					const maxBtn = document.getElementById('codec-applet-maximize-btn');
					if (maxBtn) {
						maxBtn.setAttribute('title', 'Full Screen in Browser (Maximize)');
						maxBtn.setAttribute('aria-label', 'Full Screen in Browser');
					}
					return;
				}
				const codecClose = document.getElementById('codec-applet-close-btn');
				if (codecClose) {
					codecClose.click();
				} else {
					codecModal.classList.add('hidden');
					codecModal.setAttribute('aria-hidden', 'true');
					document.body.style.overflow = '';
					const loupeSrc = document.getElementById('codec-loupe-src');
					const loupeDec = document.getElementById('codec-loupe-dec');
					if (loupeSrc) loupeSrc.classList.add('hidden');
					if (loupeDec) loupeDec.classList.add('hidden');
				}
			}
		}
	});

	function scheduleTelemetry() {
		if ('requestIdleCallback' in window) {
			(window as any).requestIdleCallback(() => initTelemetry(), { timeout: 2000 });
		} else {
			setTimeout(initTelemetry, 250);
		}
	}

	scheduleTelemetry();
	document.addEventListener('astro:page-load', scheduleTelemetry);
</script>

