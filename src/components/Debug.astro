						.catch(() => {
							if (!currentIpv4) {
								currentIpv4 = 'Unavailable';
								renderIpDisplay();
							}
						});
				}

				if (!currentIpv6) {
					fetch('https://ipv6.icanhazip.com', { signal: AbortSignal.timeout(3000) })
						.then((r) => r.text())
						.then((t) => {
							const ip = t.trim();
							if (ip && ip.includes(':')) {
