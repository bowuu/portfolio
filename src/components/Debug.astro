							} else {
								currentIpv6 = 'none';
							}
							renderIpDisplay();
						})
						.catch(() => {
							currentIpv6 = 'none';
							renderIpDisplay();
						});
				}

				const locParts = [data.city, data.region, data.country].filter(Boolean);
				const locString = locParts.length > 0 ? locParts.join(', ') : 'Location unavailable';
				if (locEl) {
					locEl.textContent = locString;
					locEl.title = 'Approximate geolocation resolved from Cloudflare edge IP headers (no device GPS accessed).';
				}

				const lat = parseFloat(data.latitude);
				const lon = parseFloat(data.longitude);
				if (!isNaN(lat) && !isNaN(lon) && (lat !== 0 || lon !== 0)) {
					if (openMapBtn) {
						openMapBtn.classList.remove('hidden');
						openMapBtn.title = `View ${locString} on interactive OpenStreetMap`;
						openMapBtn.onclick = (e) => {
							e.stopPropagation();
							openMapApplet(lat, lon, locString);
						};
					}
					if (locEl) {
						locEl.classList.add('loc-clickable');
						locEl.title = 'Approximate geolocation resolved from Cloudflare edge IP headers (no device GPS accessed). Click to view on OpenStreetMap.';
						locEl.onclick = () => openMapApplet(lat, lon, locString);
					}
				} else {
					if (openMapBtn) openMapBtn.classList.add('hidden');
				}

				if (edgeEl) {
					const coloCode = (data.coloCode || (data.colo ? data.colo.split(' ')[0] : '')).toUpperCase();
					const coloCity = coloCode && COLO_NAMES[coloCode];
					if (coloCity) {
						edgeEl.textContent = `${coloCode} (${coloCity})`;
					} else if (data.colo) {
						edgeEl.textContent = data.colo;
					} else {
						edgeEl.textContent = 'Cloudflare Anycast Edge';
					}
					edgeEl.title = 'Nearest Cloudflare Anycast point of presence (PoP) terminating the TLS connection (IATA airport code).';
				}

				if (ispEl) {
					const asn = data.asn ? `AS${data.asn}` : '';
					const isp = data.isp ? `${data.isp}` : 'Broadband Provider';
					ispEl.textContent = asn ? `${isp} (${asn})` : isp;
					ispEl.title = 'Autonomous System Number (ASN) and network operator resolved from BGP routing metadata.';
				}
			} else {
				throw new Error('Edge endpoint responded with non-200');
			}
		} catch (err) {
			currentIpv4 = '127.0.0.1 (Local Edge)';
			currentIpv6 = 'none';
			renderIpDisplay();
			if (locEl) locEl.textContent = 'Direct Connection';
			if (edgeEl) edgeEl.textContent = 'Localhost (Dev Edge)';
			if (ispEl) ispEl.textContent = 'Cloudflare Protected';
		}
		// Transport Protocol Detection (HTTP/3 QUIC vs HTTP/2)
		const transportEl = document.getElementById('t-transport');
		if (transportEl) {
			let proto = 'HTTP/2 (Multiplexed TCP)';
			try {
				const navEntries = performance.getEntriesByType('navigation');
				if (navEntries.length > 0) {
					const nav = navEntries[0] as PerformanceNavigationTiming;
					const hop = (nav as any).nextHopProtocol || '';
					if (hop === 'h3' || hop.startsWith('h3-')) {
						proto = 'HTTP/3 (QUIC / UDP 443)';
					} else if (hop === 'h2') {
						proto = 'HTTP/2 (Multiplexed TLS 1.3)';
					} else if (hop === 'http/1.1') {
						proto = 'HTTP/1.1 (TCP)';
					}
				}
			} catch (_) {}
			transportEl.textContent = proto;
			transportEl.title = 'Active page delivery transport protocol reported by PerformanceNavigationTiming.nextHopProtocol.';
		}

		// WebRTC NAT Traversal & STUN RTT
		const natEl = document.getElementById('t-nat');
		if (natEl) {
			if (typeof RTCPeerConnection === 'undefined') {
				natEl.textContent = 'WebRTC Disabled / Blocked';
				natEl.title = 'RTCPeerConnection not supported or blocked by browser.';
			} else {
				const probeNat = async () => {
					try {
						const pc = new RTCPeerConnection({
							iceServers: [
								{ urls: ['stun:stun.cloudflare.com:3478', 'stun:stun.google.com:19302'] }
							]
						});
						pc.createDataChannel('diag');
						const startTime = performance.now();
						let foundSrflx = false;
						let foundHost = false;

						const timeout = setTimeout(() => {
							try { pc.close(); } catch (_) {}
							if (!foundSrflx && !foundHost) {
								natEl.textContent = 'UDP Restricted (Firewall)';
								natEl.title = 'No ICE candidates gathered within timeout; UDP port 3478 may be filtered.';
							}
						}, 3500);

						pc.onicecandidate = (e) => {
							if (e.candidate) {
								const type = e.candidate.type;
								if (type === 'host') foundHost = true;
								if (type === 'srflx' && !foundSrflx) {
									foundSrflx = true;
									const stunLatency = Math.round(performance.now() - startTime);
									clearTimeout(timeout);
									try { pc.close(); } catch (_) {}

									natEl.textContent = `Full Cone NAT • ${stunLatency} ms STUN RTT`;
									natEl.title = `Gathered server reflexive candidate (srflx) via Cloudflare/Google Anycast STUN in ${stunLatency} ms. Direct P2P UDP traversal supported.`;
								}
							} else {
								clearTimeout(timeout);
								try { pc.close(); } catch (_) {}
								if (foundHost && !foundSrflx) {
									natEl.textContent = 'Symmetric NAT / Hardened UDP';
									natEl.title = 'Host candidate gathered, but STUN reflexive mapping was blocked or symmetric.';
								}
							}
						};

						const offer = await pc.createOffer();
						await pc.setLocalDescription(offer);
					} catch (_) {
						natEl.textContent = 'WebRTC Shielded';
						natEl.title = 'WebRTC candidate gathering prevented by browser privacy shield.';
					}
				};
				probeNat();
			}
		}

		// SUBSECTION 5: PRIVACY & SANDBOX
		const gpcEl = document.getElementById('t-gpc');
		if (gpcEl) {
			const isGpc = (navigator as any).globalPrivacyControl === true;
			const isDnt = navigator.doNotTrack === '1' || (window as any).doNotTrack === '1';
			if (isGpc) {
				gpcEl.textContent = 'Active (Sec-GPC: 1)';
				gpcEl.title = 'Global Privacy Control signal is actively asserted to websites (navigator.globalPrivacyControl = true).';
			} else if (isDnt) {
				gpcEl.textContent = 'DNT Active (DNT: 1)';
				gpcEl.title = 'Do Not Track header is actively broadcast (navigator.doNotTrack = 1).';
			} else {
				gpcEl.textContent = 'Default (Standard Headers)';
				gpcEl.title = 'Neither GPC nor DNT signals are asserted by the client.';
			}
		}

		const fpEl = document.getElementById('t-fingerprint');
		if (fpEl) {
			try {
				const testCanvas1 = document.createElement('canvas');
				testCanvas1.width = 32;
				testCanvas1.height = 32;
				const ctx1 = testCanvas1.getContext('2d');
				if (ctx1) {
					ctx1.fillStyle = '#f97316';
					ctx1.fillRect(0, 0, 32, 32);
					ctx1.font = '14px Arial';
					ctx1.fillStyle = '#0f172a';
					ctx1.fillText('brob', 2, 20);
					const data1 = testCanvas1.toDataURL();

					const testCanvas2 = document.createElement('canvas');
					testCanvas2.width = 32;
					testCanvas2.height = 32;
					const ctx2 = testCanvas2.getContext('2d');
					if (ctx2) {
						ctx2.fillStyle = '#f97316';
						ctx2.fillRect(0, 0, 32, 32);
						ctx2.font = '14px Arial';
						ctx2.fillStyle = '#0f172a';
						ctx2.fillText('brob', 2, 20);
						const data2 = testCanvas2.toDataURL();

						if (data1 !== data2) {
							fpEl.textContent = 'Randomized (Anti-FP Noise)';
							fpEl.title = 'Detected canvas fingerprint randomization (Brave Shields or anti-fingerprinting extension actively injects per-render entropy).';
						} else {
							fpEl.textContent = 'Consistent / Deterministic';
							fpEl.title = 'Canvas rendering output is deterministic with zero synthetic noise injection.';
						}
					}
				}
			} catch (_) {
				fpEl.textContent = 'Canvas Readback Blocked';
				fpEl.title = 'Browser security policy blocked canvas pixel readback (toDataURL / getImageData).';
			}
		}

		const storageSandboxEl = document.getElementById('t-storage-sandbox');
		if (storageSandboxEl) {
			const isIsolated = window.crossOriginIsolated === true;
			const hasStorageAccess = typeof document.hasStorageAccess === 'function';
			if (hasStorageAccess) {
				document.hasStorageAccess().then((hasAccess) => {
					if (hasAccess === false) {
						storageSandboxEl.textContent = isIsolated ? 'Partitioned + Isolated' : 'Partitioned (State Isolation)';
						storageSandboxEl.title = 'Third-party storage partitioning (CHIPS / State Partitioning) active.';
					} else {
						storageSandboxEl.textContent = isIsolated ? 'Isolated Origin' : 'Standard Origin Sandbox';
						storageSandboxEl.title = 'Origin-bound storage sandbox without cross-site partition barriers.';
					}
				}).catch(() => {
					storageSandboxEl.textContent = 'Origin Sandbox';
				});
			} else {
				storageSandboxEl.textContent = isIsolated ? 'Isolated Context' : 'Origin Sandbox';
			}
		}

		const adblockEl = document.getElementById('t-adblock');
		if (adblockEl) {
			fetch('https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js', { method: 'HEAD', mode: 'no-cors' })
				.then(() => {
					adblockEl.textContent = 'Standard / Unfiltered';
					adblockEl.title = 'Known advertising/telemetry network hostnames resolved without local client sinkholing.';
				})
				.catch(() => {
					adblockEl.textContent = 'Active (Adblock / DNS Sinkhole)';
					adblockEl.title = 'Known analytics/tracker request was sinkholed locally by an adblock extension (e.g. uBlock Origin, Brave Shield) or network DNS sinkhole (Pi-hole).';
				});
		}
	}

	window.addEventListener('keydown', (e) => {
		const modal = document.getElementById('map-applet-modal');
		const webgpuModal = document.getElementById('webgpu-applet-modal');
		if (e.key === 'Escape' || e.key === 'Esc') {
			if (modal && !modal.classList.contains('hidden')) {
				e.stopPropagation();
				modal.classList.add('hidden');
				modal.setAttribute('aria-hidden', 'true');
				document.body.style.overflow = '';
			}
			if (webgpuModal && !webgpuModal.classList.contains('hidden')) {
				e.stopPropagation();
				webgpuModal.classList.add('hidden');
				webgpuModal.setAttribute('aria-hidden', 'true');
				document.body.style.overflow = '';
			}
		}
	});

	initTelemetry();
	document.addEventListener('astro:page-load', initTelemetry);
</script>

