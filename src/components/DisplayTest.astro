---
// DisplayTest.astro - Display Motion Blur, Pixel Response & Ghosting Benchmark
---

<section class="card section-accordion display-test-card" id="display-lab" data-open="true">
	<div class="card-header-summary">
		<button type="button" class="card-summary-left card-summary-toggle" aria-expanded="true" aria-controls="display-lab-content">
			<span class="card-chevron-btn" aria-hidden="true">
				<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="6 9 12 15 18 9"/></svg>
			</span>
			<h2 class="card-title">
				<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" class="card-icon" aria-hidden="true">
					<rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
					<line x1="8" y1="21" x2="16" y2="21"/>
					<line x1="12" y1="17" x2="12" y2="21"/>
				</svg>
				Display Test
			</h2>
			<span class="section-summary-badge">Motion Blur · Ghosting · VSYNC</span>
		</button>

		<div class="card-summary-right">
			<button id="open-pixel-checker-btn" class="telemetry-btn" type="button" title="Open Fullscreen Dead / Stuck Pixel Checker">
				<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/>
				</svg>
				<span>Pixel Checker</span>
			</button>

			<button id="toggle-display-btn" class="benchmark-btn" type="button" aria-pressed="false" title="Start display motion benchmark" aria-label="Start display motion benchmark">
				<svg id="toggle-display-icon-stop" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" class="play-icon hidden" aria-hidden="true">
					<rect x="5" y="5" width="14" height="14" rx="2"/>
				</svg>
				<svg id="toggle-display-icon-play" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" class="play-icon" aria-hidden="true">
					<polygon points="5 3 19 12 5 21 5 3"/>
				</svg>
				<span id="toggle-display-text">Start</span>
			</button>
		</div>
	</div>

	<div class="section-content" id="display-lab-content">

	<p class="benchmark-desc">
		Inspect monitor pixel response times, sample-and-hold motion blur, overdrive coronas, and test for dead or stuck subpixels.
	</p>

	<!-- MOTION CONTROLS TOOLBAR -->
	<div class="motion-toolbar">
		<div class="segmented-control" role="group" aria-label="Motion Speed">
			<button class="seg-btn" data-speed="240" aria-pressed="false" type="button" title="240 pixels per second">240 px/s</button>
			<button class="seg-btn active" data-speed="480" aria-pressed="true" type="button" title="480 pixels per second (Standard)">480 px/s</button>
			<button class="seg-btn" data-speed="960" aria-pressed="false" type="button" title="960 pixels per second (High Speed)">960 px/s</button>
		</div>

		<div class="segmented-control" role="group" aria-label="Motion Pattern">
			<button class="seg-btn active" data-pattern="chip" aria-pressed="true" type="button" title="Silicon IC Package">Chip</button>
			<button class="seg-btn" data-pattern="bars" aria-pressed="false" type="button" title="Pursuit Bars">Bars</button>
			<button class="seg-btn" data-pattern="checker" aria-pressed="false" type="button" title="Checkerboard">Checker</button>
		</div>

		<div class="segmented-control" role="group" aria-label="Motion Direction">
			<button class="seg-btn" data-direction="left" aria-pressed="false" type="button" title="Move Left">Left</button>
			<button class="seg-btn active" data-direction="right" aria-pressed="true" type="button" title="Move Right">Right</button>
		</div>

		<div class="segmented-control" role="group" aria-label="Motion Trajectory">
			<button class="seg-btn active" data-trajectory="wrap" aria-pressed="true" type="button" title="Continuous pursuit tracking (wrap-around)">Wrap</button>
			<button class="seg-btn" data-trajectory="bounce" aria-pressed="false" type="button" title="Bidirectional rebound (ping-pong)">Bounce</button>
		</div>
	</div>

	<!-- MOTION CANVAS VIEWPORT -->
	<div class="motion-viewport-wrap" id="motion-viewport-wrap">
		<canvas id="motion-canvas" width="960" height="150" class="motion-canvas"></canvas>
	</div>

	<!-- VSYNC & HARDWARE TIMING HUD -->
	<div class="display-telemetry-hud">
		<div class="hud-item">
			<span class="hud-label">Frame Rate</span>
			<div class="hud-val-wrap">
				<span id="display-fps" class="hud-val mono">Stopped</span>
				<span id="display-fps-unit" class="hud-unit hidden">FPS</span>
			</div>
			<span id="display-frame-time" class="hud-sub mono">Motion stopped</span>
		</div>

		<div class="hud-item">
			<span class="hud-label">VSYNC Jitter</span>
			<div class="hud-val-wrap">
				<span id="display-jitter" class="hud-val mono">&plusmn;0.0</span>
				<span class="hud-unit">ms</span>
			</div>
			<span id="display-dropped" class="hud-sub mono">0 dropped frames</span>
		</div>

		<div class="hud-item">
			<span class="hud-label">Dynamic Range</span>
			<div class="hud-val-wrap">
				<span id="display-hdr-tag" class="hud-val">SDR</span>
			</div>
			<span id="display-depth-tag" class="hud-sub">Color Depth</span>
		</div>

		<div class="hud-item" title="Visual check only — track moving edges with your eyes: trailing dark blur indicates slow pixel response (smear); trailing bright/dark halos indicate excessive monitor overdrive overshoot.">
			<span class="hud-label">Overdrive Coronas</span>
			<div class="hud-val-wrap">
				<span id="display-motion-diag" class="hud-val hud-val-text">Visual Check</span>
			</div>
			<span class="hud-sub">Inspect moving edges (no halos = optimal)</span>
		</div>
	</div>

	<!-- PIXEL CHECKER FULLSCREEN MODAL -->
	<div id="pixel-checker-modal" class="pixel-modal hidden" aria-hidden="true" inert role="dialog" aria-modal="true" aria-label="Dead Pixel Checker">
		<div id="pixel-canvas-plane" class="pixel-plane">
			<div id="pixel-shape-1" class="pixel-moving-shape hidden"></div>
			<div id="pixel-shape-2" class="pixel-moving-shape hidden"></div>
		</div>
		<div class="pixel-hud" id="pixel-hud">
			<div id="pixel-mode-menu" class="pixel-mode-menu hidden" role="menu" aria-label="Select Pixel Checker Mode"></div>
			<button id="pixel-hud-pill" class="pixel-hud-pill" type="button" aria-haspopup="true" aria-expanded="false">
				<span id="pixel-color-name">Black (Stuck Pixel Check)</span>
				<span class="hud-sep">▪</span>
				<span class="hud-hint">Click / Space to cycle ▪ Esc to exit</span>
				<svg class="hud-chevron" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5">
					<polyline points="18 15 12 9 6 15"></polyline>
				</svg>
			</button>
			<button id="close-pixel-btn" class="pixel-close-btn" type="button" aria-label="Exit Pixel Checker">
				<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
					<line x1="18" y1="6" x2="6" y2="18"></line>
					<line x1="6" y1="6" x2="18" y2="18"></line>
				</svg>
			</button>
		</div>
	</div>
	</div>
</section>

<script>
	import { openModalFocus, closeModalFocus } from '../lib/ui';

	function setupDisplayTest() {
		const displayCard = document.getElementById('display-lab');
		const canvas = document.getElementById('motion-canvas') as HTMLCanvasElement | null;
		const viewportWrap = document.getElementById('motion-viewport-wrap');
		if (!displayCard || !canvas || !viewportWrap) return;
		if (displayCard.dataset.bound === '1') return;
		displayCard.dataset.bound = '1';

		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		let speedPxPerSec = 480;
		let patternType: 'chip' | 'bars' | 'checker' = 'chip';
		let motionTrajectory: 'wrap' | 'bounce' = 'wrap';
		let motionDir: 1 | -1 = 1;
		let posX = 0;
		let hasInitializedPos = false;
		let lastTimestamp = 0;
		let rafId: number | null = null;
		let isVisible = false;
		let isMotionRunning = false;

		const fpsEl = document.getElementById('display-fps');
		const fpsUnitEl = document.getElementById('display-fps-unit');
		const frameTimeEl = document.getElementById('display-frame-time');
		const jitterEl = document.getElementById('display-jitter');
		const droppedEl = document.getElementById('display-dropped');
		const hdrTagEl = document.getElementById('display-hdr-tag');
		const depthTagEl = document.getElementById('display-depth-tag');

		let frameTimes: number[] = [];
		let lastFpsUpdate = 0;
		let droppedFrames = 0;
		let expectedFrameMs = 16.67;

		// Detect HDR & Color Bit Depth
		const isHDR = window.matchMedia('(dynamic-range: high)').matches || window.matchMedia('(video-dynamic-range: high)').matches;
		const isRec2020 = window.matchMedia('(color-gamut: rec2020)').matches;
		const isP3 = window.matchMedia('(color-gamut: p3)').matches;
		const depth = window.screen.colorDepth || 24;

		if (hdrTagEl) {
			hdrTagEl.textContent = isHDR ? 'HDR' : 'SDR';
		}
		if (depthTagEl) {
			const gamut = isRec2020 ? 'Rec.2020' : (isP3 ? 'Display P3' : 'sRGB');
			depthTagEl.textContent = `${depth}-bit color ▪ ${gamut}`;
		}

		// Responsive canvas sizing
		function resizeCanvas() {
			const rect = viewportWrap?.getBoundingClientRect();
			if (!rect || rect.width === 0) return;
			const dpr = window.devicePixelRatio || 1;
			const targetW = Math.round(rect.width * dpr);
			const targetH = Math.round(150 * dpr);
			const cssWidth = targetW / dpr;
			if (!hasInitializedPos) {
				posX = Math.round(cssWidth / 2);
				hasInitializedPos = true;
			}
			if (canvas!.width !== targetW || canvas!.height !== targetH) {
				canvas!.width = targetW;
				canvas!.height = targetH;
				if (motionTrajectory === 'bounce') {
					const halfW = patternType === 'checker' ? 100 : (patternType === 'bars' ? 96 : 63);
					const minX = halfW + 10;
					const maxX = Math.max(minX, cssWidth - halfW - 10);
					if (posX < minX) posX = minX;
					else if (posX > maxX) posX = maxX;
				}
				if (!isMotionRunning) {
					drawFrame();
				}
			}
		}
		resizeCanvas();
		window.addEventListener('resize', resizeCanvas, { passive: true });
		if (window.ResizeObserver) {
			const ro = new ResizeObserver(() => resizeCanvas());
			ro.observe(viewportWrap);
		}
		displayCard.addEventListener('section-toggle', () => {
			requestAnimationFrame(resizeCanvas);
		});

		// Draw Silicon IC Package (Square QFP package with lead pins on all 4 sides & ultra-crisp typography)
		function drawSiliconChip(x: number, y: number, dpr: number, isDark: boolean) {
			if (!ctx) return;
			ctx.save();
			ctx.translate(Math.round(x), Math.round(y));

			// Square QFP package sizing: body 102px + 12px pins on each side = 126px total (fits 150px canvas with 12px margin)
			const bodySize = Math.round(102 * dpr);
			const halfBody = Math.round(bodySize / 2);
			const pinExt = Math.round(12 * dpr);
			const numPins = 7; // 7 pins per side (28-pin square package)
			const pinW = Math.max(3, Math.round(4.5 * dpr));
			const pinMargin = Math.round(11 * dpr);
			const pinSpacing = (bodySize - pinMargin * 2) / (numPins - 1);

			// Metallic gold/copper lead pins on all 4 sides
			ctx.fillStyle = isDark ? '#f59e0b' : '#d97706';
			for (let i = 0; i < numPins; i++) {
				const offset = -halfBody + pinMargin + i * pinSpacing;
				const pPos = Math.round(offset - pinW / 2);

				// Top pins
				ctx.fillRect(pPos, -halfBody - pinExt, pinW, pinExt + 1);
				// Bottom pins
				ctx.fillRect(pPos, halfBody - 1, pinW, pinExt + 1);
				// Left pins
				ctx.fillRect(-halfBody - pinExt, pPos, pinExt + 1, pinW);
				// Right pins
				ctx.fillRect(halfBody - 1, pPos, pinExt + 1, pinW);
			}

			// Main Square IC Epoxy/Ceramic Package Body
			ctx.fillStyle = isDark ? '#1e293b' : '#f8fafb';
			ctx.strokeStyle = isDark ? '#64748b' : '#475569';
			ctx.lineWidth = Math.max(1, Math.round(2 * dpr));
			ctx.beginPath();
			const cornerRadius = Math.round(8 * dpr);
			if (typeof ctx.roundRect === 'function') {
				ctx.roundRect(-halfBody, -halfBody, bodySize, bodySize, cornerRadius);
			} else {
				ctx.rect(-halfBody, -halfBody, bodySize, bodySize);
			}
			ctx.fill();
			ctx.stroke();

			// Pin 1 Index Dot (top-left orientation marker with high-contrast slate tone)
			ctx.fillStyle = isDark ? '#475569' : '#94a3b8';
			ctx.beginPath();
			ctx.arc(-halfBody + Math.round(14 * dpr), -halfBody + Math.round(14 * dpr), Math.round(4 * dpr), 0, Math.PI * 2);
			ctx.fill();

			// Laser etched text (sharp high-frequency contrast test with whole-pixel rasterization)
			ctx.textAlign = 'center';
			ctx.textBaseline = 'middle';

			// Line 1: TEST-IC (Crisp bold primary title)
			ctx.fillStyle = isDark ? '#ffffff' : '#0f172a';
			ctx.font = `800 ${Math.round(18 * dpr)}px "Atkinson", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif`;
			ctx.fillText('TEST-IC', 0, Math.round(-11 * dpr));

			// Line 2: 3nm FinFET (Crisp high-contrast technical subtext)
			ctx.fillStyle = isDark ? '#93c5fd' : '#2563eb';
			ctx.font = `700 ${Math.round(11 * dpr)}px "Atkinson", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif`;
			ctx.fillText('3nm FinFET', 0, Math.round(13 * dpr));

			ctx.restore();
		}

		// Draw Pursuit Bars
		function drawPursuitBars(x: number, h: number, dpr: number, isDark: boolean) {
			if (!ctx) return;
			const barWidth = Math.round(24 * dpr);
			const totalWidth = barWidth * 8;
			const startX = Math.round(x - totalWidth / 2);
			const marginY = Math.round(12 * dpr);
			const barHeight = h - marginY * 2;
			const tickH = Math.round(8 * dpr);

			ctx.save();
			for (let i = 0; i < 8; i++) {
				const bx = startX + i * barWidth;
				ctx.fillStyle = (i % 2 === 0) ? (isDark ? '#fafafa' : '#0f172a') : (isDark ? '#09090b' : '#f8fafc');
				ctx.fillRect(bx, marginY, barWidth, barHeight);

				// Contrast tick markers
				ctx.fillStyle = (i % 2 === 0) ? '#f97316' : '#38bdf8';
				ctx.fillRect(bx, Math.round(h / 2 - tickH / 2), barWidth, tickH);
			}
			ctx.restore();
		}

		// Draw Checkerboard
		function drawCheckerboard(x: number, h: number, dpr: number, isDark: boolean) {
			if (!ctx) return;
			const sqSize = Math.round(25 * dpr);
			const cols = 8;
			const rows = 5;
			const totalWidth = cols * sqSize;
			const totalHeight = rows * sqSize;
			const startX = Math.round(x - totalWidth / 2);
			const startY = Math.round(h / 2 - totalHeight / 2);

			ctx.save();
			for (let r = 0; r < rows; r++) {
				for (let c = 0; c < cols; c++) {
					const isEven = (r + c) % 2 === 0;
					ctx.fillStyle = isEven ? (isDark ? '#ffffff' : '#000000') : (isDark ? '#1e293b' : '#e2e8f0');
					ctx.fillRect(startX + c * sqSize, startY + r * sqSize, sqSize, sqSize);
				}
			}
			ctx.restore();
		}

		// Render canvas background, grid, track, and active pattern
		function drawFrame() {
			if (!ctx) return;
			const dpr = window.devicePixelRatio || 1;
			const w = canvas.width;
			const h = canvas.height;
			const isDark = document.documentElement.getAttribute('data-theme') === 'dark';

			ctx.clearRect(0, 0, w, h);

			// Background track
			ctx.fillStyle = isDark ? '#090a0d' : '#d9dee5';
			ctx.fillRect(0, 0, w, h);

			// Grid guide lines
			ctx.strokeStyle = isDark ? 'rgba(255, 255, 255, 0.09)' : 'rgba(15, 23, 42, 0.11)';
			ctx.lineWidth = 1;
			const gridSpacing = 40 * dpr;
			for (let gx = 0; gx < w; gx += gridSpacing) {
				ctx.beginPath();
				ctx.moveTo(gx, 0);
				ctx.lineTo(gx, h);
				ctx.stroke();
			}

			// Center tracking line
			ctx.strokeStyle = isDark ? 'rgba(234, 88, 12, 0.35)' : 'rgba(217, 72, 15, 0.32)';
			ctx.beginPath();
			ctx.moveTo(0, h / 2);
			ctx.lineTo(w, h / 2);
			ctx.stroke();

			// Render active pattern helper
			const renderY = Math.round(h / 2);
			const canvasCSSWidth = w / dpr;

			function renderPatternAt(xCoord: number) {
				const renderX = Math.round(xCoord * dpr);
				if (patternType === 'chip') {
					drawSiliconChip(renderX, renderY, dpr, isDark);
				} else if (patternType === 'bars') {
					drawPursuitBars(renderX, h, dpr, isDark);
				} else if (patternType === 'checker') {
					drawCheckerboard(renderX, h, dpr, isDark);
				}
			}

			// Render primary pattern
			renderPatternAt(posX);

			// In Wrap mode, seamlessly wrap across boundaries if intersecting edges
			if (motionTrajectory === 'wrap') {
				const halfW = patternType === 'checker' ? 100 : (patternType === 'bars' ? 96 : 63);
				if (posX - halfW < 0) {
					renderPatternAt(posX + canvasCSSWidth);
				} else if (posX + halfW > canvasCSSWidth) {
					renderPatternAt(posX - canvasCSSWidth);
				}
			}
		}

		function renderLoop(timestamp: number) {
			if (!isVisible) {
				rafId = null;
				return;
			}

			if (!lastTimestamp) lastTimestamp = timestamp;
			const deltaMs = timestamp - lastTimestamp;
			lastTimestamp = timestamp;

			if (deltaMs > 0 && deltaMs < 200) {
				frameTimes.push(deltaMs);
				if (frameTimes.length > 60) frameTimes.shift();

				if (frameTimes.length >= 10) {
					const sorted = [...frameTimes].sort((a, b) => a - b);
					expectedFrameMs = Math.max(3.5, sorted[Math.floor(sorted.length / 2)]);
					// Dropped frame heuristic (delta > 1.8x measured baseline frame interval)
					if (deltaMs > expectedFrameMs * 1.8) droppedFrames++;
				}

				// Advance movement based on exact delta
				const dtSec = deltaMs / 1000;
				const curDpr = window.devicePixelRatio || 1;
				const canvasCSSWidth = canvas.width / curDpr;

				if (motionTrajectory === 'bounce') {
					// Pattern half-width in CSS pixels (Chip: 63, Bars: 96, Checker: 100)
					const halfW = patternType === 'checker' ? 100 : (patternType === 'bars' ? 96 : 63);
					const pad = 10;
					const minX = halfW + pad;
					const maxX = Math.max(minX, canvasCSSWidth - halfW - pad);

					posX += motionDir * speedPxPerSec * dtSec;
					if (posX >= maxX) {
						posX = maxX;
						updateDirectionUI(-1);
					} else if (posX <= minX) {
						posX = minX;
						updateDirectionUI(1);
					}
				} else {
					// Continuous seamless toroidal wrap (modulo canvas width)
					posX += motionDir * speedPxPerSec * dtSec;
					if (posX >= canvasCSSWidth) {
						posX = posX % canvasCSSWidth;
					} else if (posX < 0) {
						posX = (posX % canvasCSSWidth) + canvasCSSWidth;
					}
				}
			}

			drawFrame();

			// Update HUD metrics ~5 times a second
			if (timestamp - lastFpsUpdate > 200 && frameTimes.length > 5) {
				lastFpsUpdate = timestamp;
				const avgDelta = frameTimes.reduce((a, b) => a + b, 0) / frameTimes.length;
				const currentFps = Math.round(1000 / avgDelta);

				// Compute jitter variance
				const variance = frameTimes.reduce((acc, val) => acc + Math.abs(val - avgDelta), 0) / frameTimes.length;

				if (fpsEl) fpsEl.textContent = String(currentFps);
				if (fpsUnitEl) fpsUnitEl.classList.remove('hidden');
				if (frameTimeEl) {
					const ua = typeof navigator !== 'undefined' ? navigator.userAgent : '';
					const isMobileTouch = /Android|iPhone|iPad|iPod/i.test(ua) || (typeof navigator !== 'undefined' && navigator.maxTouchPoints > 1 && /Macintosh/i.test(ua));
					if (isMobileTouch && currentFps >= 58 && currentFps <= 62) {
						frameTimeEl.textContent = `${avgDelta.toFixed(2)} ms / frame (Mobile 60Hz rAF)`;
						frameTimeEl.title = '60 Hz measured. Mobile browsers and Low Power Mode frequently cap requestAnimationFrame to 60 Hz regardless of physical screen refresh rate.';
					} else {
						frameTimeEl.textContent = `${avgDelta.toFixed(2)} ms / frame`;
						frameTimeEl.title = '';
					}
				}
				if (jitterEl) jitterEl.textContent = `±${variance.toFixed(2)}`;
				if (droppedEl) droppedEl.textContent = `${droppedFrames} dropped`;
			}

			rafId = requestAnimationFrame(renderLoop);
		}

		// Initial static frame render (since stopped by default)
		drawFrame();

		// Lightweight MutationObserver to instantly redraw canvas when theme swaps while stopped
		const themeObserver = new MutationObserver((mutations) => {
			for (const mutation of mutations) {
				if (mutation.type === 'attributes' && mutation.attributeName === 'data-theme') {
					if (!isMotionRunning) {
						drawFrame();
					}
					break;
				}
			}
		});
		themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

		// IntersectionObserver to sleep when out of viewport
		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				isVisible = entry.isIntersecting;
				if (isVisible && isMotionRunning && !rafId) {
					lastTimestamp = performance.now();
					rafId = requestAnimationFrame(renderLoop);
				} else if (isVisible && !isMotionRunning) {
					drawFrame();
				}
			});
		}, { threshold: 0.05 });
		observer.observe(viewportWrap);

		// Stop / Resume motion toggle
		const toggleDisplayBtn = document.getElementById('toggle-display-btn');
		const toggleDisplayStopIcon = document.getElementById('toggle-display-icon-stop');
		const toggleDisplayPlayIcon = document.getElementById('toggle-display-icon-play');
		const toggleDisplayText = document.getElementById('toggle-display-text');

		toggleDisplayBtn?.addEventListener('click', () => {
			isMotionRunning = !isMotionRunning;
			toggleDisplayBtn.setAttribute('aria-pressed', String(isMotionRunning));
			if (!isMotionRunning) {
				if (rafId) {
					cancelAnimationFrame(rafId);
					rafId = null;
				}
				toggleDisplayStopIcon?.classList.add('hidden');
				toggleDisplayPlayIcon?.classList.remove('hidden');
				if (toggleDisplayText) toggleDisplayText.textContent = 'Start';
				toggleDisplayBtn.setAttribute('title', 'Start display motion benchmark');
				if (fpsEl) fpsEl.textContent = 'Stopped';
				if (fpsUnitEl) fpsUnitEl.classList.add('hidden');
				if (frameTimeEl) frameTimeEl.textContent = 'Motion stopped';
				drawFrame();
			} else {
				frameTimes = [];
				droppedFrames = 0;
				lastFpsUpdate = 0;
				if (droppedEl) droppedEl.textContent = '0 dropped';
				toggleDisplayStopIcon?.classList.remove('hidden');
				toggleDisplayPlayIcon?.classList.add('hidden');
				if (toggleDisplayText) toggleDisplayText.textContent = 'Stop';
				toggleDisplayBtn.setAttribute('title', 'Stop display motion benchmark');
				if (fpsUnitEl) fpsUnitEl.classList.remove('hidden');
				lastTimestamp = performance.now();
				rafId = requestAnimationFrame(renderLoop);
			}
		});

		// Direction button controls (Left / Right)
		const directionBtns = document.querySelectorAll('.display-test-card .seg-btn[data-direction]');
		function updateDirectionUI(dir: 1 | -1) {
			motionDir = dir;
			directionBtns.forEach((btn) => {
				const bDir = btn.getAttribute('data-direction');
				const isActive = (dir === -1 && bDir === 'left') || (dir === 1 && bDir === 'right');
				btn.classList.toggle('active', isActive);
				btn.setAttribute('aria-pressed', String(isActive));
			});
		}

		directionBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const targetDir = btn.getAttribute('data-direction') === 'left' ? -1 : 1;
				updateDirectionUI(targetDir);
			});
		});

		// Trajectory button controls (Wrap / Bounce)
		const trajectoryBtns = document.querySelectorAll('.display-test-card .seg-btn[data-trajectory]');
		trajectoryBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				trajectoryBtns.forEach(b => {
					b.classList.remove('active');
					b.setAttribute('aria-pressed', 'false');
				});
				btn.classList.add('active');
				btn.setAttribute('aria-pressed', 'true');
				motionTrajectory = (btn.getAttribute('data-trajectory') as any) || 'wrap';
				if (motionTrajectory === 'bounce') {
					const halfW = patternType === 'checker' ? 100 : (patternType === 'bars' ? 96 : 63);
					const curDpr = window.devicePixelRatio || 1;
					const canvasCSSWidth = canvas.width / curDpr;
					const minX = halfW + 10;
					const maxX = Math.max(minX, canvasCSSWidth - halfW - 10);
					if (posX < minX) {
						posX = minX;
						updateDirectionUI(1);
					} else if (posX > maxX) {
						posX = maxX;
						updateDirectionUI(-1);
					}
				} else {
					const curDpr = window.devicePixelRatio || 1;
					const canvasCSSWidth = canvas.width / curDpr;
					if (posX >= canvasCSSWidth) {
						posX = posX % canvasCSSWidth;
					} else if (posX < 0) {
						posX = (posX % canvasCSSWidth) + canvasCSSWidth;
					}
				}
				if (!isMotionRunning) {
					drawFrame();
				}
			});
		});

		// Speed button controls
		const speedBtns = document.querySelectorAll('.display-test-card .seg-btn[data-speed]');
		speedBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				speedBtns.forEach(b => {
					b.classList.remove('active');
					b.setAttribute('aria-pressed', 'false');
				});
				btn.classList.add('active');
				btn.setAttribute('aria-pressed', 'true');
				const spd = parseInt(btn.getAttribute('data-speed') || '480', 10);
				speedPxPerSec = spd;
			});
		});

		// Pattern button controls
		const patternBtns = document.querySelectorAll('.display-test-card .seg-btn[data-pattern]');
		patternBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				patternBtns.forEach(b => {
					b.classList.remove('active');
					b.setAttribute('aria-pressed', 'false');
				});
				btn.classList.add('active');
				btn.setAttribute('aria-pressed', 'true');
				patternType = (btn.getAttribute('data-pattern') as any) || 'chip';
				if (motionTrajectory === 'bounce') {
					const halfW = patternType === 'checker' ? 100 : (patternType === 'bars' ? 96 : 63);
					const curDpr = window.devicePixelRatio || 1;
					const canvasCSSWidth = canvas.width / curDpr;
					const minX = halfW + 10;
					const maxX = Math.max(minX, canvasCSSWidth - halfW - 10);
					if (posX < minX) posX = minX;
					else if (posX > maxX) posX = maxX;
				}
				if (!isMotionRunning) {
					drawFrame();
				}
			});
		});

		// DEAD PIXEL CHECKER MODAL
		const pixelModal = document.getElementById('pixel-checker-modal');
		const pixelPlane = document.getElementById('pixel-canvas-plane');
		const pixelColorName = document.getElementById('pixel-color-name');
		const openPixelBtn = document.getElementById('open-pixel-checker-btn');
		const closePixelBtn = document.getElementById('close-pixel-btn');

		const PIXEL_MODES = [
			{ name: 'Pure Black (Stuck / Bright Pixel Check)', color: '#000000', textLight: true },
			{ name: 'Pure White (Dead Dark Pixel & Backlight Bleed)', color: '#ffffff', textLight: false },
			{ name: 'Pure Red (Red Subpixel Health)', color: '#ff0000', textLight: true },
			{ name: 'Pure Green (Green Subpixel Health)', color: '#00ff00', textLight: false },
			{ name: 'Pure Blue (Blue Subpixel Health)', color: '#0000ff', textLight: true },
			{ name: '50% Neutral Gray (Panel Uniformity & DSE)', color: '#7f7f7f', textLight: true },
			{ name: 'Local Dimming (Checkerboard Blooming Check)', color: '#000000', textLight: true, pattern: 'checkerboard' },
			{ name: 'Local Dimming (Large Checkerboard)', color: '#000000', textLight: true, pattern: 'checkerboard-lg' },
			{ name: 'Local Dimming (Moving White Rectangles)', color: '#000000', textLight: true, pattern: 'moving-rect', rectW: 72, rectH: 48 },
			{ name: 'Local Dimming (Large Moving White Rectangles)', color: '#000000', textLight: true, pattern: 'moving-rect', rectW: 144, rectH: 96 },
			{ name: 'Local Dimming (Erratic White Circles)', color: '#000000', textLight: true, pattern: 'loopy-circles' }
		];

		let currentPixelIdx = 0;
		let hudHideTimer: number | null = null;
		let shapeRafId: number | null = null;
		let isModeMenuOpen = false;
		const RECT_SPEED_PX_PER_SEC = 420;
		const HUD_HIDE_DELAY_MS = 3500;
		const pixelHud = document.getElementById('pixel-hud');
		const pixelHudPill = document.getElementById('pixel-hud-pill');
		const pixelModeMenu = document.getElementById('pixel-mode-menu');
		const pixelShape1 = document.getElementById('pixel-shape-1');
		const pixelShape2 = document.getElementById('pixel-shape-2');

		function closeModeMenu() {
			if (!pixelModeMenu || !pixelHudPill) return;
			isModeMenuOpen = false;
			pixelModeMenu.classList.add('hidden');
			pixelHudPill.setAttribute('aria-expanded', 'false');
		}

		function renderModeMenu() {
			if (!pixelModeMenu) return;
			pixelModeMenu.innerHTML = '';
			PIXEL_MODES.forEach((mode, idx) => {
				const btn = document.createElement('button');
				btn.type = 'button';
				btn.className = `pixel-mode-item${idx === currentPixelIdx ? ' active' : ''}`;
				btn.setAttribute('role', 'menuitem');

				const swatch = document.createElement('span');
				swatch.className = 'pixel-mode-swatch';
				if (mode.pattern === 'checkerboard') {
					swatch.classList.add('swatch-checker');
				} else if (mode.pattern === 'checkerboard-lg') {
					swatch.classList.add('swatch-checker-lg');
				} else if (mode.pattern === 'moving-rect') {
					swatch.classList.add((mode.rectW ?? 72) > 100 ? 'swatch-rect-lg' : 'swatch-rect');
				} else if (mode.pattern === 'loopy-circles') {
					swatch.classList.add('swatch-loopy-circles');
				} else {
					swatch.style.backgroundColor = mode.color;
				}

				const label = document.createElement('span');
				label.textContent = mode.name;

				btn.appendChild(swatch);
				btn.appendChild(label);
				btn.addEventListener('click', (e) => {
					e.stopPropagation();
					currentPixelIdx = idx;
					applyPixelColor();
					closeModeMenu();
					showPixelHud();
				});
				pixelModeMenu.appendChild(btn);
			});
		}

		function toggleModeMenu(e: Event) {
			e.stopPropagation();
			if (!pixelModeMenu || !pixelHudPill) return;
			isModeMenuOpen = !isModeMenuOpen;
			if (isModeMenuOpen) {
				renderModeMenu();
				pixelModeMenu.classList.remove('hidden');
				pixelHudPill.setAttribute('aria-expanded', 'true');
				if (hudHideTimer !== null) {
					window.clearTimeout(hudHideTimer);
					hudHideTimer = null;
				}
			} else {
				closeModeMenu();
				showPixelHud();
			}
		}

		function stopMovingShapes() {
			if (shapeRafId !== null) {
				cancelAnimationFrame(shapeRafId);
				shapeRafId = null;
			}
			for (const el of [pixelShape1, pixelShape2]) {
				if (el) {
					el.classList.add('hidden');
					el.classList.remove('is-circle');
				}
			}
		}

		function startMovingRects(rectW: number, rectH: number) {
			if (!pixelShape1 || !pixelShape2) return;
			stopMovingShapes();

			const vw = window.innerWidth;
			const vh = window.innerHeight;
			let x1 = 0;
			let y1 = 0;
			let x2 = 0;
			let y2 = Math.max(0, vh - rectH);
			let lastTs = performance.now();

			for (const el of [pixelShape1, pixelShape2]) {
				el.style.width = `${rectW}px`;
				el.style.height = `${rectH}px`;
				el.classList.remove('is-circle', 'hidden');
			}
			pixelShape1.style.transform = `translate3d(${x1}px, ${y1}px, 0)`;
			pixelShape2.style.transform = `translate3d(${x2}px, ${y2}px, 0)`;

			function step(now: number) {
				if (!pixelModal || pixelModal.classList.contains('hidden')) {
					stopMovingShapes();
					return;
				}
				const dt = Math.min((now - lastTs) / 1000, 0.1);
				lastTs = now;
				const curW = window.innerWidth;
				const curH = window.innerHeight;

				// Rectangle 1: left to right, stepping down row by row
				x1 += RECT_SPEED_PX_PER_SEC * dt;
				if (x1 > curW) {
					x1 = -rectW;
					y1 += rectH;
					if (y1 >= curH) {
						y1 = 0;
					}
				}

				// Rectangle 2: bottom to top, stepping right column by column
				y2 -= RECT_SPEED_PX_PER_SEC * dt;
				if (y2 < -rectH) {
					y2 = curH;
					x2 += rectW;
					if (x2 >= curW) {
						x2 = 0;
					}
				}

				if (pixelShape1) pixelShape1.style.transform = `translate3d(${x1}px, ${y1}px, 0)`;
				if (pixelShape2) pixelShape2.style.transform = `translate3d(${x2}px, ${y2}px, 0)`;
				shapeRafId = requestAnimationFrame(step);
			}

			shapeRafId = requestAnimationFrame(step);
		}

		function startLoopyCircles() {
			if (!pixelShape1 || !pixelShape2) return;
			stopMovingShapes();

			const vw = window.innerWidth;
			const vh = window.innerHeight;
			const now0 = performance.now();

			const makeCircle = (el: HTMLElement, size: number, baseSpeed: number) => {
				const maxX = Math.max(1, vw - size);
				const maxY = Math.max(1, vh - size);
				el.style.width = `${size}px`;
				el.style.height = `${size}px`;
				el.classList.add('is-circle');
				el.classList.remove('hidden');
				const x = Math.random() * maxX;
				const y = Math.random() * maxY;
				el.style.transform = `translate3d(${x}px, ${y}px, 0)`;
				return {
					el,
					size,
					baseSpeed,
					x,
					y,
					theta: Math.random() * Math.PI * 2,
					omega: 0,
					targetOmega: (Math.random() * 2 - 1) * 4.5,
					nextTurnAt: now0 + 350 + Math.random() * 850,
					phase: Math.random() * Math.PI * 2,
					freq: 1.1 + Math.random() * 1.2
				};
			};

			const circles = [
				makeCircle(pixelShape1, 44, 480),
				makeCircle(pixelShape2, 96, 270)
			];
			let lastTs = now0;

			function step(now: number) {
				if (!pixelModal || pixelModal.classList.contains('hidden')) {
					stopMovingShapes();
					return;
				}
				const dt = Math.min((now - lastTs) / 1000, 0.05);
				lastTs = now;
				const curW = window.innerWidth;
				const curH = window.innerHeight;
				const margin = Math.min(120, Math.min(curW, curH) * 0.2);

				for (const c of circles) {
					if (now >= c.nextTurnAt) {
						c.targetOmega = (Math.random() * 2 - 1) * 5.2;
						c.nextTurnAt = now + 350 + Math.random() * 1050;
					}
					c.omega += (c.targetOmega - c.omega) * Math.min(1, dt * 3.8);

					const cx = c.x + c.size * 0.5;
					const cy = c.y + c.size * 0.5;
					if (cx < margin || cx > curW - margin || cy < margin || cy > curH - margin) {
						const toCenter = Math.atan2(curH * 0.5 - cy, curW * 0.5 - cx);
						const diff = Math.atan2(Math.sin(toCenter - c.theta), Math.cos(toCenter - c.theta));
						c.theta += diff * Math.min(1, dt * 4.5);
					}

					c.theta += c.omega * dt;
					const speed = c.baseSpeed * (1 + 0.25 * Math.sin((now / 1000) * c.freq + c.phase));
					c.x = Math.max(0, Math.min(Math.max(0, curW - c.size), c.x + Math.cos(c.theta) * speed * dt));
					c.y = Math.max(0, Math.min(Math.max(0, curH - c.size), c.y + Math.sin(c.theta) * speed * dt));
					c.el.style.transform = `translate3d(${c.x}px, ${c.y}px, 0)`;
				}

				shapeRafId = requestAnimationFrame(step);
			}

			shapeRafId = requestAnimationFrame(step);
		}

		function showPixelHud() {
			if (!pixelHud) return;
			pixelHud.classList.remove('hud-hidden');
			if (hudHideTimer !== null) {
				window.clearTimeout(hudHideTimer);
				hudHideTimer = null;
			}
			if (isModeMenuOpen) return;
			hudHideTimer = window.setTimeout(() => {
				if (pixelModal && !pixelModal.classList.contains('hidden') && !isModeMenuOpen) {
					pixelHud.classList.add('hud-hidden');
				}
			}, HUD_HIDE_DELAY_MS);
		}

		function clearPixelHudTimer() {
			if (hudHideTimer !== null) {
				window.clearTimeout(hudHideTimer);
				hudHideTimer = null;
			}
			if (pixelHud) {
				pixelHud.classList.remove('hud-hidden');
			}
		}

		function applyPixelColor() {
			if (!pixelPlane || !pixelColorName) return;
			const mode = PIXEL_MODES[currentPixelIdx];
			stopMovingShapes();
			pixelPlane.classList.remove('pixel-checkerboard', 'pixel-checkerboard-lg');
			pixelPlane.style.backgroundColor = mode.color;
			pixelColorName.textContent = mode.name;
			if (mode.pattern === 'checkerboard') {
				pixelPlane.classList.add('pixel-checkerboard');
			} else if (mode.pattern === 'checkerboard-lg') {
				pixelPlane.classList.add('pixel-checkerboard-lg');
			} else if (mode.pattern === 'moving-rect') {
				startMovingRects(mode.rectW ?? 72, mode.rectH ?? 48);
			} else if (mode.pattern === 'loopy-circles') {
				startLoopyCircles();
			}
			if (isModeMenuOpen) {
				renderModeMenu();
			}
		}

		function nextPixelColor() {
			currentPixelIdx = (currentPixelIdx + 1) % PIXEL_MODES.length;
			applyPixelColor();
		}

		function requestFs(el: HTMLElement) {
			if (el.requestFullscreen) {
				return el.requestFullscreen().catch(() => {});
			} else if ((el as any).webkitRequestFullscreen) {
				return (el as any).webkitRequestFullscreen();
			} else if ((el as any).mozRequestFullScreen) {
				return (el as any).mozRequestFullScreen();
			} else if ((el as any).msRequestFullscreen) {
				return (el as any).msRequestFullscreen();
			}
		}

		function exitFs() {
			const isFs = !!(
				document.fullscreenElement ||
				(document as any).webkitFullscreenElement ||
				(document as any).mozFullScreenElement ||
				(document as any).msFullscreenElement
			);
			if (isFs) {
				try {
					if (document.exitFullscreen) {
						document.exitFullscreen().catch(() => {});
					} else if ((document as any).webkitExitFullscreen) {
						(document as any).webkitExitFullscreen();
					} else if ((document as any).mozCancelFullScreen) {
						(document as any).mozCancelFullScreen();
					} else if ((document as any).msExitFullscreen) {
						(document as any).msExitFullscreen();
					}
				} catch (_) {}
			}
		}

		function openPixelChecker() {
			if (!pixelModal) return;
			pixelModal.classList.remove('hidden');
			openModalFocus(pixelModal, closePixelBtn);
			document.documentElement.classList.add('pixel-checker-active');
			document.body.classList.add('pixel-checker-active');
			document.documentElement.style.overflow = 'hidden';
			document.body.style.overflow = 'hidden';
			currentPixelIdx = 0;
			applyPixelColor();
			showPixelHud();
			(window as any).__pushModalHistory?.('pixel-checker-modal', closePixelChecker);

			// Attempt fullscreen on modal element for true edge-to-edge inspection with 0 scrollbar
			try {
				const p = requestFs(pixelModal);
				if (p && typeof p.catch === 'function') {
					p.catch(() => {
						try {
							requestFs(document.documentElement);
						} catch (_) {}
					});
				}
			} catch (_) {
				try {
					requestFs(document.documentElement);
				} catch (_) {}
			}
		}

		function closePixelChecker() {
			if (!pixelModal || pixelModal.classList.contains('hidden')) return;
			pixelModal.classList.add('hidden');
			closeModalFocus(pixelModal);
			document.documentElement.classList.remove('pixel-checker-active');
			document.body.classList.remove('pixel-checker-active');
			document.documentElement.style.overflow = '';
			document.body.style.overflow = '';
			exitFs();
			stopMovingShapes();
			closeModeMenu();
			clearPixelHudTimer();
			(window as any).__popModalHistory?.('pixel-checker-modal');
		}

		function onFullscreenChange() {
			const isFs = !!(
				document.fullscreenElement ||
				(document as any).webkitFullscreenElement ||
				(document as any).mozFullScreenElement ||
				(document as any).msFullscreenElement
			);
			if (!isFs && pixelModal && !pixelModal.classList.contains('hidden')) {
				closePixelChecker();
			}
		}

		document.addEventListener('fullscreenchange', onFullscreenChange);
		document.addEventListener('webkitfullscreenchange', onFullscreenChange);
		document.addEventListener('mozfullscreenchange', onFullscreenChange);
		document.addEventListener('MSFullscreenChange', onFullscreenChange);

		if (openPixelBtn) openPixelBtn.addEventListener('click', openPixelChecker);
		if (closePixelBtn) closePixelBtn.addEventListener('click', closePixelChecker);
		if (pixelPlane) pixelPlane.addEventListener('click', () => {
			if (isModeMenuOpen) {
				closeModeMenu();
				showPixelHud();
				return;
			}
			nextPixelColor();
		});
		if (pixelHudPill) pixelHudPill.addEventListener('click', toggleModeMenu);
		if (pixelHud) pixelHud.addEventListener('click', (e) => e.stopPropagation());
		if (pixelModal) pixelModal.addEventListener('mousemove', showPixelHud, { passive: true });

		document.addEventListener('keydown', (e) => {
			if (!pixelModal || pixelModal.classList.contains('hidden')) return;
			if (e.key === 'Escape' || e.key === 'Esc') {
				e.preventDefault();
				e.stopPropagation();
				closePixelChecker();
			} else if (e.key === ' ' || e.key === 'ArrowRight' || e.key === 'Enter') {
				e.preventDefault();
				nextPixelColor();
			} else if (e.key === 'ArrowLeft') {
				e.preventDefault();
				currentPixelIdx = (currentPixelIdx - 1 + PIXEL_MODES.length) % PIXEL_MODES.length;
				applyPixelColor();
			}
		});
	}

	setupDisplayTest();
	document.addEventListener('astro:page-load', setupDisplayTest);
</script>

