---
// EasterEggs.astro - Hardware & Silicon Validation Interactive Lab Extras
// Logic modularized into ../lib/easterEggs.ts
---

<div id="easter-eggs-container">
	<!-- FLOATING HUDS -->
	<div id="zerog-hud" class="ee-hud zerog-hud hidden" style="display: none;">
		<span class="hud-pulse-dot"></span>
		<span class="hud-title">⚡ ZERO-G COLLAPSE ACTIVE ▪ DRAG &amp; FLING CARDS</span>
		<button id="zerog-reset-btn" type="button" class="ee-hud-btn">Resolder / Reassemble</button>
	</div>

	<div id="tilt-hud" class="ee-hud tilt-hud hidden" style="display: none;">
		<span class="hud-pulse-dot"></span>
		<span class="hud-title">📐 3D HOLOGRAM VIEWPORT TILT ACTIVE</span>
		<button id="tilt-exit-btn" type="button" class="ee-hud-btn">Exit (Esc)</button>
	</div>

	<div id="degauss-hud" class="ee-hud degauss-hud hidden" style="display: none;">
		<span class="hud-pulse-dot"></span>
		<span class="hud-title">⚡ CRT BENCH DEGAUSS ▪ ELECTROMAGNETIC PULSE</span>
		<button id="degauss-re-btn" type="button" class="ee-hud-btn">Pulse Coil</button>
		<button id="degauss-exit-btn" type="button" class="ee-hud-btn">Exit (Esc)</button>
	</div>
	<canvas id="degauss-canvas" class="ee-canvas hidden" aria-hidden="true" style="display: none;"></canvas>

	<div id="sphere-hud" class="ee-hud sphere-hud hidden" style="display: none;">
		<span class="hud-pulse-dot"></span>
		<span class="hud-title">🪐 3D SILICON CYCLONE ▪ DRAG TO ROTATE ▪ HOVER TO INSPECT</span>
		<button id="sphere-exit-btn" type="button" class="ee-hud-btn">Collapse to 2D (Esc)</button>
	</div>
	<div id="sphere-core" class="sphere-core hidden" aria-hidden="true" style="display: none;">
		<div class="die-cube">
			<div class="die-face die-front mono">3nm HPC CORE</div>
			<div class="die-face die-back mono">L3 64MB</div>
			<div class="die-face die-left mono">PCIe Gen5</div>
			<div class="die-face die-right mono">LPDDR5 PHY</div>
			<div class="die-face die-top mono">ATE BIST</div>
			<div class="die-face die-bottom mono">SUBSTRATE</div>
			<div class="die-aura"></div>
		</div>
	</div>

	<div id="quantum-hud" class="ee-hud quantum-hud hidden" style="display: none;">
		<span class="hud-pulse-dot"></span>
		<span class="hud-title">💨 QUANTUM TUNNELING ▪ TAP BOXES TO DISSOLVE ▪ DRAG TO SWIRL</span>
		<div class="hud-actions-row">
			<button id="quantum-all-btn" type="button" class="ee-hud-btn">Dissolve All</button>
			<button id="quantum-reassemble-btn" type="button" class="ee-hud-btn">Quantum Anneal</button>
			<button id="quantum-exit-btn" type="button" class="ee-hud-btn">Exit (Esc)</button>
		</div>
	</div>
	<canvas id="quantum-canvas" class="ee-canvas hidden" aria-hidden="true" style="display: none;"></canvas>

	<div id="thermal-hud" class="ee-hud thermal-hud hidden" style="display: none;">
		<div class="thermal-hud-inner">
			<span class="hud-pulse-dot"></span>
			<span class="hud-title">🌡️ THERMAL CAM ▪ <span id="thermal-tool-text">TOOL: LN2 CRYO-SPRAY (-196°C)</span></span>
			<div class="hud-actions-row">
				<button id="thermal-tool-btn" type="button" class="ee-hud-btn">Switch to Heat Gun (450°C)</button>
				<button id="thermal-reset-btn" type="button" class="ee-hud-btn">Normalize (24°C)</button>
				<button id="thermal-exit-btn" type="button" class="ee-hud-btn">Exit (Esc)</button>
			</div>
		</div>
	</div>
	<div id="thermal-scale-bar" class="thermal-scale-bar hidden" aria-hidden="true" style="display: none;">
		<div class="ts-val max mono">150°C</div>
		<div class="ts-gradient"></div>
		<div class="ts-val min mono" id="ts-min-val">-196°C</div>
		<div class="ts-emissivity mono">ε: 0.95</div>
	</div>
	<div id="thermal-spots" class="thermal-spots hidden" aria-hidden="true" style="display: none;">
		<div class="thermal-spot" id="t-spot-cpu" style="top: 25%; left: 35%;">
			<div class="spot-crosshair"></div>
			<span class="spot-label mono">SP01 [CPU DIE] <strong id="t-cpu-val">98.4°C</strong></span>
		</div>
		<div class="thermal-spot" id="t-spot-vrm" style="top: 42%; left: 62%;">
			<div class="spot-crosshair"></div>
			<span class="spot-label mono">SP02 [PMIC VRM] <strong id="t-vrm-val">104.2°C</strong></span>
		</div>
		<div class="thermal-spot" id="t-spot-mem" style="top: 65%; left: 45%;">
			<div class="spot-crosshair"></div>
			<span class="spot-label mono">SP03 [LPDDR5] <strong id="t-mem-val">71.5°C</strong></span>
		</div>
		<div class="thermal-spot" id="t-spot-cursor">
			<div class="spot-crosshair active"></div>
			<span class="spot-label mono">PROBE <strong id="t-cursor-val">24.5°C</strong></span>
		</div>
	</div>
	<canvas id="thermal-canvas" class="ee-canvas hidden" aria-hidden="true" style="display: none;"></canvas>

	<!-- 300MM SILICON WAFER DIE SORT MODAL -->
	<div id="wafer-modal" class="wafer-modal hidden" aria-hidden="true" inert role="dialog" aria-modal="true" aria-label="300mm Silicon Wafer Sort Inspector" style="display: none;">
		<div class="wafer-backdrop" id="wafer-backdrop"></div>
		<div class="wafer-dialog">
			<div class="wafer-modal-header">
				<div class="wafer-title-wrap">
					<span class="hud-pulse-dot"></span>
					<div class="wafer-title-meta">
						<span class="wafer-title">300mm ATE SILICON WAFER SORT</span>
						<span class="wafer-sub mono" id="wafer-sub-meta">LOT #740C-W14 ▪ 3nm HPC Node ▪ Reticle Limit (740 mm²) ▪ 83 Dies</span>
					</div>
				</div>
				<button id="wafer-close-btn" class="wafer-close-btn" type="button" aria-label="Close Wafer Inspector">&times;</button>
			</div>

			<div class="wafer-modal-body">
				<div class="wafer-canvas-wrap">
					<canvas id="wafer-canvas" width="400" height="400" aria-label="Wafer Die Sort Map"></canvas>
					<div class="wafer-notch-indicator mono">▼ Wafer Notch (0° / 6 o'clock) ▪ 300mm Substrate</div>
				</div>

				<div class="wafer-telemetry-panel">
					<div class="wafer-telemetry-box">
						<span class="w-box-title">Functional Die Yield</span>
						<div class="w-yield-display">
							<span class="w-yield-val mono" id="wafer-yield-val">88.0%</span>
							<span class="w-yield-badge mono" id="wafer-d0-val">D₀: 0.082/cm²</span>
						</div>
						<div class="w-yield-bar-wrap">
							<div class="w-yield-bar" id="wafer-yield-bar" style="width: 88.0%;"></div>
						</div>
					</div>

					<div class="wafer-telemetry-box">
						<span class="w-box-title">Active Die Probe Telemetry</span>
						<div class="wafer-probe-grid mono" id="wafer-probe-grid">
							<div class="probe-row"><span class="p-k">Die:</span><span class="p-v" id="wp-id">0x7E106005</span></div>
							<div class="probe-row"><span class="p-k">Pos:</span><span class="p-v" id="wp-pos">(5, 6)</span></div>
							<div class="probe-row"><span class="p-k">Bin:</span><span class="p-v" id="wp-bin">Perfect (Bin 1)</span></div>
							<div class="probe-row"><span class="p-k">Cores:</span><span class="p-v" id="wp-config">All Active</span></div>
							<div class="probe-row"><span class="p-k">Area:</span><span class="p-v" id="wp-area">740 mm²</span></div>
							<div class="probe-row"><span class="p-k">Fmax:</span><span class="p-v" id="wp-fmax">3.80 GHz</span></div>
							<div class="probe-row"><span class="p-k">Vmin:</span><span class="p-v" id="wp-vmin">0.775 V</span></div>
							<div class="probe-row"><span class="p-k">Iddq:</span><span class="p-v" id="wp-leak">24.5 mA</span></div>
						</div>
					</div>

					<div class="wafer-legend">
						<div class="legend-item"><span class="leg-color bin1"></span><span id="leg-bin1-text">Perfect (Bin 1): 46 (55.4%) ▪ All Cores</span></div>
						<div class="legend-item"><span class="leg-color bin2"></span><span id="leg-bin2-text">Defeatured (Bin 2): 27 (32.5%) ▪ Harvest</span></div>
						<div class="legend-item"><span class="leg-color binx"></span><span id="leg-binx-text">Fallout (Reject): 10 (12.1%) ▪ Defect</span></div>
					</div>

					<div class="wafer-actions">
						<button id="wafer-scan-btn" type="button" class="wafer-btn primary" title="Randomize wafer defects & run ATE probe sweep">
							<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12a9 9 0 0 1-9 9m9-9a9 9 0 0 0-9-9m9 9H3m9 9a9 9 0 0 1-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/></svg>
							<span>Run ATE Pogo Probe Scan</span>
						</button>
						<button id="wafer-random-btn" type="button" class="wafer-btn">
							<span>Probe Random Die</span>
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- 8x8 BIT CARRY-SAVE ARRAY MULTIPLIER MODAL -->
	<div id="multiplier-modal" class="wafer-modal hidden" aria-hidden="true" inert role="dialog" aria-modal="true" aria-label="8x8 Bit Carry-Save Array Multiplier" style="display: none;">
		<div class="wafer-backdrop" id="multiplier-backdrop"></div>
		<div class="wafer-dialog mult-dialog">
			<div class="wafer-modal-header">
				<div class="wafer-title-wrap">
					<span class="hud-pulse-dot"></span>
					<div class="wafer-title-meta">
						<span class="wafer-title">8×8-BIT CARRY-SAVE ARRAY MULTIPLIER</span>
					</div>
				</div>
				<div class="mult-header-actions">
					<a href="https://github.com/bowuu/8x8-Multiplier" target="_blank" rel="noopener noreferrer" class="mult-gh-link mono" title="View 8x8 Multiplier on GitHub">
						<svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
						<span>bowuu/8x8-Multiplier</span>
					</a>
					<button id="multiplier-close-btn" class="wafer-close-btn" type="button" aria-label="Close Multiplier">&times;</button>
				</div>
			</div>

			<div class="mult-body">
				<div class="mult-inputs-card">
					<div class="mult-registers-grid">
						<div class="mult-reg-box">
							<div class="mult-reg-header mono">
								<span class="reg-title">MULTIPLICAND X [7:0]</span>
								<span class="reg-meta" id="mult-x-meta">0xAA ▪ 170 ▪ 1010 1010₂</span>
							</div>
							<div class="mult-cols-row mono" id="mult-x-bits"></div>
						</div>
						<div class="mult-op-badge mono">&times;</div>
						<div class="mult-reg-box">
							<div class="mult-reg-header mono">
								<span class="reg-title">MULTIPLIER Y [7:0]</span>
								<span class="reg-meta" id="mult-y-meta">0x55 ▪ 85 ▪ 0101 0101₂</span>
							</div>
							<div class="mult-cols-row mono" id="mult-y-bits"></div>
						</div>
					</div>

					<div class="mult-presets">
						<span class="presets-title mono">PRESETS:</span>
						<button type="button" class="mult-pre-btn mono" data-x="170" data-y="85">0xAA &times; 0x55 (14,450)</button>
						<button type="button" class="mult-pre-btn mono" data-x="255" data-y="255">255 &times; 255 (65,025)</button>
						<button type="button" class="mult-pre-btn mono" data-x="15" data-y="240">0x0F &times; 0xF0 (3,600)</button>
						<button type="button" class="mult-pre-btn mono" data-x="128" data-y="64">128 &times; 64 (8,192)</button>
						<button type="button" class="mult-pre-btn mono" data-x="0" data-y="0">Clear 0 &times; 0 (0)</button>
						<button type="button" class="mult-pre-btn mono" id="mult-rand-btn">Random</button>
					</div>
				</div>

				<div class="mult-schematic-card">
					<div class="mult-schematic-header mono">
						<div class="mult-schematic-controls">
							<button id="mult-replay-btn" class="mult-speed-toggle mono" type="button" title="Replay Propagation Logic">
								<span>▶ Replay</span>
							</button>
							<button id="mult-speed-btn" class="mult-speed-toggle mono" type="button" title="Toggle between Instant Combinational Logic and Step-by-Step Wave Cascade">
								<span id="mult-speed-icon">⚡</span> <span id="mult-speed-text">Instant</span>
							</button>
						</div>
						<div class="mult-legend mono">
							<span class="leg-item"><span class="leg-line active"></span> HIGH (1)</span>
							<span class="leg-item"><span class="leg-line dim"></span> LOW (0)</span>
						</div>
					</div>
					<div class="mult-svg-scroll-wrap" id="mult-svg-wrap">
						<svg id="mult-schematic-svg" class="mult-schematic-svg" viewBox="0 0 990 510" preserveAspectRatio="xMidYMid meet"></svg>
					</div>
					<div class="mult-cell-tooltip mono" id="mult-cell-info">
						Hover or tap any cell F or wire to inspect Boolean logic, partial products, sum, and carry propagation.
					</div>
				</div>

				<div class="mult-output-card">
					<div class="mult-output-header mono">
						<span class="mult-product-title">16-BIT PRODUCT OUTPUT REGISTER P [15:0]</span>
						<div class="mult-product-vals">
							<span class="p-dec mono" id="mult-p-dec">P = 14,450</span>
							<span class="p-hex mono" id="mult-p-hex">0x3872</span>
							<span class="p-bin mono" id="mult-p-bin">0011 1000 0111 0010₂</span>
						</div>
					</div>
					<div class="mult-cols-row mono" id="mult-product-bits"></div>
				</div>
			</div>
		</div>
	</div>

	<!-- LAB EXTRAS DRAWER (SORTED ALPHABETICALLY A-Z) -->
	<div id="lab-extras-modal" class="lab-extras-modal hidden" aria-hidden="true" inert role="dialog" aria-modal="true" aria-label="Hardware Lab Easter Eggs" style="display: none;">
		<div class="extras-header">
			<div class="extras-title">
				<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
				</svg>
				<span>Hardware Lab Extras</span>
			</div>
			<button id="extras-close-btn" type="button" class="extras-close-btn" aria-label="Close Extras Drawer">&times;</button>
		</div>
		<div class="extras-grid">
			<button id="trigger-sphere-btn" class="extra-item-btn" type="button" title="3D Silicon Cyclone">
				<span class="item-icon" aria-hidden="true">🌪️</span>
				<div class="item-meta">
					<strong class="item-name">3D Cyclone</strong>
					<span class="item-desc">Orbital 3D spherical cage around silicon die</span>
				</div>
				<kbd class="item-kbd">cyclone</kbd>
			</button>

			<button id="trigger-tilt-btn" class="extra-item-btn" type="button" title="3D Viewport Parallax Hologram Tilt">
				<span class="item-icon" aria-hidden="true">📐</span>
				<div class="item-meta">
					<strong class="item-name">3D Tilt</strong>
					<span class="item-desc">Parallax hologram perspective depth</span>
				</div>
				<kbd class="item-kbd">Ctrl+Alt+H</kbd>
			</button>

			<button id="trigger-multiplier-btn" class="extra-item-btn" type="button" title="8×8-Bit Carry-Save Array Multiplier">
				<span class="item-icon" aria-hidden="true">⚡</span>
				<div class="item-meta">
					<strong class="item-name">8x8 Multiplier</strong>
					<span class="item-desc">Braun carry-save array &amp; vector merge</span>
				</div>
				<kbd class="item-kbd">multiplier</kbd>
			</button>

			<button id="trigger-boop-btn" class="extra-item-btn" type="button" title="Boop Chief Morale Officer">
				<span class="item-icon" aria-hidden="true">🐾</span>
				<div class="item-meta">
					<strong class="item-name">Chief Morale Officer</strong>
					<span class="item-desc">Bin CMO silicon from standard to golden sample</span>
				</div>
				<kbd class="item-kbd">boop</kbd>
			</button>

			<button id="trigger-degauss-btn" class="extra-item-btn" type="button" title="CRT Oscilloscope Electromagnetic Degauss Pulse">
				<span class="item-icon" aria-hidden="true">⚡</span>
				<div class="item-meta">
					<strong class="item-name">CRT Degauss</strong>
					<span class="item-desc">Electromagnetic coil warp &amp; phosphor pulse</span>
				</div>
				<kbd class="item-kbd">degauss</kbd>
			</button>

			<button id="trigger-quantum-btn" class="extra-item-btn" type="button" title="Quantum Tunneling Particle Disintegration">
				<span class="item-icon" aria-hidden="true">💨</span>
				<div class="item-meta">
					<strong class="item-name">Quantum Tunneling</strong>
					<span class="item-desc">Tap boxes to dissolve into silicon dust</span>
				</div>
				<kbd class="item-kbd">dissolve</kbd>
			</button>

			<button id="trigger-thermal-btn" class="extra-item-btn" type="button" title="Infrared Thermal Camera & LN2 Cryo-Blast">
				<span class="item-icon" aria-hidden="true">🌡️</span>
				<div class="item-meta">
					<strong class="item-name">Thermal Cam</strong>
					<span class="item-desc">Infrared thermography, LN2 cryo &amp; heat gun</span>
				</div>
				<kbd class="item-kbd">thermal</kbd>
			</button>

			<button id="trigger-wafer-btn" class="extra-item-btn" type="button" title="300mm Silicon Wafer Sort Map">
				<span class="item-icon" aria-hidden="true">🔬</span>
				<div class="item-meta">
					<strong class="item-name">Wafer Sort Map</strong>
					<span class="item-desc">300mm reticle-limit enterprise die sort</span>
				</div>
				<kbd class="item-kbd">wafer -g</kbd>
			</button>

			<button id="trigger-zerog-btn" class="extra-item-btn" type="button" title="Zero-G Physics Collapse">
				<span class="item-icon" aria-hidden="true">🪐</span>
				<div class="item-meta">
					<strong class="item-name">Zero-G Drop</strong>
					<span class="item-desc">Verlet physics element collapse &amp; fling</span>
				</div>
				<kbd class="item-kbd">Ctrl+Alt+G</kbd>
			</button>
		</div>
		<div class="extras-footer">
			<span>Click cards above, use hotkeys, or enter terminal commands (<code>boop</code>, <code>cyclone</code>, <code>degauss</code>, <code>dissolve</code>, <code>gravity</code>, <code>thermal</code>, <code>wafer -g</code>).</span>
		</div>
	</div>
</div>

<script>
	import { initAllEasterEggs } from '../lib/easterEggs';

	initAllEasterEggs();
	document.addEventListener('astro:page-load', initAllEasterEggs);
</script>

<style>
	/* FLOATING HUDS */
	.ee-hud {
		position: fixed;
		top: calc(16px + env(safe-area-inset-top, 0px));
		left: 50%;
		transform: translateX(-50%);
		background: rgba(15, 23, 42, 0.94);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border: 1px solid var(--accent);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4), 0 0 16px rgba(var(--accent-rgb), 0.35);
		color: #f8fafc;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.78em;
		letter-spacing: 0.04em;
		padding: 0.45em 1.1em;
		border-radius: 24px;
		display: flex;
		align-items: center;
		gap: 0.75em;
		z-index: 100000;
		transition: all 0.2s ease;
		white-space: nowrap;
		max-width: calc(100vw - 24px);
	}
	.hud-actions-row {
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
		flex-wrap: wrap;
	}
	.hidden,
	.ee-hud.hidden,
	.lab-extras-modal.hidden,
	.wafer-modal.hidden,
	.sphere-core.hidden,
	.thermal-scale-bar.hidden,
	.thermal-spots.hidden,
	.ee-canvas.hidden {
		display: none !important;
	}

	.hud-pulse-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #22c55e;
		box-shadow: 0 0 8px #22c55e;
		animation: pulseDot 1.4s infinite ease-in-out;
		flex-shrink: 0;
	}
	@keyframes pulseDot {
		0%, 100% { opacity: 1; transform: scale(1); }
