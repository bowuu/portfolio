<script>
	// -------------------------------------------------------------
	// PROCEDURAL MECHANICAL SWITCH AUDIO SYNTHESIZER (OFF BY DEFAULT)
	// -------------------------------------------------------------
	class SwitchAudioEngine {
		private ctx: AudioContext | null = null;
		public profile: 'off' | 'blue' | 'red' | 'modelm' = 'off';
		private thermalSpraySource: AudioBufferSourceNode | null = null;
		private thermalSprayFilter: BiquadFilterNode | null = null;
		private thermalSprayGain: GainNode | null = null;
		private thermalNoiseBuffer: AudioBuffer | null = null;

		constructor() {
			// Strictly OFF by default on load
			this.profile = 'off';
		}

		private init() {
			if (!this.ctx) {
				const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
				if (AudioCtx) this.ctx = new AudioCtx();
			}
			if (this.ctx && this.ctx.state === 'suspended') {
				this.ctx.resume().catch(() => {});
			}
		}

		public setProfile(p: 'off' | 'blue' | 'red' | 'modelm') {
			this.profile = p;
			if (p !== 'off') this.init();
			window.dispatchEvent(new CustomEvent('switch-sound-changed', { detail: { profile: p } }));
		}

		public play(code?: string) {
			if (this.profile === 'off') return;
			this.init();
			if (!this.ctx) return;

			const t = this.ctx.currentTime;
			const isSpace = code === 'Space';
			const isEnter = code === 'Enter';
			const isBack = code === 'Backspace';
			const isShift = code === 'ShiftLeft' || code === 'ShiftRight';
			const isBig = isEnter || isBack || isShift;

			// Per-key physical acoustic modeling & humanized micro-variance (±2.5% pitch, ±4% gain)
			const jitter = 0.975 + Math.random() * 0.05;
			const gainJitter = 0.96 + Math.random() * 0.08;
			const pitchMod = (isSpace ? 0.62 : isBig ? 0.82 : 1.0) * jitter;

			if (this.profile === 'blue') {
				// CLICKY BLUE (Cherry MX Blue / Kailh Box White):
				// 1. Sharp click jacket snap: crisp tactile high-frequency dual snap
				this.playResonantImpulse(t, 3950 * pitchMod, 5.2, 0.004, 0.20 * gainJitter);
				this.playResonantImpulse(t, 6200 * pitchMod, 3.8, 0.003, 0.12 * gainJitter);
				// 2. Plastic housing bottom-out clack: solid mid-frequency body resonance
				const bodyFreq = isSpace ? 165 : isBig ? 240 : 360;
				this.playResonantImpulse(t + 0.0015, bodyFreq * pitchMod, 3.2, 0.022, 0.18 * gainJitter);
				this.playResonantImpulse(t + 0.0015, 1100 * pitchMod, 2.2, 0.012, 0.08 * gainJitter);
				if (isSpace) {
					// Spacebar wire stabilizer tick
					this.playResonantImpulse(t + 0.001, 3200, 4.0, 0.003, 0.08 * gainJitter);
				}
			} else if (this.profile === 'red') {
				// LINEAR RED (Cherry MX Red / Smooth POM Stem Bottom-Out / Deep "Thock"):
				// No click leaf! Pure solid plastic impact on switch floor + keycap cavity resonance
				const cavityFreq = isSpace ? 135 : isBig ? 180 : 235;
				const cavityDur = isSpace ? 0.038 : isBig ? 0.028 : 0.022;
				// Primary keycap Helmholtz cavity resonance (solid deep thock)
				this.playResonantImpulse(t, cavityFreq * pitchMod, 3.4, cavityDur, 0.26 * gainJitter);
				// Secondary switch housing plate impact
				this.playResonantImpulse(t, 490 * pitchMod, 2.5, 0.016, 0.14 * gainJitter);
				// Subtle stem collision transient
				this.playResonantImpulse(t, 2400 * pitchMod, 1.8, 0.003, 0.06 * gainJitter);
				if (isSpace) {
					// Spacebar hollow air resonance & wire stabilizer
					this.playResonantImpulse(t + 0.002, 105, 2.8, 0.042, 0.12 * gainJitter);
				}
			} else if (this.profile === 'modelm') {
				// BUCKLING SPRING (IBM Model M / Unicomp):
				// 1. Music wire coil buckle: sharp mechanical snap
				this.playResonantImpulse(t, 2850 * pitchMod, 4.2, 0.005, 0.20 * gainJitter);
				// 2. Plastic flipper hitting curved 1.5mm steel backplate: heavy solid thud
				const steelFreq = isSpace ? 130 : isBig ? 165 : 210;
				const steelDur = isSpace ? 0.048 : 0.034;
				this.playResonantImpulse(t + 0.001, steelFreq * pitchMod, 2.8, steelDur, 0.22 * gainJitter);
				// 3. Steel spring acoustic ringing (the iconic Model M spring ping / twang)
				// Twin high-Q resonant modes creating natural metallic acoustic beating
				this.playSpringRing(t + 0.001, 2640 * pitchMod, 2850 * pitchMod, 0.085, 0.12 * gainJitter);
			}
		}

		public playProbeTick() {
			if (!this.ctx) return;
			const t = this.ctx.currentTime;
			this.playResonantImpulse(t, 2200 + Math.random() * 300, 3.5, 0.008, 0.04);
		}

		// Modal physical acoustic synthesis: excite tuned resonant bandpass filter with shaped micro-impulse
		private playResonantImpulse(time: number, freq: number, Q: number, dur: number, vol: number) {
			if (!this.ctx) return;
			const bufferSize = Math.max(16, Math.floor(this.ctx.sampleRate * Math.min(dur, 0.012)));
			const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
			const data = buffer.getChannelData(0);
			for (let i = 0; i < bufferSize; i++) {
				data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (bufferSize * 0.28));
			}

			const source = this.ctx.createBufferSource();
			source.buffer = buffer;

			const filter = this.ctx.createBiquadFilter();
			filter.type = 'bandpass';
			filter.frequency.setValueAtTime(Math.max(20, Math.min(20000, freq)), time);
			filter.Q.setValueAtTime(Q, time);

			const gain = this.ctx.createGain();
			gain.gain.setValueAtTime(vol, time);
			gain.gain.exponentialRampToValueAtTime(0.0001, time + dur);

			source.connect(filter);
			filter.connect(gain);
			gain.connect(this.ctx.destination);

			source.start(time);
			source.stop(time + dur);
		}

		// Model M steel spring ping: two high-Q damped resonant sine modes with natural metallic acoustic beating
		private playSpringRing(time: number, freq1: number, freq2: number, dur: number, vol: number) {
			if (!this.ctx) return;
			[freq1, freq2].forEach((f, idx) => {
				const osc = this.ctx!.createOscillator();
				const gain = this.ctx!.createGain();
				osc.type = 'sine';
				osc.frequency.setValueAtTime(f, time);

				const modeVol = vol * (idx === 0 ? 0.7 : 0.5);
				gain.gain.setValueAtTime(modeVol, time);
				gain.gain.exponentialRampToValueAtTime(0.0001, time + dur);

				osc.connect(gain);
				gain.connect(this.ctx!.destination);

				osc.start(time);
				osc.stop(time + dur);
			});
		}

		private playThump(time: number, startFreq: number, endFreq: number, dur: number, vol: number) {
			if (!this.ctx) return;
			const osc = this.ctx.createOscillator();
			const gain = this.ctx.createGain();

			osc.type = 'triangle';
			osc.frequency.setValueAtTime(startFreq, time);
			osc.frequency.exponentialRampToValueAtTime(Math.max(20, endFreq), time + dur);

			gain.gain.setValueAtTime(vol, time);
			gain.gain.exponentialRampToValueAtTime(0.0001, time + dur);

			osc.connect(gain);
			gain.connect(this.ctx.destination);
			osc.start(time);
			osc.stop(time + dur);
		}

		private playTone(time: number, freq: number, type: OscillatorType, dur: number, vol: number) {
			if (!this.ctx) return;
			const osc = this.ctx.createOscillator();
			const gain = this.ctx.createGain();
			osc.type = type;
			osc.frequency.setValueAtTime(freq, time);

			gain.gain.setValueAtTime(vol, time);
			gain.gain.exponentialRampToValueAtTime(0.0001, time + dur);

			osc.connect(gain);
			gain.connect(this.ctx.destination);
			osc.start(time);
			osc.stop(time + dur);
		}

		private playImpulse(time: number, centerFreq: number, dur: number, vol: number) {
			if (!this.ctx) return;
			const bufferSize = Math.max(1, Math.floor(this.ctx.sampleRate * dur));
			const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
			const data = buffer.getChannelData(0);
			for (let i = 0; i < bufferSize; i++) {
				data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (bufferSize * 0.35));
			}

			const source = this.ctx.createBufferSource();
			source.buffer = buffer;

			const filter = this.ctx.createBiquadFilter();
			filter.type = 'bandpass';
			filter.frequency.setValueAtTime(centerFreq, time);
			filter.Q.setValueAtTime(2.5, time);

			const gain = this.ctx.createGain();
			gain.gain.setValueAtTime(vol, time);
			gain.gain.exponentialRampToValueAtTime(0.0001, time + dur);

			source.connect(filter);
			filter.connect(gain);
			gain.connect(this.ctx.destination);
			source.start(time);
			source.stop(time + dur);
		}

		// CRT Degauss electromagnetic coil sweep & relay click
		public playDegauss() {
			try {
				this.init();
				if (!this.ctx) return;
				const t = this.ctx.currentTime;

				// 1. Initial High-Energy Inductive Thump / Coil Charging Kick
				const kickOsc = this.ctx.createOscillator();
				const kickGain = this.ctx.createGain();
				kickOsc.type = 'sine';
				kickOsc.frequency.setValueAtTime(54, t);
				kickOsc.frequency.exponentialRampToValueAtTime(28, t + 0.12);
				kickGain.gain.setValueAtTime(0.35, t);
				kickGain.gain.exponentialRampToValueAtTime(0.0001, t + 0.15);
				kickOsc.connect(kickGain);
				kickGain.connect(this.ctx.destination);
				kickOsc.start(t);
				kickOsc.stop(t + 0.15);

				// 2. Heavy 60Hz Magnetic Coil Transformer Hum & Power Harmonics
				const coilOsc1 = this.ctx.createOscillator();
				const coilOsc2 = this.ctx.createOscillator();
				const coilGain = this.ctx.createGain();
				const coilFilter = this.ctx.createBiquadFilter();

				// Fundamental 60Hz + slight thermal frequency sag (62Hz -> 58Hz)
				coilOsc1.type = 'sawtooth';
				coilOsc1.frequency.setValueAtTime(62, t);
				coilOsc1.frequency.linearRampToValueAtTime(58, t + 1.4);

				// 120Hz 2nd harmonic for rich transformer buzz
				coilOsc2.type = 'sawtooth';
				coilOsc2.frequency.setValueAtTime(124, t);
				coilOsc2.frequency.linearRampToValueAtTime(116, t + 1.4);

				// Resonant lowpass filter simulating chassis enclosure
				coilFilter.type = 'lowpass';
				coilFilter.frequency.setValueAtTime(450, t);
				coilFilter.frequency.exponentialRampToValueAtTime(85, t + 1.4);
				coilFilter.Q.setValueAtTime(2.2, t);

				// PTC Thermistor Envelope: violent onset, short hold, exponential thermal decay
				coilGain.gain.setValueAtTime(0.02, t);
				coilGain.gain.linearRampToValueAtTime(0.32, t + 0.04);
				coilGain.gain.setValueAtTime(0.30, t + 0.18);
				coilGain.gain.exponentialRampToValueAtTime(0.0001, t + 1.42);

				coilOsc1.connect(coilFilter);
				coilOsc2.connect(coilFilter);
				coilFilter.connect(coilGain);
				coilGain.connect(this.ctx.destination);

				coilOsc1.start(t);
				coilOsc2.start(t);
				coilOsc1.stop(t + 1.44);
				coilOsc2.stop(t + 1.44);

				// 3. Dual-Contact Mechanical Relay Opening Click-Clack at ~1.42s
				setTimeout(() => {
					if (!this.ctx) return;
					const rt = this.ctx.currentTime;
					// Contact 1: high-voltage spark & leaf snap
					this.playImpulse(rt, 3200, 0.004, 0.22);
					this.playTone(rt, 1450, 'triangle', 0.010, 0.12);
					// Contact 2: mechanical armature bounce (14ms later)
					setTimeout(() => {
						if (!this.ctx) return;
						const rt2 = this.ctx.currentTime;
						this.playImpulse(rt2, 2100, 0.005, 0.16);
						this.playTone(rt2, 820, 'square', 0.014, 0.10);
					}, 14);
				}, 1420);
			} catch {}
		}

		// Zero-allocation continuous thermal spray audio engine (no GC thrashing)
		private getThermalNoiseBuffer(): AudioBuffer | null {
			if (this.thermalNoiseBuffer) return this.thermalNoiseBuffer;
			if (!this.ctx) return null;
			// 1.5 seconds of looping pink-weighted noise
			const size = Math.floor(this.ctx.sampleRate * 1.5);
			const buf = this.ctx.createBuffer(1, size, this.ctx.sampleRate);
			const data = buf.getChannelData(0);
			let b0 = 0, b1 = 0, b2 = 0;
			for (let i = 0; i < size; i++) {
				const white = Math.random() * 2 - 1;
				b0 = 0.99886 * b0 + white * 0.0555179;
				b1 = 0.99332 * b1 + white * 0.0750759;
				b2 = 0.96900 * b2 + white * 0.1538520;
				data[i] = (b0 + b1 + b2 + white * 0.5362) * 0.18;
			}
			this.thermalNoiseBuffer = buf;
			return buf;
		}

		public startThermalSpray(mode: 'cryo' | 'heatgun') {
			try {
				this.init();
				if (!this.ctx) return;
				const t = this.ctx.currentTime;
				const buf = this.getThermalNoiseBuffer();
				if (!buf) return;

				if (!this.thermalSpraySource) {
					this.thermalSpraySource = this.ctx.createBufferSource();
					this.thermalSpraySource.buffer = buf;
					this.thermalSpraySource.loop = true;

					this.thermalSprayFilter = this.ctx.createBiquadFilter();
					this.thermalSprayGain = this.ctx.createGain();
					this.thermalSprayGain.gain.setValueAtTime(0.0001, t);

					this.thermalSpraySource.connect(this.thermalSprayFilter);
					this.thermalSprayFilter.connect(this.thermalSprayGain);
					this.thermalSprayGain.connect(this.ctx.destination);
					this.thermalSpraySource.start(t);
				}

				if (this.thermalSprayFilter && this.thermalSprayGain) {
					if (mode === 'cryo') {
						this.thermalSprayFilter.type = 'bandpass';
						this.thermalSprayFilter.frequency.setTargetAtTime(3400, t, 0.02);
						this.thermalSprayFilter.Q.setTargetAtTime(1.6, t, 0.02);
						this.thermalSprayGain.gain.setTargetAtTime(0.08, t, 0.03);
					} else {
						this.thermalSprayFilter.type = 'lowpass';
						this.thermalSprayFilter.frequency.setTargetAtTime(320, t, 0.02);
						this.thermalSprayFilter.Q.setTargetAtTime(2.4, t, 0.02);
						this.thermalSprayGain.gain.setTargetAtTime(0.12, t, 0.03);
					}
				}
			} catch {}
		}

		public stopThermalSpray() {
			try {
				if (!this.ctx || !this.thermalSprayGain) return;
				const t = this.ctx.currentTime;
				this.thermalSprayGain.gain.setTargetAtTime(0.0001, t, 0.04);
			} catch {}
		}

		// Quantum Tunneling disintegrate chime sweep
		public playQuantumDisintegrate() {
			try {
				this.init();
				if (!this.ctx) return;
