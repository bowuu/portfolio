---
// EasterEggs.astro - Hardware & Silicon Validation Interactive Easter Eggs
// 1. 3D Viewport Parallax Hologram Tilt (perspective matrix tracking cursor/orientation)
// 2. Chief Morale Officer "Boop the Dog" (+10 dBm RF Telemetry & Mascot Animation)
// 3. Procedural Mechanical Switch Synthesizer (pure Web Audio API acoustics: Blue / Red / Model M)
// 4. 300mm ATE Silicon Wafer Die Sort Map (Reticle-Limit Massive Enterprise Die Architecture)
// 5. Zero-G Verlet Physics Element Collapse (pure vanilla physics, non-destructive GPU transforms)
---

<div id="easter-eggs-container">
	<!-- FLOATING HUDS -->
	<div id="zerog-hud" class="ee-hud zerog-hud hidden">
		<span class="hud-pulse-dot"></span>
		<span class="hud-title">⚡ ZERO-G COLLAPSE ACTIVE &bull; DRAG &amp; FLING CARDS</span>
		<button id="zerog-reset-btn" type="button" class="ee-hud-btn">Resolder / Reassemble</button>
	</div>

	<div id="tilt-hud" class="ee-hud tilt-hud hidden">
		<span class="hud-pulse-dot"></span>
		<span class="hud-title">📐 3D HOLOGRAM VIEWPORT TILT ACTIVE</span>
		<button id="tilt-exit-btn" type="button" class="ee-hud-btn">Exit (Esc)</button>
	</div>

	<!-- BREAKOUT SMASHER HUD -->
	<div id="breakout-hud" class="ee-hud breakout-hud hidden">
		<span class="hud-pulse-dot"></span>
		<span class="hud-title">🕹️ SILICON DIE BREAKOUT &bull; PADDLE [MOUSE] &bull; SCORE: <span id="bo-score" class="mono">0</span></span>
		<button id="breakout-exit-btn" type="button" class="ee-hud-btn">Exit (Esc)</button>
	</div>

	<!-- ELECTROSTATIC FORCE FIELD HUD -->
	<div id="magnet-hud" class="ee-hud magnet-hud hidden">
		<span class="hud-pulse-dot"></span>
		<span class="hud-title">🧲 ELECTROSTATIC FORCE FIELD ACTIVE &bull; REPEL CARDS</span>
		<button id="magnet-exit-btn" type="button" class="ee-hud-btn">Exit (Esc)</button>
	</div>

	<!-- X-RAY SILICON INSPECTOR HUD -->
	<div id="xray-hud" class="ee-hud xray-hud hidden">
		<span class="hud-pulse-dot"></span>
		<span class="hud-title">🔬 X-RAY SILICON INSPECTOR ACTIVE &bull; HOVER TO SCAN PCB &amp; DIE</span>
		<button id="xray-exit-btn" type="button" class="ee-hud-btn">Exit (Esc)</button>
	</div>

	<!-- 300MM SILICON WAFER DIE SORT MODAL (RETICLE-LIMIT ENTERPRISE DIE) -->
	<div id="wafer-modal" class="wafer-modal hidden" role="dialog" aria-modal="true" aria-label="300mm Silicon Wafer Sort Inspector">
		<div class="wafer-backdrop" id="wafer-backdrop"></div>
		<div class="wafer-dialog">
			<div class="wafer-modal-header">
				<div class="wafer-title-wrap">
					<span class="hud-pulse-dot"></span>
					<div class="wafer-title-meta">
						<span class="wafer-title">300mm ATE SILICON WAFER SORT</span>
						<span class="wafer-sub mono" id="wafer-sub-meta">LOT #740C-W14 &bull; 7nm HPC Node &bull; Reticle Limit (740 mm²) &bull; 83 Dies</span>
					</div>
				</div>
				<button id="wafer-close-btn" class="wafer-close-btn" type="button" aria-label="Close Wafer Inspector">&times;</button>
			</div>

			<div class="wafer-modal-body">
				<div class="wafer-canvas-wrap">
					<canvas id="wafer-canvas" width="400" height="400" aria-label="Wafer Die Sort Map"></canvas>
					<div class="wafer-notch-indicator mono">▼ Wafer Notch (0° / 6 o'clock) &bull; 300mm Substrate</div>
				</div>

				<div class="wafer-telemetry-panel">
					<!-- YIELD SUMMARY -->
					<div class="wafer-telemetry-box">
						<span class="w-box-title">Functional Die Yield</span>
						<div class="w-yield-display">
							<span class="w-yield-val mono" id="wafer-yield-val">88.0%</span>
							<span class="w-yield-badge mono" id="wafer-d0-val">D₀: 0.082/cm²</span>
						</div>
						<div class="w-yield-bar-wrap">
							<div class="w-yield-bar" id="wafer-yield-bar" style="width: 88.0%;"></div>
						</div>
					</div>

					<!-- ACTIVE DIE PROBE READOUT (CONCISE, FIXED HEIGHTS, ZERO JITTER) -->
					<div class="wafer-telemetry-box">
						<span class="w-box-title">Active Die Probe Telemetry</span>
						<div class="wafer-probe-grid mono" id="wafer-probe-grid">
							<div class="probe-row"><span class="p-k">Die:</span><span class="p-v" id="wp-id">0x7E106005</span></div>
							<div class="probe-row"><span class="p-k">Pos:</span><span class="p-v" id="wp-pos">(5, 6)</span></div>
							<div class="probe-row"><span class="p-k">Bin:</span><span class="p-v" id="wp-bin">Perfect (Bin 1)</span></div>
							<div class="probe-row"><span class="p-k">Cores:</span><span class="p-v" id="wp-config">All Active</span></div>
							<div class="probe-row"><span class="p-k">Area:</span><span class="p-v" id="wp-area">740 mm²</span></div>
							<div class="probe-row"><span class="p-k">Fmax:</span><span class="p-v" id="wp-fmax">3.80 GHz</span></div>
							<div class="probe-row"><span class="p-k">Vmin:</span><span class="p-v" id="wp-vmin">0.775 V</span></div>
							<div class="probe-row"><span class="p-k">Iddq:</span><span class="p-v" id="wp-leak">24.5 mA</span></div>
						</div>
					</div>

					<!-- BIN DISTRIBUTION LEGEND -->
					<div class="wafer-legend">
						<div class="legend-item"><span class="leg-color bin1"></span><span id="leg-bin1-text">Perfect (Bin 1): 46 (55.4%) &bull; All Cores</span></div>
						<div class="legend-item"><span class="leg-color bin2"></span><span id="leg-bin2-text">Defeatured (Bin 2): 27 (32.5%) &bull; Harvest</span></div>
						<div class="legend-item"><span class="leg-color binx"></span><span id="leg-binx-text">Fallout (Reject): 10 (12.1%) &bull; Defect</span></div>
					</div>

					<!-- ACTIONS -->
					<div class="wafer-actions">
						<button id="wafer-scan-btn" type="button" class="wafer-btn primary" title="Randomize wafer defects & run ATE probe sweep">
							<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 0 1-9 9m9-9a9 9 0 0 0-9-9m9 9H3m9 9a9 9 0 0 1-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/></svg>
							<span>Run ATE Pogo Probe Scan</span>
						</button>
						<button id="wafer-random-btn" type="button" class="wafer-btn">
							<span>Probe Random Die</span>
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- LAB EXTRAS DRAWER / POPOVER (SORTED ALPHABETICALLY A-Z) -->
	<div id="lab-extras-modal" class="lab-extras-modal hidden" role="dialog" aria-modal="false" aria-label="Hardware Lab Easter Eggs">
		<div class="extras-header">
			<div class="extras-title">
				<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
				</svg>
				<span>Hardware Lab Extras</span>
			</div>
			<button id="extras-close-btn" type="button" class="extras-close-btn" aria-label="Close Extras Drawer">&times;</button>
		</div>
		<div class="extras-grid">
			<!-- 1. 3D Tilt (3) -->
			<button id="trigger-tilt-btn" class="extra-item-btn" type="button" title="3D Viewport Parallax Hologram Tilt">
				<span class="item-icon">📐</span>
				<div class="item-meta">
					<strong class="item-name">3D Tilt</strong>
					<span class="item-desc">Parallax hologram perspective depth</span>
				</div>
				<kbd class="item-kbd">Ctrl+Alt+H</kbd>
			</button>

			<!-- 2. Breakout Smasher (B) -->
			<button id="trigger-breakout-btn" class="extra-item-btn" type="button" title="Silicon Die Breakout Game">
				<span class="item-icon">🕹️</span>
				<div class="item-meta">
					<strong class="item-name">Breakout Smasher</strong>
					<span class="item-desc">Bounce silicon die off portfolio cards</span>
				</div>
				<kbd class="item-kbd">breakout</kbd>
			</button>

			<!-- 3. Chief Morale Officer (C) -->
			<button id="trigger-boop-btn" class="extra-item-btn" type="button" title="Boop Chief Morale Officer (She is a good girl!)">
				<span class="item-icon">🐾</span>
				<div class="item-meta">
					<strong class="item-name">Chief Morale Officer</strong>
					<span class="item-desc">Bin CMO silicon from standard to golden sample</span>
				</div>
				<kbd class="item-kbd">6.0 GHz Bin 1</kbd>
			</button>

			<!-- 4. Magnetic Field (M) -->
			<button id="trigger-magnet-btn" class="extra-item-btn" type="button" title="Electrostatic Force Field Repulsion">
				<span class="item-icon">🧲</span>
				<div class="item-meta">
					<strong class="item-name">Magnetic Field</strong>
					<span class="item-desc">Electrostatic cursor repulsion physics</span>
				</div>
				<kbd class="item-kbd">magnet</kbd>
			</button>

			<!-- 5. Switch Acoustics (S) -->
			<button id="trigger-switch-sound-btn" class="extra-item-btn" type="button" title="Cycle Mechanical Switch Acoustics">
				<span class="item-icon">🔊</span>
				<div class="item-meta">
					<strong class="item-name">Switch Acoustics</strong>
					<span class="item-desc" id="extras-sound-desc">Procedural Web Audio switch synth</span>
				</div>
				<kbd class="item-kbd" id="extras-sound-badge">Sound: Off</kbd>
			</button>

			<!-- 6. Wafer Sort Map (W) -->
			<button id="trigger-wafer-btn" class="extra-item-btn" type="button" title="300mm Silicon Wafer Sort Map (Near Reticle Limit)">
				<span class="item-icon">🔬</span>
				<div class="item-meta">
					<strong class="item-name">Wafer Sort Map</strong>
					<span class="item-desc">300mm reticle-limit enterprise die sort</span>
				</div>
				<kbd class="item-kbd">wafer -g</kbd>
			</button>

			<!-- 7. X-Ray PCB Scanner (X) -->
			<button id="trigger-xray-btn" class="extra-item-btn" type="button" title="X-Ray Silicon & PCB Trace Inspection">
				<span class="item-icon">🔍</span>
				<div class="item-meta">
					<strong class="item-name">X-Ray PCB Scanner</strong>
					<span class="item-desc">Inspect internal copper traces &amp; silicon dies</span>
				</div>
				<kbd class="item-kbd">xray</kbd>
			</button>

			<!-- 8. Zero-G Drop (Z) -->
			<button id="trigger-zerog-btn" class="extra-item-btn" type="button" title="Zero-G Physics Collapse">
				<span class="item-icon">🪐</span>
				<div class="item-meta">
					<strong class="item-name">Zero-G Drop</strong>
					<span class="item-desc">Verlet physics element collapse &amp; fling</span>
				</div>
				<kbd class="item-kbd">Ctrl+Alt+G</kbd>
			</button>
		</div>
		<div class="extras-footer">
			<span>Click cards above, use hotkeys, or enter terminal commands (<code>wafer -g</code>, <code>breakout</code>, <code>magnet</code>, <code>xray</code>, <code>gravity</code>).</span>
		</div>
	</div>
</div>

<script>
	// -------------------------------------------------------------
	// PROCEDURAL MECHANICAL SWITCH AUDIO SYNTHESIZER (OFF BY DEFAULT)
	// -------------------------------------------------------------
	class SwitchAudioEngine {
		private ctx: AudioContext | null = null;
		public profile: 'off' | 'blue' | 'red' | 'modelm' = 'off';

		constructor() {
			// Strictly OFF by default on load
			this.profile = 'off';
		}

		private init() {
			if (!this.ctx) {
				const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
				if (AudioCtx) this.ctx = new AudioCtx();
			}
			if (this.ctx && this.ctx.state === 'suspended') {
				this.ctx.resume().catch(() => {});
			}
		}

		public setProfile(p: 'off' | 'blue' | 'red' | 'modelm') {
			this.profile = p;
			if (p !== 'off') this.init();
			window.dispatchEvent(new CustomEvent('switch-sound-changed', { detail: { profile: p } }));
		}

		public play(code?: string) {
			if (this.profile === 'off') return;
			this.init();
			if (!this.ctx) return;

			const t = this.ctx.currentTime;
			const isSpace = code === 'Space';
			const isBig = isSpace || code === 'Enter' || code === 'Backspace';
			const pitchMod = isSpace ? 0.72 : isBig ? 0.84 : (0.96 + Math.random() * 0.08);

			if (this.profile === 'blue') {
				// CLICKY BLUE: Crisp tactile snap + plastic bottom-out clack
				this.playImpulse(t, 3800 * pitchMod, 0.005, 0.20);
				this.playThump(t + 0.002, 280 * pitchMod, 140 * pitchMod, 0.032, 0.18);
				this.playTone(t + 0.002, 1200 * pitchMod, 'triangle', 0.016, 0.07);
			} else if (this.profile === 'red') {
				// LINEAR RED: Pure smooth plastic "thock" (no click leaf)
				this.playThump(t, 190 * pitchMod, 85 * pitchMod, 0.036, 0.22);
				this.playImpulse(t, 420 * pitchMod, 0.014, 0.06);
			} else if (this.profile === 'modelm') {
				// BUCKLING SPRING: Sharp spring buckle snap + resonant steel spring twang + hollow barrel
				this.playImpulse(t, 2600 * pitchMod, 0.006, 0.18);
				this.playTone(t + 0.002, 2880 * pitchMod, 'sine', 0.075, 0.12);
				this.playTone(t + 0.002, 3020 * pitchMod, 'sine', 0.075, 0.10);
				this.playThump(t + 0.003, 180 * pitchMod, 95 * pitchMod, 0.042, 0.15);
			}
		}

		public playProbeTick() {
			if (!this.ctx) return;
			const t = this.ctx.currentTime;
			this.playTone(t, 1800 + Math.random() * 400, 'square', 0.006, 0.03);
		}

		private playThump(time: number, startFreq: number, endFreq: number, dur: number, vol: number) {
			if (!this.ctx) return;
			const osc = this.ctx.createOscillator();
			const gain = this.ctx.createGain();

			osc.type = 'triangle';
			osc.frequency.setValueAtTime(startFreq, time);
			osc.frequency.exponentialRampToValueAtTime(Math.max(20, endFreq), time + dur);

			gain.gain.setValueAtTime(vol, time);
			gain.gain.exponentialRampToValueAtTime(0.0001, time + dur);

			osc.connect(gain);
			gain.connect(this.ctx.destination);
			osc.start(time);
			osc.stop(time + dur);
		}

		private playTone(time: number, freq: number, type: OscillatorType, dur: number, vol: number) {
			if (!this.ctx) return;
			const osc = this.ctx.createOscillator();
			const gain = this.ctx.createGain();
			osc.type = type;
			osc.frequency.setValueAtTime(freq, time);

			gain.gain.setValueAtTime(vol, time);
			gain.gain.exponentialRampToValueAtTime(0.0001, time + dur);

			osc.connect(gain);
			gain.connect(this.ctx.destination);
			osc.start(time);
			osc.stop(time + dur);
		}

		private playImpulse(time: number, centerFreq: number, dur: number, vol: number) {
			if (!this.ctx) return;
			const bufferSize = Math.max(1, Math.floor(this.ctx.sampleRate * dur));
			const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
			const data = buffer.getChannelData(0);
			for (let i = 0; i < bufferSize; i++) {
				data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (bufferSize * 0.35));
			}

			const source = this.ctx.createBufferSource();
			source.buffer = buffer;

			const filter = this.ctx.createBiquadFilter();
			filter.type = 'bandpass';
			filter.frequency.setValueAtTime(centerFreq, time);
			filter.Q.setValueAtTime(2.5, time);

			const gain = this.ctx.createGain();
			gain.gain.setValueAtTime(vol, time);
			gain.gain.exponentialRampToValueAtTime(0.0001, time + dur);

			source.connect(filter);
			filter.connect(gain);
			gain.connect(this.ctx.destination);
			source.start(time);
			source.stop(time + dur);
		}
	}

	const audioEngine = new SwitchAudioEngine();
	(window as any).__playSwitchSound = (code?: string) => audioEngine.play(code);
	(window as any).__setSwitchSound = (profile: any) => audioEngine.setProfile(profile);
	(window as any).__getSwitchSound = () => audioEngine.profile;

	// -------------------------------------------------------------
	// CHIEF MORALE OFFICER: SILICON LOTTERY BINNING LADDER (6.0 GHz)
	// -------------------------------------------------------------
	function initDogBoop() {
		const avatarImg = document.getElementById('hero-avatar-img') || document.querySelector('.hero .avatar-img');
		const avatarWrap = document.getElementById('hero-avatar-wrap') || document.querySelector('.hero .avatar-wrap');
		if (!avatarImg || !avatarWrap) return;

		let streak = 0;
		let streakTimer = 0;

		const binReadouts = [
			'🐾 Standard Bin 3: 1.80 GHz @ 0.75V',
			'🐾 Mainstream Bin 2: 3.20 GHz @ 0.90V',
			'🐾 Premium Bin 1: 4.40 GHz @ 1.10V',
			'🐾 Golden Die: 5.20 GHz @ 1.25V (Top 1%)',
			'🐾 Golden Sample: 6.00 GHz (Peak Good Girl! 🐾)'
		];

		let dogAudioCtx: AudioContext | null = null;
		function playDogChime(step: number) {
			try {
				const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
				if (!AudioCtx) return;
				if (!dogAudioCtx) {
					dogAudioCtx = new AudioCtx();
				}
				if (dogAudioCtx.state === 'suspended') {
					dogAudioCtx.resume().catch(() => {});
				}
				const ctx = dogAudioCtx;
				const t = ctx.currentTime;
				const notes = [523.25, 587.33, 659.25, 783.99, 880.00, 1046.50];
				const baseFreq = notes[Math.min(step, notes.length - 1)];

				const osc = ctx.createOscillator();
				const gain = ctx.createGain();
				osc.type = 'sine';
				osc.frequency.setValueAtTime(baseFreq, t);
				osc.frequency.exponentialRampToValueAtTime(baseFreq * 1.35, t + 0.12);

				gain.gain.setValueAtTime(0.18, t);
				gain.gain.exponentialRampToValueAtTime(0.0001, t + 0.22);

				osc.connect(gain);
				gain.connect(ctx.destination);
				osc.start(t);
				osc.stop(t + 0.22);
			} catch {}
		}

		function triggerBoop() {
			streak++;
			window.clearTimeout(streakTimer);
			streakTimer = window.setTimeout(() => { streak = 0; }, 3500);

			playDogChime(streak);

			avatarImg.classList.remove('booped');
			void (avatarImg as HTMLElement).offsetWidth;
			avatarImg.classList.add('booped');

			const pill = document.createElement('div');
			const tier = Math.min(streak, 5);
			pill.className = `morale-boost-pill mono bin-tier-${tier}`;
			const text = binReadouts[Math.min(streak - 1, binReadouts.length - 1)];
			pill.textContent = text;
			avatarWrap.appendChild(pill);

			if (streak >= 5) {
				const glyphs = ['🐾', '🦴', '⚡', '🔥', '✨', '🐾'];
				glyphs.forEach((g, i) => {
					const conf = document.createElement('span');
					conf.className = 'boop-particle';
					conf.textContent = g;
					const angle = (i / glyphs.length) * Math.PI * 2;
					const dist = 55 + Math.random() * 35;
					const dx = Math.cos(angle) * dist;
					const dy = Math.sin(angle) * dist - 25;
					conf.style.setProperty('--dx', `${dx.toFixed(1)}px`);
					conf.style.setProperty('--dy', `${dy.toFixed(1)}px`);
					avatarWrap.appendChild(conf);
					setTimeout(() => conf.remove(), 950);
				});
			}

			setTimeout(() => {
				pill.remove();
			}, 1300);
		}

		avatarImg.addEventListener('click', triggerBoop);
		(window as any).__boopDog = () => {
			avatarImg.scrollIntoView({ behavior: 'smooth', block: 'center' });
			setTimeout(triggerBoop, 300);
		};
	}

	// -------------------------------------------------------------
	// 300MM SILICON WAFER DIE SORT INSPECTOR (MASSIVE RETICLE-LIMIT DIE)
	// -------------------------------------------------------------
	function initWaferInspector() {
		const modal = document.getElementById('wafer-modal');
		const backdrop = document.getElementById('wafer-backdrop');
		const closeBtn = document.getElementById('wafer-close-btn');
		const scanBtn = document.getElementById('wafer-scan-btn');
		const randomBtn = document.getElementById('wafer-random-btn');
		const canvas = document.getElementById('wafer-canvas') as HTMLCanvasElement | null;
		if (!modal || !canvas) return;

		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		const waferRadius = 175;
		const cx = 200;
		const cy = 200;

		// Near-reticle-limit massive die footprint (~740 mm², ~83 gross dies on 300mm substrate)
		const dieW = 30;
		const dieH = 24;
		const stepX = 32.5;
		const stepY = 26.5;
		const cols = 12;
		const rows = 14;

		interface WaferDie {
			col: number;
			row: number;
			x: number;
			y: number;
			bin: 1 | 2 | 'x';
			id: string;
			fmax: number;
			vmin: number;
			leakage: number;
			disabledCores: number[];
			tested: boolean;
		}

		const dies: WaferDie[] = [];
		let activeDie: WaferDie | null = null;
		let isScanning = false;

		function generateWaferDies(randomize: boolean = false) {
			dies.length = 0;
			const halfW = (cols * stepX) / 2;
			const halfH = (rows * stepY) / 2;

			// Random defect cluster centers & parameters
			const clusterX = randomize ? Math.floor(Math.random() * 8 + 2) : 4;
			const clusterY = randomize ? Math.floor(Math.random() * 8 + 3) : 8;
			const edgeDefectThreshold = randomize ? (0.83 + Math.random() * 0.08) : 0.86;
			const lotNum = randomize ? Math.floor(Math.random() * 800 + 100) : 740;
			const waferNum = randomize ? Math.floor(Math.random() * 24 + 1) : 14;

			for (let r = 0; r < rows; r++) {
				for (let c = 0; c < cols; c++) {
					const x = cx - halfW + c * stepX;
					const y = cy - halfH + r * stepY;

					const corners = [
						[x, y],
						[x + dieW, y],
						[x, y + dieH],
						[x + dieW, y + dieH]
					];

					// Check if all 4 corners are inside wafer exclusion boundary
					const fits = corners.every(([px, py]) => {
						const dx = px - cx;
						const dy = py - cy;
						const dist = Math.sqrt(dx * dx + dy * dy);
						if (dist > waferRadius - 8) return false;
						// Notch exclusion at 6 o'clock bottom center
						if (Math.abs(dx) < 14 && py > cy + waferRadius - 16) return false;
						return true;
					});

					if (!fits) continue;

					const dist = Math.sqrt((x + dieW / 2 - cx) ** 2 + (y + dieH / 2 - cy) ** 2);
					const normR = dist / (waferRadius - 8);
					const rnd = Math.random();

					// Binning for massive reticle-limit die:
					// - Bin 1: Perfect (All cores enabled, zero defect) ~55%
					// - Bin 2: Defeatured (Defects in redundant cores, cores disabled) ~33%
					// - Bin X: Parametric fallout (Critical path / scribe / dielectric breakdown) ~12%
					let bin: 1 | 2 | 'x' = 1;
					const disabledCores: number[] = [];

					if (normR > edgeDefectThreshold && rnd < 0.45) {
						bin = 'x'; // Edge lithography breakdown
					} else if (Math.abs(c - clusterX) <= 1 && Math.abs(r - clusterY) <= 1 && rnd < 0.65) {
						bin = 'x'; // Particle defect cluster
					} else if (rnd < 0.35) {
						bin = 2; // Defeatured SKU (cores disabled)
						const numDisabled = 2 + Math.floor(Math.random() * 3);
						while (disabledCores.length < numDisabled) {
							const coreIdx = Math.floor(Math.random() * 12);
							if (!disabledCores.includes(coreIdx)) disabledCores.push(coreIdx);
						}
					} else {
						bin = 1; // Perfect SKU
					}

					const hexId = `0x7E${lotNum.toString(16).toUpperCase()}` + ((r * cols + c) * 137).toString(16).toUpperCase().padStart(4, '0');
					const fmax = bin === 1 ? +(3.70 + Math.random() * 0.22).toFixed(2) : bin === 2 ? +(3.10 + Math.random() * 0.18).toFixed(2) : +(1.60 + Math.random() * 0.4).toFixed(2);
					const vmin = bin === 1 ? +(0.760 + Math.random() * 0.035).toFixed(3) : bin === 2 ? +(0.830 + Math.random() * 0.035).toFixed(3) : +(1.180 + Math.random() * 0.2).toFixed(3);
					const leakage = bin === 1 ? +(22.5 + Math.random() * 4.5).toFixed(1) : bin === 2 ? +(29.5 + Math.random() * 5.0).toFixed(1) : +(85.0 + Math.random() * 30.0).toFixed(1);

					dies.push({
						col: c,
						row: r,
						x,
						y,
						bin,
						id: hexId,
						fmax,
						vmin,
						leakage,
						disabledCores,
						tested: true
					});
				}
			}

			const subEl = document.getElementById('wafer-sub-meta');
			if (subEl) {
				subEl.textContent = `LOT #${lotNum}C-W${waferNum < 10 ? '0' + waferNum : waferNum} • 7nm HPC Node • Reticle Limit (740 mm²) • ${dies.length} Dies`;
			}

			// Update legend tallies (Concise strings, zero wrapping)
			const b1Count = dies.filter(d => d.bin === 1).length;
			const b2Count = dies.filter(d => d.bin === 2).length;
			const bxCount = dies.filter(d => d.bin === 'x').length;
			const total = dies.length;

			const legB1 = document.getElementById('leg-bin1-text');
			const legB2 = document.getElementById('leg-bin2-text');
			const legBx = document.getElementById('leg-binx-text');

			if (legB1) legB1.textContent = `Perfect (Bin 1): ${b1Count} (${((b1Count / total) * 100).toFixed(1)}%) • All Cores`;
			if (legB2) legB2.textContent = `Defeatured (Bin 2): ${b2Count} (${((b2Count / total) * 100).toFixed(1)}%) • Harvest`;
			if (legBx) legBx.textContent = `Fallout (Reject): ${bxCount} (${((bxCount / total) * 100).toFixed(1)}%) • Defect`;
		}

		generateWaferDies(false);

		function drawWafer() {
			if (!ctx || !canvas) return;
			ctx.clearRect(0, 0, canvas.width, canvas.height);

			// 1. Outer Wafer Substrate Circle
			ctx.save();
			ctx.beginPath();
			ctx.arc(cx, cy, waferRadius, 0, Math.PI * 2);
			const grad = ctx.createRadialGradient(cx - 30, cy - 30, 20, cx, cy, waferRadius);
			grad.addColorStop(0, '#1a2233');
			grad.addColorStop(0.7, '#111622');
			grad.addColorStop(1, '#0b0f17');
			ctx.fillStyle = grad;
			ctx.fill();

			ctx.lineWidth = 3;
			ctx.strokeStyle = '#38bdf8';
			ctx.stroke();

			// Wafer Notch at 6 o'clock (0° / bottom)
			ctx.beginPath();
			ctx.arc(cx, cy + waferRadius, 9, Math.PI, 0, true);
			ctx.fillStyle = '#0f172a';
			ctx.fill();
			ctx.stroke();
			ctx.restore();

			// 2. Render Massive Near-Reticle-Limit Silicon Dies
			for (const die of dies) {
				ctx.save();
				if (!die.tested) {
					ctx.fillStyle = 'rgba(255, 255, 255, 0.05)';
					ctx.fillRect(die.x, die.y, dieW, dieH);
				} else if (die.bin === 1) {
					ctx.fillStyle = '#10b981';
					ctx.fillRect(die.x, die.y, dieW, dieH);

					ctx.strokeStyle = 'rgba(0, 0, 0, 0.35)';
					ctx.lineWidth = 0.5;
					const tileW = (dieW - 2) / 4;
					const tileH = (dieH - 2) / 3;
					for (let tr = 0; tr < 3; tr++) {
						for (let tc = 0; tc < 4; tc++) {
							ctx.strokeRect(die.x + 1 + tc * tileW, die.y + 1 + tr * tileH, tileW, tileH);
						}
					}
				} else if (die.bin === 2) {
					ctx.fillStyle = '#f59e0b';
					ctx.fillRect(die.x, die.y, dieW, dieH);

					const tileW = (dieW - 2) / 4;
					const tileH = (dieH - 2) / 3;
					ctx.lineWidth = 0.5;

					for (let tr = 0; tr < 3; tr++) {
						for (let tc = 0; tc < 4; tc++) {
							const cIdx = tr * 4 + tc;
							const tx = die.x + 1 + tc * tileW;
							const ty = die.y + 1 + tr * tileH;
							if (die.disabledCores.includes(cIdx)) {
								ctx.fillStyle = 'rgba(30, 10, 10, 0.85)';
								ctx.fillRect(tx, ty, tileW, tileH);
								ctx.strokeStyle = '#ef4444';
								ctx.strokeRect(tx, ty, tileW, tileH);
							} else {
								ctx.strokeStyle = 'rgba(0, 0, 0, 0.35)';
								ctx.strokeRect(tx, ty, tileW, tileH);
							}
						}
					}
				} else {
					ctx.fillStyle = '#ef4444';
					ctx.fillRect(die.x, die.y, dieW, dieH);

					ctx.strokeStyle = 'rgba(0, 0, 0, 0.6)';
					ctx.lineWidth = 1;
					ctx.beginPath();
					ctx.moveTo(die.x + 2, die.y + 2);
					ctx.lineTo(die.x + dieW - 2, die.y + dieH - 2);
					ctx.moveTo(die.x + dieW - 2, die.y + 2);
					ctx.lineTo(die.x + 2, die.y + dieH - 2);
					ctx.stroke();
				}

				ctx.strokeStyle = 'rgba(0, 0, 0, 0.7)';
				ctx.lineWidth = 1;
				ctx.strokeRect(die.x, die.y, dieW, dieH);
				ctx.restore();
			}

			// 3. Highlight Active / Inspected Die
			if (activeDie) {
				ctx.save();
				ctx.strokeStyle = '#00f0ff';
				ctx.lineWidth = 2.5;
				ctx.shadowColor = '#00f0ff';
				ctx.shadowBlur = 10;
				ctx.strokeRect(activeDie.x - 1, activeDie.y - 1, dieW + 2, dieH + 2);

				ctx.strokeStyle = 'rgba(0, 240, 255, 0.5)';
				ctx.lineWidth = 1;
				ctx.setLineDash([3, 3]);
				ctx.beginPath();
				ctx.moveTo(activeDie.x + dieW / 2, 16);
				ctx.lineTo(activeDie.x + dieW / 2, 384);
				ctx.moveTo(16, activeDie.y + dieH / 2);
				ctx.lineTo(384, activeDie.y + dieH / 2);
				ctx.stroke();
				ctx.restore();
			}
		}

		function updateTelemetry(die: WaferDie) {
			const idEl = document.getElementById('wp-id');
			const posEl = document.getElementById('wp-pos');
			const binEl = document.getElementById('wp-bin');
			const configEl = document.getElementById('wp-config');
			const areaEl = document.getElementById('wp-area');
			const fmaxEl = document.getElementById('wp-fmax');
			const vminEl = document.getElementById('wp-vmin');
			const leakEl = document.getElementById('wp-leak');

			if (idEl) idEl.textContent = die.id;
			if (posEl) posEl.textContent = `(${die.col}, ${die.row})`;
			if (binEl) {
				if (die.bin === 1) {
					binEl.textContent = 'Perfect (Bin 1)';
					binEl.style.color = '#10b981';
				} else if (die.bin === 2) {
					binEl.textContent = 'Defeatured (Bin 2)';
					binEl.style.color = '#f59e0b';
				} else {
					binEl.textContent = 'Fallout (Reject)';
					binEl.style.color = '#ef4444';
				}
			}
			if (configEl) {
				if (die.bin === 1) {
					configEl.textContent = 'All Active';
					configEl.style.color = '#10b981';
				} else if (die.bin === 2) {
					configEl.textContent = `-${die.disabledCores.length} Cores`;
					configEl.style.color = '#f59e0b';
				} else {
					configEl.textContent = 'Defect Fail';
					configEl.style.color = '#ef4444';
				}
			}
			if (areaEl) areaEl.textContent = '740 mm²';
			if (fmaxEl) fmaxEl.textContent = `${die.fmax} GHz`;
			if (vminEl) vminEl.textContent = `${die.vmin} V`;
			if (leakEl) leakEl.textContent = `${die.leakage} mA`;
		}

		function handleCanvasPointer(e: MouseEvent) {
			if (!canvas) return;
			const rect = canvas.getBoundingClientRect();
			const px = (e.clientX - rect.left) * (canvas.width / rect.width);
			const py = (e.clientY - rect.top) * (canvas.height / rect.height);

			const found = dies.find(d => px >= d.x && px <= d.x + dieW && py >= d.y && py <= d.y + dieH);
			if (found) {
				activeDie = found;
				updateTelemetry(found);
				drawWafer();
			}
		}

		canvas.addEventListener('mousemove', handleCanvasPointer);
		canvas.addEventListener('click', handleCanvasPointer);

		function openWaferModal() {
			modal.classList.remove('hidden');
			if (!activeDie && dies.length) {
				activeDie = dies[Math.floor(dies.length / 2)];
				updateTelemetry(activeDie);
			}
			drawWafer();
		}

		function closeWaferModal() {
			modal.classList.add('hidden');
		}

		closeBtn?.addEventListener('click', closeWaferModal);
		backdrop?.addEventListener('click', closeWaferModal);

		// DYNAMIC RANDOMIZATION & ATE POGO SCAN
		scanBtn?.addEventListener('click', () => {
			if (isScanning) return;
			isScanning = true;

			generateWaferDies(true);
			dies.forEach(d => { d.tested = false; });
			activeDie = null;
			drawWafer();

			const yieldValEl = document.getElementById('wafer-yield-val');
			const yieldBarEl = document.getElementById('wafer-yield-bar');
			const d0El = document.getElementById('wafer-d0-val');

			let idx = 0;
			const batchSize = 4;
			const total = dies.length;

			function stepScan() {
				const end = Math.min(idx + batchSize, total);
				for (let i = idx; i < end; i++) {
					dies[i].tested = true;
				}
				idx = end;
				activeDie = dies[idx - 1] || null;
				if (activeDie) updateTelemetry(activeDie);

				const testedCount = dies.filter(d => d.tested).length;
				const goodCount = dies.filter(d => d.tested && d.bin !== 'x').length;
				const curYield = testedCount ? ((goodCount / testedCount) * 100).toFixed(1) : '0.0';

				if (yieldValEl) yieldValEl.textContent = `${curYield}%`;
				if (yieldBarEl) yieldBarEl.style.width = `${curYield}%`;

				audioEngine.playProbeTick();
				drawWafer();

				if (idx < total) {
					requestAnimationFrame(stepScan);
				} else {
					isScanning = false;
					const finalYield = ((goodCount / total) * 100).toFixed(1);
					if (yieldValEl) yieldValEl.textContent = `${finalYield}%`;
					if (yieldBarEl) yieldBarEl.style.width = `${finalYield}%`;
					if (d0El) {
						const d0 = (0.075 + Math.random() * 0.015).toFixed(3);
						d0El.textContent = `D₀: ${d0}/cm²`;
					}
				}
			}

			requestAnimationFrame(stepScan);
		});

		randomBtn?.addEventListener('click', () => {
			if (!dies.length) return;
			const r = dies[Math.floor(Math.random() * dies.length)];
			activeDie = r;
			updateTelemetry(r);
			drawWafer();
		});

		(window as any).__openWaferMap = openWaferModal;
	}

	// -------------------------------------------------------------
	// INTERACTIVE HARDWARE EASTER EGGS CORE
	// -------------------------------------------------------------
	function initEasterEggs() {
		let isZeroG = false;
		let isTilt = false;
		let isBreakout = false;
		let isMagnet = false;
		let isXRay = false;

		const zerogHud = document.getElementById('zerog-hud');
		const zerogResetBtn = document.getElementById('zerog-reset-btn');
		const tiltHud = document.getElementById('tilt-hud');
		const tiltExitBtn = document.getElementById('tilt-exit-btn');
		const breakoutHud = document.getElementById('breakout-hud');
		const breakoutExitBtn = document.getElementById('breakout-exit-btn');
		const magnetHud = document.getElementById('magnet-hud');
		const magnetExitBtn = document.getElementById('magnet-exit-btn');
		const xrayHud = document.getElementById('xray-hud');
		const xrayExitBtn = document.getElementById('xray-exit-btn');

		const extrasModal = document.getElementById('lab-extras-modal');
		const extrasCloseBtn = document.getElementById('extras-close-btn');

		// 1. REFINED ZERO-G DROP (OVERFLOW LOCK & SLEEP)
		interface PhysicsBody {
			el: HTMLElement;
			x: number;
			y: number;
			prevX: number;
			prevY: number;
			angle: number;
			prevAngle: number;
			width: number;
			height: number;
			initialLeft: number;
			initialTop: number;
		}

		let bodies: PhysicsBody[] = [];
		let animId = 0;
		let draggedBody: PhysicsBody | null = null;
		let dragOffsetX = 0;
		let dragOffsetY = 0;
		let lastPointerX = 0;
		let lastPointerY = 0;

		function startZeroG() {
			if (isZeroG) return;
			if (isTilt) toggleTilt(false);
			if (isBreakout) resetBreakout();
			if (isMagnet) resetMagnet();
			if (isXRay) resetXRay();

			isZeroG = true;
			zerogHud?.classList.remove('hidden');

			// Prevent document scroll bounds from expanding below footer
			document.documentElement.style.overflow = 'hidden';
			document.body.style.overflow = 'hidden';

			// Sleep active Three.js CAD viewer loop to save GPU/CPU
			window.dispatchEvent(new CustomEvent('pause-cad-render'));

			const selector = '.card, .benchmark-card, .debug-card, .cad-model-card, .hero .avatar-wrap';
			const rawElements = Array.from(document.querySelectorAll<HTMLElement>(selector));
			const winH = window.innerHeight;
			const winW = window.innerWidth;

			// Target visible cards to eliminate off-screen physics thrashing
			const elements = rawElements.filter((el) => {
				const rect = el.getBoundingClientRect();
				return rect.bottom > -150 && rect.top < winH + 350;
			});

			bodies = elements.map((el) => {
				const rect = el.getBoundingClientRect();
				el.style.transform = 'translate3d(0, 0, 0) rotate(0deg)';
				el.style.transition = 'none';
				el.style.willChange = 'transform';
				el.style.cursor = 'grab';

				return {
					el,
					x: rect.left,
					y: rect.top,
					prevX: rect.left + (Math.random() - 0.5) * 4,
					prevY: rect.top - Math.random() * 3,
					angle: 0,
					prevAngle: (Math.random() - 0.5) * 0.03,
					width: rect.width,
					height: rect.height,
					initialLeft: rect.left,
					initialTop: rect.top
				};
			});

			runPhysicsLoop();
		}

		function resetZeroG() {
			if (!isZeroG) return;
			isZeroG = false;
			cancelAnimationFrame(animId);
			animId = 0;
			zerogHud?.classList.add('hidden');

			document.documentElement.style.overflow = '';
			document.body.style.overflow = '';
			window.dispatchEvent(new CustomEvent('resume-cad-render'));

			bodies.forEach((b) => {
				b.el.style.transition = 'transform 0.55s cubic-bezier(0.25, 1, 0.5, 1)';
				b.el.style.transform = 'translate3d(0, 0, 0) rotate(0deg)';
				b.el.style.cursor = '';
			});

			setTimeout(() => {
				bodies.forEach((b) => {
					b.el.style.transition = '';
					b.el.style.willChange = '';
					b.el.style.transform = '';
				});
				bodies = [];
			}, 600);
		}

		function runPhysicsLoop() {
			const gravity = 0.45;
			const friction = 0.985;
			const restitution = 0.48;
			let settledFrames = 0;

			function step() {
				if (!isZeroG) return;
				const winW = window.innerWidth;
				const winH = window.innerHeight;
				let totalKinetic = 0;

				for (const b of bodies) {
					if (b === draggedBody) {
						b.prevX = b.x;
						b.prevY = b.y;
						b.x = lastPointerX - dragOffsetX;
						b.y = lastPointerY - dragOffsetY;
					} else {
						const vx = (b.x - b.prevX) * friction;
						const vy = (b.y - b.prevY) * friction + gravity;
						const vAngle = (b.angle - b.prevAngle) * friction;

						b.prevX = b.x;
						b.prevY = b.y;
						b.x += vx;
						b.y += vy;
						b.prevAngle = b.angle;
						b.angle += vAngle;

						totalKinetic += Math.abs(vx) + Math.abs(vy);

						// Strict viewport bottom floor clamp
						if (b.y + b.height > winH - 12) {
							b.y = winH - 12 - b.height;
							b.prevY = b.y + vy * restitution;
							b.prevAngle += vx * 0.002;
						}
						// Left/right bounds
						if (b.x < 8) {
							b.x = 8;
							b.prevX = b.x + vx * restitution;
						}
						if (b.x + b.width > winW - 8) {
							b.x = winW - 8 - b.width;
							b.prevX = b.x + vx * restitution;
						}
					}

					const dx = b.x - b.initialLeft;
					const dy = b.y - b.initialTop;
					const deg = (b.angle * 180) / Math.PI;
					b.el.style.transform = `translate3d(${dx.toFixed(2)}px, ${dy.toFixed(2)}px, 0) rotate(${deg.toFixed(2)}deg)`;
				}

				// Sleep physics loop when rested to achieve 0% idle CPU
				if (!draggedBody && totalKinetic < 0.08) {
					settledFrames++;
					if (settledFrames > 25) {
						animId = 0;
						return;
					}
				} else {
					settledFrames = 0;
				}

				animId = requestAnimationFrame(step);
			}

			animId = requestAnimationFrame(step);
		}

		window.addEventListener('pointerdown', (e) => {
			if (!isZeroG) return;
			const target = (e.target as HTMLElement).closest('.card, .benchmark-card, .debug-card, .cad-model-card, .hero .avatar-wrap') as HTMLElement | null;
			if (!target) return;
			const body = bodies.find((b) => b.el === target);
			if (body) {
				draggedBody = body;
				dragOffsetX = e.clientX - body.x;
				dragOffsetY = e.clientY - body.y;
				lastPointerX = e.clientX;
				lastPointerY = e.clientY;
				body.el.style.cursor = 'grabbing';
				if (!animId) runPhysicsLoop();
			}
		});

		window.addEventListener('pointermove', (e) => {
			if (draggedBody) {
				lastPointerX = e.clientX;
				lastPointerY = e.clientY;
			}
		});

		window.addEventListener('pointerup', () => {
			if (draggedBody) {
				draggedBody.el.style.cursor = 'grab';
				draggedBody = null;
			}
		});

		if (zerogResetBtn) zerogResetBtn.addEventListener('click', resetZeroG);

		// 2. 3D TILT VIEWPORT
		const mainEl = document.querySelector('main') as HTMLElement | null;
		function handleTiltMove(e: MouseEvent) {
			if (!isTilt || !mainEl) return;
			const nx = (e.clientX / window.innerWidth - 0.5) * 16;
			const ny = (e.clientY / window.innerHeight - 0.5) * -16;
			mainEl.style.transform = `perspective(1200px) rotateY(${nx.toFixed(2)}deg) rotateX(${ny.toFixed(2)}deg) scale(0.985)`;
		}

		function handleOrientation(e: DeviceOrientationEvent) {
			if (!isTilt || !mainEl || !e.gamma || !e.beta) return;
			const nx = Math.max(-15, Math.min(15, e.gamma));
			const ny = Math.max(-15, Math.min(15, (e.beta - 45) * 0.7));
			mainEl.style.transform = `perspective(1200px) rotateY(${nx.toFixed(2)}deg) rotateX(${-ny.toFixed(2)}deg) scale(0.985)`;
		}

		function toggleTilt(force?: boolean) {
			const next = typeof force === 'boolean' ? force : !isTilt;
			if (next === isTilt) return;
			if (next) {
				if (isZeroG) resetZeroG();
				if (isBreakout) resetBreakout();
				if (isMagnet) resetMagnet();
				if (isXRay) resetXRay();
			}
			isTilt = next;

			if (isTilt) {
				tiltHud?.classList.remove('hidden');
				window.addEventListener('mousemove', handleTiltMove);
				if (typeof (DeviceOrientationEvent as any)?.requestPermission === 'function') {
					(DeviceOrientationEvent as any).requestPermission().then((state: string) => {
						if (state === 'granted') {
							window.addEventListener('deviceorientation', handleOrientation);
						}
					}).catch(() => {});
				} else {
					window.addEventListener('deviceorientation', handleOrientation);
				}
				if (mainEl) mainEl.style.transition = 'transform 0.12s ease-out';
			} else {
				tiltHud?.classList.add('hidden');
				window.removeEventListener('mousemove', handleTiltMove);
				window.removeEventListener('deviceorientation', handleOrientation);
				if (mainEl) {
					mainEl.style.transition = 'transform 0.4s ease';
					mainEl.style.transform = '';
					setTimeout(() => { if (mainEl) mainEl.style.transition = ''; }, 400);
				}
			}
		}

		if (tiltExitBtn) tiltExitBtn.addEventListener('click', () => toggleTilt(false));

		// 3. ATARI BREAKOUT / SILICON DIE SMASHER
		const boScoreEl = document.getElementById('bo-score');
		let breakoutPaddle: HTMLElement | null = null;
		let breakoutBall: HTMLElement | null = null;
		let breakoutAnimId = 0;
		let boScore = 0;
		let ballX = 0;
		let ballY = 0;
		let ballVx = 6;
		let ballVy = -6;
		let paddleX = 0;
		const paddleW = 140;
		const paddleH = 14;

		function play8BitTone(freq: number, dur = 0.05) {
			try {
				const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
				if (!AudioCtx) return;
				const ctx = new AudioCtx();
				const osc = ctx.createOscillator();
				const gain = ctx.createGain();
				osc.type = 'square';
				osc.frequency.setValueAtTime(freq, ctx.currentTime);
				gain.gain.setValueAtTime(0.06, ctx.currentTime);
				gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + dur);
				osc.connect(gain);
				gain.connect(ctx.destination);
				osc.start();
				osc.stop(ctx.currentTime + dur);
				setTimeout(() => ctx.close(), dur * 1000 + 80);
			} catch {}
		}

		function handlePaddleMove(e: MouseEvent) {
			if (!isBreakout || !breakoutPaddle) return;
			paddleX = Math.max(10, Math.min(window.innerWidth - paddleW - 10, e.clientX - paddleW / 2));
			breakoutPaddle.style.transform = `translate3d(${paddleX}px, 0, 0)`;
		}

		function startBreakout() {
			if (isBreakout) return;
			if (isZeroG) resetZeroG();
			if (isTilt) toggleTilt(false);
			if (isMagnet) resetMagnet();
			if (isXRay) resetXRay();

			isBreakout = true;
			boScore = 0;
			if (boScoreEl) boScoreEl.textContent = '0';
			breakoutHud?.classList.remove('hidden');

			if (!breakoutPaddle) {
				breakoutPaddle = document.createElement('div');
				breakoutPaddle.className = 'breakout-paddle';
				document.body.appendChild(breakoutPaddle);
			}
			breakoutPaddle.style.display = 'block';
			paddleX = window.innerWidth / 2 - paddleW / 2;
			breakoutPaddle.style.transform = `translate3d(${paddleX}px, 0, 0)`;

			if (!breakoutBall) {
				breakoutBall = document.createElement('div');
				breakoutBall.className = 'breakout-ball';
				document.body.appendChild(breakoutBall);
			}
			breakoutBall.style.display = 'block';
			ballX = window.innerWidth / 2 - 7;
			ballY = window.innerHeight - 80;
			ballVx = (Math.random() > 0.5 ? 6 : -6);
			ballVy = -7;

			window.addEventListener('mousemove', handlePaddleMove, { passive: true });

			const cards = Array.from(document.querySelectorAll<HTMLElement>('.card, .benchmark-card, .debug-card'));

			function loopBreakout() {
				if (!isBreakout) return;
				const winW = window.innerWidth;
				const winH = window.innerHeight;

				ballX += ballVx;
				ballY += ballVy;

				// Walls
				if (ballX <= 6) { ballX = 6; ballVx = Math.abs(ballVx); play8BitTone(330); }
				if (ballX >= winW - 20) { ballX = winW - 20; ballVx = -Math.abs(ballVx); play8BitTone(330); }
				if (ballY <= 40) { ballY = 40; ballVy = Math.abs(ballVy); play8BitTone(330); }

				// Paddle Collision
				const paddleY = winH - 32;
				if (ballY + 14 >= paddleY && ballY <= paddleY + paddleH && ballX + 14 >= paddleX && ballX <= paddleX + paddleW) {
					ballY = paddleY - 14;
					const hitOffset = (ballX + 7 - (paddleX + paddleW / 2)) / (paddleW / 2);
					ballVx = hitOffset * 8;
					ballVy = -Math.max(6, Math.abs(ballVy));
					play8BitTone(520, 0.07);
				}

				// Card Collisions
				for (const card of cards) {
					const rect = card.getBoundingClientRect();
					if (
						ballX + 14 >= rect.left &&
						ballX <= rect.right &&
						ballY + 14 >= rect.top &&
						ballY <= rect.bottom
					) {
						ballVy = -ballVy;
						card.classList.add('breakout-hit');
						setTimeout(() => card.classList.remove('breakout-hit'), 280);
						boScore += 100;
						if (boScoreEl) boScoreEl.textContent = boScore.toString();
						play8BitTone(880, 0.08);
						break;
					}
				}

				// Miss / Respawn
				if (ballY > winH + 30) {
					ballX = paddleX + paddleW / 2 - 7;
					ballY = winH - 80;
					ballVy = -7;
					ballVx = (Math.random() > 0.5 ? 6 : -6);
					play8BitTone(180, 0.15);
				}

				if (breakoutBall) {
					breakoutBall.style.transform = `translate3d(${ballX.toFixed(1)}px, ${ballY.toFixed(1)}px, 0)`;
				}

				breakoutAnimId = requestAnimationFrame(loopBreakout);
			}

			breakoutAnimId = requestAnimationFrame(loopBreakout);
		}

		function resetBreakout() {
			if (!isBreakout) return;
			isBreakout = false;
			cancelAnimationFrame(breakoutAnimId);
			breakoutHud?.classList.add('hidden');
			window.removeEventListener('mousemove', handlePaddleMove);
			if (breakoutPaddle) breakoutPaddle.style.display = 'none';
			if (breakoutBall) breakoutBall.style.display = 'none';
			document.querySelectorAll('.breakout-hit').forEach((el) => el.classList.remove('breakout-hit'));
		}

		breakoutExitBtn?.addEventListener('click', resetBreakout);

		// 4. ELECTROSTATIC FORCE FIELD / MAGNETIC REPULSION
		let magnetCards: HTMLElement[] = [];
		function handleMagnetMove(e: MouseEvent) {
			if (!isMagnet) return;
			const mx = e.clientX;
			const my = e.clientY;
			const radius = 260;

			for (const card of magnetCards) {
				const rect = card.getBoundingClientRect();
				const cx = rect.left + rect.width / 2;
				const cy = rect.top + rect.height / 2;
				const dx = cx - mx;
				const dy = cy - my;
				const dist = Math.hypot(dx, dy);

				if (dist < radius && dist > 1) {
					const norm = 1 - dist / radius;
					const force = Math.pow(norm, 1.8) * 42;
					const pushX = (dx / dist) * force;
					const pushY = (dy / dist) * force;
					const rotX = -(pushY * 0.22);
					const rotY = pushX * 0.22;
					card.style.transform = `translate3d(${pushX.toFixed(1)}px, ${pushY.toFixed(1)}px, 0) rotateX(${rotX.toFixed(1)}deg) rotateY(${rotY.toFixed(1)}deg)`;
				} else {
					card.style.transform = '';
				}
			}
		}

		function startMagnet() {
			if (isMagnet) return;
			if (isZeroG) resetZeroG();
			if (isTilt) toggleTilt(false);
			if (isBreakout) resetBreakout();
			if (isXRay) resetXRay();

			isMagnet = true;
			magnetHud?.classList.remove('hidden');
			magnetCards = Array.from(document.querySelectorAll<HTMLElement>('.card, .benchmark-card, .debug-card'));
			magnetCards.forEach((c) => {
				c.style.transition = 'transform 0.15s ease-out';
			});
			window.addEventListener('mousemove', handleMagnetMove, { passive: true });
		}

		function resetMagnet() {
			if (!isMagnet) return;
			isMagnet = false;
			magnetHud?.classList.add('hidden');
			window.removeEventListener('mousemove', handleMagnetMove);
			magnetCards.forEach((c) => {
				c.style.transition = 'transform 0.4s cubic-bezier(0.25, 1, 0.5, 1)';
				c.style.transform = '';
				setTimeout(() => { c.style.transition = ''; }, 400);
			});
			magnetCards = [];
		}

		magnetExitBtn?.addEventListener('click', resetMagnet);

		// 5. X-RAY SILICON & PCB SCANNER
		let xrayReticle: HTMLElement | null = null;
		function handleXRayMove(e: MouseEvent) {
			if (!isXRay || !xrayReticle) return;
			xrayReticle.style.transform = `translate3d(${e.clientX - 110}px, ${e.clientY - 110}px, 0)`;
		}

		function startXRay() {
			if (isXRay) return;
			if (isZeroG) resetZeroG();
			if (isTilt) toggleTilt(false);
			if (isBreakout) resetBreakout();
			if (isMagnet) resetMagnet();

			isXRay = true;
			xrayHud?.classList.remove('hidden');
			document.body.classList.add('xray-mode');

			if (!xrayReticle) {
				xrayReticle = document.createElement('div');
				xrayReticle.className = 'xray-reticle';
				xrayReticle.innerHTML = `
					<div class="xray-crosshair-h"></div>
					<div class="xray-crosshair-v"></div>
					<div class="xray-label mono">7nm HPC SCAN</div>
				`;
				document.body.appendChild(xrayReticle);
			}
			xrayReticle.style.display = 'block';
			window.addEventListener('mousemove', handleXRayMove, { passive: true });
		}

		function resetXRay() {
			if (!isXRay) return;
			isXRay = false;
			xrayHud?.classList.add('hidden');
			document.body.classList.remove('xray-mode');
			window.removeEventListener('mousemove', handleXRayMove);
			if (xrayReticle) {
				xrayReticle.style.display = 'none';
			}
		}

		xrayExitBtn?.addEventListener('click', resetXRay);

		// Global API Exports
		(window as any).__toggleZeroG = () => (isZeroG ? resetZeroG() : startZeroG());
		(window as any).__toggleTilt = (force?: boolean) => toggleTilt(force);
		(window as any).__toggleBreakout = () => (isBreakout ? resetBreakout() : startBreakout());
		(window as any).__toggleMagnet = () => (isMagnet ? resetMagnet() : startMagnet());
		(window as any).__toggleXRay = () => (isXRay ? resetXRay() : startXRay());
		(window as any).__toggleLabExtras = () => { extrasModal?.classList.toggle('hidden'); };

		const kbLabEl = document.getElementById('keyboard-lab');
		function isNearKeyboardLab(): boolean {
			if (!kbLabEl) return false;
			const rect = kbLabEl.getBoundingClientRect();
			return rect.bottom > -80 && rect.top < window.innerHeight + 80;
		}

		window.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				const waferModal = document.getElementById('wafer-modal');
				if (waferModal && !waferModal.classList.contains('hidden')) {
					waferModal.classList.add('hidden');
					return;
				}
				if (isZeroG || isTilt || isBreakout || isMagnet || isXRay || (extrasModal && !extrasModal.classList.contains('hidden'))) {
					e.preventDefault();
					if (isZeroG) resetZeroG();
					if (isTilt) toggleTilt(false);
					if (isBreakout) resetBreakout();
					if (isMagnet) resetMagnet();
					if (isXRay) resetXRay();
					extrasModal?.classList.add('hidden');
				}
				return;
			}

			const hasModifiers = (e.ctrlKey || e.metaKey) && e.altKey;
			if (!hasModifiers) return;

			const activeTag = document.activeElement?.tagName;
			if (activeTag === 'INPUT' || activeTag === 'TEXTAREA' || activeTag === 'SELECT') return;

			const termModal = document.getElementById('terminal-modal');
			if (termModal && termModal.classList.contains('open')) return;

			if (isNearKeyboardLab()) return;
			if (document.activeElement?.closest('#keyboard-lab')) return;

			if (e.code === 'KeyG') {
				e.preventDefault();
				(window as any).__toggleZeroG();
			} else if (e.code === 'KeyH') {
				e.preventDefault();
				(window as any).__toggleTilt();
			}
		});

		// Lab Extras Drawer Wire-up (Alphabetical Order 3-B-C-M-S-W-X-Z)
		document.getElementById('trigger-tilt-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			(window as any).__toggleTilt();
		});
		document.getElementById('trigger-breakout-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			(window as any).__toggleBreakout();
		});
		document.getElementById('trigger-boop-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			(window as any).__boopDog?.();
		});
		document.getElementById('trigger-magnet-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			(window as any).__toggleMagnet();
		});
		document.getElementById('trigger-wafer-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			(window as any).__openWaferMap?.();
		});
		document.getElementById('trigger-xray-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			(window as any).__toggleXRay();
		});
		document.getElementById('trigger-zerog-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			(window as any).__toggleZeroG();
		});

		// Switch sound button in drawer
		const drawerSoundBtn = document.getElementById('trigger-switch-sound-btn');
		const drawerSoundBadge = document.getElementById('extras-sound-badge');
		const drawerSoundDesc = document.getElementById('extras-sound-desc');

		function updateDrawerSoundUI(p: string) {
			if (!drawerSoundBadge) return;
			const badges: Record<string, string> = {
				off: 'Sound: Off',
				blue: 'Blue (Clicky)',
				red: 'Red (Linear)',
				modelm: 'Model M (Spring)'
			};
			drawerSoundBadge.textContent = badges[p] || 'Sound: Off';
			if (drawerSoundDesc) {
				drawerSoundDesc.textContent = p === 'off' ? 'Procedural Web Audio switch synth' : `Acoustics active: ${badges[p]}`;
			}
		}

		updateDrawerSoundUI(audioEngine.profile);
		window.addEventListener('switch-sound-changed', ((e: CustomEvent) => {
			if (e.detail?.profile) updateDrawerSoundUI(e.detail.profile);
		}) as EventListener);

		drawerSoundBtn?.addEventListener('click', () => {
			const current = audioEngine.profile;
			const order = ['off', 'blue', 'red', 'modelm'];
			const next = order[(order.indexOf(current) + 1) % order.length] as any;
			audioEngine.setProfile(next);
			updateDrawerSoundUI(next);
			if (next !== 'off') audioEngine.play('KeyA');
		});

		document.getElementById('trigger-wafer-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			(window as any).__openWaferMap?.();
		});

		document.getElementById('trigger-zerog-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			(window as any).__toggleZeroG();
		});

		extrasCloseBtn?.addEventListener('click', () => extrasModal?.classList.add('hidden'));

		document.addEventListener('click', (e) => {
			const target = e.target as HTMLElement;
			if (extrasModal && !extrasModal.classList.contains('hidden')) {
				if (!extrasModal.contains(target) && !target.closest('#footer-extras-btn')) {
					extrasModal.classList.add('hidden');
				}
			}
		});
	}

	initEasterEggs();
	initWaferInspector();
	initDogBoop();

	document.addEventListener('astro:page-load', () => {
		initEasterEggs();
		initWaferInspector();
		initDogBoop();
	});
</script>

