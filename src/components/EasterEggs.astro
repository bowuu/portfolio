	/* CHIEF MORALE OFFICER: AVATAR BOOP & PARTICLES */
	:global(.avatar-img.booped) {
		animation: avatarBoop 0.42s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
	}
	@keyframes avatarBoop {
		0% { transform: scale(1); }
		28% { transform: scale(1.18, 0.84) rotate(-3deg); }
		55% { transform: scale(0.92, 1.12) rotate(2deg); }
		78% { transform: scale(1.04, 0.98); }
		100% { transform: scale(1); }
	}

	:global(.morale-rf-pill),
	:global(.morale-boost-pill) {
		position: absolute;
		top: -8px;
		left: 50%;
		transform: translate(-50%, 0);
		background: rgba(15, 23, 42, 0.94);
		border: 1px solid #38bdf8;
		color: #f8fafc;
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4), 0 0 12px rgba(56, 189, 248, 0.4);
		font-size: 0.78em;
		font-weight: 700;
		padding: 0.35em 0.85em;
		border-radius: 20px;
		pointer-events: none;
		white-space: nowrap;
		z-index: 1000;
		animation: floatPill 1.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}
	:global(.morale-boost-pill.bin-tier-3) {
		border-color: #f97316;
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4), 0 0 14px rgba(249, 115, 22, 0.5);
	}
	:global(.morale-boost-pill.bin-tier-4),
	:global(.morale-boost-pill.bin-tier-5) {
		border-color: #fbbf24;
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4), 0 0 18px rgba(251, 191, 36, 0.7);
		color: #fef08a;
	}
	@keyframes floatPill {
		0% { opacity: 0; transform: translate(-50%, 8px) scale(0.85); }
		15% { opacity: 1; transform: translate(-50%, -10px) scale(1.05); }
		70% { opacity: 1; transform: translate(-50%, -36px) scale(1); }
		100% { opacity: 0; transform: translate(-50%, -52px) scale(0.95); }
	}



	:global(.boop-particle) {
		position: absolute;
		top: 50%;
		left: 50%;
		font-size: 1.1em;
		pointer-events: none;
		z-index: 1000;
		animation: particleBurst 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}
	@keyframes particleBurst {
		0% { opacity: 1; transform: translate(-50%, -50%) scale(0.5); }
		60% { opacity: 1; transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) scale(1.2); }
		100% { opacity: 0; transform: translate(calc(-50% + var(--dx) * 1.3), calc(-50% + var(--dy) * 1.3)) scale(0.6); }
	}

	/* HARDWARE LAB EASTER EGG FULL-VIEWPORT CANVASES */
	.ee-canvas {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100vh;
		pointer-events: none;
		z-index: 999990;
	}

	/* 1. CRT BENCH OSCILLOSCOPE DEGAUSS & SCANLINES */
	#degauss-canvas {
		mix-blend-mode: screen;
		pointer-events: none;
	}
	:global(body.crt-active)::after {
		content: '';
		position: fixed;
		inset: 0;
		pointer-events: none;
		z-index: 999980;
		background: 
			linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.28) 50%),
			linear-gradient(90deg, rgba(255, 0, 0, 0.03), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.03));
		background-size: 100% 3px, 4px 100%;
		box-shadow: inset 0 0 140px rgba(0, 0, 0, 0.8), inset 0 0 40px rgba(0, 0, 0, 0.9);
	}
	:global(body.crt-degaussing main) {
		will-change: transform, filter;
	}

	/* 2. 3D SILICON CYCLONE SPHERE CORE & CUBE */
	.sphere-core {
		position: fixed;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		perspective: 1000px;
		pointer-events: none;
		z-index: 500;
	}
	.die-cube {
		width: 110px;
		height: 110px;
		position: relative;
		transform-style: preserve-3d;
		transition: transform 0.05s linear;
	}
	.die-face {
		position: absolute;
		width: 110px;
		height: 110px;
		background: rgba(15, 23, 42, 0.88);
		border: 1px solid #f97316;
		box-shadow: 0 0 20px rgba(249, 115, 22, 0.35), inset 0 0 16px rgba(249, 115, 22, 0.2);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.65em;
		font-weight: 700;
		color: #fbbf24;
		letter-spacing: 0.06em;
	}
	.die-front  { transform: rotateY(0deg) translateZ(55px); }
	.die-back   { transform: rotateY(180deg) translateZ(55px); }
	.die-left   { transform: rotateY(-90deg) translateZ(55px); }
	.die-right  { transform: rotateY(90deg) translateZ(55px); }
	.die-top    { transform: rotateX(90deg) translateZ(55px); }
	.die-face.die-bottom { transform: rotateX(-90deg) translateZ(55px); }
	.die-aura {
		position: absolute;
		inset: -35px;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(249, 115, 22, 0.3) 0%, transparent 70%);
		animation: auraPulse 2s ease-in-out infinite alternate;
	}
	@keyframes auraPulse {
		from { transform: scale(0.9); opacity: 0.6; }
		to { transform: scale(1.15); opacity: 1; }
	}

	/* 3. INFRARED THERMAL CAMERA VIEWPORT */
	:global(body.thermal-active main) {
		filter: invert(0.85) hue-rotate(185deg) saturate(3.2) contrast(1.35) !important;
		transition: filter 0.35s ease;
	}
	.thermal-scale-bar {
		position: fixed;
		right: 18px;
		top: 50%;
		transform: translateY(-50%);
		width: 36px;
		height: 260px;
		background: rgba(15, 23, 42, 0.92);
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 6px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: space-between;
		padding: 8px 4px;
		z-index: 999995;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
		pointer-events: none;
	}
	.ts-gradient {
		width: 10px;
		flex: 1;
		margin: 6px 0;
		border-radius: 3px;
		background: linear-gradient(to bottom, #ffffff 0%, #fde047 18%, #f97316 40%, #dc2626 62%, #7c3aed 82%, #0284c7 92%, #38bdf8 100%);
	}
	.ts-val {
		font-size: 0.58em;
		font-weight: 700;
		color: #f8fafc;
	}
	.ts-emissivity {
		font-size: 0.55em;
		color: rgb(var(--gray));
	}
	.thermal-spots {
		position: fixed;
		inset: 0;
		pointer-events: none;
		z-index: 999994;
	}
	.thermal-spot {
		position: absolute;
		display: flex;
		align-items: center;
		gap: 6px;
		pointer-events: none;
	}
	.spot-crosshair {
		width: 14px;
		height: 14px;
		border: 1px solid #ef4444;
		border-radius: 50%;
		position: relative;
	}
	.spot-crosshair::before, .spot-crosshair::after {
		content: '';
		position: absolute;
		background: #ef4444;
	}
	.spot-crosshair::before { top: 50%; left: -3px; right: -3px; height: 1px; transform: translateY(-50%); }
	.spot-crosshair::after { left: 50%; top: -3px; bottom: -3px; width: 1px; transform: translateX(-50%); }
	.spot-crosshair.active {
		border-color: #38bdf8;
	}
	.spot-crosshair.active::before, .spot-crosshair.active::after {
		background: #38bdf8;
	}
	.spot-label {
		font-size: 0.65em;
		font-weight: 700;
		background: rgba(15, 23, 42, 0.88);
		border: 1px solid rgba(255, 255, 255, 0.2);
		padding: 2px 6px;
		border-radius: 4px;
		color: #f8fafc;
		white-space: nowrap;
	}
	#t-spot-cursor {
		top: 0;
		left: 0;
		transition: transform 0.04s linear;
	}

	/* 4. QUANTUM TUNNELING CARD TARGETING */
	:global(body.quantum-active) .quantum-targetable {
		cursor: crosshair !important;
		transition: outline 0.15s ease, box-shadow 0.15s ease;
	}
	:global(body.quantum-active) .quantum-targetable:hover {
		outline: 2px dashed #38bdf8 !important;
		outline-offset: 4px !important;
		box-shadow: 0 0 20px rgba(56, 189, 248, 0.45) !important;
	}

