							<span>Probe Random Die</span>
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- LAB EXTRAS DRAWER / POPOVER (SORTED ALPHABETICALLY A-Z) -->
	<div id="lab-extras-modal" class="lab-extras-modal hidden" role="dialog" aria-modal="false" aria-label="Hardware Lab Easter Eggs" style="display: none;">
		<div class="extras-header">
			<div class="extras-title">
				<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
				</svg>
				<span>Hardware Lab Extras</span>
			</div>
			<button id="extras-close-btn" type="button" class="extras-close-btn" aria-label="Close Extras Drawer">&times;</button>
		</div>
		<div class="extras-grid">
			<!-- 1. 3D Cyclone (3) -->
			<button id="trigger-sphere-btn" class="extra-item-btn" type="button" title="3D Silicon Cyclone (Google Sphere Tribute)">
				<span class="item-icon">🌪️</span>
				<div class="item-meta">
					<strong class="item-name">3D Cyclone</strong>
					<span class="item-desc">Orbital 3D spherical cage around silicon die</span>
				</div>
				<kbd class="item-kbd">cyclone</kbd>
			</button>

			<!-- 2. 3D Tilt (3) -->
			<button id="trigger-tilt-btn" class="extra-item-btn" type="button" title="3D Viewport Parallax Hologram Tilt">
				<span class="item-icon">📐</span>
				<div class="item-meta">
					<strong class="item-name">3D Tilt</strong>
					<span class="item-desc">Parallax hologram perspective depth</span>
				</div>
				<kbd class="item-kbd">Ctrl+Alt+H</kbd>
			</button>

			<!-- 3. Chief Morale Officer (C) -->
			<button id="trigger-boop-btn" class="extra-item-btn" type="button" title="Boop Chief Morale Officer (She is a good girl!)">
				<span class="item-icon">🐾</span>
				<div class="item-meta">
					<strong class="item-name">Chief Morale Officer</strong>
					<span class="item-desc">Bin CMO silicon from standard to golden sample</span>
				</div>
				<kbd class="item-kbd">6.0 GHz Bin 1</kbd>
			</button>

			<!-- 4. CRT Degauss (C) -->
			<button id="trigger-degauss-btn" class="extra-item-btn" type="button" title="CRT Oscilloscope Electromagnetic Degauss Pulse">
				<span class="item-icon">⚡</span>
				<div class="item-meta">
					<strong class="item-name">CRT Degauss</strong>
					<span class="item-desc">Electromagnetic coil warp &amp; phosphor pulse</span>
				</div>
