		public playSequencerSound(type: string) {
			try {
				this.init();
				if (!this.ctx) return;
				const t = this.ctx.currentTime;
				if (type === 'relay') {
					// Telecom relay snap
					this.playImpulse(t, 3400, 0.006, 0.35);
					this.playTone(t, 1200, 'triangle', 0.012, 0.20);
					this.playImpulse(t + 0.008, 2200, 0.008, 0.25);
				} else if (type === 'bios') {
					// PC Motherboard Piezo buzzer
					this.playTone(t, 1000, 'square', 0.04, 0.15);
					this.playTone(t + 0.04, 800, 'square', 0.03, 0.12);
				} else if (type === 'seek') {
					// FDD stepper motor head step
					this.playImpulse(t, 2900, 0.004, 0.28);
					this.playTone(t, 340, 'triangle', 0.015, 0.18);
				} else if (type === 'printer') {
					// 9-pin dot-matrix printhead solenoid
					this.playImpulse(t, 4600, 0.005, 0.32);
					this.playTone(t, 2100, 'sawtooth', 0.009, 0.15);
				} else if (type === 'spark') {
					// High-voltage piezoelectric arc zap
					this.playImpulse(t, 5200, 0.015, 0.30);
					this.playTone(t, 850, 'sawtooth', 0.025, 0.18);
				} else if (type === 'modelm') {
					// Buckling spring clack
					this.playImpulse(t, 2850, 0.008, 0.30);
					this.playTone(t, 235, 'sine', 0.035, 0.28);
				}
			} catch {}
		}

