							<div class="probe-row"><span class="p-k">Bin:</span><span class="p-v" id="wp-bin">Perfect (Bin 1)</span></div>
							<div class="probe-row"><span class="p-k">Cores:</span><span class="p-v" id="wp-config">All Active</span></div>
							<div class="probe-row"><span class="p-k">Area:</span><span class="p-v" id="wp-area">740 mm²</span></div>
							<div class="probe-row"><span class="p-k">Fmax:</span><span class="p-v" id="wp-fmax">3.80 GHz</span></div>
							<div class="probe-row"><span class="p-k">Vmin:</span><span class="p-v" id="wp-vmin">0.775 V</span></div>
							<div class="probe-row"><span class="p-k">Iddq:</span><span class="p-v" id="wp-leak">24.5 mA</span></div>
						</div>
					</div>

					<!-- BIN DISTRIBUTION LEGEND -->
					<div class="wafer-legend">
						<div class="legend-item"><span class="leg-color bin1"></span><span id="leg-bin1-text">Perfect (Bin 1): 46 (55.4%) &bull; All Cores</span></div>
						<div class="legend-item"><span class="leg-color bin2"></span><span id="leg-bin2-text">Defeatured (Bin 2): 27 (32.5%) &bull; Harvest</span></div>
						<div class="legend-item"><span class="leg-color binx"></span><span id="leg-binx-text">Fallout (Reject): 10 (12.1%) &bull; Defect</span></div>
					</div>

					<!-- ACTIONS -->
					<div class="wafer-actions">
						<button id="wafer-scan-btn" type="button" class="wafer-btn primary" title="Randomize wafer defects & run ATE probe sweep">
							<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 0 1-9 9m9-9a9 9 0 0 0-9-9m9 9H3m9 9a9 9 0 0 1-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/></svg>
							<span>Run ATE Pogo Probe Scan</span>
						</button>
