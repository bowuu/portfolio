---
// EasterEggs.astro - Hardware & Silicon Validation Interactive Easter Eggs
// 1. 3D Viewport Parallax Hologram Tilt (perspective matrix tracking cursor/orientation)
// 2. Chief Morale Officer "Boop the Dog" (+10 dBm RF Telemetry & Mascot Animation)
// 3. Procedural Mechanical Switch Synthesizer (pure Web Audio API acoustics: Blue / Red / Model M)
// 4. 300mm ATE Silicon Wafer Die Sort Map (Reticle-Limit Massive Enterprise Die Architecture)
// 5. Zero-G Verlet Physics Element Collapse (pure vanilla physics, non-destructive GPU transforms)
---

<div id="easter-eggs-container">
	<!-- FLOATING HUDS -->
	<div id="zerog-hud" class="ee-hud zerog-hud hidden" style="display: none;">
		<span class="hud-pulse-dot"></span>
		<span class="hud-title">⚡ ZERO-G COLLAPSE ACTIVE &bull; DRAG &amp; FLING CARDS</span>
		<button id="zerog-reset-btn" type="button" class="ee-hud-btn">Resolder / Reassemble</button>
	</div>

	<div id="tilt-hud" class="ee-hud tilt-hud hidden" style="display: none;">
		<span class="hud-pulse-dot"></span>
		<span class="hud-title">📐 3D HOLOGRAM VIEWPORT TILT ACTIVE</span>
		<button id="tilt-exit-btn" type="button" class="ee-hud-btn">Exit (Esc)</button>
	</div>

	<!-- CRT BENCH OSCILLOSCOPE DEGAUSS HUD & CANVAS -->
	<div id="degauss-hud" class="ee-hud degauss-hud hidden" style="display: none;">
		<span class="hud-pulse-dot"></span>
		<span class="hud-title">⚡ CRT BENCH DEGAUSS &bull; ELECTROMAGNETIC PULSE</span>
		<button id="degauss-re-btn" type="button" class="ee-hud-btn">Pulse Coil</button>
		<button id="degauss-exit-btn" type="button" class="ee-hud-btn">Exit (Esc)</button>
	</div>
	<canvas id="degauss-canvas" class="ee-canvas hidden" aria-hidden="true" style="display: none;"></canvas>

	<!-- 3D SILICON CYCLONE SPHERE HUD & 3D CORE -->
	<div id="sphere-hud" class="ee-hud sphere-hud hidden" style="display: none;">
		<span class="hud-pulse-dot"></span>
		<span class="hud-title">🪐 3D SILICON CYCLONE &bull; DRAG TO ROTATE &bull; HOVER TO INSPECT</span>
		<button id="sphere-exit-btn" type="button" class="ee-hud-btn">Collapse to 2D (Esc)</button>
	</div>
	<div id="sphere-core" class="sphere-core hidden" aria-hidden="true" style="display: none;">
		<div class="die-cube">
			<div class="die-face die-front mono">3nm HPC CORE</div>
			<div class="die-face die-back mono">L3 64MB</div>
			<div class="die-face die-left mono">PCIe Gen5</div>
			<div class="die-face die-right mono">LPDDR5 PHY</div>
			<div class="die-face die-top mono">ATE BIST</div>
			<div class="die-face die-bottom mono">SUBSTRATE</div>
			<div class="die-aura"></div>
		</div>
	</div>

	<!-- QUANTUM TUNNELING DISINTEGRATION HUD & CANVAS -->
	<div id="quantum-hud" class="ee-hud quantum-hud hidden" style="display: none;">
		<span class="hud-pulse-dot"></span>
		<span class="hud-title">💨 QUANTUM TUNNELING &bull; CLICK ANY BOX TO DISSOLVE &bull; DRAG TO SWIRL DUST</span>
		<button id="quantum-all-btn" type="button" class="ee-hud-btn">Dissolve All</button>
		<button id="quantum-reassemble-btn" type="button" class="ee-hud-btn">Quantum Anneal (Restore All)</button>
		<button id="quantum-exit-btn" type="button" class="ee-hud-btn">Exit (Esc)</button>
	</div>
	<canvas id="quantum-canvas" class="ee-canvas hidden" aria-hidden="true" style="display: none;"></canvas>

	<!-- INFRARED THERMAL CAMERA HUD, CANVAS & SCALE -->
	<div id="thermal-hud" class="ee-hud thermal-hud hidden" style="display: none;">
		<div class="thermal-hud-inner">
			<span class="hud-pulse-dot"></span>
			<span class="hud-title">🌡️ THERMAL CAM &bull; <span id="thermal-tool-text">TOOL: LN2 CRYO-SPRAY (-196°C)</span></span>
			<button id="thermal-tool-btn" type="button" class="ee-hud-btn">Switch to Heat Gun (450°C)</button>
			<button id="thermal-reset-btn" type="button" class="ee-hud-btn">Normalize (24°C)</button>
			<button id="thermal-exit-btn" type="button" class="ee-hud-btn">Exit (Esc)</button>
		</div>
	</div>
	<div id="thermal-scale-bar" class="thermal-scale-bar hidden" aria-hidden="true" style="display: none;">
		<div class="ts-val max mono">150°C</div>
		<div class="ts-gradient"></div>
		<div class="ts-val min mono" id="ts-min-val">-196°C</div>
		<div class="ts-emissivity mono">ε: 0.95</div>
	</div>
	<div id="thermal-spots" class="thermal-spots hidden" aria-hidden="true" style="display: none;">
		<div class="thermal-spot" id="t-spot-cpu" style="top: 25%; left: 35%;">
			<div class="spot-crosshair"></div>
			<span class="spot-label mono">SP01 [CPU DIE] <strong id="t-cpu-val">98.4°C</strong></span>
		</div>
		<div class="thermal-spot" id="t-spot-vrm" style="top: 42%; left: 62%;">
			<div class="spot-crosshair"></div>
			<span class="spot-label mono">SP02 [PMIC VRM] <strong id="t-vrm-val">104.2°C</strong></span>
		</div>
		<div class="thermal-spot" id="t-spot-mem" style="top: 65%; left: 45%;">
			<div class="spot-crosshair"></div>
			<span class="spot-label mono">SP03 [LPDDR5] <strong id="t-mem-val">71.5°C</strong></span>
		</div>
		<div class="thermal-spot" id="t-spot-cursor">
			<div class="spot-crosshair active"></div>
			<span class="spot-label mono">PROBE <strong id="t-cursor-val">24.5°C</strong></span>
		</div>
	</div>
	<canvas id="thermal-canvas" class="ee-canvas hidden" aria-hidden="true" style="display: none;"></canvas>



	<!-- 300MM SILICON WAFER DIE SORT MODAL (RETICLE-LIMIT ENTERPRISE DIE) -->
	<div id="wafer-modal" class="wafer-modal hidden" role="dialog" aria-modal="true" aria-label="300mm Silicon Wafer Sort Inspector" style="display: none;">
		<div class="wafer-backdrop" id="wafer-backdrop"></div>
		<div class="wafer-dialog">
			<div class="wafer-modal-header">
				<div class="wafer-title-wrap">
					<span class="hud-pulse-dot"></span>
					<div class="wafer-title-meta">
