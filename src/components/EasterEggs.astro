						p.x += p.vx;
						p.y += p.vy;
						p.rot += p.vRot;

						const dist = Math.hypot(p.x - quantumPointerX, p.y - quantumPointerY);
						if (dist < 180 && dist > 2) {
							const force = (1 - dist / 180) * 4.5;
							p.vx += (-(p.y - quantumPointerY) / dist) * force;
							p.vy += ((p.x - quantumPointerX) / dist) * force;
						}
					}

