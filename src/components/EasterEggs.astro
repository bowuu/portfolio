				gain.gain.setValueAtTime(0.12, t);
				gain.gain.exponentialRampToValueAtTime(0.0001, t + 0.35);
				osc.connect(gain);
				gain.connect(this.ctx.destination);
				osc.start(t);
				osc.stop(t + 0.35);
