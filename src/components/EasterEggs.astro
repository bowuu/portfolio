---
// EasterEggs.astro - Hardware & Silicon Validation Interactive Easter Eggs
// 1. 3D Viewport Parallax Hologram Tilt (perspective matrix tracking cursor/orientation)
// 2. Chief Morale Officer "Boop the Dog" (+10 dBm RF Telemetry & Mascot Animation)
// 3. Procedural Mechanical Switch Synthesizer (pure Web Audio API acoustics: Blue / Red / Model M)
// 4. 300mm ATE Silicon Wafer Die Sort Map & Dynamic Yield Telemetry (interactive canvas)
// 5. Zero-G Verlet Physics Element Collapse (pure vanilla physics, non-destructive GPU transforms)
---

<div id="easter-eggs-container">
	<!-- FLOATING HUDS -->
	<div id="zerog-hud" class="ee-hud zerog-hud hidden">
		<span class="hud-pulse-dot"></span>
		<span class="hud-title">⚡ ZERO-G COLLAPSE ACTIVE &bull; DRAG &amp; FLING CARDS</span>
		<button id="zerog-reset-btn" type="button" class="ee-hud-btn">Resolder / Reassemble</button>
	</div>

	<div id="tilt-hud" class="ee-hud tilt-hud hidden">
		<span class="hud-pulse-dot"></span>
		<span class="hud-title">📐 3D HOLOGRAM VIEWPORT TILT ACTIVE</span>
		<button id="tilt-exit-btn" type="button" class="ee-hud-btn">Exit (Esc)</button>
	</div>

	<!-- 300MM SILICON WAFER DIE SORT MODAL -->
	<div id="wafer-modal" class="wafer-modal hidden" role="dialog" aria-modal="true" aria-label="300mm Silicon Wafer Sort Inspector">
		<div class="wafer-backdrop" id="wafer-backdrop"></div>
		<div class="wafer-dialog">
			<div class="wafer-modal-header">
				<div class="wafer-title-wrap">
					<span class="hud-pulse-dot"></span>
					<div class="wafer-title-meta">
						<span class="wafer-title">300mm ATE SILICON WAFER SORT</span>
						<span class="wafer-sub mono" id="wafer-sub-meta">LOT #850C-W14 &bull; 3nm FinFET &bull; 684 Gross Dies</span>
					</div>
				</div>
				<button id="wafer-close-btn" class="wafer-close-btn" type="button" aria-label="Close Wafer Inspector">&times;</button>
			</div>

			<div class="wafer-modal-body">
				<div class="wafer-canvas-wrap">
					<canvas id="wafer-canvas" width="400" height="400" aria-label="Wafer Die Sort Map"></canvas>
					<div class="wafer-notch-indicator mono">▼ Wafer Notch (0° / Flat)</div>
				</div>

				<div class="wafer-telemetry-panel">
					<!-- YIELD SUMMARY -->
					<div class="wafer-telemetry-box">
						<span class="w-box-title">Functional Yield</span>
						<div class="w-yield-display">
							<span class="w-yield-val mono" id="wafer-yield-val">96.2%</span>
							<span class="w-yield-badge mono" id="wafer-d0-val">D₀: 0.078/cm²</span>
						</div>
						<div class="w-yield-bar-wrap">
							<div class="w-yield-bar" id="wafer-yield-bar" style="width: 96.2%;"></div>
						</div>
					</div>

					<!-- ACTIVE DIE PROBE READOUT -->
					<div class="wafer-telemetry-box">
						<span class="w-box-title">Active Die Probe Telemetry</span>
						<div class="wafer-probe-grid mono" id="wafer-probe-grid">
							<div class="probe-row"><span class="p-k">Die ID:</span><span class="p-v" id="wp-id">0x850C6005</span></div>
							<div class="probe-row"><span class="p-k">Position:</span><span class="p-v" id="wp-pos">X: 14, Y: 15</span></div>
							<div class="probe-row"><span class="p-k">Bin Class:</span><span class="p-v" id="wp-bin">Bin 1 (Prime Core)</span></div>
							<div class="probe-row"><span class="p-k">Fmax Target:</span><span class="p-v" id="wp-fmax">4.82 GHz</span></div>
							<div class="probe-row"><span class="p-k">Vmin Voltage:</span><span class="p-v" id="wp-vmin">0.765 V</span></div>
							<div class="probe-row"><span class="p-k">Iddq Leak:</span><span class="p-v" id="wp-leak">12.4 mA</span></div>
						</div>
					</div>

					<!-- BIN DISTRIBUTION LEGEND -->
					<div class="wafer-legend">
						<div class="legend-item"><span class="leg-color bin1"></span><span id="leg-bin1-text">Bin 1 (Prime 3.8GHz+): 518 (75.7%)</span></div>
						<div class="legend-item"><span class="leg-color bin2"></span><span id="leg-bin2-text">Bin 2 (Eco 3.2GHz): 140 (20.5%)</span></div>
						<div class="legend-item"><span class="leg-color binx"></span><span id="leg-binx-text">Parametric Defect: 26 (3.8%)</span></div>
					</div>

					<!-- ACTIONS -->
					<div class="wafer-actions">
						<button id="wafer-scan-btn" type="button" class="wafer-btn primary" title="Randomize wafer defects & run ATE probe sweep">
							<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 0 1-9 9m9-9a9 9 0 0 0-9-9m9 9H3m9 9a9 9 0 0 1-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/></svg>
							<span>Run ATE Pogo Probe Scan</span>
						</button>
						<button id="wafer-random-btn" type="button" class="wafer-btn">
							<span>Probe Random Die</span>
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- LAB EXTRAS DRAWER / POPOVER (SORTED ALPHABETICALLY A-Z) -->
	<div id="lab-extras-modal" class="lab-extras-modal hidden" role="dialog" aria-modal="false" aria-label="Hardware Lab Easter Eggs">
		<div class="extras-header">
			<div class="extras-title">
				<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
				</svg>
				<span>Hardware Lab Extras</span>
			</div>
			<button id="extras-close-btn" type="button" class="extras-close-btn" aria-label="Close Extras Drawer">&times;</button>
		</div>
		<div class="extras-grid">
			<!-- 1. 3D Tilt (3) -->
			<button id="trigger-tilt-btn" class="extra-item-btn" type="button" title="3D Viewport Parallax Hologram Tilt">
				<span class="item-icon">📐</span>
				<div class="item-meta">
					<strong class="item-name">3D Tilt</strong>
					<span class="item-desc">Parallax hologram perspective depth</span>
				</div>
				<kbd class="item-kbd">Ctrl+Alt+H</kbd>
			</button>

			<!-- 2. Chief Morale Officer (C) -->
			<button id="trigger-boop-btn" class="extra-item-btn" type="button" title="Boop Chief Morale Officer (She is a good girl!)">
				<span class="item-icon">🐾</span>
				<div class="item-meta">
					<strong class="item-name">Chief Morale Officer</strong>
					<span class="item-desc">Boop avatar for RF telemetry boost</span>
				</div>
				<kbd class="item-kbd">+10 dBm</kbd>
			</button>

			<!-- 3. Switch Acoustics (S) -->
			<button id="trigger-switch-sound-btn" class="extra-item-btn" type="button" title="Cycle Mechanical Switch Acoustics">
				<span class="item-icon">🔊</span>
				<div class="item-meta">
					<strong class="item-name">Switch Acoustics</strong>
					<span class="item-desc" id="extras-sound-desc">Procedural Web Audio switch synth</span>
				</div>
				<kbd class="item-kbd" id="extras-sound-badge">Sound: Off</kbd>
			</button>

			<!-- 4. Wafer Sort Map (W) -->
			<button id="trigger-wafer-btn" class="extra-item-btn" type="button" title="300mm Silicon Wafer Sort Map">
				<span class="item-icon">🔬</span>
				<div class="item-meta">
					<strong class="item-name">Wafer Sort Map</strong>
					<span class="item-desc">300mm ATE die sort &amp; bin yield inspector</span>
				</div>
				<kbd class="item-kbd">wafer -g</kbd>
			</button>

			<!-- 5. Zero-G Drop (Z) -->
			<button id="trigger-zerog-btn" class="extra-item-btn" type="button" title="Zero-G Physics Collapse">
				<span class="item-icon">🪐</span>
				<div class="item-meta">
					<strong class="item-name">Zero-G Drop</strong>
					<span class="item-desc">Verlet physics element collapse &amp; fling</span>
				</div>
				<kbd class="item-kbd">Ctrl+Alt+G</kbd>
			</button>
		</div>
		<div class="extras-footer">
			<span>Click cards above, use hotkeys, or enter terminal commands (<code>wafer -g</code>, <code>gravity</code>, <code>tilt</code>).</span>
		</div>
	</div>
</div>

<script>
	// -------------------------------------------------------------
	// PROCEDURAL MECHANICAL SWITCH AUDIO SYNTHESIZER (ACOUSTIC PHYSICS MODEL)
	// -------------------------------------------------------------
	class SwitchAudioEngine {
		private ctx: AudioContext | null = null;
		public profile: 'off' | 'blue' | 'red' | 'modelm' = 'off';

		constructor() {
			try {
				const saved = localStorage.getItem('brob_switch_sound');
				if (saved && ['blue', 'red', 'modelm'].includes(saved)) {
					this.profile = saved as any;
				}
			} catch {}
		}

		private init() {
			if (!this.ctx) {
				const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
				if (AudioCtx) this.ctx = new AudioCtx();
			}
			if (this.ctx && this.ctx.state === 'suspended') {
				this.ctx.resume().catch(() => {});
			}
		}

		public setProfile(p: 'off' | 'blue' | 'red' | 'modelm') {
			this.profile = p;
			try {
				localStorage.setItem('brob_switch_sound', p);
			} catch {}
			if (p !== 'off') this.init();
			window.dispatchEvent(new CustomEvent('switch-sound-changed', { detail: { profile: p } }));
		}

		public play(code?: string) {
			if (this.profile === 'off') return;
			this.init();
			if (!this.ctx) return;

			const t = this.ctx.currentTime;
			const isSpace = code === 'Space';
			const isBig = isSpace || code === 'Enter' || code === 'Backspace';
			const pitchMod = isSpace ? 0.72 : isBig ? 0.84 : (0.96 + Math.random() * 0.08);

			if (this.profile === 'blue') {
				// CLICKY BLUE: Crisp tactile click-leaf snap + plastic bottom-out clack
				// 1. High-frequency click-leaf snap (2.5ms sharp impulse)
				this.playImpulse(t, 3800 * pitchMod, 0.005, 0.20);
				// 2. Plastic stem bottom-out (downward pitch drop from 280Hz to 140Hz)
				this.playThump(t + 0.002, 280 * pitchMod, 140 * pitchMod, 0.032, 0.18);
				// 3. Keycap acoustic body resonance
				this.playTone(t + 0.002, 1200 * pitchMod, 'triangle', 0.016, 0.07);
			} else if (this.profile === 'red') {
				// LINEAR RED: Pure smooth plastic "thock" (absolutely NO high click leaf)
				// 1. Soft impact thump with downward pitch slide (190Hz -> 85Hz)
				this.playThump(t, 190 * pitchMod, 85 * pitchMod, 0.036, 0.22);
				// 2. Low-pass stem dampening friction
				this.playImpulse(t, 420 * pitchMod, 0.014, 0.06);
			} else if (this.profile === 'modelm') {
				// BUCKLING SPRING: Sharp spring buckle snap + resonant steel spring twang + hollow barrel
				// 1. Buckling contact snap
				this.playImpulse(t, 2600 * pitchMod, 0.006, 0.18);
				// 2. Steel spring acoustic ringing (twin beating frequencies)
				this.playTone(t + 0.002, 2880 * pitchMod, 'sine', 0.075, 0.12);
				this.playTone(t + 0.002, 3020 * pitchMod, 'sine', 0.075, 0.10);
				// 3. Hollow barrel plate bottom-out
				this.playThump(t + 0.003, 180 * pitchMod, 95 * pitchMod, 0.042, 0.15);
			}
		}

		public playProbeTick() {
			if (!this.ctx) return;
			const t = this.ctx.currentTime;
			this.playTone(t, 1800 + Math.random() * 400, 'square', 0.006, 0.03);
		}

		private playThump(time: number, startFreq: number, endFreq: number, dur: number, vol: number) {
			if (!this.ctx) return;
			const osc = this.ctx.createOscillator();
			const gain = this.ctx.createGain();

			osc.type = 'triangle';
			osc.frequency.setValueAtTime(startFreq, time);
			osc.frequency.exponentialRampToValueAtTime(Math.max(20, endFreq), time + dur);

			gain.gain.setValueAtTime(vol, time);
			gain.gain.exponentialRampToValueAtTime(0.0001, time + dur);

			osc.connect(gain);
			gain.connect(this.ctx.destination);
			osc.start(time);
			osc.stop(time + dur);
		}

		private playTone(time: number, freq: number, type: OscillatorType, dur: number, vol: number) {
			if (!this.ctx) return;
			const osc = this.ctx.createOscillator();
			const gain = this.ctx.createGain();
			osc.type = type;
			osc.frequency.setValueAtTime(freq, time);

			gain.gain.setValueAtTime(vol, time);
			gain.gain.exponentialRampToValueAtTime(0.0001, time + dur);

			osc.connect(gain);
			gain.connect(this.ctx.destination);
			osc.start(time);
			osc.stop(time + dur);
		}

		private playImpulse(time: number, centerFreq: number, dur: number, vol: number) {
			if (!this.ctx) return;
			const bufferSize = Math.max(1, Math.floor(this.ctx.sampleRate * dur));
			const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
			const data = buffer.getChannelData(0);
			for (let i = 0; i < bufferSize; i++) {
				data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (bufferSize * 0.35));
			}

			const source = this.ctx.createBufferSource();
			source.buffer = buffer;

			const filter = this.ctx.createBiquadFilter();
			filter.type = 'bandpass';
			filter.frequency.setValueAtTime(centerFreq, time);
			filter.Q.setValueAtTime(2.5, time);

			const gain = this.ctx.createGain();
			gain.gain.setValueAtTime(vol, time);
			gain.gain.exponentialRampToValueAtTime(0.0001, time + dur);

			source.connect(filter);
			filter.connect(gain);
			gain.connect(this.ctx.destination);
			source.start(time);
			source.stop(time + dur);
		}
	}

	const audioEngine = new SwitchAudioEngine();
	(window as any).__playSwitchSound = (code?: string) => audioEngine.play(code);
	(window as any).__setSwitchSound = (profile: any) => audioEngine.setProfile(profile);
	(window as any).__getSwitchSound = () => audioEngine.profile;

	// -------------------------------------------------------------
	// CHIEF MORALE OFFICER: BOOP THE DOG (+10 dBm) [FEMALE MASCOT 🐾]
	// -------------------------------------------------------------
	function initDogBoop() {
		const avatarImg = document.getElementById('hero-avatar-img') || document.querySelector('.hero .avatar-img');
		const avatarWrap = document.getElementById('hero-avatar-wrap') || document.querySelector('.hero .avatar-wrap');
		if (!avatarImg || !avatarWrap) return;

		let streak = 0;
		let streakTimer = 0;

		const rfReadouts = [
			'🐾 Morale: +3 dBm (2x)',
			'🐾 Morale: +6 dBm (4x)',
			'🐾 Morale: +10 dBm (10x Nominal)',
			'🐾 Morale: +14 dBm (25x High Efficiency)',
			'🐾 Morale: +20 dBm (100x Max Gain!)',
			'🐾 Saturated: 0 dBFS (Peak Good Girl! 🐾)'
		];

		function playDogChime(step: number) {
			try {
				const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
				if (!AudioCtx) return;
				const ctx = new AudioCtx();
				const t = ctx.currentTime;
				const notes = [523.25, 587.33, 659.25, 783.99, 880.00, 1046.50]; // C5 to C6
				const baseFreq = notes[Math.min(step, notes.length - 1)];

				const osc = ctx.createOscillator();
				const gain = ctx.createGain();
				osc.type = 'sine';
				osc.frequency.setValueAtTime(baseFreq, t);
				osc.frequency.exponentialRampToValueAtTime(baseFreq * 1.35, t + 0.12);

				gain.gain.setValueAtTime(0.18, t);
				gain.gain.exponentialRampToValueAtTime(0.0001, t + 0.22);

				osc.connect(gain);
				gain.connect(ctx.destination);
				osc.start(t);
				osc.stop(t + 0.22);
			} catch {}
		}

		function triggerBoop() {
			streak++;
			window.clearTimeout(streakTimer);
			streakTimer = window.setTimeout(() => { streak = 0; }, 3500);

			playDogChime(streak);

			avatarImg.classList.remove('booped');
			void (avatarImg as HTMLElement).offsetWidth;
			avatarImg.classList.add('booped');

			const pill = document.createElement('div');
			pill.className = 'morale-rf-pill mono';
			const text = rfReadouts[Math.min(streak - 1, rfReadouts.length - 1)];
			pill.textContent = text;
			avatarWrap.appendChild(pill);

			if (streak >= 5) {
				const glyphs = ['🐾', '🦴', '⚡', '✨', '🐾', '🦴'];
				glyphs.forEach((g, i) => {
					const conf = document.createElement('span');
					conf.className = 'boop-particle';
					conf.textContent = g;
					const angle = (i / glyphs.length) * Math.PI * 2;
					const dist = 55 + Math.random() * 35;
					const dx = Math.cos(angle) * dist;
					const dy = Math.sin(angle) * dist - 25;
					conf.style.setProperty('--dx', `${dx.toFixed(1)}px`);
					conf.style.setProperty('--dy', `${dy.toFixed(1)}px`);
					avatarWrap.appendChild(conf);
					setTimeout(() => conf.remove(), 950);
				});
			}

			setTimeout(() => {
				pill.remove();
			}, 1100);
		}

		avatarImg.addEventListener('click', triggerBoop);
		(window as any).__boopDog = () => {
			avatarImg.scrollIntoView({ behavior: 'smooth', block: 'center' });
			setTimeout(triggerBoop, 300);
		};
	}

	// -------------------------------------------------------------
	// 300MM SILICON WAFER DIE SORT INSPECTOR (DYNAMIC RANDOMIZATION)
	// -------------------------------------------------------------
	function initWaferInspector() {
		const modal = document.getElementById('wafer-modal');
		const backdrop = document.getElementById('wafer-backdrop');
		const closeBtn = document.getElementById('wafer-close-btn');
		const scanBtn = document.getElementById('wafer-scan-btn');
		const randomBtn = document.getElementById('wafer-random-btn');
		const canvas = document.getElementById('wafer-canvas') as HTMLCanvasElement | null;
		if (!modal || !canvas) return;

		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		const waferRadius = 175;
		const cx = 200;
		const cy = 200;
		const dieW = 10.5;
		const dieH = 10.5;
		const step = 12.2;
		const gridSize = 28;

		interface WaferDie {
			col: number;
			row: number;
			x: number;
			y: number;
			bin: 1 | 2 | 'x';
			id: string;
			fmax: number;
			vmin: number;
			leakage: number;
			tested: boolean;
		}

		const dies: WaferDie[] = [];
		let activeDie: WaferDie | null = null;
		let isScanning = false;

		function generateWaferDies(randomize: boolean = false) {
			dies.length = 0;
			const half = (gridSize * step) / 2;

			// Random defect cluster centers & parameters
			const clusterX = randomize ? Math.floor(Math.random() * 18 + 5) : 8;
			const clusterY = randomize ? Math.floor(Math.random() * 18 + 5) : 18;
			const edgeDefectThreshold = randomize ? (0.85 + Math.random() * 0.07) : 0.88;
			const lotNum = randomize ? Math.floor(Math.random() * 800 + 100) : 850;
			const waferNum = randomize ? Math.floor(Math.random() * 24 + 1) : 14;

			const subEl = document.getElementById('wafer-sub-meta');
			if (subEl) {
				subEl.textContent = `LOT #${lotNum}C-W${waferNum < 10 ? '0' + waferNum : waferNum} • 3nm FinFET • 684 Gross Dies`;
			}

			for (let r = 0; r < gridSize; r++) {
				for (let c = 0; c < gridSize; c++) {
					const x = cx - half + c * step;
					const y = cy - half + r * step;

					const corners = [
						[x, y],
						[x + dieW, y],
						[x, y + dieH],
						[x + dieW, y + dieH]
					];

					const fits = corners.every(([px, py]) => {
						const dx = px - cx;
						const dy = py - cy;
						const dist = Math.sqrt(dx * dx + dy * dy);
						if (dist > waferRadius - 10) return false;
						if (Math.abs(dx) < 14 && py > cy + waferRadius - 16) return false;
						return true;
					});

					if (!fits) continue;

					const dist = Math.sqrt((x - cx) ** 2 + (y - cy) ** 2);
					const normR = dist / (waferRadius - 10);
					const rnd = Math.random();

					let bin: 1 | 2 | 'x' = 1;
					if (normR > edgeDefectThreshold && rnd < 0.40) {
						bin = 'x'; // Edge litho fallout
					} else if (Math.abs(c - clusterX) <= 1 && Math.abs(r - clusterY) <= 1 && rnd < 0.65) {
						bin = 'x'; // Particle defect cluster
					} else if (rnd < 0.21) {
						bin = 2; // Eco low-power harvest bin
					} else {
						bin = 1; // Prime high-frequency
					}

					const hexId = `0x${lotNum.toString(16).toUpperCase()}` + ((r * gridSize + c) * 137).toString(16).toUpperCase().padStart(4, '0');
					const fmax = bin === 1 ? +(4.7 + Math.random() * 0.28).toFixed(2) : bin === 2 ? +(3.2 + Math.random() * 0.18).toFixed(2) : +(1.8 + Math.random() * 0.5).toFixed(2);
					const vmin = bin === 1 ? +(0.75 + Math.random() * 0.04).toFixed(3) : bin === 2 ? +(0.71 + Math.random() * 0.03).toFixed(3) : +(1.15 + Math.random() * 0.2).toFixed(3);
					const leakage = bin === 1 ? +(11.5 + Math.random() * 3.5).toFixed(1) : bin === 2 ? +(7.2 + Math.random() * 1.8).toFixed(1) : +(48.0 + Math.random() * 20.0).toFixed(1);

					dies.push({
						col: c,
						row: r,
						x,
						y,
						bin,
						id: hexId,
						fmax,
						vmin,
						leakage,
						tested: true
					});
				}
			}

			// Update legend tallies
			const b1Count = dies.filter(d => d.bin === 1).length;
			const b2Count = dies.filter(d => d.bin === 2).length;
			const bxCount = dies.filter(d => d.bin === 'x').length;
			const total = dies.length;

			const legB1 = document.getElementById('leg-bin1-text');
			const legB2 = document.getElementById('leg-bin2-text');
			const legBx = document.getElementById('leg-binx-text');

			if (legB1) legB1.textContent = `Bin 1 (Prime 3.8GHz+): ${b1Count} (${((b1Count / total) * 100).toFixed(1)}%)`;
			if (legB2) legB2.textContent = `Bin 2 (Eco 3.2GHz): ${b2Count} (${((b2Count / total) * 100).toFixed(1)}%)`;
			if (legBx) legBx.textContent = `Parametric Defect: ${bxCount} (${((bxCount / total) * 100).toFixed(1)}%)`;
		}

		// Initial generation
		generateWaferDies(false);

		function drawWafer() {
			if (!ctx || !canvas) return;
			ctx.clearRect(0, 0, canvas.width, canvas.height);

			// 1. Outer Wafer Substrate Circle
			ctx.save();
			ctx.beginPath();
			ctx.arc(cx, cy, waferRadius, 0, Math.PI * 2);
			const grad = ctx.createRadialGradient(cx - 30, cy - 30, 20, cx, cy, waferRadius);
			grad.addColorStop(0, '#1a2233');
			grad.addColorStop(0.7, '#111622');
			grad.addColorStop(1, '#0b0f17');
			ctx.fillStyle = grad;
			ctx.fill();

			ctx.lineWidth = 3;
			ctx.strokeStyle = '#38bdf8';
			ctx.stroke();

			// Wafer Notch at bottom (0° / 6 o'clock)
			ctx.beginPath();
			ctx.arc(cx, cy + waferRadius, 8, Math.PI, 0, true);
			ctx.fillStyle = '#0f172a';
			ctx.fill();
			ctx.stroke();
			ctx.restore();

			// 2. Silicon Dies
			for (const die of dies) {
				if (!die.tested) {
					ctx.fillStyle = 'rgba(255, 255, 255, 0.05)';
				} else if (die.bin === 1) {
					ctx.fillStyle = '#10b981';
				} else if (die.bin === 2) {
					ctx.fillStyle = '#f59e0b';
				} else {
					ctx.fillStyle = '#ef4444';
				}

				ctx.fillRect(die.x, die.y, dieW, dieH);

				ctx.strokeStyle = 'rgba(0, 0, 0, 0.4)';
				ctx.lineWidth = 0.5;
				ctx.strokeRect(die.x, die.y, dieW, dieH);
			}

			// 3. Highlight Active / Inspected Die
			if (activeDie) {
				ctx.save();
				ctx.strokeStyle = '#00f0ff';
				ctx.lineWidth = 2;
				ctx.shadowColor = '#00f0ff';
				ctx.shadowBlur = 8;
				ctx.strokeRect(activeDie.x - 1, activeDie.y - 1, dieW + 2, dieH + 2);

				ctx.strokeStyle = 'rgba(0, 240, 255, 0.45)';
				ctx.lineWidth = 1;
				ctx.setLineDash([3, 3]);
				ctx.beginPath();
				ctx.moveTo(activeDie.x + dieW / 2, 20);
				ctx.lineTo(activeDie.x + dieW / 2, 380);
				ctx.moveTo(20, activeDie.y + dieH / 2);
				ctx.lineTo(380, activeDie.y + dieH / 2);
				ctx.stroke();
				ctx.restore();
			}
		}

		function updateTelemetry(die: WaferDie) {
			const idEl = document.getElementById('wp-id');
			const posEl = document.getElementById('wp-pos');
			const binEl = document.getElementById('wp-bin');
			const fmaxEl = document.getElementById('wp-fmax');
			const vminEl = document.getElementById('wp-vmin');
			const leakEl = document.getElementById('wp-leak');

			if (idEl) idEl.textContent = die.id;
			if (posEl) posEl.textContent = `X: ${die.col}, Y: ${die.row}`;
			if (binEl) {
				if (die.bin === 1) {
					binEl.textContent = 'Bin 1 (Prime Core)';
					binEl.style.color = '#10b981';
				} else if (die.bin === 2) {
					binEl.textContent = 'Bin 2 (Eco Harvest)';
					binEl.style.color = '#f59e0b';
				} else {
					binEl.textContent = 'Parametric Defect';
					binEl.style.color = '#ef4444';
				}
			}
			if (fmaxEl) fmaxEl.textContent = `${die.fmax} GHz`;
			if (vminEl) vminEl.textContent = `${die.vmin} V`;
			if (leakEl) leakEl.textContent = `${die.leakage} mA`;
		}

		function handleCanvasPointer(e: MouseEvent) {
			if (!canvas) return;
			const rect = canvas.getBoundingClientRect();
			const px = (e.clientX - rect.left) * (canvas.width / rect.width);
			const py = (e.clientY - rect.top) * (canvas.height / rect.height);

			const found = dies.find(d => px >= d.x && px <= d.x + dieW && py >= d.y && py <= d.y + dieH);
			if (found) {
				activeDie = found;
				updateTelemetry(found);
				drawWafer();
			}
		}

		canvas.addEventListener('mousemove', handleCanvasPointer);
		canvas.addEventListener('click', handleCanvasPointer);

		function openWaferModal() {
			modal.classList.remove('hidden');
			if (!activeDie && dies.length) {
				activeDie = dies[Math.floor(dies.length / 2)];
				updateTelemetry(activeDie);
			}
			drawWafer();
		}

		function closeWaferModal() {
			modal.classList.add('hidden');
		}

		closeBtn?.addEventListener('click', closeWaferModal);
		backdrop?.addEventListener('click', closeWaferModal);

		// DYNAMIC RANDOMIZATION & ATE POGO SCAN
		scanBtn?.addEventListener('click', () => {
			if (isScanning) return;
			isScanning = true;

			// Randomize dies and defects for this scan!
			generateWaferDies(true);
			dies.forEach(d => { d.tested = false; });
			activeDie = null;
			drawWafer();

			const yieldValEl = document.getElementById('wafer-yield-val');
			const yieldBarEl = document.getElementById('wafer-yield-bar');
			const d0El = document.getElementById('wafer-d0-val');

			let idx = 0;
			const batchSize = 16;
			const total = dies.length;

			function stepScan() {
				const end = Math.min(idx + batchSize, total);
				for (let i = idx; i < end; i++) {
					dies[i].tested = true;
				}
				idx = end;
				activeDie = dies[idx - 1] || null;
				if (activeDie) updateTelemetry(activeDie);

				const testedCount = dies.filter(d => d.tested).length;
				const goodCount = dies.filter(d => d.tested && d.bin !== 'x').length;
				const curYield = testedCount ? ((goodCount / testedCount) * 100).toFixed(1) : '0.0';

				if (yieldValEl) yieldValEl.textContent = `${curYield}%`;
				if (yieldBarEl) yieldBarEl.style.width = `${curYield}%`;

				audioEngine.playProbeTick();
				drawWafer();

				if (idx < total) {
					requestAnimationFrame(stepScan);
				} else {
					isScanning = false;
					const finalYield = ((goodCount / total) * 100).toFixed(1);
					if (yieldValEl) yieldValEl.textContent = `${finalYield}%`;
					if (yieldBarEl) yieldBarEl.style.width = `${finalYield}%`;
					if (d0El) {
						const d0 = (0.055 + Math.random() * 0.035).toFixed(3);
						d0El.textContent = `D₀: ${d0}/cm²`;
					}
				}
			}

			requestAnimationFrame(stepScan);
		});

		randomBtn?.addEventListener('click', () => {
			if (!dies.length) return;
			const r = dies[Math.floor(Math.random() * dies.length)];
			activeDie = r;
			updateTelemetry(r);
			drawWafer();
		});

		(window as any).__openWaferMap = openWaferModal;
	}

	// -------------------------------------------------------------
	// ZERO-G & 3D TILT CORE
	// -------------------------------------------------------------
	function initEasterEggs() {
		let isZeroG = false;
		let isTilt = false;

		const zerogHud = document.getElementById('zerog-hud');
		const zerogResetBtn = document.getElementById('zerog-reset-btn');
		const tiltHud = document.getElementById('tilt-hud');
		const tiltExitBtn = document.getElementById('tilt-exit-btn');
		const extrasModal = document.getElementById('lab-extras-modal');
		const extrasCloseBtn = document.getElementById('extras-close-btn');

		interface PhysicsBody {
			el: HTMLElement;
			x: number;
			y: number;
			prevX: number;
			prevY: number;
			angle: number;
			prevAngle: number;
			width: number;
			height: number;
			initialLeft: number;
			initialTop: number;
		}

		let bodies: PhysicsBody[] = [];
		let animId = 0;
		let draggedBody: PhysicsBody | null = null;
		let dragOffsetX = 0;
		let dragOffsetY = 0;
		let lastPointerX = 0;
		let lastPointerY = 0;

		function startZeroG() {
			if (isZeroG) return;
			isZeroG = true;
			zerogHud?.classList.remove('hidden');

			const selector = '.card, .benchmark-card, .debug-card, .cad-viewer-container, .hero .avatar-wrap, .hero .name, .hero .role-title, .hero .tagline, .hero .contact-links';
			const elements = Array.from(document.querySelectorAll<HTMLElement>(selector));

			bodies = elements.map((el) => {
				const rect = el.getBoundingClientRect();
				el.style.transform = 'translate3d(0, 0, 0) rotate(0deg)';
				el.style.transition = 'none';
				el.style.willChange = 'transform';
				el.style.cursor = 'grab';

				return {
					el,
					x: rect.left,
					y: rect.top,
					prevX: rect.left + (Math.random() - 0.5) * 6,
					prevY: rect.top - Math.random() * 4,
					angle: 0,
					prevAngle: (Math.random() - 0.5) * 0.04,
					width: rect.width,
					height: rect.height,
					initialLeft: rect.left,
					initialTop: rect.top
				};
			});

			runPhysicsLoop();
		}

		function resetZeroG() {
			if (!isZeroG) return;
			isZeroG = false;
			cancelAnimationFrame(animId);
			zerogHud?.classList.add('hidden');

			bodies.forEach((b) => {
				b.el.style.transition = 'transform 0.65s cubic-bezier(0.25, 1, 0.5, 1)';
				b.el.style.transform = 'translate3d(0, 0, 0) rotate(0deg)';
				b.el.style.cursor = '';
			});

			setTimeout(() => {
				bodies.forEach((b) => {
					b.el.style.transition = '';
					b.el.style.willChange = '';
					b.el.style.transform = '';
				});
				bodies = [];
			}, 700);
		}

		function runPhysicsLoop() {
			const gravity = 0.42;
			const friction = 0.985;
			const restitution = 0.55;

			function step() {
				if (!isZeroG) return;
				const winW = window.innerWidth;
				const winH = window.innerHeight;

				for (const b of bodies) {
					if (b === draggedBody) {
						b.prevX = b.x;
						b.prevY = b.y;
						b.x = lastPointerX - dragOffsetX;
						b.y = lastPointerY - dragOffsetY;
					} else {
						const vx = (b.x - b.prevX) * friction;
						const vy = (b.y - b.prevY) * friction + gravity;
						const vAngle = (b.angle - b.prevAngle) * friction;

						b.prevX = b.x;
						b.prevY = b.y;
						b.x += vx;
						b.y += vy;
						b.prevAngle = b.angle;
						b.angle += vAngle;

						if (b.y + b.height > winH) {
							b.y = winH - b.height;
							b.prevY = b.y + vy * restitution;
							b.prevAngle += vx * 0.003;
						}
						if (b.x < 0) {
							b.x = 0;
							b.prevX = b.x + vx * restitution;
						}
						if (b.x + b.width > winW) {
							b.x = winW - b.width;
							b.prevX = b.x + vx * restitution;
						}
					}

					const dx = b.x - b.initialLeft;
					const dy = b.y - b.initialTop;
					const deg = (b.angle * 180) / Math.PI;
					b.el.style.transform = `translate3d(${dx.toFixed(2)}px, ${dy.toFixed(2)}px, 0) rotate(${deg.toFixed(2)}deg)`;
				}
				animId = requestAnimationFrame(step);
			}
			animId = requestAnimationFrame(step);
		}

		window.addEventListener('pointerdown', (e) => {
			if (!isZeroG) return;
			const target = (e.target as HTMLElement).closest('.card, .benchmark-card, .debug-card, .cad-viewer-container, .hero .avatar-wrap, .hero .name, .hero .role-title, .hero .tagline, .hero .contact-links') as HTMLElement | null;
			if (!target) return;
			const body = bodies.find((b) => b.el === target);
			if (body) {
				draggedBody = body;
				dragOffsetX = e.clientX - body.x;
				dragOffsetY = e.clientY - body.y;
				lastPointerX = e.clientX;
				lastPointerY = e.clientY;
				body.el.style.cursor = 'grabbing';
			}
		});

		window.addEventListener('pointermove', (e) => {
			if (draggedBody) {
				lastPointerX = e.clientX;
				lastPointerY = e.clientY;
			}
		});

		window.addEventListener('pointerup', () => {
			if (draggedBody) {
				draggedBody.el.style.cursor = 'grab';
				draggedBody = null;
			}
		});

		if (zerogResetBtn) zerogResetBtn.addEventListener('click', resetZeroG);

		// 3D Tilt
		const mainEl = document.querySelector('main') as HTMLElement | null;
		function handleTiltMove(e: MouseEvent) {
			if (!isTilt || !mainEl) return;
			const nx = (e.clientX / window.innerWidth - 0.5) * 16;
			const ny = (e.clientY / window.innerHeight - 0.5) * -16;
			mainEl.style.transform = `perspective(1200px) rotateY(${nx.toFixed(2)}deg) rotateX(${ny.toFixed(2)}deg) scale(0.985)`;
		}

		function handleOrientation(e: DeviceOrientationEvent) {
			if (!isTilt || !mainEl || !e.gamma || !e.beta) return;
			const nx = Math.max(-15, Math.min(15, e.gamma));
			const ny = Math.max(-15, Math.min(15, (e.beta - 45) * 0.7));
			mainEl.style.transform = `perspective(1200px) rotateY(${nx.toFixed(2)}deg) rotateX(${-ny.toFixed(2)}deg) scale(0.985)`;
		}

		function toggleTilt(force?: boolean) {
			const next = typeof force === 'boolean' ? force : !isTilt;
			if (next === isTilt) return;
			isTilt = next;

			if (isTilt) {
				tiltHud?.classList.remove('hidden');
				window.addEventListener('mousemove', handleTiltMove);
				window.addEventListener('deviceorientation', handleOrientation);
				if (mainEl) mainEl.style.transition = 'transform 0.12s ease-out';
			} else {
				tiltHud?.classList.add('hidden');
				window.removeEventListener('mousemove', handleTiltMove);
				window.removeEventListener('deviceorientation', handleOrientation);
				if (mainEl) {
					mainEl.style.transition = 'transform 0.4s ease';
					mainEl.style.transform = '';
					setTimeout(() => { if (mainEl) mainEl.style.transition = ''; }, 400);
				}
			}
		}

		if (tiltExitBtn) tiltExitBtn.addEventListener('click', () => toggleTilt(false));

		// Keyboard Combinations (Ctrl+Alt+G / Ctrl+Alt+H / Esc)
		(window as any).__toggleZeroG = () => (isZeroG ? resetZeroG() : startZeroG());
		(window as any).__toggleTilt = (force?: boolean) => toggleTilt(force);
		(window as any).__toggleLabExtras = () => { extrasModal?.classList.toggle('hidden'); };

		const kbLabEl = document.getElementById('keyboard-lab');
		function isNearKeyboardLab(): boolean {
			if (!kbLabEl) return false;
			const rect = kbLabEl.getBoundingClientRect();
			return rect.bottom > -80 && rect.top < window.innerHeight + 80;
		}

		window.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				const waferModal = document.getElementById('wafer-modal');
				if (waferModal && !waferModal.classList.contains('hidden')) {
					waferModal.classList.add('hidden');
					return;
				}
				if (isZeroG || isTilt || (extrasModal && !extrasModal.classList.contains('hidden'))) {
					e.preventDefault();
					if (isZeroG) resetZeroG();
					if (isTilt) toggleTilt(false);
					extrasModal?.classList.add('hidden');
				}
				return;
			}

			const hasModifiers = (e.ctrlKey || e.metaKey) && e.altKey;
			if (!hasModifiers) return;

			const activeTag = document.activeElement?.tagName;
			if (activeTag === 'INPUT' || activeTag === 'TEXTAREA' || activeTag === 'SELECT') return;

			const termModal = document.getElementById('terminal-modal');
			if (termModal && termModal.classList.contains('open')) return;

			if (isNearKeyboardLab()) return;
			if (document.activeElement?.closest('#keyboard-lab')) return;

			if (e.code === 'KeyG') {
				e.preventDefault();
				(window as any).__toggleZeroG();
			} else if (e.code === 'KeyH') {
				e.preventDefault();
				(window as any).__toggleTilt();
			}
		});

		// Lab Extras Drawer Wire-up (Alphabetical Order 3-C-S-W-Z)
		document.getElementById('trigger-tilt-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			(window as any).__toggleTilt();
		});
		document.getElementById('trigger-boop-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			(window as any).__boopDog?.();
		});

		// Switch sound button in drawer
		const drawerSoundBtn = document.getElementById('trigger-switch-sound-btn');
		const drawerSoundBadge = document.getElementById('extras-sound-badge');
		const drawerSoundDesc = document.getElementById('extras-sound-desc');

		function updateDrawerSoundUI(p: string) {
			if (!drawerSoundBadge) return;
			const badges: Record<string, string> = {
				off: 'Sound: Off',
				blue: 'Blue (Clicky)',
				red: 'Red (Linear)',
				modelm: 'Model M (Spring)'
			};
			drawerSoundBadge.textContent = badges[p] || 'Sound: Off';
			if (drawerSoundDesc) {
				drawerSoundDesc.textContent = p === 'off' ? 'Procedural Web Audio switch synth' : `Acoustics active: ${badges[p]}`;
			}
		}

		updateDrawerSoundUI(audioEngine.profile);
		window.addEventListener('switch-sound-changed', ((e: CustomEvent) => {
			if (e.detail?.profile) updateDrawerSoundUI(e.detail.profile);
		}) as EventListener);

		drawerSoundBtn?.addEventListener('click', () => {
			const current = audioEngine.profile;
			const order = ['off', 'blue', 'red', 'modelm'];
			const next = order[(order.indexOf(current) + 1) % order.length] as any;
			audioEngine.setProfile(next);
			updateDrawerSoundUI(next);
			if (next !== 'off') audioEngine.play('KeyA');
		});

		document.getElementById('trigger-wafer-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			(window as any).__openWaferMap?.();
		});

		document.getElementById('trigger-zerog-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			(window as any).__toggleZeroG();
		});

		extrasCloseBtn?.addEventListener('click', () => extrasModal?.classList.add('hidden'));

		document.addEventListener('click', (e) => {
			const target = e.target as HTMLElement;
			if (extrasModal && !extrasModal.classList.contains('hidden')) {
				if (!extrasModal.contains(target) && !target.closest('#footer-extras-btn')) {
					extrasModal.classList.add('hidden');
				}
			}
		});
	}

	initEasterEggs();
	initWaferInspector();
	initDogBoop();

	document.addEventListener('astro:page-load', () => {
		initEasterEggs();
		initWaferInspector();
		initDogBoop();
	});
</script>

