---
// EasterEggs.astro - Hardware & Silicon Validation Interactive Easter Eggs
// 1. 3D Viewport Parallax Hologram Tilt (perspective matrix tracking cursor/orientation)
// 2. Chief Morale Officer "Boop the Dog" (+10 dBm RF Telemetry & Mascot Animation)
// 3. Procedural Mechanical Switch Synthesizer (pure Web Audio API acoustics: Blue / Red / Model M)
// 4. 300mm ATE Silicon Wafer Die Sort Map (Reticle-Limit Massive Enterprise Die Architecture)
// 5. Zero-G Verlet Physics Element Collapse (pure vanilla physics, non-destructive GPU transforms)
---

<div id="easter-eggs-container">
	<!-- FLOATING HUDS -->
	<div id="zerog-hud" class="ee-hud zerog-hud hidden" style="display: none;">
		<span class="hud-pulse-dot"></span>
		<span class="hud-title">⚡ ZERO-G COLLAPSE ACTIVE &bull; DRAG &amp; FLING CARDS</span>
		<button id="zerog-reset-btn" type="button" class="ee-hud-btn">Resolder / Reassemble</button>
	</div>

	<div id="tilt-hud" class="ee-hud tilt-hud hidden" style="display: none;">
		<span class="hud-pulse-dot"></span>
		<span class="hud-title">📐 3D HOLOGRAM VIEWPORT TILT ACTIVE</span>
		<button id="tilt-exit-btn" type="button" class="ee-hud-btn">Exit (Esc)</button>
	</div>

	<!-- CRT BENCH OSCILLOSCOPE DEGAUSS HUD & CANVAS -->
	<div id="degauss-hud" class="ee-hud degauss-hud hidden" style="display: none;">
		<span class="hud-pulse-dot"></span>
		<span class="hud-title">⚡ CRT BENCH DEGAUSS &bull; ELECTROMAGNETIC PULSE</span>
		<button id="degauss-re-btn" type="button" class="ee-hud-btn">Pulse Coil</button>
		<button id="degauss-exit-btn" type="button" class="ee-hud-btn">Exit (Esc)</button>
	</div>
	<canvas id="degauss-canvas" class="ee-canvas hidden" aria-hidden="true" style="display: none;"></canvas>

	<!-- 3D SILICON CYCLONE SPHERE HUD & 3D CORE -->
	<div id="sphere-hud" class="ee-hud sphere-hud hidden" style="display: none;">
		<span class="hud-pulse-dot"></span>
		<span class="hud-title">🪐 3D SILICON CYCLONE &bull; DRAG TO ROTATE &bull; HOVER TO INSPECT</span>
		<button id="sphere-exit-btn" type="button" class="ee-hud-btn">Collapse to 2D (Esc)</button>
	</div>
	<div id="sphere-core" class="sphere-core hidden" aria-hidden="true" style="display: none;">
		<div class="die-cube">
			<div class="die-face die-front mono">3nm HPC CORE</div>
			<div class="die-face die-back mono">L3 64MB</div>
			<div class="die-face die-left mono">PCIe Gen5</div>
			<div class="die-face die-right mono">LPDDR5 PHY</div>
			<div class="die-face die-top mono">ATE BIST</div>
			<div class="die-face die-bottom mono">SUBSTRATE</div>
			<div class="die-aura"></div>
		</div>
	</div>

	<!-- QUANTUM TUNNELING DISINTEGRATION HUD & CANVAS -->
	<div id="quantum-hud" class="ee-hud quantum-hud hidden" style="display: none;">
		<span class="hud-pulse-dot"></span>
		<span class="hud-title">💨 QUANTUM TUNNELING &bull; CLICK ANY BOX TO DISSOLVE &bull; DRAG TO SWIRL DUST</span>
		<button id="quantum-all-btn" type="button" class="ee-hud-btn">Dissolve All</button>
		<button id="quantum-reassemble-btn" type="button" class="ee-hud-btn">Quantum Anneal (Restore All)</button>
		<button id="quantum-exit-btn" type="button" class="ee-hud-btn">Exit (Esc)</button>
	</div>
	<canvas id="quantum-canvas" class="ee-canvas hidden" aria-hidden="true" style="display: none;"></canvas>

	<!-- INFRARED THERMAL CAMERA HUD, CANVAS & SCALE -->
	<div id="thermal-hud" class="ee-hud thermal-hud hidden" style="display: none;">
		<div class="thermal-hud-inner">
			<span class="hud-pulse-dot"></span>
			<span class="hud-title">🌡️ THERMAL CAM &bull; <span id="thermal-tool-text">TOOL: LN2 CRYO-SPRAY (-196°C)</span></span>
			<button id="thermal-tool-btn" type="button" class="ee-hud-btn">Switch to Heat Gun (450°C)</button>
			<button id="thermal-reset-btn" type="button" class="ee-hud-btn">Normalize (24°C)</button>
			<button id="thermal-exit-btn" type="button" class="ee-hud-btn">Exit (Esc)</button>
		</div>
	</div>
	<div id="thermal-scale-bar" class="thermal-scale-bar hidden" aria-hidden="true" style="display: none;">
		<div class="ts-val max mono">150°C</div>
		<div class="ts-gradient"></div>
		<div class="ts-val min mono" id="ts-min-val">-196°C</div>
		<div class="ts-emissivity mono">ε: 0.95</div>
	</div>
	<div id="thermal-spots" class="thermal-spots hidden" aria-hidden="true" style="display: none;">
		<div class="thermal-spot" id="t-spot-cpu" style="top: 25%; left: 35%;">
			<div class="spot-crosshair"></div>
			<span class="spot-label mono">SP01 [CPU DIE] <strong id="t-cpu-val">98.4°C</strong></span>
		</div>
		<div class="thermal-spot" id="t-spot-vrm" style="top: 42%; left: 62%;">
			<div class="spot-crosshair"></div>
			<span class="spot-label mono">SP02 [PMIC VRM] <strong id="t-vrm-val">104.2°C</strong></span>
		</div>
		<div class="thermal-spot" id="t-spot-mem" style="top: 65%; left: 45%;">
			<div class="spot-crosshair"></div>
			<span class="spot-label mono">SP03 [LPDDR5] <strong id="t-mem-val">71.5°C</strong></span>
		</div>
		<div class="thermal-spot" id="t-spot-cursor">
			<div class="spot-crosshair active"></div>
			<span class="spot-label mono">PROBE <strong id="t-cursor-val">24.5°C</strong></span>
		</div>
	</div>
	<canvas id="thermal-canvas" class="ee-canvas hidden" aria-hidden="true" style="display: none;"></canvas>



	<!-- 300MM SILICON WAFER DIE SORT MODAL (RETICLE-LIMIT ENTERPRISE DIE) -->
	<div id="wafer-modal" class="wafer-modal hidden" role="dialog" aria-modal="true" aria-label="300mm Silicon Wafer Sort Inspector" style="display: none;">
		<div class="wafer-backdrop" id="wafer-backdrop"></div>
		<div class="wafer-dialog">
			<div class="wafer-modal-header">
				<div class="wafer-title-wrap">
					<span class="hud-pulse-dot"></span>
					<div class="wafer-title-meta">
						<span class="wafer-title">300mm ATE SILICON WAFER SORT</span>
						<span class="wafer-sub mono" id="wafer-sub-meta">LOT #740C-W14 &bull; 3nm HPC Node &bull; Reticle Limit (740 mm²) &bull; 83 Dies</span>
					</div>
				</div>
				<button id="wafer-close-btn" class="wafer-close-btn" type="button" aria-label="Close Wafer Inspector">&times;</button>
			</div>

			<div class="wafer-modal-body">
				<div class="wafer-canvas-wrap">
					<canvas id="wafer-canvas" width="400" height="400" aria-label="Wafer Die Sort Map"></canvas>
					<div class="wafer-notch-indicator mono">▼ Wafer Notch (0° / 6 o'clock) &bull; 300mm Substrate</div>
				</div>

				<div class="wafer-telemetry-panel">
					<!-- YIELD SUMMARY -->
					<div class="wafer-telemetry-box">
						<span class="w-box-title">Functional Die Yield</span>
						<div class="w-yield-display">
							<span class="w-yield-val mono" id="wafer-yield-val">88.0%</span>
							<span class="w-yield-badge mono" id="wafer-d0-val">D₀: 0.082/cm²</span>
						</div>
						<div class="w-yield-bar-wrap">
							<div class="w-yield-bar" id="wafer-yield-bar" style="width: 88.0%;"></div>
						</div>
					</div>

					<!-- ACTIVE DIE PROBE READOUT (CONCISE, FIXED HEIGHTS, ZERO JITTER) -->
					<div class="wafer-telemetry-box">
						<span class="w-box-title">Active Die Probe Telemetry</span>
						<div class="wafer-probe-grid mono" id="wafer-probe-grid">
							<div class="probe-row"><span class="p-k">Die:</span><span class="p-v" id="wp-id">0x7E106005</span></div>
							<div class="probe-row"><span class="p-k">Pos:</span><span class="p-v" id="wp-pos">(5, 6)</span></div>
							<div class="probe-row"><span class="p-k">Bin:</span><span class="p-v" id="wp-bin">Perfect (Bin 1)</span></div>
							<div class="probe-row"><span class="p-k">Cores:</span><span class="p-v" id="wp-config">All Active</span></div>
							<div class="probe-row"><span class="p-k">Area:</span><span class="p-v" id="wp-area">740 mm²</span></div>
							<div class="probe-row"><span class="p-k">Fmax:</span><span class="p-v" id="wp-fmax">3.80 GHz</span></div>
							<div class="probe-row"><span class="p-k">Vmin:</span><span class="p-v" id="wp-vmin">0.775 V</span></div>
							<div class="probe-row"><span class="p-k">Iddq:</span><span class="p-v" id="wp-leak">24.5 mA</span></div>
						</div>
					</div>

					<!-- BIN DISTRIBUTION LEGEND -->
					<div class="wafer-legend">
						<div class="legend-item"><span class="leg-color bin1"></span><span id="leg-bin1-text">Perfect (Bin 1): 46 (55.4%) &bull; All Cores</span></div>
						<div class="legend-item"><span class="leg-color bin2"></span><span id="leg-bin2-text">Defeatured (Bin 2): 27 (32.5%) &bull; Harvest</span></div>
						<div class="legend-item"><span class="leg-color binx"></span><span id="leg-binx-text">Fallout (Reject): 10 (12.1%) &bull; Defect</span></div>
					</div>

					<!-- ACTIONS -->
					<div class="wafer-actions">
						<button id="wafer-scan-btn" type="button" class="wafer-btn primary" title="Randomize wafer defects & run ATE probe sweep">
							<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 0 1-9 9m9-9a9 9 0 0 0-9-9m9 9H3m9 9a9 9 0 0 1-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/></svg>
							<span>Run ATE Pogo Probe Scan</span>
						</button>
						<button id="wafer-random-btn" type="button" class="wafer-btn">
							<span>Probe Random Die</span>
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- 8x8 BIT CMOS MULTIPLIER MODAL (CADENCE VIRTUOSO ARCHITECTURE) -->
	<div id="multiplier-modal" class="wafer-modal hidden" role="dialog" aria-modal="true" aria-label="8x8 Bit CMOS Multiplier (Cadence Virtuoso VLSI)" style="display: none;">
		<div class="wafer-backdrop" id="multiplier-backdrop"></div>
		<div class="wafer-dialog mult-dialog">
			<div class="wafer-modal-header">
				<div class="wafer-title-wrap">
					<span class="hud-pulse-dot"></span>
					<div class="wafer-title-meta">
						<span class="wafer-title">8×8-BIT CMOS MULTIPLIER &bull; CADENCE VIRTUOSO VLSI</span>
						<span class="wafer-sub mono">Carry-Save Array (CSA) &bull; 64 AND Gates &bull; 48 FAs &bull; 8 HAs &bull; 1,696 Transistors</span>
					</div>
				</div>
				<div class="mult-header-actions">
					<a href="https://github.com/bowuu/8x8-Multiplier" target="_blank" rel="noopener noreferrer" class="mult-gh-link mono" title="View 8x8 Multiplier on GitHub">
						<svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
						<span>bowuu/8x8-Multiplier</span>
					</a>
					<button id="multiplier-close-btn" class="wafer-close-btn" type="button" aria-label="Close Multiplier">&times;</button>
				</div>
			</div>

			<div class="mult-body">
				<!-- INPUT REGISTERS -->
				<div class="mult-inputs-card">
					<div class="mult-reg-row">
						<div class="mult-reg-label mono">
							<strong>INPUT A [7:0]</strong>
							<span class="reg-meta" id="mult-a-meta">Hex: 0xAA &bull; Dec: 170</span>
						</div>
						<div class="mult-bits" id="mult-a-bits"></div>
					</div>

					<div class="mult-op-badge mono">&times; MULTIPLY</div>

					<div class="mult-reg-row">
						<div class="mult-reg-label mono">
							<strong>INPUT B [7:0]</strong>
							<span class="reg-meta" id="mult-b-meta">Hex: 0x55 &bull; Dec: 85</span>
						</div>
						<div class="mult-bits" id="mult-b-bits"></div>
					</div>

					<div class="mult-presets">
						<span class="presets-title mono">PRESETS:</span>
						<button type="button" class="mult-pre-btn mono" data-a="255" data-b="255">255 &times; 255 (Max)</button>
						<button type="button" class="mult-pre-btn mono" data-a="170" data-b="85">0xAA &times; 0x55</button>
						<button type="button" class="mult-pre-btn mono" data-a="15" data-b="240">0x0F &times; 0xF0</button>
						<button type="button" class="mult-pre-btn mono" data-a="128" data-b="64">128 &times; 64</button>
						<button type="button" class="mult-pre-btn mono" id="mult-rand-btn">Random</button>
						<button type="button" class="mult-pre-btn mono" data-a="0" data-b="0">Clear (0 &times; 0)</button>
					</div>
				</div>

				<!-- 8x8 PARTIAL PRODUCT MATRIX & TELEMETRY -->
				<div class="mult-middle-grid">
					<div class="mult-matrix-wrap">
						<div class="mult-matrix-title mono">
							<span>8&times;8 AND GATE PARTIAL PRODUCT ARRAY (PP<sub>i,j</sub> = A<sub>i</sub> &bull; B<sub>j</sub>)</span>
							<span id="mult-active-pp" class="mono">Active: 16 / 64</span>
						</div>
						<div class="mult-matrix-grid" id="mult-matrix-grid"></div>
						<div class="mult-cell-tooltip mono" id="mult-cell-info">Hover any cell to inspect transistor-level AND2 gate &amp; CSA routing stage</div>
					</div>

					<div class="mult-vlsi-stats mono">
						<div class="stat-box">
							<span class="st-lbl">VLSI Cell Matrix</span>
							<span class="st-val">64 AND2 + 48 FA + 8 HA</span>
						</div>
						<div class="stat-box">
							<span class="st-lbl">Critical Path Delay (t<sub>pd</sub>)</span>
							<span class="st-val" id="mult-tpd-val">~1.84 ns (4 Stages)</span>
						</div>
						<div class="stat-box">
							<span class="st-lbl">CMOS Transistor Count</span>
							<span class="st-val">1,696 Transistors</span>
						</div>
						<div class="stat-box">
							<span class="st-lbl">Dynamic Switching Energy</span>
							<span class="st-val" id="mult-energy-val">~98.4 fJ / op</span>
						</div>
					</div>
				</div>

				<!-- 16-BIT PRODUCT OUTPUT REGISTER -->
				<div class="mult-output-card">
					<div class="mult-output-header">
						<div class="mult-product-title mono">16-BIT PRODUCT OUTPUT REGISTER P [15:0]</div>
						<div class="mult-product-vals mono">
							<span class="p-dec mono" id="mult-p-dec">P = 14,450</span>
							<span class="p-hex mono" id="mult-p-hex">0x3872</span>
							<span class="p-bin mono" id="mult-p-bin">0011 1000 0111 0010₂</span>
						</div>
					</div>
					<div class="mult-product-bits" id="mult-product-bits"></div>
				</div>
			</div>
		</div>
	</div>

	<!-- LOGIC ANALYZER BUS SNIFFER HUD & CANVAS (BOTTOM DOCK) -->
	<div id="analyzer-hud" class="ee-hud analyzer-hud hidden" style="display: none;">
		<div class="analyzer-hud-left">
			<span class="hud-pulse-dot"></span>
			<span class="hud-title">📊 LOGIC ANALYZER &bull; 4-CH HARDWARE BUS SNIFFER</span>
			<span class="analyzer-status mono" id="analyzer-status-text">CAPTURING &bull; 24.0 MHz SAMPLE</span>
		</div>
		<div class="analyzer-hud-controls">
			<button id="analyzer-run-btn" type="button" class="ee-hud-btn active">Pause</button>
			<button id="analyzer-clear-btn" type="button" class="ee-hud-btn">Clear</button>
			<button id="analyzer-inject-btn" type="button" class="ee-hud-btn">Send Test Packet</button>
			<button id="analyzer-exit-btn" type="button" class="ee-hud-btn">Exit (Esc)</button>
		</div>
	</div>
	<canvas id="analyzer-canvas" class="ee-canvas analyzer-canvas hidden" aria-hidden="true" style="display: none;"></canvas>

	<!-- HOT AIR SOLDER REFLOW HUD & CANVAS -->
	<div id="reflow-hud" class="ee-hud reflow-hud hidden" style="display: none;">
		<span class="hud-pulse-dot"></span>
		<span class="hud-title">🔥 HOT AIR SOLDER REFLOW &bull; <span id="reflow-temp-text">NOZZLE: 350°C</span> &bull; HOVER TO MELT JOINTS</span>
		<button id="reflow-blast-btn" type="button" class="ee-hud-btn">Thermal Blast (420°C)</button>
		<button id="reflow-quench-btn" type="button" class="ee-hud-btn">Tweezer Align &amp; Quench (Freeze)</button>
		<button id="reflow-exit-btn" type="button" class="ee-hud-btn">Exit (Esc)</button>
	</div>
	<canvas id="reflow-canvas" class="ee-canvas hidden" aria-hidden="true" style="display: none;"></canvas>

	<!-- 8-BIT BUS SEQUENCER MODAL (HARDWARE DIAGNOSTIC DRUM MACHINE) -->
	<div id="sequencer-modal" class="wafer-modal hidden" role="dialog" aria-modal="true" aria-label="8-Bit Bus Diagnostic Sequencer" style="display: none;">
		<div class="wafer-backdrop" id="sequencer-backdrop"></div>
		<div class="wafer-dialog seq-dialog">
			<div class="wafer-modal-header">
				<div class="wafer-title-wrap">
					<span class="hud-pulse-dot"></span>
					<div class="wafer-title-meta">
						<span class="wafer-title">8-BIT BUS DIAGNOSTIC SEQUENCER</span>
						<span class="wafer-sub mono">Procedural Hardware Acoustics &bull; Relays, BIOS Post, Steppers &amp; Spark Arcs</span>
					</div>
				</div>
				<button id="sequencer-close-btn" class="wafer-close-btn" type="button" aria-label="Close Sequencer">&times;</button>
			</div>

			<div class="seq-body">
				<!-- TRANSPORT BAR -->
				<div class="seq-transport">
					<button id="seq-play-btn" type="button" class="seq-play-btn primary">
						<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" id="seq-play-icon"><polygon points="5 3 19 12 5 21 5 3"/></svg>
						<span id="seq-play-text">Play</span>
					</button>

					<div class="seq-tempo-wrap mono">
						<span>TEMPO:</span>
						<input type="range" id="seq-bpm-slider" min="60" max="180" value="120" class="seq-slider">
						<span id="seq-bpm-val">120 BPM</span>
					</div>

					<div class="seq-presets mono">
						<span>PRESETS:</span>
						<button type="button" class="seq-pre-btn" data-preset="heartbeat">Silicon Beat</button>
						<button type="button" class="seq-pre-btn" data-preset="atescan">ATE Probe Scan</button>
						<button type="button" class="seq-pre-btn" data-preset="random">Random</button>
						<button type="button" class="seq-pre-btn" data-preset="clear">Clear</button>
					</div>
				</div>

				<!-- STEP MATRIX (6 TRACKS x 16 STEPS) -->
				<div class="seq-matrix-wrap" id="seq-matrix-wrap"></div>
			</div>
		</div>
	</div>

	<!-- WAFER DIE SORT BREAKOUT ARCADE MODAL -->
	<div id="breakout-modal" class="wafer-modal hidden" role="dialog" aria-modal="true" aria-label="Wafer Die Sort Breakout Arcade" style="display: none;">
		<div class="wafer-backdrop" id="breakout-backdrop"></div>
		<div class="wafer-dialog breakout-dialog">
			<div class="wafer-modal-header">
				<div class="wafer-title-wrap">
					<span class="hud-pulse-dot"></span>
					<div class="wafer-title-meta">
						<span class="wafer-title">WAFER DIE SORT BREAKOUT ARCADE</span>
						<span class="wafer-sub mono">Probe Card Paddle &bull; Silicon Die Bricks &bull; ATE Chip-tune Audio</span>
					</div>
				</div>
				<button id="breakout-close-btn" class="wafer-close-btn" type="button" aria-label="Close Breakout">&times;</button>
			</div>

			<div class="breakout-body">
				<div class="breakout-score-bar mono">
					<div class="bo-stat"><span class="bo-k">SCORE:</span><span class="bo-v" id="bo-score">0</span></div>
					<div class="bo-stat"><span class="bo-k">YIELD:</span><span class="bo-v" id="bo-yield">100%</span></div>
					<div class="bo-stat"><span class="bo-k">LIVES:</span><span class="bo-v" id="bo-lives">❤️❤️❤️</span></div>
					<div class="bo-stat"><span class="bo-k">PROBED:</span><span class="bo-v" id="bo-probed">0 / 48</span></div>
					<button id="breakout-restart-btn" type="button" class="bo-btn">Restart</button>
				</div>

				<div class="breakout-canvas-wrap">
					<canvas id="breakout-canvas" width="600" height="380"></canvas>
					<div class="breakout-hints mono">Mouse or &larr; / &rarr; to slide Probe Card &bull; Space to launch &bull; Esc to exit</div>
				</div>
			</div>
		</div>
	</div>

	<!-- LAB EXTRAS DRAWER / POPOVER (SORTED ALPHABETICALLY A-Z: 14 ITEMS) -->
