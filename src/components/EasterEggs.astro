			if (cachedCryoSprite) return;

			// 1. Cryo LN2 vapor sprite (128x128)
			cachedCryoSprite = document.createElement('canvas');
			cachedCryoSprite.width = 128;
			cachedCryoSprite.height = 128;
			const cCtx = cachedCryoSprite.getContext('2d');
			if (cCtx) {
				const grad = cCtx.createRadialGradient(64, 64, 0, 64, 64, 64);
				grad.addColorStop(0, 'rgba(255, 255, 255, 0.95)');
				grad.addColorStop(0.25, 'rgba(224, 242, 254, 0.75)');
				grad.addColorStop(0.55, 'rgba(56, 189, 248, 0.40)');
				grad.addColorStop(0.85, 'rgba(14, 165, 233, 0.15)');
				grad.addColorStop(1, 'rgba(14, 165, 233, 0)');
				cCtx.fillStyle = grad;
				cCtx.fillRect(0, 0, 128, 128);
			}

			// 2. Heat Gun incandescent vapor sprite (128x128)
			cachedHeatSprite = document.createElement('canvas');
			cachedHeatSprite.width = 128;
			cachedHeatSprite.height = 128;
			const hCtx = cachedHeatSprite.getContext('2d');
			if (hCtx) {
				const grad = hCtx.createRadialGradient(64, 64, 0, 64, 64, 64);
				grad.addColorStop(0, 'rgba(255, 255, 255, 0.95)');
				grad.addColorStop(0.28, 'rgba(254, 240, 138, 0.80)');
				grad.addColorStop(0.58, 'rgba(249, 115, 22, 0.45)');
				grad.addColorStop(0.85, 'rgba(225, 29, 72, 0.18)');
				grad.addColorStop(1, 'rgba(147, 51, 234, 0)');
				hCtx.fillStyle = grad;
				hCtx.fillRect(0, 0, 128, 128);
			}

			// 3. Surface heat glow spot (96x96)
			cachedHeatSpotSprite = document.createElement('canvas');
			cachedHeatSpotSprite.width = 96;
			cachedHeatSpotSprite.height = 96;
			const sCtx = cachedHeatSpotSprite.getContext('2d');
			if (sCtx) {
				const grad = sCtx.createRadialGradient(48, 48, 0, 48, 48, 48);
				grad.addColorStop(0, 'rgba(255, 255, 255, 0.80)');
				grad.addColorStop(0.3, 'rgba(249, 115, 22, 0.60)');
				grad.addColorStop(0.7, 'rgba(225, 29, 72, 0.30)');
				grad.addColorStop(1, 'rgba(225, 29, 72, 0)');
				sCtx.fillStyle = grad;
				sCtx.fillRect(0, 0, 96, 96);
			}
		}

		function handleThermalPointerMove(e: MouseEvent) {
			thermalPointerX = e.clientX;
			thermalPointerY = e.clientY;
			if (tSpotCursor) {
				tSpotCursor.style.transform = `translate3d(${e.clientX + 14}px, ${e.clientY + 14}px, 0)`;
			}
		}

		function handleThermalPointerDown(e: MouseEvent) {
			if (e.target && (e.target as HTMLElement).closest('.ee-hud, .wafer-modal, .lab-extras-modal')) return;
			isThermalSpraying = true;
			thermalPointerX = e.clientX;
			thermalPointerY = e.clientY;
			audioEngine.startThermalSpray(thermalToolMode);
		}

		function handleThermalPointerUp() {
			isThermalSpraying = false;
			audioEngine.stopThermalSpray();
		}

		function startThermal() {
			if (isThermal || !thermalCanvas) return;
			closeAllActiveModes();
			isThermal = true;
			initThermalSprites();

			if (thermalHud) {
				thermalHud.style.display = 'flex';
				thermalHud.classList.remove('hidden');
			}
			if (thermalScaleBar) {
				thermalScaleBar.style.display = 'flex';
				thermalScaleBar.classList.remove('hidden');
			}
			if (thermalSpots) {
				thermalSpots.style.display = 'block';
				thermalSpots.classList.remove('hidden');
			}
			thermalCanvas.style.display = 'block';
			thermalCanvas.classList.remove('hidden');
			document.body.classList.add('thermal-active');

			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			thermalCanvas.width = window.innerWidth * dpr;
			thermalCanvas.height = window.innerHeight * dpr;
			const ctx = thermalCanvas.getContext('2d');
			if (!ctx) return;
			ctx.scale(dpr, dpr);

			window.addEventListener('mousemove', handleThermalPointerMove, { passive: true });
			window.addEventListener('mousedown', handleThermalPointerDown);
			window.addEventListener('mouseup', handleThermalPointerUp);

			let lastDomUpdate = 0;

			function loopThermal() {
				if (!isThermal || !ctx || !thermalCanvas) return;
				ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);

				if (isThermalSpraying) {
					if (thermalToolMode === 'cryo') {
						probeTemp = Math.max(-196, probeTemp - 8.5);

						// Spawn cryogenic billowing vapor plumes (capped pool for zero lag)
						if (thermalVapors.length < 45) {
							for (let i = 0; i < 2; i++) {
								const ang = Math.random() * Math.PI * 2;
								const spd = 1.5 + Math.random() * 4.0;
								thermalVapors.push({
									x: thermalPointerX + (Math.random() - 0.5) * 16,
									y: thermalPointerY + (Math.random() - 0.5) * 16,
									vx: Math.cos(ang) * spd,
									vy: Math.sin(ang) * spd + 1.2, // Cold gas drifts down
									radius: 18 + Math.random() * 22,
									life: 0,
									maxLife: 26 + Math.random() * 16,
									isCryo: true
								});
							}
						}

						// Spawn dendritic frost crystals blooming on contact surface
						if (Math.random() > 0.65 && frostCrystals.length < 25) {
							const branches = [];
							const branchCount = 3 + Math.floor(Math.random() * 2);
							for (let b = 0; b < branchCount; b++) {
								branches.push({
									offset: 0.3 + Math.random() * 0.5,
									angle: (Math.random() > 0.5 ? 1 : -1) * (0.55 + Math.random() * 0.3),
									length: 6 + Math.random() * 8
								});
							}
							frostCrystals.push({
								x: thermalPointerX + (Math.random() - 0.5) * 36,
								y: thermalPointerY + (Math.random() - 0.5) * 36,
								angle: Math.random() * Math.PI * 2,
								length: 15 + Math.random() * 18,
								branches,
								life: 0,
								maxLife: 80 + Math.random() * 40
							});
						}
					} else {
						probeTemp = Math.min(450, probeTemp + 12.0);

						// Heat gun buoyant rising thermal plumes
						if (thermalVapors.length < 45) {
							for (let i = 0; i < 2; i++) {
								const ang = Math.random() * Math.PI * 2;
								const spd = 1.8 + Math.random() * 4.0;
								thermalVapors.push({
									x: thermalPointerX + (Math.random() - 0.5) * 16,
									y: thermalPointerY + (Math.random() - 0.5) * 16,
									vx: Math.cos(ang) * spd,
									vy: Math.sin(ang) * spd - 2.5, // Hot gas rises
									radius: 16 + Math.random() * 22,
									life: 0,
									maxLife: 24 + Math.random() * 14,
									isCryo: false
								});
							}
						}

						if (Math.random() > 0.65 && heatSpots.length < 20) {
							heatSpots.push({
								x: thermalPointerX + (Math.random() - 0.5) * 20,
								y: thermalPointerY + (Math.random() - 0.5) * 20,
								radius: 16 + Math.random() * 22,
								life: 0,
								maxLife: 55 + Math.random() * 25
							});
						}
					}
				} else {
					probeTemp += (24.5 - probeTemp) * 0.05;
				}

				// Throttled DOM telemetry updates (~16 updates/sec) to eliminate forced layout thrashing
				const now = performance.now();
				if (now - lastDomUpdate > 60) {
					lastDomUpdate = now;
					cpuTemp += (Math.random() - 0.49) * 0.3;
					vrmTemp += (Math.random() - 0.49) * 0.4;
					memTemp += (Math.random() - 0.49) * 0.2;
					if (tCpuVal) tCpuVal.textContent = `${cpuTemp.toFixed(1)}°C`;
					if (tVrmVal) tVrmVal.textContent = `${vrmTemp.toFixed(1)}°C`;
					if (tMemVal) tMemVal.textContent = `${memTemp.toFixed(1)}°C`;

					if (tProbeVal) {
						if (probeTemp <= -100) {
							tProbeVal.textContent = `${probeTemp.toFixed(1)}°C [SUPERCOOLED 77K]`;
							tProbeVal.style.color = '#38bdf8';
						} else if (probeTemp >= 120) {
							tProbeVal.textContent = `${probeTemp.toFixed(1)}°C [RUNAWAY SATURATION]`;
							tProbeVal.style.color = '#ef4444';
						} else {
							tProbeVal.textContent = `${probeTemp.toFixed(1)}°C`;
							tProbeVal.style.color = '#10b981';
						}
					}
				}

				// 1. Draw glowing surface heat spots via pre-rendered hardware sprite
				if (cachedHeatSpotSprite) {
					for (let i = heatSpots.length - 1; i >= 0; i--) {
						const hs = heatSpots[i];
						hs.life++;
						const progress = hs.life / hs.maxLife;
						const alpha = (1 - progress) * 0.45;
						ctx.globalAlpha = Math.max(0, Math.min(1, alpha));
						const d = hs.radius * 2;
						ctx.drawImage(cachedHeatSpotSprite, hs.x - hs.radius, hs.y - hs.radius, d, d);
						if (hs.life >= hs.maxLife) heatSpots.splice(i, 1);
					}
				}

				// 2. Draw dendritic frost crystals (batched single path, zero shadowBlur for 60fps)
				for (let i = frostCrystals.length - 1; i >= 0; i--) {
					const fc = frostCrystals[i];
					fc.life++;
					const progress = fc.life / fc.maxLife;
					const alpha = (1 - progress) * 0.85;

					ctx.strokeStyle = `rgba(224, 242, 254, ${alpha.toFixed(2)})`;
					ctx.lineWidth = 1.4;
					ctx.beginPath();

					for (let sym = 0; sym < 6; sym++) {
						const rootAngle = fc.angle + (sym * Math.PI) / 3;
						const cosR = Math.cos(rootAngle);
						const sinR = Math.sin(rootAngle);
						const endX = fc.x + cosR * fc.length;
						const endY = fc.y + sinR * fc.length;

						ctx.moveTo(fc.x, fc.y);
						ctx.lineTo(endX, endY);

						for (const br of fc.branches) {
							const bx = fc.x + cosR * (fc.length * br.offset);
							const by = fc.y + sinR * (fc.length * br.offset);
							const bAngle1 = rootAngle + br.angle;
							const bAngle2 = rootAngle - br.angle;
							ctx.moveTo(bx, by);
							ctx.lineTo(bx + Math.cos(bAngle1) * br.length, by + Math.sin(bAngle1) * br.length);
							ctx.moveTo(bx, by);
							ctx.lineTo(bx + Math.cos(bAngle2) * br.length, by + Math.sin(bAngle2) * br.length);
						}
					}
					ctx.stroke();

					if (fc.life >= fc.maxLife) frostCrystals.splice(i, 1);
				}

				// 3. Draw billowing soft-edge thermal vapor clouds via pre-rendered hardware sprites
				for (let i = thermalVapors.length - 1; i >= 0; i--) {
					const v = thermalVapors[i];
					v.x += v.vx;
					v.y += v.vy;
					v.vx *= 0.96;
					v.vy *= 0.96;
					v.life++;

					const progress = v.life / v.maxLife;
					const currentRadius = v.radius * (1 + progress * 1.5);
					const alpha = (1 - progress) * 0.40;

					const sprite = v.isCryo ? cachedCryoSprite : cachedHeatSprite;
					if (sprite) {
						ctx.globalAlpha = Math.max(0, Math.min(1, alpha));
						const d = currentRadius * 2;
						ctx.drawImage(sprite, v.x - currentRadius, v.y - currentRadius, d, d);
					}

					if (v.life >= v.maxLife) {
						thermalVapors.splice(i, 1);
					}
				}
				ctx.globalAlpha = 1.0;

				thermalAnimId = requestAnimationFrame(loopThermal);
			}

			thermalAnimId = requestAnimationFrame(loopThermal);
		}

		function toggleThermalTool() {
			if (thermalToolMode === 'cryo') {
				thermalToolMode = 'heatgun';
				if (tToolText) tToolText.textContent = 'TOOL: HEAT GUN (450°C)';
				if (tToolBtn) tToolBtn.textContent = 'Switch to LN2 Cryo (-196°C)';
			} else {
				thermalToolMode = 'cryo';
				if (tToolText) tToolText.textContent = 'TOOL: LN2 CRYO-SPRAY (-196°C)';
				if (tToolBtn) tToolBtn.textContent = 'Switch to Heat Gun (450°C)';
			}
			if (isThermalSpraying) {
				audioEngine.startThermalSpray(thermalToolMode);
			}
		}

		function normalizeThermal() {
			probeTemp = 24.5;
			cpuTemp = 98.4;
			vrmTemp = 104.2;
			memTemp = 71.5;
			thermalVapors = [];
			frostCrystals = [];
			heatSpots = [];
		}

		function resetThermal() {
			if (!isThermal) return;
			isThermal = false;
			isThermalSpraying = false;
			audioEngine.stopThermalSpray();
			cancelAnimationFrame(thermalAnimId);
			if (thermalHud) {
				thermalHud.classList.add('hidden');
				thermalHud.style.display = 'none';
			}
			if (thermalScaleBar) {
				thermalScaleBar.classList.add('hidden');
				thermalScaleBar.style.display = 'none';
			}
			if (thermalSpots) {
				thermalSpots.classList.add('hidden');
				thermalSpots.style.display = 'none';
			}
			if (thermalCanvas) {
				thermalCanvas.classList.add('hidden');
				thermalCanvas.style.display = 'none';
			}
			document.body.classList.remove('thermal-active');
			window.removeEventListener('mousemove', handleThermalPointerMove);
			window.removeEventListener('mousedown', handleThermalPointerDown);
			window.removeEventListener('mouseup', handleThermalPointerUp);
			thermalVapors = [];
			frostCrystals = [];
			heatSpots = [];
			const ctx = thermalCanvas?.getContext('2d');
			if (ctx && thermalCanvas) ctx.clearRect(0, 0, thermalCanvas.width, thermalCanvas.height);
		}

		tToolBtn?.addEventListener('click', toggleThermalTool);
		thermalResetBtn?.addEventListener('click', normalizeThermal);
		thermalExitBtn?.addEventListener('click', resetThermal);

		// Global API Exports
		(window as any).__toggleZeroG = () => (isZeroG ? resetZeroG() : startZeroG());
		(window as any).__toggleTilt = (force?: boolean) => toggleTilt(force);
		(window as any).__toggleDegauss = () => (isDegauss ? resetDegauss() : startDegauss());
		(window as any).__toggleSphere = () => (isSphere ? resetSphere() : startSphere());
		(window as any).__toggleQuantum = () => (isQuantum ? resetQuantum() : startQuantum());
		(window as any).__toggleThermal = () => (isThermal ? resetThermal() : startThermal());
		(window as any).__toggleLabExtras = () => {
			if (!extrasModal) return;
			const isHidden = extrasModal.classList.contains('hidden');
			if (isHidden) {
				updateDrawerActiveUI();
				extrasModal.classList.remove('hidden');
				extrasModal.style.display = 'block';
			} else {
				extrasModal.classList.add('hidden');
				extrasModal.style.display = 'none';
			}
		};

		function updateDrawerActiveUI() {
			const sphereBtn = document.getElementById('trigger-sphere-btn');
			const tiltBtn = document.getElementById('trigger-tilt-btn');
			const degaussBtn = document.getElementById('trigger-degauss-btn');
			const thermalBtn = document.getElementById('trigger-thermal-btn');
			const quantumBtn = document.getElementById('trigger-quantum-btn');
			const zerogBtn = document.getElementById('trigger-zerog-btn');
			const waferBtn = document.getElementById('trigger-wafer-btn');
			const waferModal = document.getElementById('wafer-modal');

			sphereBtn?.classList.toggle('active', isSphere);
			tiltBtn?.classList.toggle('active', isTilt);
			degaussBtn?.classList.toggle('active', isDegauss);
			thermalBtn?.classList.toggle('active', isThermal);
			quantumBtn?.classList.toggle('active', isQuantum);
			zerogBtn?.classList.toggle('active', isZeroG);
			waferBtn?.classList.toggle('active', !!(waferModal && !waferModal.classList.contains('hidden')));
		}

		(window as any).__updateDrawerActiveUI = updateDrawerActiveUI;

		const kbLabEl = document.getElementById('keyboard-lab');
		function isNearKeyboardLab(): boolean {
			if (!kbLabEl) return false;
			const rect = kbLabEl.getBoundingClientRect();
			return rect.bottom > -80 && rect.top < window.innerHeight + 80;
		}

		window.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' || e.key === 'Esc') {
				let handled = false;
				const waferModal = document.getElementById('wafer-modal');
				if (waferModal && (!waferModal.classList.contains('hidden') || waferModal.style.display !== 'none')) {
					(window as any).__closeWaferMap?.();
					handled = true;
				}
				if (isZeroG || isTilt || isDegauss || isSphere || isQuantum || isThermal) {
					closeAllActiveModes();
					handled = true;
				}
				if (extrasModal && (!extrasModal.classList.contains('hidden') || extrasModal.style.display !== 'none')) {
					extrasModal.classList.add('hidden');
					extrasModal.style.display = 'none';
					handled = true;
				}
				if (handled) {
					e.preventDefault();
					updateDrawerActiveUI();
				}
				return;
			}

			const hasModifiers = (e.ctrlKey || e.metaKey) && e.altKey;
			if (!hasModifiers) return;

			const activeTag = document.activeElement?.tagName;
			if (activeTag === 'INPUT' || activeTag === 'TEXTAREA' || activeTag === 'SELECT') return;

			const termModal = document.getElementById('terminal-modal');
			if (termModal && termModal.classList.contains('open')) return;

			if (isNearKeyboardLab()) return;
			if (document.activeElement?.closest('#keyboard-lab')) return;

			if (e.code === 'KeyG') {
				e.preventDefault();
				(window as any).__toggleZeroG();
				updateDrawerActiveUI();
			} else if (e.code === 'KeyH') {
				e.preventDefault();
				(window as any).__toggleTilt();
				updateDrawerActiveUI();
			}
		});

		// Lab Extras Drawer Wire-up (Alphabetical Order 9 items)
		document.getElementById('trigger-sphere-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			if (extrasModal) extrasModal.style.display = 'none';
			if (isSphere) {
				resetSphere();
			} else {
				startSphere();
			}
			updateDrawerActiveUI();
		});

		document.getElementById('trigger-tilt-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			if (extrasModal) extrasModal.style.display = 'none';
			if (isTilt) {
				toggleTilt(false);
			} else {
				toggleTilt(true);
			}
			updateDrawerActiveUI();
		});

		document.getElementById('trigger-boop-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			if (extrasModal) extrasModal.style.display = 'none';
			(window as any).__boopDog?.();
		});

		document.getElementById('trigger-degauss-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			if (extrasModal) extrasModal.style.display = 'none';
			if (isDegauss) {
				resetDegauss();
			} else {
				startDegauss();
			}
			updateDrawerActiveUI();
		});

		document.getElementById('trigger-thermal-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			if (extrasModal) extrasModal.style.display = 'none';
			if (isThermal) {
				resetThermal();
			} else {
				startThermal();
			}
			updateDrawerActiveUI();
		});

		document.getElementById('trigger-quantum-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			if (extrasModal) extrasModal.style.display = 'none';
			if (isQuantum) {
				resetQuantum();
			} else {
				startQuantum();
			}
			updateDrawerActiveUI();
		});

		document.getElementById('trigger-wafer-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			if (extrasModal) extrasModal.style.display = 'none';
			const waferModal = document.getElementById('wafer-modal');
			if (waferModal && !waferModal.classList.contains('hidden')) {
				(window as any).__closeWaferMap?.();
			} else {
				(window as any).__openWaferMap?.();
			}
			updateDrawerActiveUI();
		});

		document.getElementById('trigger-zerog-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			if (extrasModal) extrasModal.style.display = 'none';
			if (isZeroG) {
				resetZeroG();
			} else {
				startZeroG();
			}
			updateDrawerActiveUI();
		});

		// Switch sound button in drawer
		const drawerSoundBtn = document.getElementById('trigger-switch-sound-btn');
		const drawerSoundBadge = document.getElementById('extras-sound-badge');
		const drawerSoundDesc = document.getElementById('extras-sound-desc');

		function updateDrawerSoundUI(p: string) {
			if (!drawerSoundBadge) return;
			const badges: Record<string, string> = {
				off: 'Sound: Off',
				blue: 'Blue (Clicky)',
				red: 'Red (Linear)',
				modelm: 'Model M (Spring)'
			};
			drawerSoundBadge.textContent = badges[p] || 'Sound: Off';
			if (drawerSoundDesc) {
				drawerSoundDesc.textContent = p === 'off' ? 'Procedural Web Audio switch synth' : `Acoustics active: ${badges[p]}`;
			}
			drawerSoundBtn?.classList.toggle('active', p !== 'off');
		}

		updateDrawerSoundUI(audioEngine.profile);
		window.addEventListener('switch-sound-changed', ((e: CustomEvent) => {
			if (e.detail?.profile) updateDrawerSoundUI(e.detail.profile);
		}) as EventListener);

		drawerSoundBtn?.addEventListener('click', () => {
			const current = audioEngine.profile;
			const order = ['off', 'blue', 'red', 'modelm'];
			const next = order[(order.indexOf(current) + 1) % order.length] as any;
			audioEngine.setProfile(next);
			updateDrawerSoundUI(next);
			if (next !== 'off') audioEngine.play('KeyA');
			updateDrawerActiveUI();
		});

		extrasCloseBtn?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			if (extrasModal) extrasModal.style.display = 'none';
		});

		document.addEventListener('click', (e) => {
			const target = e.target as HTMLElement;
			if (extrasModal && !extrasModal.classList.contains('hidden')) {
				if (!extrasModal.contains(target) && !target.closest('#footer-extras-btn')) {
					extrasModal.classList.add('hidden');
					extrasModal.style.display = 'none';
				}
			}
		});
	}

	let isEasterEggsInitialized = false;
	function safeInit() {
		if (isEasterEggsInitialized) return;
		isEasterEggsInitialized = true;
		initEasterEggs();
		initWaferInspector();
		initDogBoop();
	}

	safeInit();
	document.addEventListener('astro:page-load', safeInit);
</script>

<style>
	/* FLOATING HUDS */
	.ee-hud {
		position: fixed;
		top: 16px;
		left: 50%;
		transform: translateX(-50%);
		background: rgba(15, 23, 42, 0.94);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border: 1px solid var(--accent);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4), 0 0 16px rgba(var(--accent-rgb), 0.35);
		color: #f8fafc;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.78em;
		letter-spacing: 0.04em;
		padding: 0.45em 1.1em;
		border-radius: 24px;
		display: flex;
		align-items: center;
		gap: 0.75em;
		z-index: 100000;
		transition: all 0.2s ease;
		white-space: nowrap;
	}
	.hidden,
	.ee-hud.hidden,
	.lab-extras-modal.hidden,
	.wafer-modal.hidden,
	.sphere-core.hidden,
	.thermal-scale-bar.hidden,
	.thermal-spots.hidden,
	.ee-canvas.hidden {
		display: none !important;
	}

	.hud-pulse-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #22c55e;
		box-shadow: 0 0 8px #22c55e;
		animation: pulseDot 1.4s infinite ease-in-out;
		flex-shrink: 0;
	}
	@keyframes pulseDot {
		0%, 100% { opacity: 1; transform: scale(1); }
		50% { opacity: 0.4; transform: scale(0.85); }
	}

	.ee-hud-btn {
		font-size: 0.9em;
		font-weight: 700;
		padding: 0.22em 0.7em;
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.12);
		border: 1px solid rgba(255, 255, 255, 0.25);
		color: #ffffff;
		cursor: pointer;
		transition: all 0.15s ease;
	}
	.ee-hud-btn:hover {
		background: var(--accent);
		border-color: var(--accent);
		color: #ffffff;
	}

	/* LAB EXTRAS MODAL DRAWER */
	.lab-extras-modal {
		position: fixed;
		bottom: 60px;
		right: 24px;
		width: 340px;
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		box-shadow: 0 12px 36px rgba(0, 0, 0, 0.45);
		border-radius: 12px;
		padding: 0.9em 1.1em;
		z-index: 99999;
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		animation: extrasPop 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}
	@keyframes extrasPop {
		from { opacity: 0; transform: translateY(10px) scale(0.97); }
		to { opacity: 1; transform: translateY(0) scale(1); }
	}
	.extras-header {
		display: flex;
		justify-content: space-between;
