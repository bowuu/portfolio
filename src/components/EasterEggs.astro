	.item-icon {
		font-size: 1.25em;
		flex-shrink: 0;
	}
	.item-meta {
		flex: 1;
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.item-name {
		font-size: 0.82em;
	}
	.item-desc {
		font-size: 0.7em;
		color: rgb(var(--gray));
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.item-kbd {
		font-family: ui-monospace, SFMono-Regular, monospace;
		font-size: 0.7em;
		font-weight: 700;
		padding: 0.15em 0.45em;
		border-radius: 4px;
		background: rgba(var(--gray), 0.2);
		border: 1px solid rgba(var(--gray), 0.4);
		color: rgb(var(--gray-dark));
	}
	:global(html[data-theme="dark"]) .item-kbd {
