		function dissolveCard(card: HTMLElement) {
			if (dissolvedCards.has(card) || isDogElement(card)) return;
			dissolvedCards.add(card);

			const rect = card.getBoundingClientRect();
			card.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
			card.style.opacity = '0';
			card.style.transform = 'scale(0.96)';
			card.style.pointerEvents = 'none';

			// Spawn bold, high-visibility rotating silicon micro-chips
			const count = Math.min(450, Math.max(140, Math.floor((rect.width * rect.height) / 350)));
			const colors = ['#f97316', '#38bdf8', '#0ea5e9', '#fbbf24', '#ffffff', '#34d399', '#c084fc'];

			for (let i = 0; i < count; i++) {
				const px = rect.left + Math.random() * rect.width;
				const py = rect.top + Math.random() * rect.height;
				const col = colors[Math.floor(Math.random() * colors.length)];
				const angle = Math.random() * Math.PI * 2;
				const speed = 2 + Math.random() * 5.5;

				qParticles.push({
					x: px,
					y: py,
					origX: px,
					origY: py,
					vx: Math.cos(angle) * speed,
					vy: Math.sin(angle) * speed - 1.5,
					color: col,
					size: Math.random() * 4.5 + 4.5, // 4.5px - 9.0px bold silicon micro-dies
					rot: Math.random() * Math.PI * 2,
					vRot: (Math.random() - 0.5) * 0.16,
					card: card
