	}
	.extras-close-btn {
		background: transparent;
		border: none;
		color: rgb(var(--gray));
		font-size: 1.25em;
		cursor: pointer;
		padding: 0;
		line-height: 1;
		transition: color 0.15s ease;
	}
	.extras-close-btn:hover {
		color: #ffffff;
	}
	.extras-grid {
