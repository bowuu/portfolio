			cachedHeatSprite.height = 128;
			const hCtx = cachedHeatSprite.getContext('2d');
			if (hCtx) {
				const grad = hCtx.createRadialGradient(64, 64, 0, 64, 64, 64);
				grad.addColorStop(0, 'rgba(255, 255, 255, 0.95)');
				grad.addColorStop(0.28, 'rgba(254, 240, 138, 0.80)');
				grad.addColorStop(0.58, 'rgba(249, 115, 22, 0.45)');
				grad.addColorStop(0.85, 'rgba(225, 29, 72, 0.18)');
				grad.addColorStop(1, 'rgba(147, 51, 234, 0)');
				hCtx.fillStyle = grad;
				hCtx.fillRect(0, 0, 128, 128);
			}

			// 3. Surface heat glow spot (96x96)
			cachedHeatSpotSprite = document.createElement('canvas');
			cachedHeatSpotSprite.width = 96;
			cachedHeatSpotSprite.height = 96;
			const sCtx = cachedHeatSpotSprite.getContext('2d');
			if (sCtx) {
				const grad = sCtx.createRadialGradient(48, 48, 0, 48, 48, 48);
				grad.addColorStop(0, 'rgba(255, 255, 255, 0.80)');
				grad.addColorStop(0.3, 'rgba(249, 115, 22, 0.60)');
				grad.addColorStop(0.7, 'rgba(225, 29, 72, 0.30)');
				grad.addColorStop(1, 'rgba(225, 29, 72, 0)');
				sCtx.fillStyle = grad;
				sCtx.fillRect(0, 0, 96, 96);
			}
		}

		function handleThermalPointerMove(e: MouseEvent) {
			thermalPointerX = e.clientX;
			thermalPointerY = e.clientY;
			if (tSpotCursor) {
				tSpotCursor.style.transform = `translate3d(${e.clientX + 14}px, ${e.clientY + 14}px, 0)`;
			}
		}

		function handleThermalPointerDown(e: MouseEvent) {
			if (e.target && (e.target as HTMLElement).closest('.ee-hud, .wafer-modal, .lab-extras-modal')) return;
			isThermalSpraying = true;
			thermalPointerX = e.clientX;
			thermalPointerY = e.clientY;
			audioEngine.startThermalSpray(thermalToolMode);
		}

		function handleThermalPointerUp() {
			isThermalSpraying = false;
			audioEngine.stopThermalSpray();
		}

		function startThermal() {
			if (isThermal || !thermalCanvas) return;
			closeAllActiveModes();
			isThermal = true;
			initThermalSprites();

			if (thermalHud) {
				thermalHud.style.display = 'flex';
				thermalHud.classList.remove('hidden');
			}
			if (thermalScaleBar) {
				thermalScaleBar.style.display = 'flex';
				thermalScaleBar.classList.remove('hidden');
			}
			if (thermalSpots) {
				thermalSpots.style.display = 'block';
				thermalSpots.classList.remove('hidden');
			}
			thermalCanvas.style.display = 'block';
			thermalCanvas.classList.remove('hidden');
			document.body.classList.add('thermal-active');

			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			thermalCanvas.width = window.innerWidth * dpr;
			thermalCanvas.height = window.innerHeight * dpr;
			const ctx = thermalCanvas.getContext('2d');
			if (!ctx) return;
			ctx.scale(dpr, dpr);

			window.addEventListener('mousemove', handleThermalPointerMove, { passive: true });
			window.addEventListener('mousedown', handleThermalPointerDown);
			window.addEventListener('mouseup', handleThermalPointerUp);

			let lastDomUpdate = 0;

			function loopThermal() {
				if (!isThermal || !ctx || !thermalCanvas) return;
				ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);

				if (isThermalSpraying) {
					if (thermalToolMode === 'cryo') {
						probeTemp = Math.max(-196, probeTemp - 8.5);

						// Spawn cryogenic billowing vapor plumes (capped pool for zero lag)
						if (thermalVapors.length < 45) {
							for (let i = 0; i < 2; i++) {
								const ang = Math.random() * Math.PI * 2;
								const spd = 1.5 + Math.random() * 4.0;
								thermalVapors.push({
									x: thermalPointerX + (Math.random() - 0.5) * 16,
									y: thermalPointerY + (Math.random() - 0.5) * 16,
									vx: Math.cos(ang) * spd,
									vy: Math.sin(ang) * spd + 1.2, // Cold gas drifts down
									radius: 18 + Math.random() * 22,
									life: 0,
									maxLife: 26 + Math.random() * 16,
									isCryo: true
								});
							}
						}

						// Spawn dendritic frost crystals blooming on contact surface
						if (Math.random() > 0.65 && frostCrystals.length < 25) {
							const branches = [];
							const branchCount = 3 + Math.floor(Math.random() * 2);
							for (let b = 0; b < branchCount; b++) {
								branches.push({
									offset: 0.3 + Math.random() * 0.5,
									angle: (Math.random() > 0.5 ? 1 : -1) * (0.55 + Math.random() * 0.3),
									length: 6 + Math.random() * 8
								});
							}
							frostCrystals.push({
								x: thermalPointerX + (Math.random() - 0.5) * 36,
								y: thermalPointerY + (Math.random() - 0.5) * 36,
								angle: Math.random() * Math.PI * 2,
								length: 15 + Math.random() * 18,
								branches,
								life: 0,
								maxLife: 80 + Math.random() * 40
							});
						}
					} else {
						probeTemp = Math.min(450, probeTemp + 12.0);

						// Heat gun buoyant rising thermal plumes
						if (thermalVapors.length < 45) {
							for (let i = 0; i < 2; i++) {
								const ang = Math.random() * Math.PI * 2;
								const spd = 1.8 + Math.random() * 4.0;
								thermalVapors.push({
									x: thermalPointerX + (Math.random() - 0.5) * 16,
									y: thermalPointerY + (Math.random() - 0.5) * 16,
									vx: Math.cos(ang) * spd,
									vy: Math.sin(ang) * spd - 2.5, // Hot gas rises
									radius: 16 + Math.random() * 22,
									life: 0,
									maxLife: 24 + Math.random() * 14,
									isCryo: false
								});
							}
						}

						if (Math.random() > 0.65 && heatSpots.length < 20) {
							heatSpots.push({
								x: thermalPointerX + (Math.random() - 0.5) * 20,
								y: thermalPointerY + (Math.random() - 0.5) * 20,
								radius: 16 + Math.random() * 22,
								life: 0,
								maxLife: 55 + Math.random() * 25
							});
						}
					}
				} else {
					probeTemp += (24.5 - probeTemp) * 0.05;
				}

				// Throttled DOM telemetry updates (~16 updates/sec) to eliminate forced layout thrashing
				const now = performance.now();
				if (now - lastDomUpdate > 60) {
					lastDomUpdate = now;
					cpuTemp += (Math.random() - 0.49) * 0.3;
					vrmTemp += (Math.random() - 0.49) * 0.4;
					memTemp += (Math.random() - 0.49) * 0.2;
					if (tCpuVal) tCpuVal.textContent = `${cpuTemp.toFixed(1)}°C`;
					if (tVrmVal) tVrmVal.textContent = `${vrmTemp.toFixed(1)}°C`;
					if (tMemVal) tMemVal.textContent = `${memTemp.toFixed(1)}°C`;

					if (tProbeVal) {
						if (probeTemp <= -100) {
							tProbeVal.textContent = `${probeTemp.toFixed(1)}°C [SUPERCOOLED 77K]`;
							tProbeVal.style.color = '#38bdf8';
						} else if (probeTemp >= 120) {
							tProbeVal.textContent = `${probeTemp.toFixed(1)}°C [RUNAWAY SATURATION]`;
							tProbeVal.style.color = '#ef4444';
						} else {
							tProbeVal.textContent = `${probeTemp.toFixed(1)}°C`;
							tProbeVal.style.color = '#10b981';
						}
					}
				}

				// 1. Draw glowing surface heat spots via pre-rendered hardware sprite
				if (cachedHeatSpotSprite) {
					for (let i = heatSpots.length - 1; i >= 0; i--) {
						const hs = heatSpots[i];
						hs.life++;
						const progress = hs.life / hs.maxLife;
						const alpha = (1 - progress) * 0.45;
						ctx.globalAlpha = Math.max(0, Math.min(1, alpha));
						const d = hs.radius * 2;
						ctx.drawImage(cachedHeatSpotSprite, hs.x - hs.radius, hs.y - hs.radius, d, d);
						if (hs.life >= hs.maxLife) heatSpots.splice(i, 1);
					}
				}

				// 2. Draw dendritic frost crystals (batched single path, zero shadowBlur for 60fps)
				for (let i = frostCrystals.length - 1; i >= 0; i--) {
					const fc = frostCrystals[i];
					fc.life++;
					const progress = fc.life / fc.maxLife;
					const alpha = (1 - progress) * 0.85;

					ctx.strokeStyle = `rgba(224, 242, 254, ${alpha.toFixed(2)})`;
					ctx.lineWidth = 1.4;
					ctx.beginPath();

					for (let sym = 0; sym < 6; sym++) {
						const rootAngle = fc.angle + (sym * Math.PI) / 3;
						const cosR = Math.cos(rootAngle);
						const sinR = Math.sin(rootAngle);
						const endX = fc.x + cosR * fc.length;
						const endY = fc.y + sinR * fc.length;

						ctx.moveTo(fc.x, fc.y);
						ctx.lineTo(endX, endY);

						for (const br of fc.branches) {
							const bx = fc.x + cosR * (fc.length * br.offset);
							const by = fc.y + sinR * (fc.length * br.offset);
							const bAngle1 = rootAngle + br.angle;
							const bAngle2 = rootAngle - br.angle;
							ctx.moveTo(bx, by);
							ctx.lineTo(bx + Math.cos(bAngle1) * br.length, by + Math.sin(bAngle1) * br.length);
							ctx.moveTo(bx, by);
							ctx.lineTo(bx + Math.cos(bAngle2) * br.length, by + Math.sin(bAngle2) * br.length);
						}
					}
					ctx.stroke();

					if (fc.life >= fc.maxLife) frostCrystals.splice(i, 1);
				}

				// 3. Draw billowing soft-edge thermal vapor clouds via pre-rendered hardware sprites
				for (let i = thermalVapors.length - 1; i >= 0; i--) {
					const v = thermalVapors[i];
					v.x += v.vx;
					v.y += v.vy;
					v.vx *= 0.96;
					v.vy *= 0.96;
					v.life++;

					const progress = v.life / v.maxLife;
					const currentRadius = v.radius * (1 + progress * 1.5);
					const alpha = (1 - progress) * 0.40;

					const sprite = v.isCryo ? cachedCryoSprite : cachedHeatSprite;
					if (sprite) {
						ctx.globalAlpha = Math.max(0, Math.min(1, alpha));
						const d = currentRadius * 2;
						ctx.drawImage(sprite, v.x - currentRadius, v.y - currentRadius, d, d);
					}

					if (v.life >= v.maxLife) {
						thermalVapors.splice(i, 1);
					}
				}
				ctx.globalAlpha = 1.0;

				thermalAnimId = requestAnimationFrame(loopThermal);
			}

			thermalAnimId = requestAnimationFrame(loopThermal);
		}

		function toggleThermalTool() {
			if (thermalToolMode === 'cryo') {
				thermalToolMode = 'heatgun';
				if (tToolText) tToolText.textContent = 'TOOL: HEAT GUN (450°C)';
				if (tToolBtn) tToolBtn.textContent = 'Switch to LN2 Cryo (-196°C)';
			} else {
				thermalToolMode = 'cryo';
				if (tToolText) tToolText.textContent = 'TOOL: LN2 CRYO-SPRAY (-196°C)';
				if (tToolBtn) tToolBtn.textContent = 'Switch to Heat Gun (450°C)';
			}
			if (isThermalSpraying) {
				audioEngine.startThermalSpray(thermalToolMode);
			}
		}

		function normalizeThermal() {
			probeTemp = 24.5;
			cpuTemp = 98.4;
			vrmTemp = 104.2;
			memTemp = 71.5;
			thermalVapors = [];
			frostCrystals = [];
			heatSpots = [];
		}

		function resetThermal() {
			if (!isThermal) return;
			isThermal = false;
			isThermalSpraying = false;
			audioEngine.stopThermalSpray();
			cancelAnimationFrame(thermalAnimId);
			if (thermalHud) {
				thermalHud.classList.add('hidden');
				thermalHud.style.display = 'none';
			}
			if (thermalScaleBar) {
				thermalScaleBar.classList.add('hidden');
				thermalScaleBar.style.display = 'none';
			}
			if (thermalSpots) {
				thermalSpots.classList.add('hidden');
				thermalSpots.style.display = 'none';
			}
			if (thermalCanvas) {
				thermalCanvas.classList.add('hidden');
				thermalCanvas.style.display = 'none';
			}
			document.body.classList.remove('thermal-active');
			window.removeEventListener('mousemove', handleThermalPointerMove);
			window.removeEventListener('mousedown', handleThermalPointerDown);
			window.removeEventListener('mouseup', handleThermalPointerUp);
			thermalVapors = [];
			frostCrystals = [];
			heatSpots = [];
			const ctx = thermalCanvas?.getContext('2d');
			if (ctx && thermalCanvas) ctx.clearRect(0, 0, thermalCanvas.width, thermalCanvas.height);
		}

		tToolBtn?.addEventListener('click', toggleThermalTool);
		thermalResetBtn?.addEventListener('click', normalizeThermal);
		thermalExitBtn?.addEventListener('click', resetThermal);

		// -------------------------------------------------------------
		// 8x8 BIT CMOS MULTIPLIER (CADENCE VIRTUOSO ARCHITECTURE)
		// -------------------------------------------------------------
		let multA = 0xAA; // 170
		let multB = 0x55; // 85

		const multABitsWrap = document.getElementById('mult-a-bits');
		const multBBitsWrap = document.getElementById('mult-b-bits');
		const multMatrixGrid = document.getElementById('mult-matrix-grid');
		const multProductBitsWrap = document.getElementById('mult-product-bits');
		const multAMeta = document.getElementById('mult-a-meta');
		const multBMeta = document.getElementById('mult-b-meta');
		const multActivePP = document.getElementById('mult-active-pp');
		const multCellInfo = document.getElementById('mult-cell-info');
		const multTpdVal = document.getElementById('mult-tpd-val');
		const multEnergyVal = document.getElementById('mult-energy-val');
		const multPDec = document.getElementById('mult-p-dec');
		const multPHex = document.getElementById('mult-p-hex');
		const multPBin = document.getElementById('mult-p-bin');
		const multCloseBtn = document.getElementById('multiplier-close-btn');
		const multBackdrop = document.getElementById('multiplier-backdrop');
		const multRandBtn = document.getElementById('mult-rand-btn');

		function renderMultiplier() {
			if (!multABitsWrap || !multBBitsWrap || !multMatrixGrid || !multProductBitsWrap) return;

			// 1. Render Input A (8 bits: A7 down to A0)
			multABitsWrap.innerHTML = '';
			for (let i = 7; i >= 0; i--) {
				const bitVal = (multA >> i) & 1;
				const btn = document.createElement('button');
				btn.type = 'button';
				btn.className = `mult-bit-btn mono ${bitVal ? 'active' : ''}`;
				btn.innerHTML = `<span class="bit-idx">A${i}</span><span class="bit-val">${bitVal}</span>`;
				btn.addEventListener('click', () => {
					multA ^= (1 << i);
					audioEngine.playBitClick();
					updateMultiplier();
				});
				multABitsWrap.appendChild(btn);
			}

			// 2. Render Input B (8 bits: B7 down to B0)
			multBBitsWrap.innerHTML = '';
			for (let i = 7; i >= 0; i--) {
				const bitVal = (multB >> i) & 1;
				const btn = document.createElement('button');
				btn.type = 'button';
				btn.className = `mult-bit-btn mono ${bitVal ? 'active' : ''}`;
				btn.innerHTML = `<span class="bit-idx">B${i}</span><span class="bit-val">${bitVal}</span>`;
				btn.addEventListener('click', () => {
					multB ^= (1 << i);
					audioEngine.playBitClick();
					updateMultiplier();
				});
				multBBitsWrap.appendChild(btn);
			}

			// 3. Render 64-Cell Partial Product Matrix (8 rows B x 8 cols A)
			multMatrixGrid.innerHTML = '';
			for (let row = 0; row < 8; row++) {
				for (let col = 7; col >= 0; col--) {
					const cell = document.createElement('div');
					cell.className = 'mult-cell mono';
					cell.dataset.row = String(row);
					cell.dataset.col = String(col);
					cell.textContent = `A${col}·B${row}`;

					cell.addEventListener('mouseenter', () => {
						const bitA = (multA >> col) & 1;
						const bitB = (multB >> row) & 1;
						const pp = bitA & bitB;
						const csaStage = Math.min(3, Math.floor((col + row) / 4) + 1);
						if (multCellInfo) {
							multCellInfo.textContent = `AND2 Cell [A${col}·B${row}] = (${bitA} · ${bitB}) = ${pp} ${pp ? '⚡ HIGH' : '○ LOW'} • Routed to CSA Stage #${csaStage} • Weight: 2^${col + row} (${1 << (col + row)})`;
						}
					});

					cell.addEventListener('mouseleave', () => {
						if (multCellInfo) {
							multCellInfo.textContent = 'Hover any cell to inspect transistor-level AND2 gate & CSA routing stage';
						}
					});

					multMatrixGrid.appendChild(cell);
				}
			}

			// 4. Render 16 Product Bits (P15 down to P0)
			multProductBitsWrap.innerHTML = '';
			for (let i = 15; i >= 0; i--) {
				const bitBox = document.createElement('div');
				bitBox.className = 'mult-p-bit mono';
				bitBox.id = `mult-p-${i}`;
				bitBox.innerHTML = `<span class="p-idx">P${i}</span><span class="p-val">0</span>`;
				multProductBitsWrap.appendChild(bitBox);
			}

			updateMultiplier();
		}

		function updateMultiplier() {
			const product = (multA * multB) & 0xFFFF;

			// Update Input A UI
			if (multAMeta) multAMeta.textContent = `Hex: 0x${multA.toString(16).toUpperCase().padStart(2, '0')} • Dec: ${multA}`;
			const aBtns = multABitsWrap?.querySelectorAll('.mult-bit-btn');
			if (aBtns) {
				for (let i = 7; i >= 0; i--) {
					const btnIdx = 7 - i;
					const bit = (multA >> i) & 1;
					const btn = aBtns[btnIdx];
					if (btn) {
						btn.classList.toggle('active', bit === 1);
						const valSpan = btn.querySelector('.bit-val');
						if (valSpan) valSpan.textContent = String(bit);
					}
				}
			}

			// Update Input B UI
			if (multBMeta) multBMeta.textContent = `Hex: 0x${multB.toString(16).toUpperCase().padStart(2, '0')} • Dec: ${multB}`;
			const bBtns = multBBitsWrap?.querySelectorAll('.mult-bit-btn');
			if (bBtns) {
				for (let i = 7; i >= 0; i--) {
					const btnIdx = 7 - i;
					const bit = (multB >> i) & 1;
					const btn = bBtns[btnIdx];
					if (btn) {
						btn.classList.toggle('active', bit === 1);
						const valSpan = btn.querySelector('.bit-val');
						if (valSpan) valSpan.textContent = String(bit);
					}
				}
			}

			// Update 64 Partial Product Matrix Cells
			let activeCount = 0;
			const cells = multMatrixGrid?.querySelectorAll('.mult-cell');
			if (cells) {
				cells.forEach((cellEl) => {
					const el = cellEl as HTMLElement;
					const row = parseInt(el.dataset.row || '0', 10);
					const col = parseInt(el.dataset.col || '0', 10);
					const bitA = (multA >> col) & 1;
					const bitB = (multB >> row) & 1;
					const isActive = (bitA & bitB) === 1;
					if (isActive) activeCount++;
					el.classList.toggle('active', isActive);
				});
			}

			if (multActivePP) multActivePP.textContent = `Active: ${activeCount} / 64`;
			if (multEnergyVal) multEnergyVal.textContent = `~${(activeCount * 6.15).toFixed(1)} fJ / op`;
			if (multTpdVal) {
				const stages = Math.min(4, Math.max(1, Math.ceil(activeCount / 16)));
				multTpdVal.textContent = `~${(1.20 + stages * 0.16).toFixed(2)} ns (${stages} CSA Stages)`;
			}

			// Update Product Display
			if (multPDec) multPDec.textContent = `P = A × B = ${product.toLocaleString()}`;
			if (multPHex) multPHex.textContent = `0x${product.toString(16).toUpperCase().padStart(4, '0')}`;
			if (multPBin) {
				const binStr = product.toString(2).padStart(16, '0');
				multPBin.textContent = `${binStr.slice(0, 4)} ${binStr.slice(4, 8)} ${binStr.slice(8, 12)} ${binStr.slice(12, 16)}₂`;
			}

			// Update 16 Product Bit LEDs
			for (let i = 15; i >= 0; i--) {
				const pBit = (product >> i) & 1;
				const box = document.getElementById(`mult-p-${i}`);
				if (box) {
					box.classList.toggle('active', pBit === 1);
					const val = box.querySelector('.p-val');
					if (val) val.textContent = String(pBit);
				}
			}
		}

		function openMultiplier() {
			closeAllActiveModes();
			if (!multiplierModal) return;
			isMultiplier = true;
			multiplierModal.style.display = 'flex';
			multiplierModal.classList.remove('hidden');
			renderMultiplier();
			audioEngine.playMultiplierChime();
			updateDrawerActiveUI();
		}

		function closeMultiplier() {
			if (!multiplierModal) return;
			isMultiplier = false;
			multiplierModal.style.display = 'none';
			multiplierModal.classList.add('hidden');
			updateDrawerActiveUI();
		}

		multCloseBtn?.addEventListener('click', closeMultiplier);
		multBackdrop?.addEventListener('click', closeMultiplier);

		document.querySelectorAll('.mult-pre-btn[data-a]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const a = parseInt((btn as HTMLElement).dataset.a || '0', 10);
				const b = parseInt((btn as HTMLElement).dataset.b || '0', 10);
				multA = a;
				multB = b;
				audioEngine.playMultiplierChime();
				updateMultiplier();
			});
		});

		multRandBtn?.addEventListener('click', () => {
			multA = Math.floor(Math.random() * 256);
			multB = Math.floor(Math.random() * 256);
			audioEngine.playMultiplierChime();
			updateMultiplier();
		});

		// -------------------------------------------------------------
		// LOGIC ANALYZER BUS SNIFFER (4-CH DIGITAL WAVEFORMS & PROTOCOL DECODER)
		// -------------------------------------------------------------
		let analyzerAnimId = 0;
		let isAnalyzerPaused = false;
		let analyzerQueue: { sck: number; mosi: number; miso: number; cs: number; label?: string }[] = [];
		let analyzerHistory: { sck: number; mosi: number; miso: number; cs: number; label?: string }[] = [];
		const MAX_ANALYZER_SAMPLES = 800;

		const analyzerRunBtn = document.getElementById('analyzer-run-btn');
		const analyzerClearBtn = document.getElementById('analyzer-clear-btn');
		const analyzerInjectBtn = document.getElementById('analyzer-inject-btn');
		const analyzerExitBtn = document.getElementById('analyzer-exit-btn');
		const analyzerStatusText = document.getElementById('analyzer-status-text');

		function pushLogicPacket(label: string, bytes: number[] = [0xAA, 0x55]) {
			if (!isAnalyzer) return;
			analyzerQueue.push({ sck: 0, mosi: 0, miso: 1, cs: 0, label });
			analyzerQueue.push({ sck: 0, mosi: 0, miso: 1, cs: 0 });

			bytes.forEach((b) => {
				for (let bit = 7; bit >= 0; bit--) {
					const mosiBit = (b >> bit) & 1;
					const misoBit = Math.random() > 0.5 ? 1 : 0;
					analyzerQueue.push({ sck: 0, mosi: mosiBit, miso: misoBit, cs: 0 });
					analyzerQueue.push({ sck: 1, mosi: mosiBit, miso: misoBit, cs: 0 });
				}
				analyzerQueue.push({ sck: 0, mosi: 0, miso: 1, cs: 0 });
			});

			analyzerQueue.push({ sck: 0, mosi: 0, miso: 1, cs: 1 });
			analyzerQueue.push({ sck: 0, mosi: 0, miso: 1, cs: 1 });
		}

		function drawLogicAnalyzer() {
			if (!isAnalyzer || !analyzerCanvas) return;
			const ctx = analyzerCanvas.getContext('2d');
			if (!ctx) return;

			const dpr = window.devicePixelRatio || 1;
			const w = window.innerWidth;
			const h = 150;
			if (analyzerCanvas.width !== w * dpr || analyzerCanvas.height !== h * dpr) {
				analyzerCanvas.width = w * dpr;
				analyzerCanvas.height = h * dpr;
				analyzerCanvas.style.width = `${w}px`;
				analyzerCanvas.style.height = `${h}px`;
			}

			ctx.save();
			ctx.scale(dpr, dpr);

			ctx.fillStyle = '#06080c';
			ctx.fillRect(0, 0, w, h);

			ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
			ctx.lineWidth = 1;
			const gridStep = 40;
			for (let x = 0; x < w; x += gridStep) {
				ctx.beginPath();
				ctx.moveTo(x, 0);
				ctx.lineTo(x, h);
				ctx.stroke();
			}

			if (!isAnalyzerPaused) {
				if (analyzerQueue.length > 0) {
					const sample = analyzerQueue.shift()!;
					analyzerHistory.push(sample);
				} else {
					const idleClock = Math.random() < 0.08 ? (Math.random() < 0.5 ? 1 : 0) : 0;
					analyzerHistory.push({ sck: idleClock, mosi: 0, miso: 1, cs: 1 });
				}
				if (analyzerHistory.length > MAX_ANALYZER_SAMPLES) {
					analyzerHistory.shift();
				}
			}

			const channels = [
				{ name: 'CH0: SCK', color: '#22c55e', key: 'sck' as const, yLow: 35, yHigh: 18 },
				{ name: 'CH1: MOSI', color: '#38bdf8', key: 'mosi' as const, yLow: 65, yHigh: 48 },
				{ name: 'CH2: MISO', color: '#f59e0b', key: 'miso' as const, yLow: 95, yHigh: 78 },
				{ name: 'CH3: CS#', color: '#ec4899', key: 'cs' as const, yLow: 125, yHigh: 108 },
			];

			const leftOffset = 90;
			const sampleWidth = Math.max(2, (w - leftOffset) / MAX_ANALYZER_SAMPLES);

			channels.forEach((ch) => {
				ctx.fillStyle = ch.color;
				ctx.font = '10px ui-monospace, SFMono-Regular, Menlo, monospace';
				ctx.fillText(ch.name, 12, ch.yLow - 4);

				ctx.strokeStyle = 'rgba(255, 255, 255, 0.08)';
				ctx.beginPath();
				ctx.moveTo(leftOffset, ch.yLow);
				ctx.lineTo(w, ch.yLow);
				ctx.stroke();

				ctx.strokeStyle = ch.color;
				ctx.lineWidth = 1.6;
				ctx.shadowColor = ch.color;
				ctx.shadowBlur = 4;
				ctx.beginPath();

				let prevVal = -1;
				for (let i = 0; i < analyzerHistory.length; i++) {
					const sample = analyzerHistory[i];
					const val = sample[ch.key];
					const x = leftOffset + i * sampleWidth;
					const y = val === 1 ? ch.yHigh : ch.yLow;

					if (i === 0) {
						ctx.moveTo(x, y);
					} else {
						if (val !== prevVal) {
							ctx.lineTo(x, y);
						} else {
							ctx.lineTo(x, y);
						}
					}
					prevVal = val;
				}
				ctx.stroke();
				ctx.shadowBlur = 0;
			});

			ctx.font = '9px ui-monospace, SFMono-Regular, Menlo, monospace';
			for (let i = 0; i < analyzerHistory.length; i++) {
				const sample = analyzerHistory[i];
				if (sample.label) {
					const x = leftOffset + i * sampleWidth;
					ctx.fillStyle = 'rgba(56, 189, 248, 0.2)';
					ctx.strokeStyle = '#38bdf8';
					ctx.lineWidth = 1;
					const textW = ctx.measureText(sample.label).width;
					ctx.fillRect(x, 2, textW + 10, 14);
					ctx.strokeRect(x, 2, textW + 10, 14);
					ctx.fillStyle = '#ffffff';
					ctx.fillText(sample.label, x + 5, 12);
				}
			}

			ctx.restore();
			analyzerAnimId = requestAnimationFrame(drawLogicAnalyzer);
		}

		function startAnalyzer() {
			closeAllActiveModes();
			if (!analyzerHud || !analyzerCanvas) return;
			isAnalyzer = true;
			isAnalyzerPaused = false;
			analyzerHud.style.display = 'flex';
			analyzerHud.classList.remove('hidden');
			analyzerCanvas.style.display = 'block';
			analyzerCanvas.classList.remove('hidden');

			if (analyzerRunBtn) {
				analyzerRunBtn.textContent = 'Pause';
				analyzerRunBtn.classList.add('active');
			}

			pushLogicPacket('SPI: INIT [0x06 WREN]', [0x06]);
			pushLogicPacket('UART: BROB_BUS 24MHz', [0x42, 0x52, 0x4F, 0x42]);

			cancelAnimationFrame(analyzerAnimId);
			drawLogicAnalyzer();
			audioEngine.playLogicPulse();
			updateDrawerActiveUI();
		}

		function stopAnalyzer() {
			if (!analyzerHud || !analyzerCanvas) return;
			isAnalyzer = false;
			cancelAnimationFrame(analyzerAnimId);
			analyzerHud.style.display = 'none';
			analyzerHud.classList.add('hidden');
			analyzerCanvas.style.display = 'none';
			analyzerCanvas.classList.add('hidden');
			updateDrawerActiveUI();
		}

		analyzerRunBtn?.addEventListener('click', () => {
			isAnalyzerPaused = !isAnalyzerPaused;
			if (analyzerRunBtn) {
				analyzerRunBtn.textContent = isAnalyzerPaused ? 'Resume' : 'Pause';
				analyzerRunBtn.classList.toggle('active', !isAnalyzerPaused);
			}
			if (analyzerStatusText) {
				analyzerStatusText.textContent = isAnalyzerPaused ? 'PAUSED' : 'CAPTURING • 24.0 MHz SAMPLE';
			}
		});

		analyzerClearBtn?.addEventListener('click', () => {
			analyzerHistory = [];
			analyzerQueue = [];
			audioEngine.playLogicPulse();
		});

		analyzerInjectBtn?.addEventListener('click', () => {
			pushLogicPacket('SPI: 0x9F (JEDEC ID)', [0x9F, 0xEF, 0x40, 0x18]);
			audioEngine.playLogicPulse();
		});

		analyzerExitBtn?.addEventListener('click', stopAnalyzer);

		document.addEventListener('click', (e) => {
			if (!isAnalyzer) return;
			const target = e.target as HTMLElement;
			if (target.closest('#analyzer-hud, .ee-hud-btn')) return;
			const tag = target.tagName.toLowerCase();
			const idOrCls = target.id ? `#${target.id}` : target.className && typeof target.className === 'string' ? `.${target.className.split(' ')[0]}` : '';
			pushLogicPacket(`UART: CLICK <${tag}${idOrCls}>`, [0x43, 0x4C, 0x4B]);
		}, { passive: true });

		// -------------------------------------------------------------
		// HOT AIR SOLDER REFLOW (SURFACE TENSION & THERMAL REWORK)
		// -------------------------------------------------------------
		let reflowAnimId = 0;
		let reflowPointerX = -100;
		let reflowPointerY = -100;
		let reflowTemp = 350;
		let reflowCards: { el: HTMLElement; origTransform: string; moltenFactor: number; angle: number; dx: number; dy: number }[] = [];

		const reflowTempText = document.getElementById('reflow-temp-text');
		const reflowBlastBtn = document.getElementById('reflow-blast-btn');
		const reflowQuenchBtn = document.getElementById('reflow-quench-btn');
		const reflowExitBtn = document.getElementById('reflow-exit-btn');

		function updateReflowCardsList() {
			reflowCards = [];
			const els = document.querySelectorAll<HTMLElement>('.card, .lab-box, .stat-card, .test-card, .footer-meta, .hero-bio');
			els.forEach((el) => {
				reflowCards.push({
					el,
					origTransform: el.style.transform || '',
					moltenFactor: 0,
					angle: 0,
					dx: 0,
					dy: 0,
				});
			});
		}

		function drawReflowCanvas() {
			if (!isReflow || !reflowCanvas) return;
			const ctx = reflowCanvas.getContext('2d');
			if (!ctx) return;

			const dpr = window.devicePixelRatio || 1;
			const w = window.innerWidth;
			const h = window.innerHeight;
			if (reflowCanvas.width !== w * dpr || reflowCanvas.height !== h * dpr) {
				reflowCanvas.width = w * dpr;
				reflowCanvas.height = h * dpr;
				reflowCanvas.style.width = `${w}px`;
				reflowCanvas.style.height = `${h}px`;
			}

			ctx.save();
			ctx.scale(dpr, dpr);
			ctx.clearRect(0, 0, w, h);

			if (reflowPointerX > 0 && reflowPointerY > 0) {
				const glowGrad = ctx.createRadialGradient(reflowPointerX, reflowPointerY, 5, reflowPointerX, reflowPointerY, 65);
				glowGrad.addColorStop(0, 'rgba(251, 146, 60, 0.45)');
				glowGrad.addColorStop(0.5, 'rgba(239, 68, 68, 0.20)');
				glowGrad.addColorStop(1, 'rgba(239, 68, 68, 0)');
				ctx.fillStyle = glowGrad;
				ctx.beginPath();
				ctx.arc(reflowPointerX, reflowPointerY, 65, 0, Math.PI * 2);
				ctx.fill();

				ctx.strokeStyle = '#f97316';
				ctx.lineWidth = 2;
				ctx.beginPath();
				ctx.arc(reflowPointerX, reflowPointerY, 18, 0, Math.PI * 2);
				ctx.stroke();

				ctx.strokeStyle = 'rgba(253, 186, 116, 0.35)';
				ctx.lineWidth = 1;
				const t = performance.now() * 0.005;
				for (let i = 0; i < 3; i++) {
					const r = 24 + ((t * 15 + i * 12) % 36);
					ctx.beginPath();
					ctx.arc(reflowPointerX, reflowPointerY, r, 0, Math.PI * 2);
					ctx.stroke();
				}
			}

			reflowCards.forEach((rc) => {
				const rect = rc.el.getBoundingClientRect();
				const centerX = rect.left + rect.width / 2;
				const centerY = rect.top + rect.height / 2;
				const dist = Math.hypot(reflowPointerX - centerX, reflowPointerY - centerY);

				if (dist < 130 && reflowPointerX > 0) {
					rc.moltenFactor = Math.min(1, rc.moltenFactor + 0.04);
					rc.angle = Math.sin(performance.now() * 0.003) * 1.8 * rc.moltenFactor;
					rc.dx = Math.cos(performance.now() * 0.002) * 2.5 * rc.moltenFactor;
					rc.dy = Math.sin(performance.now() * 0.0025) * 2.5 * rc.moltenFactor;
					rc.el.style.transform = `translate3d(${rc.dx}px, ${rc.dy}px, 0) rotate(${rc.angle}deg)`;
				} else {
					rc.moltenFactor = Math.max(0, rc.moltenFactor - 0.015);
					if (rc.moltenFactor <= 0) {
						rc.el.style.transform = rc.origTransform;
					}
				}

				if (rc.moltenFactor > 0.05) {
					const corners = [
						{ x: rect.left, y: rect.top },
						{ x: rect.right, y: rect.top },
						{ x: rect.left, y: rect.bottom },
						{ x: rect.right, y: rect.bottom }
					];

					corners.forEach((c) => {
						const radius = 4 + rc.moltenFactor * 3.5;
						const grad = ctx.createRadialGradient(c.x - 1, c.y - 1, 1, c.x, c.y, radius);
						grad.addColorStop(0, '#ffffff');
						grad.addColorStop(0.4, '#e2e8f0');
						grad.addColorStop(0.8, '#94a3b8');
						grad.addColorStop(1, '#475569');
						ctx.fillStyle = grad;
						ctx.beginPath();
						ctx.arc(c.x, c.y, radius, 0, Math.PI * 2);
						ctx.fill();

						ctx.strokeStyle = 'rgba(234, 179, 8, 0.4)';
						ctx.lineWidth = 1.2;
						ctx.stroke();
					});
				}
			});

			ctx.restore();
			reflowAnimId = requestAnimationFrame(drawReflowCanvas);
		}

		function handleReflowPointerMove(e: MouseEvent) {
			reflowPointerX = e.clientX;
			reflowPointerY = e.clientY;
		}

		function startReflow() {
			closeAllActiveModes();
			if (!reflowHud || !reflowCanvas) return;
			isReflow = true;
			reflowTemp = 350;
			if (reflowTempText) reflowTempText.textContent = `NOZZLE: ${reflowTemp}°C`;
			reflowHud.style.display = 'flex';
			reflowHud.classList.remove('hidden');
			reflowCanvas.style.display = 'block';
			reflowCanvas.classList.remove('hidden');

			updateReflowCardsList();
			window.addEventListener('mousemove', handleReflowPointerMove, { passive: true });
			cancelAnimationFrame(reflowAnimId);
			drawReflowCanvas();
			audioEngine.playReflowBlast();
			updateDrawerActiveUI();
		}

		function resetReflow() {
			if (!reflowHud || !reflowCanvas) return;
			isReflow = false;
			window.removeEventListener('mousemove', handleReflowPointerMove);
			cancelAnimationFrame(reflowAnimId);

			reflowCards.forEach((rc) => {
				rc.el.style.transform = rc.origTransform;
			});

			reflowHud.style.display = 'none';
			reflowHud.classList.add('hidden');
			reflowCanvas.style.display = 'none';
			reflowCanvas.classList.add('hidden');
			updateDrawerActiveUI();
		}

		reflowBlastBtn?.addEventListener('click', () => {
			reflowTemp = 420;
			if (reflowTempText) reflowTempText.textContent = `NOZZLE: ${reflowTemp}°C (OVERDRIVE)`;
			audioEngine.playReflowBlast();
			setTimeout(() => {
				if (reflowTempText) reflowTempText.textContent = `NOZZLE: 350°C`;
			}, 2500);
		});

		reflowQuenchBtn?.addEventListener('click', () => {
			audioEngine.playReflowQuench();
			reflowCards.forEach((rc) => {
				rc.moltenFactor = 0;
				rc.el.style.transition = 'transform 0.3s cubic-bezier(0.16, 1, 0.3, 1)';
				rc.el.style.transform = rc.origTransform;
				setTimeout(() => {
					rc.el.style.transition = '';
				}, 350);
			});
		});

		reflowExitBtn?.addEventListener('click', resetReflow);

		// -------------------------------------------------------------
		// 8-BIT BUS SEQUENCER (HARDWARE DIAGNOSTIC DRUM MACHINE)
		// -------------------------------------------------------------
		let isSeqPlaying = false;
		let seqBpm = 120;
		let seqStep = 0;
		let seqTimer: number | null = null;

		const seqTracks = [
			{ id: 'relay', name: 'RELAY K1', desc: 'Latching Relay Snap', color: '#22c55e' },
			{ id: 'bios', name: 'BIOS POST', desc: 'PC Speaker 1kHz Beep', color: '#38bdf8' },
			{ id: 'seek', name: 'SEEK FDD', desc: 'Stepper Head Clatter', color: '#f59e0b' },
			{ id: 'printer', name: 'PRINT DMX', desc: '9-Pin Impact Solenoid', color: '#a855f7' },
			{ id: 'spark', name: 'SPARK HV', desc: '4.5kV Arc Discharge', color: '#ec4899' },
			{ id: 'modelm', name: 'MODEL M', desc: 'Buckling Spring Thock', color: '#e2e8f0' },
		];

		let seqGrid: boolean[][] = seqTracks.map(() => new Array(16).fill(false));

		const seqPlayBtn = document.getElementById('seq-play-btn');
		const seqPlayText = document.getElementById('seq-play-text');
		const seqBpmSlider = document.getElementById('seq-bpm-slider') as HTMLInputElement | null;
		const seqBpmVal = document.getElementById('seq-bpm-val');
		const seqMatrixWrap = document.getElementById('seq-matrix-wrap');
		const seqCloseBtn = document.getElementById('sequencer-close-btn');
		const seqBackdrop = document.getElementById('sequencer-backdrop');

		function loadSeqPreset(preset: 'heartbeat' | 'atescan' | 'random' | 'clear') {
			seqGrid = seqTracks.map(() => new Array(16).fill(false));
			if (preset === 'heartbeat') {
				seqGrid[0][0] = true; seqGrid[0][8] = true;
				seqGrid[1][4] = true; seqGrid[1][12] = true;
				seqGrid[2][2] = true; seqGrid[2][6] = true; seqGrid[2][10] = true; seqGrid[2][14] = true;
				seqGrid[3][14] = true;
				seqGrid[4][15] = true;
				seqGrid[5][0] = true; seqGrid[5][3] = true; seqGrid[5][7] = true; seqGrid[5][8] = true; seqGrid[5][11] = true;
			} else if (preset === 'atescan') {
				for (let s = 0; s < 16; s += 2) seqGrid[2][s] = true;
				seqGrid[0][0] = true; seqGrid[0][8] = true;
				seqGrid[1][4] = true; seqGrid[1][12] = true;
				seqGrid[4][14] = true;
			} else if (preset === 'random') {
				for (let t = 0; t < seqTracks.length; t++) {
					for (let s = 0; s < 16; s++) {
						seqGrid[t][s] = Math.random() < 0.22;
					}
				}
			}
			renderSequencerGrid();
		}

		function renderSequencerGrid() {
			if (!seqMatrixWrap) return;
			seqMatrixWrap.innerHTML = '';

			seqTracks.forEach((track, tIdx) => {
				const row = document.createElement('div');
				row.className = 'seq-track-row';

				const header = document.createElement('div');
				header.className = 'seq-track-header mono';
				header.id = `seq-track-hdr-${tIdx}`;
				header.innerHTML = `
					<span class="track-dot" style="background: ${track.color};"></span>
					<strong class="track-name">${track.name}</strong>
					<span class="track-desc">${track.desc}</span>
				`;
				header.addEventListener('click', () => {
					audioEngine.playSequencerSound(track.id);
				});
				row.appendChild(header);

				const stepsContainer = document.createElement('div');
				stepsContainer.className = 'seq-steps-container';

				for (let sIdx = 0; sIdx < 16; sIdx++) {
					const btn = document.createElement('button');
					btn.type = 'button';
					btn.className = `seq-step-btn mono ${seqGrid[tIdx][sIdx] ? 'active' : ''} ${sIdx % 4 === 0 ? 'beat-marker' : ''}`;
					btn.id = `seq-step-${tIdx}-${sIdx}`;
					btn.setAttribute('aria-label', `${track.name} Step ${sIdx + 1}`);

					btn.addEventListener('click', () => {
						seqGrid[tIdx][sIdx] = !seqGrid[tIdx][sIdx];
						btn.classList.toggle('active', seqGrid[tIdx][sIdx]);
						if (seqGrid[tIdx][sIdx]) {
							audioEngine.playSequencerSound(track.id);
						}
					});

					stepsContainer.appendChild(btn);
				}

				row.appendChild(stepsContainer);
				seqMatrixWrap.appendChild(row);
			});
		}

		function stepSequencer() {
			document.querySelectorAll(`.seq-step-cursor`).forEach((el) => el.classList.remove('seq-step-cursor'));

			seqTracks.forEach((_, tIdx) => {
				const cell = document.getElementById(`seq-step-${tIdx}-${seqStep}`);
				if (cell) cell.classList.add('seq-step-cursor');

				if (seqGrid[tIdx][seqStep]) {
					audioEngine.playSequencerSound(seqTracks[tIdx].id);
					const hdr = document.getElementById(`seq-track-hdr-${tIdx}`);
					if (hdr) {
						hdr.classList.add('flash');
						setTimeout(() => hdr.classList.remove('flash'), 120);
					}
				}
			});

			seqStep = (seqStep + 1) % 16;
		}

		function startSequencerPlayback() {
			if (isSeqPlaying) return;
			isSeqPlaying = true;
			if (seqPlayText) seqPlayText.textContent = 'Pause';
			seqPlayBtn?.classList.add('active');

			const interval = (60 / seqBpm / 4) * 1000;
			stepSequencer();
			seqTimer = window.setInterval(stepSequencer, interval);
		}

		function stopSequencerPlayback() {
			isSeqPlaying = false;
			if (seqPlayText) seqPlayText.textContent = 'Play';
			seqPlayBtn?.classList.remove('active');
			if (seqTimer !== null) {
				clearInterval(seqTimer);
				seqTimer = null;
			}
			document.querySelectorAll(`.seq-step-cursor`).forEach((el) => el.classList.remove('seq-step-cursor'));
		}

		function openSequencer() {
			closeAllActiveModes();
			if (!sequencerModal) return;
			isSequencer = true;
			sequencerModal.style.display = 'flex';
			sequencerModal.classList.remove('hidden');
			if (seqGrid.every((row) => row.every((c) => !c))) {
				loadSeqPreset('heartbeat');
			} else {
				renderSequencerGrid();
			}
			updateDrawerActiveUI();
		}

		function closeSequencer() {
			if (!sequencerModal) return;
			stopSequencerPlayback();
			isSequencer = false;
			sequencerModal.style.display = 'none';
			sequencerModal.classList.add('hidden');
			updateDrawerActiveUI();
		}

		seqPlayBtn?.addEventListener('click', () => {
			if (isSeqPlaying) {
				stopSequencerPlayback();
			} else {
				startSequencerPlayback();
			}
		});

		seqBpmSlider?.addEventListener('input', (e) => {
			seqBpm = parseInt((e.target as HTMLInputElement).value, 10);
			if (seqBpmVal) seqBpmVal.textContent = `${seqBpm} BPM`;
			if (isSeqPlaying) {
				stopSequencerPlayback();
				startSequencerPlayback();
			}
		});

		document.querySelectorAll('.seq-pre-btn[data-preset]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const p = (btn as HTMLElement).dataset.preset as any;
				loadSeqPreset(p);
			});
		});

		seqCloseBtn?.addEventListener('click', closeSequencer);
		seqBackdrop?.addEventListener('click', closeSequencer);

		// -------------------------------------------------------------
		// WAFER DIE SORT BREAKOUT ARCADE (ATE PROBE CARD MINI-GAME)
		// -------------------------------------------------------------
		let breakoutAnimId = 0;
		let boScore = 0;
		let boLives = 3;
		let boProbed = 0;
		let boRunning = false;

		interface BreakoutDie {
			x: number;
			y: number;
			w: number;
			h: number;
			bin: 'bin1' | 'bin2' | 'leak' | 'gold';
			alive: boolean;
			label: string;
		}

		let boDies: BreakoutDie[] = [];
		let boPaddle = { x: 260, y: 345, w: 84, h: 12 };
		let boBall = { x: 300, y: 320, vx: 3.5, vy: -3.5, r: 5 };
		let boParticles: { x: number; y: number; vx: number; vy: number; color: string; life: number }[] = [];

		const boScoreEl = document.getElementById('bo-score');
		const boYieldEl = document.getElementById('bo-yield');
		const boLivesEl = document.getElementById('bo-lives');
		const boProbedEl = document.getElementById('bo-probed');
		const breakoutCloseBtn = document.getElementById('breakout-close-btn');
		const breakoutBackdrop = document.getElementById('breakout-backdrop');
		const breakoutRestartBtn = document.getElementById('breakout-restart-btn');

		function initBreakoutLevel() {
			boDies = [];
			boParticles = [];
			boProbed = 0;
			boScore = 0;
			boLives = 3;
			boRunning = true;

			const rows = 6;
			const cols = 8;
			const dieW = 56;
			const dieH = 22;
			const startX = 64;
			const startY = 40;
			const centerX = startX + (cols * dieW) / 2;
			const centerY = startY + (rows * dieH) / 2;
			const waferRadius = 160;

			const labels = ['CORE0', 'CORE1', 'L3_64M', 'PCIE5', 'DDR_PHY', 'ATE_BIST', 'VCC_VRM', 'SRAM'];

			for (let r = 0; r < rows; r++) {
				for (let c = 0; c < cols; c++) {
					const dx = startX + c * (dieW + 8);
					const dy = startY + r * (dieH + 8);
					const dist = Math.hypot(dx + dieW / 2 - centerX, dy + dieH / 2 - centerY);
					if (dist < waferRadius) {
						let binType: 'bin1' | 'bin2' | 'leak' | 'gold' = 'bin1';
						const rand = Math.random();
						if (rand < 0.08) binType = 'gold';
						else if (rand < 0.28) binType = 'bin2';
						else if (rand < 0.40) binType = 'leak';

						boDies.push({
							x: dx,
							y: dy,
							w: dieW,
							h: dieH,
							bin: binType,
							alive: true,
							label: labels[(r * cols + c) % labels.length]
						});
					}
				}
			}

			resetBreakoutBall();
			updateBreakoutHUD();
		}

		function resetBreakoutBall() {
			boPaddle.x = 300 - boPaddle.w / 2;
			boBall.x = 300;
			boBall.y = 330;
			boBall.vx = (Math.random() > 0.5 ? 3.5 : -3.5);
			boBall.vy = -3.8;
		}

		function updateBreakoutHUD() {
			if (boScoreEl) boScoreEl.textContent = boScore.toLocaleString();
			if (boProbedEl) boProbedEl.textContent = `${boProbed} / ${boDies.length}`;
			if (boLivesEl) boLivesEl.textContent = '❤️'.repeat(Math.max(0, boLives));
			if (boYieldEl) {
				const bin1Count = boDies.filter((d) => !d.alive && (d.bin === 'bin1' || d.bin === 'gold')).length;
				const yieldPct = boProbed > 0 ? ((bin1Count / boProbed) * 100).toFixed(1) : '100.0';
				boYieldEl.textContent = `${yieldPct}%`;
			}
		}

		function runBreakoutGame() {
			if (!isBreakout || !breakoutCanvas) return;
			const ctx = breakoutCanvas.getContext('2d');
			if (!ctx) return;

			ctx.clearRect(0, 0, 600, 380);

			ctx.fillStyle = '#080b10';
			ctx.fillRect(0, 0, 600, 380);

			ctx.strokeStyle = 'rgba(255, 255, 255, 0.08)';
			ctx.lineWidth = 2;
			ctx.beginPath();
			ctx.arc(300, 115, 165, 0, Math.PI * 2);
			ctx.stroke();

			if (boRunning) {
				boBall.x += boBall.vx;
				boBall.y += boBall.vy;

				if (boBall.x - boBall.r < 0) {
					boBall.x = boBall.r;
					boBall.vx = -boBall.vx;
					audioEngine.playBreakoutPaddle();
				} else if (boBall.x + boBall.r > 600) {
					boBall.x = 600 - boBall.r;
					boBall.vx = -boBall.vx;
					audioEngine.playBreakoutPaddle();
				}
				if (boBall.y - boBall.r < 0) {
					boBall.y = boBall.r;
					boBall.vy = -boBall.vy;
					audioEngine.playBreakoutPaddle();
				}

				if (
					boBall.y + boBall.r >= boPaddle.y &&
					boBall.y - boBall.r <= boPaddle.y + boPaddle.h &&
					boBall.x >= boPaddle.x &&
					boBall.x <= boPaddle.x + boPaddle.w
				) {
					boBall.vy = -Math.abs(boBall.vy);
					const hitOffset = (boBall.x - (boPaddle.x + boPaddle.w / 2)) / (boPaddle.w / 2);
					boBall.vx = hitOffset * 4.5;
					audioEngine.playBreakoutPaddle();
				}

				boDies.forEach((die) => {
					if (!die.alive) return;
					if (
						boBall.x + boBall.r > die.x &&
						boBall.x - boBall.r < die.x + die.w &&
						boBall.y + boBall.r > die.y &&
						boBall.y - boBall.r < die.y + die.h
					) {
						die.alive = false;
						boBall.vy = -boBall.vy;
						boProbed++;

						let pts = 50;
						let pColor = '#38bdf8';
						if (die.bin === 'bin1') { pts = 100; pColor = '#22c55e'; }
						else if (die.bin === 'gold') { pts = 250; pColor = '#fbbf24'; }
						else if (die.bin === 'leak') { pts = 25; pColor = '#ef4444'; }

						boScore += pts;
						audioEngine.playBreakoutHit(die.bin === 'gold');

						for (let i = 0; i < 6; i++) {
							boParticles.push({
								x: die.x + die.w / 2,
								y: die.y + die.h / 2,
								vx: (Math.random() - 0.5) * 4,
								vy: (Math.random() - 0.5) * 4,
								color: pColor,
								life: 20
							});
						}

						updateBreakoutHUD();

						if (boDies.every((d) => !d.alive)) {
							boRunning = false;
							audioEngine.playBreakoutOver(true);
						}
					}
				});

				if (boBall.y > 380) {
					boLives--;
					updateBreakoutHUD();
					if (boLives > 0) {
						resetBreakoutBall();
						audioEngine.playBreakoutOver(false);
					} else {
						boRunning = false;
						audioEngine.playBreakoutOver(false);
					}
				}
			}

			boDies.forEach((die) => {
				if (!die.alive) return;
				let fill = '#1e293b';
				let stroke = '#334155';
				if (die.bin === 'bin1') { fill = '#064e3b'; stroke = '#10b981'; }
				else if (die.bin === 'bin2') { fill = '#0c4a6e'; stroke = '#0284c7'; }
				else if (die.bin === 'gold') { fill = '#78350f'; stroke = '#f59e0b'; }
				else if (die.bin === 'leak') { fill = '#450a0a'; stroke = '#dc2626'; }

				ctx.fillStyle = fill;
				ctx.fillRect(die.x, die.y, die.w, die.h);
				ctx.strokeStyle = stroke;
				ctx.lineWidth = 1;
				ctx.strokeRect(die.x, die.y, die.w, die.h);

				ctx.fillStyle = '#ffffff';
				ctx.font = '8px ui-monospace, SFMono-Regular, Menlo, monospace';
				ctx.textAlign = 'center';
				ctx.fillText(die.label, die.x + die.w / 2, die.y + 14);
			});
			ctx.textAlign = 'left';

			for (let i = boParticles.length - 1; i >= 0; i--) {
				const p = boParticles[i];
				p.x += p.vx;
				p.y += p.vy;
				p.life--;
				ctx.fillStyle = p.color;
				ctx.fillRect(p.x, p.y, 2.5, 2.5);
				if (p.life <= 0) boParticles.splice(i, 1);
			}

			ctx.fillStyle = '#1e293b';
			ctx.fillRect(boPaddle.x, boPaddle.y, boPaddle.w, boPaddle.h);
			ctx.strokeStyle = '#38bdf8';
			ctx.lineWidth = 2;
			ctx.strokeRect(boPaddle.x, boPaddle.y, boPaddle.w, boPaddle.h);

			ctx.fillStyle = '#f59e0b';
			for (let px = boPaddle.x + 8; px < boPaddle.x + boPaddle.w; px += 10) {
				ctx.fillRect(px, boPaddle.y - 3, 3, 3);
			}

			ctx.fillStyle = '#f59e0b';
			ctx.shadowColor = '#f59e0b';
			ctx.shadowBlur = 8;
			ctx.beginPath();
			ctx.arc(boBall.x, boBall.y, boBall.r, 0, Math.PI * 2);
			ctx.fill();
			ctx.shadowBlur = 0;

			if (!boRunning) {
				ctx.fillStyle = 'rgba(0, 0, 0, 0.75)';
				ctx.fillRect(0, 0, 600, 380);

				ctx.fillStyle = '#ffffff';
				ctx.font = 'bold 20px ui-monospace, SFMono-Regular, Menlo, monospace';
				ctx.textAlign = 'center';
				if (boLives > 0) {
					ctx.fillText('🏆 WAFER PROBE COMPLETE! YIELD VERIFIED', 300, 180);
				} else {
					ctx.fillText('❌ TEST TERMINATED • WAFER DEFECT LEVEL HIGH', 300, 180);
				}
				ctx.font = '12px ui-monospace, SFMono-Regular, Menlo, monospace';
				ctx.fillStyle = 'rgba(255, 255, 255, 0.7)';
				ctx.fillText('Click Restart or press Esc to exit', 300, 210);
				ctx.textAlign = 'left';
			}

			breakoutAnimId = requestAnimationFrame(runBreakoutGame);
		}

		function handleBreakoutMouseMove(e: MouseEvent) {
			if (!breakoutCanvas) return;
			const rect = breakoutCanvas.getBoundingClientRect();
			const mouseX = ((e.clientX - rect.left) / rect.width) * 600;
			boPaddle.x = Math.max(0, Math.min(600 - boPaddle.w, mouseX - boPaddle.w / 2));
		}

		function openBreakout() {
			closeAllActiveModes();
			if (!breakoutModal || !breakoutCanvas) return;
			isBreakout = true;
			breakoutModal.style.display = 'flex';
			breakoutModal.classList.remove('hidden');

			breakoutCanvas.addEventListener('mousemove', handleBreakoutMouseMove);
			initBreakoutLevel();
			cancelAnimationFrame(breakoutAnimId);
			runBreakoutGame();
			updateDrawerActiveUI();
		}

		function closeBreakout() {
			if (!breakoutModal || !breakoutCanvas) return;
			isBreakout = false;
			boRunning = false;
			cancelAnimationFrame(breakoutAnimId);
			breakoutCanvas.removeEventListener('mousemove', handleBreakoutMouseMove);
			breakoutModal.style.display = 'none';
			breakoutModal.classList.add('hidden');
			updateDrawerActiveUI();
		}

		breakoutCloseBtn?.addEventListener('click', closeBreakout);
		breakoutBackdrop?.addEventListener('click', closeBreakout);
		breakoutRestartBtn?.addEventListener('click', initBreakoutLevel);

		// Global API Exports
		(window as any).__toggleZeroG = () => (isZeroG ? resetZeroG() : startZeroG());
		(window as any).__toggleTilt = (force?: boolean) => toggleTilt(force);
		(window as any).__toggleDegauss = () => (isDegauss ? resetDegauss() : startDegauss());
		(window as any).__toggleSphere = () => (isSphere ? resetSphere() : startSphere());
		(window as any).__toggleQuantum = () => (isQuantum ? resetQuantum() : startQuantum());
		(window as any).__toggleThermal = () => (isThermal ? resetThermal() : startThermal());
		(window as any).__toggleMultiplier = () => (multiplierModal?.classList.contains('hidden') ? openMultiplier() : closeMultiplier());
		(window as any).__openMultiplier = openMultiplier;
		(window as any).__closeMultiplier = closeMultiplier;
		(window as any).__toggleAnalyzer = () => (isAnalyzer ? stopAnalyzer() : startAnalyzer());
		(window as any).__toggleReflow = () => (isReflow ? resetReflow() : startReflow());
		(window as any).__toggleSequencer = () => (sequencerModal?.classList.contains('hidden') ? openSequencer() : closeSequencer());
		(window as any).__openSequencer = openSequencer;
		(window as any).__closeSequencer = closeSequencer;
		(window as any).__toggleBreakout = () => (breakoutModal?.classList.contains('hidden') ? openBreakout() : closeBreakout());
		(window as any).__openBreakout = openBreakout;
		(window as any).__closeBreakout = closeBreakout;

		(window as any).__toggleLabExtras = () => {
			if (!extrasModal) return;
			const isHidden = extrasModal.classList.contains('hidden');
			if (isHidden) {
				updateDrawerActiveUI();
				extrasModal.classList.remove('hidden');
				extrasModal.style.display = 'block';
			} else {
				extrasModal.classList.add('hidden');
				extrasModal.style.display = 'none';
			}
		};

		function updateDrawerActiveUI() {
			const sphereBtn = document.getElementById('trigger-sphere-btn');
			const tiltBtn = document.getElementById('trigger-tilt-btn');
			const sequencerBtn = document.getElementById('trigger-sequencer-btn');
			const multiplierBtn = document.getElementById('trigger-multiplier-btn');
			const degaussBtn = document.getElementById('trigger-degauss-btn');
			const reflowBtn = document.getElementById('trigger-reflow-btn');
			const analyzerBtn = document.getElementById('trigger-analyzer-btn');
			const quantumBtn = document.getElementById('trigger-quantum-btn');
			const thermalBtn = document.getElementById('trigger-thermal-btn');
			const breakoutBtn = document.getElementById('trigger-breakout-btn');
			const waferBtn = document.getElementById('trigger-wafer-btn');
			const zerogBtn = document.getElementById('trigger-zerog-btn');
			const waferModal = document.getElementById('wafer-modal');

			sphereBtn?.classList.toggle('active', isSphere);
			tiltBtn?.classList.toggle('active', isTilt);
			sequencerBtn?.classList.toggle('active', isSequencer);
			multiplierBtn?.classList.toggle('active', isMultiplier);
			degaussBtn?.classList.toggle('active', isDegauss);
			reflowBtn?.classList.toggle('active', isReflow);
			analyzerBtn?.classList.toggle('active', isAnalyzer);
			quantumBtn?.classList.toggle('active', isQuantum);
			thermalBtn?.classList.toggle('active', isThermal);
			breakoutBtn?.classList.toggle('active', isBreakout);
			zerogBtn?.classList.toggle('active', isZeroG);
			waferBtn?.classList.toggle('active', !!(waferModal && !waferModal.classList.contains('hidden')));
		}

		(window as any).__updateDrawerActiveUI = updateDrawerActiveUI;

		const kbLabEl = document.getElementById('keyboard-lab');
		function isNearKeyboardLab(): boolean {
			if (!kbLabEl) return false;
			const rect = kbLabEl.getBoundingClientRect();
			return rect.bottom > -80 && rect.top < window.innerHeight + 80;
		}

		window.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' || e.key === 'Esc') {
				let handled = false;
				const waferModal = document.getElementById('wafer-modal');
				if (waferModal && (!waferModal.classList.contains('hidden') || waferModal.style.display !== 'none')) {
					(window as any).__closeWaferMap?.();
					handled = true;
				}
				if (multiplierModal && (!multiplierModal.classList.contains('hidden') || multiplierModal.style.display !== 'none')) {
					closeMultiplier();
					handled = true;
				}
				if (sequencerModal && (!sequencerModal.classList.contains('hidden') || sequencerModal.style.display !== 'none')) {
					closeSequencer();
					handled = true;
				}
				if (breakoutModal && (!breakoutModal.classList.contains('hidden') || breakoutModal.style.display !== 'none')) {
					closeBreakout();
					handled = true;
				}
				if (isZeroG || isTilt || isDegauss || isSphere || isQuantum || isThermal || isAnalyzer || isReflow) {
					closeAllActiveModes();
					handled = true;
				}
				if (extrasModal && (!extrasModal.classList.contains('hidden') || extrasModal.style.display !== 'none')) {
					extrasModal.classList.add('hidden');
					extrasModal.style.display = 'none';
					handled = true;
				}
				if (handled) {
					e.preventDefault();
					updateDrawerActiveUI();
				}
				return;
			}

			const hasModifiers = (e.ctrlKey || e.metaKey) && e.altKey;
			if (!hasModifiers) return;

			const activeTag = document.activeElement?.tagName;
			if (activeTag === 'INPUT' || activeTag === 'TEXTAREA' || activeTag === 'SELECT') return;

			const termModal = document.getElementById('terminal-modal');
			if (termModal && termModal.classList.contains('open')) return;

			if (isNearKeyboardLab()) return;
			if (document.activeElement?.closest('#keyboard-lab')) return;

			if (e.code === 'KeyG') {
				e.preventDefault();
				(window as any).__toggleZeroG();
				updateDrawerActiveUI();
			} else if (e.code === 'KeyH') {
				e.preventDefault();
				(window as any).__toggleTilt();
				updateDrawerActiveUI();
			}
		});

		// Lab Extras Drawer Wire-up (Strictly Alphabetical Order 14 items)
		// 1. 3D Cyclone
		document.getElementById('trigger-sphere-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			if (extrasModal) extrasModal.style.display = 'none';
			if (isSphere) resetSphere(); else startSphere();
			updateDrawerActiveUI();
		});

		// 2. 3D Tilt
		document.getElementById('trigger-tilt-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			if (extrasModal) extrasModal.style.display = 'none';
			toggleTilt(!isTilt);
			updateDrawerActiveUI();
		});

		// 3. 8-Bit Bus Sequencer
		document.getElementById('trigger-sequencer-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			if (extrasModal) extrasModal.style.display = 'none';
			openSequencer();
			updateDrawerActiveUI();
		});

		// 4. 8x8 Multiplier
		document.getElementById('trigger-multiplier-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			if (extrasModal) extrasModal.style.display = 'none';
			openMultiplier();
			updateDrawerActiveUI();
		});

		// 5. Chief Morale Officer
		document.getElementById('trigger-boop-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			if (extrasModal) extrasModal.style.display = 'none';
			(window as any).__boopDog?.();
		});

		// 6. CRT Degauss
		document.getElementById('trigger-degauss-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			if (extrasModal) extrasModal.style.display = 'none';
			if (isDegauss) resetDegauss(); else startDegauss();
			updateDrawerActiveUI();
		});

		// 7. Hot Air Solder Reflow
		document.getElementById('trigger-reflow-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			if (extrasModal) extrasModal.style.display = 'none';
			if (isReflow) resetReflow(); else startReflow();
			updateDrawerActiveUI();
		});

		// 8. Logic Analyzer
		document.getElementById('trigger-analyzer-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			if (extrasModal) extrasModal.style.display = 'none';
			if (isAnalyzer) stopAnalyzer(); else startAnalyzer();
			updateDrawerActiveUI();
		});

		// 9. Quantum Tunneling
		document.getElementById('trigger-quantum-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			if (extrasModal) extrasModal.style.display = 'none';
			if (isQuantum) resetQuantum(); else startQuantum();
			updateDrawerActiveUI();
		});

		// 10. Switch Acoustics
		// (handled by drawerSoundBtn below)

		// 11. Thermal Cam
		document.getElementById('trigger-thermal-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			if (extrasModal) extrasModal.style.display = 'none';
			if (isThermal) resetThermal(); else startThermal();
			updateDrawerActiveUI();
		});

		// 12. Wafer Breakout
		document.getElementById('trigger-breakout-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			if (extrasModal) extrasModal.style.display = 'none';
			openBreakout();
			updateDrawerActiveUI();
		});

		// 13. Wafer Sort Map
		document.getElementById('trigger-wafer-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			if (extrasModal) extrasModal.style.display = 'none';
			const waferModal = document.getElementById('wafer-modal');
			if (waferModal && !waferModal.classList.contains('hidden')) {
				(window as any).__closeWaferMap?.();
			} else {
				(window as any).__openWaferMap?.();
			}
			updateDrawerActiveUI();
		});

		// 14. Zero-G Drop
		document.getElementById('trigger-zerog-btn')?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			if (extrasModal) extrasModal.style.display = 'none';
			if (isZeroG) resetZeroG(); else startZeroG();
			updateDrawerActiveUI();
		});

		// Switch sound button in drawer
		const drawerSoundBtn = document.getElementById('trigger-switch-sound-btn');
		const drawerSoundBadge = document.getElementById('extras-sound-badge');
		const drawerSoundDesc = document.getElementById('extras-sound-desc');

		function updateDrawerSoundUI(p: string) {
			if (!drawerSoundBadge) return;
			const badges: Record<string, string> = {
				off: 'Sound: Off',
				blue: 'Blue (Clicky)',
				red: 'Red (Linear)',
				modelm: 'Model M (Spring)'
			};
			drawerSoundBadge.textContent = badges[p] || 'Sound: Off';
			if (drawerSoundDesc) {
				drawerSoundDesc.textContent = p === 'off' ? 'Procedural Web Audio switch synth' : `Acoustics active: ${badges[p]}`;
			}
			drawerSoundBtn?.classList.toggle('active', p !== 'off');
		}

		updateDrawerSoundUI(audioEngine.profile);
		window.addEventListener('switch-sound-changed', ((e: CustomEvent) => {
			if (e.detail?.profile) updateDrawerSoundUI(e.detail.profile);
		}) as EventListener);

		drawerSoundBtn?.addEventListener('click', () => {
			const current = audioEngine.profile;
			const order = ['off', 'blue', 'red', 'modelm'];
			const next = order[(order.indexOf(current) + 1) % order.length] as any;
			audioEngine.setProfile(next);
			updateDrawerSoundUI(next);
			if (next !== 'off') audioEngine.play('KeyA');
			updateDrawerActiveUI();
		});

		extrasCloseBtn?.addEventListener('click', () => {
			extrasModal?.classList.add('hidden');
			if (extrasModal) extrasModal.style.display = 'none';
		});

		document.addEventListener('click', (e) => {
			const target = e.target as HTMLElement;
			if (extrasModal && !extrasModal.classList.contains('hidden')) {
				if (!extrasModal.contains(target) && !target.closest('#footer-extras-btn')) {
					extrasModal.classList.add('hidden');
					extrasModal.style.display = 'none';
				}
			}
		});
	}

	let isEasterEggsInitialized = false;
	function safeInit() {
		if (isEasterEggsInitialized) return;
		isEasterEggsInitialized = true;
		initEasterEggs();
		initWaferInspector();
		initDogBoop();
	}

	safeInit();
	document.addEventListener('astro:page-load', safeInit);
</script>

<style>
	/* FLOATING HUDS */
	.ee-hud {
		position: fixed;
		top: 16px;
		left: 50%;
		transform: translateX(-50%);
		background: rgba(15, 23, 42, 0.94);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border: 1px solid var(--accent);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4), 0 0 16px rgba(var(--accent-rgb), 0.35);
		color: #f8fafc;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.78em;
		letter-spacing: 0.04em;
		padding: 0.45em 1.1em;
		border-radius: 24px;
		display: flex;
		align-items: center;
		gap: 0.75em;
		z-index: 100000;
		transition: all 0.2s ease;
		white-space: nowrap;
	}
	.hidden,
	.ee-hud.hidden,
	.lab-extras-modal.hidden,
	.wafer-modal.hidden,
	.sphere-core.hidden,
	.thermal-scale-bar.hidden,
