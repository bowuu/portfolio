---
const now = new Date();
const currentYear = now.getFullYear();

// Human-readable build timestamp pinned to America/New_York (e.g. "November 4, 2026 at 9:50 AM EST")
const lastUpdated = new Intl.DateTimeFormat('en-US', {
	month: 'long',
	day: 'numeric',
	year: 'numeric',
	hour: 'numeric',
	minute: '2-digit',
	timeZoneName: 'short',
	timeZone: 'America/New_York',
}).format(now);
const isoTimestamp = now.toISOString();
---

<footer>
	<!-- BUILD TIMESTAMP & ANONYMOUS VISITOR COUNT (Local Deployment Verified) -->
	<div class="footer-meta">
		<span class="last-updated">Last updated: <time id="footer-build-time" datetime={isoTimestamp}>{lastUpdated}</time></span>
		<span id="footer-visitor-wrap" class="visitor-wrap hidden">
			<span class="meta-dot" aria-hidden="true">&bull;</span>
			<span class="visitor-counter">Visitor #<span id="visitor-count-val">...</span></span>
		</span>
	</div>

	<!-- COPYRIGHT -->
	<p class="copyright">&copy; {currentYear} Bo Wu. All rights reserved.</p>
</footer>

<script>
	function formatLocalTimestamp() {
		const timeEl = document.getElementById('footer-build-time');
		if (!timeEl) return;
		const iso = timeEl.getAttribute('datetime');
		if (!iso) return;

		const date = new Date(iso);
		if (isNaN(date.getTime())) return;

		try {
			// Dynamically formats the timestamp to the visitor's device locale and local timezone (e.g., PST in CA, CST in TX, EST in NY)
			timeEl.textContent = new Intl.DateTimeFormat('en-US', {
				month: 'long',
				day: 'numeric',
				year: 'numeric',
				hour: 'numeric',
				minute: '2-digit',
				timeZoneName: 'short',
			}).format(date);
		} catch {
			// Keep build-time fallback if Intl formatting encounters an issue
		}
	}

	function initVisitorCounter() {
		const wrapEl = document.getElementById('footer-visitor-wrap');
		const countEl = document.getElementById('visitor-count-val');
		if (!wrapEl || !countEl) return;

		function updateDisplay(count: number | string) {
			countEl!.textContent = Number(count).toLocaleString();
			wrapEl!.classList.remove('hidden');
		}

		// 1. If already counted on this device today, fetch read-only count without sending an increment beacon
		const todayKey = new Date().toISOString().slice(0, 10);
		let localCounted = false;
		try {
			localCounted = localStorage.getItem('brob_visit_day') === todayKey;
		} catch {}

		if (localCounted) {
			fetch('/api/visitor-counter')
				.then((r) => (r.ok ? r.json() : null))
				.then((data) => {
					if (data && typeof data.count === 'number') updateDisplay(data.count);
				})
				.catch(() => {});
			return;
		}

		// 2. Wait for verified human engagement (active dwell time or scroll) to filter automated crawlers
		let triggered = false;
		function triggerIncrement() {
			if (triggered) return;
			triggered = true;
			try {
				localStorage.setItem('brob_visit_day', todayKey);
			} catch {}

			window.removeEventListener('scroll', onScroll);
			window.removeEventListener('click', triggerIncrement);
			window.removeEventListener('keydown', triggerIncrement);

			fetch('/api/visitor-counter', { method: 'POST' })
				.then((r) => (r.ok ? r.json() : null))
				.then((data) => {
					if (data && typeof data.count === 'number') updateDisplay(data.count);
				})
				.catch(() => {});
		}

		function onScroll() {
			if (window.scrollY > 80) triggerIncrement();
		}

		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('click', triggerIncrement, { once: true, passive: true });
		window.addEventListener('keydown', triggerIncrement, { once: true, passive: true });
		setTimeout(triggerIncrement, 3500);
	}

	function initFooter() {
		formatLocalTimestamp();
		initVisitorCounter();
	}

	initFooter();
	document.addEventListener('astro:page-load', initFooter);
</script>

<style>
	footer {
		padding: clamp(2rem, 4vw, 3rem) clamp(1rem, 4vw, 2rem) 3.5rem clamp(1rem, 4vw, 2rem);
		background: var(--bg-page);
		color: rgb(var(--gray));
		text-align: center;
		border-top: 1px solid var(--border-color);
		width: 100%;
		transition: background-color 0.2s ease, border-color 0.2s ease;
	}
	.footer-meta {
		display: flex;
		justify-content: center;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.35em 0.7em;
		margin: 0;
		font-size: 0.86em;
		font-weight: 400;
		color: rgb(var(--gray));
		opacity: 0.85;
		letter-spacing: 0.01em;
	}
	.meta-dot {
		color: rgba(var(--gray), 0.4);
		font-size: 0.85em;
		user-select: none;
	}
	.visitor-wrap {
		display: inline-flex;
		align-items: center;
		gap: 0.7em;
		transition: opacity 0.25s ease;
	}
	.visitor-wrap.hidden {
		display: none;
	}
	.last-updated time,
	.visitor-counter {
		font-variant-numeric: tabular-nums;
	}
	.copyright {
		margin-top: 0.75em;
		margin-bottom: 0;
		font-size: 0.8em;
		font-weight: 500;
		color: rgb(var(--gray));
		opacity: 0.65;
	}
</style>
