---
const commitDateStr = import.meta.env.PUBLIC_GIT_COMMIT_DATE || new Date().toISOString();
const commitHash = import.meta.env.PUBLIC_GIT_COMMIT_HASH || '';
const commitShortHash = import.meta.env.PUBLIC_GIT_COMMIT_SHORT_HASH || (commitHash ? commitHash.slice(0, 7) : '');
const commitDate = new Date(commitDateStr);
const currentYear = new Date().getFullYear();

// Human-readable build timestamp pinned to America/New_York (e.g. "November 11, 2026 at 1:45 PM EST")
const lastUpdated = new Intl.DateTimeFormat('en-US', {
	month: 'long',
	day: 'numeric',
	year: 'numeric',
	hour: 'numeric',
	minute: '2-digit',
	timeZoneName: 'short',
	timeZone: 'America/New_York',
}).format(commitDate);
const isoTimestamp = commitDate.toISOString();
const commitUrl = commitHash ? `https://github.com/bowuu/portfolio/commit/${commitHash}` : 'https://github.com/bowuu/portfolio';
---

<footer>
	<!-- BUILD TIMESTAMP & ANONYMOUS VISITOR COUNT (Local Deployment Verified) -->
	<div class="footer-meta">
		<span class="last-updated">
			Last updated: <time id="footer-build-time" datetime={isoTimestamp}>{lastUpdated}</time>
			{commitShortHash && (
				<a
					id="footer-commit-link"
					href={commitUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="commit-link"
					title={`View commit ${commitShortHash} on GitHub`}
				>
					({commitShortHash})
				</a>
			)}
		</span>
		<span id="footer-visitor-wrap" class="visitor-wrap hidden">
			<span class="meta-dot" aria-hidden="true">▪</span>
			<span class="visitor-counter">Visitor #<span id="visitor-count-val">...</span></span>
		</span>
		<span class="meta-dot" aria-hidden="true">▪</span>
		<button id="footer-extras-btn" class="footer-extras-btn" type="button" title="Hardware Lab Extras (Wafer Sort, Switch Acoustics, Zero-G & 3D Tilt)">
			<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="extras-sparkle-icon"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
			<span>Lab Extras</span>
		</button>
	</div>

	<!-- COPYRIGHT -->
	<p class="copyright">&copy; {currentYear} Bo Wu. All rights reserved.</p>
</footer>

<script>
	function formatLocalTimestamp() {
		const timeEl = document.getElementById('footer-build-time');
		if (!timeEl) return;
		const iso = timeEl.getAttribute('datetime');
		if (!iso) return;

		const date = new Date(iso);
		if (isNaN(date.getTime())) return;

		try {
			// Dynamically formats the timestamp to the visitor's device locale and local timezone (e.g., PST in CA, CST in TX, EST in NY)
			timeEl.textContent = new Intl.DateTimeFormat('en-US', {
				month: 'long',
				day: 'numeric',
				year: 'numeric',
				hour: 'numeric',
				minute: '2-digit',
				timeZoneName: 'short',
			}).format(date);
		} catch {
			// Keep build-time fallback if Intl formatting encounters an issue
		}
	}

	function initVisitorCounter() {
		const wrapEl = document.getElementById('footer-visitor-wrap');
		const countEl = document.getElementById('visitor-count-val');
		if (!wrapEl || !countEl) return;

		function updateDisplay(count: number | string) {
			countEl!.textContent = Number(count).toLocaleString();
			wrapEl!.classList.remove('hidden');
		}

		// Wait for verified human engagement (active dwell time or scroll) to filter automated crawlers
		let triggered = false;
		function triggerIncrement() {
			if (triggered) return;
			triggered = true;

			window.removeEventListener('scroll', onScroll);
			window.removeEventListener('click', triggerIncrement);
			window.removeEventListener('keydown', triggerIncrement);

			fetch('/api/visitor-counter', { method: 'POST' })
				.then((r) => (r.ok ? r.json() : null))
				.then((data) => {
					if (data && typeof data.count === 'number') updateDisplay(data.count);
				})
				.catch(() => {});
		}

		function onScroll() {
			if (window.scrollY > 80) triggerIncrement();
		}

		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('click', triggerIncrement, { once: true, passive: true });
		window.addEventListener('keydown', triggerIncrement, { once: true, passive: true });
		setTimeout(triggerIncrement, 3500);
	}

	function initExtrasButton() {
		const btn = document.getElementById('footer-extras-btn');
		if (btn) {
			btn.addEventListener('click', (e) => {
				e.stopPropagation();
				if (typeof (window as any).__toggleLabExtras === 'function') {
					(window as any).__toggleLabExtras();
				}
			});
		}
	}

	function initFooter() {
		formatLocalTimestamp();
		initVisitorCounter();
		initExtrasButton();
	}

	initFooter();
	document.addEventListener('astro:page-load', initFooter);
</script>

<style>
	footer {
		padding: clamp(2rem, 4vw, 3rem) clamp(1rem, 4vw, 2rem) 3.5rem clamp(1rem, 4vw, 2rem);
		background: var(--bg-page);
		color: rgb(var(--gray));
		text-align: center;
		border-top: 1px solid var(--border-color);
		width: 100%;
		transition: background-color 0.2s ease, border-color 0.2s ease;
	}
	.footer-meta {
		display: flex;
		justify-content: center;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.35em 0.7em;
		margin: 0;
		font-size: 0.86em;
		font-weight: 400;
		color: rgb(var(--gray));
		opacity: 0.85;
		letter-spacing: 0.01em;
	}
	.meta-dot {
		color: rgba(var(--gray), 0.4);
		font-size: 0.85em;
		user-select: none;
	}
	.visitor-wrap {
		display: inline-flex;
		align-items: center;
		gap: 0.7em;
		transition: opacity 0.25s ease;
	}
	.visitor-wrap.hidden {
		display: none;
	}
	.last-updated time,
	.visitor-counter {
		font-variant-numeric: tabular-nums;
	}
	.commit-link {
		color: inherit;
		text-decoration: none;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.9em;
		opacity: 0.7;
		transition: color 0.15s ease, opacity 0.15s ease;
		margin-left: 0.25em;
	}
	.commit-link:hover {
		color: var(--accent);
		opacity: 1;
		text-decoration: underline;
	}
	.footer-extras-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
		background: transparent;
		border: 1px solid var(--border-color);
		color: rgb(var(--gray));
		border-radius: 12px;
		padding: 0.15em 0.55em;
		font-size: 0.88em;
		font-family: inherit;
		cursor: pointer;
		transition: all 0.15s ease;
	}
	.footer-extras-btn:hover {
		border-color: var(--accent);
		color: var(--accent);
		background: rgba(var(--accent-rgb), 0.08);
	}
	.extras-sparkle-icon {
		color: var(--accent);
	}
	.copyright {
		margin-top: 0.75em;
		margin-bottom: 0;
		font-size: 0.8em;
		font-weight: 500;
		color: rgb(var(--gray));
		opacity: 0.65;
	}
</style>
