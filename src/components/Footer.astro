---
const now = new Date();
const currentYear = now.getFullYear();

// Human-readable build timestamp pinned to America/New_York (e.g. "November 4, 2026 at 9:50 AM EST")
const lastUpdated = new Intl.DateTimeFormat('en-US', {
	month: 'long',
	day: 'numeric',
	year: 'numeric',
	hour: 'numeric',
	minute: '2-digit',
	timeZoneName: 'short',
	timeZone: 'America/New_York',
}).format(now);
const isoTimestamp = now.toISOString();
---

<footer>
	<!-- BUILD TIMESTAMP -->
	<p class="last-updated">Last updated: <time id="footer-build-time" datetime={isoTimestamp}>{lastUpdated}</time></p>

	<!-- COPYRIGHT -->
	<p class="copyright">&copy; {currentYear} Bo Wu. All rights reserved.</p>
</footer>

<script>
	function formatLocalTimestamp() {
		const timeEl = document.getElementById('footer-build-time');
		if (!timeEl) return;
		const iso = timeEl.getAttribute('datetime');
		if (!iso) return;

		const date = new Date(iso);
		if (isNaN(date.getTime())) return;

		try {
			// Dynamically formats the timestamp to the visitor's device locale and local timezone (e.g., PST in CA, CST in TX, EST in NY)
			timeEl.textContent = new Intl.DateTimeFormat('en-US', {
				month: 'long',
				day: 'numeric',
				year: 'numeric',
				hour: 'numeric',
				minute: '2-digit',
				timeZoneName: 'short',
			}).format(date);
		} catch {
			// Keep build-time fallback if Intl formatting encounters an issue
		}
	}

	formatLocalTimestamp();
	document.addEventListener('astro:page-load', formatLocalTimestamp);
</script>

<style>
	footer {
		padding: clamp(2rem, 4vw, 3rem) clamp(1rem, 4vw, 2rem) 3.5rem clamp(1rem, 4vw, 2rem);
		background: var(--bg-page);
		color: rgb(var(--gray));
		text-align: center;
		border-top: 1px solid var(--border-color);
		width: 100%;
		transition: background-color 0.2s ease, border-color 0.2s ease;
	}
	.last-updated {
		margin: 0;
		font-size: 0.86em;
		font-weight: 400;
		color: rgb(var(--gray));
		opacity: 0.85;
		letter-spacing: 0.01em;
	}
	.last-updated time {
		font-variant-numeric: tabular-nums;
	}
	.copyright {
		margin-top: 0.75em;
		margin-bottom: 0;
		font-size: 0.8em;
		font-weight: 500;
		color: rgb(var(--gray));
		opacity: 0.65;
	}
</style>
