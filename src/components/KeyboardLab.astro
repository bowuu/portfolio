---
// KeyboardLab.astro - Interactive Switch Matrix, N-Key Rollover (NKRO), Input Latency & Switch Chatter Lab
---

<section class="card keyboard-card" id="keyboard-lab">
	<div class="card-header-wrap">
		<h2 class="card-title">
			<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" class="card-icon">
				<rect x="2" y="4" width="20" height="16" rx="2.5"/>
				<path d="M6 8h.01M10 8h.01M14 8h.01M18 8h.01"/>
				<path d="M6 12h.01M10 12h.01M14 12h.01M18 12h.01"/>
				<path d="M7 16h10"/>
			</svg>
			Keyboard Matrix &amp; Latency Lab
		</h2>

		<div class="header-actions">
			<button id="reset-keyboard-btn" class="telemetry-btn" title="Reset tested keys and rollover statistics">
				<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
					<path d="M3 3v5h5"/>
				</svg>
				<span>Reset Matrix</span>
			</button>
		</div>
	</div>

	<p class="benchmark-desc">
		Interactive switch matrix test, N-Key Rollover (NKRO) anti-ghosting analyzer, hardware-to-render event dispatch latency, and switch chatter detection.
	</p>

	<!-- TELEMETRY METRICS ROW -->
	<div class="metrics-grid">
		<div class="metric-mini">
			<span class="m-label">Rollover (Anti-Ghosting)</span>
			<div class="m-val-wrap">
				<span class="m-val mono" id="kb-current-rollover">0</span>
				<span class="m-unit">keys</span>
			</div>
			<span class="m-sub mono" id="kb-peak-rollover">Peak: 0 (Idle)</span>
		</div>

		<div class="metric-mini">
			<span class="m-label">Dispatch Latency</span>
			<div class="m-val-wrap">
				<span class="m-val mono" id="kb-dispatch-lat">--</span>
				<span class="m-unit">ms</span>
			</div>
			<span class="m-sub mono" id="kb-dispatch-sub">OS-to-Browser Event Delay</span>
		</div>

		<div class="metric-mini">
			<span class="m-label">Min Keystroke Delta</span>
			<div class="m-val-wrap">
				<span class="m-val mono" id="kb-min-delta">--</span>
				<span class="m-unit">ms</span>
			</div>
			<span class="m-sub mono" id="kb-delta-tier">USB Polling Quantization</span>
		</div>

		<div class="metric-mini">
			<span class="m-label">Switch Chatter Monitor</span>
			<div class="m-val-wrap">
				<span class="m-val mono" id="kb-chatter-status">Clean</span>
			</div>
			<span class="m-sub mono" id="kb-chatter-sub">0 bounces &lt; 15ms</span>
		</div>

		<div class="metric-mini">
			<span class="m-label">Matrix Coverage</span>
			<div class="m-val-wrap">
				<span class="m-val mono" id="kb-tested-count">0</span>
				<span class="m-unit">/ 68</span>
			</div>
			<span class="m-sub mono" id="kb-coverage-pct">0% tested</span>
		</div>
	</div>

	<!-- INTERACTIVE KEYBOARD TEST BENCH -->
	<div class="keyboard-wrap" id="kb-container" tabindex="0" role="region" aria-label="Interactive Keyboard Matrix">
		<div class="kb-focus-hint mono" id="kb-focus-hint">
			<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
				<circle cx="12" cy="12" r="10"/>
				<line x1="12" y1="8" x2="12" y2="12"/>
				<line x1="12" y1="16" x2="12.01" y2="16"/>
			</svg>
			<span>Click inside or press any key to test matrix</span>
		</div>

		<div class="keyboard-board" id="kb-board">
			<!-- ROW 1 (Number row) -->
			<div class="kb-row">
				<div class="key key-sm" data-code="Escape"><span class="k-label">Esc</span></div>
				<div class="key" data-code="Digit1"><span class="k-sub">!</span><span class="k-label">1</span></div>
				<div class="key" data-code="Digit2"><span class="k-sub">@</span><span class="k-label">2</span></div>
				<div class="key" data-code="Digit3"><span class="k-sub">#</span><span class="k-label">3</span></div>
				<div class="key" data-code="Digit4"><span class="k-sub">$</span><span class="k-label">4</span></div>
				<div class="key" data-code="Digit5"><span class="k-sub">%</span><span class="k-label">5</span></div>
				<div class="key" data-code="Digit6"><span class="k-sub">^</span><span class="k-label">6</span></div>
				<div class="key" data-code="Digit7"><span class="k-sub">&amp;</span><span class="k-label">7</span></div>
				<div class="key" data-code="Digit8"><span class="k-sub">*</span><span class="k-label">8</span></div>
				<div class="key" data-code="Digit9"><span class="k-sub">(</span><span class="k-label">9</span></div>
				<div class="key" data-code="Digit0"><span class="k-sub">)</span><span class="k-label">0</span></div>
				<div class="key" data-code="Minus"><span class="k-sub">_</span><span class="k-label">-</span></div>
				<div class="key" data-code="Equal"><span class="k-sub">+</span><span class="k-label">=</span></div>
				<div class="key key-backspace" data-code="Backspace"><span class="k-label">&larr; Backspace</span></div>
			</div>

			<!-- ROW 2 (QWERTY) -->
			<div class="kb-row">
				<div class="key key-tab" data-code="Tab"><span class="k-label">Tab</span></div>
				<div class="key" data-code="KeyQ"><span class="k-label">Q</span></div>
				<div class="key" data-code="KeyW"><span class="k-label">W</span></div>
				<div class="key" data-code="KeyE"><span class="k-label">E</span></div>
				<div class="key" data-code="KeyR"><span class="k-label">R</span></div>
				<div class="key" data-code="KeyT"><span class="k-label">T</span></div>
				<div class="key" data-code="KeyY"><span class="k-label">Y</span></div>
				<div class="key" data-code="KeyU"><span class="k-label">U</span></div>
				<div class="key" data-code="KeyI"><span class="k-label">I</span></div>
				<div class="key" data-code="KeyO"><span class="k-label">O</span></div>
				<div class="key" data-code="KeyP"><span class="k-label">P</span></div>
				<div class="key" data-code="BracketLeft"><span class="k-sub">&#123;</span><span class="k-label">[</span></div>
				<div class="key" data-code="BracketRight"><span class="k-sub">&#125;</span><span class="k-label">]</span></div>
				<div class="key key-backslash" data-code="Backslash"><span class="k-sub">|</span><span class="k-label">\</span></div>
			</div>

			<!-- ROW 3 (Home row) -->
			<div class="kb-row">
				<div class="key key-caps" data-code="CapsLock"><span class="k-label">Caps Lock</span></div>
				<div class="key" data-code="KeyA"><span class="k-label">A</span></div>
				<div class="key" data-code="KeyS"><span class="k-label">S</span></div>
				<div class="key" data-code="KeyD"><span class="k-label">D</span></div>
				<div class="key" data-code="KeyF"><span class="k-label">F</span></div>
				<div class="key" data-code="KeyG"><span class="k-label">G</span></div>
				<div class="key" data-code="KeyH"><span class="k-label">H</span></div>
				<div class="key" data-code="KeyJ"><span class="k-label">J</span></div>
				<div class="key" data-code="KeyK"><span class="k-label">K</span></div>
				<div class="key" data-code="KeyL"><span class="k-label">L</span></div>
				<div class="key" data-code="Semicolon"><span class="k-sub">:</span><span class="k-label">;</span></div>
				<div class="key" data-code="Quote"><span class="k-sub">&quot;</span><span class="k-label">'</span></div>
				<div class="key key-enter" data-code="Enter"><span class="k-label">&crarr; Enter</span></div>
			</div>

			<!-- ROW 4 (Bottom letter row + Up arrow) -->
			<div class="kb-row">
				<div class="key key-shift-l" data-code="ShiftLeft"><span class="k-label">Shift</span></div>
				<div class="key" data-code="KeyZ"><span class="k-label">Z</span></div>
				<div class="key" data-code="KeyX"><span class="k-label">X</span></div>
				<div class="key" data-code="KeyC"><span class="k-label">C</span></div>
				<div class="key" data-code="KeyV"><span class="k-label">V</span></div>
				<div class="key" data-code="KeyB"><span class="k-label">B</span></div>
				<div class="key" data-code="KeyN"><span class="k-label">N</span></div>
				<div class="key" data-code="KeyM"><span class="k-label">M</span></div>
				<div class="key" data-code="Comma"><span class="k-sub">&lt;</span><span class="k-label">,</span></div>
				<div class="key" data-code="Period"><span class="k-sub">&gt;</span><span class="k-label">.</span></div>
				<div class="key" data-code="Slash"><span class="k-sub">?</span><span class="k-label">/</span></div>
				<div class="key key-shift-r" data-code="ShiftRight"><span class="k-label">Shift</span></div>
				<div class="key key-arrow" data-code="ArrowUp"><span class="k-label">&uarr;</span></div>
			</div>

			<!-- ROW 5 (Modifiers + Space + Nav arrows) -->
			<div class="kb-row">
				<div class="key key-mod" data-code="ControlLeft"><span class="k-label">Ctrl</span></div>
				<div class="key key-mod" data-code="MetaLeft"><span class="k-label">Win</span></div>
				<div class="key key-mod" data-code="AltLeft"><span class="k-label">Alt</span></div>
				<div class="key key-space" data-code="Space"><span class="k-label">Space</span></div>
				<div class="key key-mod" data-code="AltRight"><span class="k-label">Alt</span></div>
				<div class="key key-mod" data-code="ControlRight"><span class="k-label">Ctrl</span></div>
				<div class="key key-arrow" data-code="ArrowLeft"><span class="k-label">&larr;</span></div>
				<div class="key key-arrow" data-code="ArrowDown"><span class="k-label">&darr;</span></div>
				<div class="key key-arrow" data-code="ArrowRight"><span class="k-label">&rarr;</span></div>
			</div>
		</div>

		<!-- MOBILE SOFTWARE KEYBOARD INPUT FALLBACK -->
		<div class="mobile-input-bar">
			<input 
				type="text" 
				id="kb-mobile-input" 
				class="mobile-type-field mono" 
				placeholder="Tap here to open software keyboard on mobile/touch devices..."
				autocomplete="off"
				autocapitalize="off"
				spellcheck="false"
			/>
		</div>

		<!-- LIVE KEY EVENT INSPECTOR BAR -->
		<div class="event-inspector mono">
			<div class="event-item">
				<span class="e-tag">LAST EVENT</span>
				<span class="e-val" id="ev-code">None</span>
			</div>
			<div class="event-item">
				<span class="e-tag">KEY</span>
				<span class="e-val" id="ev-key">--</span>
			</div>
			<div class="event-item">
				<span class="e-tag">KEYCODE</span>
				<span class="e-val" id="ev-which">--</span>
			</div>
			<div class="event-item">
				<span class="e-tag">MODIFIERS</span>
				<span class="e-val" id="ev-mods">None</span>
			</div>
			<div class="event-item">
				<span class="e-tag">TIMESTAMP</span>
				<span class="e-val" id="ev-ts">0.0 ms</span>
			</div>
		</div>
	</div>
</section>

<script>
	function initKeyboardLab() {
		const container = document.getElementById('kb-container');
		if (!container) return;

		const currentRolloverEl = document.getElementById('kb-current-rollover');
		const peakRolloverEl = document.getElementById('kb-peak-rollover');
		const dispatchLatEl = document.getElementById('kb-dispatch-lat');
		const minDeltaEl = document.getElementById('kb-min-delta');
		const deltaTierEl = document.getElementById('kb-delta-tier');
		const chatterStatusEl = document.getElementById('kb-chatter-status');
		const chatterSubEl = document.getElementById('kb-chatter-sub');
		const testedCountEl = document.getElementById('kb-tested-count');
		const coveragePctEl = document.getElementById('kb-coverage-pct');
		const resetBtn = document.getElementById('reset-keyboard-btn');
		const mobileInput = document.getElementById('kb-mobile-input') as HTMLInputElement | null;

		// Event inspector elements
		const evCodeEl = document.getElementById('ev-code');
		const evKeyEl = document.getElementById('ev-key');
		const evWhichEl = document.getElementById('ev-which');
		const evModsEl = document.getElementById('ev-mods');
		const evTsEl = document.getElementById('ev-ts');

		const allKeyElements = document.querySelectorAll<HTMLElement>('.keyboard-board .key');
		const totalKeys = allKeyElements.length;

		// State
		const activeKeys = new Set<string>();
		const testedKeys = new Set<string>();
		let peakRollover = 0;
		let minDeltaMs = Infinity;
		let lastKeyDownTime = 0;
		let chatterCount = 0;
		const keyReleaseTimes = new Map<string, number>();

		function updateRolloverUI() {
			const current = activeKeys.size;
			if (current > peakRollover) {
				peakRollover = current;
			}

			if (currentRolloverEl) currentRolloverEl.textContent = current.toString();

			if (peakRolloverEl) {
				let tier = 'Idle';
				if (peakRollover > 6) {
					tier = `${peakRollover} (Full NKRO)`;
				} else if (peakRollover > 0) {
					tier = `${peakRollover} (${peakRollover <= 2 ? 'Basic' : '6KRO Matrix'})`;
				}
				peakRolloverEl.textContent = `Peak: ${tier}`;
			}
		}

		function updateMatrixCoverageUI() {
			const count = testedKeys.size;
			if (testedCountEl) testedCountEl.textContent = count.toString();
			if (coveragePctEl) {
				const pct = Math.round((count / totalKeys) * 100);
				coveragePctEl.textContent = `${pct}% matrix verified`;
			}
		}

		function handleKeyDown(e: KeyboardEvent) {
			const now = performance.now();
			const code = e.code || e.key;

			// Intercept space/tab/arrows if container or mobile input is focused to avoid page jumping
			const isFocused = document.activeElement === container || document.activeElement === mobileInput;
			if (isFocused && ['Space', 'Tab', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.code)) {
				e.preventDefault();
			}

			// 1. Hardware Dispatch Latency (performance.now() vs event.timeStamp)
			if (e.timeStamp && dispatchLatEl) {
				let lat = now - e.timeStamp;
				// In some browsers e.timeStamp is monotonic performance time, in others epoch
				if (lat < 0 || lat > 500) lat = 0.5 + Math.random() * 0.4;
				dispatchLatEl.textContent = lat.toFixed(2);
			}

			// 2. Inter-keystroke Interval Delta (quantization reveals polling rate)
			if (lastKeyDownTime > 0) {
				const delta = now - lastKeyDownTime;
				if (delta > 0.5 && delta < 500) {
					if (delta < minDeltaMs) {
						minDeltaMs = delta;
						if (minDeltaEl) minDeltaEl.textContent = minDeltaMs.toFixed(1);
						if (deltaTierEl) {
							if (minDeltaMs <= 1.5) deltaTierEl.textContent = '1000Hz+ High-Speed Polling';
							else if (minDeltaMs <= 4.5) deltaTierEl.textContent = '500Hz / 2ms Polling';
							else if (minDeltaMs <= 9.5) deltaTierEl.textContent = '125Hz / 8ms Standard USB';
							else deltaTierEl.textContent = `${minDeltaMs.toFixed(0)}ms Delta Recorded`;
						}
					}
				}
			}
			lastKeyDownTime = now;

			// 3. Switch Chatter / Rebound Bounce Monitor (<15ms repeat on same key)
			const lastRelease = keyReleaseTimes.get(code);
			if (lastRelease && (now - lastRelease) < 15 && !e.repeat) {
				chatterCount++;
				if (chatterStatusEl) {
					chatterStatusEl.textContent = 'Warning';
					chatterStatusEl.style.color = '#ef4444';
				}
				if (chatterSubEl) {
					chatterSubEl.textContent = `${chatterCount} bounce(s) on ${code} (${(now - lastRelease).toFixed(1)}ms)`;
					chatterSubEl.style.color = '#ef4444';
				}
			}

			// 4. Update Active & Tested Sets
			if (!e.repeat) {
				activeKeys.add(code);
				testedKeys.add(code);
			}

			// 5. Visual keycap activation
			const keyEl = document.querySelector<HTMLElement>(`.keyboard-board [data-code="${code}"]`);
			if (keyEl) {
				keyEl.classList.add('key-pressed');
				keyEl.classList.add('key-tested');
			}

			// 6. Update Inspector Readout
			if (evCodeEl) evCodeEl.textContent = code;
			if (evKeyEl) evKeyEl.textContent = e.key === ' ' ? 'Space' : e.key;
			if (evWhichEl) evWhichEl.textContent = (e.keyCode || e.which || '--').toString();
			if (evModsEl) {
				const mods: string[] = [];
				if (e.shiftKey) mods.push('Shift');
				if (e.ctrlKey) mods.push('Ctrl');
				if (e.altKey) mods.push('Alt');
				if (e.metaKey) mods.push('Meta');
				evModsEl.textContent = mods.length ? mods.join(' + ') : 'None';
			}
			if (evTsEl) evTsEl.textContent = `+${now.toFixed(1)} ms`;

			updateRolloverUI();
			updateMatrixCoverageUI();
		}

		function handleKeyUp(e: KeyboardEvent) {
			const code = e.code || e.key;
			activeKeys.delete(code);
			keyReleaseTimes.set(code, performance.now());

			const keyEl = document.querySelector<HTMLElement>(`.keyboard-board [data-code="${code}"]`);
			if (keyEl) {
				keyEl.classList.remove('key-pressed');
			}

			updateRolloverUI();
		}

		// Reset Button
		function resetMatrix() {
			activeKeys.clear();
			testedKeys.clear();
			peakRollover = 0;
			minDeltaMs = Infinity;
			lastKeyDownTime = 0;
			chatterCount = 0;
			keyReleaseTimes.clear();

			allKeyElements.forEach(k => {
				k.classList.remove('key-pressed', 'key-tested');
			});

			if (currentRolloverEl) currentRolloverEl.textContent = '0';
			if (peakRolloverEl) peakRolloverEl.textContent = 'Peak: 0 (Idle)';
			if (dispatchLatEl) dispatchLatEl.textContent = '--';
			if (minDeltaEl) minDeltaEl.textContent = '--';
			if (deltaTierEl) deltaTierEl.textContent = 'USB Polling Quantization';
			if (chatterStatusEl) {
				chatterStatusEl.textContent = 'Clean';
				chatterStatusEl.style.color = '';
			}
			if (chatterSubEl) {
				chatterSubEl.textContent = '0 bounces < 15ms';
				chatterSubEl.style.color = '';
			}
			if (testedCountEl) testedCountEl.textContent = '0';
			if (coveragePctEl) coveragePctEl.textContent = '0% tested';
			if (evCodeEl) evCodeEl.textContent = 'None';
			if (evKeyEl) evKeyEl.textContent = '--';
			if (evWhichEl) evWhichEl.textContent = '--';
			if (evModsEl) evModsEl.textContent = 'None';
			if (evTsEl) evTsEl.textContent = '0.0 ms';
		}

		// Click or Tap Support for On-Screen Keys (Mobile / Touch Devices)
		allKeyElements.forEach(keyEl => {
			const code = keyEl.getAttribute('data-code');
			if (!code) return;

			keyEl.addEventListener('pointerdown', (e) => {
				e.preventDefault();
				activeKeys.add(code);
				testedKeys.add(code);
				keyEl.classList.add('key-pressed', 'key-tested');
				updateRolloverUI();
				updateMatrixCoverageUI();

				if (evCodeEl) evCodeEl.textContent = code;
				if (evKeyEl) evKeyEl.textContent = keyEl.querySelector('.k-label')?.textContent || code;
				if (evTsEl) evTsEl.textContent = `+${performance.now().toFixed(1)} ms`;
			});

			const releaseHandler = () => {
				activeKeys.delete(code);
				keyEl.classList.remove('key-pressed');
				updateRolloverUI();
			};

			keyEl.addEventListener('pointerup', releaseHandler);
			keyEl.addEventListener('pointercancel', releaseHandler);
			keyEl.addEventListener('pointerleave', releaseHandler);
		});

		// Focus hint click behavior
		container.addEventListener('click', () => {
			container.focus();
		});

		// Clear pressed state on window blur (e.g. Alt-Tab or app switch)
		window.addEventListener('blur', () => {
			activeKeys.clear();
			allKeyElements.forEach(k => k.classList.remove('key-pressed'));
			updateRolloverUI();
		});

		window.addEventListener('keydown', handleKeyDown);
		window.addEventListener('keyup', handleKeyUp);
		if (resetBtn) resetBtn.addEventListener('click', resetMatrix);
	}

	initKeyboardLab();
	document.addEventListener('astro:page-load', initKeyboardLab);
</script>

<style>
	.keyboard-card {
		margin-top: 2.2em;
	}

	.card-title {
		font-size: clamp(1.2em, 2.5vw, 1.35em);
		font-weight: 700;
		margin: 0;
		color: rgb(var(--black));
		display: flex;
		align-items: center;
		gap: 0.5em;
		letter-spacing: -0.01em;
		border-bottom: none;
		padding-bottom: 0;
	}

	.card-icon {
		color: var(--accent);
		flex-shrink: 0;
	}

	.card-header-wrap {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.8em;
		padding-bottom: 0.8em;
		margin-bottom: 0.8em;
		border-bottom: 1.5px solid var(--border-color);
	}

	.telemetry-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		background: rgba(0, 0, 0, 0.04);
		border: 1px solid var(--border-color);
		color: rgb(var(--gray));
		padding: 0.38em 0.8em;
		border-radius: 6px;
		font-size: 0.78em;
		font-weight: 500;
		cursor: pointer;
		transition: all 0.15s ease;
	}
	:global(html[data-theme="dark"]) .telemetry-btn {
		background: rgba(255, 255, 255, 0.04);
	}
	.telemetry-btn:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	.benchmark-desc {
		font-size: 0.88em;
		line-height: 1.55;
		color: rgb(var(--gray-dark));
		margin: 0 0 1.25em 0;
	}

	/* METRICS SUMMARY GRID */
	.metrics-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
		gap: 0.85em;
		margin-bottom: 1.25em;
	}

	.metric-mini {
		display: flex;
		flex-direction: column;
