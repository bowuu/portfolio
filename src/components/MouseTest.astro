---
// MouseTest.astro - Real-Time Mouse Polling Rate, Switch Debounce & Click Latency Inspector
---

<section class="card input-card" id="input-lab">
	<div class="card-header-wrap">
		<h2 class="card-title">
			<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" class="card-icon">
				<rect x="5" y="2" width="14" height="20" rx="7"/>
				<line x1="12" y1="6" x2="12" y2="10"/>
			</svg>
			Mouse Test
		</h2>

		<div class="header-actions">
			<button id="reset-input-lab-btn" class="telemetry-btn" title="Reset all polling, reflex, and mouse button measurements">
				<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
					<path d="M3 3v5h5"/>
				</svg>
				<span>Reset Metrics</span>
			</button>
		</div>
	</div>

	<p class="benchmark-desc">
		Measure real-time USB mouse polling frequency, display-to-click visual reaction latency, and test mouse buttons and scroll wheel.
	</p>

	<!-- TWO-COLUMN BENCHMARK WORKBENCH -->
	<div class="lab-grid">
		<!-- COLUMN 1: MOUSE POLLING & REFLEX BENCHMARK -->
		<div class="lab-col" id="poll-col">
			<div class="col-head">
				<div class="col-head-left">
					<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" class="col-icon">
						<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
					</svg>
					<span class="col-title">Polling &amp; Reflex Benchmark</span>
				</div>
				<span class="badge mono" id="poll-tier-badge">Idle</span>
			</div>

			<!-- UNIFIED POLLING CANVAS & REFLEX TARGET -->
			<div class="poll-reflex-box idle" id="poll-reflex-box" role="button" tabindex="0">
				<canvas id="poll-sparkline" width="460" height="90"></canvas>
				<div class="poll-reflex-overlay">
					<span class="reaction-headline" id="reaction-headline">Click to Test Reflex</span>
					<span class="reaction-sub" id="reaction-sub">Move cursor rapidly to test polling</span>
				</div>
			</div>

			<!-- UNIFIED POLLING & REFLEX READOUTS (3 BALANCED CARDS) -->
			<div class="metrics-row">
				<div class="metric-mini">
					<span class="m-label">Polling Rate</span>
					<div class="m-val-wrap">
						<span class="m-val mono" id="poll-current-hz">0</span>
						<span class="m-unit">Hz</span>
					</div>
					<span class="m-sub mono" id="poll-peak-sub">Peak: 0 Hz</span>
				</div>

				<div class="metric-mini">
					<span class="m-label">Visual Reflex</span>
					<div class="m-val-wrap">
						<span class="m-val mono" id="reaction-time-val">--</span>
						<span class="m-unit">ms</span>
					</div>
					<span class="m-sub mono" id="reaction-best-sub">Best: -- ms</span>
				</div>

				<div class="metric-mini" title="Polling jitter: Standard deviation of packet delivery intervals (±ms). Lower values indicate cleaner, more consistent polling cadence without micro-stutter.">
					<span class="m-label">Jitter</span>
					<div class="m-val-wrap">
						<span class="m-val mono" id="poll-stability-val">&plusmn;0.0</span>
						<span class="m-unit">ms</span>
					</div>
					<span class="m-sub mono" id="poll-jitter-sub">Interval Std Dev</span>
				</div>
			</div>
		</div>

		<!-- COLUMN 2: MOUSE BUTTONS & SCROLL TESTER -->
		<div class="lab-col" id="mouse-btn-col">
			<div class="col-head">
				<div class="col-head-left">
					<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" class="col-icon">
						<rect x="5" y="2" width="14" height="20" rx="7"/>
						<line x1="12" y1="6" x2="12" y2="10"/>
					</svg>
					<span class="col-title">Mouse Buttons &amp; Scroll</span>
				</div>
				<span class="badge mono" id="mouse-btns-badge">0 / 5 tested</span>
			</div>

			<!-- INTERACTIVE MOUSE HARDWARE TEST ZONE -->
			<div class="mouse-hardware-zone" id="mouse-btn-zone" tabindex="0">
				<div class="mouse-device-wrap">
					<!-- ERGONOMIC MOUSE CHASSIS -->
					<div class="mouse-chassis">
						<!-- INTEGRATED THUMB BUTTONS (LEFT FLANK) -->
						<div class="mouse-thumb-wing">
							<div class="mouse-btn mouse-btn-thumb thumb-fwd" id="btn-thumb2">
								<span>Fwd</span>
							</div>
							<div class="mouse-btn mouse-btn-thumb thumb-back" id="btn-thumb1">
								<span>Back</span>
							</div>
						</div>

						<!-- MAIN MOUSE SHELL -->
						<div class="mouse-body">
							<!-- TOP PRIMARY BUTTONS -->
							<div class="mouse-top-buttons">
								<!-- LEFT MOUSE BUTTON (LMB) -->
								<div class="mouse-btn mouse-btn-main mouse-btn-left" id="btn-lmb">
									<span class="mb-label">LMB</span>
								</div>

								<!-- SCROLL WHEEL & MMB -->
								<div class="mouse-wheel-wrap">
									<div class="mouse-btn mouse-btn-wheel" id="btn-wheel">
										<span class="wheel-notch up" id="notch-up">
											<svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
												<polyline points="18 15 12 9 6 15"></polyline>
											</svg>
										</span>
										<span class="wheel-center"></span>
										<span class="wheel-notch down" id="notch-down">
											<svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
												<polyline points="6 9 12 15 18 9"></polyline>
											</svg>
										</span>
									</div>
								</div>

								<!-- RIGHT MOUSE BUTTON (RMB) -->
								<div class="mouse-btn mouse-btn-main mouse-btn-right" id="btn-rmb">
									<span class="mb-label">RMB</span>
								</div>
							</div>

							<!-- CLEAN PALM REST (SMOOTH SATIN FINISH) -->
							<div class="mouse-palm"></div>
						</div>
					</div>
				</div>
			</div>

			<!-- BUTTON & SCROLL TELEMETRY READOUTS -->
			<div class="metrics-row">
				<div class="metric-mini">
					<span class="m-label">Last Button</span>
					<div class="m-val-wrap">
						<span class="m-val mono" id="mouse-last-btn">--</span>
					</div>
					<span class="m-sub mono" id="mouse-btn-count">0 / 5 tested</span>
				</div>

				<div class="metric-mini">
					<span class="m-label">Scroll Delta</span>
					<div class="m-val-wrap">
						<span class="m-val mono" id="mouse-scroll-delta">--</span>
					</div>
					<span class="m-sub mono" id="mouse-scroll-total">0 total ticks</span>
				</div>

				<div class="metric-mini" title="Switch debounce threshold (30ms): Human fingers cannot click faster than ~70ms (~14 CPS). Successive click actuations under 30ms are physically impossible for humans and indicate microswitch contact bounce (worn leaf springs causing phantom double-clicks).">
					<span class="m-label">Switch Chatter</span>
					<div class="m-val-wrap">
						<span class="m-val mono" id="mouse-chatter-status">Clean</span>
					</div>
					<span class="m-sub mono" id="mouse-chatter-sub">0 bounces &lt; 30ms</span>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	function initInputLatencyLab() {
		// ==========================================
		// 1. UNIFIED MOUSE POLLING & REFLEX BENCHMARK
		// ==========================================
		const pollReflexBox = document.getElementById('poll-reflex-box');
		const reactionHeadline = document.getElementById('reaction-headline');
		const reactionSub = document.getElementById('reaction-sub');
		const tierBadgeEl = document.getElementById('poll-tier-badge');
		const canvas = document.getElementById('poll-sparkline') as HTMLCanvasElement | null;
		const ctx = canvas?.getContext('2d');

		// Telemetry Elements
		const pollCurrentHz = document.getElementById('poll-current-hz');
		const pollPeakSub = document.getElementById('poll-peak-sub');
		const reactionTimeVal = document.getElementById('reaction-time-val');
		const reactionBestSub = document.getElementById('reaction-best-sub');
		const pollStabilityVal = document.getElementById('poll-stability-val');

		// Polling State
		let peakHz = 0;
		let totalPackets = 0;
		let eventTimestamps: number[] = [];
		let intervalHistory: number[] = [];
		const SPARKLINE_POINTS = 60;
		let sparklineData: number[] = new Array(SPARKLINE_POINTS).fill(0);
		let decayTimer: any = null;
		let lastDomUpdateTime = 0;
		let lastGraphSampleTime = 0;

		// Reflex State
		type ReactionState = 'IDLE' | 'WAITING' | 'READY' | 'TOO_SOON' | 'RESULT';
		let reactionState: ReactionState = 'IDLE';
		let stateTimer: any = null;
		let greenTimestamp = 0;
		let reactionScores: number[] = [];
		let bestReflex = Infinity;

		function drawSparkline() {
			if (!ctx || !canvas) return;

			// Handle crisp HiDPI scaling
			const dpr = window.devicePixelRatio || 1;
			const rect = canvas.getBoundingClientRect();
			const w = rect.width || 460;
			const h = rect.height || 120;

			if (canvas.width !== Math.round(w * dpr) || canvas.height !== Math.round(h * dpr)) {
				canvas.width = Math.round(w * dpr);
				canvas.height = Math.round(h * dpr);
			}

			ctx.save();
			ctx.scale(dpr, dpr);
			ctx.clearRect(0, 0, w, h);

			// Soften canvas during active reflex test to avoid visual distraction
			if (reactionState === 'WAITING' || reactionState === 'READY' || reactionState === 'TOO_SOON') {
				ctx.globalAlpha = 0.12;
			} else {
				ctx.globalAlpha = 1.0;
			}

			// Right margin reserved for standard frequency guideline badges
			const labelMargin = 58;
			const plotW = Math.max(10, w - labelMargin);
			const yBaseline = h - 10;
			const yTop = 14;
			const usableH = yBaseline - yTop;

			// Determine dynamic scale ceiling based on observed peak
			let maxScale = 1200;
			if (peakHz > 4500) maxScale = 9000;
			else if (peakHz > 2200) maxScale = 4500;
			else if (peakHz > 1100) maxScale = 2200;
			else if (peakHz > 250) maxScale = 1200;
			else maxScale = 250;

			// Standard guideline tiers
			const standardTiers = maxScale === 9000
				? [8000, 4000, 1000]
				: (maxScale === 4500
					? [4000, 2000, 1000]
					: (maxScale === 2200
						? [2000, 1000, 500]
						: (maxScale === 1200
							? [1000, 500, 125]
							: [200, 125, 60])));

			// Draw standard tier guidelines and labels
			const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
			const gridColor = isDark ? 'rgba(255, 255, 255, 0.08)' : 'rgba(0, 0, 0, 0.07)';
			const textColor = isDark ? 'rgba(255, 255, 255, 0.35)' : 'rgba(0, 0, 0, 0.38)';

			ctx.font = '500 9px ui-monospace, SFMono-Regular, Menlo, monospace';
			ctx.textAlign = 'right';

			for (const tier of standardTiers) {
				const normTier = tier / maxScale;
				const tierY = yBaseline - normTier * usableH;

				ctx.strokeStyle = gridColor;
				ctx.lineWidth = 1;
				ctx.setLineDash([3, 4]);
				ctx.beginPath();
				ctx.moveTo(6, tierY);
				ctx.lineTo(plotW, tierY);
				ctx.stroke();
				ctx.setLineDash([]);

				ctx.fillStyle = textColor;
				ctx.fillText(`${tier} Hz`, w - 8, tierY + 3);
			}

			// Draw rolling oscilloscope waveform
			const len = sparklineData.length;
			if (len > 1) {
				ctx.beginPath();
				for (let i = 0; i < len; i++) {
					const x = (i / (len - 1)) * plotW;
					const norm = Math.min(1, Math.max(0, sparklineData[i] / maxScale));
					const y = yBaseline - norm * usableH;
					if (i === 0) ctx.moveTo(x, y);
					else ctx.lineTo(x, y);
				}

				// Stroke signal line
				ctx.strokeStyle = '#ff6b00';
				ctx.lineWidth = 2;
				ctx.lineJoin = 'round';
				ctx.lineCap = 'round';
				ctx.stroke();

				// Gradient fill under waveform
				ctx.lineTo(plotW, yBaseline);
				ctx.lineTo(0, yBaseline);
				ctx.closePath();
				const grad = ctx.createLinearGradient(0, yTop, 0, yBaseline);
				grad.addColorStop(0, isDark ? 'rgba(255, 107, 0, 0.25)' : 'rgba(234, 88, 12, 0.16)');
				grad.addColorStop(1, 'rgba(255, 107, 0, 0.0)');
				ctx.fillStyle = grad;
				ctx.fill();

				// Draw live oscilloscope tracer head at current leading edge
				const lastVal = sparklineData[len - 1];
				if (lastVal > 20) {
					const lastNorm = Math.min(1, Math.max(0, lastVal / maxScale));
					const headY = yBaseline - lastNorm * usableH;

					ctx.beginPath();
					ctx.arc(plotW, headY, 4.5, 0, Math.PI * 2);
					ctx.fillStyle = 'rgba(255, 107, 0, 0.35)';
					ctx.fill();

					ctx.beginPath();
					ctx.arc(plotW, headY, 2.5, 0, Math.PI * 2);
					ctx.fillStyle = '#ffffff';
					ctx.fill();
				}
			}

			ctx.restore();
		}

		function handlePointerMove(e: PointerEvent) {
			const events: PointerEvent[] = (typeof (e as any).getCoalescedEvents === 'function')
				? (e as any).getCoalescedEvents()
				: [e];

			const now = performance.now();

			for (const evt of events) {
				const t = (evt.timeStamp && evt.timeStamp > 0) ? evt.timeStamp : now;
				totalPackets++;

				if (eventTimestamps.length > 0) {
					const dt = t - eventTimestamps[eventTimestamps.length - 1];
					if (dt > 0.05 && dt < 80) {
						intervalHistory.push(dt);
						if (intervalHistory.length > 40) intervalHistory.shift();
					}
				}
				eventTimestamps.push(t);
				if (eventTimestamps.length > 50) eventTimestamps.shift();
			}

			if (intervalHistory.length >= 8) {
				const sorted = [...intervalHistory].sort((a, b) => a - b);
				// Trim fastest 20% and slowest 20% to reject OS/Bluetooth event delivery micro-bursts and pause turnarounds
				const trim = Math.floor(sorted.length * 0.2);
				const trimmed = sorted.slice(trim, sorted.length - trim);
				const medianDt = trimmed.length ? trimmed[Math.floor(trimmed.length / 2)] : sorted[Math.floor(sorted.length / 2)];
				const currentHz = Math.round(1000 / medianDt);

				// 1. Throttle text/DOM updates to every ~90ms (11 updates/sec)
				// Keeps the numeric readout stable, calm, and readable without rapid flickering
				if (now - lastDomUpdateTime >= 90) {
					lastDomUpdateTime = now;

					if (currentHz > 40 && currentHz < 12000) {
						if (pollCurrentHz) pollCurrentHz.textContent = `${currentHz}`;

						if (currentHz > peakHz) {
							peakHz = currentHz;
							if (pollPeakSub) pollPeakSub.textContent = `Peak: ${peakHz.toLocaleString()} Hz`;
						}

						const mean = trimmed.reduce((a, b) => a + b, 0) / trimmed.length;
						const variance = trimmed.reduce((a, b) => a + Math.pow(b - mean, 2), 0) / trimmed.length;
						const stdDev = Math.sqrt(variance);
						if (pollStabilityVal) pollStabilityVal.textContent = `\u00B1${stdDev.toFixed(1)}`;

						if (tierBadgeEl) {
							if (peakHz >= 3500) {
								tierBadgeEl.textContent = '8,000 Hz HID';
								tierBadgeEl.className = 'badge mono badge-orange';
							} else if (peakHz >= 850) {
								tierBadgeEl.textContent = '1,000 Hz HID';
								tierBadgeEl.className = 'badge mono badge-orange';
							} else if (peakHz >= 400) {
								tierBadgeEl.textContent = '500 Hz HID';
								tierBadgeEl.className = 'badge mono';
							} else if (peakHz >= 110) {
								tierBadgeEl.textContent = '125 Hz USB';
								tierBadgeEl.className = 'badge mono';
							} else {
								tierBadgeEl.textContent = `${peakHz} Hz`;
								tierBadgeEl.className = 'badge mono';
							}
						}
					}
				}

				// 2. Sample sparkline graph at ~45ms (~22 updates/sec)
				// 60 points * 45ms = ~2.7s of smooth, responsive visual history without feeling sluggish
				if (now - lastGraphSampleTime >= 45) {
					lastGraphSampleTime = now;
					const jitter = (Math.random() - 0.5) * Math.min(currentHz * 0.08, 12);
					const pointRate = Math.round(Math.max(30, currentHz + jitter));

					sparklineData.push(pointRate);
					if (sparklineData.length > SPARKLINE_POINTS) sparklineData.shift();
					drawSparkline();
				}
			}

			// 3. Zero-cost idle decay: after 180ms of no pointer movement, drop to 0 and go completely to sleep
			clearTimeout(decayTimer);
			decayTimer = setTimeout(() => {
				if (pollCurrentHz) pollCurrentHz.textContent = '0';
				sparklineData.push(0);
				if (sparklineData.length > SPARKLINE_POINTS) sparklineData.shift();
				drawSparkline();
			}, 180);
		}

		function startReactionTest() {
			reactionState = 'WAITING';
			if (pollReflexBox) pollReflexBox.className = 'poll-reflex-box waiting';
			if (reactionHeadline) reactionHeadline.textContent = 'Wait for green...';
			if (reactionSub) reactionSub.textContent = 'Do not click yet!';

			const randomDelay = 1500 + Math.random() * 2500;
			clearTimeout(stateTimer);
			stateTimer = setTimeout(() => {
				reactionState = 'READY';
				greenTimestamp = performance.now();
				if (pollReflexBox) pollReflexBox.className = 'poll-reflex-box ready';
				if (reactionHeadline) reactionHeadline.textContent = 'CLICK NOW!';
				if (reactionSub) reactionSub.textContent = 'Click as fast as you can';
			}, randomDelay);
		}

		if (pollReflexBox) {
			pollReflexBox.addEventListener('pointermove', handlePointerMove);
			pollReflexBox.addEventListener('pointerdown', (e: PointerEvent) => {
				const downTime = (e.timeStamp && e.timeStamp > 0) ? e.timeStamp : performance.now();

				if (reactionState === 'IDLE' || reactionState === 'RESULT' || reactionState === 'TOO_SOON') {
					startReactionTest();
				} else if (reactionState === 'WAITING') {
					clearTimeout(stateTimer);
					reactionState = 'TOO_SOON';
					if (pollReflexBox) pollReflexBox.className = 'poll-reflex-box too-soon';
					if (reactionHeadline) reactionHeadline.textContent = 'Too Soon!';
					if (reactionSub) reactionSub.textContent = 'Clicked before green. Click to retry.';
				} else if (reactionState === 'READY') {
					const reactionDelta = Math.max(1, Math.round(downTime - greenTimestamp));
					reactionState = 'RESULT';
					reactionScores.push(reactionDelta);
					if (reactionDelta < bestReflex) {
						bestReflex = reactionDelta;
					}
					if (reactionBestSub) {
						reactionBestSub.textContent = `Best: ${bestReflex} ms (${reactionScores.length} test${reactionScores.length === 1 ? '' : 's'})`;
					}

					if (reactionTimeVal) reactionTimeVal.textContent = `${reactionDelta}`;

					let rating = 'Nominal';
					if (reactionDelta < 185) rating = 'Ultra-Fast';
					else if (reactionDelta < 225) rating = 'Fast';
					else if (reactionDelta < 275) rating = 'Nominal';
					else rating = 'Extended';

					if (pollReflexBox) pollReflexBox.className = 'poll-reflex-box result';
					if (reactionHeadline) reactionHeadline.textContent = `${reactionDelta} ms (${rating})`;
					if (reactionSub) reactionSub.textContent = 'Click to test again';
				}
			});
		}

		// ==========================================
		// 3. MOUSE BUTTONS & SCROLL TESTER
		// ==========================================
		const btnZone = document.getElementById('mouse-btn-zone');
		const mouseBadge = document.getElementById('mouse-btns-badge');
		const lastBtnEl = document.getElementById('mouse-last-btn');
		const btnCountEl = document.getElementById('mouse-btn-count');
		const scrollDeltaEl = document.getElementById('mouse-scroll-delta');
		const scrollTotalEl = document.getElementById('mouse-scroll-total');
		const mouseChatterEl = document.getElementById('mouse-chatter-status');
		const mouseChatterSubEl = document.getElementById('mouse-chatter-sub');

		const lmbEl = document.getElementById('btn-lmb');
		const rmbEl = document.getElementById('btn-rmb');
		const wheelEl = document.getElementById('btn-wheel');
		const thumb1El = document.getElementById('btn-thumb1');
		const thumb2El = document.getElementById('btn-thumb2');
		const notchUpEl = document.getElementById('notch-up');
		const notchDownEl = document.getElementById('notch-down');

		const testedButtons = new Set<number>();
		let totalScrollTicks = 0;
		const lastClickTimePerButton = new Map<number, number>();
		let mouseChatterCount = 0;
		let wheelTimer: any = null;

		const activeTimers = new Map<HTMLElement, any>();
		const isButtonDown = new Map<number, boolean>();

		function activateButton(el: HTMLElement | null, btnId: number) {
			if (!el) return;
			isButtonDown.set(btnId, true);
			el.classList.add('btn-active');
			const existing = activeTimers.get(el);
			if (existing) {
				clearTimeout(existing);
				activeTimers.delete(el);
			}
		}

		function deactivateButton(el: HTMLElement | null, btnId: number) {
			if (!el) return;
			isButtonDown.set(btnId, false);
			const existing = activeTimers.get(el);
			if (existing) clearTimeout(existing);

			// Minimum 220ms visual flash so instantaneous clicks/microswitches are clearly seen before unlighting
			const timer = setTimeout(() => {
				if (!isButtonDown.get(btnId)) {
					el.classList.remove('btn-active');
				}
				activeTimers.delete(el);
			}, 220);
			activeTimers.set(el, timer);
		}

		function getButtonInfo(btn: number, target?: HTMLElement | null): { name: string; el: HTMLElement | null; id: number } {
			// Check if clicking directly on a specific visual button element
			if (target) {
				const thumb1 = target.closest('#btn-thumb1');
				if (thumb1) return { name: 'Back', el: thumb1El, id: 3 };
				const thumb2 = target.closest('#btn-thumb2');
				if (thumb2) return { name: 'Fwd', el: thumb2El, id: 4 };
				const wheel = target.closest('#btn-wheel');
				if (wheel && btn === 0) return { name: 'MMB', el: wheelEl, id: 1 };
				const rmb = target.closest('#btn-rmb');
				if (rmb && btn === 0) return { name: 'RMB', el: rmbEl, id: 2 };
				const lmb = target.closest('#btn-lmb');
				if (lmb && btn === 0) return { name: 'LMB', el: lmbEl, id: 0 };
			}

			switch (btn) {
				case 0: return { name: 'LMB', el: lmbEl, id: 0 };
				case 1: return { name: 'MMB', el: wheelEl, id: 1 };
				case 2: return { name: 'RMB', el: rmbEl, id: 2 };
				case 3: return { name: 'Back', el: thumb1El, id: 3 };
				case 4: return { name: 'Fwd', el: thumb2El, id: 4 };
				default: return { name: `Btn ${btn}`, el: null, id: btn };
			}
		}

		function onPointerDown(e: MouseEvent | PointerEvent) {
			e.preventDefault();
			const info = getButtonInfo(e.button, e.target as HTMLElement | null);
			const now = performance.now();

			// Double-click chatter detection (<30ms between successive clicks of same button)
			const prevTime = lastClickTimePerButton.get(info.id);
			if (prevTime && (now - prevTime) < 30) {
				mouseChatterCount++;
				if (mouseChatterEl) {
					mouseChatterEl.textContent = 'Warning';
					mouseChatterEl.style.color = '#ef4444';
				}
				if (mouseChatterSubEl) {
					mouseChatterSubEl.textContent = `${mouseChatterCount} bounce(s) on ${info.name} (${(now - prevTime).toFixed(1)}ms)`;
					mouseChatterSubEl.style.color = '#ef4444';
				}
			}
			lastClickTimePerButton.set(info.id, now);

			testedButtons.add(info.id);
			activateButton(info.el, info.id);

			if (lastBtnEl) lastBtnEl.textContent = info.name;
			if (btnCountEl) btnCountEl.textContent = `${testedButtons.size} / 5 tested`;
			if (mouseBadge) {
				mouseBadge.textContent = `${testedButtons.size} / 5 tested`;
				if (testedButtons.size === 5) {
					mouseBadge.className = 'badge mono badge-orange';
				}
			}
		}

		function onPointerUp(e: MouseEvent | PointerEvent) {
			e.preventDefault();
			const info = getButtonInfo(e.button, e.target as HTMLElement | null);
			deactivateButton(info.el, info.id);
		}
		function onWheel(e: WheelEvent) {
			e.preventDefault();
			totalScrollTicks++;
			const dir = e.deltaY < 0 ? '\u25B2 Up' : '\u25BC Down';
			const delta = Math.round(e.deltaY);

			if (e.deltaY < 0) {
				if (notchUpEl) {
					notchUpEl.classList.add('notch-active');
				}
				if (notchDownEl) notchDownEl.classList.remove('notch-active');
			} else if (e.deltaY > 0) {
				if (notchDownEl) {
					notchDownEl.classList.add('notch-active');
				}
				if (notchUpEl) notchUpEl.classList.remove('notch-active');
			}

			if (scrollDeltaEl) scrollDeltaEl.textContent = dir;
			if (scrollTotalEl) scrollTotalEl.textContent = `${delta > 0 ? '+' : ''}${delta}px ▪ ${totalScrollTicks} ticks`;

			clearTimeout(wheelTimer);
			wheelTimer = setTimeout(() => {
				if (notchUpEl) notchUpEl.classList.remove('notch-active');
				if (notchDownEl) notchDownEl.classList.remove('notch-active');
			}, 240);
		}

		if (btnZone) {
			btnZone.addEventListener('mousedown', onPointerDown);
			btnZone.addEventListener('mouseup', onPointerUp);
			btnZone.addEventListener('contextmenu', (e) => e.preventDefault());
			btnZone.addEventListener('auxclick', (e) => e.preventDefault());
			btnZone.addEventListener('wheel', onWheel, { passive: false });
		}

		// Ensure all buttons deactivate even if mouseup occurs outside btnZone or window blurs
		window.addEventListener('mouseup', (e: MouseEvent) => {
			const info = getButtonInfo(e.button, e.target as HTMLElement | null);
			deactivateButton(info.el, info.id);
		});
		window.addEventListener('blur', () => {
			isButtonDown.clear();
			activeTimers.forEach(t => clearTimeout(t));
			activeTimers.clear();
			[lmbEl, rmbEl, wheelEl, thumb1El, thumb2El].forEach(el => el?.classList.remove('btn-active'));
		});

		// Reset Button
		const resetBtn = document.getElementById('reset-input-lab-btn');
		if (resetBtn) {
			resetBtn.addEventListener('click', () => {
				peakHz = 0;
				totalPackets = 0;
				eventTimestamps = [];
				intervalHistory = [];
				sparklineData = new Array(SPARKLINE_POINTS).fill(0);
				clearTimeout(decayTimer);
				lastDomUpdateTime = 0;
				lastGraphSampleTime = 0;
				reactionScores = [];
				bestReflex = Infinity;
				clearTimeout(stateTimer);
				reactionState = 'IDLE';

				// Reset buttons & scroll state
				isButtonDown.clear();
				activeTimers.forEach(t => clearTimeout(t));
				activeTimers.clear();
				testedButtons.clear();
				totalScrollTicks = 0;
				lastClickTimePerButton.clear();
				mouseChatterCount = 0;
				[lmbEl, rmbEl, wheelEl, thumb1El, thumb2El].forEach(el => {
					if (el) el.classList.remove('btn-active');
				});
				if (notchUpEl) notchUpEl.classList.remove('notch-active');
				if (notchDownEl) notchDownEl.classList.remove('notch-active');
				if (lastBtnEl) lastBtnEl.textContent = '--';
				if (btnCountEl) btnCountEl.textContent = '0 / 5 tested';
				if (mouseBadge) {
					mouseBadge.textContent = '0 / 5 tested';
					mouseBadge.className = 'badge mono';
				}
				if (scrollDeltaEl) scrollDeltaEl.textContent = '--';
				if (scrollTotalEl) scrollTotalEl.textContent = '0 total ticks';
				if (mouseChatterEl) {
					mouseChatterEl.textContent = 'Clean';
					mouseChatterEl.style.color = '';
				}
				if (mouseChatterSubEl) {
					mouseChatterSubEl.textContent = '0 bounces < 30ms';
					mouseChatterSubEl.style.color = '';
				}

				if (pollCurrentHz) pollCurrentHz.textContent = '0';
				if (pollPeakSub) pollPeakSub.textContent = 'Peak: 0 Hz';
				if (pollStabilityVal) pollStabilityVal.textContent = '\u00B10.0';
				if (reactionTimeVal) reactionTimeVal.textContent = '--';
				if (reactionBestSub) reactionBestSub.textContent = 'Best: -- ms';
				if (tierBadgeEl) {
					tierBadgeEl.textContent = 'Idle';
					tierBadgeEl.className = 'badge mono';
				}
				if (pollReflexBox) pollReflexBox.className = 'poll-reflex-box idle';
				if (reactionHeadline) reactionHeadline.textContent = 'Click to Test Reflex';
				if (reactionSub) reactionSub.textContent = 'Move cursor rapidly to test polling';
				drawSparkline();
			});
		}

		drawSparkline();
		window.addEventListener('resize', drawSparkline);
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initInputLatencyLab);
	} else {
		initInputLatencyLab();
	}
</script>

