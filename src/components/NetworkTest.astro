---
// NetworkTest.astro - Real-time zero-host-bandwidth Cloudflare edge network benchmark
---

<section class="card section-accordion benchmark-card" id="lab" data-open="true">
	<div class="card-header-summary">
		<button type="button" class="card-summary-left card-summary-toggle" aria-expanded="true" aria-controls="network-lab-content">
			<span class="card-chevron-btn" aria-hidden="true">
				<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="6 9 12 15 18 9"/></svg>
			</span>
			<h2 class="card-title">
				<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" class="card-icon" aria-hidden="true">
					<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
				</svg>
				Network Test
			</h2>
			<span class="section-summary-badge">Anycast Ping · Jitter · Throughput</span>
		</button>
		<div class="card-summary-right">
			<button id="run-speedtest-btn" class="benchmark-btn" type="button" title="Start network benchmark" aria-label="Start network benchmark">
				<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" class="play-icon" id="btn-icon-play" aria-hidden="true">
					<polygon points="5 3 19 12 5 21 5 3"/>
				</svg>
				<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" class="play-icon hidden" id="btn-icon-stop" aria-hidden="true">
					<rect x="5" y="5" width="14" height="14" rx="2"/>
				</svg>
				<span id="speedtest-btn-text">Start</span>
			</button>
		</div>
	</div>

	<div class="section-content" id="network-lab-content">
		<p class="benchmark-desc">
			Measure real-time latency, jitter, packet loss, and sustained edge throughput directly against Cloudflare's Anycast network.
		</p>

		<!-- BENCHMARK TILES -->
		<div class="benchmark-tiles">
			<div class="b-tile">
				<span class="b-tile-label">Ping / Packet Loss</span>
				<div class="b-tile-value-wrap">
					<span id="speed-ping" class="b-tile-num mono">--</span>
					<span class="b-tile-unit">ms</span>
					<span class="loss-badge mono" id="speed-loss-badge" title="Drop rate across 16 sequential Anycast edge ping requests.">
						<span id="speed-loss">0</span>% loss
					</span>
				</div>
				<span class="b-tile-sub">
					<span id="speed-jitter">Jitter: -- ms</span> ▪ <span id="speed-loss-sub">0/16 lost</span>
				</span>
			</div>

			<div class="b-tile">
				<span class="b-tile-label">Download Speed</span>
				<div class="b-tile-value-wrap">
					<span id="speed-down" class="b-tile-num mono">--</span>
					<span id="speed-down-unit" class="b-tile-unit">Mbps</span>
				</div>
				<span id="speed-down-sub" class="b-tile-sub">Edge Throughput</span>
			</div>

			<div class="b-tile">
				<span class="b-tile-label">Upload Speed</span>
				<div class="b-tile-value-wrap">
					<span id="speed-up" class="b-tile-num mono">--</span>
					<span id="speed-up-unit" class="b-tile-unit">Mbps</span>
				</div>
				<span id="speed-up-sub" class="b-tile-sub">Return Pipeline</span>
			</div>

			<div class="b-tile">
				<span class="b-tile-label">Bufferbloat</span>
				<div class="b-tile-value-wrap">
					<span id="speed-bloat" class="b-tile-num mono">--</span>
					<span id="speed-bloat-unit" class="b-tile-unit">Grade</span>
				</div>
				<span id="speed-bloat-sub" class="b-tile-sub">Loaded Ping &Delta;</span>
			</div>
		</div>

		<!-- PROGRESS TRACK & LIVE STATUS -->
		<div class="benchmark-footer">
			<div class="progress-track" id="benchmark-progress-track">
				<div class="progress-bar" id="benchmark-progress-bar"></div>
			</div>
			<div class="status-wrap">
				<span id="speedtest-status" class="status-text" aria-live="polite">Click "Start" to measure real-time latency, jitter, packet loss, and sustained throughput.</span>
			</div>
		</div>
	</div>
</section>

<script>
	import { COLO_NAMES, getVisitorInfoCached } from '../lib/colo';
	import { escapeHtml } from '../lib/ui';

	let isBenchmarking = false;
	let benchmarkAbortCtrl: AbortController | null = null;

	const COLO_COORDS: Record<string, { lat: number; lon: number }> = {
		MIA: { lat: 25.7617, lon: -80.1918 },
		TPA: { lat: 27.9506, lon: -82.4572 },
		MCO: { lat: 28.5383, lon: -81.3792 },
		ATL: { lat: 33.7490, lon: -84.3880 },
		IAD: { lat: 38.9072, lon: -77.0369 },
		DCA: { lat: 38.9072, lon: -77.0369 },
		CLT: { lat: 35.2271, lon: -80.8431 },
		RDU: { lat: 35.7796, lon: -78.6382 },
		ORD: { lat: 41.8781, lon: -87.6298 },
		DFW: { lat: 32.7767, lon: -96.7970 },
		IAH: { lat: 29.7604, lon: -95.3698 },
		DEN: { lat: 39.7392, lon: -104.9903 },
		PHX: { lat: 33.4484, lon: -112.0740 },
		LAX: { lat: 34.0522, lon: -118.2437 },
		SFO: { lat: 37.7749, lon: -122.4194 },
		SJC: { lat: 37.3382, lon: -121.8863 },
		SEA: { lat: 47.6062, lon: -122.3321 },
		PDX: { lat: 45.5152, lon: -122.6784 },
		EWR: { lat: 40.7357, lon: -74.1724 },
		JFK: { lat: 40.7128, lon: -74.0060 },
		BOS: { lat: 42.3601, lon: -71.0589 },
		YYZ: { lat: 43.6532, lon: -79.3832 },
		LHR: { lat: 51.5074, lon: -0.1278 },
		FRA: { lat: 50.1109, lon: 8.6821 },
		AMS: { lat: 52.3676, lon: 4.9041 },
		NRT: { lat: 35.6762, lon: 139.6503 },
		SIN: { lat: 1.3521, lon: 103.8198 },
		SYD: { lat: -33.8688, lon: 151.2093 },
	};

	let clientLat = 0;
	let clientLon = 0;
	let detectedColo = '';
	let detectedCity = '';

	function getGreatCircleDistance(lat1: number, lon1: number, lat2: number, lon2: number) {
		const R = 6371; // Earth radius in km
		const dLat = (lat2 - lat1) * Math.PI / 180;
		const dLon = (lon2 - lon1) * Math.PI / 180;
		const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
		          Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
		          Math.sin(dLon/2) * Math.sin(dLon/2);
		const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
		return Math.round(R * c);
	}

	async function resolveEdgeDatacenter() {
		try {
			const data = await getVisitorInfoCached();
			if (data) {
				if (data.coloCode) {
					detectedColo = data.coloCode.toUpperCase();
					detectedCity = COLO_NAMES[detectedColo] || (data.city ? `${data.city}` : 'Edge Datacenter');
					updateColoTargetUI();
				}
				if (data.latitude && data.longitude) {
					clientLat = parseFloat(String(data.latitude));
					clientLon = parseFloat(String(data.longitude));
				}
			}
		} catch (_) {
			// Fallback to Anycast defaults
		}
	}

	function updateColoTargetUI(jitterVal?: string) {
		const jitterEl = document.getElementById('speed-jitter');
		if (jitterEl && jitterVal !== undefined) {
			jitterEl.textContent = `Jitter: ${jitterVal} ms`;
		}
	}

	async function runBenchmark() {
		if (isBenchmarking) {
			benchmarkAbortCtrl?.abort();
			return;
		}
		isBenchmarking = true;
		benchmarkAbortCtrl = new AbortController();
		const runSignal = benchmarkAbortCtrl.signal;

		const btn = document.getElementById('run-speedtest-btn') as HTMLButtonElement | null;
		const btnText = document.getElementById('speedtest-btn-text');
		const playIcon = document.getElementById('btn-icon-play');
		const stopIcon = document.getElementById('btn-icon-stop');
		const progressBar = document.getElementById('benchmark-progress-bar');
		const statusText = document.getElementById('speedtest-status');

		const pingEl = document.getElementById('speed-ping');
		const downEl = document.getElementById('speed-down');
		const downUnitEl = document.getElementById('speed-down-unit');
		const downSubEl = document.getElementById('speed-down-sub');
		const upEl = document.getElementById('speed-up');
		const upUnitEl = document.getElementById('speed-up-unit');
		const upSubEl = document.getElementById('speed-up-sub');
		const lossEl = document.getElementById('speed-loss');
		const lossSubEl = document.getElementById('speed-loss-sub');
		const lossBadge = document.getElementById('speed-loss-badge');
		const bloatEl = document.getElementById('speed-bloat');
		const bloatSubEl = document.getElementById('speed-bloat-sub');

		if (btn) {
			btn.setAttribute('aria-label', 'Stop network benchmark');
			btn.setAttribute('title', 'Stop network benchmark');
		}
		playIcon?.classList.add('hidden');
		stopIcon?.classList.remove('hidden');
		if (btnText) btnText.textContent = 'Stop';
		if (progressBar) progressBar.style.width = '5%';

		// Reset values
		if (pingEl) pingEl.textContent = '--';
		updateColoTargetUI('--');
		if (downEl) downEl.textContent = '--';
		if (downUnitEl) downUnitEl.style.display = '';
		if (downSubEl) downSubEl.textContent = 'Measuring...';
		if (upEl) upEl.textContent = '--';
		if (upUnitEl) upUnitEl.style.display = '';
		if (upSubEl) upSubEl.textContent = 'Queued';
		if (lossEl) lossEl.textContent = '--';
		if (lossSubEl) lossSubEl.textContent = 'Probing...';
		if (lossBadge) {
			lossBadge.classList.remove('loss-optimal', 'loss-warn');
			lossBadge.title = 'Measuring drop rate across sequential Anycast edge ping requests...';
		}
		if (bloatEl) {
			bloatEl.textContent = '--';
			bloatEl.style.color = '';
		}
		if (bloatSubEl) bloatSubEl.textContent = 'Queued';

		try {
			// ==========================================
			// STAGE 1: LATENCY, JITTER & PACKET LOSS (16 Probes)
			// ==========================================
			if (statusText) statusText.textContent = 'Transmitting 16 probes to analyze latency, jitter, and packet loss...';

			// Prefer Cloudflare's native edge-local /cdn-cgi/trace (zero Worker/SSR dispatch overhead)
			// and fall back to /api/ping on local dev or non-Cloudflare origins.
			// Using 1 warmup probe also primes TCP/TLS/HTTP2 before measuring latency & jitter.
			let pingEndpoint = '/api/ping';
			try {
				const warmCtrl = new AbortController();
				const warmTimer = setTimeout(() => warmCtrl.abort(), 1200);
				const traceRes = await fetch(`/cdn-cgi/trace?_w=${Date.now()}`, {
					signal: warmCtrl.signal,
					cache: 'no-store',
				});
				clearTimeout(warmTimer);
				if (traceRes.ok) {
					const traceText = await traceRes.text();
					if (traceText.includes('colo=')) {
						pingEndpoint = '/cdn-cgi/trace';
						if (!detectedColo) {
							const coloMatch = traceText.match(/colo=([A-Za-z0-9]+)/);
							if (coloMatch) {
								detectedColo = coloMatch[1].toUpperCase();
								detectedCity = COLO_NAMES[detectedColo] || 'Edge Datacenter';
							}
						}
					}
				}
			} catch (_) {
				// Fall back to /api/ping warmup below
			}
			if (pingEndpoint === '/api/ping') {
				try {
					const warmCtrl = new AbortController();
					const warmTimer = setTimeout(() => warmCtrl.abort(), 1200);
					await fetch(`/api/ping?_w=${Date.now()}`, { signal: warmCtrl.signal, cache: 'no-store' });
					clearTimeout(warmTimer);
				} catch (_) {
					// Ignore warmup failure; probes will record actual reachability
				}
			}

			const totalProbes = 16;
			let failed = 0;
			const pings: number[] = [];

			for (let i = 0; i < totalProbes; i++) {
				if (runSignal.aborted) break;
				const t0 = performance.now();
				try {
					const ctrl = new AbortController();
					const onCancel = () => ctrl.abort();
					runSignal.addEventListener('abort', onCancel, { once: true });
					const timeout = setTimeout(() => ctrl.abort(), 1200);
					const res = await fetch(`${pingEndpoint}?_p=${i}_${Date.now()}`, {
						signal: ctrl.signal,
						cache: 'no-store',
					});
					runSignal.removeEventListener('abort', onCancel);
					if (res.ok) {
						if (pingEndpoint === '/cdn-cgi/trace') {
							await res.text();
						}
						clearTimeout(timeout);
						const rtt = performance.now() - t0;
						pings.push(rtt);
						if (pingEl) pingEl.textContent = Math.round(rtt).toString();
					} else {
						clearTimeout(timeout);
						failed++;
					}
				} catch (_) {
					if (runSignal.aborted) break;
					failed++;
				}

				const currentLossRate = ((failed / (i + 1)) * 100).toFixed(0);
				if (lossEl) lossEl.textContent = currentLossRate;
				if (lossSubEl) lossSubEl.textContent = `${failed}/${i + 1} lost`;
				if (lossBadge) {
					lossBadge.title = `Drop rate across ${i + 1} sequential Anycast edge ping requests.`;
					if (failed > 0) {
						lossBadge.classList.add('loss-warn');
						lossBadge.classList.remove('loss-optimal');
					}
				}
				if (progressBar) progressBar.style.width = `${5 + Math.round(((i + 1) / totalProbes) * 25)}%`;
			}

			// Compute sequential jitter in arrival order BEFORE sorting for median
			let diffSum = 0;
			for (let i = 1; i < pings.length; i++) {
				diffSum += Math.abs(pings[i] - pings[i - 1]);
			}
			const sortedPings = [...pings].sort((a, b) => a - b);
			const hasPingBaseline = sortedPings.length > 0;
			const medianPing = hasPingBaseline ? Math.round(sortedPings[Math.floor(sortedPings.length / 2)]) : 0;
			const jitter = pings.length > 1 ? (diffSum / (pings.length - 1)).toFixed(1) : (hasPingBaseline ? '0.0' : '--');
			const finalLossRate = ((failed / totalProbes) * 100).toFixed(0);

			if (pingEl) pingEl.textContent = hasPingBaseline ? medianPing.toString() : '--';
			updateColoTargetUI(jitter);
			if (lossEl) lossEl.textContent = finalLossRate;
			if (lossSubEl) lossSubEl.textContent = `${failed}/${totalProbes} lost`;
			if (lossBadge) {
				lossBadge.title = `Drop rate across ${totalProbes} sequential Anycast edge ping requests.`;
				if (failed === 0) {
					lossBadge.classList.add('loss-optimal');
					lossBadge.classList.remove('loss-warn');
				} else {
					lossBadge.classList.add('loss-warn');
					lossBadge.classList.remove('loss-optimal');
				}
			}

			if (runSignal.aborted) {
				if (statusText) statusText.textContent = 'Network benchmark cancelled.';
				if (progressBar) progressBar.style.width = '0%';
				return;
			}

			// ==========================================
			// STAGE 2: MULTI-STREAM SUSTAINED DOWNLOAD (3s)
			// ==========================================
			if (statusText) statusText.textContent = 'Streaming multi-connection download to measure sustained wire speed...';
			if (progressBar) progressBar.style.width = '30%';

			const downDurationSec = 3.0;
			const downStreams = 4;
			const chunkSize = 25000000; // 25MB per request
			const downControllers: AbortController[] = [];
			const downBloatControllers: AbortController[] = [];
			const downLoadedPings: number[] = [];
			const upLoadedPings: number[] = [];
			if (bloatSubEl) bloatSubEl.textContent = 'Probing queue...';

			let downTotalBytes = 0;
			let downSteadyBytes = 0;
			let downSteadyStartTime = 0;
			const d0 = performance.now();
			const downWarmupMs = 500;
			let isDownDone = false;

			const downTicker = setInterval(() => {
				const now = performance.now();
				const elapsedTotal = (now - d0) / 1000;
				if (downSteadyStartTime > 0 && now - downSteadyStartTime > 150) {
					const steadyElapsed = (now - downSteadyStartTime) / 1000;
					const curMbps = (downSteadyBytes * 8) / (steadyElapsed * 1_000_000);
					if (downEl) downEl.textContent = curMbps.toFixed(1);
				}
				const progressPct = 30 + Math.min(35, (elapsedTotal / downDurationSec) * 35);
				if (progressBar) progressBar.style.width = `${progressPct.toFixed(0)}%`;
			}, 80);

			// Background loaded ping probe loop during download
			const downBloatInterval = setInterval(async () => {
				if (isDownDone) return;
				const ctrl = new AbortController();
				downBloatControllers.push(ctrl);
				const timer = setTimeout(() => ctrl.abort(), 1200);
				const t0 = performance.now();
				try {
					const res = await fetch(`${pingEndpoint}?_bld=${Date.now()}`, { signal: ctrl.signal, cache: 'no-store' });
					if (res.ok && !isDownDone) {
						if (pingEndpoint === '/cdn-cgi/trace') await res.text();
						downLoadedPings.push(performance.now() - t0);
					}
				} catch (_) {
				} finally {
					clearTimeout(timer);
				}
			}, 350);

			const runDownWorker = async (streamId: number) => {
				while (!isDownDone && (performance.now() - d0) / 1000 < downDurationSec) {
					const ctrl = new AbortController();
					downControllers.push(ctrl);
					try {
						const res = await fetch(`https://speed.cloudflare.com/__down?bytes=${chunkSize}&_s=${streamId}_${Date.now()}`, {
							signal: ctrl.signal,
							cache: 'no-store',
						});
						if (res.body) {
							const reader = res.body.getReader();
							while (true) {
								const { done, value } = await reader.read();
								if (done) break;
								if (value) {
									const now = performance.now();
									downTotalBytes += value.length;
									if (now - d0 > downWarmupMs) {
										if (downSteadyStartTime === 0) downSteadyStartTime = now;
										downSteadyBytes += value.length;
									}
									if ((now - d0) / 1000 >= downDurationSec) {
										isDownDone = true;
										downControllers.forEach(c => {
											try { c.abort(); } catch (_) {}
										});
										break;
									}
								}
							}
						}
					} catch (_) {
						// Expected on abort
					}
				}
			};

			const abortAllDown = () => {
				isDownDone = true;
				downControllers.forEach(c => { try { c.abort(); } catch (_) {} });
				downBloatControllers.forEach(c => { try { c.abort(); } catch (_) {} });
			};
			runSignal.addEventListener('abort', abortAllDown, { once: true });

			const downTimeout = setTimeout(abortAllDown, (downDurationSec + 0.15) * 1000);

			await Promise.allSettled(Array.from({ length: downStreams }, (_, i) => runDownWorker(i)));
			isDownDone = true;
			runSignal.removeEventListener('abort', abortAllDown);
			clearTimeout(downTimeout);
			clearInterval(downTicker);
			clearInterval(downBloatInterval);
			downBloatControllers.forEach(c => { try { c.abort(); } catch (_) {} });

			if (runSignal.aborted) {
				if (statusText) statusText.textContent = 'Network benchmark cancelled.';
				if (progressBar) progressBar.style.width = '0%';
				return;
			}

			const downBytesToCount = downSteadyBytes > 0 ? downSteadyBytes : downTotalBytes;
			const finalDownElapsed =
				downSteadyBytes > 0 && downSteadyStartTime > 0
					? (performance.now() - downSteadyStartTime) / 1000
					: (performance.now() - d0) / 1000;
			const finalDownMbps = (downBytesToCount * 8) / (Math.max(finalDownElapsed, 0.001) * 1_000_000);
			if (downTotalBytes === 0) {
				if (downEl) downEl.textContent = 'Blocked';
				if (downUnitEl) downUnitEl.style.display = 'none';
				if (downSubEl) downSubEl.textContent = 'speed.cloudflare.com unreachable';
			} else {
				if (downEl) downEl.textContent = finalDownMbps.toFixed(1);
				if (downUnitEl) downUnitEl.style.display = '';
				const downSecDisplay = Math.max(1, Math.round((performance.now() - d0) / 1000));
				if (downSubEl) downSubEl.textContent = `Sustained (${(downTotalBytes / (1024 * 1024)).toFixed(1)} MB / ${downSecDisplay}s)`;
			}
			if (progressBar) progressBar.style.width = '65%';

			// ==========================================
			// STAGE 3: MULTI-STREAM SUSTAINED UPLOAD (3s, adaptive chunks)
			// ==========================================
			if (statusText) statusText.textContent = 'Saturating return pipeline with multi-stream upstream channels...';
			if (upSubEl) upSubEl.textContent = 'Measuring...';

			const upDurationSec = 3.0;
			const upStreams = 4;
			const maxUpChunkSize = 2 * 1024 * 1024; // 2MB max chunk
			const upMaxBuf = new Uint8Array(maxUpChunkSize);
			// Populate with non-zero pseudo-random pattern once to avoid proxy/tunnel zero-compression skew
			for (let i = 0; i < upMaxBuf.length; i += 64) {
				upMaxBuf[i] = (i * 131 + 17) & 0xff;
			}
			const upControllers: AbortController[] = [];
			const upBloatControllers: AbortController[] = [];

			let upTotalBytes = 0;
			let upSteadyBytes = 0;
			let upSteadyStartTime = 0;
			const u0 = performance.now();
			const upWarmupMs = 500;
			let isUpDone = false;

			const upTicker = setInterval(() => {
				const now = performance.now();
				const elapsedTotal = (now - u0) / 1000;
				const activeBytes = upSteadyBytes > 0 ? upSteadyBytes : upTotalBytes;
				const activeElapsed =
					upSteadyBytes > 0 && upSteadyStartTime > 0
						? (now - upSteadyStartTime) / 1000
						: elapsedTotal;
				if (activeElapsed > 0.15 && activeBytes > 0) {
					const curMbps = (activeBytes * 8) / (activeElapsed * 1_000_000);
					if (upEl) upEl.textContent = curMbps.toFixed(1);
				}
				const progressPct = 65 + Math.min(35, (elapsedTotal / upDurationSec) * 35);
				if (progressBar) progressBar.style.width = `${progressPct.toFixed(0)}%`;
			}, 80);

			// Background loaded ping probe loop during upload
			const upBloatInterval = setInterval(async () => {
				if (isUpDone) return;
				const ctrl = new AbortController();
				upBloatControllers.push(ctrl);
				const timer = setTimeout(() => ctrl.abort(), 1200);
				const t0 = performance.now();
				try {
					const res = await fetch(`${pingEndpoint}?_blu=${Date.now()}`, { signal: ctrl.signal, cache: 'no-store' });
					if (res.ok && !isUpDone) {
						if (pingEndpoint === '/cdn-cgi/trace') await res.text();
						upLoadedPings.push(performance.now() - t0);
					}
				} catch (_) {
				} finally {
					clearTimeout(timer);
				}
			}, 350);

			const runUpWorker = async (workerId: number) => {
				// Start with 256 KB so slow links (<8 Mbps) complete quickly, then ramp up to 2 MB
				let chunkSize = 256 * 1024;
				while (!isUpDone && (performance.now() - u0) / 1000 < upDurationSec) {
					const ctrl = new AbortController();
					upControllers.push(ctrl);
					const reqStart = performance.now();
					const payload = upMaxBuf.subarray(0, chunkSize);
					try {
						const res = await fetch(`https://speed.cloudflare.com/__up?_u=${workerId}_${Date.now()}`, {
							method: 'POST',
							body: payload,
							headers: { 'Content-Type': 'application/octet-stream' },
							signal: ctrl.signal,
						});
						if (res.ok) {
							const doneNow = performance.now();
							upTotalBytes += chunkSize;
							if (doneNow - u0 > upWarmupMs) {
								if (upSteadyStartTime === 0) {
									upSteadyStartTime = Math.max(reqStart, u0 + upWarmupMs);
								}
								upSteadyBytes += chunkSize;
							}
							const reqMs = doneNow - reqStart;
							if (reqMs < 250 && chunkSize < maxUpChunkSize) {
								chunkSize = Math.min(maxUpChunkSize, chunkSize * 2);
							}
						}
					} catch (_) {
						// Expected on abort
					}
				}
			};

			const abortAllUp = () => {
				isUpDone = true;
				upControllers.forEach(c => { try { c.abort(); } catch (_) {} });
				upBloatControllers.forEach(c => { try { c.abort(); } catch (_) {} });
			};
			runSignal.addEventListener('abort', abortAllUp, { once: true });

			const upTimeout = setTimeout(abortAllUp, (upDurationSec + 0.15) * 1000);

			await Promise.allSettled(Array.from({ length: upStreams }, (_, i) => runUpWorker(i)));
			isUpDone = true;
			runSignal.removeEventListener('abort', abortAllUp);
			clearTimeout(upTimeout);
			clearInterval(upTicker);
			clearInterval(upBloatInterval);
			upBloatControllers.forEach(c => { try { c.abort(); } catch (_) {} });

			if (runSignal.aborted) {
				if (statusText) statusText.textContent = 'Network benchmark cancelled.';
				if (progressBar) progressBar.style.width = '0%';
				return;
			}

			const upBytesToCount = upSteadyBytes > 0 ? upSteadyBytes : upTotalBytes;
			const finalUpElapsed =
				upSteadyBytes > 0 && upSteadyStartTime > 0
					? (performance.now() - upSteadyStartTime) / 1000
					: (performance.now() - u0) / 1000;
			const finalUpMbps = (upBytesToCount * 8) / (Math.max(finalUpElapsed, 0.001) * 1_000_000);
			if (upTotalBytes === 0) {
				if (upEl) upEl.textContent = 'Blocked';
				if (upUnitEl) upUnitEl.style.display = 'none';
				if (upSubEl) upSubEl.textContent = 'speed.cloudflare.com unreachable';
			} else {
				if (upEl) upEl.textContent = finalUpMbps > 0 ? finalUpMbps.toFixed(1) : '--';
				if (upUnitEl) upUnitEl.style.display = '';
				const upSecDisplay = Math.max(1, Math.round((performance.now() - u0) / 1000));
				if (upSubEl) upSubEl.textContent = `Sustained (${(upTotalBytes / (1024 * 1024)).toFixed(1)} MB / ${upSecDisplay}s)`;
			}

			// ==========================================
			// STAGE 4: BUFFERBLOAT & FIBER OPTIC METRICS
			// ==========================================
			const calcMedian = (arr: number[], fallback: number) => {
				if (!arr.length) return fallback;
				const sorted = [...arr].sort((a, b) => a - b);
				return Math.round(sorted[Math.floor(sorted.length / 2)]);
			};

			if (!hasPingBaseline) {
				if (bloatEl) {
					bloatEl.textContent = '--';
					bloatEl.style.color = '';
				}
				if (bloatSubEl) bloatSubEl.textContent = 'Offline / no ping baseline';
			} else {
				const allLoaded = [...downLoadedPings, ...upLoadedPings];
				const medianLoaded = calcMedian(allLoaded, medianPing);
				const downDelta = Math.max(0, calcMedian(downLoadedPings, medianPing) - medianPing);
				const upDelta = Math.max(0, calcMedian(upLoadedPings, medianPing) - medianPing);
				const bloatDelta = Math.max(0, medianLoaded - medianPing);
				let grade = 'A+';
				let gradeColor = 'rgb(34, 197, 94)';
				if (bloatDelta > 75) { grade = 'D'; gradeColor = 'rgb(239, 68, 68)'; }
				else if (bloatDelta > 40) { grade = 'C'; gradeColor = 'rgb(245, 158, 11)'; }
				else if (bloatDelta > 20) { grade = 'B'; gradeColor = 'rgb(56, 189, 248)'; }
				else if (bloatDelta > 6) { grade = 'A'; gradeColor = 'rgb(34, 197, 94)'; }

				if (bloatEl) {
					bloatEl.textContent = grade;
					bloatEl.style.color = gradeColor;
				}
				if (bloatSubEl) {
					bloatSubEl.textContent = `DL +${downDelta} ms ▪ UL +${upDelta} ms`;
				}
			}

			// Physics: Great-circle distance & speed of light in optical glass (c_glass ~ 204 km/ms)
			let distanceKm = 0;
			let fiberRttMs = '0';
			const coloCoord = detectedColo ? COLO_COORDS[detectedColo] : undefined;
			if (coloCoord && clientLat && clientLon) {
				distanceKm = getGreatCircleDistance(clientLat, clientLon, coloCoord.lat, coloCoord.lon);
				fiberRttMs = Math.max(0.1, (2 * distanceKm) / 204).toFixed(1);
			}

			if (progressBar) progressBar.style.width = '100%';
			if (!hasPingBaseline && downTotalBytes === 0 && upTotalBytes === 0) {
				if (statusText) statusText.innerHTML = '<span style="color: rgb(239, 68, 68); font-weight: 600;">Offline:</span> Unable to reach Cloudflare edge endpoints.';
			} else if (downTotalBytes === 0 && upTotalBytes === 0) {
				if (statusText) statusText.innerHTML = '<span style="color: rgb(239, 68, 68); font-weight: 600;">Notice:</span> speed.cloudflare.com throughput test blocked by ad-blocker or firewall policy. Edge ping &amp; latency succeeded.';
			} else if (upTotalBytes === 0) {
				if (statusText) statusText.innerHTML = '<span style="color: rgb(245, 158, 11); font-weight: 600;">Partial:</span> Download measured, but upload endpoint timed out or was blocked.';
			} else {
				const targetSummary = detectedColo
					? ` via Cloudflare ${escapeHtml(detectedColo)} Edge (${escapeHtml(detectedCity)})`
					: ' via Cloudflare Anycast';
				const physicsSummary = distanceKm > 0 ? ` ▪ ~${distanceKm} km (fiber limit: ~${fiberRttMs} ms RTT)` : '';
				if (statusText) statusText.innerHTML = `Test complete${targetSummary}${physicsSummary}.`;
			}

		} catch (err: any) {
			console.error('Speedtest encountered error:', err);
			if (statusText) statusText.textContent = 'Test interrupted or blocked by browser extensions.';
		} finally {
			isBenchmarking = false;
			benchmarkAbortCtrl = null;
			if (btn) {
				btn.setAttribute('aria-label', 'Start network benchmark');
				btn.setAttribute('title', 'Start network benchmark');
			}
			playIcon?.classList.remove('hidden');
			stopIcon?.classList.add('hidden');
			if (btnText) btnText.textContent = 'Start';
		}
	}

	function setupBenchmarkBtn() {
		const labEl = document.getElementById('lab');
		const btn = document.getElementById('run-speedtest-btn');
		if (!labEl || !btn || labEl.dataset.bound === '1') return;
		labEl.dataset.bound = '1';
		btn.addEventListener('click', runBenchmark);
		resolveEdgeDatacenter();
	}

	setupBenchmarkBtn();
	document.addEventListener('astro:page-load', setupBenchmarkBtn);
</script>

