---
// NetworkTest.astro - Real-time zero-host-bandwidth Cloudflare edge network benchmark
---

<section class="card benchmark-card" id="lab">
	<a id="benchmark" style="display:none;" aria-hidden="true"></a>
	<div class="benchmark-header">
		<h2 class="card-title">
			<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" class="card-icon">
				<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
			</svg>
			Network Test
		</h2>
		<button id="run-speedtest-btn" class="benchmark-btn" type="button" aria-label="Run Network Test">
			<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" class="play-icon" id="btn-icon-play">
				<polygon points="5 3 19 12 5 21 5 3"/>
			</svg>
			<span id="speedtest-btn-text">Run Test</span>
		</button>
	</div>

	<p class="benchmark-desc">
		Measure real-time latency, jitter, packet loss, and sustained edge throughput directly against Cloudflare's Anycast network.
	</p>

	<!-- BENCHMARK TILES -->
	<div class="benchmark-tiles">
		<div class="b-tile">
			<span class="b-tile-label">Ping / Packet Loss</span>
			<div class="b-tile-value-wrap">
				<span id="speed-ping" class="b-tile-num mono">--</span>
				<span class="b-tile-unit">ms</span>
				<span class="loss-badge mono" id="speed-loss-badge" title="Drop rate across 16 sequential HTTP 204 Anycast edge ping requests.">
					<span id="speed-loss">0</span>% loss
				</span>
			</div>
			<span class="b-tile-sub">
				<span id="speed-jitter">Jitter: -- ms</span> &bull; <span id="speed-loss-sub">0/16 lost</span>
			</span>
		</div>

		<div class="b-tile">
			<span class="b-tile-label">Download Speed</span>
			<div class="b-tile-value-wrap">
				<span id="speed-down" class="b-tile-num mono">--</span>
				<span class="b-tile-unit">Mbps</span>
			</div>
			<span id="speed-down-sub" class="b-tile-sub">Edge Throughput</span>
		</div>

		<div class="b-tile">
			<span class="b-tile-label">Upload Speed</span>
			<div class="b-tile-value-wrap">
				<span id="speed-up" class="b-tile-num mono">--</span>
				<span class="b-tile-unit">Mbps</span>
			</div>
			<span id="speed-up-sub" class="b-tile-sub">Return Pipeline</span>
		</div>

		<div class="b-tile">
			<span class="b-tile-label">Bufferbloat</span>
			<div class="b-tile-value-wrap">
				<span id="speed-bloat" class="b-tile-num mono">--</span>
				<span id="speed-bloat-unit" class="b-tile-unit">Grade</span>
			</div>
			<span id="speed-bloat-sub" class="b-tile-sub">Loaded Ping &Delta;</span>
		</div>
	</div>

	<!-- PROGRESS TRACK & LIVE STATUS -->
	<div class="benchmark-footer">
		<div class="progress-track" id="benchmark-progress-track">
			<div class="progress-bar" id="benchmark-progress-bar"></div>
		</div>
		<div class="status-wrap">
			<span id="speedtest-status" class="status-text">Click "Run Test" to measure real-time latency, jitter, packet loss, and sustained throughput.</span>
		</div>
	</div>
</section>

<script>
	let isBenchmarking = false;

	const COLO_MAP: Record<string, string> = {
		MIA: 'Miami, FL',
		TPA: 'Tampa, FL',
		MCO: 'Orlando, FL',
		ATL: 'Atlanta, GA',
		IAD: 'Ashburn, VA',
		DCA: 'Washington, DC',
		CLT: 'Charlotte, NC',
		RDU: 'Raleigh, NC',
		ORD: 'Chicago, IL',
		DFW: 'Dallas, TX',
		IAH: 'Houston, TX',
		DEN: 'Denver, CO',
		PHX: 'Phoenix, AZ',
		LAX: 'Los Angeles, CA',
		SFO: 'San Francisco, CA',
		SJC: 'San Jose, CA',
		SEA: 'Seattle, WA',
		PDX: 'Portland, OR',
		EWR: 'Newark, NJ',
		JFK: 'New York, NY',
		BOS: 'Boston, MA',
		YYZ: 'Toronto, ON',
		LHR: 'London, UK',
		FRA: 'Frankfurt, DE',
		AMS: 'Amsterdam, NL',
		NRT: 'Tokyo, JP',
		SIN: 'Singapore',
		SYD: 'Sydney, AU',
	};

	const COLO_COORDS: Record<string, { lat: number; lon: number }> = {
		MIA: { lat: 25.7617, lon: -80.1918 },
		TPA: { lat: 27.9506, lon: -82.4572 },
		MCO: { lat: 28.5383, lon: -81.3792 },
		ATL: { lat: 33.7490, lon: -84.3880 },
		IAD: { lat: 38.9072, lon: -77.0369 },
		DCA: { lat: 38.9072, lon: -77.0369 },
		CLT: { lat: 35.2271, lon: -80.8431 },
		RDU: { lat: 35.7796, lon: -78.6382 },
		ORD: { lat: 41.8781, lon: -87.6298 },
		DFW: { lat: 32.7767, lon: -96.7970 },
		IAH: { lat: 29.7604, lon: -95.3698 },
		DEN: { lat: 39.7392, lon: -104.9903 },
		PHX: { lat: 33.4484, lon: -112.0740 },
		LAX: { lat: 34.0522, lon: -118.2437 },
		SFO: { lat: 37.7749, lon: -122.4194 },
		SJC: { lat: 37.3382, lon: -121.8863 },
		SEA: { lat: 47.6062, lon: -122.3321 },
		PDX: { lat: 45.5152, lon: -122.6784 },
		EWR: { lat: 40.7357, lon: -74.1724 },
		JFK: { lat: 40.7128, lon: -74.0060 },
		BOS: { lat: 42.3601, lon: -71.0589 },
		YYZ: { lat: 43.6532, lon: -79.3832 },
		LHR: { lat: 51.5074, lon: -0.1278 },
		FRA: { lat: 50.1109, lon: 8.6821 },
		AMS: { lat: 52.3676, lon: 4.9041 },
		NRT: { lat: 35.6762, lon: 139.6503 },
		SIN: { lat: 1.3521, lon: 103.8198 },
		SYD: { lat: -33.8688, lon: 151.2093 },
	};

	let clientLat = 0;
	let clientLon = 0;
	let detectedColo = 'MIA';
	let detectedCity = 'Miami, FL';

	function getGreatCircleDistance(lat1: number, lon1: number, lat2: number, lon2: number) {
		const R = 6371; // Earth radius in km
		const dLat = (lat2 - lat1) * Math.PI / 180;
		const dLon = (lon2 - lon1) * Math.PI / 180;
		const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
		          Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
		          Math.sin(dLon/2) * Math.sin(dLon/2);
		const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
		return Math.round(R * c);
	}

	async function resolveEdgeDatacenter() {
		try {
			const win = window as any;
			if (!win.__visitorInfoPromise) {
				win.__visitorInfoPromise = fetch('/api/visitor-info', { cache: 'no-store' })
					.then((res) => (res.ok ? res.json() : null))
					.catch(() => null);
			}
			const data = await win.__visitorInfoPromise;
			if (data) {
				if (data.coloCode) {
					detectedColo = data.coloCode.toUpperCase();
					detectedCity = COLO_MAP[detectedColo] || (data.city ? `${data.city}` : 'Edge Datacenter');
					updateColoTargetUI();
				}
				if (data.latitude && data.longitude) {
					clientLat = parseFloat(data.latitude);
					clientLon = parseFloat(data.longitude);
				}
			}
		} catch (_) {
			// Fallback to Anycast defaults
		}
	}

	function updateColoTargetUI(jitterVal?: string) {
		const jitterEl = document.getElementById('speed-jitter');
		if (jitterEl && jitterVal !== undefined) {
			jitterEl.textContent = `Jitter: ${jitterVal} ms`;
		}
	}

	async function runBenchmark() {
		if (isBenchmarking) return;
		isBenchmarking = true;

		const btn = document.getElementById('run-speedtest-btn') as HTMLButtonElement | null;
		const btnText = document.getElementById('speedtest-btn-text');
		const progressBar = document.getElementById('benchmark-progress-bar');
		const statusText = document.getElementById('speedtest-status');

		const pingEl = document.getElementById('speed-ping');
		const downEl = document.getElementById('speed-down');
		const downSubEl = document.getElementById('speed-down-sub');
		const upEl = document.getElementById('speed-up');
		const upSubEl = document.getElementById('speed-up-sub');
		const lossEl = document.getElementById('speed-loss');
		const lossSubEl = document.getElementById('speed-loss-sub');
		const lossBadge = document.getElementById('speed-loss-badge');
		const bloatEl = document.getElementById('speed-bloat');
		const bloatSubEl = document.getElementById('speed-bloat-sub');

		if (btn) btn.disabled = true;
		if (btnText) btnText.textContent = 'Testing...';
		if (progressBar) progressBar.style.width = '5%';

		// Reset values
		if (pingEl) pingEl.textContent = '--';
		updateColoTargetUI('--');
		if (downEl) downEl.textContent = '--';
		if (downSubEl) downSubEl.textContent = 'Measuring...';
		if (upEl) upEl.textContent = '--';
		if (upSubEl) upSubEl.textContent = 'Queued';
		if (lossEl) lossEl.textContent = '--';
		if (lossSubEl) lossSubEl.textContent = 'Probing...';
		if (lossBadge) {
			lossBadge.classList.remove('loss-optimal', 'loss-warn');
			lossBadge.title = 'Measuring drop rate across sequential HTTP 204 edge ping requests...';
		}
		if (bloatEl) {
			bloatEl.textContent = '--';
			bloatEl.style.color = '';
		}
		if (bloatSubEl) bloatSubEl.textContent = 'Queued';

		try {
			// ==========================================
			// STAGE 1: LATENCY, JITTER & PACKET LOSS (16 Probes)
			// ==========================================
			if (statusText) statusText.textContent = 'Transmitting 16 probes to analyze latency, jitter, and packet loss...';

			const totalProbes = 16;
			let successful = 0;
			let failed = 0;
			let tcpLostTotal = 0;
			const pings: number[] = [];

			for (let i = 0; i < totalProbes; i++) {
				const t0 = performance.now();
				try {
					const ctrl = new AbortController();
					const timeout = setTimeout(() => ctrl.abort(), 1200);
					const res = await fetch(`/api/ping?_p=${i}_${Date.now()}`, {
						signal: ctrl.signal,
						cache: 'no-store',
					});
					clearTimeout(timeout);
					if (res.ok) {
						successful++;
						const rtt = performance.now() - t0;
						pings.push(rtt);
						if (pingEl) pingEl.textContent = Math.round(rtt).toString();

						const timing = res.headers.get('server-timing') || '';
						const lostMatch = timing.match(/lost=(\d+)/);
						if (lostMatch) {
							tcpLostTotal += parseInt(lostMatch[1], 10);
						}
					} else {
						failed++;
					}
				} catch (_) {
					failed++;
				}

				const currentLost = failed + tcpLostTotal;
				const currentLossRate = ((currentLost / (i + 1)) * 100).toFixed(0);
				if (lossEl) lossEl.textContent = currentLossRate;
				if (lossSubEl) lossSubEl.textContent = `${currentLost}/${i + 1} lost`;
				if (lossBadge) {
					lossBadge.title = `Drop rate across ${i + 1} sequential HTTP 204 Anycast edge ping requests.`;
					if (currentLost > 0) {
						lossBadge.classList.add('loss-warn');
						lossBadge.classList.remove('loss-optimal');
					}
				}
				if (progressBar) progressBar.style.width = `${5 + Math.round(((i + 1) / totalProbes) * 25)}%`;
			}

			// Finalize latency, jitter, loss
			pings.sort((a, b) => a - b);
			const medianPing = pings.length ? Math.round(pings[Math.floor(pings.length / 2)]) : 0;
			let diffSum = 0;
			for (let i = 1; i < pings.length; i++) {
				diffSum += Math.abs(pings[i] - pings[i - 1]);
			}
			const jitter = pings.length > 1 ? (diffSum / (pings.length - 1)).toFixed(1) : '0.0';
			const finalLost = failed + tcpLostTotal;
			const finalLossRate = ((finalLost / totalProbes) * 100).toFixed(0);

			if (pingEl) pingEl.textContent = medianPing.toString();
			updateColoTargetUI(jitter);
			if (lossEl) lossEl.textContent = finalLossRate;
			if (lossSubEl) lossSubEl.textContent = `${finalLost}/${totalProbes} lost`;
			if (lossBadge) {
				lossBadge.title = `Drop rate across ${totalProbes} sequential HTTP 204 Anycast edge ping requests.`;
				if (finalLost === 0) {
					lossBadge.classList.add('loss-optimal');
					lossBadge.classList.remove('loss-warn');
				} else {
					lossBadge.classList.add('loss-warn');
					lossBadge.classList.remove('loss-optimal');
				}
			}

			// ==========================================
			// STAGE 2: MULTI-STREAM SUSTAINED DOWNLOAD (3s)
			// ==========================================
			if (statusText) statusText.textContent = 'Streaming multi-connection download to measure sustained wire speed...';
			if (progressBar) progressBar.style.width = '25%';

			const downDurationSec = 3.0;
			const downStreams = 4;
			const chunkSize = 25000000; // 25MB per request
			const downControllers: AbortController[] = [];
			const loadedPings: number[] = [];
			if (bloatSubEl) bloatSubEl.textContent = 'Probing queue...';

			let downTotalBytes = 0;
			let downSteadyBytes = 0;
			let downSteadyStartTime = 0;
			const d0 = performance.now();
			const downWarmupMs = 500; // Discard initial 500ms TCP slow start ramp
			let isDownDone = false;

			// Live ticker to update speed every 80ms
			const downTicker = setInterval(() => {
				const now = performance.now();
				const elapsedTotal = (now - d0) / 1000;
				if (downSteadyStartTime > 0 && now - downSteadyStartTime > 150) {
					const steadyElapsed = (now - downSteadyStartTime) / 1000;
					const curMbps = (downSteadyBytes * 8) / (steadyElapsed * 1_000_000);
					if (downEl) downEl.textContent = curMbps.toFixed(1);
				}
				const progressPct = 25 + Math.min(38, (elapsedTotal / downDurationSec) * 38);
				if (progressBar) progressBar.style.width = `${progressPct.toFixed(0)}%`;
			}, 80);

			// Background loaded ping probe loop during download
			const downBloatInterval = setInterval(async () => {
				if (isDownDone) return;
				const t0 = performance.now();
				try {
					const res = await fetch(`/api/ping?_bld=${Date.now()}`, { cache: 'no-store' });
					if (res.ok) loadedPings.push(performance.now() - t0);
				} catch (_) {}
			}, 350);

			const runDownWorker = async (streamId: number) => {
				while (!isDownDone && (performance.now() - d0) / 1000 < downDurationSec) {
					const ctrl = new AbortController();
					downControllers.push(ctrl);
					try {
						const res = await fetch(`https://speed.cloudflare.com/__down?bytes=${chunkSize}&_s=${streamId}_${Date.now()}`, {
							signal: ctrl.signal,
							cache: 'no-store',
						});
						if (res.body) {
							const reader = res.body.getReader();
							while (true) {
								const { done, value } = await reader.read();
								if (done) break;
								if (value) {
									const now = performance.now();
									downTotalBytes += value.length;
									if (now - d0 > downWarmupMs) {
										if (downSteadyStartTime === 0) downSteadyStartTime = now;
										downSteadyBytes += value.length;
									}
									if ((now - d0) / 1000 >= downDurationSec) {
										isDownDone = true;
										downControllers.forEach(c => {
											try { c.abort(); } catch (_) {}
										});
										break;
									}
								}
							}
						}
					} catch (_) {
						// Expected on abort
					}
				}
			};

			const downTimeout = setTimeout(() => {
				isDownDone = true;
				downControllers.forEach(c => {
					try { c.abort(); } catch (_) {}
				});
			}, (downDurationSec + 0.15) * 1000);

			await Promise.allSettled(Array.from({ length: downStreams }, (_, i) => runDownWorker(i)));
			clearTimeout(downTimeout);
			clearInterval(downTicker);
			clearInterval(downBloatInterval);

			const finalDownElapsed = downSteadyStartTime > 0 ? (performance.now() - downSteadyStartTime) / 1000 : (performance.now() - d0) / 1000;
			const finalDownMbps = (downSteadyBytes * 8) / (Math.max(finalDownElapsed, 0.001) * 1_000_000);
			if (downEl) downEl.textContent = finalDownMbps.toFixed(1);
			const downSecDisplay = Math.max(1, Math.round((performance.now() - d0) / 1000));
			if (downSubEl) downSubEl.textContent = `Sustained (${(downTotalBytes / (1024 * 1024)).toFixed(1)} MB / ${downSecDisplay}s)`;
			if (progressBar) progressBar.style.width = '63%';

			// ==========================================
			// STAGE 3: MULTI-STREAM SUSTAINED UPLOAD (3s)
			// ==========================================
			if (statusText) statusText.textContent = 'Saturating return pipeline with multi-stream upstream channels...';
			if (upSubEl) upSubEl.textContent = 'Measuring...';

			const upDurationSec = 3.0;
			const upStreams = 4;
			const upChunkSize = 3 * 1024 * 1024; // 3MB chunk per request
			const upBuf = new Uint8Array(upChunkSize);
			const upControllers: AbortController[] = [];

			let upTotalBytes = 0;
			let upSteadyBytes = 0;
			let upSteadyStartTime = 0;
			const u0 = performance.now();
			const upWarmupMs = 500; // Discard initial 500ms TCP slow start ramp
			let isUpDone = false;

			const upTicker = setInterval(() => {
				const now = performance.now();
				const elapsedTotal = (now - u0) / 1000;
				if (upSteadyStartTime > 0 && now - upSteadyStartTime > 150) {
					const steadyElapsed = (now - upSteadyStartTime) / 1000;
					const curMbps = (upSteadyBytes * 8) / (steadyElapsed * 1_000_000);
					if (upEl && curMbps > 0) upEl.textContent = curMbps.toFixed(1);
				}
				const progressPct = 63 + Math.min(37, (elapsedTotal / upDurationSec) * 37);
				if (progressBar) progressBar.style.width = `${progressPct.toFixed(0)}%`;
			}, 80);

			// Background loaded ping probe loop during upload
			const upBloatInterval = setInterval(async () => {
				if (isUpDone) return;
				const t0 = performance.now();
				try {
					const res = await fetch(`/api/ping?_blu=${Date.now()}`, { cache: 'no-store' });
					if (res.ok) loadedPings.push(performance.now() - t0);
				} catch (_) {}
			}, 350);

			const runUpWorker = async (workerId: number) => {
				while (!isUpDone && (performance.now() - u0) / 1000 < upDurationSec) {
					const ctrl = new AbortController();
					upControllers.push(ctrl);
					const reqStart = performance.now();
					try {
						const res = await fetch(`https://speed.cloudflare.com/__up?_u=${workerId}_${Date.now()}`, {
							method: 'POST',
							body: upBuf,
							headers: { 'Content-Type': 'application/octet-stream' },
							signal: ctrl.signal,
						});
						if (res.ok) {
							upTotalBytes += upChunkSize;
							if (reqStart - u0 > upWarmupMs) {
								if (upSteadyStartTime === 0) upSteadyStartTime = reqStart;
								upSteadyBytes += upChunkSize;
							}
						}
					} catch (_) {
						// Expected on abort
					}
				}
			};

			const upTimeout = setTimeout(() => {
				isUpDone = true;
				upControllers.forEach(c => {
					try { c.abort(); } catch (_) {}
				});
			}, (upDurationSec + 0.15) * 1000);

			await Promise.allSettled(Array.from({ length: upStreams }, (_, i) => runUpWorker(i)));
			clearTimeout(upTimeout);
			clearInterval(upTicker);
			clearInterval(upBloatInterval);

			const finalUpElapsed = upSteadyStartTime > 0 ? (performance.now() - upSteadyStartTime) / 1000 : (performance.now() - u0) / 1000;
			const upBytesToCount = upSteadyBytes > 0 ? upSteadyBytes : upTotalBytes;
			const finalUpMbps = (upBytesToCount * 8) / (Math.max(finalUpElapsed, 0.001) * 1_000_000);
			if (upEl) upEl.textContent = finalUpMbps > 0 ? finalUpMbps.toFixed(1) : '--';
			const upSecDisplay = Math.max(1, Math.round((performance.now() - u0) / 1000));
			if (upSubEl) upSubEl.textContent = `Sustained (${(upTotalBytes / (1024 * 1024)).toFixed(1)} MB / ${upSecDisplay}s)`;

			// ==========================================
			// STAGE 4: BUFFERBLOAT & FIBER OPTIC METRICS
			// ==========================================
			loadedPings.sort((a, b) => a - b);
			const medianLoaded = loadedPings.length ? Math.round(loadedPings[Math.floor(loadedPings.length / 2)]) : medianPing;
			const bloatDelta = Math.max(0, medianLoaded - medianPing);
			let grade = 'A+';
			let gradeColor = 'rgb(34, 197, 94)'; // green
			if (bloatDelta > 75) { grade = 'D'; gradeColor = 'rgb(239, 68, 68)'; }
			else if (bloatDelta > 40) { grade = 'C'; gradeColor = 'rgb(245, 158, 11)'; }
			else if (bloatDelta > 20) { grade = 'B'; gradeColor = 'rgb(56, 189, 248)'; }
			else if (bloatDelta > 6) { grade = 'A'; gradeColor = 'rgb(34, 197, 94)'; }

			if (bloatEl) {
				bloatEl.textContent = grade;
				bloatEl.style.color = gradeColor;
			}
			if (bloatSubEl) {
				bloatSubEl.textContent = `+${bloatDelta} ms loaded Δ`;
			}

			// Physics: Great-circle distance & speed of light in optical glass (c_glass ~ 204 km/ms)
			let distanceKm = 0;
			let fiberRttMs = '0';
			const coloCoord = COLO_COORDS[detectedColo];
			if (coloCoord && clientLat && clientLon) {
				distanceKm = getGreatCircleDistance(clientLat, clientLon, coloCoord.lat, coloCoord.lon);
				fiberRttMs = Math.max(0.1, (2 * distanceKm) / 204).toFixed(1);
			}

			if (progressBar) progressBar.style.width = '100%';
			const targetSummary = detectedColo ? ` via Cloudflare ${detectedColo} Edge (${detectedCity})` : ' via Cloudflare Anycast';
			const physicsSummary = distanceKm > 0 ? ` &bull; ~${distanceKm} km (fiber limit: ~${fiberRttMs} ms RTT)` : '';
			if (statusText) statusText.innerHTML = `Test complete${targetSummary}${physicsSummary}.`;

		} catch (err: any) {
			console.error('Speedtest encountered error:', err);
			if (statusText) statusText.textContent = 'Test interrupted or blocked by browser extensions.';
		} finally {
			isBenchmarking = false;
			if (btn) btn.disabled = false;
			if (btnText) btnText.textContent = 'Run Again';
		}
	}

	function setupBenchmarkBtn() {
		const btn = document.getElementById('run-speedtest-btn');
		if (btn) {
			btn.removeEventListener('click', runBenchmark);
			btn.addEventListener('click', runBenchmark);
		}
	}

	setupBenchmarkBtn();
	resolveEdgeDatacenter();
