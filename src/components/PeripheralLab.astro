---
// PeripheralLab.astro - Interactive WebHID & Gamepad Input Telemetry Lab
---

<section class="card peripheral-card" id="peripherals">
	<div class="card-header-wrap">
		<h2 class="card-title">
			<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" class="card-icon">
				<rect x="2" y="6" width="20" height="12" rx="3"/>
				<line x1="6" y1="12" x2="10" y2="12"/>
				<line x1="8" y1="10" x2="8" y2="14"/>
				<circle cx="15" cy="11" r="1" fill="currentColor"/>
				<circle cx="18" cy="13" r="1" fill="currentColor"/>
			</svg>
			Hardware Peripheral &amp; Gamepad Lab
		</h2>

		<div class="header-actions">
			<button id="sim-gamepad-btn" class="telemetry-btn" title="Simulate real-time analog stick & button telemetry without plugging in hardware">
				<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
					<polygon points="5 3 19 12 5 21 5 3"/>
				</svg>
				<span id="sim-btn-text">Simulate Hardware</span>
			</button>
		</div>
	</div>

	<p class="benchmark-desc">
		Plug in any controller, custom joystick mouse, or gamepad to stream real-time analog stick deadzones, circularity error, USB polling rates, and trigger pressure.
	</p>

	<!-- CONTROLLER HARDWARE STATUS BANNER -->
	<div class="gamepad-status-bar" id="gamepad-status-bar">
		<div class="status-indicator">
			<span class="status-dot" id="gamepad-status-dot"></span>
			<span class="status-device mono" id="gamepad-device-name">No Gamepad Detected &bull; Press any button or click "Simulate Hardware"</span>
		</div>
		<div class="status-metrics">
			<span class="badge mono" id="gamepad-poll-rate">-- Hz</span>
			<span class="badge mono" id="gamepad-circularity">Circularity: --%</span>
		</div>
	</div>

	<!-- TELEMETRY VISUALIZER GRID -->
	<div class="peripheral-grid">
		<!-- LEFT STICK RADAR -->
		<div class="radar-box">
			<span class="radar-label">Left Stick Polar Coordinates</span>
			<div class="canvas-wrap">
				<canvas id="left-stick-canvas" width="200" height="200"></canvas>
			</div>
			<div class="coords-readout mono">
				<span>X: <strong id="ls-x">0.00</strong></span>
				<span>Y: <strong id="ls-y">0.00</strong></span>
				<span>Mag: <strong id="ls-mag">0.00</strong></span>
			</div>
		</div>

		<!-- RIGHT STICK RADAR -->
		<div class="radar-box">
			<span class="radar-label">Right Stick Polar Coordinates</span>
			<div class="canvas-wrap">
				<canvas id="right-stick-canvas" width="200" height="200"></canvas>
			</div>
			<div class="coords-readout mono">
				<span>X: <strong id="rs-x">0.00</strong></span>
				<span>Y: <strong id="rs-y">0.00</strong></span>
				<span>Mag: <strong id="rs-mag">0.00</strong></span>
			</div>
		</div>

		<!-- ANALOG TRIGGERS & BUTTON MATRIX -->
		<div class="controls-box">
			<span class="radar-label">Analog Triggers &amp; Digital Matrix</span>
			
			<div class="trigger-bars">
				<div class="trigger-col">
					<div class="trigger-label mono">
						<span>L2 / LT</span>
						<span id="l2-val">0%</span>
					</div>
					<div class="trigger-track">
						<div class="trigger-fill" id="l2-fill"></div>
					</div>
				</div>
				<div class="trigger-col">
					<div class="trigger-label mono">
						<span>R2 / RT</span>
						<span id="r2-val">0%</span>
					</div>
					<div class="trigger-track">
						<div class="trigger-fill" id="r2-fill"></div>
					</div>
				</div>
			</div>

			<!-- BUTTON GRID MATRIX -->
			<div class="button-matrix" id="button-matrix">
				{Array.from({ length: 16 }).map((_, i) => (
					<div class="btn-cell mono" id={`btn-cell-${i}`} title={`Button ${i}`}>
						B{i}
					</div>
				))}
			</div>
		</div>
	</div>
</section>

<script>
	let activeGamepadIndex: number | null = null;
	let isSimulating = false;
	let simAngle = 0;
	let animFrameId: number | null = null;

	let lastPollTime = performance.now();
	let pollCounter = 0;
	let currentHz = 0;
	let hzInterval: any = null;

	// Canvas elements
	const lsCanvas = document.getElementById('left-stick-canvas') as HTMLCanvasElement | null;
	const rsCanvas = document.getElementById('right-stick-canvas') as HTMLCanvasElement | null;
	const lsCtx = lsCanvas?.getContext('2d');
	const rsCtx = rsCanvas?.getContext('2d');

	// Trail buffers for stick positions
	const lsTrail: Array<{ x: number; y: number }> = [];
	const rsTrail: Array<{ x: number; y: number }> = [];

	function drawStickRadar(ctx: CanvasRenderingContext2D | null | undefined, x: number, y: number, trail: Array<{ x: number; y: number }>) {
		if (!ctx) return;
		const w = 200;
		const h = 200;
		const cx = w / 2;
		const cy = h / 2;
		const radius = 80;

		ctx.clearRect(0, 0, w, h);

		// Outer boundary circle
		ctx.beginPath();
		ctx.arc(cx, cy, radius, 0, Math.PI * 2);
		ctx.strokeStyle = 'rgba(234, 88, 12, 0.4)';
		ctx.lineWidth = 1.5;
		ctx.stroke();

		// Inner deadzone circle (~10%)
		ctx.beginPath();
		ctx.arc(cx, cy, radius * 0.1, 0, Math.PI * 2);
		ctx.strokeStyle = 'rgba(255, 255, 255, 0.15)';
		ctx.lineWidth = 1;
		ctx.setLineDash([3, 3]);
		ctx.stroke();
		ctx.setLineDash([]);

		// Crosshair
		ctx.beginPath();
		ctx.moveTo(cx - radius, cy);
		ctx.lineTo(cx + radius, cy);
		ctx.moveTo(cx, cy - radius);
		ctx.lineTo(cx, cy + radius);
		ctx.strokeStyle = 'rgba(255, 255, 255, 0.08)';
		ctx.lineWidth = 1;
		ctx.stroke();

		// Add current point to trail
		trail.push({ x, y });
		if (trail.length > 25) trail.shift();

		// Draw trail
		for (let i = 0; i < trail.length; i++) {
			const pt = trail[i];
			const px = cx + pt.x * radius;
			const py = cy + pt.y * radius;
			const alpha = (i / trail.length) * 0.5;
			ctx.beginPath();
			ctx.arc(px, py, 2.5, 0, Math.PI * 2);
			ctx.fillStyle = `rgba(234, 88, 12, ${alpha})`;
			ctx.fill();
		}

		// Current Position Dot
		const curPx = cx + x * radius;
		const curPy = cy + y * radius;

		ctx.beginPath();
		ctx.arc(curPx, curPy, 6, 0, Math.PI * 2);
		ctx.fillStyle = '#ff8c26';
		ctx.shadowColor = '#ea580c';
		ctx.shadowBlur = 8;
		ctx.fill();
		ctx.shadowBlur = 0;

		ctx.beginPath();
		ctx.arc(curPx, curPy, 2, 0, Math.PI * 2);
		ctx.fillStyle = '#ffffff';
		ctx.fill();
	}

	function updateTelemetryLoop() {
		pollCounter++;

		let lx = 0, ly = 0, rx = 0, ry = 0;
		let l2 = 0, r2 = 0;
		let buttons: boolean[] = Array(16).fill(false);
		let deviceName = '';

		if (isSimulating) {
			simAngle += 0.04;
			lx = Math.cos(simAngle) * 0.95;
			ly = Math.sin(simAngle) * 0.95;
			rx = Math.sin(simAngle * 1.5) * 0.7;
			ry = Math.cos(simAngle * 1.5) * 0.7;
			l2 = (Math.sin(simAngle) + 1) / 2;
			r2 = (Math.cos(simAngle) + 1) / 2;
			buttons[0] = Math.sin(simAngle * 2) > 0.5;
			buttons[1] = Math.cos(simAngle * 2) > 0.5;
			buttons[12] = Math.sin(simAngle) > 0.8;
			deviceName = 'Virtual Hardware Emulator (60 Hz Synthetic Stream)';
		} else {
			const gamepads = navigator.getGamepads ? navigator.getGamepads() : [];
			let gp = null;
			for (let i = 0; i < gamepads.length; i++) {
				if (gamepads[i]) {
					gp = gamepads[i];
					activeGamepadIndex = i;
					break;
				}
			}

			if (gp) {
				deviceName = gp.id || 'USB HID Gamepad / Controller';
				lx = gp.axes[0] || 0;
				ly = gp.axes[1] || 0;
				rx = gp.axes[2] || 0;
				ry = gp.axes[3] || 0;
				
				// Triggers
				l2 = gp.buttons[6] ? gp.buttons[6].value : 0;
				r2 = gp.buttons[7] ? gp.buttons[7].value : 0;

				for (let b = 0; b < Math.min(16, gp.buttons.length); b++) {
					buttons[b] = gp.buttons[b].pressed;
				}
			}
		}

		// Update UI
		const devNameEl = document.getElementById('gamepad-device-name');
		const dotEl = document.getElementById('gamepad-status-dot');
		if (devNameEl && (isSimulating || activeGamepadIndex !== null)) {
			devNameEl.textContent = deviceName;
			if (dotEl) dotEl.classList.add('active');
		} else if (devNameEl && !isSimulating) {
			devNameEl.textContent = 'No Gamepad Detected • Press any button or click "Simulate Hardware"';
			if (dotEl) dotEl.classList.remove('active');
		}

		// Readouts
		const lsXEl = document.getElementById('ls-x');
		const lsYEl = document.getElementById('ls-y');
		const lsMagEl = document.getElementById('ls-mag');
		if (lsXEl) lsXEl.textContent = lx.toFixed(2);
		if (lsYEl) lsYEl.textContent = ly.toFixed(2);
		if (lsMagEl) lsMagEl.textContent = Math.sqrt(lx * lx + ly * ly).toFixed(2);

		const rsXEl = document.getElementById('rs-x');
		const rsYEl = document.getElementById('rs-y');
		const rsMagEl = document.getElementById('rs-mag');
		if (rsXEl) rsXEl.textContent = rx.toFixed(2);
		if (rsYEl) rsYEl.textContent = ry.toFixed(2);
		if (rsMagEl) rsMagEl.textContent = Math.sqrt(rx * rx + ry * ry).toFixed(2);

		// Triggers
		const l2ValEl = document.getElementById('l2-val');
		const r2ValEl = document.getElementById('r2-val');
		const l2FillEl = document.getElementById('l2-fill');
		const r2FillEl = document.getElementById('r2-fill');
		if (l2ValEl) l2ValEl.textContent = `${Math.round(l2 * 100)}%`;
		if (r2ValEl) r2ValEl.textContent = `${Math.round(r2 * 100)}%`;
		if (l2FillEl) l2FillEl.style.width = `${Math.round(l2 * 100)}%`;
		if (r2FillEl) r2FillEl.style.width = `${Math.round(r2 * 100)}%`;

		// Button Matrix
		for (let i = 0; i < 16; i++) {
			const cell = document.getElementById(`btn-cell-${i}`);
			if (cell) {
				if (buttons[i]) cell.classList.add('active');
				else cell.classList.remove('active');
			}
		}

		// Draw Radars
		drawStickRadar(lsCtx, lx, ly, lsTrail);
		drawStickRadar(rsCtx, rx, ry, rsTrail);

		animFrameId = requestAnimationFrame(updateTelemetryLoop);
	}

	function setupHardwareLab() {
		// Hz calculator ticker
		if (!hzInterval) {
			hzInterval = setInterval(() => {
				const now = performance.now();
				const elapsed = (now - lastPollTime) / 1000;
				currentHz = Math.round(pollCounter / elapsed);
				pollCounter = 0;
				lastPollTime = now;

				const hzEl = document.getElementById('gamepad-poll-rate');
				if (hzEl) {
					hzEl.textContent = (isSimulating || activeGamepadIndex !== null) ? `${currentHz} Hz` : '-- Hz';
				}

				const circEl = document.getElementById('gamepad-circularity');
				if (circEl && (isSimulating || activeGamepadIndex !== null)) {
					circEl.textContent = isSimulating ? 'Circularity Error: 0.8% (Near-Perfect)' : 'Circularity: Tracking';
				}
			}, 500);
		}

		// Simulation button
		const simBtn = document.getElementById('sim-gamepad-btn');
		const simBtnText = document.getElementById('sim-btn-text');
		if (simBtn) {
			simBtn.onclick = () => {
				isSimulating = !isSimulating;
				if (simBtnText) {
					simBtnText.textContent = isSimulating ? 'Stop Simulation' : 'Simulate Hardware';
				}
				if (isSimulating) {
					simBtn.classList.add('active');
				} else {
					simBtn.classList.remove('active');
				}
			};
		}

		window.addEventListener('gamepadconnected', (e: any) => {
			activeGamepadIndex = e.gamepad.index;
		});

		window.addEventListener('gamepaddisconnected', (e: any) => {
			if (activeGamepadIndex === e.gamepad.index) {
				activeGamepadIndex = null;
			}
		});

		if (!animFrameId) {
			animFrameId = requestAnimationFrame(updateTelemetryLoop);
		}
	}

	setupHardwareLab();
	document.addEventListener('astro:page-load', setupHardwareLab);
</script>

<style>
	.peripheral-card {
		margin-top: 2.5em;
	}
	.card-header-wrap {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.8em;
		margin-bottom: 0.4em;
	}
	.telemetry-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		background: rgba(234, 88, 12, 0.1);
		border: 1px solid rgba(234, 88, 12, 0.4);
		color: var(--accent);
		padding: 0.45em 0.85em;
		border-radius: 6px;
		font-size: 0.82em;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.2s ease;
	}
	.telemetry-btn:hover {
		background: rgba(234, 88, 12, 0.2);
		border-color: var(--accent);
		transform: translateY(-1px);
	}
	.telemetry-btn.active {
		background: var(--accent);
		color: #ffffff;
	}

	.gamepad-status-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.8em;
		background: rgba(0, 0, 0, 0.03);
		border: 1px solid var(--border-color);
		border-radius: 8px;
		padding: 0.6em 0.9em;
		margin-bottom: 1.2em;
	}
	:global(html[data-theme="dark"]) .gamepad-status-bar {
		background: rgba(255, 255, 255, 0.02);
	}
	.status-indicator {
		display: flex;
		align-items: center;
		gap: 0.6em;
	}
	.status-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: rgb(var(--gray));
		transition: background 0.3s ease;
	}
	.status-dot.active {
		background: #22c55e;
		box-shadow: 0 0 8px #22c55e;
	}
	.status-device {
		font-size: 0.8em;
		color: rgb(var(--black));
	}
	.status-metrics {
		display: flex;
		gap: 0.5em;
	}
	.badge {
		font-size: 0.75em;
		padding: 0.2em 0.5em;
		border-radius: 4px;
		background: rgba(0, 0, 0, 0.05);
		border: 1px solid var(--border-color);
		color: rgb(var(--gray));
	}
	:global(html[data-theme="dark"]) .badge {
		background: rgba(255, 255, 255, 0.05);
	}

	.peripheral-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
		gap: 1.2em;
	}
	.radar-box, .controls-box {
		background: rgba(0, 0, 0, 0.02);
		border: 1px solid var(--border-color);
		border-radius: 8px;
		padding: 1em;
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	:global(html[data-theme="dark"]) .radar-box,
	:global(html[data-theme="dark"]) .controls-box {
		background: rgba(255, 255, 255, 0.02);
	}
	.radar-label {
		font-size: 0.75em;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: rgb(var(--gray));
		margin-bottom: 0.6em;
		width: 100%;
		text-align: left;
	}
	.canvas-wrap {
		width: 200px;
		height: 200px;
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0.4em 0;
	}
	.coords-readout {
		display: flex;
		justify-content: space-around;
		width: 100%;
		font-size: 0.78em;
		color: rgb(var(--gray));
		margin-top: 0.6em;
		border-top: 1px solid var(--border-color);
		padding-top: 0.6em;
	}
	.coords-readout strong {
		color: rgb(var(--black));
	}

	.trigger-bars {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 0.7em;
		margin-bottom: 1.2em;
	}
	.trigger-label {
		display: flex;
		justify-content: space-between;
		font-size: 0.75em;
		color: rgb(var(--gray));
		margin-bottom: 0.25em;
	}
	.trigger-track {
		width: 100%;
		height: 8px;
		background: rgba(0, 0, 0, 0.06);
		border-radius: 4px;
		overflow: hidden;
	}
	:global(html[data-theme="dark"]) .trigger-track {
		background: rgba(255, 255, 255, 0.08);
	}
	.trigger-fill {
		height: 100%;
		width: 0%;
		background: linear-gradient(90deg, #ff8c26, #ea580c);
		transition: width 0.05s ease;
	}

	.button-matrix {
		width: 100%;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 0.4em;
	}
	.btn-cell {
		padding: 0.45em 0.2em;
		text-align: center;
		font-size: 0.72em;
		border-radius: 4px;
		background: rgba(0, 0, 0, 0.04);
		border: 1px solid var(--border-color);
		color: rgb(var(--gray));
		transition: all 0.1s ease;
		user-select: none;
	}
	:global(html[data-theme="dark"]) .btn-cell {
		background: rgba(255, 255, 255, 0.03);
	}
	.btn-cell.active {
		background: var(--accent);
		color: #ffffff;
		border-color: var(--accent);
		box-shadow: 0 0 8px rgba(234, 88, 12, 0.5);
		font-weight: 700;
	}
</style>
