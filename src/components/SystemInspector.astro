---
// SystemInspector.astro - Real-time client-side hardware & edge telemetry inspector + Edge Network Benchmark
---

<section class="card telemetry-card" id="inspector">
	<div class="telemetry-header">
		<h2 class="card-title">
			<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" class="card-icon">
				<rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
				<line x1="8" y1="21" x2="16" y2="21"/>
				<line x1="12" y1="17" x2="12" y2="21"/>
			</svg>
			System Inspector
		</h2>
	</div>

	<!-- PROMINENT PRIVACY NOTICE (AT TOP) -->
	<div class="telemetry-privacy-banner">
		<div class="privacy-icon-box">
			<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
				<path d="m9 12 2 2 4-4"/>
			</svg>
		</div>
		<div class="privacy-content">
			<div class="privacy-headline">🔒 Client-Side Privacy &bull; What the Web Sees</div>
			<p class="privacy-message">
				Ever wonder what websites know about your device? The metrics below represent the standard network, hardware, and browser telemetry exposed to virtually every website you visit across the web. This demonstration inspects everything live in your local session &mdash; <strong>zero data is tracked, stored, or logged to any server or database.</strong>
			</p>
		</div>
	</div>

	<!-- CLIENT HARDWARE & BROWSER TELEMETRY GRID -->
	<div class="telemetry-grid">
		<div class="telemetry-item">
			<span class="t-label">Public IP</span>
			<span id="t-ip" class="t-val mono ip-val">Detecting...</span>
		</div>
		<div class="telemetry-item">
			<span class="t-label">Location (Edge)</span>
			<span id="t-location" class="t-val">Detecting...</span>
		</div>
		<div class="telemetry-item">
			<span class="t-label">Network &amp; ISP</span>
			<span id="t-isp" class="t-val">Detecting...</span>
		</div>
		<div class="telemetry-item">
			<span class="t-label">Operating System</span>
			<span id="t-os" class="t-val">Detecting...</span>
		</div>
		<div class="telemetry-item">
			<span class="t-label">Processor (CPU)</span>
			<span id="t-cpu" class="t-val">Detecting...</span>
		</div>
		<div class="telemetry-item">
			<span class="t-label">System Memory</span>
			<span id="t-ram" class="t-val">Detecting...</span>
		</div>
		<div class="telemetry-item">
			<span class="t-label">Graphics Card (GPU)</span>
			<span id="t-gpu" class="t-val">Detecting WebGL...</span>
		</div>
		<div class="telemetry-item">
			<span class="t-label">Display &amp; Scaling</span>
			<span id="t-display" class="t-val">Detecting...</span>
		</div>
		<div class="telemetry-item full-row">
			<span class="t-label">Raw User Agent</span>
			<span id="t-ua" class="t-val mono break-all">Detecting...</span>
		</div>
	</div>

	<!-- EDGE NETWORK BENCHMARK SUBSECTION -->
	<div class="benchmark-container">
		<div class="benchmark-top-bar">
			<div class="benchmark-title-group">
				<h3 class="benchmark-heading">
					<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" class="b-heading-icon">
						<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
					</svg>
					Edge Network Benchmark
				</h3>
				<span class="benchmark-subtext">Direct to Cloudflare Anycast edge &bull; 0 host bandwidth</span>
			</div>
			<button id="run-speedtest-btn" class="benchmark-btn" type="button" aria-label="Run Edge Network Benchmark">
				<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" class="play-icon" id="btn-icon-play">
					<polygon points="5 3 19 12 5 21 5 3"/>
				</svg>
				<span id="speedtest-btn-text">Run Benchmark</span>
			</button>
		</div>

		<!-- BENCHMARK TILES -->
		<div class="benchmark-tiles">
			<div class="b-tile">
				<span class="b-tile-label">Latency / Ping</span>
				<div class="b-tile-value-wrap">
					<span id="speed-ping" class="b-tile-num mono">--</span>
					<span class="b-tile-unit">ms</span>
				</div>
				<span id="speed-jitter" class="b-tile-sub">Jitter: -- ms</span>
			</div>

			<div class="b-tile b-tile-highlight">
				<span class="b-tile-label">Download Speed</span>
				<div class="b-tile-value-wrap">
					<span id="speed-down" class="b-tile-num mono">--</span>
					<span class="b-tile-unit">Mbps</span>
				</div>
				<span id="speed-down-sub" class="b-tile-sub">Edge Throughput</span>
			</div>

			<div class="b-tile">
				<span class="b-tile-label">Upload Speed</span>
				<div class="b-tile-value-wrap">
					<span id="speed-up" class="b-tile-num mono">--</span>
					<span class="b-tile-unit">Mbps</span>
				</div>
				<span id="speed-up-sub" class="b-tile-sub">Return Pipeline</span>
			</div>

			<div class="b-tile">
				<span class="b-tile-label">Edge PoP &amp; Protocol</span>
				<div class="b-tile-value-wrap">
					<span id="speed-colo" class="b-tile-text">Detecting...</span>
				</div>
				<span id="speed-protocol" class="b-tile-sub">Anycast Node</span>
			</div>
		</div>

		<!-- PROGRESS TRACK & LIVE STATUS -->
		<div class="benchmark-footer">
			<div class="progress-track" id="benchmark-progress-track">
				<div class="progress-bar" id="benchmark-progress-bar"></div>
			</div>
			<div class="status-wrap">
				<span id="speedtest-status" class="status-text">Click "Run Benchmark" to measure real-time latency, jitter, and edge throughput.</span>
			</div>
		</div>
	</div>
</section>

<script>
	let edgeColoName = 'Cloudflare Edge';
	let edgeProtocol = 'HTTP/2';

	function detectGPU(): string {
		try {
			const canvas = document.createElement('canvas');
			const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
			if (!gl || !(gl instanceof WebGLRenderingContext)) {
				return 'Hardware Accelerated (WebGL unavailable)';
			}
			const debugInfo = gl.getExtension('WEBGL_debug_renderer_info');
			if (!debugInfo) {
				return 'Hardware Accelerated GPU';
			}
			const unmasked = gl.getParameter(debugInfo.UNMASKED_RENDERER_WEBGL);
			if (!unmasked) return 'Hardware Accelerated GPU';

			const angleMatch = unmasked.match(/ANGLE \([^,]+,\s*([^,]+)/);
			if (angleMatch && angleMatch[1]) {
				return angleMatch[1]
					.replace(/\sDirect3D.*$/, '')
					.replace(/\s*\((?:0x)?[0-9a-fA-F]{4,8}\)/g, '')
					.trim();
			}
			return unmasked
				.replace(/Direct3D.*$/, '')
				.replace(/\s*\((?:0x)?[0-9a-fA-F]{4,8}\)/g, '')
				.trim();
		} catch (e) {
			return 'Generic Graphics Accelerator';
		}
	}

	function detectOS(): string {
		const ua = navigator.userAgent;
		const uaData = (navigator as any).userAgentData;

		if (uaData && uaData.platform) {
			const plat = uaData.platform;
			if (plat === 'Windows') return 'Windows PC';
			if (plat === 'macOS') return 'Apple macOS';
			if (plat === 'Linux') return 'GNU/Linux';
			if (plat === 'Android') return 'Android Device';
		}

		if (/Windows NT 10.0/.test(ua)) return 'Windows 10 / 11 (64-bit)';
		if (/Macintosh; Intel Mac OS X (\d+[._]\d+)/.test(ua)) {
			const ver = ua.match(/Macintosh; Intel Mac OS X (\d+[._]\d+)/);
			return `macOS ${ver ? ver[1].replace('_', '.') : ''}`;
		}
		if (/Android (\d+(\.\d+)?)/.test(ua)) {
			const ver = ua.match(/Android (\d+(\.\d+)?)/);
			return `Android ${ver ? ver[1] : ''}`;
		}
		if (/iPhone OS (\d+[._]\d+)/.test(ua)) {
			const v = ua.match(/iPhone OS (\d+[._]\d+)/);
			return `iOS ${v ? v[1].replace('_', '.') : ''} (iPhone)`;
		}
		if (/Linux/.test(ua)) return 'GNU/Linux';
		return navigator.platform || 'Unknown OS';
	}

	async function initTelemetry() {
		const ipEl = document.getElementById('t-ip');
		const locEl = document.getElementById('t-location');
		const ispEl = document.getElementById('t-isp');
		const osEl = document.getElementById('t-os');
		const cpuEl = document.getElementById('t-cpu');
		const ramEl = document.getElementById('t-ram');
		const gpuEl = document.getElementById('t-gpu');
		const displayEl = document.getElementById('t-display');
		const uaEl = document.getElementById('t-ua');
		const speedColoEl = document.getElementById('speed-colo');
		const speedProtoEl = document.getElementById('speed-protocol');

		// Instant Client Detection
		if (gpuEl) gpuEl.textContent = detectGPU();

		if (osEl) {
			osEl.textContent = detectOS();
			const uaData = (navigator as any).userAgentData;
			if (uaData && uaData.getHighEntropyValues) {
				uaData.getHighEntropyValues(['platform', 'platformVersion', 'architecture', 'bitness', 'model'])
					.then((hints: any) => {
						if (hints.platform === 'Windows') {
							const majorVer = parseInt(hints.platformVersion?.split('.')[0] || '0', 10);
							const winName = majorVer >= 13 ? 'Windows 11' : 'Windows 10';
							const arch = hints.architecture ? ` (${hints.architecture}, ${hints.bitness || 64}-bit)` : '';
							osEl.textContent = `${winName}${arch}`;
						}
					})
					.catch(() => {});
			}
		}

		if (cpuEl) {
			cpuEl.textContent = navigator.hardwareConcurrency ? `${navigator.hardwareConcurrency} Logical CPU Cores` : 'Multi-core Processor';
		}

		if (ramEl) {
			ramEl.textContent = (navigator as any).deviceMemory ? `${(navigator as any).deviceMemory} GB RAM` : '64-bit Architecture';
		}

		if (displayEl) {
			const dpr = window.devicePixelRatio ? ` @ ${window.devicePixelRatio}x scaling` : '';
			const depth = window.screen.colorDepth ? ` (${window.screen.colorDepth}-bit color)` : '';
			displayEl.textContent = `${window.screen.width} × ${window.screen.height}${dpr}${depth}`;
		}

		if (uaEl && navigator.userAgent) {
			uaEl.textContent = navigator.userAgent;
		}

		// Cloudflare Edge Data
		try {
			const res = await fetch('/api/visitor-info', { cache: 'no-store' });
			if (res.ok) {
				const data = await res.json();
				if (ipEl) ipEl.textContent = data.ip || 'Unavailable';
				
				const locParts = [data.city, data.region, data.country].filter(Boolean);
				if (locEl) {
					locEl.textContent = locParts.length > 0 
						? `${locParts.join(', ')} (${data.colo || 'Cloudflare Edge'})`
						: (data.colo ? `Edge Colo: ${data.colo}` : 'Resolved via Edge');
				}

				if (ispEl) {
					const asn = data.asn ? `AS${data.asn}` : '';
					const isp = data.isp ? `${data.isp}` : 'Broadband Provider';
					ispEl.textContent = asn ? `${isp} (${asn})` : isp;
				}

				if (data.colo) {
					edgeColoName = data.colo.replace(/\s*Edge Datacenter$/i, '').trim();
				}
				if (data.protocol) {
					edgeProtocol = data.protocol;
				}
				if (speedColoEl) speedColoEl.textContent = edgeColoName;
				if (speedProtoEl) speedProtoEl.textContent = `Protocol: ${edgeProtocol}`;
			} else {
				throw new Error('Edge endpoint responded with non-200');
			}
		} catch (err) {
			if (ipEl) ipEl.textContent = '127.0.0.1 (Local Edge)';
			if (locEl) locEl.textContent = 'Direct Connection';
			if (ispEl) ispEl.textContent = 'Cloudflare Protected';
			if (speedColoEl) speedColoEl.textContent = 'Cloudflare Edge';
		}
	}

	// ----------------------------------------------------
	// EDGE NETWORK BENCHMARK (0-HOST BANDWIDTH ENGINE)
	// ----------------------------------------------------
	let isBenchmarking = false;

	async function runBenchmark() {
		if (isBenchmarking) return;
		isBenchmarking = true;

		const btn = document.getElementById('run-speedtest-btn') as HTMLButtonElement | null;
		const btnText = document.getElementById('speedtest-btn-text');
		const pingEl = document.getElementById('speed-ping');
		const jitterEl = document.getElementById('speed-jitter');
		const downEl = document.getElementById('speed-down');
		const upEl = document.getElementById('speed-up');
		const coloEl = document.getElementById('speed-colo');
		const protoEl = document.getElementById('speed-protocol');
		const statusEl = document.getElementById('speedtest-status');
		const progressBar = document.getElementById('benchmark-progress-bar');

		if (btn) btn.disabled = true;
		if (btnText) btnText.textContent = 'Testing...';

		const setProgress = (pct: number, status: string) => {
			if (progressBar) progressBar.style.width = `${pct}%`;
			if (statusEl) statusEl.textContent = status;
		};

		// Reset display
		if (pingEl) pingEl.textContent = '...';
		if (jitterEl) jitterEl.textContent = 'Jitter: ...';
		if (downEl) downEl.textContent = '...';
		if (upEl) upEl.textContent = '...';

		try {
			// Phase 1: Latency & Jitter (4 warm samples against speed.cloudflare.com)
			setProgress(10, 'Establishing TLS connection to Cloudflare Anycast edge...');
			await fetch('https://speed.cloudflare.com/__down?bytes=0', { cache: 'no-store' });

			setProgress(20, 'Measuring round-trip ping and jitter (4 samples)...');
			const pings: number[] = [];
			for (let i = 0; i < 4; i++) {
				const t0 = performance.now();
				await fetch(`https://speed.cloudflare.com/__down?bytes=0&_t=${Date.now()}_${i}`, { cache: 'no-store' });
				pings.push(performance.now() - t0);
			}

			pings.sort((a, b) => a - b);
			const medianPing = Math.round(pings[Math.floor(pings.length / 2)]);
			let diffSum = 0;
			for (let i = 1; i < pings.length; i++) {
				diffSum += Math.abs(pings[i] - pings[i - 1]);
			}
			const jitter = (diffSum / (pings.length - 1)).toFixed(1);

			if (pingEl) pingEl.textContent = String(medianPing);
			if (jitterEl) jitterEl.textContent = `Jitter: ±${jitter} ms`;

			// Phase 2: Download Speed (Adaptive burst)
			setProgress(40, 'Testing downstream throughput (Cloudflare Edge stream)...');
			async function testDownload(bytes: number, maxMs: number): Promise<{ bytes: number; dur: number; mbps: number }> {
				const controller = new AbortController();
				const timeout = setTimeout(() => controller.abort(), maxMs);
				const t0 = performance.now();
				let readBytes = 0;
				try {
					const res = await fetch(`https://speed.cloudflare.com/__down?bytes=${bytes}&_t=${Date.now()}`, {
						signal: controller.signal,
						cache: 'no-store'
					});
					const reader = res.body?.getReader();
					if (reader) {
						while (true) {
							const { done, value } = await reader.read();
							if (done) break;
							readBytes += value.byteLength;
						}
					}
				} catch (e) {
					// Abort expected on timeout
				} finally {
					clearTimeout(timeout);
				}
				const dur = (performance.now() - t0) / 1000;
				return { bytes: readBytes, dur, mbps: (readBytes * 8) / (dur * 1e6) };
			}

			// Probe with 5MB
			const downProbe = await testDownload(5000000, 3000);
			let finalDownMbps = downProbe.mbps;

			// If high-speed (> 50 Mbps), sample 25MB for wire-speed accuracy
			if (downProbe.dur < 0.8) {
				setProgress(55, 'Measuring peak downstream bandwidth (25MB stream)...');
				const downHigh = await testDownload(25000000, 3000);
				finalDownMbps = Math.max(downProbe.mbps, downHigh.mbps);
			}

			if (downEl) downEl.textContent = finalDownMbps.toFixed(1);

			// Phase 3: Upload Speed (Adaptive burst)
			setProgress(75, 'Testing upstream throughput (buffer return pipeline)...');
			async function testUpload(bytes: number): Promise<{ dur: number; mbps: number }> {
				const buf = new Uint8Array(bytes);
				const t0 = performance.now();
				const res = await fetch(`https://speed.cloudflare.com/__up?_t=${Date.now()}`, {
					method: 'POST',
					body: buf,
					headers: { 'Content-Type': 'application/octet-stream' }
				});
				const dur = (performance.now() - t0) / 1000;
				return { dur, mbps: (bytes * 8) / (dur * 1e6) };
			}

			// Probe 1MB
			const upProbe = await testUpload(1024 * 1024);
			let finalUpMbps = upProbe.mbps;

			// If high-speed (> 25 Mbps), test 4MB
			if (upProbe.dur < 0.5) {
				setProgress(88, 'Measuring peak upstream bandwidth (4MB stream)...');
				const upHigh = await testUpload(4 * 1024 * 1024);
				finalUpMbps = Math.max(upProbe.mbps, upHigh.mbps);
			}

			if (upEl) upEl.textContent = finalUpMbps.toFixed(1);

			// Update Edge Info
			if (coloEl) coloEl.textContent = edgeColoName;
			if (protoEl) protoEl.textContent = `Protocol: ${edgeProtocol}`;

			setProgress(100, `Benchmark complete &bull; ${medianPing} ms RTT &bull; ${finalDownMbps.toFixed(1)} Mbps down &bull; ${finalUpMbps.toFixed(1)} Mbps up`);
		} catch (err) {
			console.error('Speedtest error:', err);
			setProgress(100, 'Benchmark error: Unable to reach Cloudflare edge endpoints.');
		} finally {
			isBenchmarking = false;
			if (btn) btn.disabled = false;
			if (btnText) btnText.textContent = 'Run Again';
		}
	}

	function setupBenchmarkBtn() {
		const btn = document.getElementById('run-speedtest-btn');
		if (btn) {
			btn.removeEventListener('click', runBenchmark);
			btn.addEventListener('click', runBenchmark);
		}
	}

	initTelemetry();
	setupBenchmarkBtn();
	document.addEventListener('astro:page-load', () => {
		initTelemetry();
		setupBenchmarkBtn();
	});
</script>

<style>
	/* TELEMETRY CARD */
	.telemetry-card {
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 12px;
		padding: clamp(1.2em, 3vw, 2em);
		margin-top: 1.5em;
		box-shadow: var(--box-shadow);
		transition: background-color 0.2s ease, border-color 0.2s ease;
		width: 100%;
		text-align: left;
	}

	/* PROMINENT PRIVACY BANNER AT TOP */
	.telemetry-privacy-banner {
		display: flex;
		align-items: flex-start;
		gap: 0.8em;
		background: #f0fdf4;
		border: 1.5px solid #86efac;
		border-radius: 8px;
		padding: 0.9em 1.1em;
		margin-bottom: 1.25em;
	}
	:global(html[data-theme="dark"]) .telemetry-privacy-banner {
		background: rgba(6, 78, 59, 0.25);
		border-color: #059669;
	}
	.privacy-icon-box {
		flex-shrink: 0;
		color: #16a34a;
		margin-top: 0.1em;
	}
	:global(html[data-theme="dark"]) .privacy-icon-box {
		color: #34d399;
	}
	.privacy-content {
		display: flex;
		flex-direction: column;
		gap: 0.2em;
	}
	.privacy-headline {
		font-size: 0.88em;
		font-weight: 700;
		color: #15803d;
		letter-spacing: 0.02em;
	}
	:global(html[data-theme="dark"]) .privacy-headline {
		color: #6ee7b7;
	}
	.privacy-message {
		font-size: 0.82em;
		line-height: 1.5;
		color: #166534;
		margin: 0;
	}
	:global(html[data-theme="dark"]) .privacy-message {
		color: #a7f3d0;
	}

	.telemetry-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.6em;
		padding-bottom: 0.8em;
		margin-bottom: 1em;
		border-bottom: 1.5px solid var(--border-color);
	}
	.card-title {
		font-size: clamp(1.2em, 2.5vw, 1.35em);
		font-weight: 700;
		margin: 0;
		color: rgb(var(--black));
		display: flex;
		align-items: center;
		gap: 0.5em;
		letter-spacing: -0.01em;
	}
	.card-icon {
		color: var(--accent);
		flex-shrink: 0;
	}

	.telemetry-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
		gap: 1.1em 1.25em;
	}
	.telemetry-item {
		display: flex;
		flex-direction: column;
		gap: 0.25em;
		min-width: 0;
		overflow: hidden;
	}
	.telemetry-item.full-row {
		grid-column: 1 / -1;
		margin-top: 0.25em;
	}
	.t-label {
		font-size: 0.76em;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: rgb(var(--gray));
		margin-bottom: 0.1em;
	}
	.t-val {
		color: rgb(var(--gray-dark));
		font-weight: 600;
		font-size: 0.92em;
		line-height: 1.45;
		word-break: break-word;
	}
	.t-val.mono {
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
	}
	.t-val.ip-val {
		color: var(--accent);
		font-weight: 700;
	}
	.break-all {
		word-break: break-all;
	}

	/* ---------------------------------------------------- */
	/* EDGE NETWORK BENCHMARK SUBSECTION                    */
	/* ---------------------------------------------------- */
	.benchmark-container {
		margin-top: 1.6em;
		padding-top: 1.4em;
		border-top: 1px solid var(--border-color);
	}
	.benchmark-top-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.8em;
		margin-bottom: 1.1em;
	}
	.benchmark-title-group {
		display: flex;
		flex-direction: column;
		gap: 0.2em;
	}
	.benchmark-heading {
		font-size: 1.05em;
		font-weight: 700;
		margin: 0;
		color: rgb(var(--black));
