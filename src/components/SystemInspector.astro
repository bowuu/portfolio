---
// SystemInspector.astro - Real-time client-side hardware & edge telemetry inspector
---

<section class="card telemetry-card" id="debug">
	<div class="telemetry-header">
		<h2 class="card-title">
			<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" class="card-icon">
				<rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
				<line x1="8" y1="21" x2="16" y2="21"/>
				<line x1="12" y1="17" x2="12" y2="21"/>
			</svg>
			Debug
		</h2>
	</div>

	<!-- EXPANDABLE PRIVACY & TELEMETRY NOTICE -->
	<details class="privacy-details">
		<summary class="privacy-summary">
			<div class="privacy-summary-left">
				<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" class="privacy-icon">
					<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
					<path d="m9 12 2 2 4-4"/>
				</svg>
				<span class="privacy-title">Client-Side Privacy Notice</span>
				<span class="privacy-tag">&bull; Zero device data logged</span>
			</div>
			<span class="privacy-toggle">
				<span class="privacy-toggle-label">Details</span>
				<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" class="privacy-chevron">
					<polyline points="6 9 12 15 18 9"/>
				</svg>
			</span>
		</summary>
		<div class="privacy-body">
			<p>
				<strong>Client-Side Evaluation:</strong> The hardware, GPU, CPU, and screen metrics below are read ephemerally in your active browser session via standard WebGL, Screen, and Navigator APIs. <strong>No hardware or browser fingerprinting data is collected, stored, or transmitted to any server or database.</strong>
			</p>
			<p>
				<strong>Network &amp; Edge Layer:</strong> Like all websites and content delivery networks, Cloudflare Pages edge infrastructure receives standard HTTP connection metadata (such as your connecting IP address and Anycast routing headers) at the network layer to deliver web assets and protect against DDoS attacks.
			</p>
		</div>
	</details>

	<!-- CLIENT HARDWARE & BROWSER TELEMETRY GRID -->
	<div class="telemetry-grid">
		<div class="telemetry-item">
			<span class="t-label">Public IP</span>
			<span id="t-ip" class="t-val mono ip-val">Detecting...</span>
		</div>
		<div class="telemetry-item">
			<span class="t-label">Location (Edge)</span>
			<span id="t-location" class="t-val">Detecting...</span>
		</div>
		<div class="telemetry-item">
			<span class="t-label">Network &amp; ISP</span>
			<span id="t-isp" class="t-val">Detecting...</span>
		</div>
		<div class="telemetry-item">
			<span class="t-label">Operating System</span>
			<span id="t-os" class="t-val">Detecting...</span>
		</div>
		<div class="telemetry-item">
			<span class="t-label">Processor (CPU)</span>
			<span id="t-cpu" class="t-val">Detecting...</span>
		</div>
		<div class="telemetry-item">
			<span class="t-label">System Memory</span>
			<span id="t-ram" class="t-val">Detecting...</span>
		</div>
		<div class="telemetry-item">
			<span class="t-label">Graphics Card (GPU)</span>
			<span id="t-gpu" class="t-val">Detecting WebGL...</span>
		</div>
		<div class="telemetry-item">
			<span class="t-label">Display &amp; Scaling</span>
			<span id="t-display" class="t-val">Detecting...</span>
		</div>
		<div class="telemetry-item">
			<span class="t-label">Panel Refresh &amp; Gamut</span>
			<span id="t-refresh" class="t-val">Measuring refresh rate...</span>
		</div>
		<div class="telemetry-item">
			<span class="t-label">Audio Pipeline Latency</span>
			<span id="t-audio" class="t-val">Probing DAC sink...</span>
		</div>
		<div class="telemetry-item">
			<span class="t-label">Compute Acceleration</span>
			<span id="t-accel" class="t-val">Probing WebGPU / SIMD...</span>
		</div>
	</div>
</section>

<script>
	function detectGPU(): string {
		try {
			const canvas = document.createElement('canvas');
			const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
			if (!gl || !(gl instanceof WebGLRenderingContext)) {
				return 'Hardware Accelerated (WebGL unavailable)';
			}
			const debugInfo = gl.getExtension('WEBGL_debug_renderer_info');
			if (!debugInfo) {
				return 'Hardware Accelerated GPU';
			}
			const renderer = gl.getParameter(debugInfo.UNMASKED_RENDERER_WEBGL);
			if (!renderer) return 'Hardware Accelerated GPU';

			// Format ANGLE strings cleanly
			const angleMatch = renderer.match(/ANGLE \([^,]+,\s*([^,]+)/);
			if (angleMatch && angleMatch[1]) {
				return angleMatch[1].replace(/\sDirect3D.*$/, '').replace(/\s*\((?:0x)?[0-9a-fA-F]{4,8}\)/g, '').trim();
			}
			return renderer.replace(/Direct3D.*$/, '').replace(/\s*\((?:0x)?[0-9a-fA-F]{4,8}\)/g, '').trim();
		} catch {
			return 'Generic Graphics Accelerator';
		}
	}

	function detectOS(gpu: string): string {
		const ua = navigator.userAgent;
		const navData = (navigator as any).userAgentData;
		const platform = navData?.platform || navigator.platform || '';
		const isMobileARM = /(Adreno|Mali|Immortalis|Xclipse|PowerVR)/i.test(gpu);
		const hasTouch = (navigator.maxTouchPoints && navigator.maxTouchPoints > 1) || ('ontouchstart' in window);

		// Direct Android UA pattern
		if (/Android (\d+(\.\d+)?)/i.test(ua)) {
			const match = ua.match(/Android (\d+(\.\d+)?)/i);
			const ver = match ? match[1] : '';
			const isTablet = hasTouch && !/Mobile/i.test(ua);
			return ver ? `Android ${ver}${isTablet ? ' (Tablet)' : ''}` : 'Android Device';
		}

		// Android Tablet in "Desktop Site" Mode (Chromium sends (X11; Linux x86_64) on tablets)
		if ((/Linux/i.test(ua) || /Linux/i.test(platform)) && (isMobileARM || (hasTouch && !/Macintosh|Windows/i.test(ua)))) {
			return isMobileARM ? 'Android (ARM64 Tablet)' : 'Android Tablet (Desktop Mode)';
		}

		// iOS / iPadOS
		if (/iPhone OS (\d+[._]\d+)/.test(ua)) {
			const match = ua.match(/iPhone OS (\d+[._]\d+)/);
			return `iOS ${match ? match[1].replace('_', '.') : ''} (iPhone)`;
		}
		if (/iPad/.test(ua) || (ua.includes('Macintosh') && hasTouch)) {
			return 'Apple iPadOS (iPad)';
		}

		// macOS
		if (/Macintosh; Intel Mac OS X (\d+[._]\d+)/.test(ua)) {
			const match = ua.match(/Macintosh; Intel Mac OS X (\d+[._]\d+)/);
			const isAppleSilicon = /Apple/i.test(gpu);
			return `macOS ${match ? match[1].replace(/_/g, '.') : ''}${isAppleSilicon ? ' (Apple Silicon)' : ''}`;
		}

		// Windows
		if (/Windows NT 10.0/.test(ua) || platform === 'Windows') {
			return 'Windows 10 / 11 (64-bit)';
		}

		// Genuine Desktop GNU/Linux (no mobile ARM GPU and no multitouch)
		if (/Linux/i.test(ua) || /Linux/i.test(platform)) {
			return 'GNU/Linux (x86_64 Desktop)';
		}

		return platform || 'Unknown OS';
	}

	async function initTelemetry() {
		const ipEl = document.getElementById('t-ip');
		const locEl = document.getElementById('t-location');
		const ispEl = document.getElementById('t-isp');
		const osEl = document.getElementById('t-os');
		const cpuEl = document.getElementById('t-cpu');
		const ramEl = document.getElementById('t-ram');
		const gpuEl = document.getElementById('t-gpu');
		const displayEl = document.getElementById('t-display');

		// Instant Client Detection
		const gpuString = detectGPU();
		if (gpuEl) gpuEl.textContent = gpuString;

		if (osEl) {
			osEl.textContent = detectOS(gpuString);
			const navData = (navigator as any).userAgentData;
			const isMobileARM = /(Adreno|Mali|Immortalis|Xclipse|PowerVR)/i.test(gpuString);
			const hasTouch = (navigator.maxTouchPoints && navigator.maxTouchPoints > 1) || ('ontouchstart' in window);

			if (navData && navData.getHighEntropyValues) {
				navData.getHighEntropyValues(['platform', 'platformVersion', 'architecture', 'bitness', 'model'])
					.then((hints: any) => {
						if (hints.platform === 'Windows') {
							const major = parseInt(hints.platformVersion?.split('.')[0] || '0', 10);
							const winVer = major >= 13 ? 'Windows 11' : 'Windows 10';
							const arch = hints.architecture ? ` (${hints.architecture}, ${hints.bitness || 64}-bit)` : '';
							osEl.textContent = `${winVer}${arch}`;
						} else if (
							hints.platform === 'Android' || 
							isMobileARM || 
							(hints.architecture?.toLowerCase().includes('arm') && /Linux/i.test(hints.platform || ''))
						) {
							const ver = hints.platformVersion ? ` ${hints.platformVersion.split('.')[0]}` : '';
							let device = '';
							if (hints.model) {
								device = ` (${hints.model})`;
							} else if (hasTouch) {
								device = ' (ARM64 Tablet)';
							} else {
								device = ' (Mobile)';
							}
							osEl.textContent = `Android${ver}${device}`;
						} else if (hints.platform === 'Linux' && !isMobileARM && !hasTouch) {
							const arch = hints.architecture ? ` (${hints.architecture})` : ' (x86_64 Desktop)';
							osEl.textContent = `GNU/Linux${arch}`;
						}
					})
					.catch(() => {});
			}
		}

		if (cpuEl) {
			cpuEl.textContent = navigator.hardwareConcurrency 
				? `${navigator.hardwareConcurrency} Logical CPU Cores` 
				: 'Multi-core Processor';
		}

		if (ramEl) {
			const mem = (navigator as any).deviceMemory;
			ramEl.textContent = mem ? `${mem} GB RAM` : '64-bit Architecture';
		}

		if (displayEl) {
			const dpr = window.devicePixelRatio ? ` @ ${window.devicePixelRatio}x scaling` : '';
			const depth = window.screen.colorDepth ? ` (${window.screen.colorDepth}-bit color)` : '';
			displayEl.textContent = `${window.screen.width} × ${window.screen.height}${dpr}${depth}`;
		}

		const refreshEl = document.getElementById('t-refresh');
		const audioEl = document.getElementById('t-audio');
		const accelEl = document.getElementById('t-accel');

		// 1. Color Gamut, HDR, and Refresh Rate Detection
		const isP3 = window.matchMedia('(color-gamut: p3)').matches;
		const isRec2020 = window.matchMedia('(color-gamut: rec2020)').matches;
		const isHDR = window.matchMedia('(dynamic-range: high)').matches;
		const gamut = isRec2020 ? 'Rec.2020' : (isP3 ? 'Display P3' : 'sRGB');
		const hdrTag = isHDR ? 'HDR' : 'SDR';

		if (refreshEl) {
			let frameTimes: number[] = [];
			let lastFrame = performance.now();
			let framesCollected = 0;
			const targetFrames = 30;

			function sampleFrame(now: number) {
				const delta = now - lastFrame;
				lastFrame = now;
				if (delta > 0 && delta < 100) frameTimes.push(delta);
				framesCollected++;

				if (framesCollected < targetFrames) {
					requestAnimationFrame(sampleFrame);
				} else if (frameTimes.length > 5) {
					const clean = frameTimes.slice(3);
					clean.sort((a, b) => a - b);
					const medianDelta = clean[Math.floor(clean.length / 2)];
					let rawHz = Math.round(1000 / medianDelta);
					
					// Snap to standard refresh rates
					let displayHz = rawHz;
					for (const std of [60, 75, 90, 120, 144, 165, 240, 360]) {
						if (Math.abs(rawHz - std) <= 3) {
							displayHz = std;
							break;
						}
					}
					if (refreshEl) refreshEl.textContent = `${displayHz} Hz • ${gamut} • ${hdrTag}`;
				} else {
					if (refreshEl) refreshEl.textContent = `60 Hz • ${gamut} • ${hdrTag}`;
				}
			}
			requestAnimationFrame(sampleFrame);
		}

		// 2. Audio Pipeline Latency
		if (audioEl) {
			try {
				const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
				if (AudioCtx) {
					const actx = new AudioCtx();
					const baseLatMs = ((actx.baseLatency || 0.005) * 1000).toFixed(1);
					const rateKhz = (actx.sampleRate / 1000).toFixed(0);
					audioEl.textContent = `${baseLatMs} ms latency • ${rateKhz} kHz DAC`;
					actx.close();
				} else {
					audioEl.textContent = 'Standard Audio Subsystem';
				}
			} catch (_) {
				audioEl.textContent = 'Hardware Audio Output';
			}
		}

		// 3. Compute Acceleration
		if (accelEl) {
			const hasWebGPU = typeof (navigator as any).gpu !== 'undefined';
			const hasSharedArrayBuffer = typeof SharedArrayBuffer !== 'undefined';
			const features = [];
			if (hasWebGPU) features.push('WebGPU Compute');
			else features.push('WebGL 2.0 Accelerated');
			features.push('WASM SIMD');
			if (hasSharedArrayBuffer) features.push('Multi-Threaded');
			accelEl.textContent = features.join(' • ');
		}

		// Cloudflare Edge Ephemeral Detection
		try {
			const res = await fetch('/api/visitor-info', { cache: 'no-store' });
			if (res.ok) {
				const data = await res.json();
				if (ipEl) ipEl.textContent = data.ip || 'Unavailable';
				
				const locParts = [data.city, data.region, data.country].filter(Boolean);
				if (locEl) {
					locEl.textContent = locParts.length > 0 
						? `${locParts.join(', ')} (${data.colo || 'Cloudflare Edge'})`
						: (data.colo ? `Edge Colo: ${data.colo}` : 'Resolved via Edge');
				}

				if (ispEl) {
					const asn = data.asn ? `AS${data.asn}` : '';
					const isp = data.isp ? `${data.isp}` : 'Broadband Provider';
					ispEl.textContent = asn ? `${isp} (${asn})` : isp;
				}
			} else {
				throw new Error('Edge endpoint responded with non-200');
			}
		} catch (err) {
			if (ipEl) ipEl.textContent = '127.0.0.1 (Local Edge)';
			if (locEl) locEl.textContent = 'Direct Connection';
			if (ispEl) ispEl.textContent = 'Cloudflare Protected';
		}
	}

	initTelemetry();
	document.addEventListener('astro:page-load', initTelemetry);
</script>

<style>
	.telemetry-card {
		margin-top: 2.5em;
	}

	/* EXPANDABLE PRIVACY & ARCHITECTURE NOTICE */
	.privacy-details {
		border: 1px solid rgba(22, 163, 74, 0.35);
		border-radius: 8px;
		background: rgba(34, 197, 94, 0.12);
		margin-bottom: 1.25em;
		transition: border-color 0.15s ease, background 0.15s ease;
	}
	:global(html[data-theme="dark"]) .privacy-details {
		background: rgba(16, 185, 129, 0.14);
		border-color: rgba(52, 211, 153, 0.35);
	}
	.privacy-details:hover {
		background: rgba(34, 197, 94, 0.16);
		border-color: rgba(234, 88, 12, 0.35);
	}
	:global(html[data-theme="dark"]) .privacy-details:hover {
		background: rgba(16, 185, 129, 0.18);
		border-color: rgba(255, 107, 0, 0.35);
	}

	.privacy-summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.6em 0.9em;
		cursor: pointer;
		user-select: none;
		list-style: none;
	}
	.privacy-summary::-webkit-details-marker {
		display: none;
	}
	.privacy-summary-left {
		display: flex;
		align-items: center;
		gap: 0.55em;
		flex-wrap: wrap;
	}
	.privacy-icon {
		color: #16a34a;
		flex-shrink: 0;
		transition: color 0.15s ease;
	}
	:global(html[data-theme="dark"]) .privacy-icon {
		color: #34d399;
	}
	.privacy-title {
		font-size: 0.82em;
		font-weight: 700;
		color: #15803d;
		transition: color 0.15s ease;
	}
	:global(html[data-theme="dark"]) .privacy-title {
		color: #86efac;
	}
	.privacy-tag {
		font-size: 0.78em;
		color: #166534;
		font-weight: 500;
		transition: color 0.15s ease;
	}
	:global(html[data-theme="dark"]) .privacy-tag {
		color: #a7f3d0;
	}

	.privacy-toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
		font-size: 0.76em;
		font-weight: 600;
		color: #15803d;
		transition: color 0.15s ease;
	}
	:global(html[data-theme="dark"]) .privacy-toggle {
		color: #86efac;
	}
	.privacy-details:hover .privacy-icon,
	.privacy-details:hover .privacy-title,
	.privacy-details:hover .privacy-tag,
	.privacy-details:hover .privacy-toggle,
	.privacy-details:hover .privacy-toggle-label,
	.privacy-details:hover .privacy-chevron,
	:global(html[data-theme="dark"]) .privacy-details:hover .privacy-icon,
	:global(html[data-theme="dark"]) .privacy-details:hover .privacy-title,
	:global(html[data-theme="dark"]) .privacy-details:hover .privacy-tag,
	:global(html[data-theme="dark"]) .privacy-details:hover .privacy-toggle,
	:global(html[data-theme="dark"]) .privacy-details:hover .privacy-toggle-label,
	:global(html[data-theme="dark"]) .privacy-details:hover .privacy-chevron {
		color: var(--accent) !important;
	}
	.privacy-chevron {
		transition: transform 0.2s ease, color 0.15s ease;
	}
	.privacy-details[open] .privacy-chevron {
		transform: rotate(180deg);
	}

	.privacy-body {
		padding: 0.75em 1em 0.95em 1em;
		border-top: 1px solid rgba(22, 163, 74, 0.22);
		display: flex;
		flex-direction: column;
		gap: 0.6em;
		animation: fadeIn 0.2s ease-in-out;
	}
	:global(html[data-theme="dark"]) .privacy-body {
		border-top-color: rgba(52, 211, 153, 0.25);
	}
	.privacy-body p {
		font-size: 0.8em;
		line-height: 1.55;
		color: #14532d;
		margin: 0;
	}
	:global(html[data-theme="dark"]) .privacy-body p {
		color: #d1fae5;
	}

	@keyframes fadeIn {
		from { opacity: 0; transform: translateY(-4px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.telemetry-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.6em;
		padding-bottom: 0.8em;
		margin-bottom: 1em;
		border-bottom: 1.5px solid var(--border-color);
	}
	.card-title {
		font-size: clamp(1.2em, 2.5vw, 1.35em);
		font-weight: 700;
		margin: 0;
		color: rgb(var(--black));
		display: flex;
		align-items: center;
		gap: 0.5em;
		letter-spacing: -0.01em;
		border-bottom: none;
		padding-bottom: 0;
	}
	.card-icon {
		color: var(--accent);
		flex-shrink: 0;
	}

	.telemetry-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
		gap: 1.1em 1.25em;
	}
	.telemetry-item {
		display: flex;
		flex-direction: column;
		gap: 0.25em;
		min-width: 0;
		overflow: hidden;
	}
	.t-label {
		font-size: 0.76em;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: rgb(var(--gray));
		margin-bottom: 0.1em;
	}
	.t-val {
		color: rgb(var(--gray-dark));
		font-weight: 600;
		font-size: 0.92em;
		line-height: 1.45;
		word-break: break-word;
	}
	.t-val.mono {
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
	}
	.t-val.ip-val {
		color: var(--accent);
		font-weight: 700;
	}

	@media (max-width: 600px) {
		.telemetry-grid {
			grid-template-columns: 1fr;
		}
		.telemetry-header {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
