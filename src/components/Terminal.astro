<span class="term-dim">[system halted in immutable squashfs]</span>`);
						setTimeout(() => {
							appendOutput('<span class="term-cyan">&rarr; System recovered. brobOS filesystem is protected by hardware write-protect jumper WP#1.</span>');
						}, 1800);
					} else {
						appendOutput(`
<span class="term-dim">[sudo] password for guest: &bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;</span>
<span class="term-err">guest is not in the sudoers file. This incident will be reported to /dev/null.</span>`);
					}
					break;

				case 'ls':
				case 'dir':
					appendOutput(`
<span class="term-dim">total 48</span>
drwxr-xr-x 2 guest brob 4096 Nov 06 23:30 <span class="term-cyan">models/</span>
drwxr-xr-x 4 guest brob 4096 Nov 06 23:30 <span class="term-cyan">src/</span>
-rwxr-xr-x 1 guest brob 8192 Nov 06 23:30 <span class="term-hl">brobOS.bin</span>*
-rw-r--r-- 1 guest brob 1064 Nov 06 23:30 LICENSE
-rw-r--r-- 1 guest brob 2048 Nov 06 23:30 README.md
-rw-r--r-- 1 guest brob  512 Nov 06 23:30 silicon_spec.json
<span class="term-dim">Tip: Try 'cat README.md' or 'cat silicon_spec.json'. Mistyped? Try 'sl'.</span>`);
					break;

				case 'cat':
					const targetFile = (args[0] || '').toLowerCase();
					if (!targetFile) {
						appendOutput('<span class="term-err">cat: missing file operand. Try "cat README.md" or "cat silicon_spec.json"</span>');
					} else if (targetFile === 'readme.md' || targetFile === 'readme') {
						appendOutput(`
<span class="term-head"># Bo Wu &bull; brob.uk</span>
Personal Portfolio &amp; Interactive Engineering Showcase.
Focusing on Silicon Validation, Embedded Linux &amp; 3D Parametric CAD.
Hosted on Cloudflare Edge with zero-logging ephemeral telemetry.`);
					} else if (targetFile === 'silicon_spec.json') {
						appendOutput(`
<span class="term-cyan">{
  "part": "BROB-VAL-SILICON",
  "die_id": "0x850C6005",
  "stepping": "A0",
  "process_node": "3nm FinFET",
  "interfaces": ["PCIe Gen5 x16", "DDR5-6400", "100GbE", "JTAG IEEE 1149.1"],
  "bist_status": "PASSED_100_PERCENT"
}</span>`);
					} else if (targetFile === 'license') {
						appendOutput('<span class="term-dim">MIT License &bull; Copyright (c) Bo Wu. Free to inspect, adapt, and build upon.</span>');
					} else if (targetFile === 'brobos.bin') {
						appendOutput('<span class="term-dim">&lt;ELF 64-bit LSB executable, x86-64, version 1 (SYSV), statically linked, stripped&gt;</span>');
					} else {
						appendOutput(`<span class="term-err">cat: ${escapeHtml(targetFile)}: No such file or directory</span>`);
					}
					break;

				case 'uname':
					if (args[0] === '-a' || args[0] === '--all') {
						appendOutput('Linux brob-edge 6.12.0-ate-val #1 SMP PREEMPT_DYNAMIC x86_64 GNU/Linux');
					} else {
						appendOutput('Linux');
					}
					break;

				case 'uptime':
					const upSecs = Math.floor(performance.now() / 1000);
					const upMins = Math.floor(upSecs / 60);
					const upHours = Math.floor(upMins / 60);
					const remM = upMins % 60;
					const timeNow = new Date().toTimeString().split(' ')[0];
					appendOutput(`${timeNow} up ${upHours > 0 ? `${upHours}h ` : ''}${remM} min, 1 user, load average: 0.04, 0.02, 0.00`);
					break;

				case 'fortune':
				case 'quote':
					const quotes = [
						'There are two types of hardware engineers: those who have shorted VDD to GND, and those who will.',
						'A capacitor installed backwards is just a chemical reaction waiting for a catalyst.',
						'If first tapeout works without a metal spin, check your validation test benches immediately.',
						'Software engineers think a byte is 8 bits; hardware engineers know a byte is 8 differential pairs, 16 termination resistors, and an EMI headache.',
						'Hardware is the part of the computer you can kick; software is the part you can only curse at.',
						'In theory, theory and practice are the same. In silicon, they are separated by 3 process nodes and a 20% yield drop.',
						'The fastest I/O is the I/O you never perform.'
					];
					const pick = quotes[Math.floor(Math.random() * quotes.length)];
					appendOutput(`<span class="term-cyan">&ldquo;${escapeHtml(pick)}&rdquo;</span>`);
					break;

				default:
					appendOutput(`<span class="term-err">brobsh: command not found: ${escapeHtml(cmd)}</span>. Type <span class="term-hl">'help'</span> for available commands.`);
					break;
			}
		}

		function scrollToSection(id: string) {
			closeTerminal();
			const el = document.getElementById(id);
			if (el) {
				el.scrollIntoView({ behavior: 'smooth' });
			}
		}

		function escapeHtml(str: string): string {
			return str
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/"/g, '&quot;')
				.replace(/'/g, '&#039;');
		}

		// Form submit
		form?.addEventListener('submit', (e) => {
			e.preventDefault();
			const cmd = input?.value || '';
			if (input) input.value = '';
			executeCommand(cmd);
		});

		// History & Tab completion
		input?.addEventListener('keydown', (e: KeyboardEvent) => {
			if (e.key === 'ArrowUp') {
				e.preventDefault();
				if (history.length > 0 && historyIndex > 0) {
					historyIndex--;
					input.value = history[historyIndex];
				}
			} else if (e.key === 'ArrowDown') {
				e.preventDefault();
				if (historyIndex < history.length - 1) {
					historyIndex++;
					input.value = history[historyIndex];
				} else {
					historyIndex = history.length;
					input.value = '';
				}
			} else if (e.key === 'Tab') {
				e.preventDefault();
				const current = input.value.trim().toLowerCase();
				if (!current) return;
				const match = COMMANDS.find(c => c.startsWith(current));
				if (match) {
					input.value = match;
				}
			} else if (e.ctrlKey && e.key.toLowerCase() === 'l') {
				e.preventDefault();
				clearOutput();
			} else if (e.ctrlKey && e.key.toLowerCase() === 'c') {
				e.preventDefault();
				appendEchoLine((input.value || '') + ' ^C');
				input.value = '';
			}
		});
	}

	initTerminal();
	document.addEventListener('astro:page-load', initTerminal);
</script>

