  SCAN_ENABLE: LOW (Functional Mode Active)
  BIST Result: <span class="term-hl">[PASS - ZERO DEFECTS DETECTED]</span>`);
					break;

				case 'peek':
					const peekAddr = args[0] ? args[0].toUpperCase() : '';
					if (peekAddr) {
						appendOutput(`[${escapeHtml(peekAddr)}] =&gt; <span class="term-hl">0xCAFEBABE</span> (<span class="term-cyan">MAGIC_SMOKE_STATUS: CONTAINED | REG_OK</span>)`);
					} else {
						appendOutput(`
<span class="term-head">Silicon Register Map Dump (Base: 0x00000000):</span>
  [0x00000000] = <span class="term-cyan">0x850C6005</span> (SILICON_DIE_ID)
  [0x00000004] = <span class="term-cyan">0x00000001</span> (STEPPING_A0_VALID)
  [0x00000008] = <span class="term-cyan">0xCAFEBABE</span> (CLOCK_PLL_LOCKED)
  [0x0000000C] = <span class="term-hl">0xDEADBEEF</span> (MAGIC_SMOKE_CONTAINED)
<span class="term-dim">Tip: Run 'peek &lt;hex_address&gt;' to probe arbitrary registers.</span>`);
					}
					break;

				case 'poke':
					const pokeAddr = args[0] ? args[0].toUpperCase() : '0x00000000';
					const pokeVal = args[1] ? args[1].toUpperCase() : '0x00000000';
					appendOutput(`[${escapeHtml(pokeAddr)}] &lt;= <span class="term-hl">${escapeHtml(pokeVal)}</span> (Register write committed via ATE JTAG interface).`);
					break;

				case 'gcode':
				case 'slice':
				case 'm104':
				case 'bambu':
					appendOutput(`
<span class="term-head">=== 3D PARAMETRIC MANUFACTURING TELEMETRY ===</span>
Active Job: <span class="term-hl">ASUS RT-BE92U Wi-Fi 7 Router Mount</span>
Material:   <span class="term-cyan">Bambu PETG-CF (Carbon Fiber Reinforced)</span>
Nozzle:     0.4 mm Hardened Steel @ <span class="term-hl">250&deg;C</span> (Target: 250&deg;C)
Bed Temp:   Engineering Plate @ <span class="term-hl">70&deg;C</span> (Target: 70&deg;C)
Bed Mesh:   16-point inductive leveling (Variance: 0.016 mm &plusmn; 0.002 mm)
Print Time: Layer 148 of 350 &bull; 42% complete &bull; Volumetric Flow: 18.5 mm&sup3;/s
Status:     Extruder pressure advance nominal &bull; Cooling fan 60%`);
					break;

				case 'matrix':
				case 'cmatrix':
					runMatrixEffect();
					break;

				case 'sl':
					runSteamLocomotive();
					break;

				case 'sudo':
					const fullArgs = args.join(' ').toLowerCase();
					if (fullArgs.includes('rm -rf') || fullArgs.includes('rm -r') || fullArgs.includes('format')) {
						appendOutput(`
<span class="term-err">[sudo] password for guest: &bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;</span>
