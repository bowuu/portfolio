---
// Terminal.astro - Interactive CLI Console & Navigation Drawer
---

<div id="terminal-modal" class="terminal-modal" aria-hidden="true">
	<div class="terminal-backdrop" id="terminal-backdrop"></div>
	<div class="terminal-window" id="terminal-window" role="dialog" aria-modal="true" aria-label="Terminal Console">
		<!-- LINUX-STYLE TERMINAL TITLEBAR -->
		<div class="terminal-header">
			<!-- Left: prompt icon + visual effect toggles (blur & transparency) -->
			<div class="terminal-header-meta">
				<svg class="term-title-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<polyline points="4 17 10 11 4 5"></polyline>
					<line x1="12" y1="19" x2="20" y2="19"></line>
				</svg>
				<button class="wm-btn wm-fx active" id="term-blur-btn" type="button" title="Toggle background blur ('blur')" aria-label="Toggle background blur">
					<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
						<path d="M8 1.75 C8 1.75 3.2 7.2 3.2 10.8 A4.8 4.8 0 0 0 12.8 10.8 C12.8 7.2 8 1.75 8 1.75 Z" fill="currentColor" fill-opacity="0.88"></path>
					</svg>
				</button>
				<button class="wm-btn wm-fx active" id="term-trans-btn" type="button" title="Toggle terminal transparency ('transparency')" aria-label="Toggle terminal transparency">
					<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor">
						<defs>
							<clipPath id="term-trans-clip">
								<rect x="2" y="2" width="12" height="12" rx="2.5"></rect>
							</clipPath>
						</defs>
						<rect x="2" y="2" width="12" height="12" rx="2.5" stroke-width="1.8"></rect>
						<g clip-path="url(#term-trans-clip)">
							<line x1="8" y1="2" x2="8" y2="14" stroke-width="1.2"></line>
							<line x1="2" y1="8" x2="14" y2="8" stroke-width="1.2"></line>
							<rect x="2" y="2" width="6" height="6" fill="currentColor" stroke="none"></rect>
							<rect x="8" y="8" width="6" height="6" fill="currentColor" stroke="none"></rect>
						</g>
					</svg>
				</button>
			</div>

			<!-- Center: session title -->
			<div class="terminal-title mono">
				<span>guest@brob:&thinsp;~</span>
			</div>

			<!-- Right: flat GTK-style window controls (−  □  ×) -->
			<div class="terminal-wm-btns" aria-label="Window controls">
				<button class="wm-btn wm-min" id="term-min-btn" type="button" title="Close (Esc)" aria-label="Minimize">
					<svg viewBox="0 0 10 10" width="10" height="10"><line x1="1" y1="5" x2="9" y2="5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
				</button>
				<button class="wm-btn wm-max" id="term-max-btn" type="button" title="Toggle fullscreen" aria-label="Maximize">
					<svg viewBox="0 0 10 10" width="10" height="10"><rect x="1.5" y="1.5" width="7" height="7" rx="1" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
				</button>
				<button class="wm-btn wm-close" id="term-close-btn" type="button" title="Close (exit / Esc)" aria-label="Close">
					<svg viewBox="0 0 10 10" width="10" height="10"><line x1="1.5" y1="1.5" x2="8.5" y2="8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><line x1="8.5" y1="1.5" x2="1.5" y2="8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
				</button>
			</div>
		</div>

		<!-- TERMINAL SCREEN BUFFER -->
		<div class="terminal-screen" id="terminal-screen">
			<div class="terminal-history" id="terminal-history">
				<div class="term-banner mono">
					<p class="banner-hint">Type <span class="term-hl">help</span> for available commands, <span class="term-hl">clear</span> to wipe screen, or <span class="term-hl">exit</span> to close. Tab autocompletes.</p>
					<p class="banner-hint">Type <span class="term-hl">blur</span> to toggle background blur, or <span class="term-hl">transparency</span> to toggle window glass (or use titlebar icons).</p>
				</div>
			</div>

			<!-- INLINE ACTIVE PROMPT (Flows naturally at bottom of buffer) -->
			<form class="terminal-prompt-row mono" id="terminal-form">
				<label for="terminal-input" class="term-prompt">
					<span class="p-user">guest@brob</span><span class="p-sep">:</span><span class="p-path" id="term-active-path">~/portfolio</span><span class="p-char">$</span>
				</label>
				<div class="term-input-wrap">
					<input 
						type="text" 
						id="terminal-input" 
						class="term-input mono" 
						autocomplete="off" 
						autocorrect="off" 
						autocapitalize="off" 
						spellcheck="false" 
						aria-label="Terminal command input"
					/>
				</div>
			</form>
		</div>
	</div>
</div>

<script>
	import * as vfs from '../lib/vfs';
	function initTerminal() {
		const modal = document.getElementById('terminal-modal');
		const win = document.getElementById('terminal-window');
		const backdrop = document.getElementById('terminal-backdrop');
		const closeBtn = document.getElementById('term-close-btn');
		const minBtn = document.getElementById('term-min-btn');
		const maxBtn = document.getElementById('term-max-btn');
		const form = document.getElementById('terminal-form');
		const input = document.getElementById('terminal-input') as HTMLInputElement | null;
		const screen = document.getElementById('terminal-screen');
		const historyEl = document.getElementById('terminal-history');
		const headerToggle = document.getElementById('terminal-toggle-btn');

		if (!modal || !win || !input || !screen || !historyEl) return;

		let history: string[] = [];
		let historyIndex = -1;

		const COMMANDS = [
			'help',
			'about',
			'skills',
			'projects',
			'tests',
			'network',
			'mouse',
			'keyboard',
			'cad',
			'debug',
			'theme',
			'transparency',
			'transparent',
			'opacity',
			'blur',
			'backdrop',
			'visitor',
			'whoami',
			'man',
			'pwd',
			'cd',
			'tree',
			'head',
			'tail',
			'grep',
			'date',
			'clear',
			'exit',
			'neofetch',
			'fastfetch',
			'dmesg',
			'bringup',
			'uboot',
			'boot',
			'gcode',
			'slice',
			'ls',
			'cat',
			'sudo',
			'uname',
			'uptime',
			'wafer',
			'sensors',
			'temp',
			'gravity',
			'tilt',
			'degauss',
			'cyclone',
			'dissolve',
			'thermal',
			'boop',
			'multiplier',
			'virtuoso',
			'extras'
		];

		function openTerminal() {
			modal?.classList.add('open');
			modal?.setAttribute('aria-hidden', 'false');
			setTimeout(() => {
				input?.focus();
				if (screen) screen.scrollTop = screen.scrollHeight;
			}, 60);
		}

		function closeTerminal() {
			modal?.classList.remove('open');
			modal?.setAttribute('aria-hidden', 'true');
		}

		function toggleTerminal() {
			if (modal?.classList.contains('open')) {
				closeTerminal();
			} else {
				openTerminal();
			}
		}

		function toggleMaximize() {
			win?.classList.toggle('maximized');
			setTimeout(() => {
				input?.focus();
				if (screen) screen.scrollTop = screen.scrollHeight;
			}, 50);
		}

		// Visual effect state & toggles
		const blurBtn = document.getElementById('term-blur-btn');
		const transBtn = document.getElementById('term-trans-btn');

		let isTransparent = true;
		let isBlurEnabled = true;

		function updateVisualButtons() {
			if (blurBtn) {
				blurBtn.classList.toggle('active', isBlurEnabled);
				blurBtn.title = isBlurEnabled ? "Background blur: ON (click or type 'blur off')" : "Background blur: OFF (click or type 'blur on')";
			}
			if (transBtn) {
				transBtn.classList.toggle('active', isTransparent);
				transBtn.title = isTransparent ? "Terminal transparency: ON (click or type 'transparency off')" : "Terminal transparency: OFF (click or type 'transparency on')";
			}
		}

		function toggleTransparency(targetState?: boolean): boolean {
			if (typeof targetState === 'boolean') {
				isTransparent = targetState;
			} else {
				isTransparent = !isTransparent;
			}

			if (isTransparent) {
				win.classList.remove('opaque');
			} else {
				win.classList.add('opaque');
			}
			updateVisualButtons();
			return isTransparent;
		}

		function toggleBlur(targetState?: boolean): boolean {
			if (typeof targetState === 'boolean') {
				isBlurEnabled = targetState;
			} else {
				isBlurEnabled = !isBlurEnabled;
			}

			if (isBlurEnabled) {
				modal.classList.remove('no-blur');
			} else {
				modal.classList.add('no-blur');
			}
			updateVisualButtons();
			return isBlurEnabled;
		}

		blurBtn?.addEventListener('click', () => {
			const next = toggleBlur();
			appendOutput(`Background blur filter is now ${next ? '<span class="term-green">ENABLED</span>' : '<span class="term-yellow">DISABLED</span>'}.`);
		});

		transBtn?.addEventListener('click', () => {
			const next = toggleTransparency();
			appendOutput(`Terminal window transparency is now ${next ? '<span class="term-green">ENABLED</span>' : '<span class="term-yellow">DISABLED</span>'}.`);
		});

		(window as any).__toggleTerminalTransparency = toggleTransparency;
		(window as any).__toggleTerminalBlur = toggleBlur;

		// Window control listeners
		headerToggle?.addEventListener('click', toggleTerminal);
		closeBtn?.addEventListener('click', closeTerminal);
		minBtn?.addEventListener('click', closeTerminal);
		maxBtn?.addEventListener('click', toggleMaximize);
		backdrop?.addEventListener('click', closeTerminal);

		// Click anywhere in terminal screen focuses input (authentic CLI UX)
		screen.addEventListener('click', (e) => {
			const selection = window.getSelection();
			if (selection && selection.toString().length > 0) return;
			const target = e.target as HTMLElement | null;
			if (target && target.tagName === 'A') return;
			input.focus();
		});

		// Global keyboard toggle (`~` or `Esc`)
		window.addEventListener('keydown', (e: KeyboardEvent) => {
			const target = e.target as HTMLElement | null;
			const isTyping = target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA') && target !== input;

			if ((e.key === '`' || e.key === '~') && !isTyping) {
				e.preventDefault();
				toggleTerminal();
			} else if ((e.key === 'Escape' || e.key === 'Esc') && modal.classList.contains('open')) {
				closeTerminal();
			}
		});

		function appendOutput(html: string) {
			const block = document.createElement('div');
			block.className = 'term-output-block mono';
			block.innerHTML = html;
			historyEl?.appendChild(block);
			if (screen) screen.scrollTop = screen.scrollHeight;
		}

		function appendEchoLine(cmdText: string) {
			const row = document.createElement('div');
			row.className = 'term-line mono';
			row.innerHTML = `<span class="term-prompt"><span class="p-user">guest@brob</span><span class="p-sep">:</span><span class="p-path">${escapeHtml(vfs.getDisplayPath())}</span><span class="p-char">$</span></span> <span class="term-cmd">${escapeHtml(cmdText)}</span>`;
			historyEl?.appendChild(row);
			if (screen) screen.scrollTop = screen.scrollHeight;
		}

		function clearOutput() {
			if (historyEl) {
				historyEl.innerHTML = '';
				if (screen) screen.scrollTop = 0;
			}
		}

		const MAN_PAGES: Record<string, string> = {
			man: `
<span class="term-head">NAME</span>
    man - interface to system reference manuals

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">man</span> [COMMAND]

<span class="term-head">DESCRIPTION</span>
    Format and display reference manual pages for brobOS internal commands.
    Try <span class="term-hl">'man uname'</span>, <span class="term-hl">'man ls'</span>, <span class="term-hl">'man cad'</span>, or <span class="term-hl">'man sensors'</span>.`,

			pwd: `
<span class="term-head">NAME</span>
    pwd - print name of current/working directory

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">pwd</span>

<span class="term-head">DESCRIPTION</span>
    Print the full resolved pathname of the current working directory.`,

			cd: `
<span class="term-head">NAME</span>
    cd - change the shell working directory

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">cd</span> [DIRECTORY]

<span class="term-head">DESCRIPTION</span>
    Change the working directory. With no argument, defaults to ~/portfolio.
    Supports ~, .., and - (previous working directory).`,

			tree: `
<span class="term-head">NAME</span>
    tree - list directory contents in a tree-like hierarchy

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">tree</span> [-L LEVEL] [DIRECTORY]

<span class="term-head">DESCRIPTION</span>
    Produce a depth-indented visual listing of files and directories in the VFS.`,

			head: `
<span class="term-head">NAME</span>
    head - output the first part of files

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">head</span> [-n LINES] [FILE]

<span class="term-head">DESCRIPTION</span>
    Print the first 10 lines (or LINES lines) of FILE to standard output.`,

			tail: `
<span class="term-head">NAME</span>
    tail - output the last part of files

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">tail</span> [-n LINES] [FILE]

<span class="term-head">DESCRIPTION</span>
    Print the last 10 lines (or LINES lines) of FILE to standard output.`,

			grep: `
<span class="term-head">NAME</span>
    grep - search file for lines matching a pattern

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">grep</span> PATTERN FILE

<span class="term-head">DESCRIPTION</span>
    Search for PATTERN in FILE and print matching lines with highlighted syntax.`,

			help: `
<span class="term-head">NAME</span>
    help - display quick command reference table

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">help</span> [COMMAND]

<span class="term-head">DESCRIPTION</span>
    Display two-column command table, or call <span class="term-hl">man [COMMAND]</span> when passed a target.`,

			uname: `
<span class="term-head">NAME</span>
    uname - print system and silicon kernel architecture

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">uname</span> [OPTION]...

<span class="term-head">DESCRIPTION</span>
    Print platform and kernel architecture information. With no OPTION, same as -s.

<span class="term-head">OPTIONS</span>
    <span class="term-cyan">-a, --all</span>
        print all information in sequence
    <span class="term-cyan">-s, --kernel-name</span>
        print the operating system / kernel name (Linux)
    <span class="term-cyan">-n, --nodename</span>
        print the network node hostname (brob-edge)
    <span class="term-cyan">-r, --kernel-release</span>
        print the operating system release (6.12.0-ate-val)
    <span class="term-cyan">-v, --kernel-version</span>
        print the operating system version (#1 SMP PREEMPT_DYNAMIC)
    <span class="term-cyan">-m, --machine</span>
        print the hardware machine architecture (x86_64)
    <span class="term-cyan">-o, --operating-system</span>
        print the operating system (GNU/Linux)

<span class="term-head">SEE ALSO</span>
    neofetch(1), dmesg(1), sensors(1)`,

			ls: `
<span class="term-head">NAME</span>
    ls - list directory contents

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">ls</span> [OPTION]...

<span class="term-head">DESCRIPTION</span>
    List information about the simulated rootfs directory contents.

<span class="term-head">OPTIONS</span>
    <span class="term-cyan">-a, --all</span>
        do not ignore hidden entries starting with . (.git, .brobrc)
    <span class="term-cyan">-l</span>
        use a long listing format with permissions, ownership, and sizes
    <span class="term-cyan">-h, --human-readable</span>
        with -l, print sizes in human readable format (e.g. 1K, 4K)

<span class="term-head">SEE ALSO</span>
    cat(1), tree(1)`,

			cad: `
<span class="term-head">NAME</span>
    cad - 3D parametric CAD viewer controller

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">cad</span> [spin|grid|slice|list]

<span class="term-head">DESCRIPTION</span>
    Query or control the Three.js WebGL CAD model viewport directly from shell.

<span class="term-head">SUBCOMMANDS</span>
    <span class="term-cyan">slice [0-100]</span>
        toggle interactive layer slicer toolpath visualizer or set cut plane (0-100%)
    <span class="term-cyan">spin</span>
        engage 10,000 RPM centrifuge dynamic stress test with dynamic g-force HUD
    <span class="term-cyan">grid</span>
        toggle the XY reference floor grid on / off
    <span class="term-cyan">list</span>
        list all 11 Autodesk Inventor CAD models in catalog`,

			theme: `
<span class="term-head">NAME</span>
    theme - user interface display mode switcher

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">theme</span> [dark|light|toggle]

<span class="term-head">DESCRIPTION</span>
    Inspect or alter the active color system across the portfolio.`,

			sensors: `
<span class="term-head">NAME</span>
    sensors - silicon junction thermal and voltage probes

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">sensors</span> [OPTION]...

<span class="term-head">DESCRIPTION</span>
    Query on-die thermal diodes and digital multiphase PMIC power delivery telemetry.

<span class="term-head">OPTIONS</span>
    <span class="term-cyan">-f, --fahrenheit</span>
        display thermal junction probes in degrees Fahrenheit instead of Celsius`,

			bringup: `
<span class="term-head">NAME</span>
    bringup - automated test equipment (ATE) silicon validation sequencer

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">bringup</span> [-f, --fast]

<span class="term-head">DESCRIPTION</span>
    Execute multi-stage hardware validation across PMIC voltage rails, clock PLL lock,
    LPDDR5 PHY eye training, PCIe Gen5 SerDes link training, and BIST scan chains.

<span class="term-head">OPTIONS</span>
    <span class="term-cyan">-f, --fast</span>
        skip simulated stage delays and output full validation report immediately`,

			uboot: `
<span class="term-head">NAME</span>
    uboot - embedded Linux Universal Bootloader firmware interface

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">uboot</span> [boot | env | printenv | bdinfo | md &lt;addr&gt;]
    <span class="term-hl">boot</span>

<span class="term-head">DESCRIPTION</span>
    Simulate embedded Linux platform bootloader. Inspect device tree blobs (FDT),
    U-Boot environment variables, DRAM bank registers, or trigger kernel execution.

<span class="term-head">SUBCOMMANDS</span>
    <span class="term-cyan">boot</span>       execute full bootloader autoboot sequence to Linux kernel
    <span class="term-cyan">printenv</span>   dump U-Boot bootloader environment variables
    <span class="term-cyan">bdinfo</span>     display board architecture and DRAM mapping
    <span class="term-cyan">md &lt;addr&gt;</span>  display memory dump at hexadecimal address (e.g. md 0x40000000)`,

			dmesg: `
<span class="term-head">NAME</span>
    dmesg - print or control the kernel ring buffer

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">dmesg</span> [OPTION]...

<span class="term-head">DESCRIPTION</span>
    Examine simulated silicon bringup and ATE automated test equipment ring buffer.

<span class="term-head">OPTIONS</span>
    <span class="term-cyan">-c, --clear</span>
        clear the ring buffer after printing contents
    <span class="term-cyan">-l, --level &lt;level&gt;</span>
        filter messages by level (err, warn, info)`,

			wafer: `
<span class="term-head">NAME</span>
    wafer - 300mm silicon wafer die sort map &amp; bin yield telemetry

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">wafer</span> [OPTION]...

<span class="term-head">DESCRIPTION</span>
    Render interactive ASCII die sort map for 300mm silicon wafer and compute bin defect yield.

<span class="term-head">OPTIONS</span>
    <span class="term-cyan">-g, --gui, --map</span>
        launch interactive 300mm silicon wafer sort GUI HUD inspector
    <span class="term-cyan">-s, --summary</span>
        display yield summary and bin breakdown without full wafer ASCII map`,

			cat: `
<span class="term-head">NAME</span>
    cat - concatenate and display file contents

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">cat</span> [FILE]...

<span class="term-head">DESCRIPTION</span>
    Output contents of simulated rootfs file to terminal standard output.

<span class="term-head">FILES</span>
    <span class="term-cyan">README.md</span>         Portfolio overview and engineering focus
    <span class="term-cyan">LICENSE</span>           MIT open source license`,

			neofetch: `
<span class="term-head">NAME</span>
    neofetch - silicon validation bench specs and ASCII badge

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">neofetch</span>

<span class="term-head">DESCRIPTION</span>
    Display silicon fabrication node, host specs, and color palette.`,

			about: `
<span class="term-head">NAME</span>
    about - hardware systems engineer background

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">about</span>

<span class="term-head">DESCRIPTION</span>
    Print technical focus, career highlights, and verified profile links.`,

			skills: `
<span class="term-head">NAME</span>
    skills - core engineering competencies

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">skills</span>

<span class="term-head">DESCRIPTION</span>
    Display competencies in Silicon Validation, Embedded Linux, and 3D Parametric CAD.`,

			projects: `
<span class="term-head">NAME</span>
    projects - featured hardware and 3D CAD showcase

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">projects</span>

<span class="term-head">DESCRIPTION</span>
    Enumerate featured physical engineering designs and models.`,

			tests: `
<span class="term-head">NAME</span>
    tests - navigate to hardware and network test suites

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">tests</span>

<span class="term-head">DESCRIPTION</span>
    Smooth scroll viewport to the live interactive hardware and network benchmark suites (#lab).`,

			network: `
<span class="term-head">NAME</span>
    network - Anycast edge throughput and latency test

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">network</span>

<span class="term-head">DESCRIPTION</span>
    Navigate to the Anycast edge throughput benchmark with unloaded ping, jitter, and bufferbloat (#benchmark).`,

			mouse: `
<span class="term-head">NAME</span>
    mouse - mouse polling rate and switch debounce lab

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">mouse</span>

<span class="term-head">DESCRIPTION</span>
    Navigate to the mouse polling oscilloscope, microswitch latency, and click counter lab (#input-lab).`,

			keyboard: `
<span class="term-head">NAME</span>
    keyboard - 104-key switch matrix and latency lab

<span class="term-head">SYNOPSIS</span>
