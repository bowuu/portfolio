					const tailLines = tailNIdx !== -1 && args[tailNIdx + 1] ? parseInt(args[tailNIdx + 1], 10) || 10 : 10;
					const tailTarget = args.find((a, i) => !a.startsWith('-') && (tailNIdx === -1 || i !== tailNIdx + 1)) || '';
					const tailRes = vfs.tailFile(tailTarget, tailLines);
					appendOutput(tailRes.output);
					break;

				case 'grep':
					const grepPattern = args[0] || '';
					const grepTarget = args[1] || '';
					const grepRes = vfs.grepFile(grepPattern, grepTarget);
					appendOutput(grepRes.output);
					break;

				case 'tree':
					const treeLIdx = args.findIndex(a => a === '-L' || a === '-d');
					const treeDepth = treeLIdx !== -1 && args[treeLIdx + 1] ? parseInt(args[treeLIdx + 1], 10) || 3 : 3;
					const treeTarget = args.find((a, i) => !a.startsWith('-') && (treeLIdx === -1 || i !== treeLIdx + 1)) || '';
					const treeRes = vfs.tree(treeTarget, treeDepth);
					appendOutput(treeRes.output);
					break;

				case 'uname':
					if (args.length === 0) {
						appendOutput('Linux');
					} else {
						let printS = false, printN = false, printR = false, printV = false, printM = false, printO = false;
						for (const a of args) {
							if (a === '-a' || a === '--all') {
								printS = printN = printR = printV = printM = printO = true;
							} else if (a.startsWith('--')) {
								if (a === '--kernel-name') printS = true;
								if (a === '--nodename') printN = true;
								if (a === '--kernel-release') printR = true;
								if (a === '--kernel-version') printV = true;
								if (a === '--machine') printM = true;
								if (a === '--operating-system') printO = true;
							} else if (a.startsWith('-')) {
								for (let i = 1; i < a.length; i++) {
									const c = a[i];
									if (c === 'a') printS = printN = printR = printV = printM = printO = true;
									else if (c === 's') printS = true;
									else if (c === 'n') printN = true;
									else if (c === 'r') printR = true;
									else if (c === 'v') printV = true;
									else if (c === 'm') printM = true;
									else if (c === 'o') printO = true;
								}
							}
						}
						const uOut: string[] = [];
						if (printS) uOut.push('Linux');
						if (printN) uOut.push('brob-edge');
						if (printR) uOut.push('6.12.0-ate-val');
						if (printV) uOut.push('#1 SMP PREEMPT_DYNAMIC');
						if (printM) uOut.push('x86_64');
						if (printO) uOut.push('GNU/Linux');
						appendOutput(uOut.length ? uOut.join(' ') : 'Linux');
					}
					break;

				case 'uptime':
					const upSecs = Math.floor(performance.now() / 1000);
					const upMins = Math.floor(upSecs / 60);
					const upHours = Math.floor(upMins / 60);
					const remM = upMins % 60;
					const timeNow = new Date().toTimeString().split(' ')[0];
					appendOutput(`${timeNow} up ${upHours > 0 ? `${upHours}h ` : ''}${remM} min, 1 user, load average: 0.04, 0.02, 0.00`);
					break;

				default:
					appendOutput(`<span class="term-err">brobsh: command not found: ${escapeHtml(cmd)}</span>. Type <span class="term-hl">'help'</span> for available commands.`);
					break;
			}
		}

		function scrollToSection(id: string) {
			closeTerminal();
			const el = document.getElementById(id);
			if (el) {
				el.scrollIntoView({ behavior: 'smooth' });
			}
		}

		function escapeHtml(str: string): string {
			return str
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/"/g, '&quot;')
				.replace(/'/g, '&#039;');
		}

		// Form submit
		form?.addEventListener('submit', (e) => {
			e.preventDefault();
			const cmd = input?.value || '';
			if (input) input.value = '';
			executeCommand(cmd);
		});

		// History & Tab completion
		input?.addEventListener('keydown', (e: KeyboardEvent) => {
			if (!e.repeat) {
				(window as any).__playSwitchSound?.(e.code || e.key);
			}
			if (e.key === 'ArrowUp') {
				e.preventDefault();
				if (history.length > 0 && historyIndex > 0) {
					historyIndex--;
					input.value = history[historyIndex];
				}
			} else if (e.key === 'ArrowDown') {
				e.preventDefault();
				if (historyIndex < history.length - 1) {
					historyIndex++;
					input.value = history[historyIndex];
				} else {
					historyIndex = history.length;
					input.value = '';
				}
			} else if (e.key === 'Tab') {
				e.preventDefault();
				const current = input.value;
				if (!current.trim()) return;

				const tokens = current.split(/\s+/);
				if (tokens.length <= 1) {
					const prefix = tokens[0].toLowerCase();
					const match = COMMANDS.find(c => c.startsWith(prefix));
					if (match) {
						input.value = match + ' ';
					}
				} else {
					const lastToken = tokens[tokens.length - 1];
					const matches = vfs.autocompletePath(lastToken);
					if (matches.length === 1) {
						tokens[tokens.length - 1] = matches[0];
						input.value = tokens.join(' ');
					} else if (matches.length > 1) {
						appendEchoLine(current);
						appendOutput(matches.map(m => `<span class="term-cyan">${escapeHtml(m)}</span>`).join('  '));
					}
				}
			} else if (e.ctrlKey && e.key.toLowerCase() === 'l') {
				e.preventDefault();
				clearOutput();
			} else if (e.ctrlKey && e.key.toLowerCase() === 'c') {
				e.preventDefault();
				appendEchoLine((input.value || '') + ' ^C');
				input.value = '';
			}
		});
	}

	initTerminal();
	document.addEventListener('astro:page-load', initTerminal);
</script>

