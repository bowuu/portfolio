---
// Terminal.astro - Interactive CLI Console & Navigation Drawer
---

<div id="terminal-modal" class="terminal-modal" aria-hidden="true">
	<div class="terminal-backdrop" id="terminal-backdrop"></div>
	<div class="terminal-window" id="terminal-window" role="dialog" aria-modal="true" aria-label="Terminal Console">
		<!-- LINUX-STYLE TERMINAL TITLEBAR -->
		<div class="terminal-header">
			<!-- Left: shell info badge -->
			<div class="terminal-header-meta mono">
				<svg class="term-title-icon" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2">
					<polyline points="4 17 10 11 4 5"></polyline>
					<line x1="12" y1="19" x2="20" y2="19"></line>
				</svg>
				<span class="term-meta-shell">brobsh</span>
			</div>

			<!-- Center: session title -->
			<div class="terminal-title mono">
				<span>guest@brob:&thinsp;~</span>
			</div>

			<!-- Right: flat GTK-style window controls -->
			<div class="terminal-wm-btns" aria-label="Window controls">
				<button class="wm-btn wm-min" id="term-min-btn" type="button" title="Close (Esc)" aria-label="Minimize">
					<svg viewBox="0 0 10 10" width="10" height="10"><line x1="1" y1="5" x2="9" y2="5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
				</button>
				<button class="wm-btn wm-max" id="term-max-btn" type="button" title="Toggle fullscreen" aria-label="Maximize">
					<svg viewBox="0 0 10 10" width="10" height="10"><rect x="1.5" y="1.5" width="7" height="7" rx="1" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
				</button>
				<button class="wm-btn wm-close" id="term-close-btn" type="button" title="Close (exit / Esc)" aria-label="Close">
					<svg viewBox="0 0 10 10" width="10" height="10"><line x1="1.5" y1="1.5" x2="8.5" y2="8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><line x1="8.5" y1="1.5" x2="1.5" y2="8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
				</button>
			</div>
		</div>

		<!-- TERMINAL SCREEN BUFFER -->
		<div class="terminal-screen" id="terminal-screen">
			<div class="terminal-history" id="terminal-history">
				<div class="term-banner mono">
					<p class="banner-hint">Type <span class="term-hl">help</span> for available commands, <span class="term-hl">clear</span> to wipe screen, or <span class="term-hl">exit</span> to close. Tab autocompletes.</p>
				</div>
			</div>

			<!-- INLINE ACTIVE PROMPT (Flows naturally at bottom of buffer) -->
			<form class="terminal-prompt-row mono" id="terminal-form">
				<label for="terminal-input" class="term-prompt">
					<span class="p-user">guest@brob</span><span class="p-sep">:</span><span class="p-path">~</span><span class="p-char">$</span>
				</label>
				<div class="term-input-wrap">
					<input 
						type="text" 
						id="terminal-input" 
						class="term-input mono" 
						autocomplete="off" 
						autocorrect="off" 
						autocapitalize="off" 
						spellcheck="false" 
						aria-label="Terminal command input"
					/>
				</div>
			</form>
		</div>
	</div>
</div>

<script>
	function initTerminal() {
		const modal = document.getElementById('terminal-modal');
		const win = document.getElementById('terminal-window');
		const backdrop = document.getElementById('terminal-backdrop');
		const closeBtn = document.getElementById('term-close-btn');
		const minBtn = document.getElementById('term-min-btn');
		const maxBtn = document.getElementById('term-max-btn');
		const form = document.getElementById('terminal-form');
		const input = document.getElementById('terminal-input') as HTMLInputElement | null;
		const screen = document.getElementById('terminal-screen');
		const historyEl = document.getElementById('terminal-history');
		const headerToggle = document.getElementById('terminal-toggle-btn');

		if (!modal || !win || !input || !screen || !historyEl) return;

		let history: string[] = [];
		let historyIndex = -1;

		const COMMANDS = [
			'help',
			'about',
			'skills',
			'projects',
			'tests',
			'network',
			'mouse',
			'keyboard',
			'cad',
			'debug',
			'theme',
			'visitor',
			'whoami',
			'man',
			'date',
			'clear',
			'exit',
			'neofetch',
			'fastfetch',
			'dmesg',
			'gcode',
			'slice',
			'matrix',
			'cmatrix',
			'sl',
			'ls',
			'cat',
			'sudo',
			'uname',
			'uptime',
			'wafer',
			'sensors',
			'temp'
		];

		function openTerminal() {
			modal?.classList.add('open');
			modal?.setAttribute('aria-hidden', 'false');
			setTimeout(() => {
				input?.focus();
				if (screen) screen.scrollTop = screen.scrollHeight;
			}, 60);
		}

		function closeTerminal() {
			modal?.classList.remove('open');
			modal?.setAttribute('aria-hidden', 'true');
		}

		function toggleTerminal() {
			if (modal?.classList.contains('open')) {
				closeTerminal();
			} else {
				openTerminal();
			}
		}

		function toggleMaximize() {
			win?.classList.toggle('maximized');
			setTimeout(() => {
				input?.focus();
				if (screen) screen.scrollTop = screen.scrollHeight;
			}, 50);
		}

		// Window control listeners
		headerToggle?.addEventListener('click', toggleTerminal);
		closeBtn?.addEventListener('click', closeTerminal);
		minBtn?.addEventListener('click', closeTerminal);
		maxBtn?.addEventListener('click', toggleMaximize);
		backdrop?.addEventListener('click', closeTerminal);

		// Click anywhere in terminal screen focuses input (authentic CLI UX)
		screen.addEventListener('click', (e) => {
			const selection = window.getSelection();
			if (selection && selection.toString().length > 0) return;
			const target = e.target as HTMLElement | null;
			if (target && target.tagName === 'A') return;
			input.focus();
		});

		// Global keyboard toggle (`~` or `Esc`)
		window.addEventListener('keydown', (e: KeyboardEvent) => {
			const target = e.target as HTMLElement | null;
			const isTyping = target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA') && target !== input;

			if ((e.key === '`' || e.key === '~') && !isTyping) {
				e.preventDefault();
				toggleTerminal();
			} else if (e.key === 'Escape' && modal.classList.contains('open')) {
				closeTerminal();
			}
		});

		function appendOutput(html: string) {
			const block = document.createElement('div');
			block.className = 'term-output-block mono';
			block.innerHTML = html;
			historyEl?.appendChild(block);
			if (screen) screen.scrollTop = screen.scrollHeight;
		}

		function appendEchoLine(cmdText: string) {
			const row = document.createElement('div');
			row.className = 'term-line mono';
			row.innerHTML = `<span class="term-prompt"><span class="p-user">guest@brob</span><span class="p-sep">:</span><span class="p-path">~</span><span class="p-char">$</span></span> <span class="term-cmd">${escapeHtml(cmdText)}</span>`;
			historyEl?.appendChild(row);
			if (screen) screen.scrollTop = screen.scrollHeight;
		}

		function clearOutput() {
			if (historyEl) {
				historyEl.innerHTML = '';
				if (screen) screen.scrollTop = 0;
			}
		}

		function runSteamLocomotive() {
			appendOutput(`
<div class="term-sl-block">
  <pre class="term-sl-train">
      ====        ________                ___________
  _D _|  |_______/        \\__I_I_____===__|_________|
   |(_)---  |   H\\________/ _____ \\   (|        |
   /     |===========|   //     \\\\     |        |
  |      |           |  //  (O)  \\\\    |        |
  |________\\_chuu-chuu_//________\\\\___|________|
   (O)(O)               (O)(O)        (O)(O)
  </pre>
  <div class="term-dim">🚂 Choo Choo! (Did you mean 'ls'?)</div>
</div>`);
		}

		function runMatrixEffect() {
			if (!screen) return;
			const canvas = document.createElement('canvas');
			canvas.className = 'term-matrix-overlay';
			screen.appendChild(canvas);

			const ctx = canvas.getContext('2d');
			if (!ctx) return;

			canvas.width = screen.clientWidth;
			canvas.height = screen.clientHeight;

			const chars = '0123456789ABCDEFｦｱｳｴｵｶｷｹｺｻｼｽｾｿﾀﾂﾃﾅﾆﾇﾈﾊﾋﾎﾏﾐﾑﾒﾓﾔﾕﾗﾘﾜ';
			const fontSize = 13;
			const cols = Math.floor(canvas.width / fontSize);
			const drops: number[] = Array(cols).fill(1);

			let animId: number;
			let isTerminated = false;

			function stopMatrix() {
				if (isTerminated) return;
				isTerminated = true;
				cancelAnimationFrame(animId);
				canvas.remove();
				window.removeEventListener('keydown', handleKey);
				appendOutput('<span class="term-cyan">Wake up, guest... Matrix diagnostic complete.</span>');
			}

			function handleKey() {
				stopMatrix();
			}
			window.addEventListener('keydown', handleKey, { once: true });
			canvas.addEventListener('click', stopMatrix);

			function draw() {
				ctx!.fillStyle = 'rgba(10, 12, 16, 0.12)';
				ctx!.fillRect(0, 0, canvas.width, canvas.height);

				ctx!.fillStyle = '#22c55e';
				ctx!.font = `${fontSize}px monospace`;

				for (let i = 0; i < drops.length; i++) {
					const text = chars.charAt(Math.floor(Math.random() * chars.length));
					ctx!.fillText(text, i * fontSize, drops[i] * fontSize);

					if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) {
						drops[i] = 0;
					}
					drops[i]++;
				}
				animId = requestAnimationFrame(draw);
			}
			draw();

			setTimeout(() => {
				stopMatrix();
			}, 3500);
		}

		const MAN_PAGES: Record<string, string> = {
			man: `
<span class="term-head">NAME</span>
    man - interface to system reference manuals

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">man</span> [COMMAND]

<span class="term-head">DESCRIPTION</span>
    Format and display reference manual pages for brobOS internal commands.
    Try <span class="term-hl">'man uname'</span>, <span class="term-hl">'man ls'</span>, <span class="term-hl">'man cad'</span>, or <span class="term-hl">'man sensors'</span>.`,

			help: `
<span class="term-head">NAME</span>
    help - display quick command reference table

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">help</span> [COMMAND]

<span class="term-head">DESCRIPTION</span>
    Display two-column command table, or call <span class="term-hl">man [COMMAND]</span> when passed a target.`,

			uname: `
<span class="term-head">NAME</span>
    uname - print system and silicon kernel architecture

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">uname</span> [OPTION]...

<span class="term-head">DESCRIPTION</span>
    Print platform and kernel architecture information. With no OPTION, same as -s.

<span class="term-head">OPTIONS</span>
    <span class="term-cyan">-a, --all</span>
        print all information in sequence
    <span class="term-cyan">-s, --kernel-name</span>
        print the operating system / kernel name (Linux)
    <span class="term-cyan">-n, --nodename</span>
        print the network node hostname (brob-edge)
    <span class="term-cyan">-r, --kernel-release</span>
        print the operating system release (6.12.0-ate-val)
    <span class="term-cyan">-v, --kernel-version</span>
        print the operating system version (#1 SMP PREEMPT_DYNAMIC)
    <span class="term-cyan">-m, --machine</span>
        print the hardware machine architecture (x86_64)
    <span class="term-cyan">-o, --operating-system</span>
        print the operating system (GNU/Linux)

<span class="term-head">SEE ALSO</span>
    neofetch(1), dmesg(1), sensors(1)`,

			ls: `
<span class="term-head">NAME</span>
    ls - list directory contents

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">ls</span> [OPTION]...

<span class="term-head">DESCRIPTION</span>
    List information about the simulated rootfs directory contents.

<span class="term-head">OPTIONS</span>
    <span class="term-cyan">-a, --all</span>
        do not ignore hidden entries starting with . (.git, .brobrc)
    <span class="term-cyan">-l</span>
        use a long listing format with permissions, ownership, and sizes
    <span class="term-cyan">-h, --human-readable</span>
        with -l, print sizes in human readable format (e.g. 1K, 4K)

<span class="term-head">SEE ALSO</span>
    cat(1), sl(1)`,

			cad: `
<span class="term-head">NAME</span>
    cad - 3D parametric CAD viewer controller

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">cad</span> [spin|grid|list]

<span class="term-head">DESCRIPTION</span>
    Query or control the Three.js WebGL CAD model viewport directly from shell.

<span class="term-head">SUBCOMMANDS</span>
    <span class="term-cyan">spin</span>
        engage 10,000 RPM centrifuge dynamic stress test with dynamic g-force HUD
