			date: `
<span class="term-head">NAME</span>
    date - print current system date and time

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">date</span>

<span class="term-head">DESCRIPTION</span>
    Display current UTC and local timestamp according to edge runtime.`,

			clear: `
<span class="term-head">NAME</span>
    clear - clear the terminal screen

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">clear</span>

<span class="term-head">DESCRIPTION</span>
    Clear scrollback buffer history.`,

			exit: `
<span class="term-head">NAME</span>
    exit - close the brobOS terminal session

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">exit</span>

<span class="term-head">DESCRIPTION</span>
    Close the terminal modal interface.`,

			gcode: `
<span class="term-head">NAME</span>
    gcode - 3D printer telemetry &amp; bed mesh leveling report

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">gcode</span>

<span class="term-head">DESCRIPTION</span>
    Display simulated Bambu Lab PETG-CF print metrics, hotend thermals, and bed variance.`,

			matrix: `
<span class="term-head">NAME</span>
    matrix - cascading digital rain diagnostic

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">matrix</span>

<span class="term-head">DESCRIPTION</span>
    Stream simulated green phosphor digital rain (cmatrix).`,

			sl: `
<span class="term-head">NAME</span>
    sl - cure your bad habit of mistyping

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">sl</span>

<span class="term-head">DESCRIPTION</span>
    Steam Locomotive travels across your terminal when you mistype 'ls'.`,

			sudo: `
<span class="term-head">NAME</span>
    sudo - execute a command as another user

<span class="term-head">SYNOPSIS</span>
    <span class="term-hl">sudo</span> COMMAND...

<span class="term-head">DESCRIPTION</span>
    Simulate administrative privilege escalation request.`
		};

		function showManPage(page: string) {
			const p = page.toLowerCase();
			if (MAN_PAGES[p]) {
				appendOutput(MAN_PAGES[p]);
			} else {
				appendOutput(`<span class="term-err">No manual entry for ${escapeHtml(page)}</span>. Type <span class="term-hl">'help'</span> for available commands.`);
			}
		}

		function executeCommand(rawCmd: string) {
			const trimmed = rawCmd.trim();

			// Echo executed line
			appendEchoLine(trimmed);

			if (!trimmed) {
				return;
			}

			// Add to history
			history.push(trimmed);
			historyIndex = history.length;

			const parts = trimmed.split(/\s+/);
			const cmd = parts[0].toLowerCase();
			const args = parts.slice(1);

			// Check for --help or help <cmd>
			if (args.includes('--help') || (args.includes('-h') && cmd !== 'ls')) {
				showManPage(cmd);
				return;
			}
			if (cmd === 'help' && args.length > 0) {
				showManPage(args[0]);
				return;
			}

			switch (cmd) {
				case 'man':
					const manTarget = (args[0] || '').toLowerCase();
					if (!manTarget) {
						appendOutput("What manual page do you want? Try <span class=\"term-hl\">'man uname'</span>, <span class=\"term-hl\">'man ls'</span>, <span class=\"term-hl\">'man cad'</span>, or <span class=\"term-hl\">'help'</span>.");
					} else {
						showManPage(manTarget);
					}
					break;

				case 'help':
					appendOutput(`
<span class="term-head">brobOS 1.0.0(1)-release (x86_64-brob-linux-edge)</span>
These shell commands are defined internally. Type <span class="term-hl">'help'</span> to see this list.

  <span class="term-col">Core System &amp; Navigation</span> <span class="term-col">Description</span>
