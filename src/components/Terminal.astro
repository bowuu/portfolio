<span class="term-dim">Tip: Try 'cat README.md' or 'cat silicon_spec.json'. Mistyped? Try 'sl'.</span>`);
					} else {
						if (lsIsAll) {
							appendOutput(`<span class="term-cyan">.</span>  <span class="term-cyan">..</span>  .brobrc  <span class="term-cyan">.git/</span>  <span class="term-hl">brobOS.bin</span>*  LICENSE  <span class="term-cyan">models/</span>  README.md  silicon_spec.json  <span class="term-cyan">src/</span>`);
						} else {
							appendOutput(`<span class="term-hl">brobOS.bin</span>*  LICENSE  <span class="term-cyan">models/</span>  README.md  silicon_spec.json  <span class="term-cyan">src/</span>`);
					}
					}
					break;

				case 'cat':
					const targetFile = (args[0] || '').toLowerCase();
					if (!targetFile) {
						appendOutput('<span class="term-err">cat: missing file operand. Try "cat README.md" or "cat silicon_spec.json"</span>');
					} else if (targetFile === 'readme.md' || targetFile === 'readme') {
						appendOutput(`
<span class="term-head"># Bo Wu &bull; brob.uk</span>
Personal Portfolio &amp; Interactive Engineering Showcase.
Focusing on Silicon Validation, Embedded Linux &amp; 3D Parametric CAD.
Hosted on Cloudflare Edge with zero-logging ephemeral telemetry.`);
					} else if (targetFile === 'silicon_spec.json') {
						appendOutput(`
<span class="term-cyan">{
  "part": "BROB-VAL-SILICON",
  "die_id": "0x850C6005",
  "stepping": "A0",
  "process_node": "3nm FinFET",
  "interfaces": ["PCIe Gen5 x16", "DDR5-6400", "100GbE", "JTAG IEEE 1149.1"],
  "bist_status": "PASSED_100_PERCENT"
}</span>`);
					} else if (targetFile === 'license') {
						appendOutput('<span class="term-dim">MIT License &bull; Copyright (c) Bo Wu. Free to inspect, adapt, and build upon.</span>');
					} else if (targetFile === 'brobos.bin') {
						appendOutput('<span class="term-dim">&lt;ELF 64-bit LSB executable, x86-64, version 1 (SYSV), statically linked, stripped&gt;</span>');
					} else {
						appendOutput(`<span class="term-err">cat: ${escapeHtml(targetFile)}: No such file or directory</span>`);
					}
					break;

				case 'uname':
					if (args.length === 0) {
						appendOutput('Linux');
					} else {
						let printS = false, printN = false, printR = false, printV = false, printM = false, printO = false;
						for (const a of args) {
							if (a === '-a' || a === '--all') {
								printS = printN = printR = printV = printM = printO = true;
							} else if (a.startsWith('--')) {
								if (a === '--kernel-name') printS = true;
								if (a === '--nodename') printN = true;
								if (a === '--kernel-release') printR = true;
								if (a === '--kernel-version') printV = true;
								if (a === '--machine') printM = true;
								if (a === '--operating-system') printO = true;
							} else if (a.startsWith('-')) {
								for (let i = 1; i < a.length; i++) {
									const c = a[i];
									if (c === 'a') printS = printN = printR = printV = printM = printO = true;
									else if (c === 's') printS = true;
									else if (c === 'n') printN = true;
									else if (c === 'r') printR = true;
									else if (c === 'v') printV = true;
									else if (c === 'm') printM = true;
									else if (c === 'o') printO = true;
								}
							}
						}
						const uOut: string[] = [];
						if (printS) uOut.push('Linux');
						if (printN) uOut.push('brob-edge');
						if (printR) uOut.push('6.12.0-ate-val');
						if (printV) uOut.push('#1 SMP PREEMPT_DYNAMIC');
						if (printM) uOut.push('x86_64');
						if (printO) uOut.push('GNU/Linux');
						appendOutput(uOut.length ? uOut.join(' ') : 'Linux');
					}
					break;

				case 'uptime':
					const upSecs = Math.floor(performance.now() / 1000);
					const upMins = Math.floor(upSecs / 60);
					const upHours = Math.floor(upMins / 60);
					const remM = upMins % 60;
					const timeNow = new Date().toTimeString().split(' ')[0];
					appendOutput(`${timeNow} up ${upHours > 0 ? `${upHours}h ` : ''}${remM} min, 1 user, load average: 0.04, 0.02, 0.00`);
					break;

				default:
					appendOutput(`<span class="term-err">brobsh: command not found: ${escapeHtml(cmd)}</span>. Type <span class="term-hl">'help'</span> for available commands.`);
					break;
			}
		}

		function scrollToSection(id: string) {
			closeTerminal();
			const el = document.getElementById(id);
			if (el) {
				el.scrollIntoView({ behavior: 'smooth' });
			}
		}

		function escapeHtml(str: string): string {
			return str
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/"/g, '&quot;')
				.replace(/'/g, '&#039;');
		}

		// Form submit
		form?.addEventListener('submit', (e) => {
			e.preventDefault();
			const cmd = input?.value || '';
			if (input) input.value = '';
			executeCommand(cmd);
		});

		// History & Tab completion
		input?.addEventListener('keydown', (e: KeyboardEvent) => {
			if (e.key === 'ArrowUp') {
				e.preventDefault();
				if (history.length > 0 && historyIndex > 0) {
					historyIndex--;
					input.value = history[historyIndex];
				}
			} else if (e.key === 'ArrowDown') {
				e.preventDefault();
				if (historyIndex < history.length - 1) {
					historyIndex++;
					input.value = history[historyIndex];
				} else {
					historyIndex = history.length;
					input.value = '';
				}
			} else if (e.key === 'Tab') {
				e.preventDefault();
				const current = input.value.trim().toLowerCase();
				if (!current) return;
				const match = COMMANDS.find(c => c.startsWith(current));
				if (match) {
					input.value = match;
				}
			} else if (e.ctrlKey && e.key.toLowerCase() === 'l') {
				e.preventDefault();
				clearOutput();
			} else if (e.ctrlKey && e.key.toLowerCase() === 'c') {
				e.preventDefault();
				appendEchoLine((input.value || '') + ' ^C');
				input.value = '';
			}
		});
	}

	initTerminal();
	document.addEventListener('astro:page-load', initTerminal);
</script>

