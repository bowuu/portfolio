---
// Terminal.astro - Interactive CLI Console & Navigation Drawer
---

<div id="terminal-modal" class="terminal-modal" aria-hidden="true">
	<div class="terminal-backdrop" id="terminal-backdrop"></div>
	<div class="terminal-window" id="terminal-window" role="dialog" aria-modal="true" aria-label="Terminal Console">
		<!-- LINUX-STYLE TERMINAL TITLEBAR -->
		<div class="terminal-header">
			<!-- Left: shell info badge -->
			<div class="terminal-header-meta mono">
				<svg class="term-title-icon" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2">
					<polyline points="4 17 10 11 4 5"></polyline>
					<line x1="12" y1="19" x2="20" y2="19"></line>
				</svg>
				<span class="term-meta-shell">brobsh</span>
			</div>

			<!-- Center: session title -->
			<div class="terminal-title mono">
				<span>guest@brob:&thinsp;~</span>
			</div>

			<!-- Right: flat GTK-style window controls -->
			<div class="terminal-wm-btns" aria-label="Window controls">
				<button class="wm-btn wm-min" id="term-min-btn" type="button" title="Close (Esc)" aria-label="Minimize">
					<svg viewBox="0 0 10 10" width="10" height="10"><line x1="1" y1="5" x2="9" y2="5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
				</button>
				<button class="wm-btn wm-max" id="term-max-btn" type="button" title="Toggle fullscreen" aria-label="Maximize">
					<svg viewBox="0 0 10 10" width="10" height="10"><rect x="1.5" y="1.5" width="7" height="7" rx="1" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
				</button>
				<button class="wm-btn wm-close" id="term-close-btn" type="button" title="Close (exit / Esc)" aria-label="Close">
					<svg viewBox="0 0 10 10" width="10" height="10"><line x1="1.5" y1="1.5" x2="8.5" y2="8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><line x1="8.5" y1="1.5" x2="1.5" y2="8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
				</button>
			</div>
		</div>

		<!-- TERMINAL SCREEN BUFFER -->
		<div class="terminal-screen" id="terminal-screen">
			<div class="terminal-history" id="terminal-history">
				<div class="term-banner mono">
					<p class="banner-hint">Type <span class="term-hl">help</span> for available commands, <span class="term-hl">clear</span> to wipe screen, or <span class="term-hl">exit</span> to close. Tab autocompletes.</p>
				</div>
			</div>

			<!-- INLINE ACTIVE PROMPT (Flows naturally at bottom of buffer) -->
			<form class="terminal-prompt-row mono" id="terminal-form">
				<label for="terminal-input" class="term-prompt">
					<span class="p-user">guest@brob</span><span class="p-sep">:</span><span class="p-path">~</span><span class="p-char">$</span>
				</label>
				<div class="term-input-wrap">
					<input 
						type="text" 
						id="terminal-input" 
						class="term-input mono" 
						autocomplete="off" 
						autocorrect="off" 
						autocapitalize="off" 
						spellcheck="false" 
						aria-label="Terminal command input"
					/>
				</div>
			</form>
		</div>
	</div>
</div>

<script>
	function initTerminal() {
		const modal = document.getElementById('terminal-modal');
		const win = document.getElementById('terminal-window');
		const backdrop = document.getElementById('terminal-backdrop');
		const closeBtn = document.getElementById('term-close-btn');
		const minBtn = document.getElementById('term-min-btn');
		const maxBtn = document.getElementById('term-max-btn');
		const form = document.getElementById('terminal-form');
		const input = document.getElementById('terminal-input') as HTMLInputElement | null;
		const screen = document.getElementById('terminal-screen');
		const historyEl = document.getElementById('terminal-history');
		const headerToggle = document.getElementById('terminal-toggle-btn');

		if (!modal || !win || !input || !screen || !historyEl) return;

		let history: string[] = [];
		let historyIndex = -1;

		const COMMANDS = [
			'help',
			'about',
			'skills',
			'projects',
			'tests',
			'network',
			'mouse',
			'keyboard',
			'cad',
			'debug',
			'theme',
			'visitor',
			'whoami',
			'date',
			'clear',
			'exit',
			'neofetch',
			'fastfetch',
			'dmesg',
			'jtag',
			'peek',
			'poke',
			'gcode',
			'slice',
			'matrix',
			'cmatrix',
			'sl',
			'ls',
			'cat',
			'sudo',
			'uname',
			'uptime',
			'fortune'
		];

		function openTerminal() {
			modal?.classList.add('open');
			modal?.setAttribute('aria-hidden', 'false');
			setTimeout(() => {
				input?.focus();
				if (screen) screen.scrollTop = screen.scrollHeight;
			}, 60);
		}

		function closeTerminal() {
			modal?.classList.remove('open');
			modal?.setAttribute('aria-hidden', 'true');
		}

		function toggleTerminal() {
			if (modal?.classList.contains('open')) {
				closeTerminal();
			} else {
				openTerminal();
			}
		}

		function toggleMaximize() {
			win?.classList.toggle('maximized');
			setTimeout(() => {
				input?.focus();
				if (screen) screen.scrollTop = screen.scrollHeight;
			}, 50);
		}

		// Window control listeners
		headerToggle?.addEventListener('click', toggleTerminal);
		closeBtn?.addEventListener('click', closeTerminal);
		minBtn?.addEventListener('click', closeTerminal);
		maxBtn?.addEventListener('click', toggleMaximize);
		backdrop?.addEventListener('click', closeTerminal);

		// Click anywhere in terminal screen focuses input (authentic CLI UX)
		screen.addEventListener('click', (e) => {
			const selection = window.getSelection();
			if (selection && selection.toString().length > 0) return;
			const target = e.target as HTMLElement | null;
			if (target && target.tagName === 'A') return;
			input.focus();
		});

		// Global keyboard toggle (`~` or `Esc`)
		window.addEventListener('keydown', (e: KeyboardEvent) => {
			const target = e.target as HTMLElement | null;
			const isTyping = target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA') && target !== input;

			if ((e.key === '`' || e.key === '~') && !isTyping) {
				e.preventDefault();
				toggleTerminal();
			} else if (e.key === 'Escape' && modal.classList.contains('open')) {
				closeTerminal();
			}
		});

		function appendOutput(html: string) {
			const block = document.createElement('div');
			block.className = 'term-output-block mono';
			block.innerHTML = html;
			historyEl?.appendChild(block);
			if (screen) screen.scrollTop = screen.scrollHeight;
		}

		function appendEchoLine(cmdText: string) {
			const row = document.createElement('div');
			row.className = 'term-line mono';
			row.innerHTML = `<span class="term-prompt"><span class="p-user">guest@brob</span><span class="p-sep">:</span><span class="p-path">~</span><span class="p-char">$</span></span> <span class="term-cmd">${escapeHtml(cmdText)}</span>`;
			historyEl?.appendChild(row);
			if (screen) screen.scrollTop = screen.scrollHeight;
		}

		function clearOutput() {
			if (historyEl) {
				historyEl.innerHTML = '';
				if (screen) screen.scrollTop = 0;
			}
		}

		function runSteamLocomotive() {
			appendOutput(`
<div class="term-sl-block">
  <pre class="term-sl-train">
      ====        ________                ___________
  _D _|  |_______/        \\__I_I_____===__|_________|
   |(_)---  |   H\\________/ _____ \\   (|        |
   /     |===========|   //     \\\\     |        |
  |      |           |  //  (O)  \\\\    |        |
  |________\\_chuu-chuu_//________\\\\___|________|
   (O)(O)               (O)(O)        (O)(O)
  </pre>
  <div class="term-dim">🚂 Choo Choo! (Did you mean 'ls'?)</div>
</div>`);
		}

		function runMatrixEffect() {
			if (!screen) return;
			const canvas = document.createElement('canvas');
			canvas.className = 'term-matrix-overlay';
			screen.appendChild(canvas);

			const ctx = canvas.getContext('2d');
			if (!ctx) return;

			canvas.width = screen.clientWidth;
			canvas.height = screen.clientHeight;

			const chars = '0123456789ABCDEFｦｱｳｴｵｶｷｹｺｻｼｽｾｿﾀﾂﾃﾅﾆﾇﾈﾊﾋﾎﾏﾐﾑﾒﾓﾔﾕﾗﾘﾜ';
			const fontSize = 13;
			const cols = Math.floor(canvas.width / fontSize);
			const drops: number[] = Array(cols).fill(1);

			let animId: number;
			let isTerminated = false;

			function stopMatrix() {
				if (isTerminated) return;
				isTerminated = true;
				cancelAnimationFrame(animId);
				canvas.remove();
				window.removeEventListener('keydown', handleKey);
				appendOutput('<span class="term-cyan">Wake up, guest... Matrix diagnostic complete.</span>');
			}

			function handleKey() {
				stopMatrix();
			}
			window.addEventListener('keydown', handleKey, { once: true });
			canvas.addEventListener('click', stopMatrix);

			function draw() {
				ctx!.fillStyle = 'rgba(10, 12, 16, 0.12)';
				ctx!.fillRect(0, 0, canvas.width, canvas.height);

				ctx!.fillStyle = '#22c55e';
				ctx!.font = `${fontSize}px monospace`;

				for (let i = 0; i < drops.length; i++) {
					const text = chars.charAt(Math.floor(Math.random() * chars.length));
					ctx!.fillText(text, i * fontSize, drops[i] * fontSize);

					if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) {
						drops[i] = 0;
					}
					drops[i]++;
				}
				animId = requestAnimationFrame(draw);
			}
			draw();

			setTimeout(() => {
				stopMatrix();
			}, 3500);
		}

		function executeCommand(rawCmd: string) {
			const trimmed = rawCmd.trim();

			// Echo executed line
			appendEchoLine(trimmed);

			if (!trimmed) {
				return;
			}

			// Add to history
			history.push(trimmed);
			historyIndex = history.length;

			const parts = trimmed.split(/\s+/);
			const cmd = parts[0].toLowerCase();
			const args = parts.slice(1);

			switch (cmd) {
				case 'help':
					appendOutput(`
<span class="term-head">brobOS 1.0.0(1)-release (x86_64-brob-linux-edge)</span>
These shell commands are defined internally. Type <span class="term-hl">'help'</span> to see this list.

  <span class="term-col">Core System &amp; Navigation</span> <span class="term-col">Description</span>
  <span class="term-dim">------------------------ ------------------------------------------------------------</span>
  <span class="term-hl">about</span>                    Hardware engineering background, focus &amp; profile links
  <span class="term-hl">skills</span>                   Silicon validation, embedded Linux &amp; 3D CAD platforms
  <span class="term-hl">projects</span>                 Featured engineering projects &amp; 3D CAD portfolio
  <span class="term-hl">tests</span>                    Navigate to hardware &amp; network test suites (#lab)
  <span class="term-hl">network</span>                  Navigate to Anycast edge throughput benchmark (#benchmark)
  <span class="term-hl">mouse</span>                    Navigate to mouse polling oscilloscope &amp; button lab (#input-lab)
  <span class="term-hl">keyboard</span>                 Navigate to 104-key switch matrix &amp; latency lab (#keyboard-lab)
  <span class="term-hl">cad</span> [spin|grid]          List 11 3D CAD models ('cad spin' or 'cad grid')
  <span class="term-hl">debug</span>                    Navigate to client hardware &amp; edge telemetry (#debug)
  <span class="term-hl">theme</span> [mode]             Obsidian Dark / Clean Light theme toggle [dark|light|toggle]
  <span class="term-hl">visitor</span>                  Query anonymous Cloudflare D1 visitor counter
  <span class="term-hl">whoami</span>                   Display client session &amp; Anycast edge telemetry info
  <span class="term-hl">date</span> / <span class="term-hl">clear</span> / <span class="term-hl">exit</span>      Standard shell session utilities

  <span class="term-col">Hardware Diagnostics</span>     <span class="term-col">Description</span>
  <span class="term-dim">------------------------ ------------------------------------------------------------</span>
  <span class="term-hl">neofetch</span>                 Silicon validation bench summary &amp; die specs
  <span class="term-hl">dmesg</span>                    Simulated silicon bringup &amp; ATE kernel ring buffer
  <span class="term-hl">jtag</span>                     JTAG TAP controller diagnostic &amp; boundary scan report
  <span class="term-hl">peek</span> [addr]              Read 32-bit hardware register (e.g. peek 0xdeadbeef)
  <span class="term-hl">poke</span> [addr] [val]        Write 32-bit register via ATE JTAG interface
  <span class="term-hl">gcode</span>                    3D printer telemetry &amp; bed mesh leveling report
  <span class="term-hl">uptime</span> / <span class="term-hl">uname</span>           Kernel platform flags &amp; continuous session runtime

  <span class="term-col">Undocumented Opcodes</span>     <span class="term-col">Description</span>
  <span class="term-dim">------------------------ ------------------------------------------------------------</span>
  <span class="term-hl">matrix</span>                   Cascading digital rain diagnostic (cmatrix)
  <span class="term-hl">sl</span>                       Scenic steam locomotive journey (mistyped 'ls')
  <span class="term-hl">sudo</span> [cmd]               Privilege escalation request (try 'sudo rm -rf /')
  <span class="term-hl">cad spin</span>                 Engage 10,000 RPM centrifuge stress test on 3D viewer
  <span class="term-hl">ls</span> / <span class="term-hl">cat</span> [file]          Inspect simulated rootfs (README.md, silicon_spec.json)
  <span class="term-hl">fortune</span>                  Random silicon engineering aphorism &amp; hardware wisdom

<span class="term-dim">Tip: Use Up/Down arrows for command history; press Tab for autocompletion.</span>`);
					break;

				case 'about':
					appendOutput(`
<span class="term-head">Bo Wu &bull; Hardware Systems Engineer</span>
Silicon Validation &bull; Embedded Linux &bull; 3D Parametric CAD

Focus:
  &bull; Automated Test Equipment (ATE) die sort, yield analysis &amp; electrical debug
  &bull; High-speed interfaces (PCIe Gen4/5, Ethernet, DDR) &amp; embedded bringup
  &bull; Production 3D CAD parametric modeling in Autodesk Inventor

Verified Profiles:
  &bull; LinkedIn:   <a href="https://www.linkedin.com/in/bowu/" target="_blank" class="term-link">https://www.linkedin.com/in/bowu/</a>
  &bull; GitHub:     <a href="https://github.com/bowuu" target="_blank" class="term-link">https://github.com/bowuu</a>
  &bull; MakerWorld: <a href="https://makerworld.com/en/@brob" target="_blank" class="term-link">https://makerworld.com/en/@brob</a>`);
					break;

				case 'skills':
					appendOutput(`
<span class="term-head">Core Technical Competencies:</span>
  <span class="term-cyan">[SILICON &amp; VALIDATION]</span>  ATE Die Sort, Yield Optimization, Power/Electrical Debug
  <span class="term-cyan">[EMBEDDED PLATFORMS]</span>   Embedded Linux (Debian, Yocto), PCIe, High-Speed I/O, RISC
  <span class="term-cyan">[CAD &amp; PROTOTYPING]</span>    Autodesk Inventor, 3D Parametric Modeling, FDM Prototyping
  <span class="term-cyan">[EDGE &amp; WEB SYSTEMS]</span>   Cloudflare Workers, Cloudflare D1 SQL, TypeScript, Three.js`);
					break;

				case 'projects':
					appendOutput(`
<span class="term-head">Featured Engineering Projects:</span>
  <span class="term-cyan">[01] PlayKeys</span>
       Zero-dependency Manifest V3 browser extension for global OS media key control.
  <span class="term-cyan">[02] 3D CAD Repository</span>
       11 production Autodesk Inventor models with authentic .stp downloads.
  <span class="term-cyan">[03] Hardware Test Triad</span>
       Anycast edge benchmark, mouse polling oscilloscope, 104-key switch matrix.
  <span class="term-cyan">[04] D1 Visitor Counter</span>
       Zero-logging engagement-verified counter with daily rotating volatile salt.`);
					break;

				case 'tests':
				case 'test':
				case 'lab':
					scrollToSection('lab');
					appendOutput('<span class="term-cyan">&rarr; Navigating to Hardware &amp; Network Tests (#lab)...</span>');
					break;

				case 'network':
				case 'ping':
				case 'speed':
					scrollToSection('benchmark');
					appendOutput('<span class="term-cyan">&rarr; Navigating to Network Edge Benchmark (#benchmark)...</span>');
					break;

				case 'mouse':
					scrollToSection('input-lab');
					appendOutput('<span class="term-cyan">&rarr; Navigating to Mouse Polling &amp; Button Lab (#input-lab)...</span>');
					break;

				case 'keyboard':
				case 'keys':
					scrollToSection('keyboard-lab');
					appendOutput('<span class="term-cyan">&rarr; Navigating to 104-Key Switch Matrix (#keyboard-lab)...</span>');
					break;

				case 'cad':
					const cadSub = args[0]?.toLowerCase();
					if (cadSub === 'grid') {
						scrollToSection('cad-viewer');
						(window as any).__toggleCadGrid?.();
						appendOutput('<span class="term-cyan">&rarr; Toggled 3D CAD XY-axis build plate grid.</span>');
						break;
					}
					if (cadSub === 'centrifuge' || cadSub === 'spin') {
						scrollToSection('cad-viewer');
						(window as any).__triggerCadCentrifuge?.(true);
						appendOutput('<span class="term-cyan">&rarr; Centrifuge Stress Test engaged on 3D CAD viewer (#cad-viewer)! (10,000 RPM)</span>');
						break;
					}
					appendOutput(`
<span class="term-head">Autodesk Inventor 3D CAD Catalog (11 Models):</span>
  01. ASUS RT-BE92U Router Mount
  02. IKEA Tertial Desk Lamp Heavy Mount
  03. Audio-Technica ATH-R70x Headband Joiner
  04. Subaru BRZ / GR86 Armrest Blocker
  05. Skil 12V Battery Holder
  06. Hakko FX-888D Soldering Tip Holder
  07. Micro-USB to USB-C Adapter Leash
  08. Logitech MX Master Vertical Charging Stand
  09. Low-Profile Mechanical Keyboard Display Stand
  10. Wi-Fi 7 Antenna Wall Standoff
  11. Magnetic Cable Management Guide
<span class="term-dim">All models render in Three.js WebGL with authentic .stp downloads under /public/models/.</span>`);
					break;

				case 'debug':
				case 'telemetry':
					scrollToSection('debug');
					appendOutput('<span class="term-cyan">&rarr; Navigating to Client Hardware &amp; Edge Telemetry (#debug)...</span>');
					break;

				case 'theme':
					const sub = args[0]?.toLowerCase();
					if (sub === 'dark') {
						document.documentElement.setAttribute('data-theme', 'dark');
						localStorage.setItem('theme', 'dark');
						appendOutput('Theme switched to: <span class="term-hl">Obsidian Dark</span>');
					} else if (sub === 'light') {
						document.documentElement.removeAttribute('data-theme');
						localStorage.setItem('theme', 'light');
						appendOutput('Theme switched to: <span class="term-hl">Clean Light</span>');
					} else {
						const current = document.documentElement.getAttribute('data-theme');
						if (current === 'dark') {
							document.documentElement.removeAttribute('data-theme');
							localStorage.setItem('theme', 'light');
							appendOutput('Theme toggled to: <span class="term-hl">Clean Light</span>');
						} else {
							document.documentElement.setAttribute('data-theme', 'dark');
							localStorage.setItem('theme', 'dark');
							appendOutput('Theme toggled to: <span class="term-hl">Obsidian Dark</span>');
						}
					}
					break;

				case 'visitor':
				case 'counter':
					const counterEl = document.getElementById('visitor-count-val');
					const currentCount = counterEl ? counterEl.textContent : 'active';
					appendOutput(`
<span class="term-head">Cloudflare D1 Engagement Counter:</span>
  Total Verified Visitors: <span class="term-hl">${currentCount}</span>
  Architecture: Edge-computed SHA-256 with volatile daily rotating salt
  Privacy: Zero IP persistence; hashes purged at UTC midnight rollover.`);
					break;

				case 'whoami':
					const ipEl = document.getElementById('t-ip');
					const locEl = document.getElementById('t-loc');
					const coloEl = document.getElementById('t-colo');
					const ip = ipEl ? ipEl.textContent : 'Detected at edge';
					const loc = locEl ? locEl.textContent : 'Global';
					const colo = coloEl ? coloEl.textContent : 'Cloudflare Anycast';
					appendOutput(`
<span class="term-head">Visitor Telemetry Identity:</span>
  USER:       guest@brob
  EDGE POP:   <span class="term-cyan">${colo} &bull; ${loc}</span>
  CLIENT IP:  <span class="term-dim">${ip} (ephemeral, zero persistence)</span>
  HOST:       brob.uk (Cloudflare Workers Anycast)
  SECURITY:   Zero-logging, volatile daily rotating salt`);
					break;

				case 'date':
					appendOutput(`UTC Timestamp: <span class="term-hl">${new Date().toUTCString()}</span>`);
					break;

				case 'clear':
					clearOutput();
					break;

				case 'exit':
				case 'quit':
					closeTerminal();
					break;

				case 'neofetch':
				case 'fastfetch':
					const upSec = Math.floor(performance.now() / 1000);
					const upM = Math.floor(upSec / 60);
					const upS = upSec % 60;
					const upStr = upM > 0 ? `${upM}m ${upS}s` : `${upS}s`;
					appendOutput(`
<div class="neofetch-wrap">
  <pre class="neofetch-art">
   +-----------+
   | # # # # # |
   | #  [b]  # |
   | # # # # # |
   +-----------+
       |||||
  </pre>
  <div class="neofetch-info">
    <div class="nf-title"><span class="nf-user">guest</span>@<span class="nf-host">brob</span></div>
    <div class="nf-line">------------------------------------</div>
    <div><span class="nf-k">OS:</span> brobOS 1.0.0(1)-release x86_64</div>
    <div><span class="nf-k">Host:</span> Silicon Validation Station #04</div>
    <div><span class="nf-k">Kernel:</span> 6.12.0-ate-val</div>
    <div><span class="nf-k">Uptime:</span> ${upStr}</div>
    <div><span class="nf-k">Shell:</span> brobsh 1.0.0</div>
    <div><span class="nf-k">CPU:</span> Custom Silicon (Die Stepping A0, 100% Yield)</div>
    <div><span class="nf-k">GPU:</span> WebGL 2.0 (ACES Filmic Tone Mapping)</div>
    <div><span class="nf-k">Memory:</span> 64 GiB DDR5-6400 (ECC Active)</div>
    <div><span class="nf-k">Location:</span> Cloudflare Anycast Edge</div>
    <div class="nf-colors">
      <span style="background:#1e293b"></span>
      <span style="background:#ef4444"></span>
      <span style="background:#22c55e"></span>
      <span style="background:#eab308"></span>
      <span style="background:#3b82f6"></span>
      <span style="background:#a855f7"></span>
      <span style="background:#06b6d4"></span>
      <span style="background:#f8fafc"></span>
    </div>
  </div>
</div>`);
					break;

				case 'dmesg':
					appendOutput(`
<span class="term-dim">[    0.000000]</span> Linux version brobOS (gcc version 14.2.1) #1 SMP PREEMPT_DYNAMIC
<span class="term-dim">[    0.000000]</span> Command line: BOOT_IMAGE=/vmlinuz root=UUID=brob-val ro quiet console=tty0
<span class="term-dim">[    0.012490]</span> x86/fpu: Supporting XSAVE feature 0x001: 'x87 floating point registers'
<span class="term-dim">[    0.024109]</span> <span class="term-cyan">ATE:</span> Automated Test Equipment interface initialized on pogo probe card #07
<span class="term-dim">[    0.052841]</span> <span class="term-hl">SILICON:</span> Die ID 0x850C6005, Stepping A0, Wafer #14, Bin: 1 (Ultra High Performance)
