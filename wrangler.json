{
  "name": "portfolio",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-db",
      "database_id": "850c6005-0535-4af4-a6c0-6e797747867d"
    }
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
